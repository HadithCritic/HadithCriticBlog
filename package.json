{
  "name": "hadithcritic-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "test:notifications": "node --test src/lib/tests/*.test.mjs src/lib/email-templates/tests/*.test.mjs",
    "check": "astro check",
    "lint:footnotes": "node scripts/lint-footnotes.mjs",
    "test:design": "node scripts/design-audit.mjs",
    "test:e2e": "playwright test",
    "validate": "npm run lint:footnotes && npm run test:notifications && npm run test:normalize && npm run check && npm run test:design && npm run build",
    "build:narrators": "node scripts/build-narrators.mjs",
    "build": "node --max-old-space-size=8192 ./node_modules/astro/bin/astro.mjs build && pagefind --site dist/client",
    "preview": "astro preview",
    "astro": "astro",
    "test:normalize": "node --experimental-sqlite --experimental-strip-types --test src/lib/tests/arabic-normalize.test.mjs src/lib/tests/format-text.test.mjs src/lib/tests/arabic-fold-sql.test.mjs",
    "build:hadith-seed": "python ../silsilah/optimized_translation_package/export_hadith_d1.py",
    "fts:rebuild:local": "node --experimental-strip-types scripts/fill-hadith-fts.mjs --local",
    "fts:rebuild:remote": "node node_modules/wrangler/bin/wrangler.js d1 execute silsilah --remote --file migrations/0004_hadith_search_index.sql && node --experimental-strip-types scripts/fill-hadith-fts.mjs --remote && node --experimental-strip-types scripts/verify-d1-corpus.mjs --remote",
    "verify:corpus": "node --experimental-strip-types scripts/verify-d1-corpus.mjs --local",
    "verify:corpus:remote": "node --experimental-strip-types scripts/verify-d1-corpus.mjs --remote"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "gsap": "^3.15.0",
    "marked": "^18.0.11",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.0",
    "typescript": "^5.7.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "hyparquet": "^1.29.2",
    "hyparquet-compressors": "^1.1.1",
    "pagefind": "^1.5.2"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.7",
    "yaml": "^2.9.0"
  }
}
