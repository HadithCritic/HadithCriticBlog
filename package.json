{
  "name": "hadithcritic-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/site/dev-site.mjs",
    "test:subscribe": "node --test src/lib/tests/*.test.mjs",
    "check": "astro check",
    "lint:footnotes": "node scripts/blog/lint-footnotes.mjs",
    "test:design": "node scripts/site/design-audit.mjs",
    "test:tafsir": "node --test scripts/tafsir/lib/tafsir.test.mjs",
    "build:tafsir": "node scripts/tafsir/build-tafsir-data.mjs",
    "test:rijal": "node --test scripts/rijal/lib/rijal.test.mjs",
    "build:taqrib": "node scripts/rijal/build-taqrib-rijal.mjs",
    "build:e2e": "node scripts/site/build-for-e2e.mjs",
    "test:e2e": "playwright test",
    "validate": "npm run lint:footnotes && npm run test:subscribe && npm run test:normalize && npm run test:research && npm run check && npm run test:design && npm run build",
    "build:abu-hanifa-mubarak-pages": "node scripts/hadith/build-abu-hanifa-mubarak-pages.mjs",
    "measure:artwork": "node --experimental-strip-types scripts/blog/measure-artwork-crop.mjs",
    "sync:youtube": "node scripts/site/sync-youtube-stats.mjs",
    "build": "node --max-old-space-size=8192 scripts/site/build-site.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test:research": "node --experimental-strip-types --test src/lib/tests/research-graph.test.mjs",
    "test:normalize": "node --experimental-strip-types --test src/lib/tests/arabic-normalize.test.mjs src/lib/tests/format-text.test.mjs",
    "build:og": "node scripts/og/build-og-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/cloudflare": "^14.4.1",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/sorts-mill-goudy": "^5.3.0",
    "astro": "^7.4.1",
    "http-cache-semantics": "file:vendor/http-cache-semantics",
    "marked": "^18.1.1",
    "parse5": "^8.0.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "pagefind": "^1.6.0",
    "satori": "0.35.1"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.8",
    "fflate": "^0.7.5",
    "miniflare": {
      "undici": "^7.29.1"
    },
    "sharp": "^0.35.5",
    "http-cache-semantics": "$http-cache-semantics",
    "source-map-js": "^1.2.2",
    "smol-toml": "^1.9.0",
    "svgo": "^4.1.0",
    "unifont": {
      "undici": "^8.10.2"
    },
    "yaml": "^2.9.0"
  }
}
