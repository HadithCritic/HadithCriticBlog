{
  "name": "hadithcritic-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "test:notifications": "node --test src/lib/tests/*.test.mjs src/lib/email-templates/tests/*.test.mjs",
    "check": "astro check",
    "lint:footnotes": "node scripts/lint-footnotes.mjs",
    "test:design": "node scripts/design-audit.mjs",
    "test:e2e": "playwright test",
    "validate": "npm run lint:footnotes && npm run test:notifications && npm run check && npm run test:design && npm run build",
    "build": "astro build && pagefind --site dist/client",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@libsql/client": "^0.17.4",
    "astro": "^7.2.2",
    "fast-xml-parser": "^5.11.0",
    "gsap": "^3.15.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.0",
    "turath-sdk": "^1.1.0",
    "typescript": "^5.7.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "pagefind": "^1.5.2"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "yaml": "^2.9.0"
  }
}
