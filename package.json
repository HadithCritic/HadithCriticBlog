{
  "name": "hadithcritic-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "test:subscribe": "node --test src/lib/tests/*.test.mjs",
    "check": "astro check",
    "lint:footnotes": "node scripts/lint-footnotes.mjs",
    "test:design": "node scripts/design-audit.mjs",
    "build:e2e": "node scripts/build-for-e2e.mjs",
    "build:e2e:fixture": "node scripts/build-for-e2e.mjs --fixture",
    "test:e2e": "playwright test",
    "test:e2e:corpus": "playwright test tests/corpus.spec.ts tests/corpus-data.spec.ts",
    "validate": "npm run lint:footnotes && npm run test:subscribe && npm run test:normalize && npm run check && npm run test:design && npm run build",
    "build:narrators": "node scripts/build-narrators.mjs",
    "build:corpus": "node scripts/build-corpus.mjs",
    "verify:corpus": "node scripts/verify-distribution.mjs",
    "publish:corpus": "node scripts/publish-corpus.mjs --target r2 --cors",
    "publish:corpus:dist": "node scripts/publish-corpus.mjs --target dist --prune",
    "corpus:meta": "node scripts/build-corpus-meta.mjs",
    "build:corpus:fixture": "node scripts/build-corpus-fixture.mjs",
    "use:corpus-fixture": "node scripts/use-corpus-fixture.mjs",
    "use:corpus-real": "node scripts/use-corpus-fixture.mjs --restore",
    "build": "node --max-old-space-size=8192 ./node_modules/astro/bin/astro.mjs build && pagefind --site dist/client",
    "preview": "astro preview",
    "astro": "astro",
    "test:normalize": "node --experimental-sqlite --experimental-strip-types --test src/lib/tests/arabic-normalize.test.mjs src/lib/tests/format-text.test.mjs src/lib/tests/arabic-fold-sql.test.mjs",
    "build:og": "node --experimental-sqlite scripts/build-og-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "astro": "^7.3.2",
    "gsap": "^3.15.0",
    "marked": "^18.0.11",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "sql.js-httpvfs": "^0.8.12",
    "typescript": "^5.7.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@playwright/test": "^1.61.1",
    "hyparquet": "^1.29.2",
    "hyparquet-compressors": "^1.1.1",
    "pagefind": "^1.5.2",
    "satori": "^0.33.4"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.7",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "yaml": "^2.9.0"
  }
}
