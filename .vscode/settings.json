{
    "workbench.editorAssociations": {
        "*.gz": "default",
        "*.db": "sqlite-viewer.view",
        "*.svg": "cweijan.officeViewer",
        "*.parquet": "duckdb.dataFileViewer",
        "*.csv": "duckdb.dataFileViewer",
        "*.tsv": "duckdb.dataFileViewer",
        "*.xlsx": "duckdb.dataFileViewer"
    },
    // Build output, the corpus build, the local archive and the Quran releases
    // are hundreds of thousands of generated files. Keep the editor from
    // watching and searching them; they stay visible in the explorer.
    "files.watcherExclude": {
        "**/dist/**": true,
        "**/dist-*/**": true,
        "**/dist-db/**": true,
        "**/local-archive/**": true,
        "**/scratch/**": true,
        "**/output/**": true,
        "**/public/data/quran/releases/**": true,
        "**/.wrangler/**": true,
        "**/.astro/**": true
    },
    "search.exclude": {
        "**/dist": true,
        "**/dist-*": true,
        "**/dist-db": true,
        "**/local-archive": true,
        "**/scratch": true,
        "**/output": true,
        "**/public/data/quran/releases": true,
        "**/.wrangler": true
    }
}
