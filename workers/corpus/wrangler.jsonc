{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hcb-corpus",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",

  // The bucket the corpus is published to by scripts/publish-corpus.mjs.
  // Bound rather than fetched over HTTP: a cache miss is then an in-network
  // read instead of a second internet round trip.
  "r2_buckets": [
    {
      "binding": "CORPUS",
      "bucket_name": "hadithcritic-corpus"
    }
  ],

  // Deployed to its own hostname first, so the corpus can be verified end to
  // end before anything is repointed. Cutting over is then a change to
  // PUBLIC_CORPUS_BASE_URL in the build environment and a redeploy of the site,
  // with no DNS surgery on a hostname readers are already using.
  "routes": [
    {
      "pattern": "corpus.hadithcriticblog.com/*",
      "zone_name": "hadithcriticblog.com"
    }
  ],

  "observability": {
    "enabled": true
  }
}
