---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogSlider from '../components/BlogSlider.astro';
---

<BaseLayout title="HadithCritic | Historical Criticism & Quranic Scholarship">
  <main class="home-page">
    <header class="hero hero-upgraded">
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-aurora" aria-hidden="true"></div>

      <div class="container hero-layout">
        <section class="hero-copy" aria-labelledby="hero-title">
          <p class="eyebrow"><span></span> Academic Hadith &amp; Quranic Scholarship</p>
          <h1 id="hero-title">
            Unveiling the<br />
            <em>History of Hadith</em>
          </h1>
          <div class="hero-divider"></div>
          <p class="hero-lede">
            A rigorous examination of traditional Islamic narratives through historical criticism,
            source analysis, and the Qur’anic demand for verification.
          </p>

          <div class="hero-actions">
            <a href="/blogs" class="btn btn-primary hero-primary">
              Read Research <i class="fas fa-arrow-right"></i>
            </a>
            <a href="/academia" class="btn btn-outline hero-secondary">
              Academia <i class="fas fa-university"></i>
            </a>
          </div>

          <dl class="hero-metrics" aria-label="Site research summary">
            <div>
              <dt>74</dt>
              <dd>published studies</dd>
            </div>
            <div>
              <dt>7</dt>
              <dd>research categories</dd>
            </div>
            <div>
              <dt>49:6</dt>
              <dd>method of verification</dd>
            </div>
          </dl>
        </section>

        <section class="hero-visual-panel" aria-label="HadithCritic transmission analysis visual">
          <div class="visual-frame">
            <div class="visual-grid" aria-hidden="true"></div>
            <div class="orbit orbit-1" aria-hidden="true"></div>
            <div class="orbit orbit-2" aria-hidden="true"></div>
            <div class="orbit orbit-3" aria-hidden="true"></div>

            <div class="node node-a">R1</div>
            <div class="node node-b disputed">M</div>
            <div class="node node-c">R2</div>
            <div class="node node-d disputed">W</div>
            <div class="node node-e">R8</div>
            <div class="node node-f disputed">D</div>

            <svg class="network-lines" viewBox="0 0 620 420" preserveAspectRatio="none" aria-hidden="true">
              <path d="M120 160 C210 110, 300 135, 310 210" />
              <path d="M130 252 C220 285, 265 265, 310 210" />
              <path d="M500 152 C430 120, 355 142, 310 210" />
              <path d="M498 266 C410 284, 360 258, 310 210" />
            </svg>

            <div class="critic-core">
              <img src="https://hadithcriticblog.com/wp-content/uploads/2026/02/cropped-HCpfp.jpg" alt="HadithCritic logo" />
            </div>

            <div class="analysis-label">Extracting Historical Reality</div>
          </div>
        </section>
      </div>
    </header>

    <section class="method-strip" aria-label="Research method pillars">
      <div class="container method-grid">
        <article>
          <span class="method-icon"><i class="fas fa-project-diagram"></i></span>
          <h2>Map the Transmission</h2>
          <p>Follow common links, regional clusters, anonymous transmitters, and late isnād growth.</p>
        </article>
        <article>
          <span class="method-icon"><i class="fas fa-magnifying-glass"></i></span>
          <h2>Test the Claim</h2>
          <p>Separate inherited authority from evidence, probability, and verifiable historical reasoning.</p>
        </article>
        <article>
          <span class="method-icon"><i class="fas fa-book-open"></i></span>
          <h2>Return to the Criterion</h2>
          <p>Measure theology and law against the Qur’an’s own claims of clarity and sufficiency.</p>
        </article>
      </div>
    </section>

    <BlogSlider />

    <section class="academia-preview" aria-labelledby="academia-title">
      <div class="container academia-shell">
        <div class="academia-copy">
          <p class="section-kicker">Latest Publication</p>
          <h2 id="academia-title">Academia</h2>
          <p>
            Long-form publications, critical notes, and research methods for studying hadith,
            law, and Qur’anic theology with academic discipline.
          </p>
          <div class="academia-actions">
            <a href="/academia" class="btn btn-primary">Explore Academic Works <i class="fas fa-arrow-right"></i></a>
            <a href="/projects" class="btn btn-outline">View Projects</a>
          </div>
        </div>

        <div class="publication-card">
          <div class="publication-glow" aria-hidden="true"></div>
          <img src="/images/RefutationKJI_FC.png" alt="The Decisive Refutation book cover" class="book-mini-img" />
          <div class="publication-meta">
            <span>Treatise Response</span>
            <strong>The Decisive Refutation</strong>
            <small>A Quranic analysis of Shāfiʿī’s legal theory.</small>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home-page {
    --hc-gold: #c1973f;
    --hc-gold-soft: rgba(193, 151, 63, .38);
    --hc-copper: #d7a085;
    --hc-plum: #4a344f;
    --hc-panel: rgba(15, 15, 15, .82);
    --hc-border: rgba(255, 255, 255, .08);
    background:
      radial-gradient(circle at 80% 0%, rgba(126, 62, 38, .16), transparent 30rem),
      radial-gradient(circle at 10% 20%, rgba(193, 151, 63, .06), transparent 24rem),
      #080909;
  }

  .hero-upgraded {
    position: relative;
    min-height: 680px;
    display: grid;
    align-items: center;
    padding: 115px 20px 92px;
    overflow: hidden;
    border-bottom: 1px solid rgba(255,255,255,.06);
  }

  .hero-noise,
  .hero-aurora {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-noise {
    opacity: .35;
    background:
      linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px),
      radial-gradient(circle at 50% 50%, transparent, rgba(0,0,0,.44));
    background-size: 38px 38px, 38px 38px, auto;
    mask-image: linear-gradient(to bottom, black 45%, transparent 100%);
  }

  .hero-aurora {
    background:
      radial-gradient(circle at 72% 36%, rgba(222, 117, 74, .18), transparent 19rem),
      radial-gradient(circle at 64% 52%, rgba(193,151,63,.10), transparent 24rem),
      linear-gradient(90deg, rgba(8,9,9,.05), rgba(41, 24, 17, .18));
  }

  .hero-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, .94fr) minmax(420px, 1.06fr);
    gap: clamp(44px, 6vw, 96px);
    align-items: center;
  }

  .hero-copy { max-width: 650px; }

  .eyebrow,
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    color: var(--hc-gold);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 30px;
    height: 1px;
    background: currentColor;
    box-shadow: 12px 0 0 rgba(193,151,63,.25);
  }

  .hero-copy h1 {
    margin: 0;
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: clamp(54px, 8vw, 112px);
    line-height: .92;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero-copy h1 em {
    color: var(--hc-copper);
    font-style: italic;
    letter-spacing: .09em;
  }

  .hero-divider {
    width: min(220px, 42vw);
    height: 2px;
    margin: 28px 0 24px;
    background: linear-gradient(90deg, var(--hc-gold), transparent);
    position: relative;
  }

  .hero-divider::after {
    content: "";
    position: absolute;
    left: 0;
    top: -4px;
    width: 10px;
    height: 10px;
    transform: rotate(45deg);
    background: var(--hc-gold);
  }

  .hero-lede {
    color: var(--text-body);
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.85;
    max-width: 590px;
    margin: 0 0 30px;
  }

  .hero-actions,
  .academia-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-primary,
  .hero-secondary { min-height: 48px; }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 38px 0 0;
    max-width: 560px;
  }

  .hero-metrics div {
    padding: 18px 18px 16px;
    background: linear-gradient(180deg, rgba(255,255,255,.052), rgba(255,255,255,.018));
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 18px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.05), 0 20px 45px rgba(0,0,0,.2);
  }

  .hero-metrics dt {
    margin: 0 0 6px;
    color: var(--hc-gold);
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1;
  }

  .hero-metrics dd {
    margin: 0;
    color: var(--text-muted);
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .hero-visual-panel {
    min-height: 520px;
    position: relative;
  }

  .visual-frame {
    position: relative;
    height: min(520px, 56vw);
    min-height: 430px;
    border: 1px solid rgba(193,151,63,.13);
    border-radius: 32px;
    background:
      radial-gradient(circle at 50% 47%, rgba(220, 97, 63, .15), transparent 11rem),
      radial-gradient(circle at 50% 47%, rgba(193,151,63,.12), transparent 18rem),
      linear-gradient(135deg, rgba(255,255,255,.035), rgba(255,255,255,.01));
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.03), 0 36px 120px rgba(0,0,0,.38);
    overflow: hidden;
  }

  .visual-grid {
    position: absolute;
    inset: 0;
    opacity: .35;
    background:
      linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(circle at center, black 0 42%, transparent 76%);
  }

  .orbit {
    position: absolute;
    inset: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(223, 105, 75, .34);
    border-radius: 999px;
    animation: orbitPulse 6s ease-in-out infinite;
  }
  .orbit-1 { width: 175px; height: 175px; }
  .orbit-2 { width: 282px; height: 282px; animation-delay: -1.2s; }
  .orbit-3 { width: 392px; height: 392px; animation-delay: -2.4s; }

  .network-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: .65;
    filter: drop-shadow(0 0 8px rgba(223,105,75,.12));
  }
  .network-lines path {
    fill: none;
    stroke: rgba(193,151,63,.35);
    stroke-width: 1;
    stroke-dasharray: 5 7;
    animation: dashMove 18s linear infinite;
  }

  .critic-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 118px;
    height: 118px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 2px solid rgba(223,105,75,.8);
    background: #090909;
    box-shadow: 0 0 0 12px rgba(223,105,75,.04), 0 0 55px rgba(223,105,75,.18);
    z-index: 5;
  }

  .critic-core img {
    width: 86px;
    height: 86px;
    object-fit: cover;
    border-radius: 50%;
    filter: contrast(1.1);
  }

  .node {
    position: absolute;
    z-index: 6;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,.65);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 800;
    border: 1px solid rgba(255,255,255,.16);
    background: rgba(15,15,15,.78);
    box-shadow: 0 12px 30px rgba(0,0,0,.32);
  }
  .node.disputed { color: #ff9c7a; border-color: rgba(223,105,75,.55); background: rgba(88,23,18,.72); }
  .node-a { left: 14%; top: 26%; }
  .node-b { left: 18%; top: 46%; }
  .node-c { left: 13%; top: 64%; }
  .node-d { right: 16%; top: 31%; }
  .node-e { right: 12%; top: 53%; }
  .node-f { right: 18%; top: 70%; }

  .analysis-label {
    position: absolute;
    left: 50%;
    bottom: 19%;
    transform: translateX(-50%);
    color: var(--hc-copper);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .24em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .method-strip {
    padding: 34px 20px 20px;
    position: relative;
    z-index: 2;
  }

  .method-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .method-grid article {
    padding: 24px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.015));
    box-shadow: 0 22px 60px rgba(0,0,0,.22);
  }

  .method-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    color: var(--hc-gold);
    border: 1px solid rgba(193,151,63,.22);
    border-radius: 13px;
    background: rgba(193,151,63,.06);
    margin-bottom: 18px;
  }

  .method-grid h2 {
    margin: 0 0 10px;
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: .04em;
  }

  .method-grid p {
    margin: 0;
    color: var(--text-body);
    line-height: 1.65;
    font-size: 14px;
  }

  .academia-preview {
    padding: 92px 20px 104px;
    background: linear-gradient(180deg, rgba(15,15,15,.50), rgba(8,9,9,.90));
    border-top: 1px solid rgba(255,255,255,.06);
  }

  .academia-shell {
    max-width: 1050px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 44px;
    align-items: center;
    padding: 46px;
    border-radius: 30px;
    border: 1px solid rgba(193,151,63,.16);
    background:
      radial-gradient(circle at 86% 8%, rgba(193,151,63,.13), transparent 16rem),
      linear-gradient(135deg, rgba(193,151,63,.06), rgba(255,255,255,.015));
    box-shadow: 0 32px 90px rgba(0,0,0,.30), inset 0 1px 0 rgba(255,255,255,.04);
  }

  .academia-copy h2 {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: clamp(38px, 5vw, 62px);
    letter-spacing: .08em;
    color: var(--text-heading);
    text-transform: uppercase;
  }

  .academia-copy p:not(.section-kicker) {
    max-width: 620px;
    margin: 0 0 26px;
    color: var(--text-body);
    font-size: 17px;
    line-height: 1.75;
  }

  .publication-card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 16px;
  }

  .publication-glow {
    position: absolute;
    width: 220px;
    height: 220px;
    top: 14px;
    border-radius: 50%;
    background: rgba(193,151,63,.18);
    filter: blur(48px);
    z-index: 0;
  }

  .book-mini-img {
    position: relative;
    z-index: 1;
    width: 168px;
    border-radius: 6px 10px 10px 6px;
    transform: perspective(900px) rotateY(-14deg) rotateZ(.5deg);
    box-shadow: -18px 22px 46px rgba(0,0,0,.56), inset 3px 0 5px rgba(255,255,255,.18);
    transition: transform .45s ease, box-shadow .45s ease;
  }
  .publication-card:hover .book-mini-img { transform: perspective(900px) rotateY(-6deg) rotateZ(0) scale(1.04); }

  .publication-meta {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 16px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 18px;
    background: rgba(0,0,0,.24);
    text-align: center;
  }
  .publication-meta span {
    display: block;
    margin-bottom: 7px;
    color: var(--hc-gold);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .publication-meta strong {
    display: block;
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: 18px;
    margin-bottom: 6px;
  }
  .publication-meta small { color: var(--text-muted); line-height: 1.45; }

  @keyframes orbitPulse {
    0%, 100% { opacity: .48; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: .78; transform: translate(-50%, -50%) scale(1.035); }
  }
  @keyframes dashMove { to { stroke-dashoffset: -120; } }

  @media (max-width: 1000px) {
    .hero-layout { grid-template-columns: 1fr; }
    .hero-visual-panel { min-height: 440px; }
    .method-grid { grid-template-columns: 1fr; }
    .academia-shell { grid-template-columns: 1fr; text-align: center; }
    .academia-actions { justify-content: center; }
  }

  @media (max-width: 640px) {
    .hero-upgraded { padding-top: 92px; }
    .hero-metrics { grid-template-columns: 1fr; }
    .visual-frame { min-height: 360px; border-radius: 22px; }
    .critic-core { width: 92px; height: 92px; }
    .critic-core img { width: 68px; height: 68px; }
    .analysis-label { bottom: 15%; font-size: 9px; }
    .academia-shell { padding: 28px; }
  }
</style>
