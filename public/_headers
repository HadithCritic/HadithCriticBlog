# Cloudflare response headers.
#
# The Astro Cloudflare adapter appends its own immutable rule for /_astro/* to
# this file at build time. Everything here is hand-written.

# Fonts and images keep their filenames when they change, so they cannot be
# marked immutable the way the hashed files under /_astro/ are. Without a rule
# they were served max-age=0 and revalidated on every page view. These windows
# trade freshness for that: a replaced image can take up to a week to reach a
# returning reader, a replaced font up to thirty days. Rename the file instead
# if a change has to land at once.
/fonts/*
  Cache-Control: public, max-age=2592000

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
