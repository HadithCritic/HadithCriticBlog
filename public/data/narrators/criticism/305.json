5778}]}],"flags":[]},"15275":{"id":15275,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"بإسناد صحيح","citation":"الإصابة في تمييز الصحابة (7/ 97)","pageId":425860,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15276":{"id":15276,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: الذي يصح من رواية شعبة وغيره أن أفلح أخا أبي القعيس، فأبو القعيس إن كان اسمه وائل صحت هذه الترجمة","citation":"الإصابة في تمييز الصحابة (11/ 313)","pageId":433633,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15277":{"id":15277,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"خلطه ابن الأثير بالذي قبله، ثم قال: سعيد تابعي لم يدرك من يقتل بأحد، فإن كان غيره وإلا فهو منقطع. انتهى. وكيف يحتمل أن يكون منقطعا وهو يصرح بأنه رآه فتعين الاحتمال الأول","citation":"الإصابة في تمييز الصحابة (13/ 27)","pageId":436957,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15280":{"id":15280,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن السكن","statements":[{"text":"وقال ابن السكن: له صحبة","citation":"الإصابة في تمييز الصحابة (12/ 311)","pageId":435617,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"ورأيته في نسخة معتمدة من كتاب ابن السكن بالفاء بدل الميم، والسلمي بدل الأسلمي، وفي نسخة من البغوي: السلامي، وممن ذكر أنه أبو سلالة بلامين: أبو عبيد الله المرزباني في كتاب \"السيرة العادلة\"، وممن نسبه سلميا الباوردي، فالله أعلم","citation":"الإصابة في تمييز الصحابة (12/ 311)","pageId":435617,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15284":{"id":15284,"criticCount":3,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"ذكره أبو نعيم في الصحابة","citation":"الإصابة في تمييز الصحابة (8/ 366)","pageId":428481,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وأخرج البخاري في كتاب \"الضعفاء\" من طريق عثمان بن عطاء الخراساني، عن سعيد بن عبد العزيز، عن أبيه، عن جده حديثا، ولم يسم جده، وعثمان بن عطاء ضعيف","citation":"الإصابة في تمييز الصحابة (8/ 366)","pageId":428481,"verdict":"jarh"}]},{"critic":"أبو موسى المديني","statements":[{"text":"قال أبو موسى: فيه وهم من وجهين: أحدهما أنه تابعي. والثاني أنه من روايته، عن أبيه. ثم ذكره من رواية معلى بن مهدي، عن عثمان بن مطر، عن عبد الغفور بن عبد العزيز بن سعيد، عن أبيه، عن جده، قال... فالصحبة لسعيد. انتهى. وقد مضى في السين المهملة، وكلا السندين ضعيف","citation":"الإصابة في تمييز الصحابة (8/ 366)","pageId":428481,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15286":{"id":15286,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"قال أبو نعيم: هذا وهم، والصواب ما رواه عثمان بن مطر، عن معمر، عن خلاد بن عبد الرحمن، عن أبيه، عن أنس ؛ كذا قال. وعثمان بن مطر ضعيف جدا، فلو كان ضابطا لقبلت زيادته، وكان قد سقط اسم الصحابي من رواية عبد الرزاق","citation":"الإصابة في تمييز الصحابة (6/ 580)","pageId":425416,"verdict":"jarh"}]},{"critic":"البخاري","statements":[{"text":"قال ابن منده: ذكره البخاري","citation":"الإصابة في تمييز الصحابة (6/ 580)","pageId":425416,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15287":{"id":15287,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"ويقال: إن له صحبة","citation":"الثقات (3/ 11)","pageId":582807,"verdict":"unclassified"},{"text":"قال ابن حبان: يقال: إن له صحبة","citation":"الإصابة في تمييز الصحابة (1/ 295)","pageId":414954,"verdict":"unclassified"}]},{"critic":"ابن عبد البر","statements":[{"text":"قرأت بخط ابن عبد البر: لولا حديث كعب بن مالك لم يثبت له صحبة","citation":"الإصابة ف