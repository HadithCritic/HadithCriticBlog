يخ الإسلام (7/ 848)","pageId":643323,"verdict":"tadil"},{"text":"وثقه أبو سعيد بن يونس","citation":"سير أعلام النبلاء (15/ 529)","pageId":728169,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"الشيخ","citation":"سير أعلام النبلاء (16/ 24)","pageId":728281,"verdict":"unclassified"},{"text":"وكان صاحب حديث","citation":"سير أعلام النبلاء (16/ 24)","pageId":728281,"verdict":"unclassified"},{"text":"الإمام الحجة","citation":"سير أعلام النبلاء (15/ 529)","pageId":728169,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20786":{"id":20786,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سئل أبي عنه، فقال: صدوق","citation":"الجرح والتعديل لابن أبي حاتم (2/ 188)","pageId":684463,"verdict":"tadil"}]},{"critic":"الفسوي","statements":[{"text":"من شيوخ يعقوب بن سفيان. ذكره في \" تاريخه \" وقال: كان ثقة، إلا أنهم كانوا يعيبون عليه بيعه الزيبق","citation":"لسان الميزان (2/ 146)","pageId":544714,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20792":{"id":20792,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الحسيني","statements":[{"text":"مجهول","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 114)","pageId":580648,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"قلت: قد بينت وجه الصواب فيه في ترجمة العلاء بن رافع","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 114)","pageId":580648,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20793":{"id":20793,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: كأن الغلط فيه من إسماعيل؛ فإن إبراهيم بن العلاء لم يتفرد به، والحق ما قال ابن منده؛ فإن جعفر بن الزبير ولد بعد موت النبي - صلى الله عليه وسلم - بدهر، وهو أصغر من عروة","citation":"الإصابة في تمييز الصحابة (2/ 312)","pageId":417153,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"قلت: كأن الغلط فيه من إسماعيل؛ فإن إبراهيم بن العلاء لم يتفرد به، والحق ما قال ابن منده؛ فإن جعفر بن الزبير ولد بعد موت النبي - صلى الله عليه وسلم - بدهر، وهو أصغر من عروة","citation":"الإصابة في تمييز الصحابة (2/ 312)","pageId":417153}]}],"flags":["Sends Mursal Reports"]},"20795":{"id":20795,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"شيخ صعلوك، دين، يخبز بيده ويبيعه","citation":"تاريخ الإسلام (11/ 882)","pageId":660617,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20797":{"id":20797,"criticCount":1,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":1,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن عبد الله بن فروخ مولى عائشة، روى عنه حماد بن عبد الرحمن الكلبي من أهل قنسرين. سمعت أبي يقول ذلك، وسألته عنه فقال: هو مجهول، وعبد الله بن فروخ مجهول، [وهما] ضعيفان","citation":"الجرح والتعديل لابن أبي حاتم (8/ 341)","pageId":715097,"verdict":"jarh"},{"text":"عن، مجهولان ضعيفان. قاله أبو حاتم. قلت: بل ابن فروخ صدوق","citation":"لسان الميزان (6/ 450)","pageId":555990,"verdict":"mixed"}]}],"phenomena":[],"flags":[]}}