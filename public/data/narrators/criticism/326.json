{"16300":{"id":16300,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"عبد الغافر بن إسماعيل الفارسي","statements":[{"text":"قال عبد الغافر في \" السياق \": كان محدثا مفيدا، من خواص خدام أبي عبد الرحمن السلمي، وكان صاحب كتب، صار بندار كتب الحديث بنيسابور، وأكثر أقرانه سماعا وأصولا، قد رزقه الله الإسناد العالي، وجمع الأبواب، وأسمع الصبيان، وهو من بيت حديث وصلاح. سمع من أبي محمد المخلدي، وأبي الحسين الخفاف، والسلمي. قال: وحدثني من أثق به، أن أبا سعيد أظهر سماعه من أبي طاهر بن خزيمة بعد وفاة أبي عثمان الصابوني، فتكلم أصحاب الحديث فيه، وما رضوا ذلك منه، والله أعلم بحاله. وأما سماعه من غيره فصحيح","citation":"لسان الميزان (7/ 385)","pageId":558004,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16308":{"id":16308,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الأزدي","statements":[{"text":"لا يصح حديثه قاله الأزدي","citation":"لسان الميزان (3/ 397)","pageId":548677,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16309":{"id":16309,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أحمد بن محمد الإشبيلي","statements":[{"text":"مجهول، قاله النباتي","citation":"لسان الميزان (3/ 423)","pageId":548783,"verdict":"jarh"}]},{"critic":"الأزدي","statements":[{"text":"وأورده الأزدي في ترجمة ابنه داود، عن حسين بن عبد الله القطان الرقي، عن عبد الله بن داود بن دلهاث، عن أبيه، عن أبيه دلهاث بن إسماعيل بن عبد الله بن مسرع بن ياسر بن سويد الجهني صاحب رسول الله صلى الله عليه وسلم، عن أبيه إسماعيل أن أباه حدثه عن أبيه مسرع بن ياسر، عن عمرو بن مرة الجهني أنه كان يحدث قال: خرجت حاجا في الجاهلية فرأيت في المنام نورا ساطعا... الحديث بطوله في الدلائل","citation":"لسان الميزان (3/ 423)","pageId":548783,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16310":{"id":16310,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"وهذا مذكور في الصحابة لأن له رؤية، وأبوه ذكره ابن السكن وغيره في الصحابة، وأوردوا حديثه من طريق بنيه، وفيه أن النبي صلى الله عليه وسلم سمى ولده مسرعا","citation":"لسان الميزان (8/ 36)","pageId":558989,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"مجهول","citation":"لسان الميزان (8/ 36)","pageId":558989,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"16312":{"id":16312,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول ذلك، وسألته عنه فقال: هو شيخ","citation":"الجرح والتعديل لابن أبي حاتم (3/ 413)","pageId":692214,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16315":{"id":16315,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع أباه، سمع منه أبو نعيم وإبراهيم بن موسى ومحمد بن مهران الجمال، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 255)","pageId":705976,"verdict":"unclassified"},{"text":"نا عبد الرحمن قال: سئل أبي عن عمرو بن قيس بن يسير، فقال: ثقة","citation":"الجرح والتعديل لابن أبي حاتم (6/ 255)","pageId":705976,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"ثنا عبد الرحمن قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين أنه قال: عمرو بن قيس بن يسير بن عمرو لا شيء","citation":"الجرح والتعديل لابن أبي حاتم (6/ 255)","pageId":705976,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع أباه، سمع منه أبو نعيم وإبراهيم بن موسى ومحمد بن مهران الجمال، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 255)","pageId":705976}]}],"flags":[]},"16317":{"id":16317,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي عن علي، روى هشيم، عن أبي محمد عنه إن لم يكن أبو 