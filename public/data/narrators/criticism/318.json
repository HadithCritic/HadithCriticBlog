ة","citation":"الإصابة في تمييز الصحابة (12/ 550)","pageId":436452,"verdict":"unclassified"}]},{"critic":"أبو القاسم البغوي","statements":[{"text":"وقال البغوي: أبو القين سكن البصرة، ولم يحدث بغير هذا الحديث ولا رواه عن سعيد بن جمهان، ولم أر من نسبه حضرميا كما قال أبو عمر، فالله أعلم","citation":"الإصابة في تمييز الصحابة (12/ 550)","pageId":436452,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15913":{"id":15913,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الطبراني","statements":[{"text":"ذكره أبو موسى، عن الطبراني","citation":"الإصابة في تمييز الصحابة (13/ 13)","pageId":436905,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15916":{"id":15916,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"البخاري","statements":[{"text":"ذكره البخاري في الصحابة","citation":"الإصابة في تمييز الصحابة (10/ 133)","pageId":431090,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15917":{"id":15917,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن السكن","statements":[{"text":"ذكره ابن السكن والطبراني في الصحابة، وأخرجا من طريق صالح بن عمر الواسطي عن إسماعيل بن أبي خالد عن حنش بن المعتمر عن أبيه قال: كان النبي - صلى الله عليه وسلم - يصلي على جنازة، فجاءت امرأة بمجمر تريد الجنازة، فصاح بها حتى دخلت في آجام المدينة. قال ابن السكن: لم أجد لمعتمر غير هذا، وليس بمعروف في الصحابة","citation":"الإصابة في تمييز الصحابة (10/ 266)","pageId":431500,"verdict":"unclassified"}]},{"critic":"الطبراني","statements":[{"text":"ذكره ابن السكن والطبراني في الصحابة، وأخرجا من طريق صالح بن عمر الواسطي عن إسماعيل بن أبي خالد عن حنش بن المعتمر عن أبيه قال: كان النبي - صلى الله عليه وسلم - يصلي على جنازة، فجاءت امرأة بمجمر تريد الجنازة، فصاح بها حتى دخلت في آجام المدينة. قال ابن السكن: لم أجد لمعتمر غير هذا، وليس بمعروف في الصحابة","citation":"الإصابة في تمييز الصحابة (10/ 266)","pageId":431500,"ver