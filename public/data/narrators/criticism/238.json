,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"أخبرنا الأزهري، قال: أخبرنا أبو الحسن الدارقطني، قال: علي بن الحسن بن هارون بن رستم السقطي صدوق، كتبنا عنه في سنة اثنتين وعشرين وثلاثمائة","citation":"تاريخ بغداد (13/ 311)","pageId":829288,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"حدث سنة اثنتين وعشرين. وكان ثقة","citation":"تاريخ الإسلام (7/ 607)","pageId":641949,"verdict":"tadil"},{"text":"سمع: ابن عرفة، والحسن الزعفراني","citation":"تاريخ الإسلام (7/ 607)","pageId":641949,"verdict":"unclassified"}]},{"critic":"يوسف بن عمر القواس","statements":[{"text":"أخبرني الخلال، قال: حدثنا يوسف القواس، قال: حدثنا علي بن الحسن بن رستم، وكان من الثقات","citation":"تاريخ بغداد (13/ 311)","pageId":829288,"verdict":"tadil"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع: ابن عرفة، والحسن الزعفراني","citation":"تاريخ الإسلام (7/ 607)","pageId":641949}]}],"flags":[]},"11946":{"id":11946,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"انتقى عليه الدارقطني، وسمع منه، وروى عنه، وكان ثقة","citation":"تاريخ بغداد (13/ 446)","pageId":829526,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"11949":{"id":11949,"criticCount":3,"statementCount":6,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":1},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"كان من الجوالين في طلب الحديث، وصاحب غرائب. سمع محمد بن الفضل البلخي، وأحمد بن سيار المروزي، وأبا حاتم الرازي، وأبا قلابة الرقاشي وطبقتهم. وكان ثقة حافظا","citation":"تاريخ بغداد (13/ 505)","pageId":829650,"verdict":"tadil"},{"text":"قال الخطيب: كان ثقة حافظا جوالا في طلب الحديث، صاحب غرائب","citation":"سير أعلام النبلاء (15/ 69)","pageId":727623,"verdict":"tadil"}]},{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: هو ثقة حافظ","citation":"سير أعلام النبلاء (15/ 69)","pageId":727623,"