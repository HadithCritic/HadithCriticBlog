ي","statements":[{"text":"وروى عمار بن رجاء الإستراباذي فقال: حدثنا محمد بن بشير بن عطاء بن مروان الكندي، عن الوليد بن عبيد الله، عن الزهري قال: لا يوجد الحافظ إلا في كل أربعين سنة مرة، ولا أدري محمد بن بشير هذا هو الواعظ أو غيره","citation":"الجرح والتعديل لابن أبي حاتم (7/ 211)","pageId":710514,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19382":{"id":19382,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الدارقطني","statements":[{"text":". قال الدارقطني: متروك","citation":"لسان الميزان (8/ 40)","pageId":559010,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19384":{"id":19384,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: شيخ كتبت عنه بالمدينة ما رأينا [به] بأسا","citation":"الجرح والتعديل لابن أبي حاتم (8/ 112)","pageId":712819,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19386":{"id":19386,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الأزدي","statements":[{"text":"قال الأزدي: ضعيف جدا خراساني، انتهى. وأورد له عن خازم، عن أبيه، عن جده أبي بصرة، عن أبي سعيد رفعه قال لأبي بكر وعمر: \" والله إن الله ليحبكما لحبي لكما... \" الحديث","citation":"لسان الميزان (3/ 398)","pageId":548687,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19387":{"id":19387,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وكان شيخا متعبدا متقنا، ولكنه كان مرجئا","citation":"الثقات (9/ 123)","pageId":613920,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19390":{"id":19390,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"وقال أبو حاتم: لا أعرفه","citation":"لسان الميزان (8/ 237)","pageId":559852,"v