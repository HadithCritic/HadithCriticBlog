{"19351":{"id":19351,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن، أنا يعقوب بن إسحاق فيما كتب إلي قال: أنا عثمان بن سعيد قال: قلت ليحيى بن معين: علي بن أبي كثير، فقال: ثقة","citation":"الجرح والتعديل لابن أبي حاتم (6/ 202)","pageId":705351,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن أبي بكر الصديق رضي الله عنه، مرسل وعن أبي عبيدة بن الجراح مرسل، روى عنه إسماعيل بن سميع، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 202)","pageId":705351,"verdict":"unclassified"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"عن أبي عبيدة بن الجراح، قال أبو زرعة: مرسل","citation":"تحفة التحصيل في المراسيل (1/ 364)","pageId":681125,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"عن أبي عبيدة بن الجراح، قال أبو زرعة: مرسل","citation":"تحفة التحصيل في المراسيل (1/ 364)","pageId":681125},{"text":"روى عن أبي بكر الصديق رضي الله عنه، مرسل وعن أبي عبيدة بن الجراح مرسل، روى عنه إسماعيل بن سميع، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 202)","pageId":705351}]}],"flags":["Sends Mursal Reports"]},"19354":{"id":19354,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سمعت أبي يقول: في صحة خبره نظر","citation":"الجرح والتعديل لابن أبي حاتم (6/ 319)","pageId":706791,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19355":{"id":19355,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"كان مستجاب الدعوة له آثار في العبادة، ومقامات في الزهادة","citation":"الثقات (5/ 227)","pageId":592061,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع ابن عمر، روى جعفر بن برقان عن راشد عنه، سمعت