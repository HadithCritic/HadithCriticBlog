ل الذهبي: هو وابنه بدر مجهولان","citation":"تهذيب التهذيب (3/ 260)","pageId":476147,"verdict":"jarh"}]},{"critic":"الحاكم","statements":[{"text":"خرج أبو عبد الله الحاكم حديثه في التيمم في \" صحيحه \"","citation":"إكمال تهذيب الكمال (10/ 140)","pageId":539632,"verdict":"unclassified"}]}],"phenomena":[{"key":"التوثيق الضمني","label":"Implicit Authentication","statements":[{"text":"خرج أبو عبد الله الحاكم حديثه في التيمم في \" صحيحه \"","citation":"إكمال تهذيب الكمال (10/ 140)","pageId":539632}]}],"flags":[]},"4807":{"id":4807,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"ثقة","citation":"تقريب التهذيب (1/ 732)","pageId":518176,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"4812":{"id":4812,"criticCount":4,"statementCount":4,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول الحال","citation":"تقريب التهذيب (1/ 733)","pageId":518190,"verdict":"jarh"}]},{"critic":"يحيى بن معين","statements":[{"text":"قال ابن معين: هذا حديث مشهور","citation":"تهذيب التهذيب (3/ 264)","pageId":476173,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع عبد الله بن عمر، وروى عنه أبو سفيان عن مسلم بن كثير، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 227)","pageId":705671,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وقد تقدم أن ابن حبان جعل عمرو بن حريش هو عمرو بن حبشي، فالله أعلم","citation":"تهذيب التهذيب (3/ 264)","pageId":476173,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"4817":{"id":4817,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 266)","pageId":476189,"verdict":"tadil"},{"text":"وذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (21/ 598)","pageId":451538,"verdic