{"17302":{"id":17302,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع إياس بن سلمة، روى عنه ذؤيب بن عمامة السهمي والحميدي، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 209)","pageId":705425,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع إياس بن سلمة، روى عنه ذؤيب بن عمامة السهمي والحميدي، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 209)","pageId":705425}]}],"flags":[]},"17303":{"id":17303,"criticCount":1,"statementCount":3,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"ثنا علان، ثنا ابن أبي مريم قال: سألت يحيى بن معين، عن حنظلة التيمي فقال: ضعيف يكتب حديثه","citation":"الكامل في الضعفاء (3/ 343)","pageId":575372,"verdict":"jarh"},{"text":"ثنا ابن حماد، ثنا العباس، عن يحيى قال: وحنظلة بن عبد الرحمن التيمي روى عنه وكيع وليس بشيء","citation":"الكامل في الضعفاء (3/ 343)","pageId":575372,"verdict":"jarh"},{"text":"وهو حنظلة القاص، ولم أر لحنظلة هذا من الحديث إلا القليل، إلا أن الثوري قد حدث عنه بشيء يسير، ولم يتبين لي ضعفه لقلة حديثه، إلا أن ابن معين قد نسبه إلى الضعف","citation":"الكامل في الضعفاء (3/ 343)","pageId":575372,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17308":{"id":17308,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن المجد المقدسي","statements":[{"text":"ووجدت بخط السيف ابن المجد: رأيت أصحابنا ومشايخنا يتكلمون فيه بسبب قلة الدين والمروءة. وكان سماعه صحيحا","citation":"تاريخ الإسلام (14/ 117)","pageId":670541,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17310":{"id":17310,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"شيخ صالح مكثر","citation":"تاريخ الإسلام (10/ 781)","pageId":656081,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17311":{"id":17311,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"قلت: لم يذكر ابن عساكر أحدا روى عنه سوى ابن أبي نصر","citation":"تاريخ الإسلام (7/ 768)","pageId":642852,"verdict":"unclassified"}]},{"critic":"محمد بن إبراهيم الأصبهاني","statements":[{"text":"وقال الكتاني: لم أسمع فيه شيئا","citation":"تاريخ الإسلام (7/ 768)","pageId":642852,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17315":{"id":17315,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن القطان الفاسي","statements":[{"text":"لا يعرف حاله، قاله ابن القطان","citation":"لسان الميزان (9/ 85)","pageId":562510,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17318":{"id":17318,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"الشيخ الإمام المفتي المعمر الثقة","citation":"سير أعلام النبلاء (20/ 71)","pageId":731553,"verdict":"tadil"},{"text":"كان إمام الجامع المنيعي بنيسابور، وكان مفتيا، عالما، يعرف مذهب الشافعي، وفيه تواضع وخير","citation":"تاريخ الإسلام (11/ 654)","pageId":659459,"verdict":"unclassified"},{"text":"وكان متواضعا خيرا، بصيرا بمذهب الشافعي","citation":"سير أعلام النبلاء (20/ 71)","pageId":731553,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17319":{"id":17319,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن عساكر","statements":[{"text":"قال ابن عساكر: لم يكن الحديث من صنعته، توفي في جمادى الأولى سنة ثمان وخمسين وخمسمائة، روى كثيرا من \" سنن \" النسائي الكبير عن الإسفراييني","citation":"سير أعلام النبلاء (20/ 348)","pageId":731942,"verdict":"unclassified"},{"text":"روى عنه ابن عساكر، وقال: لم يكن الحديث من صنعته","citation":"تاريخ الإسلام (12/ 138)","pageId":661938,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17322":{"id":17322,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"علي بن إبراهيم النسيب","statements":[{"text":"والنسيب وقال: هو ثقة","citation":"تاريخ الإسلام (9/ 700)","pageId":652244,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"ليس عنده شيء سوى نسخة أبي مسهر وما معها. سمع ذلك من الفضل بن جعفر التميمي","citation":"سير أعلام النبلاء (17/ 647)","pageId":730004,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17323":{"id":17323,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وقال ابن حبان: يروي عن أبيه الأشياء الموضوعة، وأبوه أيضا لا شيء. ثم قال: روى عن أبيه، عن عبد العزيز بن أبي رواد، عن نافع، عن ابن عمر رضي الله عنهما مرفوعا: \" الناس على ثلاث منازل ؛ فمن طلب ما عند الله كانت السماء ظلاله، والأرض فراشه، لم يهتم بشيء من أمر الدنيا، فرغ نفسه لله، فهو لا يزرع الزرع ويأكل الخبز، ولا يغرس الشجر ويأكل الثمر، لا يهتم بشيء من أمر الدنيا، توكلا على الله \" الحديث بطوله، انتهى. قال ابن حبان: لست أدري ؛ أهو الجاني على أبيه ؟ أو أبوه كان يخصه بالموضوعات ؟ ثم قال بعد أن ساق الحديث المذكور بطوله: هذا مما عملت يداه، وليس هذا من عمل عمرو بن بكر، ولا عبد العزيز، ولا هو من حديث رسول الله صلى الله عليه وسلم، ولا ابن عمر، ولا نافع","citation":"لسان الميزان (1/ 327)","pageId":542560,"verdict":"unclassified"}]},{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: متروك","citation":"لسان الميزان (1/ 327)","pageId":542560,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17324":{"id":17324,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان: يقال: إنه سرق هذا الحديث","citation":"لسان الميزان (8/ 297)","pageId":560129,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17326":{"id":17326,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixe