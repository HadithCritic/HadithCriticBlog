{"13200":{"id":13200,"criticCount":6,"statementCount":6,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":6},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في التابعين بهذا، وقال: روى عن ابن مسعود، روى عنه جبلة بن سحيم","citation":"الإصابة في تمييز الصحابة (5/ 535)","pageId":423812,"verdict":"unclassified"}]},{"critic":"الحسن بن محمد الصغاني","statements":[{"text":": ذكره الصغاني فيمن اختلف في صحبته","citation":"تحفة التحصيل في المراسيل (1/ 223)","pageId":680537,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"قلت: وهذا ليس من شرط الكتاب","citation":"لسان الميزان (4/ 381)","pageId":551046,"verdict":"unclassified"}]},{"critic":"عبد الرحمن بن الحكم الرازي","statements":[{"text":"نا عبد الرحمن، نا محمد بن سعيد المقري الرازي قال: سمعت عبد الرحمن بن الحكم بن بشير بن سلمان يقول: أبو مطر الذي يروي عنه جبلة بن سحيم هو عامر بن مطر شيباني رجل له شأن في المسلمين","citation":"الجرح والتعديل لابن أبي حاتم (6/ 328)","pageId":706896,"verdict":"unclassified"}]},{"critic":"محمد بن سعد","statements":[{"text":"قال ابن سعد قليل الحديث نقلته من خط الشريف الحسيني","citation":"لسان الميزان (4/ 381)","pageId":551046,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع ابن مسعود، روى عنه الشعبي وجبلة بن سحيم، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 328)","pageId":706896,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع ابن مسعود، روى عنه الشعبي وجبلة بن سحيم، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 328)","pageId":706896}]}],"flags":[]},"13203":{"id":13203,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \"الثقات\"، وقال: كان من عباد أهل البصرة وقرائهم، يروي عن أبي بكرة إن كان سمع منه، روى عنه هارون النحوي. مات سنة 129","citation":"لسان الميزان (4/ 372)","pageId":551004,"verdict":