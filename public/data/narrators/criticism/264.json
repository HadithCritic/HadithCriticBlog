08)","pageId":550262,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"مقل، لا يقبل ما انفرد به","citation":"لسان الميزان (4/ 208)","pageId":550262,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13232":{"id":13232,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"[له] كلمات نافعة، ومواعظ حسنة; وقدم راسخ في الطريق","citation":"سير أعلام النبلاء (13/ 330)","pageId":726592,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13236":{"id":13236,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو زرعة الرازي","statements":[{"text":"حدثنا عبد الرحمن، قال: سئل أبو زرعة عنه فقال: لا بأس به وبأخيه سحاج من موسى","citation":"الجرح والتعديل لابن أبي حاتم (4/ 321)","pageId":697235,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"13237":{"id":13237,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الأزدي","statements":[{"text":"قال الأزدي: لا يصح حديثه","citation":"لسان الميزان (4/ 180)","pageId":550108,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"وقال العقيلي: مجهول، وحديثه غير محفوظ","citation":"لسان الميزان (4/ 180)","pageId":550108,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"وفي استدلاله بما ذكر لعدم صحته نظر","citation":"لسان الميزان (4/ 180)","pageId":550108,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13239":{"id":13239,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"حدثنا عبد الرحمن قال: سئل أبي عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (4/ 147)","pageId":695582,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13242":{"id":13242,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارق