l"},{"text":"وكان ثقة صاحب أخبار وآداب وملح","citation":"تاريخ بغداد (11/ 204)","pageId":827043,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12078":{"id":12078,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"العقيلي","statements":[{"text":"ذكره العقيلي في الضعفاء","citation":"لسان الميزان (4/ 539)","pageId":551691,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12079":{"id":12079,"criticCount":2,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: كان يضع الحديث","citation":"لسان الميزان (4/ 539)","pageId":551689,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"ومن مصائبه: عن عفان، عن شعبة، عن عاصم، عن أبي رزين، عن ابن عباس - رضي الله عنهما - حديث: \" لاتقتل المرأة إذا ارتدت \". رواه عبد الصمد بن علي الطستي","citation":"لسان الميزان (4/ 539)","pageId":551689,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"12087":{"id":12087,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"أخبرنا أبو عبد الله الحسين بن علي بن بطحا المحتسب، قال: أخبرنا محمد بن عبد الله الشافعي بإسناده مثله، إلا أنه قال: حدثنا العباس بن سفيان، وحرمي بن عمارة عن شعبة، والأول أصح، والله أعلم","citation":"تاريخ بغداد (11/ 309)","pageId":827199,"verdict":"unclassified"},{"text":"كان ممن عني بطلب الحديث والآثار، ورحل في ذلك، وجالس الحفاظ، وكتب عنهم","citation":"تاريخ بغداد (11/ 309)","pageId":827199,"verdict":"unclassified"},{"text":"وكان ثقة","citation":"تاريخ بغداد (11/ 309)","pageId":827199,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12092":{"id":12092,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وثقه الخطيب","citation":"تاريخ الإسلام (6/ 564)","pageId":635379,"verdict":"tadil"},{"text":"وكان ثقة","citation":"تاريخ بغداد (11/ 287)","pageId":827163,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12094":{"id":12094,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"عن أبيه، عن جده، فرفع خطبة منكرة، وفيه جهالة، انتهى. والحديث في \" سنن الدارقطني \" من طريق مصعب بن زيد بن خالد الجهني","citation":"لسان الميزان (5/ 16)","pageId":551934,"verdict":"unclassified"}]},{"critic":"ابن القطان الفاسي","statements":[{"text":"وقال الحكيم الترمذي في \" نوادر الأصول \"، في الأصل الثاني والأربعين بعد المائتين: حدثنا أبي، حدثنا عبد الله بن نافع الزبيري، عن عبد الله بن مصعب بن زيد بن خالد الجهني، عن أبيه، عن جده قال: استلقفت هذه الخطبة من فم رسول الله - صلى الله عليه وسلم - بتبوك، فذكر منها قوله - صلى الله عليه وسلم -: \" خير ما ألقي في القلب اليقين \". وقد جهل ابن القطان عبد الله بن مصعب وأباه. روى عن عبد الله بن مصعب المذكور عبد الله بن نافع","citation":"لسان الميزان (5/ 16)","pageId":551934,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12097":{"id":12097,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: مجهول","citation":"الجرح والتعديل لابن أبي حاتم (9/ 84)","pageId":717533,"verdict":"jarh"}]}],"phenomena":[],"flags":[]}}