راشد","statements":[{"text":"وحدثني الخلال أن يوسف ذكره في جملة شيوخه الثقات","citation":"تاريخ بغداد (2/ 304)","pageId":817113,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"سمع: محمد بن الوليد البسري، والحسن بن أبي الربيع، ويوسف بن موسى","citation":"تاريخ الإسلام (7/ 373)","pageId":640608,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع: محمد بن الوليد البسري، والحسن بن أبي الربيع، ويوسف بن موسى","citation":"تاريخ الإسلام (7/ 373)","pageId":640608}]}],"flags":[]},"11979":{"id":11979,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"والدارقطني ووثقه","citation":"تاريخ الإسلام (7/ 511)","pageId":641323,"verdict":"tadil"},{"text":"أخبرنا أبو بكر البرقاني، قال: أخبرنا علي بن عمر الحافظ، قال: محمد بن أحمد بن هارون العسكري ثقة","citation":"تاريخ بغداد (2/ 241)","pageId":816962,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"كان يتفقه لأبي ثور","citation":"تاريخ الإسلام (7/ 511)","pageId":641323,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11980":{"id":11980,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (2/ 252)","pageId":817000,"verdict":"tadil"},{"text":"ووثقه الخطيب","citation":"تاريخ الإسلام (7/ 824)","pageId":643210,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"11981":{"id":11981,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"أحاديث مستقيمة","citation":"تاريخ بغداد (2/ 70)","pageId":816499,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"أحاديثه مستقيمة","citation":"تاريخ الإسلام (7/ 912)","pageId":643733,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11988":{"id":11988,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"إسماعيل بن علي بن إسماعيل الخطبي","statements":[{"text":"أخبرنا إبراهيم بن مخلد، قال: أخبرنا إسماعيل بن علي، قال: وعزل محمد بن الحسن بن أبي الشوارب، عن جميع ما كان يتقلده من أعمال القضاء، وأمر أمير المؤمنين المستكفي بالله بالقبض عليه، ففعل ذلك في يوم الثلاثاء لخمس خلون من صفر سنة أربع وثلاثين وثلاثمائة، وكان قبيح الذكر فيما يتولاه من الأعمال، منسوبا إلى الاسترشاء في الأحكام، والعمل فيها بما لا يجوز، قد شاع ذلك عنه، وكثر الحديث به","citation":"تاريخ بغداد (2/ 601)","pageId":817610,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وكان أحد الأجواد. وكان قبيح الذكر فيما تولاه، قد شاع ذلك. توفي في رمضان عن نيف وسبعين سنة. وكان هو يولي قضاء مصر من يختار، ويكتب إليه بعهده، وكذا إلى ما دون مصر كدمشق وغيرها. وقد عزل عن القضاء قبل موته بمدة. وكان جده قاضي مدينة أبي جعفر المنصور ؛ وهو من بيت الحشمة والقضاء","citation":"تاريخ الإسلام (7/ 857)","pageId":643382,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11993":{"id":11993,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"فيه لين","citation":"تاريخ الإسلام (7/ 556)","pageId":641652,"verdict":"unclassified"}]},{"critic":"جخجخ أبو الفتح النحوي","statements":[{"text":"وبلغني عن أبي الفتح عبيد الله بن أحمد النحوي أنه ذكره، فقال: كان سيئ الحال في الحديث","citation":"تاريخ بغداد (3/ 30)","pageId":817743,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}