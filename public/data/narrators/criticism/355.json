ts":[{"text":"وقال عبد العزيز الكتاني: هو ثقة، نبيل، حافظ لمذهب الشافعي. ومات في ذي القعدة","citation":"تاريخ الإسلام (7/ 716)","pageId":642567,"verdict":"tadil"},{"text":"قال عبد العزيز الكتاني: هو ثقة نبيل حافظ لمذهب الشافعي","citation":"سير أعلام النبلاء (15/ 383)","pageId":727968,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"الفقيه","citation":"تاريخ الإسلام (7/ 716)","pageId":642567,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17772":{"id":17772,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"شيخ","citation":"الثقات (6/ 166)","pageId":597195,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17774":{"id":17774,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الحاكم","statements":[{"text":"قال الحاكم في ترجمة أبي علي: سألته عنه فقلت: إن أهل الحجاز يذكرون أنه سمع بعض \" الموطأ \" فحدث بالكل، فقال: ما كان إلا صدوقا، وما رأينا إلا خيرا، قرأ علينا \" الموطأ \" من أصل كتابه في القراطيس","citation":"لسان الميزان (3/ 103)","pageId":547246,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17776":{"id":17776,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي عن يزيد بن هارون، حدثنا عنه ابن خزيمة، يخطئ ويخالف. قاله ابن حبان في \" الثقات","citation":"لسان الميزان (8/ 85)","pageId":559227,"verdict":"tadil"},{"text":"يخطئ ويخالف","citation":"الثقات (9/ 189)","pageId":614696,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17781":{"id":17781,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال أبو سعد السمعاني كان شيخا صالحا يلقن الصبيان","citation":"سير أعلام النبلاء (19/ 419)","pageId":731198,"verdict":"unclassified"},{"text":"قال السمعاني: أجاز لنا وكان شيخا صالحا يلقن الصبيان","citation":"تاريخ الإسلام (11/ 210)","pageId":657313,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"الشيخ المسند، المقرئ الصالح، بقية المشيخة","citation":"سير أعلام النبلاء (19/ 419)","pageId":731198,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17782":{"id":17782,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"الإمام المحدث","citation":"سير أعلام النبلاء (18/ 578)","pageId":730656,"verdict":"unclassified"}]},{"critic":"خليفة بن محفوظ الأنباري","statements":[{"text":"قال السمعاني: سمعت خليفة بن محفوظ بالأنبار يقول: كان ابن أبي الصقر صواما قواما. سأله بعض الناس: كم مسموعات الشيخ ؟ قال: وقر جمل، سوى ما شذ عني. قال خليفة: وكان قد أصيب ببعضها","citation":"تاريخ الإسلام (10/ 397)","pageId":654370,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17783":{"id":17783,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"الثقة العالم","citation":"سير أعلام النبلاء (20/ 47)","pageId":731511,"verdict":"tadil"},{"text":"صالح خير صدوق مكثر","citation":"سير أعلام النبلاء (20/ 47)","pageId":731511,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17785":{"id":17785,"criticCount":1,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال ابن السمعاني: كان صدرا، مهيبا، وقورا، حاد الفراسة، دقيق النظر، ذا رأي وتدبير، ومعرفة بالأمور العظام، وكان شجاعا جريئا، خلع الراشد الذي استخلف بعد أن قتل أبوه المسترشد، وجمع الناس على خلعه، وعلى مبايعة المقتفي لأمر الله في يوم واحد، وكان الناس يتعجبون من ذلك، ولم يزل أمره مستقيما، وأحواله على الترقي إلى أن تغير عليه المقتفي لأمر الله، وأراد القبض عليه، فالتجأ إلى دار السلطان مسعود بن محمد، إلى أن قدم السلطان بغداد، فأمر بحمله إلى داره مكرما، وجلس في داره ملاصق دار الخلافة واشتغل بالعبادة، وكان طلق الوجه، دائم البشر، كثير التلاوة والصلاة ؛ وكل من كان له عليه رسم وإدرار من القراء والصلحاء كان يوصله إليهم بعد العزل، إلى أن توفاه الله حميدا مكرما، قرأت عليه الكثير من الكتب والأجزاء، وكنت ألازمه، وأحضر مجلسه مرتين في الأسبوع، أقرأ عليه، وكان يكرمني غاية الإكرام ويخرج لي الأجزاء والأصول، وتوفي في أول رمضان، ودفن في داره، ثم نقل إلى تربته بالحربية سنة أربع وأربعين","citation":"تاريخ الإسلام (11/ 687)","pageId":659637,"verdict":"jarh"},{"text":"قال السمعاني: كان علي بن طراد صدرا مهيبا وقورا، دقيق النظر، حاد الفراسة، عارفا بالأمور السنية العظام، شجاعا جريئا","citation":"سير أعلام النبلاء (20/ 149)","pageId":731649,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17788":{"id":17788,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حزم","statements":[{"text":"قال ابن حزم: لا يدري أحد من هو","citation":"لسان الميزان (1/ 392)","pageId":542860,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17789":{"id":17789,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول ذلك ويقول: لا بأس به","citation":"الجرح والتعديل لابن أبي حاتم (2/ 111)","pageId":683832,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}