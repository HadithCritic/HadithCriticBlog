9":{"id":2039,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا تعرف","citation":"تقريب التهذيب (1/ 1355)","pageId":530572,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"2045":{"id":2045,"criticCount":6,"statementCount":7,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":6},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة بصري، أبو الوازع روت عنه امرأة من صباح عبد القيس يقال لها أم أبان بنت الوازع بن الزارع، عن جدها زارع، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (3/ 618)","pageId":694176,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وفد على النبي صلى الله عليه وآله وسلم. وروى عنه في قصة أشج عبد القيس، وعداده في أعراب البصرة","citation":"تهذيب التهذيب (1/ 619)","pageId":468822,"verdict":"unclassified"},{"text":"صحابي","citation":"تقريب التهذيب (1/ 333)","pageId":511103,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"له وفادة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 410)","pageId":493138,"verdict":"unclassified"}]},{"critic":"مغلطاي","statements":[{"text":"وفد على النبي صلى الله عليه وسلم وروى عنه في « الحلم والأناة ». كذا ذكره المزي، ويفهم منه تفرده بهذا الحديث، وليس كذلك لما ذكره أبو نعيم الحافظ: أنه قال: قلت يا رسول الله إن معي ابنا لي أو ابن أخت لي مجنون أتيتك به لتدعو له، ففعل. فذكر حديثا طويلا في كيفية سلامته من ذاك الجن. وسمى الباوردي ابنه المجنون مطرا وابن أخيه أشج فلامه عليهما الأشج","citation":"إكمال تهذيب الكمال (5/ 22)","pageId":534643,"verdict":"jarh"}]},{"critic":"ابن عبد البر","statements":[{"text":"وقال ابن عبد البر: ويقال الزارع بن الوازع، والأول أولى بالصواب - يعني ابن عامر - وله ابن يقال له: الوازع وبه كان يكنى، وحديثه حسن","citation":"إكمال تهذيب الكمال (5/ 22)","pageId":534643,"verdict":"unclassified"}]},{"critic":"الأزدي","statements":[{"text":"ذكر الأزدي أنها تفردت بالرواية عنه","citation":"تهذيب التهذيب (1/ 619)","pageId":468822,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"2047":{"id":2047,"criticCount":4,"statementCount":6,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":6},"critics":[{"critic":"ابن حبان","statements":[{"text":"كان ممن بايع تحت الشجرة","citation":"الثقات (3/ 143)","pageId":583714,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"كان من أصحاب الشجرة","citation":"الإصابة في تمييز الصحابة (4/ 5)","pageId":420269,"verdict":"unclassified"},{"text":"وعنه: ابنه مجزأة، وفي حديثه أنه شهد الحديبية وخيبر. قلت: ذكر مسلم وغيره أنه تفرد عنه","citation":"تهذيب التهذيب (1/ 620)","pageId":468828,"verdict":"unclassified"},{"text":"صحابي","citation":"تقريب التهذيب (1/ 333)","pageId":511107,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"حديبي","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 410)","pageId":493142,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"له صحبة، وكان ممن بايع تحت الشجرة","citation":"تهذيب الكمال (9/ 270)","pageId":444793,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}