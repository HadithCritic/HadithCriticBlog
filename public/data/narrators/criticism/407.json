mentCount":3,"tally":{"jarh":2,"tadil":0,"mixed":1,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \"الثقات\" في التابعين، فقال: الحنفي روى عنه أهل اليمامة فمقتضى ذكره له في التابعين أن يكون شيخه أبو موسى هذا هو الأشعري، وليس في كتاب ابن أبي حاتم أن شيخ طريف مجهول","citation":"لسان الميزان (4/ 351)","pageId":550899,"verdict":"mixed"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن: أبي موسى. روى عنه... سمعت أبي يقول: هما مجهولان","citation":"الجرح والتعديل لابن أبي حاتم (4/ 493)","pageId":698881,"verdict":"jarh"},{"text":"مجهول، وكذا شيخه","citation":"لسان الميزان (4/ 351)","pageId":550899,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20359":{"id":20359,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"العقيلي","statements":[{"text":"لا يعرف أتى بخبر منكر، عن ابن جريج، عن نافع، عن ابن عمر رضي الله عنهما مرفوعا \" من شاب شيبة في الإسلام كانت له نورا يوم القيامة \" قال العقيلي: لا يتابع عليه، وفي الباب أسانيد صالحة، انتهى. وزاد: مجهول بالنقل حديثه خطأ","citation":"لسان الميزان (4/ 350)","pageId":550888,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20365":{"id":20365,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"ضعفه أبو حاتم، انتهى. وقال: هو مثل يزيد بن عياض","citation":"لسان الميزان (5/ 539)","pageId":553925,"verdict":"jarh"},{"text":"سمعت أبي يقول ذلك، وسألته عنه فقال: هو مثل يزيد بن عياض في الضعف","citation":"الجرح والتعديل لابن أبي حاتم (6/ 185)","pageId":705160,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"وقال العقيلي: مجهول، وحديثه غير محفوظ، ولا يتابعه إلا من هو دونه، ثم ساقه من طريقه عن يحيى، عن سعيد بن المسيب، عن ربيعة بن أكتم في السواك: كان يستاك عرضا ويشرب مصا... الحديث، وقال: لا يصح","citation":"لسان الميزان (5/ 539)","pageId":553925,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20368":{"id":20368,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"نا عبد الرحمن، أنا عبد الله بن أحمد [بن محمد] بن حنبل فيما كتب إلي، قال: قال أبي: عبد الملك بن أبي كثيرة شيخ ثقة، ليس به بأس","citation":"الجرح والتعديل لابن أبي حاتم (5/ 365)","pageId":702523,"verdict":"tadil"}]},{"critic":"يحيى القطان","statements":[{"text":"نا عبد الرحمن، نا صالح بن أحمد [بن محمد] بن حنبل، نا علي - يعني ابن المديني - قال: قلت ليحيى بن سعيد القطان: عبد الملك بن أبي كثيرة ؟ قال: لم يكن به بأس","citation":"الجرح والتعديل لابن أبي حاتم (5/ 365)","pageId":702523,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"نا [عباس بن محمد الدوري قال: سمعت يحيى بن معين يقول: عبد الملك بن أبي كثيرة] بصري ثقة. روى عنه عبد الوارث، ويحيى بن سعيد، وأبو عبيدة الحداد","citation":"الجرح والتعديل لابن أبي حاتم (5/ 365)","pageId":702523,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20370":{"id":20370,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":1,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"عن مالك، وغيره ليس بثقة، ولا مأمون فمن بلاياه قال: حدثنا العمري، عن نافع، عن ابن عمر رضي الله عنهما، قال: صليت خلف النبي صلى الله عليه وسلم، وأبي بكر، وعمر فجهروا ببسم الله الرحمن الرحيم","citation":"لسان الميزان (4/ 346)","pageId":550872,"verdict":"mixed"}]}],"phenomena":[],"flags":[]},"20372":{"id":20372,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وقد ذكره ابن حبان في \" الثقات \"، وساق له هذا الحديث مختصرا","citation":"لسان الميزان (4/ 99)","pageId":549827,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وأنا أحسبه سلاما الطويل الواهي","citation":"لسان الميزان (4/ 99)","pageId":549827,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20376":{"id":20376,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"cri