{"16850":{"id":16850,"criticCount":2,"statementCount":7,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":7},"critics":[{"critic":"الذهبى","statements":[{"text":"، وبالغ في الطلب إلى الغاية","citation":"سير أعلام النبلاء (17/ 570)","pageId":729882,"verdict":"unclassified"},{"text":"الشيخ الإمام، الحافظ الكبير، المصنف","citation":"سير أعلام النبلاء (17/ 570)","pageId":729882,"verdict":"unclassified"},{"text":"محدث هراة، وصاحب التواليف الكثيرة","citation":"سير أعلام النبلاء (17/ 570)","pageId":729882,"verdict":"unclassified"},{"text":"الإمام الجليل، محدث هراة","citation":"تاريخ الإسلام (9/ 458)","pageId":650822,"verdict":"unclassified"},{"text":"وكان ممن يرجع إليه في العلل، والجرح والتعديل","citation":"سير أعلام النبلاء (17/ 570)","pageId":729882,"verdict":"unclassified"}]},{"critic":"عبد الرحمن بن عبد الجبار الشروطي","statements":[{"text":"قال أبو النضر الفامي: حتى أن عدد شيوخه زاد على ألف ومائتي نفس، وله \" تاريخ السنين \" الذي صنفه في وفاة أهل العلم، من زمان رسول الله - صلى الله عليه وسلم - إلى سنة وفاته سنة تسع وعشرين، ومنها: كتاب \" نسيم المهج \"، وكتاب \" الأنس والسلوة \"، وكتاب \" شمائل العباد \". قال: وكان زاهدا مقلا من الدنيا","citation":"تاريخ الإسلام (9/ 458)","pageId":650822,"verdict":"unclassified"},{"text":"قال أبو النضر الفامي: زاد عدد شيوخه على ألف ومائتين","citation":"سير أعلام النبلاء (17/ 570)","pageId":729882,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16853":{"id":16853,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان من وجوه أهل بلده","citation":"تاريخ الإسلام (9/ 413)","pageId":650598,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16854":{"id":16854,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان شيخ صدق","citation":"سير أعلام النبلاء (15/ 519)","pageId":728149,"verdict":"unclassified"},{"text":"وكان صادقا","citation":"تار