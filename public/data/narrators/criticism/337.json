":16886,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن يونس المصري","statements":[{"text":"قال ابن يونس: كان رجلا صالحا، ثقة، ثبتا، متقللا، فقيرا، لم يكن يقبل من أحد شيئا","citation":"تاريخ الإسلام (7/ 330)","pageId":640307,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"القدوة الحجة","citation":"سير أعلام النبلاء (14/ 519)","pageId":727479,"verdict":"tadil"},{"text":"وكان رجلا صالحا، متقللا، فقيرا، لا يقبل من أحد شيئا، وكان ثقة ثبتا","citation":"سير أعلام النبلاء (14/ 519)","pageId":727479,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16887":{"id":16887,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال السمعاني: ثقة، صالح","citation":"تاريخ الإسلام (11/ 46)","pageId":656584,"verdict":"tadil"},{"text":"قال السمعاني: ثقة صالح","citation":"سير أعلام النبلاء (19/ 254)","pageId":731027,"verdict":"tadil"}]},{"critic":"أبو طاهر السلفي","statements":[{"text":"وقال السلفي في معجمه: كاتب، رئيس في الفضل على غاية من الجلالة","citation":"تاريخ الإسلام (11/ 46)","pageId":656584,"verdict":"unclassified"},{"text":"وقال السلفي: كاتب رئيس على غاية من الجلالة","citation":"سير أعلام النبلاء (19/ 254)","pageId":731027,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"الشيخ العالم، الثقة الجليل، مسند أصبهان","citation":"سير أعلام النبلاء (19/ 254)","pageId":731027,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16891":{"id":16891,"criticCount":2,"statementCount":5,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان صحيح السماع، وبعض سماعاته في الخامسة","citation":"تاريخ الإسلام (13/ 467)","pageId":668100,"verdict":"unclassified"},{"text":"الشيخ الفاضل المسند","citation":"سير أعلام النبلاء (22/ 90)","pageId":732885,"verdict":"unclassified"},{"text":"وسماعه صحيح، لكن غالبه في السنة الخامسة","citation":"سير أعلام النبلاء (22/ 90)","pageId":732885,"verdict":"unclassified"}]},{"critic":"محمد بن محمود ابن النجار البغدادي","statements":[{"text":"قال ابن النجار: كان أبوه ديوانيا فاعتنى به، وكان متيقظا متوددا صحيح السماع، له مروءة ونفس حسنة يحدث من أصوله","citation":"سير أعلام النبلاء (22/ 90)","pageId":732885,"verdict":"unclassified"},{"text":"قال ابن النجار: كان أبوه يتولى كتابة من قبل الديوان، فأسمعه، واعتنى به، وحصل له الأجزاء. وكان حسنا، متيقظا، صحيح السماع، متوددا، له مروءة، ونفس حسنة. يحدث من أصوله. روى عنه شيخنا أبو محمد بن قدامة في \" معجمه \"","citation":"تاريخ الإسلام (13/ 467)","pageId":668100,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16895":{"id":16895,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"الفقيه المفتي","citation":"تاريخ الإسلام (13/ 58)","pageId":666369,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16897":{"id":16897,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":4,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"وقال السمعاني: صدوق صالح، حسن السيرة بكتاب الله، يأكل من كد يده، كتبت عنه","citation":"سير أعلام النبلاء (20/ 354)","pageId":731960,"verdict":"tadil"},{"text":"قال ابن السمعاني: هو شيخ صدوق، قيم بكتاب الله، يأكل من كد يده، كتبت عنه","citation":"تاريخ الإسلام (12/ 114)","pageId":661797,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وكان قيما بالروايات ومعرفتها، ثبتا، صالحا، حسن الطريقة","citation":"تاريخ الإسلام (12/ 114)","pageId":661797,"verdict":"tadil"}]},{"critic":"محمد بن محمود ابن النجار البغدادي","statements":[{"text":"قال ابن النجار: كان ثبتا صدوقا، قيما بمعرفة القراءات","citation":"سير أعلام النبلاء (20/ 354)","pageId":731960,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16898":{"id":16898,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان ورعا قان