"flags":[]},"12160":{"id":12160,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"أحمد بن الحجاج بن الصلت، عن سعدويه بإسناد الصحاح مرفوعا: \" يختم هذا الأمر بغلام من ولدك يا عم يصلي بعيسى ابن مريم \" رواه عنه محمد بن مخلد العطار، فأحمد آفته، والعجب أن الخطيب ذكره في تاريخ بغداد، ولم يضعفه، وكأنه سكت عنه لانهتاك حاله، مات سنة اثنتين وستين ومائتين، انتهى. والسند الذي أشار إليه أنه قال: حدثنا سعيد بن سليمان، حدثنا خلف بن خليفة، عن مغيرة، عن إبراهيم، عن علقمة، عن عمار بن ياسر به","citation":"لسان الميزان (1/ 425)","pageId":543028,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"12162":{"id":12162,"criticCount":2,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وقال الخطيب: منكر الحديث","citation":"لسان الميزان (1/ 431)","pageId":543048,"verdict":"jarh"}]},{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: ليس بثقة","citation":"لسان الميزان (1/ 431)","pageId":543048,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"12163":{"id":12163,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"سمع منه أبي، وسمعت معه، وهو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (2/ 48)","pageId":683209,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12164":{"id":12164,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الدارقطني","statements":[{"text":"وذكره الدارقطني، فقال: لا بأس به","citation":"تاريخ بغداد (5/ 156)","pageId":820627,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12166":{"id":12166,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"وثقه الدارقطني","citation":"تاريخ الإسلام (7/ 353)","pageId":640479,"verdict":"tadil"},{"text"