:"tadil"}]},{"critic":"الذهبى","statements":[{"text":"بغدادي ثقة، سمع مصعب بن المقدام، وعنه محمد بن مخلد","citation":"تاريخ الإسلام (6/ 269)","pageId":633807,"verdict":"tadil"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"بغدادي ثقة، سمع مصعب بن المقدام، وعنه محمد بن مخلد","citation":"تاريخ الإسلام (6/ 269)","pageId":633807}]}],"flags":[]},"12193":{"id":12193,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"مغلطاي","statements":[{"text":"سمع: منصور بن أبي مزاحم","citation":"إكمال تهذيب الكمال (1/ 88)","pageId":531466,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع: منصور بن أبي مزاحم","citation":"إكمال تهذيب الكمال (1/ 88)","pageId":531466}]}],"flags":[]},"12195":{"id":12195,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وروى ابن حبان، عن إبراهيم بن سعيد، عن أحمد بن علي بن سلمان هذا، عن سعيد بن عبد الرحمن المخزومي، عن ابن عيينة بسند صحيح، عن زيد بن ثابت مرفوعا: \" من قرأ خلف الإمام فلا صلاة له \". وقال: هذا باطل، وأحمد بن علي بن سلمان لا نشتغل به، حكاه عنه ابن الجوزي في \" العلل \"","citation":"لسان الميزان (1/ 538)","pageId":543458,"verdict":"unclassified"}]},{"critic":"الدارقطني","statements":[{"text":"ضعفه الدارقطني، فقال: يضع الحديث، انتهى. ولفظ الدارقطني: يروي عن إبراهيم بن المنذر، والمدنيين. روى عنه محمد بن مخلد، وإبراهيم بن سليمان الدهان المروزي. ذكره الخطيب","citation":"لسان الميزان (1/ 538)","pageId":543458,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"12196":{"id":12196,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الدارقطني","statements":[{"text":"حدثني عبيد الله بن أبي الفتح، عن أبي الحسن الدارقطني، قال: أحمد بن علي العمي بصري، كان بالعسكر ثقة","citation":"تاريخ بغداد (5/ 494)","pageId":821331,"verdict":"tadil"},{"text":"وثقه الدارقطني","citation":"تاريخ الإسلام (6/ 29)","pageId":632541,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12199":{"id":12199,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: كذاب","citation":"لسان الميزان (1/ 569)","pageId":543588,"verdict":"jarh"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"ذكره ابن أبي حاتم في الجرح والتعديل، فقال: روى عن أبيه، وابن أبي فديك. وعنه أبو يونس المدني، ولم يذكر فيه جرحا، ولا تعديلا","citation":"لسان الميزان (1/ 569)","pageId":543588,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}