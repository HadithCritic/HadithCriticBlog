{"12152":{"id":12152,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"قد وثقه - يعني أحمد - الدارقطني","citation":"لسان الميزان (1/ 449)","pageId":543130,"verdict":"tadil"}]},{"critic":"ابن القطان الفاسي","statements":[{"text":"أحمد بن خالد بن عمرو بن خالد الحمصي، عن أبيه، قال ابن القطان: لا أعرفهما، وحديثهما في الدارقطني","citation":"لسان الميزان (1/ 449)","pageId":543130,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12153":{"id":12153,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":2,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"ذكرته لأن المصنف ذكر عثمان بن أحمد الدقاق [5101] الصدوق الثقة بسبب كونه يروي المناكير","citation":"لسان الميزان (6/ 511)","pageId":556241,"verdict":"mixed"}]},{"critic":"البرقاني","statements":[{"text":"قال الخطيب: سألت البرقاني عنه فقال: ثقة، إلا أنه يروي مناكير","citation":"لسان الميزان (6/ 511)","pageId":556241,"verdict":"mixed"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"قال الخطيب: وقد اعتبرت أنا حديثه، فقل ما رأيت فيه منكرا","citation":"لسان الميزان (6/ 511)","pageId":556241,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12155":{"id":12155,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"سمع: علي بن حجر، وأحمد بن منيع، وجماعة","citation":"تاريخ الإسلام (6/ 876)","pageId":637152,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع: علي بن حجر، وأحمد بن منيع، وجماعة","citation":"تاريخ الإسلام (6/ 876)","pageId":637152}]}],"flags":[]},"12158":{"id":12158,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في الثقات","citation":"لسان الميزان (1/ 424)","pageId":543022,"verdict":"tadil"}]},{"critic":"ابن القطان الفاسي","statements":[{"text":"أحمد بن الحارث عن الصقر بن حبيب، بحديث علي: \" ليس في العوامل صدقة \" رواه الدارقطني في السنن، قال ابن القطان: أحمد مجهول كشيخه","citation":"لسان الميزان (1/ 424)","pageId":543022,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"ويحتمل أن يكون هو الغساني [343] فقد ذكر ابن القطان أنه رآه في عدة نسخ من كتاب الدارقطني: أحمد بن الحارث البصري، بالباء الموحدة","citation":"لسان الميزان (1/ 424)","pageId":543022,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12159":{"id":12159,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن عدي","statements":[{"text":"صاحب ذاك الجزء الذي رواه عنه ابن لهيعة لا يعرف ولكنها نسخة حسنة الحال، لم يرو عنه سوى ابن لهيعة، مات شابا بمصر، ولم أورده إلا لذكر ابن عدي له، وقال: عامة أحاديثه مستقيمة","citation":"لسان الميزان (1/ 449)","pageId":543128,"verdict":"jarh"},{"text":"ليس بالمعروف، يحدث عنه ابن لهيعة، ويحدث أحمد هذا، عن عمر بن دينار، وعبد الله بن دينار، وعطاء، وابن المنكدر، وصفوان بن سليم بأحاديث عامتها مستقيمة. أنبأناه بذلك محمد بن موسى الحضرمي، عن روح بن الفرج، عن يحيى بن عبد الله بن بكير، عن ابن لهيعة عنه","citation":"الكامل في الضعفاء (1/ 274)","pageId":574218,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"صاحب ذاك الجزء الذي رواه عنه ابن لهيعة لا يعرف ولكنها نسخة حسنة الحال، لم يرو عنه سوى ابن لهيعة، مات شابا بمصر، ولم أورده إلا لذكر ابن عدي له، وقال: عامة أحاديثه مستقيمة","citation":"لسان الميزان (1/ 449)","pageId":543128,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"12162":{"id":12162,"criticCount":2,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وقال الخطيب: منكر الحديث","citation":"لسان الميزان (1/ 431)","pageId":543048,"verdict":"jarh"}]},{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: ليس بثقة","citation":"لسان الميزان (1/ 431)","pageId":543048,"verdict":"jarh"}]}],"phe