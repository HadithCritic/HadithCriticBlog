d"}]},{"critic":"ابن عدي","statements":[{"text":"ليس بالمعروف","citation":"الكامل في الضعفاء (5/ 471)","pageId":576614,"verdict":"unclassified"},{"text":"قال ابن عدي: وعبد الرحمن بن يوسف ليس بمعروف، وهذا الحديث منكر عن الأعمش بهذا الإسناد، ولا أعرف لعبد الرحمن بن يوسف غيره","citation":"الكامل في الضعفاء (5/ 471)","pageId":576614,"verdict":"unclassified"},{"text":"قال ابن عدي وغيره: لا يعرف","citation":"لسان الميزان (5/ 149)","pageId":552472,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"وقال العقيلي: مجهول في النسبة والرواية، وحديثه غير محفوظ، ولا يعرف إلا به","citation":"لسان الميزان (5/ 149)","pageId":552472,"verdict":"jarh"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"روى عن النبي صلى الله عليه وسلم، مرسل","citation":"الجرح والتعديل لابن أبي حاتم (5/ 301)","pageId":701905}]}],"flags":["Sends Mursal Reports"]},"21323":{"id":21323,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سئل أبي عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (8/ 84)","pageId":712511,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21325":{"id":21325,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"جهله أبو حاتم","citation":"لسان الميزان (3/ 555)","pageId":549320,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21331":{"id":21331,"criticCount":3,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: في \" غرائب مالك \" حدثنا: الوزير أبو الفضل جعفر بن الفضل بن الفرات، حدثنا محمد بن موسى بن يعقوب، حدثنا النسائي، أخبرنا محمد بن علي بن حرب المروزي، حدثنا أبو يحيى عبد الحكم المروزي، وكان ضعيفا، عن مالك، عن نافع، عن ابن عمر رفعه: \" الناس شركاء في الماء والكلأ والملح والنار \". ثم قال: هو عبد الحكم بن ميسرة أبو يحيى، يحدث بمالا يتابع عليه، أخرجه أبو عبد الرحمن - يعني النسائي - في كتاب \" الضعفاء \"","citation":"لسان الميزان (5/ 66)","pageId":552142,"verdict":"jarh"}]},{"critic":"النسائي","statements":[{"text":"قال الدارقطني: في \" غرائب مالك \" حدثنا: الوزير أبو الفضل جعفر بن الفضل بن الفرات، حدثنا محمد بن موسى بن يعقوب، حدثنا النسائي، أخبرنا محمد بن علي بن حرب المروزي، حدثنا أبو يحيى عبد الحكم المروزي، وكان ضعيفا، عن مالك، عن نافع، عن ابن عمر رفعه: \" الناس شركاء في الماء والكلأ والملح والنار \". ثم قال: هو عبد الحكم بن ميسرة أبو يحيى، يحدث بمالا يتابع عليه، أخرجه أبو عبد الرحمن - يعني النسائي - في كتاب \" الضعفاء \"","citation":"لسان الميزان (5/ 66)","pageId":552142,"verdict":"jarh"}]},{"critic":"أبو موسى المديني","statements":[{"text":"قال أبو موسى المديني: لا أعرفه بجرح ولا تعديل، انتهى. وقد عرفه غيره","citation":"لسان الميزان (5/ 66)","pageId":552142,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21333":{"id":21333,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (4/ 373)","pageId":697708,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21339":{"id":21339,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي عن: جماعة من التابعين، وأدرك واثلة بن الأسقع","citation":"الثقات (5/ 261)","pageId":592303,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع حذيفة، وروى عن معاوية وقد أدركه، وروى عن كعب، روى عنه فضيل بن فضالة وصفوان بن عمرو ويحيى بن حصين، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 382)","pageId":707602,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"يروي عن: جماعة من التابعين، وأدرك واثلة بن الأسقع","citation":"الثقات (5/ 261)","pageId":592303},{"text":"سمع حذيفة، ورو