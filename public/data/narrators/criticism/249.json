و حاتم الرازي","statements":[{"text":"سألت أبي عنه، فقال: هو مجهول، روى عن عبيد الله بن عمر حديثا موضوعا","citation":"الجرح والتعديل لابن أبي حاتم (6/ 14)","pageId":703115,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"من المجاهيل، والخبر منكر","citation":"لسان الميزان (5/ 71)","pageId":552163,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12471":{"id":12471,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"ولا أعلم فيه جرحا","citation":"تاريخ الإسلام (5/ 1165)","pageId":631749,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12475":{"id":12475,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان صدوقا","citation":"تاريخ بغداد (12/ 216)","pageId":827989,"verdict":"tadil"},{"text":"قال الخطيب: كان صدوقا، توفي سنة تسع وستين ومائتين","citation":"تاريخ الإسلام (6/ 359)","pageId":634345,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12477":{"id":12477,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن، قال: سألت أبي عن عبد العزيز بن أبي عثمان، فقال: ثقة","citation":"الجرح والتعديل لابن أبي حاتم (5/ 389)","pageId":702736,"verdict":"tadil"}]},{"critic":"عبد الرحمن بن الحكم الرازي","statements":[{"text":"نا عبد الرحمن، نا عبد الملك بن أبي عبد الرحمن المقري. نا عبد الرحمن - يعني ابن الحكم بن بشير -. نا عبد العزيز بن أبي عثمان، ولم أر مثله","citation":"الجرح والتعديل لابن أبي حاتم (5/ 389)","pageId":702736,"verdict":"unclassified"}]},{"critic":"وكيع بن الجراح","statements":[{"text":"نا عبد الرحمن، أنا أبو بكر بن أبي خيثمة فيما كتب إلي، قال: سمعت محمد بن يزيد - يعني الرفاعي - يقول: سمعت وكيعا يقول: عبد العزيز [بن أبي عثمان] أثبت من بقي اليوم في جامع سفيان، اذهبوا فاسمعوا منه","citation":"الجرح والتعديل لابن أبي حاتم (5/ 389)","pageId":702736,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12487":{"id":12487,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الدارقطني","statements":[{"text":"أخبرنا البرقاني، قال: سمعت أبا الحسن الدارقطني يقول: عبدوس بن بشر حدثونا عنه، لا بأس به، من أهل الري، حدث ببغداد قبل الستين، يعتبر به","citation":"تاريخ بغداد (12/ 418)","pageId":828404,"verdict":"tadil"},{"text":"قال الدارقطني: لا بأس به، يعتبر به","citation":"تاريخ الإسلام (6/ 119)","pageId":633138,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12488":{"id":12488,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"حدثت عن عبد العزيز بن جعفر الحنبلي، قال: أخبرنا أبو بكر الخلال، قال: وعبدوس بن مالك العطار كانت له عند أبي عبد الله، يعني أحمد بن حنبل، منزلة","citation":"تاريخ بغداد (12/ 417)","pageId":828397,"verdict":"unclassified"},{"text":"وأخبرني الحسن بن صالح العطار، قال: حدثنا هارون بن يعقوب الهاشمي، قال: سمعت أبي أنه سأل أبا عبد الله عن عبدوس العطار ؛ فقال: أكتب عنه ؟ قال: نعم، اكتب عنه","citation":"تاريخ بغداد (12/ 417)","pageId":828397,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12494":{"id":12494,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"شيخ","citation":"لسان الميزان (5/ 360)","pageId":553230,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}