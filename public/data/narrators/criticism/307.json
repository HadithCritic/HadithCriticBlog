{"15350":{"id":15350,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"ذكره الطبراني وأبو نعيم في الصحابة","citation":"الإصابة في تمييز الصحابة (5/ 413)","pageId":423446,"verdict":"unclassified"}]},{"critic":"الطبراني","statements":[{"text":"ذكره الطبراني وأبو نعيم في الصحابة","citation":"الإصابة في تمييز الصحابة (5/ 413)","pageId":423446,"verdict":"unclassified"}]},{"critic":"سعيد بن يعقوب الطالقاني","statements":[{"text":"وقال سعيد بن يعقوب: ليست له صحبة","citation":"الإصابة في تمييز الصحابة (5/ 413)","pageId":423446,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15353":{"id":15353,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو القاسم البغوي","statements":[{"text":"قال البغوي: سكن الشام. وروى هو والطبراني، وابن أبي خيثمة، وابن شاهين من طريق قيس بن مسلم السكوني، عن عائذ بن قرط، أن النبي - صلى الله عليه وسلم - قال: من صلى صلاة لم يتمها زيد فيها من سبحاته حتى تتم. وإسناده حسن","citation":"الإصابة في تمييز الصحابة (5/ 544)","pageId":423851,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15355":{"id":15355,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الطبراني","statements":[{"text":"ذكره الطبراني وغيره في الصحابة","citation":"الإصابة في تمييز الصحابة (5/ 518)","pageId":423772,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وهذا اختلف فيه على ثابت، ثم على سليمان، فأما ثابت فقال حماد بن سلمة عنه: عمرو بن عمير، وقال عمارة بن زاذان: عن ثابت: عمارة بن عمير، وقال الضحاك بن نبراس عنه: عمرو بن حزم، وأما سليمان فقيل عنه أيضا: عمرو أو عامر على الشك، واختلف في صحابي هذا المتن، فقيل عمرو الأنصاري، وقيل عمرو بن بلال، وقيل عمرو بن عمرو","citation":"الإصابة في تمييز الصحابة (5/ 518)","pageId":423772,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15356":{"id":15356,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"(قلت) : مات أبوه قبل فتح مكة، فله رؤية، إن لم يكن له صحبة","citation":"الإصابة في تمييز الصحابة (5/ 550)","pageId":423867,"verdict":"unclassified"}]},{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"ذكره ابن منده، وقال: له ذكر في الصحابة، ولا يعرف له رواية، ولا صحبة","citation":"الإصابة في تمييز الصحابة (5/ 550)","pageId":423867,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15357":{"id":15357,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"روى ابن منده من طريق قيس بن الربيع، عن عاصم بن سليمان، عن العباس مولى بني هاشم. قديم أدرك النبي - صلى الله عليه وسلم","citation":"الإصابة في تمييز الصحابة (5/ 582)","pageId":423984,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"روى ابن منده من طريق قيس بن الربيع، عن عاصم بن سليمان، عن العباس مولى بني هاشم. قديم أدرك النبي - صلى الله عليه وسلم","citation":"الإصابة في تمييز الصحابة (5/ 582)","pageId":423984}]}],"flags":[]},"15359":{"id":15359,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 256)","pageId":584458,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"قال البخاري: له صحبة","citation":"الإصابة في تمييز الصحابة (6/ 492)","pageId":425236,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15360":{"id":15360,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان: له صحبة","citation":"الإصابة في تمييز الصحابة (6/ 569)","pageId":425378,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15363":{"id":15363,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وقال ابن أبي حاتم: عبد الله بن شبل، وكان أحد النقباء، روى عنه أبو راشد الحبراني، ويزيد بن خمير","citation":"الإصابة في تمييز الصحابة (6/ 203)","pageId":424441,"verdict":"unclassified"}]},{"critic":"الحسين بن عيسى البسطامي","statements":[{"text":"وقال ابن عيسى فيمن نزل حمص من الصحابة: كان أحد النقباء","citation":"الإصابة في تمييز الصحابة (6/ 203)","pageId":424441,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15364":{"id":15364,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"البخاري","statements":[{"text":"وذكره البخاري في \" التاريخ \" فقال: روى عنه عبد الكريم، منقطع، قال: وأظنه أخا عبد الحميد بن عبد الرحمن بن زيد","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 748)","pageId":580064,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15367":{"id":15367,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في ثقات التابعين","citation":"الإصابة في تمييز الصحابة (8/ 165)","pageId":427819,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"15370":{"id":15370,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"له ذكر ورواية","citation":"الإصابة في تمييز الصحابة (7/ 204)","pageId":426181,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15371":{"id":15371,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الطبراني","statements":[{"text":"ذكره الطبراني في \"الصحابة \"","citation":"الإصابة في تمييز الصحابة (7/ 322)","pageId":426487,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15372":{"id":15372,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الطبراني","statements":[{"text":"ذكره الطبراني وغيره في الصحابة","citation":"الإصابة في تمييز الصحابة (7/ 488)","pageId":426982,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15373":{"id":15373,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"","citation":"لسان الميزان (6/ 194)","pageId":554804,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (6/ 194)","pageId":554804,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15374":{"id":15374,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو موسى المديني","statements":[{"text":"واستدركه أبو موسى","citation":"الإصابة في تمييز الصحابة (7/ 428)","pageId":426814,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15376":{"id":15376,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 286)","pageId":584624,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"ووقع في الموطأ رواية القعنبي: أن عويمر بن أشقر العجلاني، وقيل: إنه خطأ، وأن عويمر بن أشقر آخر مازني، وهو المذكور بعد. ولعل أحد آباء عويمر العجلاني كان يلقب أبيض، فأطلق عليه الراوي أشقر","citation":"الإصابة في تمييز الصحابة (7/ 563)","pageId":427235,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15389":{"id":15389,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"البخاري","statements":[{"text":"قال البخاري: ويقال: ابن عبد الله، نزل الشام، له صحبة","citation":"الإصابة في تمييز الصحابة (2/ 476)","pageId":417734,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15393":{"id":15393,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة. روى عنه: عبد الرحمن بن جبير المصري. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 309)","pageId":719665,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15395":{"id":15395,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"ذكره بعضهم في الصحابة لحديث أرسله","citation":"الإصابة في تمييز الصحابة (11/ 493)","pageId":434376,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15396":{"id":15396,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"روى عن النبي -صلى الله عليه وسلم - في سبأ. روى عنه علي بن رباح، كذا ذكره ابن أبي حاتم","citation":"الإصابة في تمييز الصحابة (11/ 397)","pageId":433963,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وقد قيل: إن يزيد هذا هو ولد الأمير الذي كان من قبل يزيد بن معاوية في وقعة الحرة وحصار مكة، وسيأتي في القسم الأخير، فيكون حديثه هذا مرسلا. والذي يظهر لي أنه غيره، فإن علي بن رباح من أقران حصين بن نمير، والد يزيد الأمير المذكور. والله أعلم","citation":"الإصابة في تمييز الصحابة (11/ 397)","pageId":433963,"verdict":"unclassified"},{"text":"وقوله: مصري. وهم، وإنما كان يقال: دخل مصر مع ابن مروان بن الحكم، فسمع منه علي بن رباح بها","citation":"الإصابة في تمييز الصحابة (11/ 397)","pageId":433963,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}