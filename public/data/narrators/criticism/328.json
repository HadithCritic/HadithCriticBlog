{"16409":{"id":16409,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"حدثنا عبد الرحمن، قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين قال: الحسن بن سالم بن أبي الجعد صالح","citation":"الجرح والتعديل لابن أبي حاتم (3/ 15)","pageId":688200,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16414":{"id":16414,"criticCount":3,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عنه فقال: مجهول","citation":"الجرح والتعديل لابن أبي حاتم (6/ 135)","pageId":704553,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"ووجدت عنه حديثا منكرا أخرجه أبو سعد السمان في معجم شيوخه قال: حدثنا أبو سعد علي بن محمد بن حامد البزار بقزوين، حدثنا علي بن عمر بن محمد بن أبي خالد، حدثنا محمد بن محمود بن نشيط قاضي أهل صنعاء، حدثنا محمد بن عبد الرحيم بن شروس، حدثنا عمر بن ميناء، عن أبيه عن عائشة قالت: \" اضطجع النبي صلى الله عليه وسلم مقيلا، فحانت الصلاة، فقامت عائشة لتوقظه، فخافت أن يجد عليها، ثم قامت الثانية فهابت، ثم قامت الثالثة فاستيقظ وهي قائمة على رأسه، فقال لها: ما لك ؟ قالت: حانت الصلاة وطال رقادك. فتوضأ وصلى ثم قال لها: تسأليني عن طول رقادي! إن أهل الجنة والنار عرضوا علي وإني استلبثت عبد الرحمن بن عوف حتى خشيت أن لا يمر بي فيمن يمر بي. فقالت عائشة: يا رسول الله، أي أهل الجنة أكثر، وأي أهل النار أقل ؟ قال: أكثرهم المساكين وأقلهم النساء. قالت: ما النساء في الجنة ؟ قال: كغراب أبيض في غربان سود \"","citation":"لسان الميزان (6/ 152)","pageId":554613,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"مجهول","citation":"لسان الميزان (6/ 152)","pageId":554613,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"16418":{"id":16418,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"حدث عنه أحمد البزي بحديث منكر","citation":"لسان الميزان (7/ 579)","pageId":558707,"verdict":"unclassified"},{"text":"نكرة كشيخه","citation":"لسان الميزان (7/ 579)","pageId":558707,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"ذكره العقيلي فقال: مدني مجهول بالنقل وشيخه الحسين بن صدقة بن يسار نحو منه، وحديثه غير محفوظ","citation":"لسان الميزان (7/ 579)","pageId":558707,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"16424":{"id":16424,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"وانفرد بأكثر مسموعاته، وعمر دهرا، وقصده الطلبة","citation":"سير أعلام النبلاء (20/ 263)","pageId":731826,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16429":{"id":16429,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن الجوزي","statements":[{"text":"قال ابن الجوزي كان ثقة","citation":"سير أعلام النبلاء (20/ 472)","pageId":732070,"verdict":"tadil"},{"text":"قال ابن الجوزي: كان ثقة","citation":"تاريخ الإسلام (12/ 290)","pageId":662447,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16436":{"id":16436,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"شيخ ثقة صدوق","citation":"تاريخ الإسلام (10/ 709)","pageId":655639,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16444":{"id":16444,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"العلامة، شيخ الشافعية","citation":"سير أعلام النبلاء (16/ 446)","pageId":728936,"verdict":"unclassified"}]},{"critic":"الحاكم","statements":[{"text":"قال الحاكم: كان أعرف الأصحاب بالمذهب وترتيبه. تفقه بأبي إسحاق وغيره، وعقد مجلس النظر، ومجلس الإملاء، فأملى زمانا","citation":"سير أعلام النبلاء (16/ 446)","pageId":728936,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16448":{"id":16448,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"حدث عنه سعد بن الصلت بحديث منكر","citation":"لسان الميزان (8/ 303)","pageId":560153,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: يخالف في حديثه، وليس بمشهور بالنقل، انتهى","citation":"لسان الميزان (8/ 303)","pageId":560153,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}