{"14900":{"id":14900,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"حدثنا عبد الرحمن قال: سئل أبي عنه فقال: صدوق","citation":"الجرح والتعديل لابن أبي حاتم (9/ 106)","pageId":717762,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"14903":{"id":14903,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"ورأيت في ثقات ابن حبان: هبيرة بن عبد الرحمن السلمي، يروي عن أنس بن مالك، عداده في أهل الشام، روى عنه أبو جعفر الرازي، فإن كان هو وإلا فيذكر للتمييز","citation":"لسان الميزان (8/ 329)","pageId":560270,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"ذكره المؤلف في المغني أن ابن عدي ذكره في الضعفاء فلم أره","citation":"لسان الميزان (8/ 329)","pageId":560270,"verdict":"unclassified"}]},{"critic":"ابن عدي","statements":[{"text":"ذكره المؤلف في المغني أن ابن عدي ذكره في الضعفاء فلم أره","citation":"لسان الميزان (8/ 329)","pageId":560270,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"14906":{"id":14906,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"نا عبد الرحمن، أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال: سألت أبي عن هشام بن كليب الذي يروي عنه: الثوري فقال: ثقة]","citation":"الجرح والتعديل لابن أبي حاتم (9/ 68)","pageId":717360,"verdict":"tadil"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات","citation":"لسان الميزان (8/ 342)","pageId":560332,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وعن قفيز الطحان هذا منكر، وراويه لا يعرف","citation":"لسان الميزان (8/ 342)","pageId":560332,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"14916":{"id":14916,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي