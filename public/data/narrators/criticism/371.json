{"18554":{"id":18554,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع السائب بن يزيد وسلمة بن الأكوع، روى عنه عكرمة بن عمار، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 339)","pageId":707014,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع السائب بن يزيد وسلمة بن الأكوع، روى عنه عكرمة بن عمار، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 339)","pageId":707014}]}],"flags":[]},"18558":{"id":18558,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"حدثنا عبد الرحمن قال: سألت أبي عنه، فقال: هو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (2/ 552)","pageId":688076,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18559":{"id":18559,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (3/ 510)","pageId":549141,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"وقد لينه العقيلي، وقد ذكر له هذا الحديث عن بهز، عن أبيه، عن جده مرفوعا: \" لا يرحم الله من لا يرحم الناس \"","citation":"لسان الميزان (3/ 510)","pageId":549141,"verdict":"unclassified"},{"text":"ونسبه العقيلي فقال: الناجي، وقال: حديثه غير محفوظ لا يتابع عليه","citation":"لسان الميزان (3/ 510)","pageId":549141,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18560":{"id":18560,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (1/ 409)","pageId":415295,"verdict":"unclassified"}]},{"critic":"الوليد بن سليمان بن أبي السائب","statements":[{"text":"وقال أبو عمر الكندي في كتاب \"الخندق\": حدثني يحيى بن أبي معاوي