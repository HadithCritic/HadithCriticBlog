{"13358":{"id":13358,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن السوادي أبو القاسم الأزهري","statements":[{"text":"سألت أبا القاسم الأزهري عن أبي أحمد الجريري، فقال: ما سمعت فيه إلا خيرا","citation":"تاريخ بغداد (2/ 252)","pageId":816998,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وهو شيخ من ولد جرير بن عبد الله","citation":"تاريخ الإسلام (7/ 512)","pageId":641327,"verdict":"unclassified"},{"text":"روى كتب المدائني عن أحمد بن الحارث عنه","citation":"تاريخ الإسلام (7/ 512)","pageId":641327,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13361":{"id":13361,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وثقه الخطيب","citation":"تاريخ الإسلام (6/ 940)","pageId":637510,"verdict":"tadil"},{"text":"وكان ثقة","citation":"تاريخ بغداد (8/ 637)","pageId":824982,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"13363":{"id":13363,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: ليس به بأس","citation":"الجرح والتعديل لابن أبي حاتم (7/ 209)","pageId":710484,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"13371":{"id":13371,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"عبد الله بن أحمد الجواليقي","statements":[{"text":"أورده عبدان في الصحابة","citation":"الإصابة في تمييز الصحابة (3/ 40)","pageId":418484,"verdict":"unclassified"}]},{"critic":"أحمد بن سيار المروزي","statements":[{"text":"وقال أحمد بن سيار: لم يذكروا له صحبة وهو كبير","citation":"الإصابة في تمييز الصحابة (3/ 40)","pageId":418484,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وروى ابن خزيمة ويعقوب بن شيبة وغيرهما من طريق نعيم بن أبي هند عن أبي حازم عن حسين بن خارجة، قال: أشكلت