24,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"10029":{"id":10029,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان في كتاب \" الثقات \": خالد بن كيسان يروي عن الربيع بنت معوذ. وعنه: أبو معاذ عيسى بن يزيد. قلت: وقال فيها أيضا: خالد بن كيسان يروي عن ابن عمر وابن الزبير، وعنه: أيوب بن ثابت، فهما عنده اثنان، وإنما اسم الذي يروي عن الربيع خالد بن ذكوان، وقد تقدم","citation":"تهذيب التهذيب (1/ 530)","pageId":468023,"verdict":"tadil"},{"text":"قال ابن حبان في كتاب \" الثقات \": خالد بن كيسان يروي عن الربيع بنت معوذ بن عفراء، روى عنه أبو معاذ عيسى بن يزيد","citation":"تهذيب الكمال (8/ 158)","pageId":444121,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 290)","pageId":510432,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10031":{"id":10031,"criticCount":2,"statementCount":3,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال فيه أبو حاتم: مجهول","citation":"تهذيب التهذيب (1/ 531)","pageId":468031,"verdict":"jarh"},{"text":"مجهول","citation":"لسان الميزان (9/ 294)","pageId":567391,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 291)","pageId":510440,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"10045":{"id":10045,"criticCount":2,"statementCount":3,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 300)","pageId":510584,"verdict":"jarh"},{"text":"روى له: ابن ماجه، عن يحيى بن عثمان، عن بقية، عن أبي حلبس، عن خليد بن أبي خليد، عن معاوية بن قرة، عن أبيه، حديث: \" من حضرته الوفاة فأوصى، فكانت وصيته على كتاب الله، كانت كفارته لما ترك من زكاته \". وقد روى بقية، عن خليد بن دعلج، عن معاوية بن قرة حديثا غير هذا، فكأن بقية دلسه في هذا الحديث لضعفه، فإن بقية معروف بذلك","citation":"تهذيب التهذيب (1/ 550)","pageId":468215,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"هكذا رواه يحيى بن عثمان عن بقية، وخالفه عيسى بن المنذر الحمصي، وعبد الرحمن بن الحارث المعروف بجحدر، وغيرهما، فقالوا: عن بقية، عن خليد بن أبي خليد، عن أبي حلبس، عن معاوية بن قرة، وقد روى بقية، عن خليد بن دعلج، عن معاوية بن قرة حديثا غير هذا وما أخلقه أن يكون خليد بن أبي خليد هذا، ويكون بقية قد دلسه في هذا الحديث لضعفه، فإن ذلك معروف لبقية، ولا بد من ذكره ليعرف حاله وهو","citation":"تهذيب الكمال (8/ 306)","pageId":444269,"verdict":"jarh"}]}],"phenomena":[],"flags":[]}}