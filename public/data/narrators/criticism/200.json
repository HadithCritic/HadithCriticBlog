il"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (1/ 544)","pageId":468167,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 297)","pageId":510546,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"10042":{"id":10042,"criticCount":3,"statementCount":4,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"مستور","citation":"تقريب التهذيب (1/ 299)","pageId":510566,"verdict":"unclassified"}]},{"critic":"الدارقطني","statements":[{"text":"اتهمه الدارقطني بوضع الحديث","citation":"لسان الميزان (3/ 368)","pageId":548527,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"لا يكاد يعرف","citation":"لسان الميزان (3/ 368)","pageId":548527,"verdict":"unclassified"},{"text":"روى مطين عن هذا، عن بشر بن إبراهيم، عن ثور بن يزيد، عن خالد بن معدان، عن معاذ: بخبر كذب","citation":"لسان الميزان (3/ 368)","pageId":548527,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10045":{"id":10045,"criticCount":2,"statementCount":3,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 300)","pageId":510584,"verdict":"jarh"},{"text":"روى له: ابن ماجه، عن يحيى بن عثمان، عن بقية، عن أبي حلبس، عن خليد بن أبي خليد، عن معاوية بن قرة، عن أبيه، حديث: \" من حضرته الوفاة فأوصى، فكانت وصيته على كتاب الله، كانت كفارته لما ترك من زكاته \". وقد روى بقية، عن خليد بن دعلج، عن معاوية بن قرة حديثا غير هذا، فكأن بقية دلسه في هذا الحديث لضعفه، فإن بقية معروف بذلك","citation":"تهذيب التهذيب (1/ 550)","pageId":468215,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"هكذا رواه يحيى بن عثمان عن بقية، وخالفه عيسى بن المنذر الحمصي، وعبد الرحمن بن الحارث المعروف بجحدر، وغيرهما، فقالوا: عن بقية، عن خليد بن أبي خليد، عن أبي حلبس، عن معاوية بن قرة، وقد روى بقية، عن خليد بن دعلج، عن معاوية بن قرة حديثا غير هذا وما أخلقه أن يكون خليد بن أبي خليد هذا، ويكون بقية قد دلسه في هذا الحديث لضعفه، فإن ذلك معروف لبقية، ولا بد من ذكره ليعرف حاله وهو","citation":"تهذيب الكمال (8/ 306)","pageId":444269,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"10047":{"id":10047,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (8/ 319)","pageId":444280,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (1/ 551)","pageId":468228,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 301)","pageId":510596,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}