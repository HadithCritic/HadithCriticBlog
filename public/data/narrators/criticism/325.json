{"16251":{"id":16251,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"ذكره ابن السمعاني فقال: يسكن دار الجليلة بالقرية، شيخ كبير من بيت الرياسة والتقدم، واسع الرواية، صاحب أصول حسنة مليحة، سمع بنفسه وأكثر، ونقل وجمع، وله خط مليح، وأكثر سماعاته بقراءة أبي بكر ابن الخاضبة","citation":"تاريخ الإسلام (11/ 713)","pageId":659774,"verdict":"unclassified"},{"text":"قال السمعاني: شيخ كبير، من بيت الرئاسة والتقدم، واسع الرواية، صاحب أصول حسنة مليحة، سمع بنفسه، وأكثر، ونقل وجمع، أكثر سماعه بقراءة ابن الخاضبة، قرأت عليه الكثير، وكان ينحدر إلى واسط من جهة الخليفة على الأعمال التي بها، مات في سابع رجب سنة تسع وثلاثين وخمسمائة","citation":"سير أعلام النبلاء (20/ 147)","pageId":731643,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"الشيخ العالم، المحدث المسند","citation":"سير أعلام النبلاء (20/ 147)","pageId":731643,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16254":{"id":16254,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سئل أبي عنه فقال: لا بأس به","citation":"الجرح والتعديل لابن أبي حاتم (8/ 244)","pageId":714160,"verdict":"tadil"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"كتبنا عنه، وهو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (8/ 244)","pageId":714160,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16257":{"id":16257,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"مسند، جليل","citation":"تاريخ الإسلام (12/ 1198)","pageId":666036,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16265":{"id":16265,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال السمعاني: شيخ صالح متواضع، متحر في قضائه الخير، متثبت","cit