:"tadil"}]},{"critic":"الذهبى","statements":[{"text":"الشيخ الإمام الثقة","citation":"سير أعلام النبلاء (20/ 273)","pageId":731836,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20271":{"id":20271,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو زرعة الرازي","statements":[{"text":"ثنا عبد الرحمن، قال: سئل أبو زرعة (60 م 4)، عن عبد الرحمن بن الحارث الذي يحدث عنه خالد بن مخلد القطواني قال: لا بأس به","citation":"الجرح والتعديل لابن أبي حاتم (5/ 224)","pageId":701138,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20272":{"id":20272,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"مقرئ مسند","citation":"تاريخ الإسلام (10/ 131)","pageId":653181,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20273":{"id":20273,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان ذكيا، مفننا، مناظرا، وقورا، فصيحا، نبيلا، حجة، كل أحد يثني عليه","citation":"سير أعلام النبلاء (22/ 255)","pageId":733040,"verdict":"tadil"},{"text":"وكان إماما، عالما، مفتيا، مناظرا، ذا سمت ووقار. وكان كثير المحفوظ، كثير الخير، حجة، صدوقا، كثير الاحتمال، تام المرؤة، فصيحا، مفوها ؛ لم يكن في المقادسة، أفصح منه. اتفقت الألسنة على شكره","citation":"تاريخ الإسلام (13/ 731)","pageId":669153,"verdict":"tadil"}]},{"critic":"الضياء المقدسي","statements":[{"text":"قال عمر ابن الحاجب: سألت أخاه الضياء عنه، فقال: كان فقيها، ورعا، ثقة","citation":"تاريخ الإسلام (13/ 731)","pageId":669153,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20275":{"id":20275,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"أحمد بن محمد العتيقي","statements":[{"text":"قال العتيقي: قرأ على ابن شنبوذ، وكان ثقة مأمونا","citation":"تاريخ بغداد (7/ 469)","pageId":823557,"verdict":"tadil"}]},{"critic":"الخطيب البغدادي"