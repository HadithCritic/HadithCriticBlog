critic":"ابن حجر","statements":[{"text":"ووهم من زعم أن له صحبة","citation":"تقريب التهذيب (1/ 282)","pageId":510281,"verdict":"unclassified"},{"text":"وهو خطأ في موضعين: أحدهما: أنه حية بتحتانية مثناة من تحت لا بموحدة. والثاني: أنه روى الحديث المذكور عن أبيه، كذلك أخرجه أحمد والترمذي وابن خزيمة من طرق عن يحيى بن أبي كثير، وهو الصواب","citation":"الإصابة في تمييز الصحابة (3/ 87)","pageId":418659,"verdict":"unclassified"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 282)","pageId":510281,"verdict":"unclassified"}]},{"critic":"أبو بكر ابن أبي عاصم النبيل","statements":[{"text":"وذكره ابن أبي عاصم في \" الصحابة \"، وروى هذا الحديث من طريقه عن النبي صلى الله عليه وآله وسلم بغير واسطة أبيه. وذكره أبو موسى في \" ذيله \" تبعا له، وهو مرسل أسقطه بعض الرواة","citation":"تهذيب التهذيب (1/ 509)","pageId":467860,"verdict":"unclassified"}]},{"critic":"أبو موسى المديني","statements":[{"text":"وذكره ابن أبي عاصم في \" الصحابة \"، وروى هذا الحديث من طريقه عن النبي صلى الله عليه وآله وسلم بغير واسطة أبيه. وذكره أبو موسى في \" ذيله \" تبعا له، وهو مرسل أسقطه بعض الرواة","citation":"تهذيب التهذيب (1/ 509)","pageId":467860,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1699":{"id":1699,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":4},"critics":[{"critic":"أبو زرعة الرازي","statements":[{"text":"قال أبو زرعة: محله الصدق","citation":"تهذيب التهذيب (1/ 510)","pageId":467866,"verdict":"unclassified"},{"text":"قال عبد الرحمن بن أبي حاتم: سألت أبا زرعة عن أبي جناب الكلبي، فقال: صدوق، غير أنه كان يدلس، قلت: فما حال أبيه ؟ قال: محله الصدق","citation":"تهذيب الكمال (7/ 487)","pageId":443979,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"له في ابن ماجه حديث واحد","citation":"تهذيب التهذيب (1/ 510)","pageId":467866,"verdict":"unclassified"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 282)","pageId":510285,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"قال أبو زرعة: محله الصدق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 335)","pageId":492475,"verdict":"unclassified"}]}],"phenomena":[{"key":"التدليس","label":"Tadlis","statements":[{"text":"قال عبد الرحمن بن أبي حاتم: سألت أبا زرعة عن أبي جناب الكلبي، فقال: صدوق، غير أنه كان يدلس، قلت: فما حال أبيه ؟ قال: محله الصدق","citation":"تهذيب الكمال (7/ 487)","pageId":443979}]}],"flags":["Mudallis"]}}