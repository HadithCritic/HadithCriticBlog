{"15701":{"id":15701,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"قال ابن أبي حاتم: ثابت بن رفيع له صحبة، سمعت أبي يقول: هو شامي، وهو عندي رويفع بن ثابت","citation":"الإصابة في تمييز الصحابة (2/ 42)","pageId":416183,"verdict":"unclassified"},{"text":"له صحبة","citation":"الجرح والتعديل لابن أبي حاتم (2/ 451)","pageId":687052,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه الحسن البصري، سمعت أبي يقول: هذا الرجل عندي شامي، وهو عندي رويفع بن ثابت، والحديث حديث شامي","citation":"الجرح والتعديل لابن أبي حاتم (2/ 451)","pageId":687052,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15704":{"id":15704,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الحسن بن سفيان النسوي","statements":[{"text":"ذكره الحسن بن سفيان، والطبراني، وغيرهما في الصحابة","citation":"الإصابة في تمييز الصحابة (7/ 568)","pageId":427249,"verdict":"unclassified"}]},{"critic":"الطبراني","statements":[{"text":"ذكره الحسن بن سفيان، والطبراني، وغيرهما في الصحابة","citation":"الإصابة في تمييز الصحابة (7/ 568)","pageId":427249,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15706":{"id":15706,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"البخاري","statements":[{"text":"ذكره البخاري في الوحدان وابن سعد فيمن نزل البصرة من الصحابة","citation":"الإصابة في تمييز الصحابة (7/ 294)","pageId":426404,"verdict":"unclassified"}]},{"critic":"محمد بن سعد","statements":[{"text":"ذكره البخاري في الوحدان وابن سعد فيمن نزل البصرة من الصحابة","citation":"الإصابة في تمييز الصحابة (7/ 294)","pageId":426404,"verdict":"unclassified"}]},{"critic":"ابن عبد البر","statements":[{"text":"وقال أبو عمر: لم أقف له على رواية","citation":"الإصابة في تمييز الصحابة (7/ 294)","pageId":426404,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15708":{"id":15708,"criticCount":1,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"رواه أبو حاتم بن حبان في \" كتابه \" عن محمد بن الحسن بن قتيبة، وقال: توفي عمر بن الخطاب وهاشم بن عبد الله بن الزبير ابن تسع سنين. وقال عبد الرحمن بن أبي حاتم الرازي: هاشم بن عبد الله بن الزبير روى عن عمر، مرسل، روى عنه معلى بن رؤبة","citation":"الأحاديث المختارة (1/ 416)","pageId":45398,"verdict":"jarh"},{"text":"الأحاديث المختارة: (1/ 416) برقم: (296)","citation":"روى عن عمر رضي الله عنه، مرسل الجرح والتعديل لابن أبي حاتم (9/ 104)","pageId":45398,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"روى عن: عمر رضي الله عنه، مرسل","citation":"الجرح والتعديل لابن أبي حاتم (9/ 104)","pageId":717746},{"text":"رواه أبو حاتم بن حبان في \" كتابه \" عن محمد بن الحسن بن قتيبة، وقال: توفي عمر بن الخطاب وهاشم بن عبد الله بن الزبير ابن تسع سنين. وقال عبد الرحمن بن أبي حاتم الرازي: هاشم بن عبد الله بن الزبير روى عن عمر، مرسل، روى عنه معلى بن رؤبة","citation":"الأحاديث المختارة (1/ 416)","pageId":45398}]}],"flags":["Sends Mursal Reports"]},"15714":{"id":15714,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو أحمد الحاكم","statements":[{"text":"قال الحاكم أبو أحمد: له صحبة، وفي إسناده مقال","citation":"الإصابة في تمييز الصحابة (12/ 272)","pageId":435451,"verdict":"unclassified"}]},{"critic":"أبو القاسم البغوي","statements":[{"text":"قال البغوي: لا أدري له صحبة أم لا","citation":"الإصابة في تمييز الصحابة (12/ 272)","pageId":435451,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وعبيد ضعيف جدا، وقد خولف. قال الدارقطني في العلل: رواه يزيد بن أبي زياد، عن مجاهد فقال: عن أبي سعيد الخدري، وقال عبد الكريم: عن مجاهد، عن عبد الله بن عمرو","citation":"الإصابة في تمييز الصحابة (12/ 272)","pageId":435451,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15720":{"id":15720,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"يقال: إن له صحبة","citation":"الثقات (3/ 98)","pageId":583398,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"قال ابن أبي حاتم: سألت أبي عن حسيل بن خارجة الأشجعي، وروايته عن رسول الله - صلى الله عليه وسلم - فقال: ليست له صحبة","citation":"تحفة التحصيل في المراسيل (1/ 92)","pageId":680027,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15722":{"id":15722,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو موسى المديني","statements":[{"text":"استدركه أبو موسى","citation":"الإصابة في تمييز الصحابة (3/ 184)","pageId":418985,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15723":{"id":15723,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"البخاري","statements":[{"text":"ذكره البخاري وغيره في الصحابة","citation":"الإصابة في تمييز الصحابة (3/ 222)","pageId":419090,"verdict":"unclassified"}]},{"critic":"ابن السكن","statements":[{"text":"وقال ابن السكن: في حديثه نظر","citation":"الإصابة في تمييز الصحابة (3/ 222)","pageId":419090,"verdict":"unclassified"}]},{"critic":"أبو القاسم البغوي","statements":[{"text":"وقال البغوي: لا أدري له صحبة أم لا","citation":"الإصابة في تمييز الصحابة (3/ 222)","pageId":419090,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15727":{"id":15727,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان: يقال: له صحبة","citation":"الإصابة في تمييز الصحابة (4/ 62)","pageId":420454,"verdict":"unclassified"},{"text":"يقال له صحبة","citation":"الثقات (3/ 142)","pageId":583708,"verdict":"unclassified"}]},{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"وروى الباوردي من طريق مسعود بن سليمان، عن حبيب بن أبي ثابت، عن الزهري، عن زياد بن الغرد وأبي اليسر أنهما سمعا النبي - صلى الله عليه وسلم - يقول لعمار: تقتلك الفئة الباغية. قال ابن منده: غريب. قلت: فيه انقطاع بين الزهري وبينهما","citation":"الإصابة في تمييز الصحابة (4/ 62)","pageId":420454,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15729":{"id":15729,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"ووقع في رواية ابن السكن: عن أبيه، عن جده فقط","citation":"الإصابة في تمييز الصحابة (4/ 384)","pageId":421433,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15731":{"id":15731,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وكذا ابن أبي حاتم، إلا أنه لم يذكر في هذا أنه صحابي، بل قال: روى عن عمر، وأشار إلى ذلك ابن عبد البر","citation":"الإصابة في تمييز الصحابة (7/ 200)","pageId":426160,"verdict":"unclassified"},{"text":"سمع عمر بن الخطاب رضي الله عنه","citation":"الجرح والتعديل لابن أبي حاتم (7/ 29)","pageId":708289,"verdict":"unclassified"}]},{"critic":"ابن عبد البر","statements":[{"text":"وكذا ابن أبي حاتم، إلا أنه لم يذكر في هذا أنه صحابي، بل قال: روى عن عمر، وأشار إلى ذلك ابن عبد البر","citation":"الإصابة في تمييز الصحابة (7/ 200)","pageId":426160,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع عمر بن الخطاب رضي الله عنه","citation":"الجرح والتعديل لابن أبي حاتم (7/ 29)","pageId":708289}]}],"flags":[]},"15732":{"id":15732,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الطبراني","statements":[{"text":"ذكره الطبراني في الصحابة","citation":"الإصابة في تمييز الصحابة (9/ 164)","pageId":429662,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وظاهره أن الحديث من رواية محمد بن قيس، إلا إن كان أطلق على الجد أبا، فيكون الحديث من رواية عثمان عن قيس، ورأيت