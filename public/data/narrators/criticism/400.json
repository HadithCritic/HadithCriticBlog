{"20002":{"id":20002,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"ربما خالف وأخطأ، وكان على القضاء بها","citation":"الثقات (8/ 405)","pageId":611064,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"ربما خالف وأخطأ، وكان على القضاء بها. ذكره ابن حبان في الثقات هكذا","citation":"لسان الميزان (5/ 338)","pageId":553144,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن، قال: سألت أبي عنه، فقال: لا أعرفه","citation":"الجرح والتعديل لابن أبي حاتم (5/ 329)","pageId":702173,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20003":{"id":20003,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع منه نصر بن علي سمعت أبي يقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (6/ 215)","pageId":705505,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20006":{"id":20006,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وله صحبة","citation":"الثقات (4/ 88)","pageId":586714,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20007":{"id":20007,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال أبو سعد السمعاني: هي من أهل بخشة، قرية على أربعة فراسخ من هراة، صالحة عفيفة. عندها جزء من حديث ابن أبي شريح تفردت بروايته في عصرها. سمع منها عالم لا يحصون","citation":"تاريخ الإسلام (10/ 405)","pageId":654407,"verdict":"unclassified"},{"text":"قال أبو سعد السمعاني: هي من قرية بخشة على بريد من هراة، صالحة، عفيفة، عندها جزء من حديث ابن أبي شريح، تفردت به، سمعه منها عالم لا يحصون. ولدت في حدود سنة ثمانين وثلاثمائة ثم قال: وماتت في حدود سنة خمس وسبعين وأربعمائة","citation":"سير أعلام النبلاء (18/ 403)","pageId":730451,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20009":{"id":20009,"criticCount":3,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الأزدي","statements":[{"text":"ضعفه الأزدي","citation":"لسان الميزان (1/ 290)","pageId":542384,"verdict":"jarh"}]},{"critic":"البزار","statements":[{"text":"قال البزار: لا نعرف عنه راويا سوى أبي عاصم","citation":"لسان الميزان (1/ 290)","pageId":542384,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وهو مقل، بل لا يعرف إلا بما رواه البزار: حدثنا محمد بن معمر، حدثنا أبو عاصم، عن إبراهيم بن سلام، عن حماد بن أبي سليمان، عن إبراهيم النخعي، عن أنس رضي الله عنه مرفوعا: \" طلب العلم فريضة على كل مسلم \"","citation":"لسان الميزان (1/ 290)","pageId":542384,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20011":{"id":20011,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن النبي صلى الله عليه وسلم حديثا مرسلا، وروى عن الحارث بن جميلة، عن أم الدرداء. روى عنه عبد الملك بن عمير، وجعفر بن سليمان الضبعي. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (5/ 35)","pageId":699302,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"روى عن النبي صلى الله عليه وسلم حديثا مرسلا، وروى عن الحارث بن جميلة، عن أم الدرداء. روى عنه عبد الملك بن عمير، وجعفر بن سليمان الضبعي. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (5/ 35)","pageId":699302}]}],"flags":["Sends Mursal Reports"]},"20014":{"id":20014,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الأزدي","statements":[{"text":"قال الأزدي: منكر الحديث","citation":"لسان الميزان (2/ 329)","pageId":545460,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20015":{"id":20015,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"محمد بن محمود ابن النجار البغدادي","statements":[{"text":"قال ابن النجار كان صالحا متدينا، على طريقة السلف","citation":"سير أعلام النبلاء (20/ 468)","pageId":732064,"verdict":"unclassified"},{"text":"قال ابن النجار: كان عبد الواحد شيخا صالحا على طريقة السلف","citation":"تاريخ الإسلام (12/ 276)","pageId":662400,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20016":{"id":20016,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"قرأت بخط الحافظ أبي عبد الله بن منده اسمه، وقال: منكر الحديث","citation":"لسان الميزان (5/ 334)","pageId":553130,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20020":{"id":20020,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي المراسيل","citation":"الثقات (7/ 101)","pageId":601197,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"يروي المراسيل","citation":"الثقات (7/ 101)","pageId":601197}]}],"flags":["Sends Mursal Reports"]},"20023":{"id":20023,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو زرعة الرازي","statements":[{"text":"نا عبد الرحمن قال: سئل أبو زرعة عنه فلم يعرفه، وذكر له حديثا رواه عن هشام ابن حسان، فقال: هو باطل","citation":"الجرح والتعديل لابن أبي حاتم (6/ 66)","pageId":703725,"verdict":"jarh"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: لا يتابع على حديثه","citation":"لسان الميزان (5/ 283)","pageId":552945,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20027":{"id":20027,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وفي ثقات ابن حبان ذكره، وزاد: روى عنه سعيد بن مسلم","citation":"لسان الميزان (5/ 328)","pageId":553103,"verdict":"tadil"}]},{"critic":"أبو حاتم