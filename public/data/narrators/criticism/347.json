{"17351":{"id":17351,"criticCount":1,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"حدثنا عبد الرحمن، قال: سألت أبي عنه ما حال الحسن، وعمر ؟ فقال: مجهولان","citation":"الجرح والتعديل لابن أبي حاتم (3/ 12)","pageId":688167,"verdict":"jarh"},{"text":"مجهول","citation":"لسان الميزان (3/ 39)","pageId":547031,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17354":{"id":17354,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه ابن أخته حماد بن يزيد بن مسلم، وابنته، وكرامة، سمعت أبي يقول ذلك، وسمعته يقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (3/ 68)","pageId":688745,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17367":{"id":17367,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الأزدي","statements":[{"text":"وذكره الأزدي فقال: فيه لين، وسمى جده عبد الله بن كعب","citation":"لسان الميزان (2/ 256)","pageId":545124,"verdict":"unclassified"}]},{"critic":"الدارقطني","statements":[{"text":"ليس بقوي قاله الدارقطني","citation":"لسان الميزان (2/ 256)","pageId":545124,"verdict":"jarh"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وذكره ابن أبي حاتم فقال: يروي عن أبيه، وزيد بن أرقم. وعنه محمد بن عبيد، وأبو معاوية يعد في الكوفيين ولم يذكر فيه جرحا، وسمى جده سعدا","citation":"لسان الميزان (2/ 256)","pageId":545124,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17368":{"id":17368,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"وسألته عنه، فقال: هو شيخ قديم صالح الحديث","citation":"الجرح والتعديل لابن أبي حاتم (2/ 244)","pageId":684966,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17378":{"id":17378,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"حدثنا عبد الرحمن، أنا عبد الله بن أحمد [بن حنبل] فيما كتب إلي قال: سألت يحيى بن معين قلت: شيخ روى عنه وكيع يقال له: البراء بن سليم ؟ فقال: كوفي حدثنا عنه وكيع عن نافع عن ابن عمر، ما أرى [به] بأسا","citation":"الجرح والتعديل لابن أبي حاتم (2/ 400)","pageId":686529,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17379":{"id":17379,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: قلت لأبي: ما حاله ؟ قال: يروي عنه","citation":"الجرح والتعديل لابن أبي حاتم (9/ 185)","pageId":718439,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17386":{"id":17386,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عن صدقة بن عبيد الله المازني فقال: ما أرى بحديثه بأسا","citation":"الجرح والتعديل لابن أبي حاتم (4/ 432)","pageId":698309,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: ذكره أبي، عن إسحاق بن منصور، عن يحيى بن معين أنه قال (331 م 3) : صدقة بن عبيد الله المازني ليس به بأس","citation":"الجرح والتعديل لابن أبي حاتم (4/ 432)","pageId":698309,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17396":{"id":17396,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن عبد البر","statements":[{"text":"قال أبو عمر: له صحبة، ولا أحفظ له خبرا","citation":"الإصابة في تمييز الصحابة (12/ 435)","pageId":436016,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وذكر فيه اختلافا على عطاء بن السائب، ففي رواية عبد السلام بن حرب عنه، عن حرب بن عبيد الله، عن جده، ولم يسمه، ومن طريق أبي الأحوص، عن عطاء، عن حرب، عن جده أبي أمه، ومن طريق الثوري، عن عطاء، عن حرب مرسلا. وفي رواية عن عطاء، عن رجل من بكر بن وائل، عن خاله قال: قلت: يا رسول الله، أعشر قومي، وفيه اختلاف آخر، ويقال: إن اسم جده حرب بن عبيد الله","citation":"الإصابة في تمييز الصحابة (12/ 435)","pageId":436016,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17397":{"id":17397,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: هو مقدم في شعراء المحدثين. قدمه بعضهم على بشار","citation":"سير أعلام النبلاء (6/ 207)","pageId":723717,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17398":{"id":17398,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الأزدي","statements":[{"text":"وقال الأزدي: لا يصح حديثه","citation":"لسان الميزان (3/ 392)","pageId":548646,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (3/ 392)","pageId":548646,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"لا يعرف","citation":"لسان الميزان (3/ 392)","pageId":548646}]}],"flags":[]}}