{"17500":{"id":17500,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الحاكم","statements":[{"text":"قال الحاكم: كان من أفاضل شيوخنا وأكثرهم صحبة، وصار في آخر عمره من العباد المجتهدين، وألف العزلة، وعاش تسعين سنة","citation":"تاريخ الإسلام (8/ 83)","pageId":644119,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17501":{"id":17501,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: وأخرج أبو نعيم في ترجمته حديثا فيه: سمعت رسول الله - صلى الله عليه وسلم - وقد غلب على ظني أنه غيره فأفردته فيما مضى","citation":"الإصابة في تمييز الصحابة (3/ 446)","pageId":419671,"verdict":"unclassified"}]},{"critic":"ابن عبد البر","statements":[{"text":"قال أبو عمر: لا أعلم له صحبة، إلا أنه أسلم واتبع في حياة النبي - صلى الله عليه وسلم - وقدم في زمن عمر فروى عنه، وشهد صفين مع معاوية، وقتل بها","citation":"الإصابة في تمييز الصحابة (3/ 446)","pageId":419671,"verdict":"unclassified"}]},{"critic":"محمد بن عمران المرزباني","statements":[{"text":"وقال المرزباني في \" معجم الشعراء \": سميفع بن الأكور ذو الكلاع الأصغر، مخضرم له مع عمر أخبار، ثم بقي إلى أيام معاوية","citation":"الإصابة في تمييز الصحابة (3/ 446)","pageId":419671,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17502":{"id":17502,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"من كبار أمراء الشام","citation":"تاريخ الإسلام (2/ 644)","pageId":617366,"verdict":"unclassified"},{"text":"قتل مع ابن زياد","citation":"تاريخ الإسلام (2/ 644)","pageId":617366,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17504":{"id":17504,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"نا عبد الرحمن، أنا عبد الله بن أحمد بن محمد بن حنبل وكتبه إلي قال: سمعت أبي يقول: عبد ربه بن أبي راشد شيخ ثقة ثقة، ثنا عنه ابن أبي راشد يحيى بن سعيد القطان","citation":"الجرح والتعديل لابن أبي حاتم (6/ 40)","pageId":703437,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: ذكره عن إسحاق بن منصور، عن يحيى بن معين قال: عبد ربه بن أبي راشد ثقة","citation":"الجرح والتعديل لابن أبي حاتم (6/ 40)","pageId":703437,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"رأى أبا برزة وابن عمر وجابر بن زيد ورائطة، روى عنه وكيع وسهل بن هاشم سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 40)","pageId":703437,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17505":{"id":17505,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"عمر رضي الله عنه، مرسل","citation":"الجرح والتعديل لابن أبي حاتم (9/ 143)","pageId":718105,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"عمر رضي الله عنه، مرسل","citation":"الجرح والتعديل لابن أبي حاتم (9/ 143)","pageId":718105}]}],"flags":["Sends Mursal Reports"]},"17509":{"id":17509,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن، قال: سمعت أبي يقول: روى مالك هذا الحديث عن عبد الملك بن قرير البصري، عن محمد بن سيرين أن رجلا جاء إلى عمر بن الخطاب، فقال: إني أصبت ظبيا، وأنا محرم فسمعت أبي يقول: كانوا يظنون قديما أن رواية مالك عن عبد الملك بن قرير وهم، وإنما سمع من","citation":"الجرح والتعديل لابن أبي حاتم (5/ 363)","pageId":702516,"verdict":"unclassified"}]},{"critic":"علي بن الحسين بن الجنيد النخعي","statements":[{"text":"نا عبد الرحمن، سمعت ابن الجنيد يقول: هو أخو عبد العزيز بن قرير من ولد مرحوم العبدي، المعروف بالشعر في الجاهلية. روى عن محمد بن سيرين. روى عنه مالك بن أنس","citation":"الجرح والتعديل لابن أبي حاتم (5/ 363)","pageId":702516,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"وقال يحيى بن معين: روى مالك عن عبد الملك (157 م 4) بن قرير، وإنما هو ابن قريب. قال الأصمعي: سمع مني [مالك]","citation":"الجرح والتعديل لابن أبي حاتم (5/ 363)","pageId":702516,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17524":{"id":17524,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الأزدي","statements":[{"text":"قال الأزدي: متروك الحديث","citation":"لسان الميزان (2/ 403)","pageId":545863,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17533":{"id":17533,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان في الثقات: يخطئ ويغرب على قلة روايته","citation":"لسان الميزان (3/ 265)","pageId":547993,"verdict":"tadil"},{"text":"يخطئ، ويغرب على قلة روايته","citation":"الثقات (6/ 248)","pageId":597985,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17535":{"id":17535,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"حدثنا عبد الرحمن، قال: سألت أبي عنه فقال: هو العرماني صدوق","citation":"الجرح والتعديل لابن أبي حاتم (3/ 148)","pageId":689496,"verdict":"tadil"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"وقال أبو زرعة: لا بأس به","citation":"الجرح والتعديل لابن أبي حاتم (3/ 148)","pageId":689496,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17537":{"id":17537,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات","citation":"لسان الميزان (3/ 357)","pageId":548463,"verdict":"tadil"}]},{"critic":"علي ابن المديني","statements":[{"text":"قال ابن المديني: مجهول","citation":"لسان الميزان (3/ 357)","pageId":548463,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17543":{"id":17543,"criticCount":1,"statementCount":1,"tally":{"jarh