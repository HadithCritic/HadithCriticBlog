}]}],"phenomena":[],"flags":[]},"9970":{"id":9970,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 259)","pageId":509869,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"9971":{"id":9971,"criticCount":2,"statementCount":5,"tally":{"jarh":0,"tadil":4,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عنه فقال: صدوق","citation":"الجرح والتعديل لابن أبي حاتم (3/ 175)","pageId":689748,"verdict":"tadil"},{"text":"سمع منه أبي بحلوان سنة ست وثلاثين ومائتين","citation":"الجرح والتعديل لابن أبي حاتم (3/ 175)","pageId":689748,"verdict":"unclassified"},{"text":"قال عبد الرحمن بن أبي حاتم: سمع منه أبي بحلوان سنة ست وثلاثين ومائتين، سألت أبي عنه فقال: صدوق","citation":"تهذيب الكمال (7/ 48)","pageId":443576,"verdict":"tadil"},{"text":"قال ابن أبي حاتم: سمع منه أبي سنة (236) بحلوان، وقال: صدوق","citation":"تهذيب التهذيب (1/ 456)","pageId":467416,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 259)","pageId":509871,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"9980":{"id":9980,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \"الثقات\"","citation":"تهذيب الكمال (7/ 134)","pageId":443653,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (1/ 469)","pageId":467509,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 264)","pageId":509957,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"9981":{"id":9981,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \"الثقات\"","citation":"تهذيب الكمال (7/ 197)","pageId":443684,"verdict":"tadil"},{"t