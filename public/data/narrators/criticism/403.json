[{"text":"روى عنه أبو الوليد الطيالسي، وإبراهيم بن موسى، ومحمد بن بشار، وأبو حفص الصيرفي، ومحمد بن المثنى سمعت أبي يقول ذلك، وسألته عنه فقال: هو شيخ","citation":"الجرح والتعديل لابن أبي حاتم (3/ 247)","pageId":690518,"verdict":"unclassified"}]},{"critic":"الفلاس","statements":[{"text":"قال عمرو بن علي: كان كذابا وكان صائغا","citation":"الكامل في الضعفاء (3/ 345)","pageId":575377,"verdict":"jarh"},{"text":"قال الفلاس: كذاب وكان صائغا فسمعت عمرا الأنماطي يقول: سمعته يقول: حدثنا أن الحسن قال: أتي عمر بسارق فقطعه فقال: ما حملك على ذلك؟ قال: القدر فضربه أربعين. ثم أقر أنه لم يسمعه من الحسن، وحلف أن لا يحدث به، وكتب عليه كتابا بشهود","citation":"لسان الميزان (3/ 308)","pageId":548253,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20199":{"id":20199,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو الغنائم الهمذاني","statements":[{"text":"قال شيرويه: كان ثقة صدوقا مرضيا في حكمه","citation":"تاريخ الإسلام (8/ 703)","pageId":647594,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}