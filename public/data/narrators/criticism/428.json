{"21404":{"id":21404,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"ولفظ أبي حاتم: كان مستورا حتى حدث عن أبي جمرة، عن ابن عباس... فذكر هذا الحديث، يعني فافتضح","citation":"لسان الميزان (6/ 168)","pageId":554695,"verdict":"unclassified"},{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: كان عندي مستورا إلى أن حدث عن أبي جمرة، عن ابن عباس، عن النبي صلى الله عليه وسلم بحديث منكر أنه قال: من أكفاء الدين تفصح النبط، واتخاذ القصور في الأمصار","citation":"الجرح والتعديل لابن أبي حاتم (6/ 295)","pageId":706462,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21405":{"id":21405,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"حدثنا عبد الرحمن قال: قرئ على العباس بن محمد الدوري، قال: سمعت يحيى بن معين يقول: خالد بن وردان مكي ليس به بأس","citation":"الجرح والتعديل لابن أبي حاتم (3/ 356)","pageId":691624,"verdict":"tadil"}]},{"critic":"أبو داود السجستاني","statements":[{"text":"، قال الآجري: سألت أبا داود عنه فقال: لا أعرفه","citation":"لسان الميزان (3/ 344)","pageId":548397,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21407":{"id":21407,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا يدرى من ذا، وأتى بحديث باطل رواه عنه المفضل الغلابي","citation":"لسان الميزان (4/ 153)","pageId":550015,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21408":{"id":21408,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"أبو موسى المديني","statements":[{"text":"ثم أورده من طريق إبراهيم بن راشد عن محمد بن خالد به فقال: عن رجل يقال له محمد، فالظاهر أن التصحيف فيه من راويه. وقد أخرجه أبو موسى من طريق عبد الله بن ناجية عن ابن أبي سمية عن محمد بن خالد بن عنمة - فذكر مثل رواية إبراهيم بن راشد فبين أن الصحابي فيه هو أبو برزة، والله أعلم","citation":"الإصابة في تمييز الصحابة (10/ 498)","pageId":432325,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"ذكره عبدان في الصحابة، وهو خطأ منه، وإنما الرواية عن محمد عن أبي برزة","citation":"الإصابة في تمييز الصحابة (10/ 498)","pageId":432325,"verdict":"unclassified"}]},{"critic":"عبد الله بن أحمد الجواليقي","statements":[{"text":"ثم أورده من طريق إبراهيم بن راشد عن محمد بن خالد به فقال: عن رجل يقال له محمد، فالظاهر أن التصحيف فيه من راويه. وقد أخرجه أبو موسى من طريق عبد الله بن ناجية عن ابن أبي سمية عن محمد بن خالد بن عنمة - فذكر مثل رواية إبراهيم بن راشد فبين أن الصحابي فيه هو أبو برزة، والله أعلم","citation":"الإصابة في تمييز الصحابة (10/ 498)","pageId":432325,"verdict":"unclassified"},{"text":"ذكره عبدان في الصحابة، وهو خطأ منه، وإنما الرواية عن محمد عن أبي برزة","citation":"الإصابة في تمييز الصحابة (10/ 498)","pageId":432325,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21411":{"id":21411,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي المراسيل روى عنه موسى الجهني من ثقات ابن حبان","citation":"لسان الميزان (4/ 356)","pageId":550931,"verdict":"tadil"},{"text":"يروي المراسيل","citation":"الثقات (6/ 487)","pageId":600247,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول ذلك، وسألته عنه فقال: [هو] مجهول","citation":"الجرح والتعديل لابن أبي حاتم (4/ 482)","pageId":698763,"verdict":"jarh"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"يروي المراسيل روى عنه موسى الجهني من ثقات ابن حبان","citation":"لسان الميزان (4/ 356)","pageId":550931},{"text":"يروي المراسيل","citation":"الثقات (6/ 487)","pageId":600247}]}],"flags":["Sends Mursal Reports"]},"21413":{"id":21413,"criticCount":3,"statementCount":7,"tally":{"jarh":1,"tadil":6,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن