{"10154":{"id":10154,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"النسائي","statements":[{"text":"قال النسائي: لا أعرفه","citation":"تقريب التهذيب (1/ 392)","pageId":512143,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"سعيد هذا أظنه ابن سالم القداح، وإبراهيم هذا أظنه ابن سعد الزهري، والله أعلم. ووقع في بعض النسخ: سعيد بن إبراهيم، عن ابن الهاد","citation":"تهذيب الكمال (11/ 129)","pageId":445791,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10170":{"id":10170,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 403)","pageId":512343,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"10171":{"id":10171,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 81)","pageId":470152,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (11/ 342)","pageId":445999,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 403)","pageId":512349,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10194":{"id":10194,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 412)","pageId":512529,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10195":{"id":10195,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"ثقة","citation":"تقريب التهذيب (1/ 413)","pageId":512537,"verdict":"tadil"}]},{"critic":"محمد بن عبد الوهاب حمك","statements":[{"text":"قال الحاكم في « تاريخ نيسابور »: قرأت بخط أبي عمرو المستملي سمعت أبا أحمد محمد بن عبد الوهاب يقول: كان اجتماعنا عند سليمان بن مطر، وكان بارا ما شئت بأهل العلم متفقدا لأحوالهم، روى عنه الحسين بن محمد بن زياد والحسين بن بشر وروى عن عمر بن هارون","citation":"إكمال تهذيب الكمال (6/ 87)","pageId":535858,"verdict":"unclassified"},{"text":"قال الحاكم: قرأت بخط أبي عمرو المستملي: سمعت أبا أحمد - يعني الفراء - يقول: كان اجتماعنا عند سليمان بن مطر، وكان بارا بأهل العلم","citation":"تهذيب التهذيب (2/ 108)","pageId":470335,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10198":{"id":10198,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 417)","pageId":512633,"verdict":"jarh"}]},{"critic":"محمد بن يزيد بن سنان بن يزيد الرهاوي","statements":[{"text":"قال أبو حاتم: قلت لمحمد بن يزيد: كان جدك كبير السن أدرك عليا، ما كانت كنيته ؟ وكم أتت عليه من سنة ؟ قال: كان جدي يكنى أبا حكيم أتت عليه ست وعشرون ومائة سنة يوم مات، وأخبرني أنه غزاة ثمانين غزاة","citation":"تهذيب الكمال (12/ 158)","pageId":446272,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"قال أبو حاتم: قلت لمحمد بن يزيد: كان جدك كبير السن أدرك عليا، ما كانت كنيته ؟ وكم أتت عليه من سنة ؟ قال: كان جدي يكنى أبا حكيم أتت عليه ست وعشرون ومائة سنة يوم مات، وأخبرني أنه غزاة ثمانين غزاة","citation":"تهذيب الكمال (12/ 158)","pageId":446272,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"رأى عليا، ثم عمر","citation":"تقريب التهذيب (1/ 417)","pageId":512633}]}],"flags":[]},"10199":{"id":10199,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 418)","pageId":512639,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}