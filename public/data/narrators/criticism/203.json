}],"flags":["Sends Mursal Reports"]},"10179":{"id":10179,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (11/ 430)","pageId":446069,"verdict":"tadil"},{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 95)","pageId":470229,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 407)","pageId":512425,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10183":{"id":10183,"criticCount":3,"statementCount":7,"tally":{"jarh":0,"tadil":7,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال أبو حاتم: مستوي الحديث، حسن الحديث، صدوق","citation":"تهذيب التهذيب (2/ 99)","pageId":470261,"verdict":"tadil"},{"text":"قال أبو حاتم الرازي: مستوي الحديث، حسن الحديث، صدوق، لو أدرك شعبة هذا لعله كان يكتب كلامه ؛ ألا ترى كيف يتوقى، لا يتجاوز الربيع بن أنس","citation":"تهذيب الكمال (12/ 13)","pageId":446101,"verdict":"tadil"},{"text":"قال أبو حاتم: صدوق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 529)","pageId":494231,"verdict":"tadil"},{"text":"حدثنا عبد الرحمن قال: سمعت أبي يقول ذلك، وسمعته يقول: هو مستوي الحديث، حسن الحديث، صدوق لو أدرك شعبة هذا لعله كان يكتب كلامه، ألا ترى كيف يتوقى، لا يجاوز الربيع بن أنس","citation":"الجرح والتعديل لابن أبي حاتم (4/ 133)","pageId":695462,"verdict":"tadil"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في كتاب \" الثقات","citation":"تهذيب الكمال (12/ 13)","pageId":446101,"verdict":"tadil"},{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 99)","pageId":470261,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 409)","pageId":512459,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"10184":{"id":10184,"criticCount":3,"statementCount":6,"tally":{"jarh":1,"tadil":2,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"وقال ابن حبان في « الثقات »: سليمان بن عبد الله بن الحارث، أخو إسحاق، والصلت. يروي عن المدنيين، روى عنه سعيد بن أبي هلال. قلت: كذا قال المؤلف، والذي في « الثقات » لابن حبان: روى عنه الزبير بن سعيد، كما وقع في كتاب ابن أبي حاتم سواء","citation":"تهذيب التهذيب (2/ 100)","pageId":470263,"verdict":"tadil"},{"text":"وقال أبو حاتم ابن حبان في كتاب \" الثقات \": سليمان بن عبد الله بن الحارث الهاشمي، أخو إسحاق، وعبد الله, والصلت. يروي عن المدنيين، روى عنه سعيد بن أبي هلال","citation":"تهذيب الكمال (12/ 15)","pageId":446103,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول الحال","citation":"تقريب التهذيب (1/ 409)","pageId":512461,"verdict":"jarh"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه: الزبير بن سعيد مرسل، وعبد الله بن الصلت الهاشمي، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (4/ 126)","pageId":695400,"verdict":"unclassified"},{"text":"وقال ابن أبي حاتم، عن أبيه: سليمان بن عبد الله بن الحارث: إن لم يكن أخا إسحاق بن عبد الله بن الحارث فلا أدري من هو، روى عنه: الزبير بن سعيد مرسلا","citation":"تهذيب التهذيب (2/ 100)","pageId":470263,"verdict":"unclassified"},{"text":"قال عبد الرحمن بن أبي حاتم، عن أبيه: سليمان بن عبد الله بن الحارث: إن لم يكن أخا إسحاق بن عبد الله بن الحارث فلا أدري من هو، روى عن... روى عنه الزبير بن سعيد مرسل، وعبد الله بن الصلت الهاشمي","citation":"تهذيب الكمال (12/ 15)","pageId":446103,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"قال عبد الرحمن بن أبي حاتم، عن أبيه: سليمان بن عبد الله بن الحارث: إن لم يكن أخا إسحاق بن عبد الله بن الحارث فلا أدري من هو، روى عن... روى عنه الزبير بن سعيد مرسل، وعبد الله بن الصلت الهاشمي","citation":"تهذيب الكمال (12/ 15)","pageId":446103},{"text":"وقال ابن أبي حاتم، عن أبيه: سليمان بن عبد الله بن الحارث: إن لم يكن أخا إسحاق بن عبد الله بن الحارث فلا أدري من هو، روى عنه: الزبير بن سعيد مرسلا","citation":"تهذيب التهذيب (2/ 100)","pageId":470263}