{"20704":{"id":20704,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: تفرد وكيع عن إبراهيم بقوله: عن إسحاق بن سعد، ورواه يحيى القطان وأبو أحمد الزبيري عن إبراهيم عن سعد بن سمرة، عن أبيه، عن أبي عبيدة، ووقع في رواية أحمد التصريح بأن الراوي عن أبي عبيدة هو سمرة، وهو المعتمد فكأن وكيعا كنى إبراهيم أبا إسحاق، فوقع في روايته تغيير، فإني لم أر لإسحاق بن سعد ترجمة","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 291)","pageId":579001,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20706":{"id":20706,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"ولد له في عهد النبي - صلى الله عليه وسلم - ومات صغيرا. قال الزبير في الأنساب: فولد سعد إسحاق الأكبر، وبه كان يكنى","citation":"الإصابة في تمييز الصحابة (1/ 352)","pageId":415133,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20707":{"id":20707,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"شيخ مصري صدوق","citation":"تاريخ الإسلام (7/ 765)","pageId":642836,"verdict":"tadil"},{"text":"الشيخ الإمام المحدث الصدوق","citation":"سير أعلام النبلاء (15/ 430)","pageId":728040,"verdict":"tadil"}]},{"critic":"القاضي عبد الله بن وليد الظاهري","statements":[{"text":"وكان قد عدله القاضي عبد الله بن وليد الظاهري","citation":"سير أعلام النبلاء (15/ 430)","pageId":728040,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20710":{"id":20710,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع مصعب بن الزبير. روى عنه: قرة بن خالد. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 452)","pageId":721662,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع مصعب بن الزبير. روى عنه: قرة بن خالد. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 452)","pageId":721662}]}],"flags":[]},"20717":{"id":20717,"criticCount":2,"statementCount":3,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن: أبيه، عن علي بن الحسين. روى عنه: عبد العزيز الدراوردي. سمعت أبي يقول ذلك، ويقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (9/ 80)","pageId":717499,"verdict":"jarh"},{"text":"وقد قدمنا أن أبا حاتم قال فيه: مجهول، وهو يؤيد قولنا: إن بصر المؤلف زل عند النقل من كتاب ابن أبي حاتم","citation":"لسان الميزان (8/ 364)","pageId":560413,"verdict":"jarh"}]},{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان: منكر الحديث على قلته، لا يحتج به لما فيه من الجهالة والخروج عن العدالة","citation":"لسان الميزان (8/ 364)","pageId":560413,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20720":{"id":20720,"criticCount":1,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول ذلك، ويقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (3/ 34)","pageId":688385,"verdict":"jarh"},{"text":"مجهول","citation":"لسان الميزان (3/ 108)","pageId":547264,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20721":{"id":20721,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"ثنا عبد الرحمن قال: سئل أبي عنه فقال: صدوق","citation":"الجرح والتعديل لابن أبي حاتم (9/ 85)","pageId":717545,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20722":{"id":20722,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"لا يدرى من هو","citation":"لسان الميزان (8/ 358)","pageId":560399,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"ذكره العقيلي وقال: لا يتابع على حديثه ولا يعرف إلا به، ثم ساقه من روايته عن مطر الوراق، عن عطاء، عن جابر: \" أفطر الحاجم والمحجوم \". ورواه ابن جريج وكافة أصحاب عطاء عنه، عن أبي هريرة، منهم من رفعه، ومنهم من وقفه وقال كثير: عن عطاء، عن عائشة. وقال فطر: عن عطاء، عن ابن عباس، ورواية ابن جريج ومن تابعه هي الصواب","citation":"لسان الميزان (8/ 358)","pageId":560399,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20724":{"id":20724,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال: سألت ابن عباس. روى عنه: [أبو إسحاق الهمداني. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 423)","pageId":721214,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20727":{"id":20727,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان خبازا","citation":"تاريخ الإسلام (12/ 532)","pageId":663336,"verdict":"unclassified"},{"text":"شيخ مسند، معمر","citation":"تاريخ الإسلام (12/ 532)","pageId":663336,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20728":{"id":20728,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان من الثقات","citation":"تاريخ الإسلام (12/ 993)","pageId":665100,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20732":{"id":20732,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"كتبت عنه بأصبهان، وهو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (8/ 481)","pageId":716467,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20737":{"id":20737,"criticCount":1,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"مجهول","citation":"لسان الميزان (8/ 276)","pageId":560040,"verdict":"jarh"},{"text":"روى عن سنان بن مالك عن علي رضي الله عنه، روى عنه أبو مخنف سمعت أبي يقول ذلك، وسمعته يقول: النضر، وسنان مجهولان","citation":"الجرح والتعديل لابن أبي حاتم (8/ 477)","pageId":716437,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20748":{"id":20748,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه شعبة، سمعت أبي يقول: هذا غلط، إنما هو الربيع بن الركين بن الربيع بن عميلة الفزاري","citation":"الجرح والتعديل لابن أبي حاتم (2/ 343)","pageId":685915,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}