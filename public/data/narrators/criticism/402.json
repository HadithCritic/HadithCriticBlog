{"20101":{"id":20101,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وفي ثقات ابن حبان طريف بن الدفاع الحنفي يروي عن إسحاق بن عبد الله بن أبي طلحة روى عنه عمر بن يونس اليمامي، فهو هو إن شاء الله تعالى","citation":"لسان الميزان (4/ 352)","pageId":550903,"verdict":"tadil"}]},{"critic":"العقيلي","statements":[{"text":"لينه العقيلي","citation":"لسان الميزان (4/ 352)","pageId":550903,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20102":{"id":20102,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (5/ 70)","pageId":552157,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: حدثناه أحمد بن محمد بن صدقة، حدثنا محمد بن مسكين اليمامي، حدثنا عبد الحميد، انتهى. وعبارة العقيلي: مجهولان جميعا، والحديث غير محفوظ","citation":"لسان الميزان (5/ 70)","pageId":552157,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20104":{"id":20104,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع ابن المسيب. روى عنه سعيد بن السائب. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (5/ 362)","pageId":702503,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع ابن المسيب. روى عنه سعيد بن السائب. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (5/ 362)","pageId":702503}]}],"flags":[]},"20108":{"id":20108,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"مستقيم الحديث إذا حدث عن الثقات","citation":"الثقات (8/ 357)","pageId":610540,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20111":{"id":20111,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو عثمان","statements":[{"text":"قال السلمي: صحب الجنيد، وأبا عثمان، ومحمد بن الفضل، ورويما، وسمنون، وأبا علي الجوزجاني، ومحمد بن حامد. وكان أبو عثمان يكرمه ويبجله وهو من أجل مشايخ نيسابور في وقته، له من الرياضات ما يعجز عن سماعها إلا أهلها. وكان عالما بعلوم هذه الطائفة، وكتب الحديث الكثير، وكان ثقة","citation":"تاريخ الإسلام (8/ 57)","pageId":643981,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20117":{"id":20117,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي المراسيل","citation":"الثقات (6/ 316)","pageId":598616,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"يروي المراسيل","citation":"الثقات (6/ 316)","pageId":598616}]}],"flags":["Sends Mursal Reports"]},"20118":{"id":20118,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"العقيلي","statements":[{"text":"قال العقيلي: في حديثه وهم ونكارة","citation":"تاريخ الإسلام (5/ 98)","pageId":627662,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"له حديث وقد خولف فيه","citation":"تاريخ الإسلام (5/ 98)","pageId":627662,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20122":{"id":20122,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"أدركته ولم أكتب عنه، كتب إلى أبي بجزء من حديثه","citation":"الجرح والتعديل لابن أبي حاتم (5/ 46)","pageId":699425,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20128":{"id":20128,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الأزدي","statements":[{"text":"تركوه. قاله الأزدي","citation":"لسان الميزان (5/ 27)","pageId":551984,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20133":{"i