:[],"flags":[]},"21892":{"id":21892,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"العقيلي","statements":[{"text":"الغالب على حديث الوهم","citation":"الضعفاء الكبير (1/ 82) قال العقيلي الغالب على حديثه الوهم. حدثنا جعفر بن أحمد، حدثنا محمد بن حميد، حدثنا إسماعيل بن سليمان، حدثنا عبد الملك بن أبي سليمان، عن عطاء، عن عبد الله بن عمرو رضي الله عنهما أن النبي صلى الله عليه وسلم كان يطعن في البيت بمخصرته ويقول \" ها إن هذا البيت مسؤول عن أعمالكم يوم القيامة، فانظروا ماذا يخبر عنكم \". وروى عن، عطاء عن أنس حديث الطير. قال العقيلي كلاهما ليسا بمحفوظين، انتهى. ولفظ العقيلي حديث الطير يروى من غير وجه بأسانيد لينة، وحديث عبد الله بن عمرو يروى من قوله لسان الميزان (2/ 130)","pageId":544662,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21898":{"id":21898,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"الرجل الصالح","citation":"تاريخ الإسلام (8/ 355)","pageId":645605,"verdict":"unclassified"},{"text":"العبد الصالح","citation":"سير أعلام النبلاء (16/ 318)","pageId":728724,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21899":{"id":21899,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"شيخ","citation":"الثقات (7/ 15)","pageId":600437,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}