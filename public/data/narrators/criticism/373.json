{"18650":{"id":18650,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"قال أحمد: كانت فيه غفلة شديدة، وحديثه صالح","citation":"لسان الميزان (3/ 529)","pageId":549201,"verdict":"unclassified"},{"text":"حدثنا عبد الرحمن، نا محمد بن حمويه بن الحسن، قال: سمعت أبا طالب قال: قال أحمد بن حنبل: أبو الوازع الكوفي كانت به غفلة شديدة. قلت: كيف كان حديثه ؟ قال: صالح","citation":"الجرح والتعديل لابن أبي حاتم (3/ 586)","pageId":693903,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"، وقال: الراسبي","citation":"لسان الميزان (3/ 529)","pageId":549201,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18656":{"id":18656,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن عدي","statements":[{"text":"ذكره ابن عدي وقال: أظنه مصريا، وليس هو بالمعروف. روى عن هشام بن عروة حدثني عمرو بن شعيب، عن أبيه، عن جده...، فذكر حديثا، وقال: هذا عجب، ولا أعلم لهشام عن عمرو بن شعيب غيره","citation":"لسان الميزان (3/ 271)","pageId":548025,"verdict":"unclassified"},{"text":"قال ابن عدي: وهذا الحديث لا أعلم يرويه عن هشام بن عروة غير حماد هذا، وليس هو بالمعروف، وهو عجب من حديث هشام بن عروة، عن عمرو بن شعيب، ولا أعرف لهشام عن عمرو غيره","citation":"الكامل في الضعفاء (3/ 32)","pageId":575141,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"لا يدرى من ذا","citation":"لسان الميزان (3/ 271)","pageId":548025,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18661":{"id":18661,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول ذلك، وسألته عنه فقال: صالح هو شيخ","citation":"الجرح والتعديل لابن أبي حاتم (3/ 204)","pageId":690050,"verdict":"unclassified"}]},{"critic":"الأزدي","statements":[{"text":"قال الأزدي: فيه نظر انتهى. وأسند له عن الشعبي، عن جرير، رفعه: \