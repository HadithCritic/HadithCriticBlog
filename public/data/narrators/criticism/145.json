{"7262":{"id":7262,"criticCount":4,"statementCount":5,"tally":{"jarh":2,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (31/ 203)","pageId":456998,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 339)","pageId":482172,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"لين الحديث","citation":"تقريب التهذيب (1/ 1048)","pageId":523928,"verdict":"jarh"}]},{"critic":"الدارقطني","statements":[{"text":"قلت: وقال الدارقطني: لا يحتج به","citation":"تهذيب التهذيب (4/ 339)","pageId":482172,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"وقزعة بن يحيى (سي) على خلاف فيه","citation":"تهذيب الكمال (31/ 203)","pageId":456998,"verdict":"unclassified"}]}],"phenomena":[{"key":"الاختلاف في سماع الراوي","label":"Audition Disputed","statements":[{"text":"وقزعة بن يحيى (سي) على خلاف فيه","citation":"تهذيب الكمال (31/ 203)","pageId":456998}]}],"flags":["Audition Disputed"]},"7268":{"id":7268,"criticCount":2,"statementCount":5,"tally":{"jarh":2,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"روى عنه: ابن أبي فديك بنسخة مستقيمة","citation":"الثقات (6/ 452)","pageId":599932,"verdict":"unclassified"},{"text":"وذكره ابن حبان في \" الثقات \" وقال: روى عنه ابن أبي فديك نسخة مستقيمة، حدثنا بها الفضل بن محمد العطار بأنطاكية، حدثنا أحمد بن الوليد بن برد، عنه، كنيته أبو المفضل","citation":"لسان الميزان (4/ 230)","pageId":550361,"verdict":"tadil"}]},{"critic":"ابن عدي","statements":[{"text":"قال ابن عدي: روى أحاديث مناكير، انتهى. وقال أيضا: أحاديثه ليست بمحفوظة","citation":"لسان الميزان (4/ 230)","pageId":550361,"verdict":"jarh"},{"text":"حدث عنه ابن أبي فديك، عن أبيه، عن جده، عن أبي هريرة، عن النبي صلى الله عليه وسلم بأحاديث لا يحدث بها عن العلاء غيره مناكير","citation":"الكامل في الضعفاء (5/ 72)","pageId":576173,"verdict":"jarh"},{"text":"قال الشيخ: منكر من حديث مالك، وشبل بن العلاء بهذا الإسناد، وبهذا الإسناد ثناه جعفر بن أحمد بن خالد بغير حديث أحاديث ليست بمحفوظة","citation":"الكامل في الضعفاء (5/ 72)","pageId":576173,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"7269":{"id":7269,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 283)","pageId":584608,"verdict":"unclassified"}]},{"critic":"ابن شاهين","statements":[{"text":"قال ابن سعد وابن شاهين: هو أحد العشرة الذين وجههم عمر من الصحابة إلى الكوفة مع عمار بن ياسر","citation":"الإصابة في تمييز الصحابة (7/ 39)","pageId":425658,"verdict":"unclassified"}]},{"critic":"محمد بن سعد","statements":[{"text":"قال ابن سعد وابن شاهين: هو أحد العشرة الذين وجههم عمر من الصحابة إلى الكوفة مع عمار بن ياسر","citation":"الإصابة في تمييز الصحابة (7/ 39)","pageId":425658,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"7270":{"id":7270,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"من الصحابة","citation":"تقريب التهذيب (1/ 922)","pageId":521609,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"7271":{"id":7271,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"والصواب: أن مجيبة امرأة ؛ فقد وقع عند سعيد بن منصور، عن ابن علية، عن الجريري، عن أبي السليل، عن مجيبة الباهلية عجوز من قومها","citation":"الإصابة في تمييز الصحابة (12/ 587)","pageId":436608,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في الصحابة","citation":"الإصابة في تمييز الصحابة (12/ 587)","pageId":436608,"verdict":"unclassified"}]},{"critic":"ابن عبد البر","statements":[{"text":"وقال أبو عمر: لا أعرفه","citation":"الإصابة في تمييز الصحابة (12/ 587)","pageId":436608,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"7273":{"id":7273,"criticCount":2,"statementCount":2,"tal