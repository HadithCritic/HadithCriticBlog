{"12550":{"id":12550,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي المراسيل","citation":"الثقات (5/ 375)","pageId":593363,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"يروي المراسيل","citation":"الثقات (5/ 375)","pageId":593363}]}],"flags":["Sends Mursal Reports"]},"12554":{"id":12554,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (11/ 93)","pageId":826848,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12556":{"id":12556,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"قال الحافظ أبو بكر الخطيب: اعتبرت كثيرا من حديثه، فوجدته مستقيما يدل على ثقته","citation":"لسان الميزان (4/ 472)","pageId":551401,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"وقال العقيلي: لا يتابع على حديثه. ثم ساق له ثلاثة أحاديث محفوظة المتن لكنه خولف في سندها، وهو أكبر شيخ لقيه ابن أبي الدنيا، انتهى. وعبارة العقيلي: في حديثه وهم","citation":"لسان الميزان (4/ 472)","pageId":551401,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12565":{"id":12565,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"ليس بالمتين","citation":"لسان الميزان (6/ 112)","pageId":554473,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: لا يتابع على حديثه، قال: وحدثنا محمد بن سنان الشيزرى، حدثنا سليمان بن عمر بن سيار، حدثني أبي، عن ابن أخي الزهري، عن الزهرى، عن أنس رضي الله عنه مرفوعا: \" من سره أن ينجو فليلزم الصمت \"","citation":"لسان الميزان (6/ 112)","pageId":554473,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12567":{"id":12567,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن، قال: سألت أبي عنه، فقال: هذا شيخ أدركته بالبصرة، خرج إلى الكوفة في بدو قدومنا البصرة، فلم نكتب عنه، ولا أخبر أمره","citation":"الجرح والتعديل لابن أبي حاتم (5/ 120)","pageId":700104,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12580":{"id":12580,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الدارقطني","statements":[{"text":"ضعفه الدارقطني","citation":"لسان الميزان (6/ 153)","pageId":554617,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"12598":{"id":12598,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وثقه الخطيب","citation":"تاريخ الإسلام (6/ 133)","pageId":633237,"verdict":"tadil"},{"text":"سمع أبا النضر هاشم بن القاسم، ويعلى بن عبيد، ويحيى بن إسحاق السيلحيني، وعبيد الله بن موسى، ومسلم بن إبراهيم، وخالد بن مخلد، وإسماعيل بن الخليل، ويحيى بن حماد. روى عنه: هاشم بن القاسم الهاشمي، والحسن بن محمد بن شعبة، وأحمد بن عبد الله الوكيل، والقاضي المحاملي، وكان ثقة","citation":"تاريخ بغداد (14/ 132)","pageId":830156,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}