{"20955":{"id":20955,"criticCount":2,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"ذكره ابن أبي حاتم، ونقل عن أبيه أنه مجهول","citation":"لسان الميزان (7/ 300)","pageId":557716,"verdict":"jarh"}]},{"critic":"الأزدي","statements":[{"text":"وذكره الأزدي، فقال: مجهول لا يحتج بحديثه. روى عن ليث، عن أبي محمد، عن معقل بن يسار، عن أبي بكر رفعه \" الشرك أخفى فيكم من دبيب النمل \"، وفيه قصة، وفي آخره: \" قل: اللهم إني أعوذ بك أن أشرك بك، وأنا لا أعلم. رواه عنه أبو ياسر عمار بن هارون","citation":"لسان الميزان (7/ 300)","pageId":557716,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20959":{"id":20959,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (4/ 158)","pageId":819231,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20962":{"id":20962,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"الطبيب المعمر","citation":"لسان الميزان (6/ 379)","pageId":555619,"verdict":"unclassified"}]},{"critic":"الحاكم","statements":[{"text":"قال الحاكم: لم تعجبني روايته \" لتاريخ \" يحيى بن بكير","citation":"لسان الميزان (6/ 379)","pageId":555619,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20977":{"id":20977,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول ذلك، وسمعته يقول: ابن أبي سعد مجهول","citation":"الجرح والتعديل لابن أبي حاتم (9/ 321)","pageId":719802,"verdict":"jarh"},{"text":"قال أبو حاتم: هو حديث ضعيف، وهذا مجهول، رواه عنه مجهول مثله، وهو يحيى بن أبي خالد","citation":"لسان الميزان (9/ 217)","pageId":564999,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"لا يعرف","citation":"لسان الميزان (9/ 217)","pageId":564999,"verdict"