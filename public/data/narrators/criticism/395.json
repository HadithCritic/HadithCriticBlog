776":{"id":19776,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (6/ 457)","pageId":556021,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"ذكره العقيلي، وأخرج من رواية أبي بكر بن عياش عنه، عن الزهري، عن سالم، عن أبي هريرة حديث: كل أمتي معافى إلا المجاهرين... الحديث. وقال: تابعه ابن أخي الزهري، ولم يتابعهما من أصحاب الزهري أحد. قلت: هو في \" الصحيحين \" من رواية ابن أخي الزهري","citation":"لسان الميزان (6/ 457)","pageId":556021,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن الزهري روى [عنه أبو] بكر بن عياش سمعت أبي يقول ذلك ويقول: لا أعلم أحدا، روى عنه غير أبي بكر بن عياش","citation":"الجرح والتعديل لابن أبي حاتم (8/ 342)","pageId":715114,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19778":{"id":19778,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"العقيلي","statements":[{"text":"قال العقيلي: مضطرب الحديث","citation":"لسان الميزان (6/ 327)","pageId":555376,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19780":{"id":19780,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"من أعلى أهل بخارى إسنادا، وهو صدوق إن شاء الله","citation":"تاريخ الإسلام (6/ 806)","pageId":636785,"verdict":"tadil"},{"text":"رحل وعني بالحديث","citation":"تاريخ الإسلام (6/ 806)","pageId":636785,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19787":{"id":19787,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"قال الحافظ أبو سعيد العلائي في \" الوشي \": لا أعرفه ولا أباه، وجده صحابي معروف، وهو غير الذي أخرج له الترمذي لاختلاف النسبين","citation":"تهذيب التهذيب (3/ 379)","pageId":477080,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19788":{"id":19788,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"العلائي","statements":[{"text":"قال العلائي في الوشي: لا أعرف غيلان ولا أباه، وجده أسماء صحابي معروف","citation":"لسان الميزان (4/ 436)","pageId":551273,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19792":{"id":19792,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"شيخ","citation":"الثقات (5/ 385)","pageId":593453,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19797":{"id":19797,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"العقيلي","statements":[{"text":"قال العقيلي: من كبار الرافضة، روى أحاديث سوء كذب، روى عن مالك بن ضمرة عن أبي ذر، وعنه زياد بن المنذر، انتهى. والحديث المذكور أورده العقيلي عن أبي ذر بسنده، ولفظ المتن: \" تحشر أمتي يوم القيامة على خمس رايات... \" الحديث في تفسير يوم تبيض وجوه","citation":"لسان الميزان (6/ 182)","pageId":554767,"verdict":"unclassified"},{"text":"قال العقيلي: روى أحاديث سوء كذا في الأصل وكأن لفظ: كذب، من تصرف الذهبي","citation":"لسان الميزان (6/ 182)","pageId":554767,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}