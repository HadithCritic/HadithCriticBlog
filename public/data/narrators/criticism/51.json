{"2550":{"id":2550,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا تعرف","citation":"تقريب التهذيب (1/ 1357)","pageId":530604,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"2566":{"id":2566,"criticCount":4,"statementCount":6,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال أبو حاتم: أعرابي محله الصدق","citation":"تهذيب الكمال (11/ 347)","pageId":446007,"verdict":"unclassified"},{"text":"روى عنه: هشام بن عمار، وابن أبي الحواري، وزياد بن نصر الوادي من أهل وادي القرى، سمعت أبي يقول ذلك، وسألته (178 م 3) عنه فقال: هو أعرابي محله الصدق","citation":"الجرح والتعديل لابن أبي حاتم (4/ 214)","pageId":696240,"verdict":"unclassified"},{"text":"قال أبو حاتم: أعرابي، محله الصدق","citation":"تهذيب التهذيب (2/ 82)","pageId":470162,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"محله الصدق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 519)","pageId":494151,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في « الضعفاء »، فقال: منكر الحديث على قلة روايته","citation":"تهذيب التهذيب (2/ 82)","pageId":470162,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"لين الحديث","citation":"تقريب التهذيب (1/ 404)","pageId":512359,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"2569":{"id":2569,"criticCount":4,"statementCount":7,"tally":{"jarh":1,"tadil":3,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 114)","pageId":470365,"verdict":"tadil"},{"text":"وذكره ابن حبان في كتاب \" الثقات","citation":"تهذيب الكمال (12/ 111)","pageId":446203,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 537)","pageId":494317,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"قال عثمان بن سعيد الدارمي: قلت ليحيى بن معين: حميد الشامي، عن سليمان المنبهي حديث ثوبان ؟ فقال: ما أعرفهما","citation":"تهذيب الكمال (12/ 111)","pageId":446203,"verdict":"unclassified"},{"text":"حدثنا عبد الرحمن، أنا يعقوب بن إسحاق فيما كتب إلي قال: نا عثمان بن سعيد [الدارمي] قال: قلت ليحيى بن معين: حميد الشامي الذي روى حديث ثوبان، عن سليمان المنبهي فقال: ما أعرفهما","citation":"الجرح والتعديل لابن أبي حاتم (4/ 152)","pageId":695636,"verdict":"unclassified"},{"text":"قال ابن معين: ما أعرفهما","citation":"تهذيب التهذيب (2/ 114)","pageId":470365,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 414)","pageId":512567,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"2579":{"id":2579,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 85)","pageId":470181,"verdict":"tadil"},{"text":"ذكر ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (11/ 369)","pageId":446021,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 405)","pageId":512377,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 521)","pageId":494163,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"2582":{"id":2582,"criticCount":4,"statementCount":7,"tally":{"jarh":0,"tadil":7,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"كتبت عنه بنهروان، وكان صدوقا","citation":"الجرح والتعديل لابن أبي حاتم (4/ 104)","pageId":695220,"verdict":"tadil"},{"text":"وابن أبي حاتم، وقال: كان صدوقا","citation":"تهذيب التهذيب (2/ 87)","pageId":470187,"verdict":"tadil"},{"text":"قال عبد الرحمن بن أبي حاتم: كان صدوقا","citation":"تهذيب الكمال (11/ 376)","pageId":446027,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","