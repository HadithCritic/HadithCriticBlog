{"15551":{"id":15551,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن السكن","statements":[{"text":"قال ابن السكن: يقال: إن له صحبة، وفي إسناد حديثه نظر","citation":"الإصابة في تمييز الصحابة (11/ 352)","pageId":433757,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15556":{"id":15556,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"محمد بن إسحاق","statements":[{"text":"ذكره ابن إسحاق فيمن شهد بدرا","citation":"الإصابة في تمييز الصحابة (10/ 289)","pageId":431582,"verdict":"unclassified"}]},{"critic":"الواقدي","statements":[{"text":"وذكر الواقدي في كتاب الردة أنه كان مع خالد بن الوليد في قتال أهل الردة، وأنه وجهه طليعة إلى اليمامة في مائتي فارس","citation":"الإصابة في تمييز الصحابة (10/ 289)","pageId":431582,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15557":{"id":15557,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 141)","pageId":709677,"verdict":"unclassified"},{"text":"وقال أبو حاتم الرازي: له صحبة، يكنى أبا زيد","citation":"الإصابة في تمييز الصحابة (9/ 68)","pageId":429365,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"ذكروه فيمن شهد بدرا والعقبة والمشاهد، وكانت معه راية بني سلمة يوم الفتح","citation":"الإصابة في تمييز الصحابة (9/ 68)","pageId":429365,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15558":{"id":15558,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن عبد البر","statements":[{"text":"وجزم ابن عبد البر بها، وقال: أسلم بعد أبيه","citation":"تحفة التحصيل في المراسيل (1/ 383)","pageId":681211,"verdict":"unclassified"}]},{"critic":"الحسن بن محمد الصغاني","statements":[{"text":"ذكره الصغاني فيمن اختلف في صحبته","citation":"تحفة ال