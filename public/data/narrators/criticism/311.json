لى رأي من يغاير بين الراية واللواء، والله أعلم","citation":"الإصابة في تمييز الصحابة (7/ 55)","pageId":425722,"verdict":"unclassified"},{"text":"أسلم قديما، وكان رأس بني عبد مناف حينئذ، مع أن العباس وإخوته كانوا في التعدد أقرب، وكان مع النبي - صلى الله عليه وسلم - بمكة، ثم هاجر، وشهد بدرا، وبارز فيها مع حمزة وعلي عتبة وشيبة والوليد","citation":"الإصابة في تمييز الصحابة (7/ 55)","pageId":425722,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15568":{"id":15568,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن عبد البر","statements":[{"text":"ذكره أبو عمر فقال: إنه كان رسول رسول الله -صلى الله عليه وسلم- إلى الذين قتلوا الأسود العنسي، وهو غير يحنس بن وبرة السبئي الذي تقدم في القسم الأول","citation":"الإصابة في تمييز الصحابة (11/ 319)","pageId":433646,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15569":{"id":15569,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"أسلم قبل أخيه","citation":"الإصابة في تمييز الصحابة (1/ 502)","pageId":415530,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15570":{"id":15570,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال ابن أبي حاتم عن أبيه: هو الذي سمع عبد الله بن أبي يقول: لئن رجعنا إلى المدينة","citation":"الإصابة في تمييز الصحابة (4/ 484)","pageId":421800,"verdict":"unclassified"},{"text":"ه و الذي سمع عبد الله بن أبي ابن سلول يقول: لئن رجعنا إلى المدينة سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (4/ 251)","pageId":696553,"verdict":"unclassified"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"قال أبو محمد: لا أعلم له رواية","citation":"الجرح والتعديل لابن أبي حاتم (4/ 251)","pageId":696553,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15576":{"id":15576,"criticCount":2,"statementCount":2,"tally":{"j