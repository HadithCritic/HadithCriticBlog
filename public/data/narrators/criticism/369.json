 عن أبيه، عن أنس رضي الله عنه نسخة أوردها البزار، فيها مناكير","citation":"لسان الميزان (8/ 511)","pageId":561048,"verdict":"jarh"}]},{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين أنه قال: يسار بن محمد [البناني] الذي روى عن ثابت، عن أبيه، عن (1190 ك) أنس - لا شيء","citation":"الجرح والتعديل لابن أبي حاتم (9/ 307)","pageId":719645,"verdict":"unclassified"},{"text":"قال ابن معين: لا شيء","citation":"لسان الميزان (8/ 511)","pageId":561048,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18463":{"id":18463,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان: روى عن شعبة ما ليس من حديثه","citation":"لسان الميزان (7/ 236)","pageId":557491,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18466":{"id":18466,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه عثمان بن عبد الرحمن الحراني سمعت أبي يقول ذلك، وسألته عنه فقال: يكتب حديثه","citation":"الجرح والتعديل لابن أبي حاتم (3/ 609)","pageId":694091,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18471":{"id":18471,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"مسند وقته بدمشق","citation":"سير أعلام النبلاء (13/ 505)","pageId":726789,"verdict":"unclassified"},{"text":"المحدث، العالم، الثقة","citation":"سير أعلام النبلاء (13/ 505)","pageId":726789,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18476":{"id":18476,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"ولم أقف على كلام من صرح بتجريحه، وكان من مسندي عصره، حدث بمصر عن يوسف بن يزيد القراطيسي، والقاسم بن الليث الرسعني، وأحمد بن حماد زغبة، ومحمد بن علي الصائغ. روى عنه أبو الفضل بن