{"12101":{"id":12101,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان صدوقا مستقيم الأمر","citation":"تاريخ الإسلام (6/ 567)","pageId":635395,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12104":{"id":12104,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن أبي المتوكل الناجي. روى عنه شعبة. سمعت أبي يقول ذلك، ويقول: هو صالح","citation":"الجرح والتعديل لابن أبي حاتم (5/ 208)","pageId":700980,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12111":{"id":12111,"criticCount":1,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الفلاس","statements":[{"text":"نا عبد الرحمن، نا محمد بن إبراهيم، نا أبو حفص عمرو بن علي قال: عبد الرحمن بن القطامي الذي يحدث عن أبي المهزم لقيته، وكان كذابا","citation":"الجرح والتعديل لابن أبي حاتم (5/ 279)","pageId":701696,"verdict":"jarh"},{"text":"قال عمرو بن علي ورجل لقيته أنا يقال له عبد الرحمن بن القطامي يحدث عن أبي المهزم وكان كذابا رأيت في كتابه عن أبي المهزم عن أبي هريرة، عن ابن عباس، وعن أبي المهزم، عن أبي هريرة، عن ابن عمر ورأيت في كتابه بين سطرين، ثنا عمر بن علي بن مقدم، عن هشام بن عروة، عن أبيه وعمر يومئذ حي فقلت له: من عمر بن علي هذا ؟ قال: رجل لقيته قبل الطاعون. والحديث بعينه أنا سمعته من عمر بن علي","citation":"الكامل في الضعفاء (5/ 504)","pageId":576664,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"12115":{"id":12115,"criticCount":2,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"قال الذهبي في \" الضعفاء \": مجهول. وكذا هو في كتاب ابن أبي حاتم","citation":"لسان الميزان (2/ 16)","pageId":544155,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"قال الذهبي في \" الضعفاء \": مجهول. وكذا هو في كتاب ابن أبي حاتم","citation":"لسان الميزان (2/ 16)","pageId":544155,"ver