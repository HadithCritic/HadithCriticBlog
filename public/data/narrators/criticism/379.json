{"18959":{"id":18959,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"، وقال: روى عنه قتادة","citation":"لسان الميزان (8/ 170)","pageId":559571,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: لا يعرف، مجهول","citation":"الجرح والتعديل لابن أبي حاتم (8/ 179)","pageId":713428,"verdict":"jarh"},{"text":"مجهول","citation":"لسان الميزان (8/ 170)","pageId":559571,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18960":{"id":18960,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":1,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"غسان صدوق، ومالك واه","citation":"الثقات (9/ 1)","pageId":612523,"verdict":"mixed"}]}],"phenomena":[],"flags":[]},"18965":{"id":18965,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"شيخ","citation":"الثقات (6/ 388)","pageId":599287,"verdict":"unclassified"}]},{"critic":"الأزدي","statements":[{"text":"وذكره الأزدي، فقال: فيه لين، سمع أبا هاشم","citation":"لسان الميزان (4/ 183)","pageId":550124,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"ذكره العقيلي وقال: لا يتابع على حديثه، رواه عنه عبيد الله بن موسى، انتهى. وساق حديثه، عن أبي هاشم الرماني، عن إبراهيم النخعي، عن علقمة، عن عبد الله أن رسول الله صلى الله عليه وسلم كناه أبا عبد الرحمن، ولم يولد له. ثم ذكره من طريق مغيرة عن إبراهيم أن عبد الله كنى علقمة أبا شبل، ولم يولد له. ومن طريق فضيل بن عمرو، قلت لإبراهيم: الرجل يكنى، ولم يولد له ؟ قال: ليس بذلك بأس، قد كان علقمة يكنى أبا شبل وكان عقيما. قال العقيلي: هذا أولى","citation":"لسان الميزان (4/ 183)","pageId":550124,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18968":{"id":18968,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الحسيني","statements":[{"text":"قال الحسيني: ليس بالمشهور","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 804)","pageId":580214,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"قلت: قد ذكره البخاري وذكر بعده: عبد الرحمن بن عبد العزيز الأمامي الأنصاري من ذرية أبي أمامة بن سهل، ويغلب على ظني أنهما واحد، والأمامي مذكور في \" التهذيب \"","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 804)","pageId":580214,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18970":{"id":18970,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع أنسا، روى عنه مسعر بن كدام وإسرائيل وشريك وأبو عوانة، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 188)","pageId":705182,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع أنسا، روى عنه مسعر بن كدام وإسرائيل وشريك وأبو عوانة، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 188)","pageId":705182}]}],"flags":[]},"18974":{"id":18974,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يغرب","citation":"الثقات (7/ 213)","pageId":602305,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18976":{"id":18976,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن عدي","statements":[{"text":"قال ابن عدي: كان أروى الناس عن هشام بن عمار. كانت عنده كتبه كلها","citation":"تاريخ الإسلام (7/ 40)","pageId":638394,"verdict":"unclassified"}]}],"phenomena":[{"key":"المفاضلة بين الرواة في راو","label":"Comparative Ranking (Shared Teacher)","statements":[{"text":"قال ابن عدي: كان أروى الناس عن هشام بن عمار. كانت عنده كتبه كلها","citation":"تاريخ الإسلام (7/ 40)","pageId":638394}]}],"flags":[]},"18977":{"id":18977,"criticCount":1,"statementCount":3,"tally":{"ja