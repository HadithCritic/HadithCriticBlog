{"16208":{"id":16208,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن الفرضي أبو الوليد القرطبي","statements":[{"text":"قال ابن الفرضي: وكان حافظا لأخبار الأندلس، له حظ من النحو والشعر، ولي الصلاة بقرطبة","citation":"سير أعلام النبلاء (14/ 495)","pageId":727455,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وكان إماما في الفقه، مقدما على أهل زمانه في الفتوى، كبير الشأن، حافظا لأخبار الأندلس، أديبا شاعرا. ولي الصلاة بقرطبة، وروى عنه خلق كثير وتفقهوا به، ولم يكن له حذق بالحديث، كان يحدث بالمعنى","citation":"تاريخ الإسلام (7/ 286)","pageId":640013,"verdict":"unclassified"},{"text":"وروى عنه خلق كثير، ولم يكن له علم بالحديث، بل ينقل بالمعنى","citation":"سير أعلام النبلاء (14/ 495)","pageId":727455,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16215":{"id":16215,"criticCount":3,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"البيهقي","statements":[{"text":"وأورد البيهقي في \" الشعب \" من طريق عمار بن عمر بن المختار، عن أبيه، وقال: عمار وعمر ضعيفان، ولم يأت به غيرهما","citation":"لسان الميزان (6/ 48)","pageId":554255,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"فيه كلام، لكن الراوي عنه محمد هو ابن زكريا الغلابي، كذاب","citation":"لسان الميزان (6/ 48)","pageId":554255,"verdict":"jarh"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: لا يتابع على حديثه، ولا يعرف إلا به","citation":"لسان الميزان (6/ 48)","pageId":554255,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16232":{"id":16232,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"ضعفه بعضهم، ولم يترك","citation":"تاريخ الإسلام (7/ 59)","pageId":638519,"verdict":"jarh"},{"text":"الشيخ العالم المحدث","citation":"سير أعلام النبلاء (14/ 153)","pageId":727076,"verdict":"unclassified"}]},{"critic":"الحاكم","statements":[{"text":"وثقه أبو عبد الله الحاكم وغيره، وبعضهم لينه","citation":"سير أعلام النبلاء (14/ 153)","pageId":727076,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}