لآجري: سألت أبا داود عن سعيد بن أبي سلمة بن أبي الحسام، فقال كلاما، ثم قال: وروى عنه أبو عامر العقدي، فقال: حدثنا أبو عمرو المديني [يعني ابن أبي الحسام]. قلت: وروى أبو محمد بن صاعد في الجزء الخامس من حديثه، حدثنا محمد بن معمر القيسي، حدثنا أبو عامر العقدي، حدثنا أبو عمرو السدوسي، أخبرني عبد الله بن أبي بكر بن حزم فذكر حديثا آخر. قال ابن صاعد: أبو عمرو السدوسي هو سعيد بن سلمة، حدثنا هشام بن علي السيرافي بالبصرة، حدثنا عبد الله بن رجاء، حدثنا سعيد بن سلمة بن أبي الحسام، حدثني عبد الله بن أبي بكر، فذكر ذلك الحديث بعينه، فتعين أن أبا عمرو المديني السدوسي المذكور هو سعيد بن سلمة، كما أشار إليه أبو داود، والله تعالى أعلم","citation":"تهذيب التهذيب (4/ 563)","pageId":485003,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11289":{"id":11289,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1184)","pageId":526707,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"بخبر معلل","citation":"لسان الميزان (9/ 478)","pageId":573223,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11295":{"id":11295,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"وعنه: ثابت بن محمد البغدادي يحتمل أن يكون هو الباهلي","citation":"تهذيب التهذيب (4/ 570)","pageId":485129,"verdict":"unclassified"},{"text":"، وإلا فمجهول","citation":"تقريب التهذيب (1/ 1188)","pageId":526790,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"ثابت بن محمد العبدي (ق). لا أدري هو الباهلي أو غيره","citation":"تهذيب الكمال (34/ 173)","pageId":459688,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11299":{"id":11299,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"أكثر عنه محمد بن نصر المروزي","citation":"تهذيب التهذيب (4/ 575)","pageId":485240,"verdict":"unclassif