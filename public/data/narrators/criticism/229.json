{"11455":{"id":11455,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الطبراني","statements":[{"text":"قال الطبراني: لم يرو هذه الأحاديث عن أبي قتادة إلا ولده ولا سمعناها إلا من عبدة، وكانت امرأة عاقلة فصيحة متدينة","citation":"تاريخ بغداد (16/ 627)","pageId":832551,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11460":{"id":11460,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"سمع: محمد بن عوف، والعباس بن الوليد بن مزيد، ويزيد بن عبد الصمد، وجماعة","citation":"تاريخ الإسلام (7/ 395)","pageId":640766,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11464":{"id":11464,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"كتبت عنه بالري قدم علينا، وكان ثقة صدوقا","citation":"الجرح والتعديل لابن أبي حاتم (8/ 292)","pageId":714641,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"11466":{"id":11466,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"وثقه الدارقطني وحده","citation":"تاريخ الإسلام (6/ 1034)","pageId":638036,"verdict":"tadil"},{"text":"حدثني علي بن محمد بن نصر قال: سمعت حمزة بن يوسف يقول: سألت الدارقطني عن محمد بن عبد العزيز بن محمد بن ربيعة الكلابي أبي مليل الكوفي، فقال: ثقة","citation":"تاريخ بغداد (3/ 611)","pageId":818751,"verdict":"tadil"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"غريب من حديث شعبة، من رواية الحسن بن صالح عنه، لم نكتبه إلا من حديث أبي مليل","citation":"تاريخ بغداد (3/ 611)","pageId":818751,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11468":{"id":11468,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الطحاوي","statements":[{"text":"قال أبو جعفر الطحاوي: كان فقيها لا يدافع، رحمه الله","citation":"تاريخ الإسلام (6/ 813)","pageId":636825,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11471":{"id":11471,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"مجهول الحال","citation":"تاريخ الإسلام (6/ 836)","pageId":636956,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"11472":{"id":11472,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"سمع: خالد بن يوسف السمتي، ومحمد بن بشار، وأبا موسى، والعباس الرياشي","citation":"تاريخ الإسلام (7/ 198)","pageId":639585,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع: خالد بن يوسف السمتي، ومحمد بن بشار، وأبا موسى، والعباس الرياشي","citation":"تاريخ الإسلام (7/ 198)","pageId":639585}]}],"flags":[]},"11476":{"id":11476,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو بكر الإسماعيلي","statements":[{"text":"وروى عنه الإسماعيلي في معجمه، وقال: بصري منكر الحديث","citation":"لسان الميزان (7/ 360)","pageId":557926,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"11479":{"id":11479,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"قال أبو نعيم الأصبهاني: لا بأس به","citation":"تاريخ الإسلام (6/ 906)","pageId":637308,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"11486":{"id":11486,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"سمع مطرف بن عبد الله الشاري الفقيه، وعبد العزيز بن عبد الله الإدريسي. روى عنه الطبراني وغيره","citation":"تاريخ الإسلام (6/ 773)","pageId":636553,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11489":{"id":11489,"criticCount":3,"statementCount":6,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":5},"critics":[{"critic":"الذهبى","statements":[{"text":"سمع أباه، وموسى بن عامر، ومحمود بن خالد، ومحمد بن هاشم البعلبكي، وعبد الوهاب بن عبد الرحيم الأشجعي، وأبا إسحاق الجوزجاني، وأبا عتبة الحجازي، ومحمد بن إسماعيل ابن علية، وأبا أمية الطرسوسي، وخلقا كثيرا. وكان ذا عناية وإتقان، وعمر دهرا","citation":"سير أعلام النبلاء (15/ 268)","pageId":727787,"verdict":"unclassified"},{"text":"سمع: أباه، وموسى بن عامر، ومحمود بن خالد، ومحمد بن هاشم البعلبكي، وعبد الوهاب بن عبد الرحيم الأشجعي، وجماعة كبيرة","citation":"تاريخ الإسلام (7/ 544)","pageId":641570,"verdict":"unclassified"},{"text":"الشيخ الإمام المحدث الثقة","citation":"سير أعلام النبلاء (15/ 268)","pageId":727787,"verdict":"tadil"}]},{"critic":"عبد الوهاب بن الحسن الكلابي","statements":[{"text":"وقال عبد الوهاب الكلابي: مات في ذي القعدة سنة ثمان وعشرين وثلاثمائة وقيل: مات في محرمها وهو من بيت علم وتقدم","citation":"سير أعلام النبلاء (15/ 268)","pageId":727787,"verdict":"unclassified"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"قال الخطيب: كان مليا بحديث الوليد بن مسلم، روى عن جماعة من أصحابه","citation":"تاريخ الإسلام (7/ 544)","pageId":641570,"verdict":"unclassified"},{"text":"قال أبو بكر الخطيب: كان مليئا بحديث الوليد بن مسلم. روى عن عدة من أصحابه","citation":"سير أعلام النبلاء (15/ 268)","pageId":727787,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11490":{"id":11490,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو بكر الإسماعيلي","statements":[{"text":"وعنه الإسماعيلي في معجمه. وقال: وكان ينسب إلى التفسير، ولم يكن في الحديث بذاك","citation":"لسان الميزان (7/ 425)","pageId":558139,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11491":{"id":11491,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"زاهد عابد، يقال إنه من الأبدال","citation":"تاريخ الإسلام (7/ 115)","pageId":638921,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11492":{"id":11492,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الطبراني","statements":[{"text":": تفرد بخبر باطل. قال الطبراني: حدثنا محمد بن عبيد، حدثنا أبي عن جدي عن حفص بن ميسرة عن زيد بن أسلم، عن أبيه، عن عمر رضي الله عنه قال: قال رسول الله صلى الله عليه وسلم: \" القرآن ألف ألف حرف وسبعة وعشرون ألف حرف، فمن قرأه صابرا محتسبا كان له بكل حرف زوجة من الحور العين \". قال الطبراني في معجمه الأوسط: لا يروى عن عمر إلا بهذا الإسناد","citation":"لسان الميزان (7/ 334)","pageId":557840,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11494":{"id":11494,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"سمع: أبا علي عبيد الله بن عبد المجيد الحنفي. روى عنه: الطبراني. وهو من كبار شيوخه","citation":"تاريخ الإسلام (6/ 615)","pageId":635686,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}