ي يقول: ضرب عمرو بن علي الصيرفي على حديثه في كتابي. وسمعت أبي يقول: هو ضعيف الحديث","citation":"الجرح والتعديل لابن أبي حاتم (3/ 297)","pageId":690997,"verdict":"jarh"},{"text":"وهاه أبو حفص الفلاس","citation":"لسان الميزان (2/ 540)","pageId":546666,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17010":{"id":17010,"criticCount":3,"statementCount":4,"tally":{"jarh":1,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال البستي: فيه نظر","citation":"لسان الميزان (2/ 540)","pageId":546663,"verdict":"jarh"},{"text":"وذكره ابن حبان في الثقات فقال: روى عنه أبو إسحاق السبيعي ويقال له: حبال بن أبي الحبال","citation":"لسان الميزان (2/ 540)","pageId":546663,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"حدثنا عبد الرحمن، قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين أنه قال: حبان بن رفيدة ثقة","citation":"الجرح والتعديل لابن أبي حاتم (3/ 315)","pageId":691188,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (2/ 540)","pageId":546663,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17016":{"id":17016,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عنه فقال: محله الصدق","citation":"الجرح والتعديل لابن أبي حاتم (3/ 319)","pageId":691234,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17018":{"id":17018,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن يونس المصري","statements":[{"text":"روى عن المستورد بن شداد حديثا منكرا. قاله ابن يونس في تاريخ مصر قال: وما أدري ممن هو، روى عنه يزيد بن أبي حبيب","citation":"لسان الميزان (2/ 569)","pageId":546828,"verdict":"unclassified"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وذكره ابن أبي حاتم في الجرح والتعديل وابن حبان في طبقة ثقات التابعين، فلم يعرفاه بأكثر من روايته عن المستورد، إلا أن ابن حبان قال: حديج بن عمرو، وقال: روى عنه الحارث بن يزيد","citation":"لسان الميزان (2/ 569)","pageId":546828,"verdict":"tadil"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن أبي حاتم في الجرح والتعديل وابن حبان في طبقة ثقات التابعين، فلم يعرفاه بأكثر من روايته عن المستورد، إلا أن ابن حبان قال: حديج بن عمرو، وقال: روى عنه الحارث بن يزيد","citation":"لسان الميزان (2/ 569)","pageId":546828,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17019":{"id":17019,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (3/ 31)","pageId":418436,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (3/ 31)","pageId":418436}]}],"flags":[]},"17020":{"id":17020,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"الإمام المحدث الصادق","citation":"سير أعلام النبلاء (15/ 477)","pageId":728096,"verdict":"unclassified"},{"text":"ثقة رحال","citation":"سير أعلام النبلاء (15/ 477)","pageId":728096,"verdict":"tadil"},{"text":"ثقة، مسند. من كبار شيوخ أصبهان","citation":"تاريخ الإسلام (7/ 784)","pageId":642963,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17021":{"id":17021,"criticCount":3,"statementCount":6,"tally":{"jarh":3,"tadil":0,"mixed":1,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"وقال ابن حبان: روى عن ابن عيينة وأهل بلده العجائب لا يجوز الاحتجاج به، ولا الرواية عنه إلا للمعرفة فقط","citation":"لسان الميزان (4/ 336)","pageId":550810,"verdict":"unclassified"}]},{"critic":"ابن عدي","statements":[{"text":"قال الشيخ: وهذا لا أعرفه إلا من رواية الضحاك بن حجوة بهذا الإسناد","citation":"الكامل في الضعفاء (5/ 158)","pageId":576266,"verdict":"unclassified"},{"text":"منكر الحديث عن الثقات","citation":"الكامل في الضعفاء (5/ 158)","pageId":576266,"verdict":"mixed"},{"text":"قال الشيخ: والضحاك بن حجوة هذا كل رواياته مناكير، إما متنا أو إسنادا","citation":"الكامل في الضعفاء (5/ 158)","pageId":576266,"verdict":"jarh"},{"text":"وقال ابن عدي: هو أبو عبد الله المنبجي كل رواياته مناكير إما متنا وإما إسنادا، ومن مصائبه قال: حدثنا الفريابي، حدثنا الثوري، عن ابن المنكدر، عن جابر رضي الله عنه مرفوعا \" من أكرم العلماء، فقد أكرم الله ورسوله \"","citation":"لسان الميزان (4/ 336)","pageId":550810,"verdict":"jarh"}]},{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: كان يضع الحديث","citation":"لسان الميزان (4/ 336)","pageId":550810,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17027":{"id":17027,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (13/ 297)","pageId":829246,"verdict":"tadil"},{"text":"وثقه الخطيب","citation":"تاريخ الإسلام (6/ 125)","pageId":633181,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17029":{"id":17029,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"حدثنا عبد الرحمن، قال: سئل أبي عنه فقال: صدوق","citation":"الجرح والتعديل لابن أبي حاتم (4/ 115)","pageId":695298,"verdict":"tadil"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وكتبت عنه، وهو صدوق ثقة","citation":"الجرح والتعديل لابن أبي حاتم (4/ 115)","pageId":695298,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17031":{"id":17031,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول ذلك. وسئل عنه فقال: شيخ، لا أفهمه كما ينبغي","citation":"الجرح والتعديل لابن أبي حاتم (4/ 111)","pageId":695278,"verdict":"unclassified"},{"text":"قال أبو حاتم: لا أفهمه كما ينبغي","citation":"لسان الميزان (4/ 149)","pageId":549989,"verdict":"unclassified"}]},{"critic":"الأزدي","statem