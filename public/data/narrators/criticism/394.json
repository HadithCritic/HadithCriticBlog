:"unclassified"}]}],"phenomena":[],"flags":[]},"19725":{"id":19725,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"حدثنا عبد الرحمن، قال: سألت أبي عنه فقال: هو مجهول، وأبوه معروف","citation":"الجرح والتعديل لابن أبي حاتم (3/ 180)","pageId":689796,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19726":{"id":19726,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: لا بأس بحديثه محله الصدق","citation":"الجرح والتعديل لابن أبي حاتم (6/ 275)","pageId":706226,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"مستقيم الحديث","citation":"الثقات (8/ 491)","pageId":612052,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19727":{"id":19727,"criticCount":3,"statementCount":4,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"الذهبى","statements":[{"text":"عن رجل، وعنه هشام بن عمار. فذكر خبرا موضوعا في الدعاء لحفظ القرآن، ساقه العقيلي","citation":"لسان الميزان (6/ 471)","pageId":556097,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: هو وشيخه مجهولان بالنقل، والحديث غير محفوظ، قال: ورواه الوليد عن ابن جريج، عن عطاء وعكرمة، عن ابن عباس، وهو غير محفوظ أيضا، وليس لكل منهما أصل","citation":"لسان الميزان (6/ 471)","pageId":556097,"verdict":"jarh"},{"text":"عن رجل، وعنه هشام بن عمار. فذكر خبرا موضوعا في الدعاء لحفظ القرآن، ساقه العقيلي","citation":"لسان الميزان (6/ 471)","pageId":556097,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"وهو في \" جامع الترمذي \" من طريق الوليد، عن ابن جريج، ليس بينهما واسطة، فلعل الوليد دلسه عن ابن جريج، فقد ذكر ابن أبي حاتم في ترجمة محمد بن إبراهيم أنه روى عنه الوليد بن مسلم، وهشام بن عمار","citation":"لسان الميزان (6/ 471)","pageId":556097,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19732":{"id":19732,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكر ابن حبان في ثقات التابعين","citation":"تهذيب التهذيب (1/ 341)","pageId":466514,"verdict":"tadil"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وذكره ابن أبي حاتم في من لم يسم والده ممن اسمه الحارث، ولم يذكر فيه جرحا","citation":"تهذيب التهذيب (1/ 341)","pageId":466514,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19734":{"id":19734,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"ولم يترجم في التهذيب لمحمد بل جزم في ابن بجيد في المبهمات أن اسمه عبد الرحمن وليس بجيد ؛ لأنه لم يقع في النسائي إلا كما وقع عند أكثر رواة الموطأ غير مسمى لا هو، ولا أمه","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 171)","pageId":580805,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19737":{"id":19737,"criticCount":4,"statementCount":5,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":4},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (2/ 472)","pageId":687286,"verdict":"unclassified"},{"text":"وقال أبو حاتم: شيخ","citation":"لسان الميزان (2/ 402)","pageId":545861,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \"الثقات\"","citation":"لسان الميزان (2/ 402)","pageId":545861,"verdict":"tadil"}]},{"critic":"الأزدي","statements":[{"text":"ليس حديثه بالقائم، قاله الأزدي","citation":"لسان الميزان (2/ 402)","pageId":545861,"verdict":"unclassified"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وقال ابن أبي حاتم: روى عنه إسرائيل أيضا","citation":"لسان الميزان (2/ 402)","pageId":545861,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19739":{"id":19739,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"وقال ابن حبان في \" الثقات \": الحسن بن عطاء المدني، روى عن الحسن البصري وأبيه، روى عنه موسى بن إسماعيل","citation":"لسان الميزان (3/ 69)","pageId":547139,"verdict":"tadil"}]},{"critic":"أحمد بن حنبل","statements":[{"text":"قال أحمد بن حنبل: لا أعرفه","citation":"لسان الميزان (3/ 69)","pageId":547139,"verdict":"unclassified"},{"text":"حدثنا عبد الرحمن، نا محمد بن حمويه بن الحسن، قال: سمعت أبا طالب أحمد بن حميد، قال: سألت أحمد بن حنبل، عن الحسن بن عطاء الذي روى عن حماد بن سلمة قال: لا أعرفه","citation":"الجرح والتعديل لابن أبي حاتم (3/ 30)","pageId":688338,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19743":{"id":19743,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"مستقيم الحديث","citation":"الثقات (9/ 3)","pageId":612551,"verdict":"tadil"},{"text":"قال ابن حبان: لم يحدث به وكيع بالعراق، وهذا مما تفرد به غالب عنه. وذكره في \" الثقات \" وقال: من أهل فلسطين، مستقيم الحديث جدا، كذا قال","citation":"لسان الميزان (6/ 301)","pageId":555261,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"عن ابن وهب بحديث باطل، وكان من أهل غزة، قل ما روى","citation":"لسان الميزان (6/ 301)","pageId":555261,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"وذكره العقيلي في \" الضعفاء \" فقال: حديثه منكر، لا أصل له، ولم يأت به عن ابن وهب غيره","citation":"لسان الميزان (6/ 301)","pageId":555261,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19744":{"id":19744,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"كان مسلما في عهد النبي - صلى الله عليه وسلم - وكاتبه","citation":"الإصابة في تمييز الصحابة (8/ 234)","pageId":428107,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"كان مسلما في عهد النبي - صلى الله عليه وسلم - وكاتبه","citation":"الإصاب