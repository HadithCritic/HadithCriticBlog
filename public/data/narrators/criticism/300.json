itic":"ابن حجر","statements":[{"text":"والصواب: عن محمد بن طلحة، عن معاوية بن جاهمة عن أبيه ؛ فصحف \"عن\" فصارت \"ابن\" وقدم قوله: عن أبيه، فخرج عنه أن لطلحة صحبة. وليس كذلك، بل ليس بينه وبين معاوية بن جاهمة نسب، ولو كان الأمر على ظاهر الإسناد لكان هؤلاء أربعة في نسق صحبوا النبي صلى الله عليه وسلم، طلحة بن معاوية بن جاهمة بن العباس بن مرداس","citation":"الإصابة في تمييز الصحابة (2/ 141)","pageId":416541,"verdict":"unclassified"}]},{"critic":"محمد بن سعد","statements":[{"text":"وذكره ابن سعد في طبقة من شهد الخندق، وقال: أسلم وصحب","citation":"الإصابة في تمييز الصحابة (2/ 141)","pageId":416541,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15048":{"id":15048,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"إن كان حفظه محمد بن عبد الله بن عبيد بن عمير الليثي","citation":"الثقات (4/ 348)","pageId":589375,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15049":{"id":15049,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"حدث عنه ليث بن أبي سليم: في بول الجارية، ليس بمقنع","citation":"لسان الميزان (2/ 569)","pageId":546826,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"يروي المقاطيع","citation":"الثقات (4/ 194)","pageId":587713,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}