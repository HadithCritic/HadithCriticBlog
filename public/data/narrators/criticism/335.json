classified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"- سفيان ووهب ابنا قيس بن أبان طائفيان، لهما صحبة، روت أميمة بنت رقيقة، عن رقيقة عنهما، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (4/ 218)","pageId":696287,"verdict":"unclassified"},{"text":"سمعت أبي يقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (9/ 22)","pageId":717002,"verdict":"jarh"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"له صحبة","citation":"الجرح والتعديل لابن أبي حاتم (9/ 22)","pageId":717002,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16783":{"id":16783,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"- سفيان ووهب ابنا قيس بن أبان طائفيان، لهما صحبة، روت أميمة بنت رقيقة، عن رقيقة عنهما، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (4/ 218)","pageId":696287,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 182)","pageId":583964,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16792":{"id":16792,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 380)","pageId":585285,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16793":{"id":16793,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو القاسم البغوي","statements":[{"text":"ذكره البغوي في الصحابة","citation":"الإصابة في تمييز الصحابة (9/ 94)","pageId":429454,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وقال ابن حبان: يقال: إن له صحبة","citation":"الإصابة في تمييز الصحابة (9/ 94)","pageId":429454,"verdict":"unclassified"},{"text":"يقال: إن له صحبة","citation":"الثقات (3/ 341)","pageId":585023,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16794":{"id":16794,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (8/ 469)","pageId":716362,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16797":{"id":16797,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو القاسم البغوي","statements":[{"text":"ذكره البغوي وغيره في الصحابة","citation":"الإصابة في تمييز الصحابة (6/ 584)","pageId":425428,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وهكذا أخرجه ابن مردويه في التفسير. وأخرجه عبد بن حميد، وابن جرير ؛ كلاهما من وجه آخر عن أبي معشر، فقالا: عن محمد بن عبد الرحمن، قال أبو عمر: هذا هو الصواب في تسمية ولده. قلت: وأخرجه ابن شاهين، وابن مردويه في التفسير أيضا من وجه آخر عن أبي معشر، فقالا: يحيى بن عبد الرحمن، والاضطراب فيه عن أبي معشر، وهو نجيح بن عبد الرحمن، فإنه ضعيف. وقد رواه سعيد بن أبي هلال، عن يحيى بن شبل ؛ فخالف أبا معشر في سنده. وأخرجه ابن جرير، وابن شاهين من طريق الليث، عن خالد بن يزيد، عن سعيد، عن يحيى بن شبل: أن رجلا من بني نصر، أخبره عن رجل من بني هلال، عن أبيه: أنه أخبره أنه سأل النبي - صلى الله عليه وسلم - فذكر نحوه. وأخرجه ابن مردويه من طريق ابن لهيعة، عن خالد بن يزيد، لكن لم يقل عن أبيه، ورواية الليث أوصل","citation":"الإصابة في تمييز الصحابة (6/ 584)","pageId":425428,"verdict":"jarh"}]}],"phenomena":[],"flags":[]}}