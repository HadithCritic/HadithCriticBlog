{"16755":{"id":16755,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عن بدر بن الخليل فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (2/ 412)","pageId":686639,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"حدثنا عبد الرحمن قال: قرئ على العباس بن محمد الدوري قال: سمعت يحيى بن معين يقول: بدر بن خليل الأسدي ثقة، روى عنه شريك","citation":"الجرح والتعديل لابن أبي حاتم (2/ 412)","pageId":686639,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16756":{"id":16756,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سئل أبي عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (4/ 419)","pageId":698181,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16761":{"id":16761,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"العقيلي","statements":[{"text":"قال العقيلي: حديثه غير محفوظ، وشيخه مجهول","citation":"لسان الميزان (6/ 393)","pageId":555705,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"16764":{"id":16764,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"(قلت) :، فإن كان الطبراني ضبط أن اسم الصحابي: عبد الله بن حصن، ولم يلتبس عليه بهذا التابعي، فقد اتفقا في الاسم واسم الأب والكنية، وافترقا في النسبة، وإلا فالاسم والكنية للتابعي، وأما الصحابي الدارمي، فلم يسم","citation":"الإصابة في تمييز الصحابة (6/ 101)","pageId":424211,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16769":{"id":16769,"criticCount":4,"statementCount":7,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن القطان الفاسي","statements":[{"text":"قال ابن القطان: ثقة، نسب إلى غفلة","citation":"لسان الميزان (6/ 103)","pageId":554431,"verdict":"tadil"}]},{"critic":"الدارقطني","statements":[{"text":"وقال الدارقطني: ثقة، وقد يشبه به عمرو بن زرارة النيسابوري، وهو ثقة أيضا","citation":"تهذيب التهذيب (3/ 271)","pageId":476221,"verdict":"tadil"},{"text":"وقال الدارقطني: ثقة","citation":"لسان الميزان (6/ 103)","pageId":554431,"verdict":"tadil"}]},{"critic":"صالح جزرة","statements":[{"text":"وقال صالح بن محمد: شيخ مغفل","citation":"لسان الميزان (6/ 103)","pageId":554431,"verdict":"unclassified"},{"text":"قال صالح: قدم بغداد فاجتمع عليه جمع عظيم","citation":"تهذيب التهذيب (3/ 271)","pageId":476221,"verdict":"unclassified"},{"text":"ونقل عبد المؤمن بن خلف الحافظ النسفي، عن صالح بن محمد قال: كان عمرو بن زرارة مغفلا وحكى له في ذلك قصة","citation":"تهذيب التهذيب (3/ 271)","pageId":476221,"verdict":"unclassified"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"ونقل الخطيب عن البرقاني أن البغوي روى عنهما جميعا، وتعقبه الخطيب، فنفى أن يكون البغوي سمع من النيسابوري شيئا","citation":"تهذيب التهذيب (3/ 271)","pageId":476221,"verdict":"unclassified"}]}],"phenomena":[{"key":"الاختلاف في سماع الراوي","label":"Audition Disputed","statements":[{"text":"ونقل الخطيب عن البرقاني أن البغوي روى عنهما جميعا، وتعقبه الخطيب، فنفى أن يكون البغوي سمع من النيسابوري شيئا","citation":"تهذيب التهذيب (3/ 271)","pageId":476221}]}],"flags":["Audition Disputed"]},"16771":{"id":16771,"criticCount":5,"statementCount":6,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"وقال ابن أبي حاتم: روى عن أبي الدرداء، وأبي أمامة، وواثلة بن الأسقع \" أن النبي - صلى الله عليه وسلم - سئل كيف تبعث الأنبياء ؟ \". روى عنه فياض بن محمد الرقي. سألت أبي عنه فقال: لا أعرفه، وهذا باطل","citation":"لسان الميزان (5/ 40)","pageId":552037,"verdict":"unclassified"},{"text":"نا عبد الرحمن، قال: سألت أبي عنه، فقال: لا أعرفه، وهذا حديث باطل","citation":"الجرح والتعديل لابن أبي حاتم (5/ 197)","pageId":700853,"verdict":"unclassified"}]},{"critic":"أحمد بن حنبل","statements":[{"text":"قال أحمد: أحاديثه موضوعة","citation":"لسان الميزان (5/ 40)","pageId":552037,"verdict":"unclassified"}]},{"critic":"الأزدي","statements":[{"text":"عبد الله بن يزيد الدالاني ليس بثقة، ذكره الأزدي وغيره","citation":"لسان الميزان (5/ 40)","pageId":552037,"verdict":"jarh"}]},{"critic":"الجوزجاني","statements":[{"text":"وقال الجوزجاني: أحاديثه منكرة","citation":"لسان الميزان (5/ 40)","pageId":552037,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وأتى بعجائب. روى أبو معاوية عنه، عن أبي أمامة، وواثلة، وأنس مرفوعا: \" اقرؤوا القرآن من البقرة إلى سورة الناس، ولا تقرؤوه من سورة الناس إلى البقرة \"","citation":"لسان الميزان (5/ 40)","pageId":552037,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16774":{"id":16774,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: ذكره أبي عن إسحاق بن منصور، عن يحيى [بن معين أنه] قال: عبد الله بن المستورد صالح","citation":"الجرح والتعديل لابن أبي حاتم (5/ 170)","pageId":700585,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16777":{"id":16777,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"وأحسبه بن جري بن كليب","citation":"الثقات (6/ 178)","pageId":597327,"verdict":"unclassified"}]},{"critic":"محمد بن الحسن الطوسي","statements":[{"text":"ذكره الطوسي في رجال الشيعة وقال: روى عن الصادق، ويقال: إنه أدرك الباقر","citation":"لسان الميزان (2/ 546)","pageId":546697,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"حدثنا عبد الرحمن، قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين قال: حبيب بن جري العبسي رجل صالح","citation":"الجرح والتعديل لابن أبي حاتم (3/ 97)","pageId":689070,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16778":{"id":16778,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"te