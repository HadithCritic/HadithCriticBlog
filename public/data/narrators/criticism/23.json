{"1163":{"id":1163,"criticCount":4,"statementCount":6,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"ثقة، صاحب حديث","citation":"تقريب التهذيب (1/ 201)","pageId":508816,"verdict":"tadil"}]},{"critic":"النسائي","statements":[{"text":"قال النسائي: ثقة","citation":"تهذيب التهذيب (1/ 312)","pageId":466227,"verdict":"tadil"},{"text":"قال النسائي: ثقة","citation":"تهذيب الكمال (5/ 101)","pageId":442560,"verdict":"tadil"}]},{"critic":"مسلمة بن القاسم","statements":[{"text":"وقال [مسلمة بن قاسم]: كوفي صاحب حديث كيس","citation":"تهذيب التهذيب (1/ 312)","pageId":466227,"verdict":"unclassified"},{"text":"قال مسلمة في كتاب \"الصلة\": كوفي صاحب حديث، كيس، توفي بالكوفة","citation":"إكمال تهذيب الكمال (3/ 231)","pageId":533329,"verdict":"unclassified"}]},{"critic":"أحمد بن محمد بن هارون البغدادي","statements":[{"text":"ولما ذكرها الخلال في \"أصحاب أحمد\" مدحه وقال: كان عنده عن أبي عبد الله مسائل صالحة، وكناه أبا عبد الله","citation":"إكمال تهذيب الكمال (3/ 231)","pageId":533329,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1165":{"id":1165,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (1/ 313)","pageId":466237,"verdict":"tadil"},{"text":"ذكره أبو حاتم بن حبان في \"جملة الثقات\" وكناه أبا كثير، وقال: روى عنه عبد العزيز بن رفيع، وقد روى ابن جريح عن ابنه سعيد بن جعفر، وابن أخيه سعيد بن كثير","citation":"إكمال تهذيب الكمال (3/ 233)","pageId":533337,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 201)","pageId":508828,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1170":{"id":1170,"criticCount":4,"statementCount":7,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان في \" الثقات \": مستقيم الحديث كان ينتحل مذهب الرأي قديما، ثم انتحل السنن، وجعل يذب عنها","citation":"تهذيب التهذيب (1/ 314)","pageId":466257,"verdict":"tadil"},{"text":"مستقيم الحديث، ولكنه كان ينتحل مذهب الرأي، ثم انتحل السنن وجعل يذب عنها حتى بلغ من صلابتها أن أحمد بن حرب دخل واشجرد ودعا الناس إلى الإرجاء فأفسد بها عالما منهم. فلما بلغ جمعة بن عبد الله ذلك خرج إلى واشجرد، فجعل يبين للناس أمره، ويصدهم عنه ويخبرهم ببدعته","citation":"الثقات (8/ 165)","pageId":608371,"verdict":"tadil"},{"text":"خرج ابن حبان حديثه في \"صحيحه\"","citation":"إكمال تهذيب الكمال (3/ 237)","pageId":533347,"verdict":"unclassified"},{"text":"ذكره أبو حاتم بن حبان في كتاب \" الثقات \"، وقال: مستقيم الحديث كان ينتحل مذهب الرأي قديما، ثم انتحل السنن، وجعل يذب عنها حتى بلغ من صلابته فيه أن أحمد بن حرب دخل واشجرد، ودعا الناس إلى الإرجاء، فأفسد بها عالما منهم، فلما بلغ جمعة بن عبد الله ذلك، خرج على إثره إلى واشجرد، فجعل يبين للناس أمرهم ويصدهم عنه، ويخبرهم ببدعته","citation":"تهذيب الكمال (5/ 120)","pageId":442578,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 202)","pageId":508842,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"ثقة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 213)","pageId":491446,"verdict":"tadil"}]},{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"وقال ابن منده: جمعة أخو خاقان وليس له في \" الصحيح \" سوى حديث واحد في فضل العجوة","citation":"تهذيب التهذيب (1/ 314)","pageId":466257,"verdict":"unclassified"}]}],"phenomena":[{"key":"التوثيق الضمني","label":"Implicit Authentication","statements":[{"text":"خرج ابن حبان حديثه في \"صحيحه\"","citation":"إكمال تهذيب الكمال (3/ 237)","pageId":533347}]}],"flags":[]},"1171":{"id":1171,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \"الثقات","citation":"إكمال تهذيب الكمال (3/ 237)","pageId":533350,"verdict":"tadil"},{"text":"وذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (1/ 314)","pageId":466260,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 202)","pageId":508844,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1175":{"id":1175,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان في كتاب \" الثقات \": لا أدري من هو وابن من هو","citation":"تهذيب التهذيب (1/ 317)","pageId":466281,"verdict":"tadil"},{"text":"لا أدري من هو ولا ابن من هو","citation":"الثقات (6/ 146)","pageId":597014,"verdict":"unclassified"},{"text":"ذكره أبو حاتم بن حبان في كتاب \" الثقات \"، وقال: لا أدري من هو ولا ابن من هو","citation":"تهذيب الكمال (5/ 132)","pageId":442595,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 203)","pageId":508858,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1176":{"id":1176,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا تعرف","citation":"تقريب التهذيب (1/ 1348)","pageId":530472,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1177":{"id":1177,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكرها ابن حبان في \" الثقات \" في خصيلة","citation":"تهذيب التهذيب (4/ 667)","pageId":489073,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبولة","citation":"تقريب التهذيب (1/ 1368)","pageId":530727,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1183":{"id":1183,"criticCount":4,"statementCount":4,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة. روى عنه مسلم بن عبد الله بن خبيب الجهني، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (2/ 511)","pageId":687671,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"له صحبة","citation":"تقريب التهذيب (1/ 204)","pageId":508866,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"صحابي","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 216)","pageId":491466,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"له صحبة","citation":"تهذيب الكمال (5/ 139)","pageId":442604,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1192":{"id":1192,"criticCount":4,"statementCount":5,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"تقدم في ترجمة جارية بن قدامة ما يدل على أنه عم الأحنف، فليراجع منه. ومما يؤيده قول البخاري في \" التاريخ \": حدثنا آدم، حدثنا شعبة، حدثنا أبو جمرة، سمعت جويرية بن قدامة التميمي [قال: ] سمعت عمر بن الخطاب يخطب قال: رأيت كأن ديكا نقرني - فذكر الحديث، وأخرج منه في \" الصحيح \" عن آدم طرفا منه. وذكره ابن حبان في \" الثقات \"، وجعله تميميا أيضا، فلا يبعد أن يكون هو جارية بن قدامة، والله أعلم، ثم وجدت ذلك صريحا. قال ابن أبي شيبة في \" مصنفه \": حدثنا ابن إدريس، حدثنا شعبة، عن أبي جمرة، عن جارية بن قدامة السعدي، فذكر الحديث بتمامه","citation":"تهذيب التهذيب (1/ 321)","pageId":466333,"verdict":"tadil"},{"text":"وذكره أبو حاتم البستي في \"جملة الثقات","citation":"إكمال تهذيب الكمال (3/ 261)","pageId":533398,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"ثقة","citation":"تقريب التهذيب (1/ 205)","pageId":508894,"verdict":"tadil"}]},{"critic":"ابن خلفون","statements":[{"text":"وذكره ابن خلفون في كتاب \"الثقات\"","citation":"إكمال تهذيب الكمال (3/ 261)","pageId":533398,"verdict":"tadil"}]},{"critic":"العجلي","statements":[{"text":"وقال العجلي: جارية بن قدامة التيمي تابعي ثقة","citation":"إكمال تهذيب الكمال (3/ 261)","pageId":533398,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"1194":{"id":1194,"criticCount":4,"statementCount":5,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"ابن حبان","statements":[{"text":"ولها صحبة","citation":"الثقات (3/ 336)","pageId":584982,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"كانت من السابقات","citation":"الإصابة في تمييز الصحابة (14/ 313)","pageId":439673,"verdict":"unclassified"},{"text":"صحابية","citation":"تقريب التهذيب (1/ 1378)","pageId":530850,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"من مهاجرة الحبشة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 222)","pageId":506455,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"لها صحبة","citation":"تهذيب الكمال (35/ 335)","pageId":463619,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1198":{"id":1198,"criticCount":4,"statementCount":6,"tally":{"jarh":3,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره أبو حاتم بن حبان البستي في \"جملة الثقات\"","citation":"إكمال تهذيب الكمال (3/ 273)","pageId":533423,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (1/ 325)","pageId":466366,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 208)","pageId":508919,"verdict":"jarh"}]},{"critic":"ابن القطان الفاسي","statements":[{"text":"قال أبو الحسن بن القطان في كتاب \"الوهم والإيهام \": لم يرو عنه غير سعد بن هشام وهو مجهول","citation":"إكمال تهذيب الكمال (3/ 273)","pageId":533423,"verdict":"jarh"},{"text":"وقال ابن القطان الفاسي: لم يرو عنه غير هشام بن سعد، فهو مجهول","citation":"تهذيب التهذيب (1/ 325)","pageId":466366,"verdict":"jarh"}]},{"critic":"الحاكم","statements":[{"text":"وخرج الحاكم حديثه في \"مستدركه\"","citation":"إكمال تهذيب الكمال (3/ 273)","pageId":533423,"verdict":"unclassified"}]}],"phenomena":[{"key":"التوثيق الضمني","label":"Implicit Authentication","statements":[{"text":"وخرج الحاكم حديثه في \"مستدركه\"","citation":"إكمال تهذيب الكمال (3/ 273)","pageId":533423}]}],"flags":[]}}