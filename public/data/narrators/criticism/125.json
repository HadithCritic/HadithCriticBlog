{"6252":{"id":6252,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب الثقات","citation":"تهذيب الكمال (28/ 236)","pageId":455370,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 115)","pageId":480471,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 958)","pageId":522273,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 313)","pageId":501351,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"6254":{"id":6254,"criticCount":4,"statementCount":6,"tally":{"jarh":1,"tadil":3,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 115)","pageId":480475,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب الثقات","citation":"تهذيب الكمال (28/ 238)","pageId":455374,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 314)","pageId":501355,"verdict":"tadil"}]},{"critic":"ابن القطان الفاسي","statements":[{"text":"قال ابن القطان: ما روى عنه غير يعلى بن عطاء، ولا يعرف أيضا حاله","citation":"إكمال تهذيب الكمال (11/ 281)","pageId":540833,"verdict":"unclassified"},{"text":"قلت: وقال ابن القطان: لا يعرف حاله","citation":"تهذيب التهذيب (4/ 115)","pageId":480475,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 958)","pageId":522277,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"6256":{"id":6256,"criticCount":4,"statementCount":5,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"قال ابن معين: حديثه في الكحل منكر","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 314)","pageId":501357,"verdict":"unclassified"},{"text":"معبد بن هوذة الأنصاري. عن النبي صلى الله عليه وآله وسلم أنه أمر بالإثمد المروح عند النوم، وقال: ليتقه الصائم. روى حديثه عبد الرحمن بن النعمان بن سعيد عن أبيه عن جده. قال أبو داود: قال لي يحيى بن معين: هو حديث منكر. قلت: وجعل ابن منده وجماعة الضمير في قوله: عن جده، للنعمان، وتكون الرواية والصحبة لهوذة، ونسبوه فقالوا: هوذة بن قيس بن عباد بن رهم، فالله تعالى أعلم","citation":"تهذيب التهذيب (4/ 116)","pageId":480477,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة]، روى عنه ابن النعمان بن معبد حديث الكحل للصائم سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 279)","pageId":714501,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"يقال: إن له صحبة","citation":"الثقات (3/ 389)","pageId":585357,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"صحابي","citation":"تقريب التهذيب (1/ 958)","pageId":522279,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"6265":{"id":6265,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"وكان مولده سنة مائة. قلت: إن صح أن هذا مولده فروايته عن مجاهد مرسلة، والظاهر أن بينهما ابن أبي نجيح","citation":"تهذيب التهذيب (4/ 119)","pageId":480508,"verdict":"unclassified"},{"text":"صدوق مقرئ مشهور","citation":"تقريب التهذيب (1/ 959)","pageId":522305,"verdict":"tadil"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"وكان مولده سنة مائة. قلت: إن صح أن هذا مولده فروايته عن مجاهد مرسلة، والظاهر أن بينهما ابن أبي نجيح","citation":"تهذيب التهذيب (4/ 119)","pageId":480508}]}],"flags":["Sends Mursal Reports"]},"6266":{"id":6266,"criticCount":3,"statementCount":4,"tally":{"jarh":1,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب الثقات","citation":"تهذيب الكمال (28/ 281)","pageId":455417,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","cit