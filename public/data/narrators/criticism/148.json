{"7410":{"id":7410,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"صحابي","citation":"تقريب التهذيب (1/ 1174)","pageId":526487,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"له صحبة","citation":"تهذيب الكمال (34/ 53)","pageId":459393,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"له صحبة","citation":"تهذيب الكمال (34/ 53)","pageId":459393}]}],"flags":[]},"7438":{"id":7438,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"وروى ابن منده من طريق مغيرة، عن الشعبي، عن زياد بن عياض قال: كل شيء رأيت النبي - صلى الله عليه وسلم - يفعله رأيتكم تفعلونه، غير أنكم لا تقلسون في العيد. وهذا وهم فيه شريك على مغيرة، وإنما المحفوظ في هذا عن الشعبي، عن عياض الأشعري. وقد روي عن شريك على الصواب، أخرجه البغوي، وغيره في ترجمة عياض من طريق شريك","citation":"الإصابة في تمييز الصحابة (4/ 143)","pageId":420721,"verdict":"unclassified"},{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (4/ 143)","pageId":420721,"verdict":"unclassified"}]},{"critic":"محمد بن سعد","statements":[{"text":"وذكره ابن سعد في الطبقة الأولى من التابعين","citation":"الإصابة في تمييز الصحابة (4/ 143)","pageId":420721,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (4/ 143)","pageId":420721}]}],"flags":[]}}