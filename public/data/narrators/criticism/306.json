{"15301":{"id":15301,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال أبو حاتم: ليس بمشهور","citation":"لسان الميزان (4/ 211)","pageId":550275,"verdict":"unclassified"},{"text":"سمع أبا أمامة الباهلي، روى عنه: سليمان بن موسى، ورجاء بن أبي سلمة، سمعت أبي يقول ذلك، وسمعته يقول: روى حديثا واحدا لا أعلم بحديثه بأسا، وأدخله بعض الناس في كتاب الضعفاء يحول منه","citation":"الجرح والتعديل لابن أبي حاتم (7/ 19)","pageId":708149,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع أبا أمامة الباهلي، روى عنه: سليمان بن موسى، ورجاء بن أبي سلمة، سمعت أبي يقول ذلك، وسمعته يقول: روى حديثا واحدا لا أعلم بحديثه بأسا، وأدخله بعض الناس في كتاب الضعفاء يحول منه","citation":"الجرح والتعديل لابن أبي حاتم (7/ 19)","pageId":708149}]}],"flags":[]},"15302":{"id":15302,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة، روى عنه الوليد بن عبد الرحمن الجرشي، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (3/ 72)","pageId":688787,"verdict":"unclassified"}]},{"critic":"ابن السكن","statements":[{"text":"ورواه ابن السكن، من طريق سليم بن عامر، عن الحارث بن الحارث الغامدي، وقد أدرك النبي - صلى الله عليه وسلم - وروى عنه أحاديث","citation":"الإصابة في تمييز الصحابة (2/ 340)","pageId":417261,"verdict":"jarh"}]},{"critic":"محمد بن عوف بن سفيان","statements":[{"text":"وذكر أبو القاسم بن عيسى في \"طبقات الحمصيين\" عن محمد بن عوف أنه قال: ما أخلقه أن يكون من أهل حمص، ثم ذكر أنه روى عنه سليم بن عامر، وخالد بن معدان، وشريح بن عبيد، وأنه كانت له قطيعة بمر عين، وأنه شهد وقعة راهط","citation":"الإصابة في تمييز الصحابة (2/ 340)","pageId":417261,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15303":{"id":15303,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة، روى عنه عبد الله بن رافع مولى أم سلمة، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 58)","pageId":708658,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 77)","pageId":583244,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15305":{"id":15305,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة سكن مصر، روى عنه: ابنه، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 92)","pageId":709099,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"صحابي","citation":"تقريب التهذيب (1/ 1284)","pageId":528892,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"له صحبة، قاله البخاري","citation":"الإصابة في تمييز الصحابة (8/ 531)","pageId":429034,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15306":{"id":15306,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي المقاطيع","citation":"الثقات (9/ 168)","pageId":614464,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"يروي المقاطيع","citation":"الثقات (9/ 168)","pageId":614464}]}],"flags":["Sends Mursal Reports"]},"15307":{"id":15307,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"محمد بن سعد","statements":[{"text":"ذكره ابن سعد فيمن نزل البصرة من الصحابة","citation":"الإصابة في تمييز الصحابة (10/ 340)","pageId":431759,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15309":{"id":15309,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: كذا وقع في المسند عن أبي سعيد مولى بني هاشم، عن مطر بن عبد الرحمن عن هند، ورواه أبو داود، عن موسى بن إسماعيل، عن مطر، عن هند بنت أبي الوازع الزارع بن عامر وهو أصح، وقال ابن عساكر: صحابي هذا الحديث هو الزارع بالزاي","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 338)","pageId":581238,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15310":{"id":15310,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن السكن","statements":[{"text":"ذكره ابن السكن، وقال: لم يثبت حديثه","citation":"الإصابة في تمييز الصحابة (11/ 345)","pageId":433742,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"15313":{"id":15313,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"من المهاجرات","citation":"الثقات (3/ 116)","pageId":583521,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وجبارة ضعيف، وتابعه معاوية بن حفص، عن ابن المبارك، لكن قال: عن عبيد الله، عن أم خالد بنت الأسود، أخرجه ابن أبي عاصم، فإن كان محفوظا فلعلها كانت كنيتها، وخالدة اسمها","citation":"الإصابة في تمييز الصحابة (13/ 309)","pageId":437827,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15319":{"id":15319,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الطبراني","statements":[{"text":"زاد الطبراني: وكانت أم مغيث جدة ربيعة بن أبي عبد الرحمن، وقد صلت القبلتين على عهد رسول الله - صلى الله عليه وسلم -","citation":"الإصابة في تمييز الصحابة (14/ 531)","pageId":440401,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15325":{"id":15325,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان: له صحبة","citation":"الإصابة في تمييز الصحابة (7/ 101)","pageId":425866,"verdict":"unclassified"}]},{"critic":"ابن عبد البر","statements":[{"text":"وقال أبو عمر: أسلم، وهاجر، ولا أعرف له رواية","citation":"الإصابة في تمييز الصحابة (7/ 101)","pageId":425866,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وقال الذهبي: لا صحبة له، ولا إسلام، بل الصحبة لولده عبد الرحمن. قلت: وهو رد بغير دليل","citation":"الإصابة في تمييز الصحابة (7/ 101)","pageId":425866,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15327":{"id":15327,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن عبد البر","statements":[{"text":"ذكرهما الصغاني ممن في صحبته نظر، وأثبت ابن عبد البر صحبة حبيب بن خماشة","citation":"تحفة التحصيل في المراسيل (1/ 73)","pageId":679973,"verdict":"tadil"}]},{"critic":"الحسن بن محمد الصغاني","statements":[{"text":"ذكرهما الصغاني ممن في صحبته نظر، وأثبت ابن عبد البر صحبة حبيب بن خماشة","citation":"تحفة التحصيل في المراسيل (1/ 73)","pageId":679973,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"15329":{"id":15329,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"كان صاحب كتاب رسول الله صلى الله عليه وسلم إلى عامر بن الطفيل، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (3/ 281)","pageId":690849,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15331":{"id":15331,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 109)","pageId":583468,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"شهد بدرا","citation":"الإصابة في تمييز الصحابة (3/ 189)","pageId":419003,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15332":{"id":15332,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 113)","pageId":583494,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15335":{"id":15335,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال بعض الناس: إنه من المهاجرين الأولين، ولم يصح الرواية عنه، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (3/ 472)","pageId":692728,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وإسناده إلى سعيد بن المسيب ضعيف","citation":"الإصابة في تمييز الصحابة (3/ 495)","pageId":419843,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15340":{"id":15340,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"ذكره أبو حاتم في الصحابة","citation":"الإصابة في تمييز الصحابة (4/ 316)","pageId":421227,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15345":{"id":15345,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"عبد الغني بن سعيد الأزدي","statements":[{"text":"قال عبد الغني بن سعيد: له صحبة، وقال: له وفادة","citation":"الإصابة في تمييز الصحابة (4/ 553)","pageId":422022,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"وأغرب ابن عبد البر فقال: روى حديثه هشيم، عن يحيى بن سعيد بن عمرو بن سعيد بن العاص، عن أبيه، عن جده، عن سيابة. انتهى. ولم أره عن هشيم هكذا، وإنما اختلف عليه ؛ فقال عنه سعيد بن منصور كما تقدم، وتابعه إسحاق بن إدريس، وقال أبو حاتم: حدثنا بعض أصحاب هشيم عنه هكذا، وحدثنا عنه محمد بن الصباح فقال: عن يحيى بن سعيد، عن عمرو بن سعيد، عن سيابة. قال أبو حاتم: الأول أشبه. قلت: إسحاق ضعيف، وقد تابع محمد بن الصباح عمرو بن عون. أخرجه الطبراني","citation":"الإصابة في تمييز الصحابة (4/ 553)","pageId":422022,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15349":{"id":15349,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن السكن","statements":[{"text":"قال ابن السكن: يقال: له صحبة.. حديثه في البصريين","citation":"الإصابة في تمييز الصحابة (5/ 274)","pageId":423042,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}