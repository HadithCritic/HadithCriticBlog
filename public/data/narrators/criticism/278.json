{"13902":{"id":13902,"criticCount":1,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"شيخ العدالة بنيسابور","citation":"تاريخ الإسلام (7/ 317)","pageId":640219,"verdict":"unclassified"},{"text":"سمع محمد بن رافع، وإسحاق بن منصور، وعبد الله بن هاشم، وعيسى بن أحمد العسقلاني، وبحر بن نصر الخولاني، لقيه بمكة، وأحمد بن منصور الرمادي، وأبا زرعة الرازي، وابن وارة، وخلقا سواهم. سمع منه: شيخه أحمد بن المبارك المستملي، ودعلج السجزي، وأبو علي النيسابوري، وأبو بكر الإسماعيلي، وأبو الحسين أحمد بن محمد الخفاف، ومحمد بن أحمد بن عبدوس، وآخرون. وكان صدرا معظما، وعالما محتشما","citation":"سير أعلام النبلاء (14/ 492)","pageId":727451,"verdict":"jarh"},{"text":"الإمام المحدث العدل الرئيس","citation":"سير أعلام النبلاء (14/ 492)","pageId":727451,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13903":{"id":13903,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"ولا أعلم فيه جرحا","citation":"تاريخ الإسلام (7/ 279)","pageId":639939,"verdict":"unclassified"},{"text":"المحدث الإمام","citation":"سير أعلام النبلاء (14/ 426)","pageId":727364,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13904":{"id":13904,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":1,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"هذا حديث منكر، ورجال إسناده كلهم معروفون بالثقة إلا إبراهيم بن عيسى القنطري، فإنه مجهول","citation":"تاريخ بغداد (6/ 146)","pageId":821907,"verdict":"mixed"}]}],"phenomena":[],"flags":[]},"13907":{"id":13907,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"ثقة","citation":"تاريخ الإسلام (7/ 318)","pageId":640225,"verdict":"tadil"},{"text":"سمع: علي بن عبد المؤمن الزعفراني، وسليمان بن داود القزاز","citation":"تاريخ الإسلام (7/ 318)","pageId":640225,"verdict":"u