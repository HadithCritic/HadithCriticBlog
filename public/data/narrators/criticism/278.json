ageId":544423,"verdict":"unclassified"}]},{"critic":"محمد بن أحمد بن حماد الكوفي","statements":[{"text":"وقال أبو الحسن بن حماد الحافظ الكوفي: مات سنة ثمان عشرة وثلاثمائة. قال: وكان أكثر مقامه بالرقة، وكان لا يحسن يقرأ ولا يكتب، وكان ابن سعيد - يعني أبا العباس بن عقدة - يخرج له أسماء من عنده على أنه في كتاب أبيه، فيلقنه إياه ويقرأ عليه. وقلت لابن سعيد: أشتهي أن أرى شيئا من سماعه، فكان يريني الشيء بعسر","citation":"لسان الميزان (2/ 77)","pageId":544423,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13919":{"id":13919,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وله صحبة","citation":"الثقات (4/ 15)","pageId":586072,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13939":{"id":13939,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: هو شيخ","citation":"الجرح والتعديل لابن أبي حاتم (4/ 386)","pageId":697849,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"مستقيم الحديث","citation":"الثقات (8/ 315)","pageId":610101,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"13943":{"id":13943,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"أدركته، ولم أكتب عنه، وكان صدوقا","citation":"الجرح والتعديل لابن أبي حاتم (3/ 39)","pageId":688437,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}