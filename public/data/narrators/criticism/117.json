{"5861":{"id":5861,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"وقيل: الصواب: عن محمد بن علي","citation":"تقريب التهذيب (1/ 884)","pageId":520896,"verdict":"unclassified"},{"text":"مجهول","citation":"تقريب التهذيب (1/ 884)","pageId":520896,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"قاله الترمذي عن صالح بن عبد الله الترمذي، عن فرج بن فضالة، عن يحيى. وقال أبو توبة الربيع بن نافع، وأبو مسلم الواقدي، ومحمد ابن الفرج بن فضالة، عن الفرج بن فضالة، عن يحيى بن سعيد، عن محمد بن علي، عن علي، وهو الأشبه بالصواب، والله أعلم","citation":"تهذيب الكمال (26/ 218)","pageId":454082,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5862":{"id":5862,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 884)","pageId":520898,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5866":{"id":5866,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 887)","pageId":520946,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"صدوق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 182)","pageId":500429,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"5871":{"id":5871,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (26/ 268)","pageId":454134,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 672)","pageId":479083,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 887)","pageId":520957,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}