{"5850":{"id":5850,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو زرعة الرازي","statements":[{"text":"روى عنه أبو زرعة وقال: كان شيخا صالحا قدم علينا حاجا","citation":"الجرح والتعديل لابن أبي حاتم (8/ 34)","pageId":712090,"verdict":"unclassified"},{"text":"وأبو زرعة الرازي، وقال: كان شيخا صالحا، قدم علينا حاجا","citation":"تهذيب الكمال (26/ 223)","pageId":454092,"verdict":"unclassified"},{"text":"قال أبو زرعة: كان شيخا صالحا قدم حاجا","citation":"تهذيب التهذيب (3/ 664)","pageId":479036,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 884)","pageId":520906,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"5851":{"id":5851,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 884)","pageId":520900,"verdict":"unclassified"}]},{"critic":"ابن عبد الهادي الحنبلي","statements":[{"text":"وقرأت بخط ابن عبد الهادي أنه أبو سهل الذي أفرده المزي بعده، واستدل لذلك بأن الحديث الذي أخرجه (د) له في الأذان وقع في \" مسند أحمد \" من الطريق المذكورة، فوقع مكنى أبا سهل","citation":"تهذيب التهذيب (3/ 663)","pageId":479032,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"قرأت بخط الذهبي حكمه العدالة يعني: لرواية ابن مهدي عنه","citation":"تهذيب التهذيب (3/ 663)","pageId":479032,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5861":{"id":5861,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"وقيل: الصواب: عن محمد بن علي","citation":"تقريب التهذيب (1/ 884)","pageId":520896,"verdict":"unclassified"},{"text":"مجهول","citation":"تقريب التهذيب (1/ 884)","pageId":520896,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"قاله الترمذي عن صالح بن عبد الله الترمذي، عن فرج بن فضالة، عن يحيى. وقال أبو توبة الربيع بن نا