{"21453":{"id":21453,"criticCount":3,"statementCount":4,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"شيخ","citation":"لسان الميزان (7/ 366)","pageId":557952,"verdict":"unclassified"},{"text":"قلت: بل ليس بثقة، فإن تماما. روى عنه قال: حدثنا إبراهيم بن هاشم البغوي، حدثنا هدبة، حدثنا أبو عوانة عن الأعمش، عن أبي صالح، عن أبي هريرة رضي الله عنه مرفوعا: \" أكذب الناس الصواغون والصباغون \". وهذا موضوع والحمل فيه على الشرابي وللمتن إسناد آخر ضعيف.. مات بعد الخمسين وثلاثمائة","citation":"لسان الميزان (7/ 366)","pageId":557952,"verdict":"jarh"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"قال الخطيب: أحاديثه مستقيمة","citation":"لسان الميزان (7/ 366)","pageId":557952,"verdict":"unclassified"}]},{"critic":"يوسف بن عمر القواس","statements":[{"text":"وقال أبو الفتح بن مسرور: فيه بعض اللين","citation":"لسان الميزان (7/ 366)","pageId":557952,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21461":{"id":21461,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"شيخ","citation":"الثقات (5/ 475)","pageId":594400,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"رأى ابن عمر، وروى عن علقمة بن عبد الله، روى عنه، وكيع سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 474)","pageId":716417,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"رأى ابن عمر، وروى عن علقمة بن عبد الله، روى عنه، وكيع سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 474)","pageId":716417}]}],"flags":[]},"21466":{"id":21466,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا يعرف","citation":"لسان الميزان (9/ 185)","pageId":564128,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21468":{"id":21468,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"الحاكم","statements":[{"text":"وقال الحاكم: كان حسن الحديث","citation":"تاريخ الإسلام (8/ 163)","pageId":644537,"verdict":"unclassified"},{"text":"قال الحاكم: كان حسن الحديث","citation":"سير أعلام النبلاء (16/ 273)","pageId":728655,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"مفتي هراة وعالمها ونحويها","citation":"تاريخ الإسلام (8/ 80)","pageId":644097,"verdict":"unclassified"},{"text":"الفقيه أبو حامد الهروي الشافعي، مفتي هراة وأديبها وعالمها ومفسرها ومحدثها في زمانه","citation":"تاريخ الإسلام (8/ 163)","pageId":644537,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21469":{"id":21469,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"مسلمة بن القاسم","statements":[{"text":"وكان ضعيفا في الحديث، متشيعا. قاله مسلمة بن قاسم، وقال: كتبت عنه","citation":"لسان الميزان (7/ 231)","pageId":557467,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21472":{"id":21472,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"حدثنا إسماعيل بن أبان عن عمرو بن حريث، وكان ثقة","citation":"لسان الميزان (6/ 198)","pageId":554818,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21476":{"id":21476,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"عن أخيه، عن ليث بن أبي سليم. لا يعرف","citation":"لسان الميزان (4/ 50)","pageId":549588,"verdict":"unclassified"}]},{"critic":"ابن حزم","statements":[{"text":"وذكره النباتي، ونقل عن ابن حزم أنه قال: لا يدرى من هو، ولا من أخوه","citation":"لسان الميزان (4/ 50)","pageId":549588,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21481":{"id":21481,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مضى في ترجمة عبد الله [4465] أن فيهم جهالة","citation":"لسان الميزان (8/ 75)","pageId":559179,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21482":{"id":21482,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"هو منقطع بين حفص، وخولة","citation":"المطالب العالية (5/ 694)","pageId":207874,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21483":{"id":21483,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"قال الخطيب: ثقة","citation":"تاريخ الإسلام (5/ 857)","pageId":630599,"verdict":"tadil"},{"text":"وكان ثقة","citation":"تاريخ بغداد (11/ 268)","pageId":827135,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21484":{"id":21484,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي المراسيل","citation":"الثقات (6/ 344)","pageId":598896,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"يروي المراسيل","citation":"الثقات (6/ 344)","pageId":598896}]}],"flags":["Sends Mursal Reports"]},"21485":{"id":21485,"criticCount":3,"statementCount":5,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \" فقال: يروي عن عمرو بن عثمان","citation":"لسان الميزان (6/ 64)","pageId":554327,"verdict":"tadil"}]},{"critic":"ابن عدي","statements":[{"text":"ثناه أبو يعلى أيضا، عن أبي معشر، عن عمر بن أبان بن عثمان، عن أبيه، عن ابن عمر، عن النبي صلى الله عليه وسلم بغير شيء، وكلها غير محفوظة في فضيلة عثمان، وقصة جيش العسرة","citation":"الكامل في الضعفاء (6/ 115)","pageId":576850,"verdict":"unclassified"},{"text":"وقال ابن عدي: حدثنا أبو يعلى، حدثنا المقدمي، حدثنا أبو معشر البراء، عن إبراهيم بن عمر بن أبان بن عثمان، عن أبيه، عن عثمان بأحاديث كلها غير محفوظة، منها: \" أن النبي صلى الله عليه وسلم أسر إليه أنه يقتل مظلوما \"","citation":"لسان الميزان (6/ 64)","pageId":554327,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"قال البخاري: فيه نظر","citation":"لسان الميزان (6/ 64)","pageId":554327,"verdict":"jarh"},{"text":"سمع عثمان. قاله إبراهيم بن عمر بن أبان، عن أبيه، في إسناده شيء، سمعت ابن حماد يذكره عن البخاري","citation":"الكامل في الضعفاء (6/ 115)","pageId":576850,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع عثمان. قاله إبراهيم بن عمر بن أبان، عن أبيه، في إسناده شيء، سمعت ابن حماد يذكره عن البخاري","citation":"الكامل في الضعفاء (6/ 115)","pageId":576850}]}],"flags":[]},"21486":{"id":21486,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"أحمد بن محمد العتيقي","statements":[{"text":"أحمد بن محمد العتيقي قال: سنة سبع وثمانين وثلاثمائة، فيها توفي أبو الطيب محمد بن الحسين بن النخاس بالكوفة في شهر ربيع الآخر، ثقة مأمون صاحب أصول حسان","citation":"تاريخ بغداد (3/ 38)","pageId":817769,"verdict":"tadil"}]},{"critic":"ابن السوادي أبو القاسم الأزهري","statements":[{"text":"قال لي أبو القاسم الأزهري: قدم علينا أبو الطيب محمد بن الحسين التيملي الكوفي بغداد في سنة ست وسبعين وثلاثمائة، فكتب الناس عنه، ثم رجع إلى الكوفة. قال: وكان ثقة يتشيع","citation":"تاريخ بغداد (3/ 38)","pageId":817769,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وكان ثقة","citation":"تاريخ الإسلام (8/ 624)","pageId":647192,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21487":{"id":21487,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وليس هذا بعمرو بن حريث المخزومي، ذلك له صحبة","citation":"الثقات (7/ 218)","pageId":602349,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21488":{"id":21488,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع أبا هريرة قوله. روى عنه يعلى بن عطاء. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (5/ 216)","pageId":701054,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع أبا هريرة قوله. روى عنه يعلى بن عطاء. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (5/ 216)","pageId":701054}]}],"flags":[]},"21489":{"id":21489,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ربما أخطأ وأغرب","citation":"الثقات (9/ 136)","pageId":614074,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21499":{"id":21499,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع أباه، روى عنه ابنه يعقوب سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 109)","pageId":712769,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع أباه، روى عنه ابنه يعقوب سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 109)","pageId":712769}]}],"flags":[]}}