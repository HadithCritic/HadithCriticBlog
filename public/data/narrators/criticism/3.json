{"153":{"id":153,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1270)","pageId":528560,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف، روى عنه أبو بكر بن عياش، وبنو وهب عبد الله وعبد الرحمن وأيوب ؛ ليسوا بالمشهورين","citation":"لسان الميزان (9/ 236)","pageId":565650,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"ذكر يحيى بن معين، وغيره أن لوهب بن منبه ابنين: أحدهما عبد الله وهو الأكبر، والآخر عبد الرحمن وهو الأصغر. أما عبد الله فقد تقدم في الأسماء. وأما عبد الرحمن فيروي عنه هشام ابن يوسف الصنعاني. وذكر بعضهم أن له ابنا آخر اسمه أيوب وأنه يروي عنه يوسف بن زكريا الصنعاني، فالله أعلم","citation":"تهذيب الكمال (34/ 482)","pageId":461372,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"154":{"id":154,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"صحابية","citation":"تقريب التهذيب (1/ 1387)","pageId":531049,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"156":{"id":156,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا تعرف","citation":"تقريب التهذيب (1/ 1387)","pageId":531062,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"159":{"id":159,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1106)","pageId":524992,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"نكرة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 7)","pageId":503316,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"167":{"id":167,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن ح