1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (3/ 7)","pageId":817687,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19422":{"id":19422,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"قال الخطيب أبو بكر: عامة أحاديثه مستقيمة","citation":"تاريخ الإسلام (6/ 989)","pageId":637778,"verdict":"unclassified"},{"text":"أحاديث مستقيمة","citation":"تاريخ بغداد (13/ 61)","pageId":828652,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19423":{"id":19423,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي عن: أبي حبيب العنقزي عن بهز بن حكيم، حدثنا عنه أبو يعلى بالموصل، وأبو حبيب هذا لا أدري من هو لأن قرة بن حبيب لم ير بهز بن حكيم وقرة بن حبيب، كنيته: أبو علي لا أبو حبيب","citation":"الثقات (8/ 361)","pageId":610582,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19425":{"id":19425,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (2/ 575)","pageId":817538,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وكان موثقا","citation":"تاريخ الإسلام (6/ 605)","pageId":635631,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19427":{"id":19427,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"خبرا منكرا","citation":"لسان الميزان (1/ 654)","pageId":543844,"verdict":"unclassified"},{"text":"لا أعرفه","citation":"لسان الميزان (1/ 654)","pageId":543844,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19430":{"id":19430,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"العقيلي","statements":[{"text":"قال العقيلي: الغالب على حديثه الوهم، ثم ساق من حديث إبراهيم بن المستمر العروقي، عنه، عن البراء بن يزيد، عن قتادة، عن أنس رضي الله عنه مرفوعا: \" يوشك أن يملأ الله أيديكم من العجم ثم يجعلهم أسدا لا يفرون، يقتلون مقاتلتكم، ويأكلون فيئكم \". وإنما جاء هذا لحماد بن سلمة، عن يونس، عن الحسن، عن سمرة، عن النبي صلى الله عليه وسلم انتهى. وروى العقيلي أيضا من رواية إبراهيم بن المستمر، عنه، عن البراء بن يزيد، أخبرنا الحسن، حدثنا أبو العالية، عن ابن عباس: \" شهد عندي رجال مرضيون \"... الحديث قال: وهذا ليس بمعروف من حديث الحسن، وإنما رواه قتادة، عن أبي العالية","citation":"لسان الميزان (3/ 347)","pageId":548409,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19440":{"id":19440,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"لا يعرف، يقع حديثه عاليا في نسخة أبي الجهم متنه \" ابدأ بمن تعول \"","citation":"لسان الميزان (9/ 96)","pageId":562638,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19447":{"id":19447,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه: حبيب بن عبيد. سمعت أبي يقول ذلك، وسألته عنه فقال: لا يدرى من هو","citation":"الجرح والتعديل لابن أبي حاتم (9/ 347)","pageId":720137,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}