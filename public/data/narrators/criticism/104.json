jarh"}]},{"critic":"الذهبى","statements":[{"text":"قال الذهبي: ما روى عنه إلا ابنه","citation":"تهذيب التهذيب (3/ 455)","pageId":477617,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5232":{"id":5232,"criticCount":5,"statementCount":6,"tally":{"jarh":2,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 454)","pageId":477609,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (24/ 89)","pageId":452794,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"ثقة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 56)","pageId":499428,"verdict":"tadil"}]},{"critic":"العقيلي","statements":[{"text":"وذكره العقيلي في \" الضعفاء \" وأورد له حديثين، وقال: لا يتابع عليهما. أحدهما الذي أخرجه ابن ماجه في التعزية بالميت","citation":"تهذيب التهذيب (3/ 454)","pageId":477609,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"فيه لين","citation":"تقريب التهذيب (1/ 806)","pageId":519513,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"سمعت ابن حماد يقول: قال البخاري: قيس أبو عمارة الفارسي مولى سودة بنت سعد عن عبد الله بن أبي بكر بن حزم فيه نظر، وهذا الذي أشار إليه البخاري وإنما هو حديث واحد، وليس الذي يبين من الضعف في الرجل وصدقه إذا كان له حديث واحد","citation":"الكامل في الضعفاء (7/ 171)","pageId":577617,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"5238":{"id":5238,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 803)","pageId":519433,"verdict":"unclassified"},{"text":"قلت: ثابت بن قيس أبوه قتل يوم اليمامة بعد النبي صلى الله عليه وآله وسلم بقليل، فإما أن تكون رواية قيس عنه منقطعة، وإلا لزم أن يكون لقيس إدراك. وقد تقدم في إسماعيل بن محمد بن ثابت أن الدمياطي جزم بأنه والد عبد الخبير، فالله أعلم","citation":"تهذيب التهذيب (3/ 444)","pageId":477534,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5245":{"id":5245,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 804)","pageId":519455,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"وعنه: سليمان بن بشير. قلت: قال الذهبي: ما روى عنه غيره","citation":"تهذيب التهذيب (3/ 448)","pageId":477558,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}