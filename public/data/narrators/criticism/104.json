{"5238":{"id":5238,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 803)","pageId":519433,"verdict":"unclassified"},{"text":"قلت: ثابت بن قيس أبوه قتل يوم اليمامة بعد النبي صلى الله عليه وآله وسلم بقليل، فإما أن تكون رواية قيس عنه منقطعة، وإلا لزم أن يكون لقيس إدراك. وقد تقدم في إسماعيل بن محمد بن ثابت أن الدمياطي جزم بأنه والد عبد الخبير، فالله أعلم","citation":"تهذيب التهذيب (3/ 444)","pageId":477534,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5245":{"id":5245,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 804)","pageId":519455,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"وعنه: سليمان بن بشير. قلت: قال الذهبي: ما روى عنه غيره","citation":"تهذيب التهذيب (3/ 448)","pageId":477558,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}