ied":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عنه فقال: هو شيخ تشبه أحاديثه عن زهير بن محمد] أحاديث إبراهيم بن أبي يحيى، ودليلنا أن أحاديثه من أحاديث (23 م 6) إبراهيم بن أبي يحيى حديثا (؟) رواه معاذ بن خالد عن زهير بن محمد قال: حدثني شرحبيل بن سعد أنه سمع جبار بن صخر يقول: سمعت رسول الله صلى الله عليه وسلم يقول: نهينا أن ترى عوراتنا. وقد حدثنى بهذا الحديث بعينه معاذ بن حسان نزيل برذعة قال: حدثنا إبراهيم بن محمد بن أبي يحيى عن شرحبيل بن سعد","citation":"الجرح والتعديل لابن أبي حاتم (8/ 250)","pageId":714215,"verdict":"jarh"},{"text":"قال عبد الرحمن بن أبي حاتم: سألت أبي عنه، فقال: شيخ تشبه أحاديثه عن زهير بن محمد أحاديث إبراهيم بن أبي يحيى","citation":"تهذيب الكمال (28/ 120)","pageId":455256,"verdict":"unclassified"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"قال ابن أبي حاتم: شيخ تشبه أحاديثه عن زهير بن محمد أحاديث إبراهيم بن أبي يحيى","citation":"تهذيب التهذيب (4/ 98)","pageId":480353,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"لين الحديث","citation":"تقريب التهذيب (1/ 951)","pageId":522155,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"له مناكير","citation":"لسان الميزان (9/ 425)","pageId":571604,"verdict":"jarh"},{"text":"قرأت بخط الذهبي: له مناكير","citation":"تهذيب التهذيب (4/ 98)","pageId":480353,"verdict":"jarh"}]},{"critic":"ابن يونس المصري","statements":[{"text":"وقال أبو سعيد بن يونس: قدم مصر وكتب عنه","citation":"تهذيب الكمال (28/ 120)","pageId":455256,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10991":{"id":10991,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 951)","pageId":522167,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"10993":{"id":10993,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب الثقات","