{"15850":{"id":15850,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"عطاء الشيبي العبدري. روى عنه ابنه إبراهيم، وفطر بن خليفة، له حديث: قابلوا النعال ؛ كذا ذكره الذهبي. ودعواه أن فطر بن خليفة روى عن هذا غلط، وقوله في هذا: إنه شيبي عبدري غلط أيضا ؛ بل هو ثقفي طائفي. واختلف في حديثه: قابلوا النعال هل هو صحابيه أو إبراهيم كما تقدم مستوفى في ترجمة إبراهيم. وأما الشيبي العبدري فهو الذي روى عنه فطر بن خليفة، وحديثه: رأيت النبي - صلى الله عليه وسلم - يصلي في نعليه","citation":"الإصابة في تمييز الصحابة (8/ 406)","pageId":428628,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15851":{"id":15851,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"وقال أبو حاتم: ليس بالقوي","citation":"لسان الميزان (3/ 214)","pageId":547769,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (3/ 214)","pageId":547769,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15853":{"id":15853,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 315)","pageId":584834,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وقال المفضل العلائي في تاريخه: حدثني رجل من بني عامر قال: صحب النبي - صلى الله عليه وسلم - من بني كلاب قدامة وعلقمة بن علاثة، وسمى جماعة","citation":"الإصابة في تمييز الصحابة (7/ 258)","pageId":426339,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15857":{"id":15857,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن السكن","statements":[{"text":"ذكره ابن السكن وغيره في الصحابة","citation":"الإصابة في تمييز الصحابة (7/ 555)","pageId":427207,"verdict":"unclassified"},{"text":"قال ابن السكن: لا يصح. (قلت) : لأن في السند من لا يعرف","citation":"الإصابة في تمييز الصحابة (7/ 555)","pageId":427207,"verdict":"unclassified"}]},{"critic":"الزبير بن بكار","statements":[{"text":"وقد ذكر الزبير بن بكار عوف بن القعقاع هذا في الموفقيات، وذكر عنه كلاما حسنا، وهو قوله: والله لئن لم يغفر الله لنا بإحسانه أو لنهلكن، فإنا لا نلقى الله بعمل","citation":"الإصابة في تمييز الصحابة (7/ 555)","pageId":427207,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15858":{"id":15858,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن عبد البر","statements":[{"text":"قال أبو عمر: أجمعوا أن رسول الله - صلى الله عليه وسلم - تزوجها، واختلفوا في قصة فراقها إلى أن قال: قال قتادة: هي أسماء بنت النعمان من بني الجون، لما أدخلت عليه دعاها، فقالت: تعال أنت، وأبت أن تجيء، قال قتادة: وقيل: إنها قالت له: أعوذ بالله منك، فقال: قد عذت بمعاذ. وهذا باطل، إنما قال هذا لامرأة أخرى من بني سليم","citation":"الإصابة في تمييز الصحابة (13/ 141)","pageId":437255,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15860":{"id":15860,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو القاسم البغوي","statements":[{"text":"ذكره البغوي، ولم يخرج له شيئا","citation":"الإصابة في تمييز الصحابة (12/ 236)","pageId":435309,"verdict":"unclassified"}]},{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"وقال ابن منده: له ذكر في الصحابة، ولا يثبت","citation":"الإصابة في تمييز الصحابة (12/ 236)","pageId":435309,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"15861":{"id":15861,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن عبد البر","statements":[{"text":"ذكره ابن عبد البر أيضا، وقال: روى عنه مختار بن عقبة وفيه نظر","citation":"تحفة التحصيل في المراسيل (1/ 614)","pageId":682278,"verdict":"jarh"}]},{"critic":"أبو زرعة العراقي","statements":[{"text":"أي في صحبته","citation":"تحفة التحصيل في المراسيل (1/ 614)","pageId":682278,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15870":{"id":15870,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"له صحبة، عداده في الشاميين، روى عنه الوليد بن عبد الرحمن الجرشي، كذا أخرجه ابن منده وأبو نعيم مختصرا","citation":"الإصابة في تمييز الصحابة (10/ 90)","pageId":430941,"verdict":"unclassified"}]},{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"له صحبة، عداده في الشاميين، روى عنه الوليد بن عبد الرحمن الجرشي، كذا أخرجه ابن منده وأبو نعيم مختصرا","citation":"الإصابة في تمييز الصحابة (10/ 90)","pageId":430941,"verdict":"unclassified"}]},{"critic":"محمد بن المسيب الإسفنجي","statements":[{"text":"وقال أبو موسى: ذكره محمد بن المسيب الأرغياني في الصحابة","citation":"الإصابة في تمييز الصحابة (10/ 90)","pageId":430941,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15873":{"id":15873,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو موسى المديني","statements":[{"text":"ذكرها أبو نعيم وأبو موسى من طريقه","citation":"الإصابة في تمييز الصحابة (14/ 64)","pageId":438814,"verdict":"unclassified"}]},{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"ذكرها أبو نعيم وأبو موسى من طريقه","citation":"الإصابة في تمييز الصحابة (14/ 64)","pageId":438814,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15874":{"id":15874,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو موسى المديني","statements":[{"text":"ذكره أبو موسى في الذيل","citation":"الإصابة في تمييز الصحابة (9/ 372)","pageId":430273,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15876":{"id":15876,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو زرعة الرازي","statements":[{"text":"حدثنا عبد الرحمن قال: سمعت أبا زرعة يقول: أبو عبيد هذا ليست له صحبة، وأبو معقل لا يسمى","citation":"الجرح والتعديل لابن أبي حاتم (9/ 405)","pageId":720938,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15877":{"id":15877,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وفد إلى النبي صلى الله عليه وسلم","citation":"الثقات (3/ 65)","pageId":583160,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15879":{"id":15879,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (4/ 128)","pageId":420671,"verdict":"unclassified"},{"text":"قلت: كانت بيعة مروان سنة أربع وستين من الهجرة، والذي يوصف بأنه شيخ كبير يكون من أبناء السبعين إلى الثمانين، فيكون زرارة من أهل هذا القسم","citation":"الإصابة في تمييز الصحابة (4/ 128)","pageId":420671,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (4/ 128)","pageId":420671}]}],"flags":[]},"15881":{"id":15881,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"عيسى بن موسى","statements":[{"text":"قال الهيثم: فحدثت به عيسى بن موسى الهاشمي، فقال رجل في المجلس: لو كان هذا الحديث عن غير يزيد. فقال عيسى بن موسى: \" كان يزيد أشرف من أن يكذب في الحديث","citation":"المعجم الأوسط (2/ 104)","pageId":330543,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15883":{"id":15883,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"الطبراني","statements":[{"text":"ذكره الطبراني في الصحابة","citation":"الإصابة في تمييز الصحابة (12/ 185)","pageId":435175,"verdict":"unclassified"}]},{"critic":"العلائي","statements":[{"text":"وقال العلائي شيخ شيوخنا في كتاب الوشي: إن كان يزيد بن خصيفة هذا هو يزيد بن عبد الله بن خصيفة، الثقة، المشهور، الراوي عن السائب بن يزيد فلا أعرف لأبيه ذكرا في أسماء الرواة، ولا لجده خصيفة ذكرا في الصحابة، وإن كان غيره فلا أعرفه ولا أباه ولا جده","citation":"الإصابة في تمييز الصحابة (12/ 185)","pageId":435175,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"هو المشهور؛ فقد ذكر المزي في التهذيب يزيد بن عبد الملك في الرواة عنه، وعلي هذا فصحابي هذا الحديث هو خصيفة، وقد ذكر المزي في ترجمة يزيد بن عبد الله بن خصيفة أن اسم والد خصيفة يزيد، وقيل عبد الله بن يزيد بن سعيد بن ثمامة الكندي","citation":"الإصابة في تمييز الصحابة (12/ 185)","pageId":435175,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15888":{"id":15888,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن عبد البر","statements":[{"text":"وذكرها الرشاطي وقال: لم يذكرها أبو عمر، ولا ابن فتحون","citation":"الإصابة في تمييز الصحابة (14/ 416)","pageId":440026,"verdict":"unclassified"}]},{"critic":"عبد الله بن علي الرشاطي","statements":[{"text":"وذكرها الرشاطي وقال: لم يذكرها أبو عمر، ولا ابن فتحون","citation":"الإصابة في تمييز الصحابة (14/ 416)","pageId":440026,"verdict":"unclassified"}]},{"critic":"محمد بن خلف الأوريولي","statements":[{"text":"وذكرها الرشاطي وقال: لم يذكرها أبو عمر، ولا ابن فتحون","citation":"الإصابة في تمييز الصحابة (14/ 416)","pageId":440026,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15890":{"id":15890,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"حدثنا عبد الرحمن، أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي، قال: سألت أبي عن الحارث الغنوي، قال: روى عنه أبو عوانة. أرجو أن لا يكون به بأس","citation":"الجرح والتعديل لابن أبي حاتم (3/ 95)","pageId":689050,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15892":{"id":15892,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"أحمد بن أبى خيثمة البغدادي","statements":[{"text":"قال ابن أبي خيثمة: سمعت سعد بن عبد الحميد بن جعفر يقول: المنذر بن عمرو عقبي بدري نقيب، استشهد يوم بئر معونة، وكذا قال ابن إسحاق","citation":"الإصابة في تمييز الصحابة (10/ 328)","pageId":431721,"verdict":"unclassified"}]},{"critic":"محمد بن إسحاق","statements":[{"text":"قال ابن أبي خيثمة: سمعت سعد بن عبد الحميد بن جعفر يقول: المنذر بن عمرو عقبي بدري نقيب، استشهد يوم بئر معونة، وكذا قال ابن إسحاق","citation":"الإصابة في تمييز الصحابة (10/ 328)","pageId":431721,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وثبت أنه استشهد ببئر معونة في \"صحيح البخاري\"، وسمي المنذر بن الزبير بن العوام على اسمه، وكان يلقب المعنق ليموت","citation":"الإصابة في تمييز الصحابة (10/ 328)","pageId":431721,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"15893":{"id":15893,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"له صحبة","citation":"الجرح والتعديل لابن أبي حاتم (2/ 508)","pageId":687640,"verdict":"unclassified"}]},{"critic":"ابن السكن","statements":[{"text":"وقال ابن السكن، يقال: له صحبة، وليست له عن النبي صلى الله عليه وسلم رواية","citation":"الإصابة في تمييز الصحابة (2/ 163)","pageId":416606,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"قال البخاري: له صحبة، روى عنه ابن سيرين مرسلا، أراه الأول - يعني جبلة بن عمرو الأنصاري","citation":"الإصابة في تمييز الصحابة (2/ 163)","pageId":416606,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15894":{"id":15894,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو بكر ابن أبي عاصم النبيل","statements":[{"text":"ذكرها ابن أبي عاصم","citation":"الإصابة في تمييز الصحابة (13/ 327)","pageId":437873,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15896":{"id":15896,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"صلت القبلتين مع رسول الله صلى الله عليه وسلم","citation":"الثقات (3/ 146)","pageId":583739,"verdict":"unclassified"}]},{"critic":"عبد الرحمن بن أبي كريمة","statements":[{"text":"أخرج الطبراني وابن منده من طريق إسماعيل بن عبد الرحمن السدي، عن أبيه قال: كاتبتني زينب بنت قيس بن مخرمة بعشرة آلاف، فتركت لي ألفا، وكانت زينب قد صلت القبلتين مع رسول الله - صلى الله عليه وسلم -","citation":"الإصابة في تمييز الصحابة (13/ 436)","pageId":438185,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15899":{"id":15899,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"لها صحبة","citation":"الثقات (3/ 184)","pageId":583987,"verdict":"unclassified"}]},{"critic":"ابن عبد البر","statements":[{"text":"قال أبو عمر: تزوجها عبد الرحمن بن عوف، ويروى عن النبي - صلى الله عليه وسلم - أنه أسهم لها يوم خيبر","citation":"الإصابة في تمييز الصحابة (13/ 501)","pageId":438396,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}