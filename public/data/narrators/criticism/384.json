لي بن المديني قال: سألت جريرا عن عثمان بن يسار الذي روى عنه المغيرة، فقال: كان ضبيا إمام مسجد بني السيد وأثنى عليه خيرا","citation":"الجرح والتعديل لابن أبي حاتم (6/ 173)","pageId":705002,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19236":{"id":19236,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ربما أغرب","citation":"الثقات (9/ 182)","pageId":614628,"verdict":"unclassified"},{"text":"وذكره ابن حبان في \" الثقات \"، وقال: ربما أغرب","citation":"لسان الميزان (8/ 115)","pageId":559370,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19237":{"id":19237,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حزم","statements":[{"text":"وذكره النباتي، ونقل عن ابن حزم أنه قال: لا يدرى من هو، ولا من أخوه","citation":"لسان الميزان (4/ 50)","pageId":549588,"verdict":"unclassified"}]},{"critic":"ليث بن أبي سليم","statements":[{"text":"عن أخيه، عن ليث بن أبي سليم. لا يعرف","citation":"لسان الميزان (4/ 50)","pageId":549588,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19241":{"id":19241,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الأزدي","statements":[{"text":"قال الأزدي: لا يصح حديثه","citation":"لسان الميزان (5/ 262)","pageId":552874,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19242":{"id":19242,"criticCount":4,"statementCount":5,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن النبي صلى الله عليه وسلم، مرسل، في أبي رغال، روى عنه ابنه محمد بن مسلم الزهري سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 188)","pageId":713539,"verdict":"unclassified"},{"text":"وقال البخاري وأبو حاتم: حديثه مرسل. وكذا قال أبو أحمد العسكري","citation":"الإصابة في تمييز الصحابة (10/ 541)","pageId":432460,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"، روى عن النبي - صلى الله عليه وسلم - في قصة أبي رغال، فذكره بعضهم في الصحابة، وجزم غير واحد بأنه لا صحبة له ولا رؤية","citation":"الإصابة في تمييز الصحابة (10/ 541)","pageId":432460,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"وقال البخاري وأبو حاتم: حديثه مرسل. وكذا قال أبو أحمد العسكري","citation":"الإصابة في تمييز الصحابة (10/ 541)","pageId":432460,"verdict":"unclassified"}]},{"critic":"الحسن بن عبد الله العسكري","statements":[{"text":"وقال البخاري وأبو حاتم: حديثه مرسل. وكذا قال أبو أحمد العسكري","citation":"الإصابة في تمييز الصحابة (10/ 541)","pageId":432460,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19243":{"id":19243,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"العلائي","statements":[{"text":"قال العلائي في \" الوشي \": لا أعرف عميرا، ولا اليقظان","citation":"لسان الميزان (8/ 545)","pageId":561188,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19245":{"id":19245,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع ابن عمر، روى عنه عطاء بن أبي رباح، وحميد بن قيس المكي سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 253)","pageId":714247,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع ابن عمر، روى عنه عطاء بن أبي رباح، وحميد بن قيس المكي سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 253)","pageId":714247}]}],"flags":[]},"19246":{"id":19246,"criticCount":3,"statementCount":6,"tally":{"jarh":3,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"، وقال: يخطئ","citation":"لسان الميزان (6/ 264)","pageId":555133,"verdict":"tadil"},{"text":"يخطئ","citation":"الثقات (7/ 234)","pageId":602505,"verdict":"unclassified"}]},{"critic":"ابن عدي","