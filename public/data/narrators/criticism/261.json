,"critics":[{"critic":"أبو العباس السراج","statements":[{"text":"أنبأنا محمد بن أحمد بن رزق، قال: أخبرنا إبراهيم بن محمد بن يحيى المزكي، قال: أخبرنا محمد بن إسحاق السراج، قال: حدثنا أبو العباس الفضل بن إسحاق الدوري ثقة مأمون","citation":"تاريخ بغداد (14/ 325)","pageId":830423,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"13070":{"id":13070,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"العقيلي","statements":[{"text":"قال العقيلي: لا يتابع على حديثه","citation":"لسان الميزان (6/ 335)","pageId":555411,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13075":{"id":13075,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"سمع: أباه، والذهلي، وعلي بن حرب، وجماعة","citation":"تاريخ الإسلام (7/ 147)","pageId":639164,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع: أباه، والذهلي، وعلي بن حرب، وجماعة","citation":"تاريخ الإسلام (7/ 147)","pageId":639164}]}],"flags":[]},"13086":{"id":13086,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"علي بن الحسين بن الجنيد النخعي","statements":[{"text":"نا عبد الرحمن قال: وسمعت علي بن الحسين يقول: كتبت عنه مع جريج وكان شيعيا من أصحاب حسن بن صالح","citation":"الجرح والتعديل لابن أبي حاتم (7/ 109)","pageId":709337,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13091":{"id":13091,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"أحد أئمة الحديث. سمع الحسن بن سفيان، والهيثم بن خلف، وحامد بن شعيب، وأبا عمرو الخفاف، وعبد الله شيرويه، وقاسم بن الفضل الرازي، وابن خزيمة، وخلقا كثيرا. وصنف التفسير الكبير، والمستخرج على صحيح مسلم، والأبواب، وغير ذلك","citation":"سير أعلام النبلاء (16/ 29)","pageId":728297,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}