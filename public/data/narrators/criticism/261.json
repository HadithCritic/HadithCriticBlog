{"13050":{"id":13050,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: كان من أجلة أهل الري يسئل عن العدالات","citation":"الجرح والتعديل لابن أبي حاتم (6/ 279)","pageId":706276,"verdict":"unclassified"},{"text":"نا عبد الرحمن قال: سئل أبي عن عيسى بن أبي فاطمة، فقال: صدوق","citation":"الجرح والتعديل لابن أبي حاتم (6/ 279)","pageId":706276,"verdict":"tadil"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"ثنا عبد الرحمن قال: سئل أبو زرعة عنه، فقال: كان صدوقا كتبت عنه الكثير","citation":"الجرح والتعديل لابن أبي حاتم (6/ 279)","pageId":706276,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"13057":{"id":13057,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سئل أبي عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (7/ 50)","pageId":708556,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13058":{"id":13058,"criticCount":2,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حزم","statements":[{"text":"وقال ابن حزم في \" المحلى \": غالب بن عبد الله مجهول","citation":"لسان الميزان (6/ 296)","pageId":555247,"verdict":"jarh"}]},{"critic":"العلائي","statements":[{"text":"وفي الإسناد عمرو بن زياد، وضاع، فأما غالب فلا يعرف. قاله العلائي","citation":"لسان الميزان (6/ 296)","pageId":555247,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"13059":{"id":13059,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":1,"unclassified":1},"critics":[{"critic":"الحاكم","statements":[{"text":"رواة هذا الحديث كلهم ثقات إلا غزال بن محمد ؛ فإنه مجهول لا أعرفه بعدالة ولا جرح. وقد صح الحديث عن ابن عمر - رضي الله عنهما - من قوله من غير مسند ولا متصل","citation":"المستدرك على الصحيحين (4/ 211)","pageId":61878,"verdict":"mixed"}]},{"critic":"الذهبى","statem