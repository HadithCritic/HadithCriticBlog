{"18400":{"id":18400,"criticCount":2,"statementCount":4,"tally":{"jarh":1,"tadil":0,"mixed":1,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"صحيح غريب","citation":"سير أعلام النبلاء (14/ 194)","pageId":727118,"verdict":"unclassified"},{"text":"وكان واسع الرحلة، بصيرا بالآثار","citation":"تاريخ الإسلام (7/ 68)","pageId":638572,"verdict":"unclassified"},{"text":"من أعيان المحدثين بخراسان وثقاتهم","citation":"تاريخ الإسلام (7/ 68)","pageId":638572,"verdict":"mixed"}]},{"critic":"صالح جزرة","statements":[{"text":"قال ابن عدي: بلغني عن صالح بن محمد جزرة: أنه وقف على حلقة أبي الحسين السمناني وهو يروي عن بركة بن محمد الحلبي - يعني: مناكير - فقال صالح: يا أبا الحسين، ليس ذا بركة; ذا نقمة","citation":"سير أعلام النبلاء (14/ 194)","pageId":727118,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18401":{"id":18401,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الدارقطني","statements":[{"text":"قال أبو الحسن الدارقطني: مجهول","citation":"لسان الميزان (5/ 142)","pageId":552443,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18404":{"id":18404,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"علي بن محمد الشالسني","statements":[{"text":"قال علي بن محمد الشالسني: كان من رواة أهل البيت، وحاملي الأثر عنهم، وكان في وسط المائة الثالثة","citation":"لسان الميزان (3/ 32)","pageId":546995,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18405":{"id":18405,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سئل أبي عنه فقال: هو شيخ","citation":"الجرح والتعديل لابن أبي حاتم (3/ 15)","pageId":688196,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18407":{"id":18407,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":1,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"أتى بخبر باطل قال: حدثنا أبو بكر بن عياش عن معروف بن خربوذ، عن أبي الطفيل، عن أبي ذر مرفوعا: \" لا تزول قدما عبد حتى يسأل عن حبنا أهل البيت. وأومأ إلى علي \". رواه أبو بكر الباغندي، عن يعقوب بن إسحاق الطوسي عنه. وله عن حلو بن السري، عن أبي إسحاق، عن أبي الأحوص، عن عبد الله: \" لا ألفين أحدكم يتغنى ويدع أن يقرأ سورة البقرة \". حلو وثق [2721]","citation":"لسان الميزان (2/ 529)","pageId":546578,"verdict":"mixed"}]}],"phenomena":[],"flags":[]},"18408":{"id":18408,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سئل أبي عنه فقال: صدوق","citation":"الجرح والتعديل لابن أبي حاتم (8/ 36)","pageId":712115,"verdict":"tadil"},{"text":"قال أبو محمد بن أبي حاتم: كتب إلي ببعض حديثه، وهو صدوق. وسئل أبي عنه، فقال: صدوق","citation":"لسان الميزان (7/ 350)","pageId":557904,"verdict":"tadil"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"قال أبو محمد بن أبي حاتم: كتب إلي ببعض حديثه، وهو صدوق. وسئل أبي عنه، فقال: صدوق","citation":"لسان الميزان (7/ 350)","pageId":557904,"verdict":"tadil"},{"text":"سمع منه أبي بيروت وكتب إلي ببعض حديثه، وهو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (8/ 36)","pageId":712115,"verdict":"tadil"}]},{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان في \"الثقات\" في ترجمة عقبة بن علقمة: يعتبر حديثه من غير رواية ابنه محمد عنه، لأن محمدا كان يدخل عليه الحديث ويجيب فيه","citation":"لسان الميزان (7/ 350)","pageId":557904,"verdict":"tadil"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع منه أبي بيروت وكتب إلي ببعض حديثه، وهو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (8/ 36)","pageId":712115}]}],"flags":[]},"18409":{"id":18409,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"البيهقي","statements":[{"text":"مجهول، قاله البيهقي","citation":"لسان الميزان (7/ 349)","pageId":557900,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18410":{"id":18410,"criticCount":3,"statementCount":4,"tally":{"jarh":3,"tadil":0,"mixed":1,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"مجهول","citation":"لسان الميزان (3/ 227)","pageId":547837,"verdict":"jarh"}]},{"critic":"ابن عدي","statements":[{"text":"قال ابن عدي: وهذه الأحاديث الثلاثة عن مبارك يرويها عنه حفص بن عمار، وعن حفص أحمد بن المعلى الآدمي، ولا أعرف لحفص هذا أنكر من هذه الأحاديث بهذه الأسانيد التي رواها","citation":"الكامل في الضعفاء (3/ 291)","pageId":575318,"verdict":"jarh"},{"text":"وقد ذكره ابن عدي، وساق له مناكير. انتهى. ساق له عن مبارك بن فضالة، عن الحسن، عن أنس حديث: النهي عن الشغار، والقول مثل ما يقول المؤذن. وعن مبارك، عن سلمة، عن رجاء بن حيوة، عن عمر بن عبد العزيز، عن أبي بكر بن عبد الرحمن، عن أبي هريرة في النهي عن الشغار أيضا. وقال: لا أعرف لحفص أنكر من هذه بهذه الأسانيد، تفرد بها عنه أحمد بن المعلى الأدمي","citation":"لسان الميزان (3/ 227)","pageId":547837,"verdict":"jarh"}]},{"critic":"البخاري","statements":[{"text":"حفص سمع أبا رافع، عن أبي بكر، سمع منه موسى بن أبي عائشة فيه نظر. سمعت ابن حماد يذكره عن البخاري وهذا الذي ذكره البخاري من رواية موسى بن أبي عائشة، عن حفص، وحفص هذا لم ينسب، ويذكر هذا في حديث واحد، وقد ثبت في غير موضع أن مراده أن لا يسقط عليه راو","citation":"الكامل في الضعفاء (3/ 291)","pageId":575318,"verdict":"mixed"}]}],"phenomena":[],"flags":[]},"18411":{"id":18411,"criticCount":2,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الأزدي","statements":[{"text":"قال أبو الفتح الأزدي: ضعيف","citation":"لسان الميزان (2/ 566)","pageId":546802,"verdict":"jarh"}]},{"critic":"ابن قانع","statements":[{"text":"ويزيد والد الحجاج، ذكره ابن قانع في الصحابة بهذا الحديث. والراوي عن الحجاج: هشام بن زياد أبو المقدام، وهو ضعيف","citation":"لسان الميزان (2/ 566)","pageId":546802,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18412":{"id":18412,"criticCount":2,"statementCount":3,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن أبي إسحاق الهمداني، وثابت البناني، ويونس بن عبيد، وسعد الإسكيف، روى عنه مهران بن أبي عمر العطار الرازي، وإسحاق بن سليمان سمعت أبي يقول ذلك، [قال أبو محمد]، وسألته عنه فقال: متروك الحديث، ولم يحدثني بحديثه","citation":"الجرح والتعديل لابن أبي حاتم (8/ 476)","pageId":716433,"verdict":"jarh"},{"text":"قال أبو حاتم: متروك الحديث","citation":"لسان الميزان (8/ 272)","pageId":560032,"verdict":"jarh"}]},{"critic":"البخاري","statements":[{"text":"وقال البخاري: منكر الحديث، وهو النضر بن حميد الكندي","citation":"لسان الميزان (8/ 272)","pageId":560032,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18413":{"id":18413,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"لا أدري من هو، ولا ابن من هو","citation":"الثقات (4/ 265)","pageId":588504,"verdict":"unclassified"},{"text":"قال ابن حبان في الثقات: لا أدري من هو، ولا من أبوه","citation":"لسان الميزان (3/ 492)","pageId":549053,"verdict":"tadil"}]},{"critic":"عبد الرحيم العراقي","statements":[{"text":"شيخ","citation":"لسان الميزان (3/ 492)","pageId":549053,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18416":{"id":18416,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"صدر محتشم، نبيل القدر، تام المروءة، واسع العلم، صدوق","citation":"تاريخ الإسلام (10/ 404)","pageId":654405,"verdict":"tadil"},{"text":"الإمام المفتي، الرئيس","citation":"سير أعلام النبلاء (18/ 564)","pageId":730644,"verdict":"unclassified"},{"text":"وكان صدرا، معظما، إماما، واعظا، بليغا، له النظم والنثر وسعة العلم","citation":"سير أعلام النبلاء (18/ 564)","pageId":730644,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18417":{"id":18417,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"ابن عدي","statements":[{"text":"قال الشيخ: وزبرقان هذا لا أعرف له حديثا مسندا له ضوء، وما يروي عنه الثوري وإسرائيل لعله مقاطيع","citation":"الكامل في الضعفاء (4/ 215)","pageId":575796,"verdict":"unclassified"},{"text":"وذكره ابن عدي فقال: لا أعرف له حديثا مسندا له ضوء","citation":"لسان الميزان (3/ 491)","pageId":549050,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"عن كعب بن عبد الله، روى عنه الثوري وإسرائيل، فيه وهم. سمعت ابن حماد يذكره عن البخاري","citation":"الكامل في الضعفاء (4/ 215)","pageId":575796,"verdict":"unclassified"},{"text":"وقال البخاري: في حديثه وهم","citation":"لسان الميزان (3/ 491)","pageId":549050,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"وهم في حديث فذكره العقيلي في كتابه","citation":"لسان الميزان (3/ 491)","pageId":549050,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18419":{"id":18419,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"رأى عليا، وحذيفة. روى عنه ابنه الزبرقان بن عبد الله بن كعب العبدي. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (5/ 142)","pageId":700341,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وفي \"تاريخ البخاري \": كعب بن عبد الله العبدي يعد في الكوفيين، ورأى عليا يمسح على جوربيه، ثم ساقه من طريق الثوري، عن الزبرقان، عنه؛ فكأنه هذا","citation":"الإصابة في تمييز الصحابة (9/ 342)","pageId":430178,"verdict":"unclassified"},{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (9/ 342)","pageId":430178,"verdict":"unclassified"}]},{"critic":"هشام بن محمد بن السائب الكلبي","statements":[{"text":"ذكره ابن الكلبي:","citation":"الإصابة في تمييز الصحابة (9/ 342)","pageId":430178,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (9/ 342)","pageId":430178},{"text":"رأى عليا، وحذيفة. روى عنه ابنه الزبرقان بن عبد الله بن كعب العبدي. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (5/ 142)","pageId":700341}]}],"flags":[]},"18420":{"id":18420,"criticCount":3,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"وقال أبو حاتم: شيخ","citation":"لسان الميزان (3/ 448)","pageId":548895,"verdict":"unclassified"}]},{"critic":"الأزدي","statements":[{"text":"قال الأزدي: منكر الحديث","citation":"لسان الميزان (3/ 448)","pageId":548895,"verdict":"jarh"}]},{"critic":"يحيى بن معين","statements":[{"text":"وقال ابن معين: ليس بشيء","citation":"لسان الميزان (3/ 448)","pageId":548895,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18425":{"id":18425,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"لا بأس به","citation":"تاريخ الإسلام (5/ 1165)","pageId":631747,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18426":{"id":18426,"criticCount":2,"statementCount":4,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سئل عنه أبو حاتم فقال: شيخ","citation":"لسان الميزان (3/ 449)","pageId":548897,"verdict":"unclassified"},{"text":"حدثنا عبد الرحمن، قال: سألت أبي عن ربيع بن سليم فقال: هو شيخ","citation":"الجرح والتعديل لابن أبي حاتم (3/ 463)","pageId":692649,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"حدثنا عبد الرحمن، قال: قرئ على العباس بن محمد الدوري، قال: سمعت يحيى بن معين يقول: الربيع بن سليم صاحب لمازة ليس بشيء","citation":"الجرح والتعديل لابن أبي حاتم (3/ 463)","pageId":692649,"verdict":"jarh"},{"text":"قال ابن معين: ليس بشيء، صاحب لمازة بن زبار","citation":"لسان الميزان (3/ 449)","pageId":548897,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18428":{"id":18428,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"الفقيه","citation":"تاريخ الإسلام (13/ 327)","pageId":667475,"verdict":"unclassi