{"10100":{"id":10100,"criticCount":3,"statementCount":4,"tally":{"jarh":1,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال المزي: يحتمل أن يكون هو مولى عمرو بن العاص، ولم يبين من حاله شيئا، وأغفل كونه مذكورا في كتاب «الثقات» لابن حبان","citation":"إكمال تهذيب الكمال (5/ 125)","pageId":534898,"verdict":"tadil"},{"text":"وروى عمرو بن دينار، عن زياد مولى عمرو بن العاص، عن عمرو حديث: \" تقتل عمارا الفئة الباغية \". فيحتمل أن يكون هذا. قلت: هذا في \" الثقات \" لابن حبان","citation":"تهذيب التهذيب (1/ 656)","pageId":469139,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 349)","pageId":511383,"verdict":"jarh"}]},{"critic":"أبو داود السجستاني","statements":[{"text":"روى عن النبي - صلى الله عليه وسلم - أنه نهى أن تسترضع الحمقاء، وعنه ضمام بن إسماعيل، أورده أبو داود في \" المراسيل \"","citation":"الإصابة في تمييز الصحابة (4/ 165)","pageId":420780,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"روى عن النبي - صلى الله عليه وسلم - أنه نهى أن تسترضع الحمقاء، وعنه ضمام بن إسماعيل، أورده أبو داود في \" المراسيل \"","citation":"الإصابة في تمييز الصحابة (4/ 165)","pageId":420780}]}],"flags":["Sends Mursal Reports"]},"10101":{"id":10101,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 349)","pageId":511397,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"10105":{"id":10105,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"، قال: وهو الذي يقال له: زيد بن أبي زياد","citation":"تهذيب الكمال (10/ 67)","pageId":445126,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (1/ 665)","pageId":469215,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 353)","pageId":511457,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10110":{"id":10110,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (1/ 680)","pageId":469362,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (10/ 177)","pageId":445264,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 361)","pageId":511598,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10111":{"id":10111,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"، مجهول","citation":"تقريب التهذيب (1/ 362)","pageId":511616,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"10114":{"id":10114,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 364)","pageId":511640,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"قلت: قرأت بخط الذهبي: لا يعرف","citation":"تهذيب التهذيب (1/ 683)","pageId":469401,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10117":{"id":10117,"criticCount":2,"statementCount":5,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في الصحابة، وقال: أتاه النبي صلى الله عليه وآله وسلم يعوده","citation":"تهذيب التهذيب (1/ 691)","pageId":469482,"verdict":"unclassified"},{"text":"ذكره ابن حبان في الصحابة","citation":"الإصابة في تمييز الصحابة (4/ 260)","pageId":421065,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"صحابي، له حديث","citation":"تهذيب التهذيب (1/ 691)","pageId":469482,"verdict":"unclassified"},{"text":"تفرد يونس بن الحجاج عن ابن عيينة، عن ابن أبي نجيح بقوله: سعد بن أبي رافع. ورواه الحسن بن سفيان، عن قتيبة، عن ابن عيينة، فقال: قال سعد، ولم ينسبه. وكذا أخرجه أبو داود، وابن منده من رواية ابن عيينة. وروى ابن إسحاق عن إسماعيل بن محمد بن سعد بن أبي وقاص، عن أبيه، عن جده مثل هذا. فإما أن يكون يونس بن الحجاج وهم في قوله: ابن أبي رافع، أو تكون القصة تعددت","citation":"الإصابة في تمييز الصحابة (4/ 260)","pageId":421065,"verdict":"jarh"},{"text":"صحابي","citation":"تقريب التهذيب (1/ 368)","pageId":511710,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10118":{"id":10118,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \". قلت: في أتباع التابعين، فقال: سعد بن عبادة الزرقي: يروي عن أبيه، عن عمر وعثمان. روى عنه عبد الله بن لاحق","citation":"تهذيب التهذيب (1/ 695)","pageId":469500,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (10/ 282)","pageId":445391,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 370)","pageId":511728,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10121":{"id":10121,"criticCount":4,"statementCount":7,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":7},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"بدري شهد بدرا، مات في عهد النبي - صلى الله عليه وسلم - بالمدينة سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (4/ 93)","pageId":695108,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"شهد بدرا، وأحدا، والخندق، ورمي فيه بسهم فعاش بعد ذلك شهرا ثم انتقض جرحه فمات منه سنة (5) من الهجرة","citation":"تهذيب التهذيب (1/ 697)","pageId":469524,"verdict":"unclassified"},{"text":"شهد بدرا","citation":"تقريب التهذيب (1/ 371)","pageId":511752,"verdict":"unclassified"},{"text":"شهد بدرا باتفاق","citation":"الإصابة في تمييز الصحابة (4/ 303)","pageId":421171,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"سيد الأوس، بدري، كبير القدر","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 469)","pageId":493675,"verdict":"unclassified"},{"text":"له شيء في البخاري","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 469)","pageId":493675,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"سيد الأوس","citation":"تهذيب الكمال (10/ 300)","pageId":445411,"verdict":"unclassified"}]}],"phenomena":[{"key":"التوثيق الضمني","label":"Implicit Authentication","statements":[{"text":"له شيء في البخاري","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 469)","pageId":493675}]}],"flags":[]},"10123":{"id":10123,"criticCount":6,"statementCount":7,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":7},"critics":[{"critic":"أبو القاسم البغوي","statements":[{"text":"جزم ابن المديني والبغوي والدارقطني بأنه صحابي من الأنصار","citation":"تقريب التهذيب (1/ 372)","pageId":511774,"verdict":"unclassified"},{"text":"وأفرده البغوي في \" معجم الصحابة \"، وتبعه في إفراده ابن منده، وأبو نعيم","citation":"تهذيب التهذيب (1/ 699)","pageId":469546,"verdict":"unclassified"}]},{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"وأفرده البغوي في \" معجم الصحابة \"، وتبعه في إفراده ابن منده، وأبو نعيم","citation":"تهذيب التهذيب (1/ 699)","pageId":469546,"verdict":"unclassified"}]},{"critic":"الدارقطني","statements":[{"text":"جزم ابن المديني والبغوي والدارقطني بأنه صحابي من الأنصار","citation":"تقريب التهذيب (1/ 372)","pageId":511774,"verdict":"unclassified"}]},{"critic":"علي ابن المديني","statements":[{"text":"جزم ابن المديني والبغوي والدارقطني بأنه صحابي من الأنصار","citation":"تقريب التهذيب (1/ 372)","pageId":511774,"verdict":"unclassified"}]},{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"وأفرده البغوي في \" معجم الصحابة \"، وتبعه في إفراده ابن منده، وأبو نعيم","citation":"تهذيب التهذيب (1/ 699)","pageId":469546,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"قلت: ويؤيد أنه غيره أن ابن منده أخرج من طريق حماد بن سلمة، عن يونس بن عبيد، عن زياد بن جبير أن رسول الله -صلى الله عليه وسلم- بعث رجلا يقال له: سعد. على السعاية. فلو كان هو ابن أبي وقاص ما عبر عنه الراوي بهذا","citation":"الإصابة في تمييز الصحابة (4/ 320)","pageId":421243,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10126":{"id":10126,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"وكان سعيد من خيار عباد الله من أفاضل أهل بيته","citation":"الثقات (6/ 348)","pageId":598928,"verdict":"unclassified"},{"text":"وذكره ابن حبان في « الثقات »، وقال: كان من خيار عباد الله من أفضل أهل بيته. وهو أقدم من المذكور في الأصل ذكرته للفائدة","citation":"تهذيب التهذيب (2/ 5)","pageId":469567,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"ثقة","citation":"تقريب التهذيب (1/ 373)","pageId":511791,"verdict":"tadil"}]},{"critic":"محمد بن عبد الله بن الزبير","statements":[{"text":"قال البخاري: قال أبو أحمد الزبيري: كان من خيار الناس","citation":"تهذيب التهذيب (2/ 5)","pageId":469567,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10127":{"id":10127,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 376)","pageId":511851,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"10129":{"id":10129,"criticCount":2,"statementCount":5,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 157)","pageId":583796,"verdict":"unclassified"},{"text":"قال ابن حبان: له صحبة","citation":"الإصابة في تمييز الصحابة (4/ 335)","pageId":421278,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"يقال: إن له صحبة، وفي إسناد حديثه هذا نظر","citation":"تهذيب التهذيب (2/ 16)","pageId":469640,"verdict":"unclassified"},{"text":"وإسناده ضعيف","citation":"تهذيب التهذيب (2/ 16)","pageId":469640,"verdict":"jarh"},{"text":"صحابي، في إسناد حديثه نظر","citation":"تقريب التهذيب (1/ 377)","pageId":511863,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10132":{"id":10132,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"سمعنا منه، وكان صدوقا","citation":"الجرح والتعديل لابن أبي حاتم (4/ 32)","pageId":694525,"verdict":"tadil"},{"text":"وعنه: ابن أبي حاتم – وقال: كان صدوقا -","citation":"تهذيب التهذيب (2/ 21)","pageId":469674,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 379)","pageId":511895,"verdict":"tadil"}]},{"critic":"الخليلي","statements":[{"text":"وذكره الخليلي في شيوخ أبي الحسن بن سلمة القطان صاحب ابن ماجه، وقال: له معرفة بالحديث، مات قبل أبي حاتم الرازي بأشهر","citation":"تهذيب التهذيب (2/ 21)","pageId":469674,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10133":{"id":10133,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 21)","pageId":469678,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (10/ 464)","pageId":445545,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 379)","pageId":511899,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10134":{"id":10134,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 379)","pageId":511907,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"10141":{"id":10141,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا بأس به","citation":"تقريب التهذيب (1/ 383)","pageId":511971,"verdict":"tadil"}]},{"critic":