itation":"لسان الميزان (2/ 445)","pageId":546080,"verdict":"jarh"}]},{"critic":"العقيلي","statements":[{"text":"وذكره العقيلي فقال: في حفظه اضطراب شديد كان يذهب إلى القدر وحدث بمناكير","citation":"لسان الميزان (2/ 445)","pageId":546080,"verdict":"jarh"}]}],"phenomena":[{"key":"التضعيف الاستثنائي","label":"Exceptional Weakening","statements":[{"text":"يعتبر بحديثه إذا روى عن غير أبيه","citation":"الثقات (8/ 159)","pageId":608309}]}],"flags":[]},"17956":{"id":17956,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أحمد بن الفرات الضبي","statements":[{"text":"وكان أحمد بن الفرات يحترمه، ويصحح سماعه منه بيده","citation":"تاريخ الإسلام (7/ 273)","pageId":639914,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17961":{"id":17961,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان ثقة، صالحا","citation":"تاريخ الإسلام (7/ 442)","pageId":640872,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17963":{"id":17963,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو طاهر السلفي","statements":[{"text":"يقول فيه أبو طاهر السلفي فيما نقلته من خطه: لم يك في وقته في الدنيا من يدانيه في علو الإسناد","citation":"سير أعلام النبلاء (19/ 583)","pageId":731381,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"مسند الديار المصرية وشيخ الإسكندرية","citation":"تاريخ الإسلام (11/ 436)","pageId":658366,"verdict":"unclassified"},{"text":"المعمر الثقة، مسند الإسكندرية ومصر","citation":"سير أعلام النبلاء (19/ 583)","pageId":731381,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17965":{"id":17965,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":4,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"ووثقه عبد الغافر، والسمعاني","citation":"سير أعلام النبلاء (18/ 250)","pageId":730295,"verdict":"tadil"},{"text":"وكذا وثقه ابن السمعاني","citation":"تاريخ الإسلام (10/ 274)","pageId":653791,"verdict":"tadil"}]},{"critic":"عبد الغافر بن إسماعيل الفارسي","statements":[{"text":"ووثقه عبد الغافر، والسمعاني","citation":"سير أعلام النبلاء (18/ 250)","pageId":730295,"verdict":"tadil"},{"text":"وعبد الغافر الفارسي ووثقه","citation":"تاريخ الإسلام (10/ 274)","pageId":653791,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17969":{"id":17969,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"حدث عن ابن هزارمرد الصريفيني، كان شيعيا، يترك الصلاة، عمر، وتفرد بعوال","citation":"لسان الميزان (7/ 480)","pageId":558313,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17971":{"id":17971,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وكان أحفظ من أبيه","citation":"الثقات (8/ 454)","pageId":611626,"verdict":"unclassified"}]}],"phenomena":[{"key":"المفاضلة بين الرواة","label":"Comparative Ranking","statements":[{"text":"وكان أحفظ من أبيه","citation":"الثقات (8/ 454)","pageId":611626}]}],"flags":[]},"17972":{"id":17972,"criticCount":3,"statementCount":5,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"روى عنه البصريون الغرائب","citation":"الثقات (8/ 140)","pageId":608088,"verdict":"unclassified"},{"text":"وذكره ابن حبان في الثقات، وقال: مولى بني هاشم من أهل البصرة، يروي عن محمد بن دينار الطاحي، روى عنه البصريون الغرائب","citation":"لسان الميزان (2/ 315)","pageId":545393,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"قلت: قد روى عنه محمد بن زكريا الغلابي، لكن الغلابي متهم، قال: حدثنا شريك، عن الأعمش، عن زيد بن وهب، عن حذيفة قال: قال رسول الله - صلى الله عليه وسلم -: \" من سره أن يحيى حياتي ويموت ميتتي ويتمسك بالقضيب الياقوت ؛ فليتول علي بن أبي طالب من بعدي \"","citation":"لسان الميزان (2/ 315)","pageId":545393,