{"12803":{"id":12803,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"ثقة طالب حديث","citation":"تاريخ الإسلام (6/ 326)","pageId":634165,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12811":{"id":12811,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه بشر بن محمد السكري. سمعت أبي يقول ذلك، وسمعته يقول: قال بعض أصحابنا: إن عبد الملك بن وهب هذا معمول عن اسمه، وهو سليمان بن عمرو بن عبد الله بن وهب النخعي - نسبة إلى جده وهب -، وسماه عبد الملك، والناس معبدون عبيد الله","citation":"الجرح والتعديل لابن أبي حاتم (5/ 373)","pageId":702586,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12820":{"id":12820,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الحاكم","statements":[{"text":"عن محمد بن ثابت، وعنه ابن لهيعة. أخرج له الحاكم في كتاب الأهوال من المستدرك حديثا، وقال: أخرجته تعجبا، وعبد الوهاب مجهول. قال الذهبي في تلخيصه: قلت: ذا الخبر موضوع، انتهى. ويحتمل أن يكون الذي قبله [4978]","citation":"لسان الميزان (5/ 303)","pageId":553027,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"12823":{"id":12823,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سئل أبي عنه، فقال: مكي صدوق","citation":"الجرح والتعديل لابن أبي حاتم (6/ 73)","pageId":703791,"verdict":"tadil"},{"text":"روى عنه أبي وكان كتب عنه بمكة سنة ثنتين وأربعين ومائتين","citation":"الجرح والتعديل لابن أبي حاتم (6/ 73)","pageId":703791,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12835":{"id":12835,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: لا بأس به","citation":"تاريخ الإسلام (7/ 171)","pageId":639315,"verdict":"tadil"},{"text":"أخبرنا أبو نعيم الحافظ، قال: حدثنا أبو بكر الطلحي، قال: حدثنا أحمد بن عبد الله بن شجاع البغدادي أبو العباس، قال: حدثنا أحمد بن بديل قال: حدثني علي بن محمد بن نصر، قال: سمعت حمزة بن يوسف يقول: سألت الدارقطني عن أحمد بن عبد الله بن أبي شجاع البغدادي، قال: ليس به بأس، كذا قال ابن أبي شجاع، وإنما هو ابن شجاع","citation":"تاريخ بغداد (5/ 364)","pageId":821001,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12836":{"id":12836,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"ولا يدرى من هو ذا عبيد","citation":"لسان الميزان (5/ 351)","pageId":553188,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12845":{"id":12845,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أحمد بن علي البيكندي","statements":[{"text":"اتهمه السليماني بوضع الحديث","citation":"لسان الميزان (5/ 119)","pageId":552360,"verdict":"jarh"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"وقال الخطيب: في حديثه أفراد وغرائب، ولم نسمع عنه إلا خيرا","citation":"لسان الميزان (5/ 119)","pageId":552360,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}