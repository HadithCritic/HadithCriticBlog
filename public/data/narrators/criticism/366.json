{"18303":{"id":18303,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"لم أر في حديثه ما يجب أن يعدل به عن الثقات إلى المجروحين","citation":"الثقات (8/ 364)","pageId":610616,"verdict":"tadil"},{"text":"يروي عن عبد الوهاب الثقفي، ويحيى القطان، حدثنا عنه الحسين بن يزيد القطان بالرقة، لم أجد في حديثه ما يجب أن يعدل به عن الثقات إلى المجروحين. قاله ابن حبان","citation":"لسان الميزان (5/ 29)","pageId":551994,"verdict":"tadil"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وقد ذكره ابن أبي حاتم، فلم يذكر فيه جرحا","citation":"لسان الميزان (5/ 29)","pageId":551994,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18310":{"id":18310,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"كتب عنه أبي","citation":"الجرح والتعديل لابن أبي حاتم (6/ 34)","pageId":703366,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18317":{"id":18317,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن، قال: سألت أبي عن عبد الله بن سفيان بن عقبة، فقال: ليس به بأس","citation":"الجرح والتعديل لابن أبي حاتم (5/ 66)","pageId":699626,"verdict":"tadil"}]},{"critic":"ابن حبان","statements":[{"text":"وقد قيل: إنه سمع جده عقبة بن أبي عائشة","citation":"الثقات (8/ 338)","pageId":610352,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"وقد قيل: إنه سمع جده عقبة بن أبي عائشة","citation":"الثقات (8/ 338)","pageId":610352}]}],"flags":[]},"18319":{"id":18319,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"العقيلي","statements":[{"text":"قال العقيلي: لا يتابع على حديثه، حدثنا أسلم بن سهل، حدثنا جدي وهب بن بقية، حدثنا عبد الله بن سفيان، عن يحيى بن