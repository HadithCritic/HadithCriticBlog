jarh":1,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات، وقال: روى عنه سيف بن هارون","citation":"لسان الميزان (5/ 436)","pageId":553531,"verdict":"tadil"}]},{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: هما مجهولان، والخبر منكر","citation":"لسان الميزان (5/ 436)","pageId":553531,"verdict":"jarh"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع الفزع، روى عنه: سيف بن هارون البرجمي، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 20)","pageId":708168,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18346":{"id":18346,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"قرأت بخط الحسيني: فيه نظر","citation":"لسان الميزان (5/ 412)","pageId":553423,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18347":{"id":18347,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حزم","statements":[{"text":"قال ابن حزم: مجهول","citation":"لسان الميزان (5/ 407)","pageId":553405,"verdict":"jarh"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع جرير بن عبد الله البجلي، روى عنه إسماعيل بن أبي خالد، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 164)","pageId":704910,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18348":{"id":18348,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وقيس لم يسمع من أبيه","citation":"الثقات (8/ 449)","pageId":611564,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"وقيس لم يسمع من أبيه","citation":"الثقات (8/ 449)","pageId":611564}]}],"flags":["Sends Mursal Reports"]}}