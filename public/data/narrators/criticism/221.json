"},{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 395)","pageId":501960,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"11067":{"id":11067,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1002)","pageId":523093,"verdict":"jarh"}]},{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"روى عنه: عامر بن إبراهيم الأصبهاني. قال أبو نعيم الأصبهاني: لم يحدث عنه غيره","citation":"تهذيب التهذيب (4/ 224)","pageId":481321,"verdict":"unclassified"},{"text":"ويروي عنه عامر بن إبراهيم الأصبهاني. قال الحافظ أبو نعيم: ولم يحدث عنه غيره","citation":"تهذيب الكمال (29/ 389)","pageId":456167,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11071":{"id":11071,"criticCount":5,"statementCount":7,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":7},"critics":[{"critic":"أبو القاسم البغوي","statements":[{"text":"ذكره البغوي في الصحابة، وأخرج من طريق جرير، عن منصور، عن أبي خالد الوالبي، عن النعمان بن عمرو بن مقرن قال: قال رسول الله - صلى الله عليه وسلم -: سباب المسلم فسوق، وقتاله كفر. وأخرجه ابن شاهين من طريق زياد البكائي، عن منصور، عن أبي خالد، عن النعمان بن مقرن، والأول أصح","citation":"الإصابة في تمييز الصحابة (11/ 91)","pageId":432848,"verdict":"unclassified"},{"text":"النعمان بن عمرو بن مقرن، فحكموا على حديثه بالإرسال، منهم ابن أبي حاتم، وأبو القاسم البغوي، وأبو أحمد العسكري وغيرهم","citation":"تهذيب التهذيب (4/ 232)","pageId":481376,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"قال أبو حاتم: حديثه عن النبي - صلى الله عليه وسلم - مرسل، روى عنه أبو خالد الوالبي","citation":"تحفة التحصيل في المراسيل (1/ 540)","pageId":681882,"verdict":"unclassified"},{"text":"روى عن النبي صلى الله عليه وسلم مرسلا، روى عنه أبو خالد الوالبي سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 445)","pageId":716144,"verdict":"unclassified"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"النعمان بن عمرو بن مقرن، فحكموا على حديثه بالإرسال، منهم ابن أبي حاتم، وأبو القاسم البغوي، وأبو أحمد العسكري وغيرهم","citation":"تهذيب التهذيب (4/ 232)","pageId":481376,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وعمرو بن النعمان ابن عم صاحب الترجمة ويقال: هو هو، انقلب على الراوي، ويقال: إن حديث النعمان هذا عن النبي - صلى الله عليه وسلم - مرسل","citation":"الإصابة في تمييز الصحابة (11/ 91)","pageId":432848,"verdict":"unclassified"}]},{"critic":"الحسن بن عبد الله العسكري","statements":[{"text":"النعمان بن عمرو بن مقرن، فحكموا على حديثه بالإرسال، منهم ابن أبي حاتم، وأبو القاسم البغوي، وأبو أحمد العسكري وغيرهم","citation":"تهذيب التهذيب (4/ 232)","pageId":481376,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11072":{"id":11072,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1006)","pageId":523167,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"قلت: قرأت بخط الذهبي: لا يعرف","citation":"تهذيب التهذيب (4/ 237)","pageId":481395,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"عمر بن عبد العزيز (س)، وكان من كتابه","citation":"تهذيب الكمال (29/ 487)","pageId":456229,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11073":{"id":11073,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (30/ 16)","pageId":456254,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 241)","pageId":481422,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":": فعلى هذا لا رواية لنفيع هذا عند أبي داود، وإنما راوي القصة سعيد بن المسيب، والحاكم فيها إنما هو عثمان، وقد صح سماع سعيد بن المسيب من عثمان، فلا معنى لذكر نفيع هذا في هذا الكتاب","citation":"تهذيب التهذيب (4/ 241)","pageId":481422,"verdict":"unclassified"},{"text":"ثقة","citation":"تقريب التهذيب (1/ 1008)","pageId":523191,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"11074":{"id":11074,"criticCount":6,"statementCount":7,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":6},"critics":[{"critic":"ابن حجر","statements":[{"text":"ومن شعر النمر بن تولب الدال على صحبته: يا قوم إني رجل عندي خبر لله من آياته هذا القمر والشمس والشعرى وآيات أخر ومنها يخاطب النبي - صلى الله عليه وسلم -: إنا أتيناك وقد طال السفر أقود خيلا رجعا فيها ضرر. ومن محاسن شعره: يود الفتى طول السلامة والغنى فكيف يرى طول السلامة يفعل يرد الفتى بعد اعتدال وصحة ينوء إذا رام القيام ويحمل ومنها: لا تغضبن على امرئ في ماله وعلى كرائم صلب مالك فاغضب وإذا تصبك خصاصة فارج الغنى وإلى الذي يعطي الرغائب فارغب","citation":"الإصابة في تمييز الصحابة (11/ 123)","pageId":432956,"verdict":"unclassified"},{"text":"صحابي","citation":"تقريب التهذيب (1/ 1008)","pageId":523197,"verdict":"unclassified"}]},{"critic":"ابن حزم","statements":[{"text":"وفرق ابن حزم في الجمهرة بين النمر بن تولب بن أقيش العكلي فساق نسبه، وأثبت صحبته وبين النمر بن تولب الشاعر فنسبه في النمر بن قاسط، وقال: إنه الذي عاش حتى خرف، ويؤيده أن ابن قتيبة حكى أن النمر بن تولب الشاعر لما خرف كان هجيراه: أقروا الضيف، أصبحوا الراكب! انحروا. وإن عمر بن الخطاب ذكره بذلك فترحم عليه، فدل ذلك على أن الذي تأخر إلى أن لقيه أبو العلاء ومن في طبقته غيره","citation":"الإصابة في تمييز الصحابة (11/ 123)","pageId":432956,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"صحابي","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 405)","pageId":502040,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"له صحبة","citation":"تهذيب الكمال (30/ 19)","pageId":456260,"verdict":"unclassified"}]},{"critic":"مغلطاي","statements":[{"text":"له صحبة","citation":"إكمال تهذيب الكمال (12/ 82)","pageId":541274,"verdict":"unclassified"}]},{"critic":"محمد بن عمران المرزباني","statements":[{"text":"وقال المرزباني: كان شاعرا فصيحا، وفد على النبي - صلى الله عليه وسلم - فأسلم، وكتب له النبي - صلى الله عليه وسلم - كتابا ونزل البصرة بعد ذلك، وكان أبو عمرو بن العلاء يسميه الكيس ؛ لجودة شعره وكثرة أمثاله","citation":"الإصابة في تمييز الصحابة (11/ 123)","pageId":432956,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11075":{"id":11075,"criticCount":4,"statementCount":7,"tally":{"jarh":3,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (30/ 23)","pageId":456273,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \". قلت: وقال: روى عنه بقية وأهل الشام","citation":"تهذيب التهذيب (4/ 242)","pageId":481444,"verdict":"tadil"},{"text":"قال ابن حبان في كتاب «الثقات»: روى عنه بقية وأهل الشام","citation":"إكمال تهذيب الكمال (12/ 86)","pageId":541287,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1009)","pageId":523209,"verdict":"jarh"}]},{"critic":"الأزدي","statements":[{"text":"قال الأزدي: ليس بشيء","citation":"لسان الميزان (9/ 438)","pageId":572011,"verdict":"jarh"},{"text":"وقال أبو الفتح الأزدي: ليس بشيء","citation":"تهذيب التهذيب (4/ 242)","pageId":481444,"verdict":"jarh"}]},{"critic":"أبو زرعة العراقي","statements":[{"text":"روى عن قحافة بن ربيعة، وقيل: عن أبيه عنه","citation":"تحفة التحصيل في المراسيل (1/ 544)","pageId":681896,"verdict":"unclassified"}]}],"phenomena":[{"key":"الاختلاف في سماع الراوي","label":"Audition Disputed","statements":[{"text":"روى عن قحافة بن ربيعة، وقيل: عن أبيه عنه","citation":"تحفة التحصيل في المراسيل (1/ 544)","pageId":681896}]}],"flags":["Audition Disputed"]},"11079":{"id":11079,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 249)","pageId":481496,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (30/ 66)","pageId":456322,"verdict":"tadil"}]},{"critic":"ابن ح