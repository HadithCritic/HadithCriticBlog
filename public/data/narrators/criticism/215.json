 (3/ 573)","pageId":478386,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10796":{"id":10796,"criticCount":3,"statementCount":6,"tally":{"jarh":0,"tadil":4,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو داود السجستاني","statements":[{"text":"قال الآجري، عن أبي داود: كان صاحب حديث كتبت عنه سنة (30)، وسألته عن حديث، فقال: شغلنا القرآن عن الحديث","citation":"تهذيب التهذيب (3/ 581)","pageId":478459,"verdict":"unclassified"},{"text":"قال أبو عبيد الآجري، عن أبي داود: كان صاحب حديث، كتبت عنه سنة ثلاثين، وسألته عن حديث فقال: شغلنا القرآن عن الحديث","citation":"تهذيب الكمال (25/ 316)","pageId":453525,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في كتاب \"الثقات","citation":"تهذيب الكمال (25/ 316)","pageId":453525,"verdict":"tadil"},{"text":"مستقيم الحديث","citation":"الثقات (9/ 112)","pageId":613792,"verdict":"tadil"},{"text":"وذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 581)","pageId":478459,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 851)","pageId":520278,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"10797":{"id":10797,"criticCount":4,"statementCount":6,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 851)","pageId":520280,"verdict":"tadil"}]},{"critic":"الحسين بن علي الصيمري","statements":[{"text":"وقال القاضي أبو عبد الله الحسين بن علي الصيمري، ومن أصحاب أبي يوسف ومحمد جميعا محمد بن سماعة، وهو من الحفاظ الثقات، كتب النوادر عن أبي يوسف، ومحمد جميعا، وروى الكتب، والأمالي، وولي القضاء ببغداد لأمير المؤمنين المأمون، فلم يزل ناظرا إلى أن ضعف بصره في أيام المعتصم، فاستعفى","citation":"تهذيب الكمال (25/ 317)","pageId":453527,"verdict":"tadil"},{"text":"وقال القاضي أبو عبد الله الحسين بن علي الصيمري: ومن أصحاب أبي يوسف ومحمد جميعا محمد بن سماعة، وهو من الحفاظ الثقات، كتب النوادر، وروى الكتب والأمالي، وولي القضاء ببغداد للمأمون، فلم يزل حتى ضعف بصره في أيام المعتصم، فاستعفى","citation":"تهذيب التهذيب (3/ 581)","pageId":478461,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"قال يحيى بن معين: لو كان أصحاب الحديث يصدقون كما يصدق محمد بن سماعة في الرأي لكانوا على نهاية","citation":"تهذيب التهذيب (3/ 581)","pageId":478461,"verdict":"unclassified"},{"text":"قال يحيى بن معين: لو كان أصحاب الحديث يصدقون في الحديث كما يصدق محمد بن سماعة في الرأي، لكانوا على نهاية","citation":"تهذيب الكمال (25/ 317)","pageId":453527,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"كان أحد أصحاب الرأي","citation":"تهذيب الكمال (25/ 317)","pageId":453527,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}