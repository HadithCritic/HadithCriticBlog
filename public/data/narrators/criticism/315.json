,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"لها صحبة","citation":"الثقات (3/ 463)","pageId":585930,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15767":{"id":15767,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"وأخرجه ابن قانع من وجه آخر، عن عطاء، فقال: عن حرب بن عبيد الله، عن جده أبي أمه، عن أبيه، وترجم للصحابي سلامة بن سالم التغلبي، وليس في السند الذي ساقه هذا الاسم، فالمعتمد ما قاله البغوي، والله أعلم","citation":"الإصابة في تمييز الصحابة (4/ 416)","pageId":421537,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15768":{"id":15768,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"أخرجه ابن منده من رواية إبراهيم بن حمزة الزبيري، عن إبراهيم بن حسن بن علي الرافعي، عن أبيه، عن جدته زينب، وإبراهيم ضعيف، وأخرجه أبو نعيم من طريق يعقوب بن حميد، عن إبراهيم الرافعي. وقال في روايته: حدثتني بنت أبي رافع، عن فاطمة بنت رسول الله - صلى الله عليه وسلم - أنها أتت. قال: وهذا هو الصواب. قلت: الزبيري أحفظ من ابن حميد، وإن كانت زينب أدركت فاطمة حتى سمعت منها، فقد أدركت النبي - صلى الله عليه وسلم - لأن فاطمة لم تبق بعده إلا قليلا","citation":"الإصابة في تمييز الصحابة (13/ 428)","pageId":438159,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15772":{"id":15772,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن السكن","statements":[{"text":"وقال ابن السكن: أبو أذينة الصدفي له صحبة، وحديثه في أهل مصر","citation":"الإصابة في تمييز الصحابة (12/ 14)","pageId":434476,"verdict":"unclassified"}]},{"critic":"أبو القاسم البغوي","statements":[{"text":"قال البغوي: من أهل مصر، روى عن النبي - صلى الله عليه وسلم - حديثا، ولا أدري له صحبة أم لا","citation":"الإصابة في تمييز الصحابة (12/ 14)","pageId":434476,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15779":{"id":15779,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"مبتدع","citation":"لسان الميزان (3/ 240)","pageId":547899,"verdict":"unclassified"}]},{"critic":"الشافعي","statements":[{"text":"وكفره الشافعي في مناظرته","citation":"لسان الميزان (3/ 240)","pageId":547899,"verdict":"unclassified"}]},{"critic":"النسائي","statements":[{"text":"قال النسائي: صاحب كلام، لا يكتب حديثه","citation":"لسان الميزان (3/ 240)","pageId":547899,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15783":{"id":15783,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الوليد بن هشام القحذمي","statements":[{"text":"وقال القحذمي: كان النابغة قديما شاعرا مفلقا طويل العمر في الجاهلية وفي الإسلام","citation":"الإصابة في تمييز الصحابة (11/ 5)","pageId":432610,"verdict":"unclassified"}]},{"critic":"معمر بن المثنى البصري","statements":[{"text":"وقال أبو عبيدة معمر بن المثنى: كان النابغة ممن فكر في الجاهلية، وأنكر الخمر والسكر، وهجر الأزلام، واجتنب الأوثان، وذكر دين إبراهيم، وهو القائل القصيدة التي فيها: الحمد لله لا شريك له من لم يقلها فنفسه ظلما","citation":"الإصابة في تمييز الصحابة (11/ 5)","pageId":432610,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15786":{"id":15786,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"فأسلمت قديما وهاجرت معه إلى الحبشة","citation":"الإصابة في تمييز الصحابة (13/ 163)","pageId":437329,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15789":{"id":15789,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن عبد البر","statements":[{"text":"قاله أبو عمر قال: ولها صحبة، روى عنها سعيد بن عثمان البلوي وهي جدته، وهي والدة عبد الله بن سلمة العجلاني المقتول بأحد","citation":"الإصابة في تمييز الصحابة (13/ 181)","pageId":437407,"verdict":"unclassified"}]}],"