لسان الميزان (2/ 147)","pageId":544718,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16823":{"id":16823,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \"الثقات\"، وقال يروي عن الحسن بن علي روى عنه مجالد","citation":"لسان الميزان (4/ 350)","pageId":550883,"verdict":"tadil"}]},{"critic":"الأزدي","statements":[{"text":"قال الأزدي: لا يقوم إسناد حديثه","citation":"لسان الميزان (4/ 350)","pageId":550883,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16832":{"id":16832,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"قال الخطيب كتبنا عنه، وكان لا بأس به","citation":"سير أعلام النبلاء (17/ 662)","pageId":730038,"verdict":"tadil"},{"text":"كتبنا عنه، وكان لا بأس به","citation":"تاريخ بغداد (13/ 253)","pageId":829153,"verdict":"tadil"},{"text":"قال الخطيب: كتبنا عنه، وكان لا بأس به","citation":"تاريخ الإسلام (9/ 712)","pageId":652339,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16833":{"id":16833,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول ذلك، وسمعته يقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (2/ 519)","pageId":687766,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"16834":{"id":16834,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"حدثنا عبد الرحمن، أنا عبد الله بن أحمد [بن محمد] بن حنبل فيما كتب إلي قال: سمعت أبي يقول: أدهم بن طريف ثقة ثقة","citation":"الجرح والتعديل لابن أبي حاتم (2/ 348)","pageId":685954,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16838":{"id":16838,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم ال