{"5813":{"id":5813,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 878)","pageId":520796,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"5822":{"id":5822,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 880)","pageId":520838,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"هكذا ذكره مفردا عن أبي جعفر محمد بن علي بن الحسين والظاهر أنه هو، والله أعلم. وقد كتبنا حديثه في ترجمة عبيد الله بن طلحة","citation":"تهذيب الكمال (26/ 163)","pageId":454030,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5837":{"id":5837,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا يعرف","citation":"تقريب التهذيب (1/ 881)","pageId":520856,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"قال المزي: لم أجد له ذكرا في غير هذا الحديث، ويحتمل أن يكون محمد بن أبي عمر المقرئ الدوري","citation":"تهذيب التهذيب (3/ 656)","pageId":478994,"verdict":"unclassified"},{"text":"ولم أجد له ذكرا في غير هذا الحديث، وأخشى أن يكون محمد بن أبي عمر الدوري المقرئ، واسم أبيه حفص بن عمر بن عبد العزيز، وله ذكر في كتاب عبد الرحمن بن أبي حاتم وغيره، والله أعلم","citation":"تهذيب الكمال (26/ 176)","pageId":454046,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5848":{"id":5848,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مستور","citation":"تقريب التهذيب (1/ 885)","pageId":520910,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}