{"15600":{"id":15600,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة، روى عن النبي صلى الله عليه وسلم، روى عنه ابنه خثيم بن مروان سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 270)","pageId":714421,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"يقال: إن له صحبة","citation":"الثقات (3/ 389)","pageId":585351,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"قال البخاري: له صحبة. روى عنه ابنه","citation":"الإصابة في تمييز الصحابة (10/ 124)","pageId":431070,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15601":{"id":15601,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"من عباد أهل البصرة وقرائهم","citation":"الثقات (5/ 452)","pageId":594169,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15604":{"id":15604,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"وقع ذكره في مستدرك الحاكم، فأخرج من طريق ابن لهيعة عن يزيد بن أبي حبيب عن ليث مولى محمد بن عياض الزهري عن محمد بن عياض الزهري قال: رفعت إلى رسول الله -صلى الله عليه وسلم- في صغري وعلي خرقة، وقد كشفت عورتي، فقال: غطوا عورته ؛ فإن حرمة عورة الصغير كحرمة عورة الكبير، ولا ينظر الله إلى كاشف عورته. وفي السند مع ابن لهيعة غيره من الضعفاء","citation":"الإصابة في تمييز الصحابة (10/ 50)","pageId":430833,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15606":{"id":15606,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات","citation":"لسان الميزان (7/ 176)","pageId":557249,"verdict":"tadil"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: ليس يعرف بالنقل، وحديثه هذا غير محفوظ","citation":"لسان الميزان (7/ 176)","pageId":557249,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15609":{"id":15609,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"قدم على النبي صلى الله عليه وسلم تبوكا، وكتب له كتابا - فيما رواه الوليد بن مسلم عن ابن ابنه سعد بن منصور بن مالك بن أحمر عن جده مالك بن أحمر","citation":"الجرح والتعديل لابن أبي حاتم (8/ 203)","pageId":713691,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15612":{"id":15612,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"ذكره ابن منده","citation":"الإصابة في تمييز الصحابة (6/ 614)","pageId":425538,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15614":{"id":15614,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: وحارثة ضعيف ؛ وهذا هو الحديث الذي أشار إليه أبو عمر","citation":"الإصابة في تمييز الصحابة (14/ 186)","pageId":439212,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15615":{"id":15615,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"روى عنها أبو عبد الله المدني، وهو مجهول. قلت: أسنده المستغفري، من طريق عبد الكريم الخراز، عن أبي عبد الله المدني، عن حاجبة عائشة ومولاتها، قالت: قلت: يا رسول الله، إنك تخرج من الخلاء فأدخل في أثرك فلا أرى شيئا إلا أني أجد رائحة المسك، فقال: إنا معاشر الأنبياء تنبت أجسادنا على أرواح أهل الجنة، فما خرج منا من نتن ابتلعته الأرض","citation":"الإصابة في تمييز الصحابة (14/ 189)","pageId":439216,"verdict":"jarh"}]},{"critic":"ابن عبد البر","statements":[{"text":"قال أبو عمر: حديثها ليس بالقائم الإسناد","citation":"الإصابة في تمييز الصحابة (14/ 189)","pageId":439216,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15621":{"id":15621,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن القطان الفاسي","statements":[{"text":"قال ابن القطان: حاله مجهول. قال: وقيل: إنه راوي المرسل المتقدم","citation":"لسان الميزان (2/ 543)","pageId":546683,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"15622":{"id":15622,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"ذكره أبو نعيم تبعا للطبراني","citation":"الإصابة في تمييز الصحابة (8/ 389)","pageId":428561,"verdict":"unclassified"}]},{"critic":"الطبراني","statements":[{"text":"ذكره أبو نعيم تبعا للطبراني","citation":"الإصابة في تمييز الصحابة (8/ 389)","pageId":428561,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"هكذا أورده، وقد صحف بعض رواته في اسم أبيه وأسقط منه، قال أحمد: حدثنا عباد بن عباد، حدثنا هشام بن زياد، عن عمار، عن عثمان بن الأرقم بن أبي الأرقم عن أبيه ؛ فذكره، وهو الصواب. والحديث للأرقم بن أبي الأرقم لا لابنه عثمان. والله أعلم","citation":"الإصابة في تمييز الصحابة (8/ 389)","pageId":428561,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15623":{"id":15623,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في الصحابة","citation":"الإصابة في تمييز الصحابة (3/ 412)","pageId":419529,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"15627":{"id":15627,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"حدثنا عبد الرحمن، نا محمد بن حمويه [بن الحسن] قال: سمعت أبا طالب يقول: قال أحمد بن حنبل: أبو الجلد جيلان بن فروة ثقة","citation":"الجرح والتعديل لابن أبي حاتم (2/ 547)","pageId":688046,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"15628":{"id":15628,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن يونس المصري","st