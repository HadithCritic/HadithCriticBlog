ع، مكثرا من الحديث، ولما كبر كان يستملي للشيوخ والأئمة كأبيه وجده، ولما شاخ أملى بموضع أبيه وجده بالجامع المنيعي وفقد في كائنة الغز، فلا يدرى قتل أو هلك من البرد، ثم سمعت بعد أنه أحرق","citation":"سير أعلام النبلاء (20/ 254)","pageId":731812,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"الشيخ العالم الثقة المحدث","citation":"سير أعلام النبلاء (20/ 254)","pageId":731812,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18139":{"id":18139,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال ابن السمعاني: امرأة صالحة كثيرة الخير","citation":"تاريخ الإسلام (11/ 964)","pageId":661056,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}