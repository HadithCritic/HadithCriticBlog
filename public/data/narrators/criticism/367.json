ط وكتب السجلات، لا يجري أحد مجراه في هذا الفن، وهو إمام مسجد المطرز","citation":"سير أعلام النبلاء (20/ 227)","pageId":731762,"verdict":"tadil"},{"text":"قال ابن السمعاني: إمام، فاضل، ثقة، صدوق، دين، حسن الأخلاق، له باع طويل في الشروط وكتب السجلات، لا يجري أحد مجراه في هذا الفن، وهو إمام مسجد المطرز","citation":"تاريخ الإسلام (11/ 965)","pageId":661062,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"الشيخ الفقيه العالم، المسند الثقة","citation":"سير أعلام النبلاء (20/ 227)","pageId":731762,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18381":{"id":18381,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"حدث عنه بشر بن موسى بخبر باطل","citation":"لسان الميزان (8/ 137)","pageId":559448,"verdict":"unclassified"}]},{"critic":"الأزدي","statements":[{"text":"ووهاه أبو الفتح الأزدي","citation":"لسان الميزان (8/ 137)","pageId":559448,"verdict":"unclassified"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"قال الخطيب: مجهول","citation":"لسان الميزان (8/ 137)","pageId":559448,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18385":{"id":18385,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"قال ابن منده: أدركت النبي - صلى الله عليه وسلم -","citation":"الإصابة في تمييز الصحابة (14/ 507)","pageId":440334,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"قال ابن منده: أدركت النبي - صلى الله عليه وسلم -","citation":"الإصابة في تمييز الصحابة (14/ 507)","pageId":440334}]}],"flags":[]},"18390":{"id":18390,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"سمعت منه بمكة، وهو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (3/ 2)","pageId":688101,"verdict":"tadil"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمعت منه بمكة، وهو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (3/ 2)","pageId":688101}]}],"flags":[]},"18391":{"id":18391,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أحمد بن محمد الإشبيلي","statements":[{"text":"قال النباتي بعد ذكره أحاديث بقية: ليست نقية","citation":"لسان الميزان (2/ 142)","pageId":544698,"verdict":"unclassified"}]},{"critic":"الأزدي","statements":[{"text":"وهذا ذكره الأزدي، فأورد من طريق بقية، عنه، عن أبان، عن أنس رفعه: \" لا يقبل قول إلا بعمل، ولا عمل إلا بنية، ولا يقبل مع ذلك إلا بإصابة السنة \"","citation":"لسان الميزان (2/ 142)","pageId":544698,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"عن الأعمش، وعنه بقية، بخبر عجيب منكر","citation":"لسان الميزان (2/ 142)","pageId":544698,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18392":{"id":18392,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"كتب عنه أبي في الرحلة الثانية، وسألته عنه فقال: محله الصدق","citation":"الجرح والتعديل لابن أبي حاتم (9/ 268)","pageId":719228,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"يغرب","citation":"الثقات (9/ 277)","pageId":615683,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18393":{"id":18393,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سئل أبي (362 م 6)، عن يزيد بن عبد الرحمن فقال: صدوق","citation":"الجرح والتعديل لابن أبي حاتم (9/ 277)","pageId":719320,"verdict":"tadil"}]},{"critic":"عبد الرحمن بن مصعب الأزدي","statements":[{"text":"نا عبد الرحمن قال: سمعت أبي يقول: سمعت محمد بن الصباح قال: سمعت أبا يزيد المعنى يقول: ابني خير مني. ويثني عليه","citation":"الجرح والتعديل لابن أبي حاتم (9/ 277)","pageId":719320,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18396":{"id":18396,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عنه فقال: شيخ مجهول","citation":"الجرح والتعديل لابن أبي حاتم (8/ 84)","pageId":712507,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18397":{"id":18397,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"مجهول","citation":"لسان الميزان (8/ 413)","pageId":560623,"verdict":"jarh"}]},{"critic":"ابن عدي","statements":[{"text":"قال ابن عدي: يكنى أبا عامر، ولا يروي عنه غير إسماعيل بن عياش، وأحاديثه غير محفوظة","citation":"لسان الميزان (8/ 413)","pageId":560623,"verdict":"unclassified"},{"text":"حدثنا محمد بن جعفر بن رزين قال: ثنا إبراهيم بن العلاء الزبيدي قال: ثنا إسماعيل بن عياش عن أبي عامر يافع بن عامر، عن قتادة، عن أنس، عن النبي صلى الله عليه وسلم قال: لولا أن لا تدفنوا - لسألت الله أن يسمعكم أصوات موتاكم. أخبرنا القاسم بن الليث، ثنا محمد بن مصفى، ثنا معافى بن عمران، عن إسماعيل بن عياش، عن يافع بن عامر، عن قتادة، عن الحسن، عن عمران بن الحصين، أن رجلا أتى رسول الله صلى الله عليه وسلم فقال: إن ابني توفي فما لي من ميراثه ؟ قال: لك السدس، فلما تولى الرجل دعاه النبي صلى الله عليه وسلم فقال: ولك السدس الآخر طعمة. قال الشيخ: وليافع عن قتادة غير ما ذكرت، ولا يروي عنه غير إسماعيل بن عياش، وأحاديثه عن قتادة غير محفوظة","citation":"الكامل في الضعفاء (9/ 181)","pageId":578874,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18399":{"id":18399,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو زرعة الرازي","statements":[{"text":"قال أبو زرعة: صدوق","citation":"تهذيب التهذيب (2/ 559)","pageId":473772,"verdict":"tadil"},{"text":"نا عبد الرحمن، قال: سمعت أبا زرعة يقول: هو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (5/ 294)","pageId":701837,"verdict":"tadil"}]},{"critic":"ابن حبان","statements":[{"text":"وقال ابن حبان في « الثقات »: عبد الرحمن بن نافع المخزومي من أهل بغداد، يروي عن وكيع، روى عنه صالح بن محمد البغدادي، أحسبه الذي يقال: درخت، كنيته أبو زياد وهو أبو زياد الأعور. انتهى. وما خاب ظنه ؛ فإن الخطيب ذكره وذكر لقبه وكنيته، لكن قال: المخرمي بتشديد الراء، روى عن مغيرة، وعلي بن ثابت الجزري، وابن أبي الزناد، ثم أسند من طريق عبد الله بن أحمد الدورقي، حدثنا عبد الرحمن بن نافع أبو زياد المخرمي جار خلف، وكان ثقة","citation":"تهذيب التهذيب (2/ 559)","pageId":473772,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}