:"تاريخ بغداد (13/ 120)","pageId":828814,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21182":{"id":21182,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وقال ابن حبان في الثقات: سكن مصر يروي عن يحيى بن زهدم، عن أبيه، عن العرس بن عميرة بنسخة مطولة. البلية فيها من يحيى بن زهدم، وأما هو في نفسه إذا حدث عن الثقات فصدوق، حدثنا عنه الحسين بن إسحاق الخلال الأصبهاني بالكرخ بنسخة","citation":"لسان الميزان (1/ 557)","pageId":543540,"verdict":"tadil"},{"text":"يروي عن: يحيى بن زهدم، عن أبيه، عن العرس بن عميرة بنسخة مقلوبة، البلية فيها من يحيى بن زهدم، وأما هو في نفسه إذا حدث عن الثقات فصدوق","citation":"الثقات (8/ 50)","pageId":607217,"verdict":"tadil"}]},{"critic":"ابن عدي","statements":[{"text":"أحمد بن علي بن الأفطح: عن يحيى بن زهدم بطامات. قال ابن عدي: لا أدري البلاء منه أو من شيخه","citation":"لسان الميزان (1/ 557)","pageId":543540,"verdict":"unclassified"}]}],"phenomena":[{"key":"التضعيف الضمني","label":"Implicit Weakening","statements":[{"text":"أحمد بن علي بن الأفطح: عن يحيى بن زهدم بطامات. قال ابن عدي: لا أدري البلاء منه أو من شيخه","citation":"لسان الميزان (1/ 557)","pageId":543540}]}],"flags":[]},"21183":{"id":21183,"criticCount":5,"statementCount":6,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع منه أبي بالرقة، وسئل عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (6/ 189)","pageId":705208,"verdict":"unclassified"},{"text":"وقال أبو حاتم: شيخ","citation":"لسان الميزان (5/ 544)","pageId":553946,"verdict":"unclassified"}]},{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"وقال أبو نعيم الأصبهاني: روى عن يزيد والأنصاري بحديثين مقلوبين","citation":"لسان الميزان (5/ 544)","pageId":553946,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان: لا يجوز الاحتجاج به، كثير الخطأ، فاحش الوهم","citation":"لسان الميزان (5/ 544)","pageId":553946,"verdict":"unclassified"}]},{"critic":"مسلمة بن القاسم","statements":[{"text":"وقال مسلمة بن قاسم: ضعيف جدا","citation":"لسان الميزان (5/ 544)","pageId":553946,"verdict":"jarh"}]},{"critic":"الحاكم","statements":[{"text":"وقال الحاكم: حدث عن يزيد بحديثين قلبهما","citation":"لسان الميزان (5/ 544)","pageId":553946,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21184":{"id":21184,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"لا أدري من هو","citation":"الثقات (5/ 370)","pageId":593315,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21185":{"id":21185,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الحاكم","statements":[{"text":"وقال الحاكم: كان شيخ عصرنا ببلدنا","citation":"لسان الميزان (5/ 520)","pageId":553853,"verdict":"unclassified"}]},{"critic":"أبو حامد ابن الشرقي","statements":[{"text":"وقال أبو حامد بن الشرقي: متروك الحديث","citation":"لسان الميزان (5/ 520)","pageId":553853,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21188":{"id":21188,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي عن يزيد بن هارون وغيره، ربما أغرب، مات سنة 244","citation":"لسان الميزان (5/ 501)","pageId":553797,"verdict":"unclassified"},{"text":"ربما أغرب","citation":"الثقات (8/ 470)","pageId":611788,"verdict":"unclassified"},{"text":"ذكره ابن حبان في \" الثقات \" هكذا","citation":"لسان الميزان (5/ 501)","pageId":553797,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21189":{"id":21189,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الحسيني","statements":[{"text":"قال الحسيني: مجهول كشيخه","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 474)","pageId":581566,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21192":{"id":21192,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي عن شداد المقاطيع","citation":"الثقات (7/ 347)","pageId":603586,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21193":{"id":21193,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":2,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"الإمام العلامة، نحوي وقته","citation":"سير أعلام النبلاء (21/ 136)","pageId":732361,"verdict":"unclassified"}]},{"critic":"علي بن يوسف القفطي","statements":[{"text":"قال الجمال القفطي كان عالما \" بكتاب \" سيبويه وعلله، قيما باللغة وشواهدها، وإليه كان التصفح في ديوان الإنشاء، لا يصدر كتاب إلى الملوك إلا بعد تصفحه، وكان فيه غفلة وقد تصدر تلامذته في حياته، وقل ما صنف. وله \" جواب المسائل العشر \" و \" حواش على الصحاح \" جودها، جاءت في ست مجلدات وكان ثقة دينا","citation":"سير أعلام النبلاء (21/ 136)","pageId":732361,"verdict":"mixed"},{"text":"قال جمال الدين القفطي: وكان عالما \" بكتاب سيبويه \" وعلله، قيما باللغة وشواهدها. وكان إليه التصفح في ديوان الإنشاء، لا يصدر كتاب عن الدولة إلى ملوك النواحي إلا بعد أن يتصفحه. وكان ينسب إلى الغفلة في غير العربية، وتحكى عنه حكايات. وقد تصدر غير واحد من أصحابه في حياته. وكان قليل التصنيف، له مقدمة سماها \" اللباب \" وله \" جواب المسائل العشرة \" التي سأل عنها ملك النحاة. وله حواش على \" صحاح الجوهري \" أجاد فيها، وهي ستة مجلدات، وكان ثقة حجة","citation":"تاريخ الإسلام (12/ 748)","pageId":664078,"verdict":"mixed"}]}],"phenomena":[],"flags":[]},"21196":{"id":21196,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"كتب عنه أبي وكتبت عنه وهو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (7/ 63)","pageId":708729,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21197":{"id":21197,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الحاكم","statements":[{"text":"قال الحاكم في ترجمته: شيخ آل رسول الله صلى الله عليه وسلم في عصره بخراسان، وكان من أكثر الناس صلاة وصدقة ومحبة لأصحاب رسول الله صلى الله عليه وسلم في عصره. صحبته برهة من الدهر فما سمعته ذكر عثمان إلا قال: الشهيد، وبكي، وما سمعته يذكر عائشة إلا قال الصديقة بنت الصديق حبيبة حبيب الله، وبكى","citation":"تاريخ الإسلام (8/ 81)","pageId":644105,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}