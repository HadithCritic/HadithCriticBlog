xed":0,"unclassified":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"حدثنا عبد الرحمن، سمعت أبي يقول: زيد أبو المعلى العدوي صالح الحديث","citation":"الجرح والتعديل لابن أبي حاتم (3/ 573)","pageId":693755,"verdict":"tadil"},{"text":"رأى أنسا، روى عن الحسن، وأبي سعيد الرقاشي، روى عنه المعتمر بن سليمان، وأبو داود الطيالسي، وعبد الصمد بن عبد الوارث، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (3/ 573)","pageId":693755,"verdict":"unclassified"}]},{"critic":"أبو داود الطيالسي","statements":[{"text":"حدثنا عبد الرحمن، نا يونس بن حبيب، نا أبو داود، نا زيد بن أبي ليلى أبو المعلى، وكان ثقة، قال: كنا عند أنس","citation":"الجرح والتعديل لابن أبي حاتم (3/ 573)","pageId":693755,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"حدثنا عبد الرحمن، قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين قال: زيد بن أبي ليلى أبو المعلى ثقة","citation":"الجرح والتعديل لابن أبي حاتم (3/ 573)","pageId":693755,"verdict":"tadil"}]},{"critic":"المنذري","statements":[{"text":"قال المنذري: لا أعرف حاله بجرح ولا عدالة","citation":"لسان الميزان (3/ 562)","pageId":549354,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وعنه معتمر بن سليمان وحده","citation":"لسان الميزان (3/ 562)","pageId":549354,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"رأى أنسا، روى عن الحسن، وأبي سعيد الرقاشي، روى عنه المعتمر بن سليمان، وأبو داود الطيالسي، وعبد الصمد بن عبد الوارث، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (3/ 573)","pageId":693755}]}],"flags":[]},"9236":{"id":9236,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"كأنه يعقوب [7880]، وإلا فمجهول","citation":"تقريب التهذيب (1/ 1254)","pageId":528219,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"9241":{"id":9241,"criticCount":4,"statementCount":4,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن القطان الفاسي","statements":[{"text":"قال ابن القطان: مجهول","citation":"لسان الميزان (6/ 413)","pageId":555812,"verdict":"jarh"}]},{"critic":"الحسيني","statements":[{"text":"مجهول","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 146)","pageId":580746,"verdict":"jarh"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"ولأبيه صحبة، روى عن: أبيه، روى عنه: ابنه عثيم بن كثير بن كليب، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 156)","pageId":709866,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"قلت: وقع في حديثه اختلاف، فعند أحمد وأبي داود، عن عثيم بن كليب، عن أبيه، لا ذكر عندهما لكثير في السند، بل أخرجا جميعا من طريق ابن جريج، أخبرت عن عثيم بن كليب، عن أبيه، عن جده أنه جاء إلى النبي صلى الله عليه وسلم فقال: إني قد أسلمت، فقال: ألق عنك شعر الكفر. وأخرجه ابن منده من طريق إبراهيم بن محمد بن أبي يحيى، عن عثيم بن كثير بن كليب، عن أبيه، عن جده، فقيل: إن ابن جريج حمله عن إبراهيم بن أبي يحيى فأبهمه، ونسب عثيما إلى جده، وقد جرى ابن منده على ما اقتضته رواية إبراهيم، فذكر كليبا في الصحابة، وجرى على ظاهر رواية ابن جريج، فجعل الصحبة في هذا الحديث لوالد كليب، وسماه الصلت فالله أعلم","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 146)","pageId":580746,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}