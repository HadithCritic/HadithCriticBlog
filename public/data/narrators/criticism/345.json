{"17255":{"id":17255,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"ولا يعرف","citation":"لسان الميزان (5/ 60)","pageId":552116,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: مجهول بالنقل، لا يقيم الحديث، وحديثه غير محفوظ، لكن يعرف بفضيل بن مرزوق، عن عطية، عن ابن عمر","citation":"لسان الميزان (5/ 60)","pageId":552116,"verdict":"jarh"},{"text":"عن أيوب بن موسى، عن نافع، عن ابن عمر - رضي الله عنهما - قال: \" قرأت على النبي - صلى الله عليه وسلم -: ضعف، فقال: \" اقرأ: ضعف \". وهذا منكر. ذكره العقيلي","citation":"لسان الميزان (5/ 60)","pageId":552116,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17268":{"id":17268,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"ما علمت فيه مقالا","citation":"تاريخ الإسلام (5/ 585)","pageId":629482,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"عبد الخالق بن منصور، قال: سألت يحيى بن معين عن سهل بن نصر يعني المطبخي، فقال: ثقة","citation":"تاريخ بغداد (10/ 168)","pageId":826156,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17269":{"id":17269,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي المقاطيع","citation":"الثقات (6/ 428)","pageId":599675,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"يروي المقاطيع","citation":"الثقات (6/ 428)","pageId":599675}]}],"flags":["Sends Mursal Reports"]},"17270":{"id":17270,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"محله الصدق، رفع حديثا فأخطأ، انتهى","citation":"لسان الميزان (4/ 215)","pageId":550297,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17272":{"id"