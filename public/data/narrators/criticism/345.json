ally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: ذكره أبي، عن إسحاق بن منصور، عن يحيى بن معين أنه قال: صالح بن مسعود الجدلي ثقة","citation":"الجرح والتعديل لابن أبي حاتم (4/ 412)","pageId":698135,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17294":{"id":17294,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الطحاوي","statements":[{"text":"فكان في هذا الحديث مكان محمد بن أبي بكر فيما رويناه قبله أبو الرجال، وقد خالف يحيى هذا فيه أبو عامر وسعيد بن منصور وأسد بن موسى، وعبد الله بن عبد الوهاب الحجبي، فذكروا أنه عن محمد بن أبي بكر، وأربعة أولى بالحفظ من واحد. ثم نظرنا هل روي فيه شيء من غير هذا الوجه ؟","citation":"شرح مشكل الآثار (6/ 144)","pageId":292213,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: حدث بمناكير","citation":"لسان الميزان (8/ 477)","pageId":560879,"verdict":"jarh"}]}],"phenomena":[],"flags":[]}}