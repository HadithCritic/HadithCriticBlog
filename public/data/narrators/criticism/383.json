{"19151":{"id":19151,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو زرعة الرازي","statements":[{"text":"حدثنا عبد الرحمن، قال: سئل أبو زرعة عنه فقال: شيخ مسلم صدوق","citation":"الجرح والتعديل لابن أبي حاتم (3/ 158)","pageId":689574,"verdict":"tadil"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وسمعت منه مع أبي","citation":"الجرح والتعديل لابن أبي حاتم (3/ 158)","pageId":689574,"verdict":"unclassified"}]},{"critic":"عبد الله بن الحسن الهسنجاني","statements":[{"text":"حدثنا عبد الرحمن، نا علي بن الحسن الهسنجاني، قال: سمعت أخي أبا محمد يعني عبد الله بن الحسن، وذكر حجاج بن حمزة فقال: أعرفه منذ ثلاثين أو أربعين سنة ما أعرفه إلا يزداد خيرا","citation":"الجرح والتعديل لابن أبي حاتم (3/ 158)","pageId":689574,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19155":{"id":19155,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وفي ثقات ابن حبان: خطاب بن كيسان، عن أبي إسحاق، وعنه محمد بن القاسم","citation":"لسان الميزان (3/ 365)","pageId":548506,"verdict":"tadil"}]},{"critic":"الأزدي","statements":[{"text":": ضعفه الأزدي، انتهى. ولفظ الأزدي: خطاب بن كيسان، أو ابن محمد بن كيسان بن عدي، روى عن أبي إسحاق، عن أبي جحيفة، قاله محمد بن القاسم عنه","citation":"لسان الميزان (3/ 365)","pageId":548506,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19158":{"id":19158,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: لا بأس به","citation":"الجرح والتعديل لابن أبي حاتم (8/ 34)","pageId":712084,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19160":{"id":19160,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان عالما زاهدا","citation":"تاريخ الإسلام (7/ 71)","pageId":638599,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19161":{"id":19161,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"عن أبيه، عن علي بن أبي طالب بخبر باطل","citation":"لسان الميزان (4/ 546)","pageId":551741,"verdict":"unclassified"}]},{"critic":"الأزدي","statements":[{"text":"وقال الأزدي: تركوه","citation":"لسان الميزان (4/ 546)","pageId":551741,"verdict":"jarh"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: لا يتابع على حديثه من وجه يثبت، وفي الباب رواية من غير هذا الوجه فيها لين أيضا","citation":"لسان الميزان (4/ 546)","pageId":551741,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19164":{"id":19164,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"البخاري","statements":[{"text":"قال البخاري: منكر الحديث","citation":"لسان الميزان (3/ 268)","pageId":548015,"verdict":"jarh"}]},{"critic":"العقيلي","statements":[{"text":"وقال العقيلي: في حديثه وهم. حدثنا أحمد بن عمرو، حدثنا محمد بن يزيد الرواس، حدثنا حماد بن سعيد، عن إسماعيل، عن قيس، عن ابن مسعود رضي الله عنه: \" أن النبي صلى الله عليه وسلم مر بشاة ميتة فقال: ألا انتفعتم بإهابها \" والصواب إسماعيل بن أبي خالد، عن عامر، عن عكرمة، عن ابن عباس. * -","citation":"لسان الميزان (3/ 268)","pageId":548015,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19166":{"id":19166,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حزم","statements":[{"text":"قال ابن حزم في الإيصال: مجهول","citation":"لسان الميزان (8/ 373)","pageId":560455,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19169":{"id":19169,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: ذكره أبي، عن إسحاق بن منصور، عن يحيى بن معين أنه سئل عن واصل بن عبد الرحمن قال: مشهور","citation":"الجرح والتعديل لابن أبي حاتم (9/ 29)","pageId":717074,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19170":{"id":19170,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"حدثنا عبد الرحمن قال: وسألت أبي عنه فقال: ما بحديثه بأس","citation":"الجرح والتعديل لابن أبي حاتم (7/ 267)","pageId":711108,"verdict":"unclassified"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وذكره ابن أبي حاتم، فقال: ما بحديثه بأس","citation":"لسان الميزان (7/ 182)","pageId":557276,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19179":{"id":19179,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان فقيها معدلا","citation":"تاريخ الإسلام (12/ 1134)","pageId":665715,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19180":{"id":19180,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال ابن السمعاني: شيخ صالح، سمع الكثير، وحصل بعض الأصول","citation":"تاريخ الإسلام (11/ 868)","pageId":660515,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19182":{"id":19182,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن عدي","statements":[{"text":": وهذا حديث لم يروه عن سعيد بهذا الإسناد غير إسماعيل بن عباد، وفي متن هذا الحديث زيادات لا يرويها غير إسماعيل، وفي الجملة عن قتادة، عن أنس غريب لا يروى إلا من هذا الوجه عن قتادة، وروي عن هشام الدستوائي، عن قتادة، وهو حديث ينفرد به إسحاق بن راهويه","citation":"الكامل في الضعفاء (1/ 506)","pageId":574488,"verdict":"unclassified"},{"text":"وهذا الحديث بهذا الإسناد منكر لا يرويه عن سعيد غير إسماعيل هذا، ولإسماعيل عن سعيد غير ما ذكرت من الحديث بما ينفرد به عنه، وإسماعيل ليس بذلك المعروف","citation":"الكامل في الضعفاء (1/ 506)","pageId":574488,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19183":{"id":19183,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الطبراني","statements":[{"text":"وخرج الطبراني في \" الأوسط \" من طريقه غريب الإسناد، وقال: إنه تفرد به. ولعله الذي ذكره الأزدي","citation":"لسان الميزان (8/ 32)","pageId":558956,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19185":{"id":19185,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان أحد الثقات","citation":"تاريخ الإسلام (6/ 294)","pageId":633976,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19187":{"id":19187,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"علي بن حجر بن إياس","statements":[{"text":"روى عنه: علي بن حجر السعدي، وزعم أنه كان ثقة","citation":"الثقات (9/ 197)","pageId":614802,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19188":{"id":19188,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"الزنديق الاتحادي","citation":"تاريخ الإسلام (6/ 716)","pageId":636168,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19190":{"id":19190,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين أنه قال: عقبة بن أبي جسرة ثقة","citation":"الجرح والتعديل لابن أبي حاتم (6/ 309)","pageId":706658,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19191":{"id":19191,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الساجي","statements":[{"text":"سمعت الساجي يقول: أبو سفيان الصوفي يقال: ابن رواحة يروي عن ابن عون ما سمعت أحدا من أصحابنا البصريين لا بندار ولا ابن المثنى حدثوا عنه بشيء","citation":"الكامل في الضعفاء (5/ 535)","pageId":576709,"verdict":"unclassified"}]},{"critic":"يحيى القطان","statements":[{"text":"ثنا الجنيدي، ثنا البخاري، قال: كان يحيى بن سعيد لا يرضى عبيد الله ابن سفيان","citation":"الكامل في الضعفاء (5/ 535)","pageId":576709,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"ثنا ابن حماد، ثنا عباس، عن يحيى، قال: أبو سفيان الصواف كان كذابا، وكان يقال له: ابن رواحة، قدم علينا وهو بصري يروي عن ابن عون","citation":"الكامل في الضعفاء (5/ 535)","pageId":576709,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19192":{"id":19192,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات كما سيأتي بعد ترجمة","citation":"لسان الميزان (8/ 269)","pageId":560008,"verdict":"tadil"}]},{"critic":"العقيلي","statements":[{"text":"وذكره العقيلي في الضعفاء فقال: نصر بن نجيح الباهلي، عن عمر أبي حفص ونصر وعمر مجهولان بالنقل، والحديث غير محفوظ، ثم ساق الحديث المذكور من رواية نصر بن علي، عن نصر بن نجيح بسنده المذكور إلى أنس","citation":"لسان الميزان (8/ 269)","pageId":560008,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19196":{"id":19196,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"، لا يعرف ؛ لا هو ولا أبوه","citation":"لسان الميزان (8/ 30)","pageId":558950,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: مجهول بالنقل هو وأبوه، وحديثه غير محفوظ، ثم ساق من طريق عنبسة بن عبد الرحمن عنه، عن أبيه، عن حذيفة رفعه: \" أهل الجور وأعوانهم في النار \"","citation":"لسان الميزان (8/ 30)","pageId":558950,"verdict":"jarh"},{"text":"قال العقيلي: وحديثه غير محفوظ","citation":"لسان الميزان (8/ 30)","pageId":558950,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19198":{"id":19198,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"ثقة","citation":"تاريخ الإسلام (9/ 253)","pageId":649628,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19199":{"id":19199,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"سمعت منه مع أبي، وهو صدوق، وروى عنه أبي","citation":"الجرح والتعديل لابن أبي حاتم (8/ 472)","pageId":716394,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}