{"12350":{"id":12350,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":". حماد بن منهال مجهول، ومحمد بن أحمد بن أنس ضعيف","citation":"سنن الدارقطني (1/ 406)","pageId":146041,"verdict":"jarh"},{"text":"سنن الدارقطني: (1/ 406) برقم: (847)","citation":"قال الدارقطني مجهول لسان الميزان (3/ 279)","pageId":146041,"verdict":"unclassified"}]},{"critic":"الطبراني","statements":[{"text":"وقال الطبراني في \" الأوسط \": لم يروه عن مكحول إلا العلاء، وحديث مكحول، عن واثلة قال رسول الله صلى الله عليه وسلم: \" أقل الحيض ثلاثة أيام، وأكثره عشرة أيام \" رواه أيضا، وقال: حماد بن المنهال يعني راويه مجهول، ومحمد بن أحمد بن أنس ضعيف","citation":"الإعلام بسنته عليه الصلاة والسلام بشرح سنن ابن ماجه الإمام (3/ 187)","pageId":373965,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"12354":{"id":12354,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو زرعة الرازي","statements":[{"text":"حدثنا عبد الرحمن، قال: سئل أبو زرعة عنه فقال: مكي ثقة","citation":"الجرح والتعديل لابن أبي حاتم (3/ 213)","pageId":690165,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"12359":{"id":12359,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في الثقات، وقال: يغرب","citation":"لسان الميزان (3/ 310)","pageId":548268,"verdict":"tadil"},{"text":"يغرب","citation":"الثقات (8/ 217)","pageId":608988,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"12366":{"id":12366,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه معن، منقطع، سمعت أبي يقول ذلك، وسمعته يقول: خالد بن يحيى محله الصدق يكتب حديثه، كان يرى الإرجاء","citation":"الجرح والتعديل لابن أبي حاتم (3/ 362)","pageId":691683,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1237