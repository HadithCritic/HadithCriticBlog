assified"},{"text":"الإمام الفقيه المحدث","citation":"سير أعلام النبلاء (17/ 569)","pageId":729880,"verdict":"unclassified"},{"text":"وكان بليغ الموعظة، وافر العلم، ذا زهد وقنوع، وفضل وخشوع، قد أثر البكاء في عينيه، وعلى وجهه النور، وكان حفظة لأخبار الصالحين","citation":"سير أعلام النبلاء (17/ 569)","pageId":729880,"verdict":"unclassified"}]},{"critic":"عبد الواحد بن محمد ابن خشنام","statements":[{"text":"قال صاحبه أبو عمر بن مهدي: كان من أهل العلم بالحديث والفقه، كثير الرواية، وافر الحظ من العربية واللغة، قائلا للشعر النفيس، بليغا في خطبه، كثير الخشوع فيها، لا يتمالك من سمعه عن البكاء، مع الزهد والفضل والقنوع باليسير. ما لقيت في شيوخنا من يضاهيه في جميع أحواله. كنت إذا ذاكرته شيئا من أمر الآخرة يصفر وجهه ويدافع البكاء، وربما غلبه، وكان الدمع قد أثر في عينيه وغيرها لكثرة بكائه، وكان النور باديا على وجهه. وصحب الصالحين، وما رأيت أحفظ منه لأخبارهم وحكاياتهم","citation":"تاريخ الإسلام (9/ 466)","pageId":650886,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18157":{"id":18157,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"أحمد بن محمد العتيقي","statements":[{"text":"قال العتيقي: شيخ صالح ثقة","citation":"تاريخ بغداد (4/ 647)","pageId":820196,"verdict":"tadil"},{"text":"قال أحمد بن محمد العتيقي: هو صالح ثقة","citation":"تاريخ الإسلام (8/ 529)","pageId":646724,"verdict":"tadil"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (4/ 647)","pageId":820196,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18159":{"id":18159,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"محمد بن سعد","statements":[{"text":"قال ابن سعد: أسلمت وبايعت رسول الله - صلى الله عليه وسلم - في حجة الوداع","citation":"الإصابة في تمييز الصحابة (14/ 338)","pageId":439775,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18161":{"id":18161,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"الشيخ، الإمام، الثقة","citation":"سير أعلام النبلاء (18/ 375)","pageId":730413,"verdict":"tadil"}]},{"critic":"علي بن إبراهيم النسيب","statements":[{"text":"وقال النسيب: هو ثقة أمين","citation":"تاريخ الإسلام (10/ 290)","pageId":653869,"verdict":"tadil"},{"text":"قال النسيب: هو ثقة أمين","citation":"سير أعلام النبلاء (18/ 375)","pageId":730413,"verdict":"tadil"}]},{"critic":"هبة الله بن أحمد ابن الاكفاني","statements":[{"text":"وقال ابن الأكفاني: توفي يوم السبت الثالث من صفر سنة سبعين ودفن في باب الصغير. قال: وكان فاضلا كثير الدرس للقرآن، ثقة مأمونا","citation":"تاريخ الإسلام (10/ 290)","pageId":653869,"verdict":"tadil"},{"text":"قال هبة الله بن الأكفاني: كان فاضلا، ثقة، مأمونا، كثير الدرس للقرآن، كان يخطب للمصريين، ثم تخلى عن ذلك","citation":"سير أعلام النبلاء (18/ 375)","pageId":730413,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18162":{"id":18162,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو طاهر السلفي","statements":[{"text":"قال السلفي: كان بمصر من مشاهير الرواة، ومن الثقات الأثبات","citation":"سير أعلام النبلاء (17/ 664)","pageId":730042,"verdict":"tadil"},{"text":"قال السلفي: كان بمصر من مشاهير الرواة ومن الثقات الأثبات","citation":"تاريخ الإسلام (9/ 714)","pageId":652353,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"الشيخ الإمام الثقة المقرئ، مسند مصر","citation":"سير أعلام النبلاء (17/ 664)","pageId":730042,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18164":{"id":18164,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"الشيخ الثقة المسند","citation":"سير أعلام النبلاء (17/ 85)","pageId":729215,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18165":{"id":18165,"criticCount":3,"statementCount":6,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \"الثقات\"","citation":"لسان الميزان (4/ 356)","pageId":550933,"verdict":"tadil"}]},{"critic":"ابن عدي","statements":[{"text":"قال ابن عدي: له مناكير","citation":"لسان الميزان (4/ 356)","pageId":550933,"verdict":"jarh"},{"text":"روى عنه هشيم، وروى هو عن قتادة شيئا لا يتابعوه عليه","citation":"الكامل في الضعفاء (5/ 182)","pageId":576293,"verdict":"unclassified"},{"text":"قال الشيخ: وهذا الحديث بهذا الإسناد لا أعلم يرويه غير طلحة، عن قتادة","citation":"الكامل في الضعفاء (5/ 182)","pageId":576293,"verdict":"unclassified"},{"text":"قال الشيخ: ولطلحة هذا غير ما ذكرت من الحديث مما يرويه عن قتادة منه ما يتابعونه عليه، ومنه ما لا يتابع عليه","citation":"الكامل في الضعفاء (5/ 182)","pageId":576293,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"له أشياء لا يتابع عليها","citation":"لسان الميزان (4/ 356)","pageId":550933,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18167":{"id":18167,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"روى حديثا منقطعا","citation":"لسان الميزان (4/ 21)","pageId":549463,"verdict":"unclassified"},{"text":"مجهول","citation":"لسان الميزان (4/ 21)","pageId":549463,"verdict":"jarh"}]},{"critic":"البيهقي","statements":[{"text":"وأخرج البيهقي في الصيام من طريق إبراهيم بن مزاحم عن سريع بن نبهان عن أبي ذر حديثا في الصوم، وقال: سريع مجهول، فما أدري ؛ أهو ذا أو غيره","citation":"لسان الميزان (4/ 21)","pageId":549463,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18169":{"id":18169,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"قال ابن منده: لها ذكر في وفاة أبي ذر. ووصل ذلك أبو نعيم، من طريق مجاهد، عن إبراهيم بن الأشتر، وليس فيه ما يدل على أن لها صحبة، بل فيه احتمال أن يكون تزوجها بعد النبي - صلى الله عليه وسلم -. لكن وقفت على حديث فيه التصريح بأنها أسلمت مع أبي ذر في أول الإسلام","citation":"الإصابة في تمييز الصحابة (14/ 352)","pageId":439834,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18172":{"id":18172,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"الثقة","citation":"سير أعلام النبلاء (17/ 339)","pageId":729535,"verdict":"tadil"},{"text":"وثق","citation":"سير أعلام النبلاء (17/ 339)","pageId":729535,"verdict":"tadil"},{"text":"الثقة الرضا","citation":"تاريخ الإسلام (9/ 244)","pageId":649559,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18173":{"id":18173,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"، وقال: روى عن أبي هريرة وأبي سعيد، روى عنه قتادة والعوام بن حوشب كذا قال، وسبقه إلى ذلك عبد الرحمن بن يوسف بن خراش","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 612)","pageId":579769,"verdict":"tadil"}]},{"critic":"الحسيني","statements":[{"text":"مجهول","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 612)","pageId":579769,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18174":{"id":18174,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الحسيني","statements":[{"text":"مجهول كأمه","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 613)","pageId":579771,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18176":{"id":18176,"criticCount":4,"statementCount":5,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":2},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"نا عبد الرحمن، أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال: سمعت أبي يقول: الفياض بن غزوان شيخ ثقة، روى عنه: نعيم بن ميسرة","citation":"الجرح والتعديل لابن أبي حاتم (7/ 87)","pageId":709025,"verdict":"tadil"},{"text":"قال عبد الله بن أحمد، عن أبيه: ثقة. حكاه ابن أبي حاتم","citation":"لسان الميزان (6/ 363)","pageId":555553,"verdict":"tadil"}]},{"critic":"ابن حبان","statements":[{"text":"و