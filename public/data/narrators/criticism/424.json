{"21203":{"id":21203,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":": وكان ثقة","citation":"تاريخ بغداد (15/ 410)","pageId":831442,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21205":{"id":21205,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"[روى عنه:... ]. سمعت أبي (1219 ك) يقول ذلك، ويقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (9/ 406)","pageId":720950,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"لا يعرف","citation":"لسان الميزان (9/ 115)","pageId":562932,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21206":{"id":21206,"criticCount":3,"statementCount":6,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":4},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان أحد الموصوفين بالعقل، والمذكورين بالفضل كثير البر، والمعروف، وكانت داره مألفا لأهل العلم","citation":"تاريخ بغداد (6/ 228)","pageId":822063,"verdict":"unclassified"},{"text":"قال الخطيب: كان ثقة، يملي كل سنة مجلسا واحدا في المحرم","citation":"تاريخ الإسلام (9/ 250)","pageId":649602,"verdict":"tadil"},{"text":"كتبت عنه، وكان ثقة","citation":"تاريخ بغداد (6/ 228)","pageId":822063,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وكان يصوم الدهر، ويتهجد بسبع القرآن","citation":"تاريخ الإسلام (9/ 250)","pageId":649602,"verdict":"unclassified"},{"text":"وكان موصوفا بالعقل والفضل والبر، وداره مألف لأهل العلم. ولد سنة سبع وثلاثين وثلاثمائة، وكان صواما كثير التلاوة","citation":"تاريخ الإسلام (9/ 250)","pageId":649602,"verdict":"unclassified"}]},{"critic":"علي بن الحسن الوزير","statements":[{"text":"قال الخطيب: حدثني رئيس الرؤساء أبو القاسم الوزير قال: كان جدي يختلف إلى درس أبي بكر الرازي، وقال لي الوزير: إنه رأى في النوم أبا الحسين القدوري. فقال له: كيف حالك ؟ فتغير وجهه وطال، وأشار إلى صعوبة الأمر. قلت: فكيف حال الشيخ أبي الفرج ؟ يعني جده. قال: فعاد وجهه إلى ما كان، وقال: ومن مثل الشيخ أبي الفرج ؟ ذاك. ثم رفع يده إلى السماء. فقلت في نفسي: يريد \" وهم في الغرفات آمنون \"","citation":"تاريخ الإسلام (9/ 250)","pageId":649602,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21207":{"id":21207,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وما علمت من حاله إلا خيرا","citation":"تاريخ بغداد (13/ 210)","pageId":829027,"verdict":"unclassified"},{"text":"قال الخطيب: ما علمت إلا خيرا","citation":"تاريخ الإسلام (6/ 370)","pageId":634377,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21209":{"id":21209,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول ذلك، وسألته عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (3/ 223)","pageId":690263,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21210":{"id":21210,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الدارقطني","statements":[{"text":"ضعفه الدارقطني","citation":"لسان الميزان (8/ 422)","pageId":560661,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21212":{"id":21212,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"الشريف العالم الصالح الزاهد فخر الدين بقية المشايخ","citation":"سير أعلام النبلاء (22/ 89)","pageId":732883,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21213":{"id":21213,"criticCount":2,"statementCount":5,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال السمعاني هو نصر بن أحمد بن إبراهيم بن أسد بن أحمد، من ولد حنيفة بن لجيم بن صعب بن علي بن بكر بن وائل. قال: وهو من أهل العلم والسداد والصلاح، أفنى عمره في كتابة العلم، وتفرد بالرواية الكثيرة","citation":"سير أعلام النبلاء (19/ 391)","pageId":731178,"verdict":"unclassified"},{"text":"وساق السمعاني نسبه إلى حنيفة بن لجيم بن صعب بن علي بن بكر بن وائل، وقال: هو من أهل العلم والسداد والصلاح، أفنى عمره في كتابة العلم. حدث بالكثير، وتفرد بالرواية الكثيرة","citation":"تاريخ الإسلام (11/ 182)","pageId":657164,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وكان أسند من بقي ببلده وأزهدهم","citation":"سير أعلام النبلاء (19/ 391)","pageId":731178,"verdict":"unclassified"},{"text":"وكان أسند من بقي بهراة وأعبدهم","citation":"تاريخ الإسلام (11/ 146)","pageId":657071,"verdict":"unclassified"},{"text":"الإمام القدوة الزاهد، العابد المعمر","citation":"سير أعلام النبلاء (19/ 391)","pageId":731178,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21216":{"id":21216,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":2},"critics":[{"critic":"الحاكم","statements":[{"text":"قال الحاكم: كان من حفاظ الحديث المبرزين في المذاكرة","citation":"تاريخ الإسلام (8/ 768)","pageId":647973,"verdict":"unclassified"},{"text":"قال الحاكم: كان من حفاظ الحديث المبرزين في المذاكرة","citation":"سير أعلام النبلاء (17/ 90)","pageId":729225,"verdict":"unclassified"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة حافظا مبرزا في المذاكرة","citation":"تاريخ بغداد (2/ 210)","pageId":816878,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"الناقد الثقة","citation":"سير أعلام النبلاء (17/ 90)","pageId":729225,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21217":{"id":21217,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"محدث متقن، رحال","citation":"تاريخ الإسلام (7/ 816)","pageId":643158,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21218":{"id":21218,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"كان مؤدبا ببغداد، عالما بالنحو","citation":"تاريخ بغداد (4/ 538)","pageId":819995,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21223":{"id":21223,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن: أبي حريز. روى عنه: أحمد بن عبد الله بن يونس. سمعت أبي يقول ذلك. وسألته عنه فقال: شيخ لا بأس به","citation":"الجرح والتعديل لابن أبي حاتم (9/ 373)","pageId":720494,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21224":{"id":21224,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو محمد بن السمرقندي","statements":[{"text":"قال ابن النجار: كان شيعيا. قلت: إنما حكى ذلك عن غيره، فذكر أنه سمع من أبي القاسم بن بشران، وروى عنه أبو القاسم بن السمرقندي، وعبد الوهاب الأنماطي وغيرهما، ثم قال: قرأت بخط أبي محمد بن السمرقندي قال: توفي أبو طالب الخباز الشيعي المذهب، في نصف جمادى الآخرة سنة 498، وكان نائحا للشيعة، سمعت منه حديثا واحدا لأتبين أمره. قال: وكان مولده سنة ست عشرة وأربعمائة","citation":"لسان الميزان (1/ 443)","pageId":543096,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21226":{"id":21226,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"أحمد بن محمد العتيقي","statements":[{"text":"ثقة مأمون ؛ قاله العتيقي","citation":"تاريخ الإسلام (8/ 807)","pageId":648187,"verdict":"tadil"},{"text":"قال العتيقي: ثقة مأمون","citation":"تاريخ بغداد (3/ 505)","pageId":818583,"verdict":"tadil"}]},{"critic":"البرقاني","statements":[{"text":"سألت البرقاني عن أبي أحمد بن جامع، فقال: كان شيخا كما سر، صالحا، سمع من المحاملي ونحوه، ولم يزل يسمع معنا الحديث إلى أن مات. قلت: أكان ثقة ؟ فقال: ثقة ثقة","citation":"تاريخ بغداد (3/ 505)","pageId":818583,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21229":{"id":21229,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"المسند المعمر","citation":"سير أعلام النبلاء (13/ 45)","pageId":726351,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21231":{"id":21231,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"اتهمه الخطيب","citation":"لسان الميزان (5/ 477)","pageId":553720,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21233":{"id":21233,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (8/ 569)","pageId":824838,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وكان ثقة","citation":"تاريخ الإسلام (8/ 798)","pageId":648149,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21236":{"id":21236,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"حدثنا مهنى، قال: سألت أحمد بن حنبل عن علي بن إبراهيم المروزي، فقال: إنما هو علي بن إبراهيم البيروذي. قلت: كيف هو ؟ قال: لا بأس به مر بنا هاهنا - يعني: ببغداد - كان يحدث عن حماد بن سلمة","citation":"تاريخ بغداد (13/ 242)","pageId":829125,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21244":{"id":21244,"criticCount":4,"statementCount":4,"tally":{"jarh":3,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وفي \" ثقات ابن حبان \": عبد الحميد بن سوار، يروي عن إياس بن معاوية، روى عنه هشيم، وبكر بن خنيس. قلت: ورأيت في أصل المصنف ضربا على معاوية، وفي الحاشية: صوابه سلمة، فيحرر هذا","citation":"لسان الميزان (5/ 72)","pageId":552165,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"وقال يحيى: ليس بشيء","citation":"لسان الميزان (5/ 72)","pageId":552165,"verdict":"jarh"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه بكر بن بشر العسقلاني، سمعت أبي يقول ذلك، وسمعته يقول: مجهول","citation":"الجرح والتعديل لابن أبي حاتم (6/ 13)","pageId":703111,"verdict":"jarh"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"ضعفه أبو زرعة","citation":"لسان الميزان (5/ 72)","pageId":552165,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21247":{"id":21247,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان صدوقا","citation":"تاريخ بغداد (5/ 280)","pageId":820849,"verdict":"tadil"}]},{"critic":"حمزة بن محمد الكناني","statements":[{"text":"وثقه حمزة","citation":"تاريخ الإسلام (7/ 98)","pageId":638822,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}