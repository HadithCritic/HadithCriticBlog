07)","pageId":648187,"verdict":"tadil"},{"text":"قال العتيقي: ثقة مأمون","citation":"تاريخ بغداد (3/ 505)","pageId":818583,"verdict":"tadil"}]},{"critic":"البرقاني","statements":[{"text":"سألت البرقاني عن أبي أحمد بن جامع، فقال: كان شيخا كما سر، صالحا، سمع من المحاملي ونحوه، ولم يزل يسمع معنا الحديث إلى أن مات. قلت: أكان ثقة ؟ فقال: ثقة ثقة","citation":"تاريخ بغداد (3/ 505)","pageId":818583,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21229":{"id":21229,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"المسند المعمر","citation":"سير أعلام النبلاء (13/ 45)","pageId":726351,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21231":{"id":21231,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"اتهمه الخطيب","citation":"لسان الميزان (5/ 477)","pageId":553720,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21233":{"id":21233,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (8/ 569)","pageId":824838,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وكان ثقة","citation":"تاريخ الإسلام (8/ 798)","pageId":648149,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21236":{"id":21236,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أحمد بن حنبل","statements":[{"text":"حدثنا مهنى، قال: سألت أحمد بن حنبل عن علي بن إبراهيم المروزي، فقال: إنما هو علي بن إبراهيم البيروذي. قلت: كيف هو ؟ قال: لا بأس به مر بنا هاهنا - يعني: ببغداد - كان يحدث عن حماد بن سلمة","citation":"تاريخ بغداد (13/ 242)","pageId":829125,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"21247":{"id":21247,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"criti