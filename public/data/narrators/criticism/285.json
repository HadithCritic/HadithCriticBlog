{"14250":{"id":14250,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"شيخ","citation":"تاريخ الإسلام (7/ 175)","pageId":639351,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"14260":{"id":14260,"criticCount":1,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"قال حمزة: سألت الدارقطني عنه فقال: رأيت من كذبه شيئا لست أخبر به الساعة","citation":"لسان الميزان (2/ 253)","pageId":545112,"verdict":"unclassified"},{"text":"قال الدارقطني: كذاب، انتهى","citation":"لسان الميزان (2/ 253)","pageId":545112,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"14265":{"id":14265,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"ولا أعرف هذا الشيخ في البغداديين، لكن في المواصلة: بشران بن عبد الملك الخزاعي، وأراه ورد بغداد فسمع بها منه أحمد بن حبيب هذا الحديث، فإن كان كذلك فإن بشران بن عبد الملك كان يذكر عنه فضل وصلاح","citation":"تاريخ بغداد (7/ 632)","pageId":823738,"verdict":"unclassified"},{"text":"والحديث الذي سقناه منكر جدا مع إرساله، والحمل فيه على من بين بشران والحسن فإنهم ملطيون. وقد حدثني محمد بن علي الصوري قال: سمعت عبد الغني ابن سعيد المصري الحافظ يقول: ليس في الملطيين ثقة","citation":"تاريخ بغداد (7/ 632)","pageId":823738,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"14279":{"id":14279,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (8/ 96)","pageId":823931,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}