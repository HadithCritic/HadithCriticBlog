{"21003":{"id":21003,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"العقيلي","statements":[{"text":"قال العقيلي: يهم في غير حديث، له عن أبيه، عن قيس بن أبي حازم قال: كنا عند ابن عمر وغلام يسلخ شاة، فقال له: ويلك! إذا فرغت فابدأ بجارنا اليهودي ؛ سمعت رسول الله صلى الله عليه وسلم يوصي بالجار، حتى ظننت أنه سيورثه. رواه أبو نعيم، عن بشير بن سلمان، عن مجاهد بدل قيس، وحديث أبي نعيم أولى","citation":"لسان الميزان (2/ 110)","pageId":544595,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"21006":{"id":21006,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"شيخ لبقية لا يعرف","citation":"لسان الميزان (4/ 375)","pageId":551020,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21009":{"id":21009,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"لم يذكر ابن أبي حاتم إسماعيل بن القعقاع ولا أتحقق سماعه عن جده غير أنه قال عبد الله: فانطلقت فجمعتها فأديتها إلى امرأتي","citation":"الأحاديث المختارة (9/ 249)","pageId":48909,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21011":{"id":21011,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"الفقيه، المسند","citation":"سير أعلام النبلاء (18/ 550)","pageId":730616,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21012":{"id":21012,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"المحدث","citation":"سير أعلام النبلاء (15/ 432)","pageId":728042,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"21013":{"id":21013,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن القطان الفاسي","statements":[{"text