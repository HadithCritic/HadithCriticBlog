unclassified"}]}],"phenomena":[],"flags":[]},"8323":{"id":8323,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"وعنه عبد العزيز بن أبي سلمة الماجشون بحديث منكر في الكذب. قلت: وقع في عبارة أبي زرعة ابن شيخنا بخبر منكر كذب، كأنه ظن أن قول الحسيني في الكذب أن الخبر نفسه كذب، ولم يرد الحسيني ذلك، وإنما أراد أن متن الحديث يتعلق بالكذب، وهو كذلك فإن لفظه: لا يؤمن العبد الإيمان كله حتى يترك الكذب في المزاحة. الحديث، وهو وإن كان منكرا من جهة إسناده ؛ لأن مكحولا لم يسمع من أبي هريرة، ولأن منصورا راويه مجهول، فليس المتن بكذب، فإن له شواهد من حديث فضالة بن عبيد وأنس وأبي أمامة وغيرهم، فليس هو بكذب في نفسه، والله أعلم","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 281)","pageId":581082,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"8325":{"id":8325,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الحسيني","statements":[{"text":"لا يعرف","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 283)","pageId":581086,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"8337":{"id":8337,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في الثقات","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 294)","pageId":581116,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"8342":{"id":8342,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: أبوه مختلف في صحبته، وأما هو فلا أعرف حاله","citation":"لسان الميزان (8/ 243)","pageId":559888,"verdict":"unclassified"}]},{"critic":"الحسيني","statements":[{"text":"هو مجهول","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 299)","pageId":581130,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"8346":{"id":8346,"criticCount":1,"statementCount":1,"tally":{"jarh