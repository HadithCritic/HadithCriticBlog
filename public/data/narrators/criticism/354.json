{"17702":{"id":17702,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان: لا تحل الرواية عنه إلا على سبيل الاعتبار، إبراهيم بن سليمان الزيات، حدثنا بكر عن أبيه عن أنس: \" كنت مع النبي - صلى الله عليه وسلم - فجاء أبو بكر فقال: افتح له وبشره بالجنة، وأخبره بأنه الخليفة من بعدي \"","citation":"لسان الميزان (2/ 357)","pageId":545597,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17703":{"id":17703,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال [هو] شيخ","citation":"الجرح والتعديل لابن أبي حاتم (8/ 329)","pageId":715014,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"لا أعرفه، وخبره منكر","citation":"لسان الميزان (8/ 49)","pageId":559046,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17706":{"id":17706,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وكان من العباد","citation":"الثقات (6/ 107)","pageId":596673,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17719":{"id":17719,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال ابن السمعاني: كان خطيب نيسابور، ويرجع إلى فضل وتمييز ومعرفة بعلوم القوم، مع سلامة الجانب والتودد وحسن الخلق. وقيل: إنه ادعى سماع الرسالة من جده وغيرها من تصانيفه، وما ظهر له أصل من سماعه إلا أجزاء من حديث السراج ومجالس من إملاء جده، وكتاب عيون الأجوبة","citation":"لسان الميزان (8/ 321)","pageId":560242,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17721":{"id":17721,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"مجهول","citation":"لسان الم