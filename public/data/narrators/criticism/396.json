{"19800":{"id":19800,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات","citation":"لسان الميزان (6/ 438)","pageId":555945,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"مجهول","citation":"لسان الميزان (6/ 438)","pageId":555945,"verdict":"jarh"},{"text":"روى عن عتبة بن أبي عتبة، والحسن، روى عنه مروان بن معاوية الفزاري سمعت أبي يقول ذلك، وسمعته يقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (8/ 208)","pageId":713726,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19801":{"id":19801,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"النسائي","statements":[{"text":"وثقه النسائي","citation":"تاريخ الإسلام (5/ 1199)","pageId":631925,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19802":{"id":19802,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"البزار","statements":[{"text":"قال البزار: كان الناس ينتابونه في هذا الخبر يسمعونه منه، وكان مستورا. فحدثنا عمران، حدثنا عبد الله بن محمد القرشي، حدثنا محمد بن طلحة بن يحيى بن طلحة، عن أبيه، عن جده طلحة بن عبيد الله، قال: \" كنا نمشي مع النبي صلى الله عليه وسلم فأجهده الصوم فحلبنا له في قعب وصببنا عليه عسلا نكرم به رسول الله صلى الله عليه وسلم عند فطره \". عبد الله لا يدرى من هو","citation":"لسان الميزان (6/ 183)","pageId":554769,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"شيخ لا يعرف حاله، أتى بخبر منكر ما تابعه عليه أحد","citation":"لسان الميزان (6/ 183)","pageId":554769,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19803":{"id":19803,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"أدرك الجاهلية","citation":"الإصابة في تمييز الصحابة (11/ 163)","pageId":433101,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19805":{"id":19805,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"ولا يعرف كأبيه","citation":"لسان الميزان (6/ 387)","pageId":555659,"verdict":"unclassified"}]},{"critic":"محمد بن عبد الله بن نمير","statements":[{"text":"نا عبد الرحمن، نا علي بن الحسين بن الجنيد قال: سمعت ابن نمير يقول: روى وكيع عن القاسم الجعفي شيخ ليس بمعروف","citation":"الجرح والتعديل لابن أبي حاتم (7/ 124)","pageId":709507,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19808":{"id":19808,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عن عمرو بن عبيد الله الأنصاري، فقال: صالح محله الصدق","citation":"الجرح والتعديل لابن أبي حاتم (6/ 245)","pageId":705877,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19811":{"id":19811,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"عداده في التابعين مبتدع ضال زعم أن الله لم يتخذ إبراهيم خليلا، ولم يكلم موسى، فقتل على ذلك بالعراق يوم النحر والقصة مشهورة","citation":"لسان الميزان (2/ 437)","pageId":546037,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19812":{"id":19812,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه، فقال: لا أعرفه","citation":"الجرح والتعديل لابن أبي حاتم (6/ 110)","pageId":704247,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19813":{"id":19813,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: قرئ على العباس بن محمد الدوري قال: سمعت يحيى بن معين يقول: كان أبو سفيان بن عيينة صيرفيا بالكوفة فر من طارق وما سمعت أحدا حدث عنه غير ابنه سفيان","citation":"الجرح والتعديل لابن أبي حاتم (7/ 31)","pageId":708313,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19815":{"id":19815,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"عبد الرحيم العراقي","statements":[{"text":"قال شيخنا في \" الذيل \": الحسن بن سليمان هذا معدود من حفاظ الحديث، قال ابن يونس في \" تاريخ مصر \": كان ثقة حافظا، مات في آخر جمادى الآخرة سنة 261","citation":"لسان الميزان (3/ 54)","pageId":547072,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"قلت: سيأتي ما أورده ابن عبد البر، وما تعقبه ابن القطان في ترجمة عثمان بن محمد في أصل \" الميزان \"، وتقدمت الإشارة إلى أنه لا يستغرب خفاء حال الحسن بن سليمان على ابن القطان","citation":"لسان الميزان (3/ 54)","pageId":547072,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19819":{"id":19819,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"الذهبى","statements":[{"text":"الشيخ الإمام، العلامة المفتي المفسر، الخطيب البارع، عالم حران وخطيبها وواعظها، فخر الدين","citation":"سير أعلام النبلاء (22/ 288)","pageId":733090,"verdict":"unclassified"},{"text":"وكان فخر الدين إماما في التفسير، إماما في الفقه، إماما في اللغة. ولي خطابة بلده، ودرس، ووعظ، وأفتى","citation":"تاريخ الإسلام (13/ 723)","pageId":669110,"verdict":"unclassified"},{"text":"الفقيه","citation":"تاريخ الإسلام (13/ 723)","pageId":669110,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19821":{"id":19821,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"شيخ","citation":"الثقات (6/ 312)","pageId":598581,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19824":{"id":19824,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (12/ 46)","pageId":434634,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (12/ 46)","pageId":434634}]}],"flags":[]},"19827":{"id":19827,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: لا بأس به","citation":"الجرح والتعديل لابن أبي حاتم (6/ 263)","pageId":706069,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19828":{"id":19828,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (2/ 121)","pageId":816628,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19831":{"id":19831,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (11/ 479)","pageId":434322,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (11/ 479)","pageId":434322}]}],"flags":[]},"19835":{"id":19835,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"ولم يكن به بأس","citation":"تاريخ بغداد (7/ 464)","pageId":823548,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19836":{"id":19836,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وروى هو عن عمر رضي الله عنه في تجويز طلاق المكره مرسلا","citation":"الجرح والتعديل لابن أبي حاتم (6/ 116)","pageId":704326,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"وروى هو عن عمر رضي الله عنه في تجويز طلاق المكره مرسلا","citation":"الجرح والتعديل لابن أبي حاتم (6/ 116)","pageId":704326}]}],"flags":["Sends Mursal Reports"]},"19841":{"id":19841,"criticCount":1,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن عدي","statements":[{"text":"ولعمرو بن القاسم غير ما ذكرت من الحديث، وهو مع ضعفه يكتب حديثه","citation":"الكامل في الضعفاء (6/ 232)","pageId":576985,"verdict":"jarh"},{"text":"ضعفه ابن عدي فقال: عمرو بن القاسم بن حبيب التمار، يكنى أبا علي. عباد بن يعقوب، وإسماعيل ابن بنت السدي، قالا: أخبرنا عمرو بن القاسم التمار عن يزيد بن أبي زياد، عن إبراهيم، عن علقمة، عن عبد الله رضي الله عنه مرفوعا: \" إذا رأيتم الرايات السود [قد خرجت] فائتوها ولو حبوا على الثلج \". الحسن بن علي بن عفان: حدثنا عمرو بن القاسم التمار، عن الأعمش، عن أبي وائل، قال: خطبنا علي رضي الله عنه فقال: انفروا إلى بقية الأحزاب. رواه ابن عدي عن ابن عقدة عنه، انتهى. وقال ابن عدي في آخر ترجمته: وله غير ما ذكرت، وهو مع ضعفه يكتب حديثه","citation":"لسان الميزان (6/ 222)","pageId":554916,"verdict":"jarh"},{"text":"وهذا الحديث من حديث منصور عن سلمة غريب، لا أعلم يرويه عنه غير عمرو بن القاسم","citation":"الكامل في الضعفاء (6/ 232)","pageId":576985,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19846":{"id":19846,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (14/ 43)","pageId":830059,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19848":{"id":19848,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن يزيد بن أبي مريم، روى عنه يحيى بن سعيد القطان ومحمد بن حمران، وقال: عمارة بن مطرف، سمعت أبي يقول ذلك، وسألت أبي عنه، فقال: لا بأس به","citation":"الجرح والتعديل لابن أبي حاتم (6/ 366)","pageId":707352,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19849":{"id":19849,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"يجهل حاله، وأتى بخبر منكر، أخرجه الحاكم في مستدركه، وأظنه موضوعا، من طريق جندل بن والق، حدثنا عمرو بن أوس، حدثنا سعيد بن أبي عروبة، عن قتادة، عن سعيد بن المسيب، عن ابن عباس رضي الله عنهما قال: \" أوحى الله إلى عيسى: آمن بمحمد، فلولاه ما خلقت آدم، ولا الجنة ولا النار... \" الحديث","citation":"لسان الميزان (6/ 189)","pageId":554794,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}