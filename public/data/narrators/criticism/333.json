{"16652":{"id":16652,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"كتب عنه أبي بمصر في الرحلة الثانية، وروى عنه","citation":"الجرح والتعديل لابن أبي حاتم (9/ 198)","pageId":718565,"verdict":"unclassified"},{"text":"سئل أبي عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (9/ 198)","pageId":718565,"verdict":"unclassified"}]},{"critic":"كندير بن سعيد","statements":[{"text":"ونقل ابن يونس، عن كندير بن سعيد قال: كان أبو شريك يتشيع","citation":"لسان الميزان (8/ 485)","pageId":560906,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16660":{"id":16660,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن عدي","statements":[{"text":"وقد ذكر الذهبي ليحيى بن زهدم ترجمة، ونقل فيها، عن ابن عدي أنه لا بأس به، وأهمل ذكر زهدم والحارث، وأحدهما: موضع الريبة. ذكره الياسوفي في حاشية له على \" الميزان \". ولم يصب في استدراكه، فإن الذهبي ذكره كما ترى عقب الطائي، لكنه قال: المكي، ولم يقل: الغفاري، ولا منافاة بينهما، فهو مكي وهو غفاري، وسيأتي في يحيى بن زهدم بن الحارث: أنه غفاري","citation":"لسان الميزان (3/ 526)","pageId":549190,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"روى عن أبيه، وعنه ابنه يحيى نسخة موضوعة","citation":"لسان الميزان (3/ 526)","pageId":549190,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16661":{"id":16661,"criticCount":1,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: مجهول","citation":"الجرح والتعديل لابن أبي حاتم (9/ 373)","pageId":720490,"verdict":"jarh"},{"text":"مجهول","citation":"لسان الميزان (9/ 72)","pageId":562322,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"16662":{"id":16662,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":