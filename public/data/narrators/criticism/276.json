ified"},{"text":"قال الدارقطني: حدثنا بذلك أبو الفرج علي بن الحسين الأصبهاني الكاتب الأموي، حدثنا أبو الحسن محمد بن أحمد بن الهيثم بن صالح التميمي المصري، حدثنا محمد بن زياد به. قال: ويحيى ليس بالقوي","citation":"لسان الميزان (8/ 442)","pageId":560738,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"13835":{"id":13835,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عن أبي البلاد فقال: شيخ، يكتب حديثه","citation":"الجرح والتعديل لابن أبي حاتم (9/ 160)","pageId":718218,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين أنه قال: يحيى أبو البلاد ثقة","citation":"الجرح والتعديل لابن أبي حاتم (9/ 160)","pageId":718218,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"13836":{"id":13836,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الأزدي","statements":[{"text":"قال أبو الفتح الأزدي: لا يحتج به","citation":"لسان الميزان (8/ 456)","pageId":560779,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"13837":{"id":13837,"criticCount":2,"statementCount":4,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"الذهبى","statements":[{"text":"فذكر حديثا باطلا بيقين، فلعله افتراه","citation":"لسان الميزان (8/ 456)","pageId":560781,"verdict":"unclassified"},{"text":"شيخ مصري","citation":"لسان الميزان (8/ 456)","pageId":560781,"verdict":"unclassified"},{"text":"والحديث المذكور أورده الحاكم في المستدرك في علامات النبوة، وهو ظاهر النكارة بإسناد صحيح، وهو من طريق اليمان بن سعيد المصيصي، عن يحيى، عن عبد الرزاق، عن معمر، عن الزهري، عن سالم، عن أبيه، وهذا موضوع على الإسناد المذكور. وقد أخرجه الطبراني في الدعاء من طريق سعيد بن موسى الأزدي الحمصي، عن الثوري، عن عمرو بن دينار، عن نافع، عن ابن عمر.... فذكر نحوه بطوله. واليمان ضعيف كما سيأتي في ترجمته [8673]، وهو بسعيد أشبه، ولعل سنده انقلب على اليمان، وسعيد تقدم أنه متهم بالوضع","citation":"لسان الميزان (8/ 456)","pageId":560781,"verdict":"jarh"}]},{"critic":"الحاكم","statements":[{"text":"وقال الحاكم: يحيى هذا لا أعرفه بعدالة ولا جرح","citation":"لسان الميزان (8/ 456)","pageId":560781,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13838":{"id":13838,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"ادعى أنه سمع محمد بن إسحاق. روى عنه: ابنه أبو غسان محمد بن يحيى. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 175)","pageId":718346,"verdict":"unclassified"}]}],"phenomena":[{"key":"الاختلاف في سماع الراوي","label":"Audition Disputed","statements":[{"text":"ادعى أنه سمع محمد بن إسحاق. روى عنه: ابنه أبو غسان محمد بن يحيى. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 175)","pageId":718346}]}],"flags":["Audition Disputed"]},"13839":{"id":13839,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 362)","pageId":581292,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عنه فقال: شيخ مدني مجهول","citation":"الجرح والتعديل لابن أبي حاتم (9/ 177)","pageId":718374,"verdict":"jarh"},{"text":"قال أبو حاتم: شيخ مديني مجهول","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (2/ 362)","pageId":581292,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"13840":{"id":13840,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حزم","statements":[{"text":"قال ابن حزم: مجهول. وقال مرة: ليس بالقوي","citation":"لسان الميزان (8/ 471)","pageId":560843,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"13842":{"id":13842,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عنه فقال: ليس بقوي","citation":"الجرح والتعديل لابن أبي حاتم (9/ 166)","pageId":718274,"verdict":"jarh"}]},{"critic":"يحيى بن معين","statements":[{"text":"أخبرنا ابن أبي بكر، ثنا عباس، سمعت يحيى يقول: يحيى بن أبي لبيبة الذي يروي عنه وكيع ليس حديثه بشيء","citation":"الكامل في الضعفاء (9/ 88)","pageId":578770,"verdict":"unclassified"},{"text":"نا عبد الرحمن قال: قرئ على العباس بن محمد الدوري قال: سمعت يحيى بن معين يقول: ابن أبي لبيبة الذي يروي عنه [نافع، وجعفر بن محمد، و] وكيع - ليس حديثه بشيء","citation":"الجرح والتعديل لابن أبي حاتم (9/ 166)","pageId":718274,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13844":{"id":13844,"criticCount":2,"statementCount":6,"tally":{"jarh":0,"tadil":4,"mixed":0,"unclassified":2},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"قال الخطيب: كان ثقة حافظا زاهدا","citation":"تاريخ الإسلام (6/ 852)","pageId":637064,"verdict":"tadil"},{"text":"وكان ثقة حافظا صالحا زهدا","citation":"تاريخ بغداد (16/ 331)","pageId":831962,"verdict":"tadil"},{"text":"ذكره أبو بكر الخطيب، وقال: توفي بهراة في سنة سبع وثمانين ومائتين، قال: وكان ثقة، حافظا، زاهدا","citation":"سير أعلام النبلاء (13/ 570)","pageId":726877,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"شيخ هراة","citation":"تاريخ الإسلام (6/ 852)","pageId":637064,"verdict":"unclassified"},{"text":"سمع حبان بن موسى، وعلي ابن المديني، وأحمد بن حنبل، وطبقتهم","citation":"تاريخ الإسلام (6/ 852)","pageId":637064,"verdict":"unclassified"},{"text":"الإمام، الحافظ، الثقة، الزاهد، القدوة، محدث هراة","citation":"سير أعلام النبلاء (13/ 570)","pageId":726877,"verdict":"tadil"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع حبان بن موسى، وعلي ابن المديني، وأحمد بن حنبل، وطبقتهم","citation":"تاريخ الإسلام (6/ 852)","pageId":637064}]}],"flags":[]},"13848":{"id":13848,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critic