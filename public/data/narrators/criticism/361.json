ed":0,"unclassified":1},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وذكر كردوسا في التابعين ابن أبي حاتم، وابن حبان وغيرهما","citation":"الإصابة في تمييز الصحابة (9/ 358)","pageId":430223,"verdict":"unclassified"}]},{"critic":"ابن شاهين","statements":[{"text":"أورده ابن شاهين في الصحابة، وهو خطأ نشأ عن سقط حرف واحد، فأخرج من طريق وهب بن جرير، عن شعبة، عن عبد الملك بن ميسرة، عن كردوس رجل من الصحابة، أن النبي - صلى الله عليه وسلم -: قال لأن أجلس هذا المجلس أحب إلي من أن أعتق أربع رقاب، وهذا الحديث رواه علي بن الجعد وغيره عن شعبة، فقال: عن كردوس، عن رجل. فسقط من سند ابن شاهين عن قبل قوله: رجل","citation":"الإصابة في تمييز الصحابة (9/ 358)","pageId":430223,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18081":{"id":18081,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"شهد تستر مع أبي موسى","citation":"الثقات (4/ 203)","pageId":587812,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18082":{"id":18082,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عنه فقال: لا بأس به","citation":"الجرح والتعديل لابن أبي حاتم (7/ 149)","pageId":709770,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18083":{"id":18083,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال أبو سعد السمعاني: امرأة صالحة عالمة","citation":"سير أعلام النبلاء (19/ 625)","pageId":731451,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"الشيخة العالمة، المقرئة الصالحة المعمرة، مسندة نيسابور","citation":"سير أعلام النبلاء (19/ 625)","pageId":731451,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18085":{"id":18085,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"العلائي","stateme