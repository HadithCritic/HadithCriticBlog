---
import blogMetadata from '../data/blogMetadata.json';
import type { CollectionEntry } from 'astro:content';

interface Props {
  articles?: CollectionEntry<'articles'>[];
  compact?: boolean;
}

const { compact = false } = Astro.props;

const CATEGORY_SHORT: Record<string, string> = {
  "Hadith Transmission & Rijāl Criticism": "Hadith Transmission",
  "Prophecies, Eschatology & Miracle Claims": "Prophecies & Miracles",
  "Quranic Theology & Tafsir": "Quranic Theology",
  "Legal Theory, Madhhabs & Juristic Authority": "Legal Theory",
  "Ritual Practice & Legal Reform": "Ritual Practice",
  "Comparative Religion & Biblical Studies": "Comparative Religion",
  "Philosophy & Epistemology": "Philosophy",
};

const CATEGORY_ICONS: Record<string, string> = {
  "Hadith Transmission & Rijāl Criticism": "fa-project-diagram",
  "Prophecies, Eschatology & Miracle Claims": "fa-hourglass-half",
  "Quranic Theology & Tafsir": "fa-book-open",
  "Legal Theory, Madhhabs & Juristic Authority": "fa-gavel",
  "Ritual Practice & Legal Reform": "fa-mosque",
  "Comparative Religion & Biblical Studies": "fa-scroll",
  "Philosophy & Epistemology": "fa-brain",
};

const TEMPLATE_COLORS: Record<string, string> = {
  "isnad-forensics": "#b97955",
  "prophecy-dossier": "#b49338",
  "quranic-criterion": "#9b7aa6",
  "logic-lab": "#829bf9",
  "legal-edifice": "#c1973f",
  "comparative-manuscripts": "#8fb7a1",
  "ritual-diagram": "#d0a066",
};

const filterCategories = [
  { label: "All",                    value: "All",                                         icon: "fa-layer-group" },
  { label: "Hadith Transmission",    value: "Hadith Transmission & Rijāl Criticism",       icon: "fa-project-diagram" },
  { label: "Prophecies & Miracles",  value: "Prophecies, Eschatology & Miracle Claims",    icon: "fa-hourglass-half" },
  { label: "Quranic Theology",       value: "Quranic Theology & Tafsir",                   icon: "fa-book-open" },
  { label: "Legal Theory",           value: "Legal Theory, Madhhabs & Juristic Authority", icon: "fa-gavel" },
  { label: "Ritual Practice",        value: "Ritual Practice & Legal Reform",              icon: "fa-mosque" },
  { label: "Comparative Religion",   value: "Comparative Religion & Biblical Studies",     icon: "fa-scroll" },
  { label: "Philosophy",             value: "Philosophy & Epistemology",                   icon: "fa-brain" },
];

const allPosts = [...blogMetadata];
const quran49 = allPosts.find((post: any) => String(post.recommended_slug ?? '').includes('quran-49-6'));
const latest = allPosts.reverse().filter((post: any) => post !== quran49).slice(0, 11);
const posts = quran49 ? [quran49, ...latest] : latest.slice(0, 12);
---

<section class={`blog-slider-section ${compact ? 'is-compact' : ''}`}>
  <div class="slider-shell">
    <div class="slider-header">
      <div class="slider-title">
        <p class="slider-kicker">Library</p>
        <h2>Blogs, Research, &amp; Analysis.</h2>
        <p>Browse source criticism, Qur’anic theology, legal theory, and comparative study.</p>
      </div>

      <div class="slider-categories-container" aria-label="Blog category filters">
        <div class="slider-categories" id="categoryTabs">
          <div class="category-highlight" id="catHighlight"></div>
          {filterCategories.map((cat, index) => (
            <button
              class={`cat-tab ${index === 0 ? 'active' : ''}`}
              type="button"
              data-index={index}
              data-filter={cat.value}
            >
              <i class={`fas ${cat.icon}`}></i> {cat.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="slider-main">
      <div class="cards-wrapper" id="cardsWrapper">
        {posts.map((post: any, index: number) => {
          const shortCat = CATEGORY_SHORT[post.category] ?? post.category;
          const icon = CATEGORY_ICONS[post.category] ?? 'fa-file-alt';
          const template = post.thumbnail_template ?? 'quranic-criterion';
          const color = TEMPLATE_COLORS[template] ?? '#c1973f';
          const isFeatured = index === 0;

          return (
            <a
              href={`/blogs/${post.recommended_slug}`}
              class={`blog-card-ray blog-card--${template} ${isFeatured ? 'is-featured-card' : ''}`}
              data-category={post.category}
              style={`--tmpl-color:${color}`}
            >
              <div class="card-thumbnail-rect">
                {post.thumbnail_image ? (
                  <>
                    <img class="thumb-image" src={post.thumbnail_image} alt={post.recommended_title} />
                    <div class="thumb-image-shade"></div>
                  </>
                ) : (
                  <>
                    <div class="thumb-bg-grid"></div>
                    <div class="thumb-glow-top"></div>
                    <div class="thumb-glow-bottom"></div>
                    <div class="thumb-motif"></div>
                    <div class="thumb-content-rect">
                      <div class="thumb-brand">
                        <img
                          src="https://hadithcriticblog.com/wp-content/uploads/2026/02/cropped-HCpfp.jpg"
                          alt="HC Logo"
                          width="22"
                          height="22"
                        />
                        <span>HADITHCRITIC</span>
                      </div>
                      <p class="thumb-category">{shortCat}</p>
                      <h4 class="thumb-title thumb-title-in-card">{post.recommended_title}</h4>
                    </div>
                  </>
                )}
              </div>

              <div class="card-content-bottom">
                <div class="card-topline">
                  <span class="card-cat-label">
                    <i class={`fas ${icon}`}></i> {shortCat}
                  </span>
                  <span class="card-number">{String(index + 1).padStart(2, '0')}</span>
                </div>

                <h3 class="card-title">{post.recommended_title}</h3>
                <p class="card-desc">{post.visual_motif}</p>
                <span class="read-more">Read study <i class="fas fa-arrow-right"></i></span>
              </div>
            </a>
          );
        })}
      </div>

      <div class="slider-controls">
        <a href="/blogs" class="btn btn-outline browse-all">Browse all 74 blogs &rarr;</a>
        <div class="control-btns">
          <button class="slider-btn prev" id="sliderPrev" aria-label="Previous cards">
            <i class="fas fa-chevron-left"></i>
          </button>
          <button class="slider-btn next" id="sliderNext" aria-label="Next cards">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .blog-slider-section {
    padding: 78px 20px 86px;
    color: #fff;
    font-family: var(--font-sans);
    position: relative;
    overflow: hidden;
  }

  .blog-slider-section::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: .38;
    pointer-events: none;
    background:
      radial-gradient(circle at 22% 12%, rgba(193,151,63,.08), transparent 20rem),
      radial-gradient(circle at 78% 52%, rgba(126,62,38,.06), transparent 24rem),
      linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
    background-size: auto, auto, 36px 36px, 36px 36px;
    mask-image: linear-gradient(to bottom, transparent, black 16%, black 82%, transparent);
  }

  .slider-shell {
    max-width: 1320px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .slider-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin-bottom: 34px;
  }

  .slider-title { max-width: 760px; }

  .slider-kicker {
    display: inline-flex;
    color: var(--accent, #c1973f);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .22em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .slider-title h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.6vw, 60px);
    font-weight: 500;
    margin: 0 0 10px;
    letter-spacing: .04em;
    color: var(--text-heading);
    text-transform: uppercase;
  }

  .slider-title p:last-child {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .slider-categories-container {
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 2px;
  }
  .slider-categories-container::-webkit-scrollbar { display: none; }

  .slider-categories {
    display: inline-flex;
    width: max-content;
    position: relative;
    background: rgba(12,12,12,.78);
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 9999px;
    padding: 5px;
    gap: 2px;
    box-shadow: inset 0 2px 14px rgba(0,0,0,.72), 0 18px 45px rgba(0,0,0,.18);
    backdrop-filter: blur(14px);
  }

  .category-highlight {
    position: absolute;
    top: 5px;
    left: 0;
    background: linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.055));
    border-radius: 9999px;
    transition: transform .35s cubic-bezier(.25,1,.25,1), width .35s cubic-bezier(.25,1,.25,1);
    pointer-events: none;
    border: 1px solid rgba(255,255,255,.12);
    height: calc(100% - 10px);
    z-index: 0;
  }

  .cat-tab {
    position: relative;
    z-index: 1;
    background: transparent;
    border: 0;
    color: rgba(255,255,255,.48);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .02em;
    padding: 9px 16px;
    border-radius: 9999px;
    cursor: pointer;
    transition: color .25s ease;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .cat-tab i { font-size: 11px; opacity: .58; transition: opacity .25s ease, color .25s ease; }
  .cat-tab:hover, .cat-tab.active { color: #fff; }
  .cat-tab.active i { color: var(--tmpl-color, var(--accent)); opacity: 1; }

  .cards-wrapper {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    padding: 4px 2px 34px;
    scrollbar-width: none;
    scroll-behavior: smooth;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
  }
  .cards-wrapper::-webkit-scrollbar { display: none; }

  .blog-card-ray {
    flex: 0 0 clamp(314px, 30vw, 404px);
    min-height: 438px;
    background: linear-gradient(180deg, rgba(19,20,20,.94), rgba(12,13,13,.96));
    border: 1px solid rgba(255,255,255,.085);
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    box-shadow: 0 16px 46px rgba(0,0,0,.40), inset 0 1px 0 rgba(255,255,255,.03);
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
  }

  .blog-card-ray::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity .3s ease;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tmpl-color) 48%, transparent), 0 0 42px color-mix(in srgb, var(--tmpl-color) 16%, transparent);
  }

  .blog-card-ray.hidden { display: none; }

  .blog-card-ray:hover {
    transform: translateY(-8px);
    border-color: color-mix(in srgb, var(--tmpl-color) 42%, rgba(255,255,255,.08));
    box-shadow: 0 28px 70px rgba(0,0,0,.58);
  }
  .blog-card-ray:hover::after { opacity: 1; }

  .card-thumbnail-rect {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #090a0a;
    overflow: hidden;
    border-bottom: 1px solid rgba(255,255,255,.07);
  }

  .thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(.82) contrast(1.05) brightness(.92);
    transform: scale(1.012);
    transition: transform .45s ease, filter .45s ease;
  }
  .blog-card-ray:hover .thumb-image { transform: scale(1.055); filter: saturate(.94) contrast(1.08) brightness(1); }

  .thumb-image-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 44%, rgba(0,0,0,.20)),
      radial-gradient(circle at 50% 15%, rgba(255,255,255,.07), transparent 40%);
    pointer-events: none;
  }

  .thumb-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: .55;
  }

  .thumb-glow-top,
  .thumb-glow-bottom {
    position: absolute;
    border-radius: 50%;
    filter: blur(58px);
    z-index: 0;
  }
  .thumb-glow-top {
    top: -36%;
    left: -18%;
    width: 82%;
    height: 84%;
    background: var(--tmpl-color);
    opacity: .18;
  }
  .thumb-glow-bottom {
    right: -22%;
    bottom: -42%;
    width: 80%;
    height: 82%;
    background: rgba(255,255,255,.12);
    opacity: .07;
  }

  .thumb-motif {
    position: absolute;
    inset: 0;
    opacity: .55;
    pointer-events: none;
  }

  .blog-card--isnad-forensics .thumb-motif {
    background:
      radial-gradient(circle at 28% 42%, var(--tmpl-color) 0 5px, transparent 6px),
      radial-gradient(circle at 50% 58%, var(--tmpl-color) 0 5px, transparent 6px),
      radial-gradient(circle at 72% 39%, var(--tmpl-color) 0 5px, transparent 6px),
      linear-gradient(28deg, transparent 31%, rgba(255,255,255,.16) 31.3% 31.7%, transparent 32%),
      linear-gradient(-18deg, transparent 47%, rgba(255,255,255,.12) 47.3% 47.8%, transparent 48%);
  }

  .blog-card--prophecy-dossier .thumb-motif {
    background:
      linear-gradient(135deg, transparent 0 48%, rgba(193,151,63,.18) 48.3% 49%, transparent 49.4%),
      repeating-linear-gradient(0deg, transparent 0 18px, rgba(255,255,255,.08) 18px 19px, transparent 19px 32px);
  }

  .blog-card--quranic-criterion .thumb-motif {
    background:
      radial-gradient(circle at 50% 48%, rgba(245,236,215,.15), transparent 26%),
      linear-gradient(90deg, rgba(74,52,79,.8) 0 26%, transparent 26.4%),
      repeating-linear-gradient(106deg, transparent 0 10px, rgba(255,255,255,.11) 10px 11px, transparent 11px 20px);
  }

  .blog-card--logic-lab .thumb-motif {
    background:
      radial-gradient(circle at 25% 50%, var(--tmpl-color) 0 4px, transparent 5px),
      radial-gradient(circle at 50% 34%, var(--tmpl-color) 0 4px, transparent 5px),
      radial-gradient(circle at 72% 58%, var(--tmpl-color) 0 4px, transparent 5px),
      linear-gradient(20deg, transparent 41%, rgba(255,255,255,.15) 41.4% 41.8%, transparent 42%);
  }

  .blog-card--legal-edifice .thumb-motif {
    background:
      linear-gradient(90deg, transparent 17%, rgba(193,151,63,.16) 17% 22%, transparent 22% 39%, rgba(193,151,63,.16) 39% 44%, transparent 44% 61%, rgba(193,151,63,.16) 61% 66%, transparent 66%),
      linear-gradient(0deg, transparent 73%, rgba(255,255,255,.11) 73% 77%, transparent 77%);
  }

  .blog-card--comparative-manuscripts .thumb-motif {
    background:
      linear-gradient(90deg, transparent 18%, rgba(255,255,255,.12) 18% 36%, transparent 36% 42%, rgba(255,255,255,.10) 42% 60%, transparent 60% 66%, rgba(255,255,255,.12) 66% 84%, transparent 84%),
      repeating-linear-gradient(0deg, transparent 0 20px, rgba(255,255,255,.07) 20px 21px, transparent 21px 31px);
  }

  .blog-card--ritual-diagram .thumb-motif {
    background:
      radial-gradient(circle at 50% 52%, transparent 0 44px, rgba(193,151,63,.24) 45px 47px, transparent 48px),
      conic-gradient(from 45deg at 50% 52%, transparent 0 22%, rgba(255,255,255,.10) 22% 24%, transparent 24% 50%, rgba(255,255,255,.10) 50% 52%, transparent 52%);
  }

  .thumb-content-rect {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    gap: 7px;
    padding: 22px;
  }

  .thumb-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: auto;
    align-self: flex-start;
    opacity: .86;
  }
  .thumb-brand img {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.18);
    object-fit: cover;
  }
  .thumb-brand span {
    font-family: 'Cinzel', var(--font-display), serif;
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 700;
    color: rgba(255,255,255,.75);
  }

  .thumb-category {
    font-size: 9px;
    color: var(--tmpl-color);
    letter-spacing: .18em;
    text-transform: uppercase;
    margin: 0;
    font-weight: 900;
    opacity: .9;
  }

  .thumb-title-in-card {
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 500;
    line-height: 1.1;
    margin: 0;
    color: #f8fafc;
    letter-spacing: .12em;
    text-transform: uppercase;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-content-bottom {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 10px;
  }

  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .card-cat-label {
    font-size: 10px;
    color: var(--tmpl-color, var(--accent));
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .card-cat-label i { margin-right: 5px; }

  .card-number {
    color: rgba(255,255,255,.24);
    font-family: var(--font-display);
    font-size: 18px;
  }

  .card-title {
    margin: 0;
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.18;
    letter-spacing: .06em;
    text-transform: uppercase;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-desc {
    color: var(--text-body);
    font-size: 13px;
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    opacity: .75;
  }

  .read-more {
    margin-top: auto;
    color: rgba(255,255,255,.62);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color .25s ease;
  }
  .blog-card-ray:hover .read-more { color: var(--tmpl-color); }

  .slider-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    margin-top: 14px;
  }

  .control-btns { display: flex; gap: 10px; }

  .slider-btn {
    background: rgba(255,255,255,.055);
    border: 1px solid rgba(255,255,255,.08);
    color: rgba(255,255,255,.58);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all .22s ease;
    font-size: 12px;
  }
  .slider-btn:hover { background: rgba(255,255,255,.10); color: #fff; transform: translateY(-2px); }

  @media (max-width: 900px) {
    .blog-slider-section { padding-top: 58px; }
    .blog-card-ray { flex-basis: min(360px, 86vw); }
    .slider-controls { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabsContainer = document.getElementById('categoryTabs');
    const wrapper = document.getElementById('cardsWrapper');

    if (tabsContainer && wrapper) {
      const tabs = tabsContainer.querySelectorAll<HTMLButtonElement>('.cat-tab');
      const highlight = document.getElementById('catHighlight');
      const cards = wrapper.querySelectorAll<HTMLElement>('.blog-card-ray');
      let activeTab = tabsContainer.querySelector<HTMLButtonElement>('.cat-tab.active');

      function updateHighlight(tab: HTMLButtonElement) {
        if (!highlight || !tabsContainer) return;
        const cr = tabsContainer.getBoundingClientRect();
        const tr = tab.getBoundingClientRect();
        highlight.style.width = `${tr.width}px`;
        highlight.style.transform = `translateX(${tr.left - cr.left + tabsContainer.scrollLeft}px)`;
      }

      if (activeTab) setTimeout(() => updateHighlight(activeTab!), 60);

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          activeTab = tab;
          updateHighlight(tab);

          const filter = tab.dataset.filter;
          cards.forEach(card => {
            const match = filter === 'All' || card.dataset.category === filter;
            card.classList.toggle('hidden', !match);
          });

          wrapper.scrollLeft = 0;
        });
      });

      tabsContainer.addEventListener('scroll', () => {
        if (activeTab) updateHighlight(activeTab);
      });
      window.addEventListener('resize', () => {
        if (activeTab) updateHighlight(activeTab);
      });
    }

    const prevBtn = document.getElementById('sliderPrev');
    const nextBtn = document.getElementById('sliderNext');
    const wrapper2 = document.getElementById('cardsWrapper');

    if (wrapper2 && prevBtn && nextBtn) {
      const getWidth = () => {
        const c = wrapper2.querySelector<HTMLElement>('.blog-card-ray:not(.hidden)');
        return c ? c.getBoundingClientRect().width + 24 : 400;
      };
      prevBtn.addEventListener('click', () => wrapper2.scrollBy({ left: -getWidth(), behavior: 'smooth' }));
      nextBtn.addEventListener('click', () => wrapper2.scrollBy({ left: getWidth(), behavior: 'smooth' }));
    }
  });
</script>
