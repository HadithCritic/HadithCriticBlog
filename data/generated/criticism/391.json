ع آخر فقال: كنيته أبو عامر، ويقال: أبو العباس، أصله من البصرة، سكن واسط، يروي عن سليمان التيمي، يروي عنه الواسطيون","citation":"لسان الميزان (4/ 21)","pageId":549460,"verdict":"tadil"}]},{"critic":"الأزدي","statements":[{"text":"وإنما قال الأزدي: عنده مناكير عن الشعبي","citation":"لسان الميزان (4/ 21)","pageId":549460,"verdict":"jarh"},{"text":"ذكره الأزدي وتكلم فيه","citation":"لسان الميزان (4/ 21)","pageId":549460,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19576":{"id":19576,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"له إدراك، لأن عمر قبل شهادته على قدامة ابن مظعون حين شرب الخمر، أخرجه ابن أبي شيبة من وجهين، وسيأتي ذكر القصة","citation":"الإصابة في تمييز الصحابة (8/ 171)","pageId":427845,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"له إدراك، لأن عمر قبل شهادته على قدامة ابن مظعون حين شرب الخمر، أخرجه ابن أبي شيبة من وجهين، وسيأتي ذكر القصة","citation":"الإصابة في تمييز الصحابة (8/ 171)","pageId":427845}]}],"flags":[]},"19578":{"id":19578,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"سمع عكرمة والشعبي. روى عنه أبو محمد الزبيري. ذكره البخاري وابن حبان في كتاب الثقات","citation":"إكمال تهذيب الكمال (9/ 120)","pageId":538605,"verdict":"tadil"}]},{"critic":"البخاري","statements":[{"text":"سمع عكرمة والشعبي. روى عنه أبو محمد الزبيري. ذكره البخاري وابن حبان في كتاب الثقات","citation":"إكمال تهذيب الكمال (9/ 120)","pageId":538605,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع الشعبي وعكرمة وسعيد بن جبير، روى عنه حفص بن غياث، وأبو أحمد الزبيري، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 13)","pageId":708073,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع عكرمة والشعبي. روى عنه أبو محمد الزبيري. ذكره البخاري وابن حبان في كتاب الثقات","citation":"إكمال تهذيب الكمال (9/ 120)","pageId":538605},{"text":"سمع الشعبي وعكرمة وسعيد بن جبير، روى عنه حفص بن غياث، وأبو أحمد الزبيري، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 13)","pageId":708073}]}],"flags":[]},"19579":{"id":19579,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"مستقيم الحديث، يعتبر حديثه من غير رواية النضر بن سلمة عنه","citation":"الثقات (8/ 4)","pageId":606861,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19581":{"id":19581,"criticCount":4,"statementCount":4,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات، فقال: عبيد بن باب الدوسي، مولى أبي هريرة، عن أبي هريرة، وعنه عبد الله بن عون، فأظنه هو","citation":"لسان الميزان (5/ 351)","pageId":553186,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن، قال: وسألت أبي عنه، فقال: مستور، لم يبلغنا عنه شيء إلا في ابنه عمرو","citation":"الجرح والتعديل لابن أبي حاتم (5/ 402)","pageId":702851,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"قال ابن معين ليس بشيء","citation":"لسان الميزان (5/ 351)","pageId":553186,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"قل ما روى","citation":"لسان الميزان (5/ 351)","pageId":553186,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19582":{"id":19582,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":4,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حزم","statements":[{"text":"قال ابن حزم: كان ثقة مكثرا، لم أزل أسمع أن سبب خروجه إلى المشرق، أنه خرجت بأنفه، أو ببعض جسده قرحة، فلم يجد لها مداويا، فخافها، فبادر إلى المشرق، فقيل: لها دواؤها بالهند، فوصل الهند، فأزالها طبيب هناك وشرط له إن برئت أن يقاسمه ماله. فلما عوفي أحضر له جميع ماله ليقاسمه، فقال له: والله، لا أرزؤك شيئا، وأخذ شيئا حسنا من آلة بيته. واشتغل في رجوعه بالعلم والحديث، فبرع","citation":"تاريخ الإسلام (8/ 130)","pageId":644353,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وكان شيخا جميلا ثقة صدوقا","citation":"تاريخ الإسلام (8/ 130)","pageId":644353,"verdict":"tadil"},{"text":"محدث الأندلس، ومسندها الثقة","citation":"سير أعلام النبلاء (16/ 68)","pageId":728357,"verdict":"tadil"},{"text":"وكان شيخا نبيلا، ثقة، معمرا","citation":"سير أعلام النبلاء (16/ 68)","pageId":728357,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19585":{"id":19585,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن الباجي عبد الله اللخمي","statements":[{"text":"قال أبو محمد الباجي: لم أدرك بقرطبة من الشيوخ أكثر حديثا منه","citation":"سير أعلام النبلاء (15/ 254)","pageId":727765,"verdict":"unclassified"},{"text":"قال أبو محمد الباجي: لم أدرك بقرطبة من الشيوخ أكثر حديثا منه، وكان عالما ثقة، بارعا في علم الوثائق","citation":"تاريخ الإسلام (7/ 540)","pageId":641549,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"قلت: كان عالما ثقة رأسا في الشروط، وعقد الوثائق","citation":"سير أعلام النبلاء (15/ 254)","pageId":727765,"verdict":"tadil"},{"text":"وكان صدوقا","citation":"تاريخ الإسلام (7/ 540)","pageId":641549,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19586":{"id":19586,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن عبد البر","statements":[{"text":"وعبيد الله ابنه مجهول","citation":"الإعلام بسنته عليه الصلاة والسلام بشرح سنن ابن ماجه الإمام (2/ 144)","pageId":373820,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19589":{"id":19589,"criticCount":2,"statementCount":5,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن الفرضي أبو الوليد القرطبي","statements":[{"text":"قال ابن الفرضي: لم ألق أحدا أفضله عليه في الضبط. سمعت منه الكثير بقرطبة، ورحلت إليه إلى إشبيلية مرتين ؛ سنة ثلاث وسبعين، وسنة أربع. وروى الناس عنه كثيرا، وسمع منه جماعة من أقرانه","citation":"تاريخ الإسلام (8/ 452)","pageId":646269,"verdict":"unclassified"},{"text":"قال ابن الفرضي: كان حافظا، ضابطا، لم ألق مثله في الضبط","citation":"سير أعلام النبلاء (16/ 377)","pageId":728808,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"العلامة الحافظ، محدث الأندلس","citation":"سير أعلام النبلاء (16/ 377)","pageId":728808,"verdict":"unclassified"},{"text":"وكان ضابطا حافظا متقنا، بصيرا بمعاني الحديث","citation":"تاريخ الإسلام (8/ 452)","pageId":646269,"verdict":"tadil"},{"text":"العلامة الحافظ","citation":"تاريخ الإسلام (8/ 452)","pageId":646269,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19591":{"id":19591,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"حدثنا عبد الرحمن قال: سألت أبي عنه فقال: هذا شيخ بصري مجهول لا أعلم أحدا، روى عنه غير محمد بن شعيب بن شابور، والوليد بن مزيد","citation":"الجرح والتعديل لابن أبي حاتم (8/ 127)","pageId":712973,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19592":{"id":19592,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سألت أبي عنه، فقال: مجهول","citation":"الجرح والتعديل لابن أبي حاتم (5/ 376)","pageId":702619,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19594":{"id":19594,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع معفس بن عمران بن حطان، روى عنه: وكيع، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 324)","pageId":711737,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع معفس بن عمران بن حطان، روى عنه: وكيع، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 324)","pageId":711737}]}],"flags":[]},"19595":{"id":19595,"criticCount":3,"stateme