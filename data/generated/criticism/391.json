{"19550":{"id":19550,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"وأثنى عليه خيرا. روى عنه: الربيع بن أنس، ومن الناس من يقول: الربيع بن أنس، عن أبي العالية، عن سويد، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (4/ 236)","pageId":696412,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19558":{"id":19558,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"البخاري","statements":[{"text":"قال البخاري: لا يتابع عليه","citation":"لسان الميزان (8/ 215)","pageId":559774,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"أورده العقيلي في \" الضعفاء \"، وأخرج له هذا الحديث من طريق عبد السلام المذكور","citation":"لسان الميزان (8/ 215)","pageId":559774,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19561":{"id":19561,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن، أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي، قال: قلت ليحيى بن معين: شيخا حدث عنه معتمر يقال له: أبو عبيدة، عن صالح الدهان، عن جابر بن زيد، من أبو عبيدة هذا ؟ قال: رجل يقال له: عبد الله بن القاسم، ليس به بأس","citation":"الجرح والتعديل لابن أبي حاتم (5/ 141)","pageId":700322,"verdict":"tadil"}]},{"critic":"علي ابن المديني","statements":[{"text":"قال ابن المديني: مجهول. نقلته من خط ابن عبد الهادي","citation":"لسان الميزان (4/ 544)","pageId":551727,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19563":{"id":19563,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال أبو حاتم: لا أعرفه","citation":"لسان الميزان (7/ 553)","pageId":558627,"verdict":"unclassified"},{"text":"روى عن كثير بن زياد عن الشعبي، روى عنه حماد بن سلمة، ونوح بن قيس سمعت أبي يقول ذلك، وسألته عنه فقال: لا أعرفه","citation":"الجرح والتعديل لابن أبي حاتم (8/ 109)","pageId":712779,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19565":{"id":19565,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع ابن عمر ومعاوية، روى عنه: إبراهيم بن عكرمة ونافع بن جبير، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 9)","pageId":708030,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع ابن عمر ومعاوية، روى عنه: إبراهيم بن عكرمة ونافع بن جبير، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 9)","pageId":708030}]}],"flags":[]},"19567":{"id":19567,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي المراسيل","citation":"الثقات (5/ 450)","pageId":594149,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"يروي المراسيل","citation":"الثقات (5/ 450)","pageId":594149}]}],"flags":["Sends Mursal Reports"]},"19568":{"id":19568,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن: أبيه، عن جده شداد بن أوس، روى عنه: إبراهيم بن محمد بن يوسف الفريابي نزيل بيت المقدس، سمعت أبي يقول ذلك، وسألته عنه فقال: محمد بن عبد الرحمن وأبوه لا يعرفان وحديثه، عن أبيه، عن جده شداد بن أوس منكر","citation":"الجرح والتعديل لابن أبي حاتم (7/ 315)","pageId":711646,"verdict":"unclassified"},{"text":"قال أبو حاتم الرازي: لا يعرف والخبر منكر","citation":"لسان الميزان (7/ 289)","pageId":557677,"verdict":"unclassified"}]},{"critic":"الأزدي","statements":[{"text":"قال الأزدي: كذاب متروك","citation":"لسان الميزان (7/ 289)","pageId":557677,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19571":{"id":19571,"criticCount":2,"statementCount":2,"tall