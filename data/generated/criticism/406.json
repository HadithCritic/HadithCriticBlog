م يرو عنه إلا يزيد بن هارون","citation":"الجرح والتعديل لابن أبي حاتم (6/ 48)","pageId":703524,"verdict":"unclassified"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبا زرعة فقال: لا أعرفه، حديثه الذي رواه في المسح حديث منكر","citation":"الجرح والتعديل لابن أبي حاتم (6/ 48)","pageId":703524,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20316":{"id":20316,"criticCount":2,"statementCount":3,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الأزدي","statements":[{"text":"قال أبو الفتح الأزدي كذاب","citation":"لسان الميزان (4/ 372)","pageId":551000,"verdict":"jarh"},{"text":"وهذا هو الذي نقله النباتي عن الأزدي، وزاد: ضعيف","citation":"لسان الميزان (4/ 372)","pageId":551000,"verdict":"jarh"}]},{"critic":"الحسيني","statements":[{"text":"وقرأت بخط الحسيني: مجهول","citation":"لسان الميزان (4/ 372)","pageId":551000,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20317":{"id":20317,"criticCount":4,"statementCount":6,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":4},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"وهو حراني، روى عن موسى بن أعين، وزهير بن معاوية وخليد بن دعلج قاله ابن أبي حاتم قال: وكتب عنه أبي بأذنة، وسئل عنه فقال: ليس بالمتين، روى أحاديث فيها صنعة","citation":"لسان الميزان (3/ 482)","pageId":549012,"verdict":"unclassified"},{"text":"حدثنا عبد الرحمن، قال: سئل أبي عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (3/ 499)","pageId":693023,"verdict":"unclassified"},{"text":"كتب عنه أبي بأذنة سنة عشرين ومائتين، وسألته عنه فقال: ليس بالمتقن، روى أحاديث فيها صنعة","citation":"الجرح والتعديل لابن أبي حاتم (3/ 499)","pageId":693023,"verdict":"jarh"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات","citation":"لسان الميزان (3/ 482)","pageId":549012,"verdict":"tadil"}]},{"critic":"ابن عدي","statements":[{"text":"وقال ابن عدي في ترجمة خليد بن دعلج عقب حديث أورده من رواية هذا، عن خليد: لعل البلاء فيه من الراوي عنه","citation":"لسان الميزان (3/ 482)","pageId":549012,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"وقال العقيلي بعد إيراد حديثه: الرواية في هذا لينة","citation":"لسان الميزان (3/ 482)","pageId":549012,"verdict":"unclassified"}]}],"phenomena":[{"key":"التضعيف الضمني","label":"Implicit Weakening","statements":[{"text":"وقال العقيلي بعد إيراد حديثه: الرواية في هذا لينة","citation":"لسان الميزان (3/ 482)","pageId":549012}]}],"flags":[]},"20321":{"id":20321,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن علي رضي الله عنه، روى عنه أبو بكر الزبيدي خال عبثر، سمعت أبي يقول ذلك، وسألته عنه فقال: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (6/ 345)","pageId":707089,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20324":{"id":20324,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"وهو بصري صاحب حديث لكنه راوية للموضوعات والعجائب","citation":"تاريخ الإسلام (8/ 243)","pageId":644996,"verdict":"unclassified"},{"text":"أحد الضعفاء","citation":"تاريخ الإسلام (8/ 243)","pageId":644996,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20325":{"id":20325,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"أبو بكر بن رجاء الزبيدي. سمع عاصم بن شريب. روى عنه: الثوري. سمعت (399 م 6) أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 342)","pageId":720087,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"أبو بكر بن رجاء الزبيدي. سمع عاصم بن شريب. روى عنه: الثوري. سمعت (399 م 6) أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 342)","pageId":720087}]}],"flags":[]},"20326":{"id":20326,"criticCount":3,"statementCount":5,"tally":{"jarh":4,"tadil":0,"mixed":1,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: [هو] مجهول","citation":"الجرح والتعديل لابن أبي حاتم (4/ 341)","pageId":697434,"verdict":"jarh"},{"text":"مجهول","citation":"لسان الميزان (4/ 248)","pageId":550457,"verdict":"jarh"}]},{"critic":"ابن حبان","statements":[{"text":"يعتبر بحديثه إذا لم يكن في إسناده ضعيف ولا بقية بن الوليد","citation":"الثقات (6/ 438)","pageId":599780,"verdict":"jarh"},{"text":"وقال ابن حبان في \" الثقات \": شعيب بن أبي الأشعث يروي عن نافع، عن ابن عمر. روى عنه محمد بن حمير، وشراحيل بن عبد الحميد، وأهل الشام، يعتبر حديثه إذا لم يكن في إسناده ضعيف، ولا بقية بن الوليد","citation":"لسان الميزان (4/ 248)","pageId":550457,"verdict":"mixed"}]},{"critic":"الأزدي","statements":[{"text":"وقال الأزدي: ليس بشيء","citation":"لسان الميزان (4/ 248)","pageId":550457,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20327":{"id":20327,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"أنا عبد الرحمن، سمعت أبي يقول ذلك، وسألته عنه فقال: شيخ مجهول","citation":"الجرح والتعديل لابن أبي حاتم (4/ 346)","pageId":697465,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20328":{"id":20328,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن، نا العباس بن محمد الدوري قال: سمعت يحيى بن معين يقول: شعيب بن درهم، ليس به بأس، وليس بأخي محمد بن درهم","citation":"الجرح والتعديل لابن أبي حاتم (4/ 344)","pageId":697456,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20329":{"id":20329,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ربما أخطأ. كذا ذكره ابن حبان في \" الثقات \"","citation":"لسان الميزان (4/ 239)","pageId":550402,"verdict":"tadil"},{"text":"وربما أخطأ، يعتبر حديثه من غير روايته عن صالح المري","citation":"الثقات (8/ 314)","pageId":610099,"v