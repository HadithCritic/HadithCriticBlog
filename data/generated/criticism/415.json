lags":[]},"20764":{"id":20764,"criticCount":6,"statementCount":7,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":6},"critics":[{"critic":"ابن عساكر","statements":[{"text":"وقال ابن عساكر أيضا: كان صحيح السماع ولد سنة سبع وثلاثين وقال مرة: لا أحفظ مولدي، غير أني أول ما سمعت سنة سبع وأربعين يعني وأربع ومائة","citation":"لسان الميزان (1/ 532)","pageId":543430,"verdict":"unclassified"},{"text":"وقال ابن عساكر: قال لي أبو العز بن كادش، وسمع رجلا قد وضع في حق علي حديثا: ووضعت أنا في حق أبي بكر حديثا، بالله أليس فعلت جيدا؟","citation":"لسان الميزان (1/ 532)","pageId":543430,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"مشهور من شيوخ ابن عساكر أقر بوضع حديث وتاب، وأناب","citation":"لسان الميزان (1/ 532)","pageId":543430,"verdict":"unclassified"}]},{"critic":"عبد الله بن عبد الرحمن البستنبان","statements":[{"text":"عبد الله بن عبد الرحمن الحربي. قال: وكان مخلطا كذابا لا يحتج بمثله وللأئمة فيه مقال","citation":"لسان الميزان (1/ 532)","pageId":543430,"verdict":"jarh"}]},{"critic":"إسماعيل بن عبد الله الشافعي","statements":[{"text":"وقال ابن الأنماطي: كان مخلطا","citation":"لسان الميزان (1/ 532)","pageId":543430,"verdict":"unclassified"}]},{"critic":"محمد بن ناصر السلامي","statements":[{"text":"وقال أبو سعد بن السمعاني: كان ابن ناصر يسيء القول فيه","citation":"لسان الميزان (1/ 532)","pageId":543430,"verdict":"unclassified"}]},{"critic":"محمد بن محمود ابن النجار البغدادي","statements":[{"text":"وقد ساق له ابن النجار نسبا إلى عتبة بن فرقد السلمي الصحابي، وقال: سمع الكثير بنفسه، وقرأ على المشايخ، وكتب بخطه، وكان يكتب خطا رديئا، وكان يفهم طرفا من علم الحديث، وقد خرج، وألف. سمع أقضى القضاة أبا الحسن الماوردي، وهو آخر من حدث عنه، وأبا الطيب الطبري، والجوهري وطبقتهم، وحدث بالكثير","citation":"لسان الميزان (1/ 532)","pageId":543430,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20765":{"id":20765,"criticCount":1,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"