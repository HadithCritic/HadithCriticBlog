1)","pageId":434300,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (11/ 471)","pageId":434300}]}],"flags":[]},"18824":{"id":18824,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"أدركته ولم أسمع منه، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (2/ 249)","pageId":685008,"verdict":"unclassified"},{"text":"قال أبو حاتم الرازي: أدركته ولم أكتب عنه","citation":"إكمال تهذيب الكمال (2/ 333)","pageId":532591,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"قال أبو حاتم الرازي: أدركته ولم أكتب عنه","citation":"إكمال تهذيب الكمال (2/ 333)","pageId":532591},{"text":"أدركته ولم أسمع منه، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (2/ 249)","pageId":685008}]}],"flags":[]},"18827":{"id":18827,"criticCount":4,"statementCount":6,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات، وقال: روى عنه عبد الله بن عمر بن أبان الجعفي، وكناه أبا سليمان","citation":"لسان الميزان (2/ 258)","pageId":545132,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وبعضهم قواه","citation":"لسان الميزان (2/ 258)","pageId":545132,"verdict":"jarh"}]},{"critic":"يحيى بن معين","statements":[{"text":"قال ابن معين: لا أعرفه","citation":"لسان الميزان (2/ 258)","pageId":545132,"verdict":"unclassified"},{"text":"حدثنا عبد الرحمن، أنا يعقوب بن إسحاق [الهروي] فيما كتب إلي، ثنا عثمان بن سعيد [الدارمي] قال: سألت يحيى بن معين قلت: أيوب بن واصل صاحب العدني تعرفه ؟ فقال: ما أعرفه","citation":"الجرح والتعديل لابن أبي حاتم (2/ 261)","pageId":685111,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"وقال ابن أبي حاتم: روى عنه إبراهيم بن المنذر، سألت أبي عنه فقال: يروى عنه","citation":"لسان الميزان (2/ 258)","pageId":545132,"verdict":"unclassified"},{"text":"سألت أبي عنه فقال: يروى عنه","citation":"الجرح والتعديل لابن أبي حاتم (2/ 261)","pageId":685111,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18831":{"id":18831,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: [هو] صدوق، ثقة، من نبلاء الرجال","citation":"الجرح والتعديل لابن أبي حاتم (9/ 278)","pageId":719324,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"18837":{"id":18837,"criticCount":3,"statementCount":4,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان: لا يجوز الاحتجاج به، وروى عنه عمرو بن حريث، كان يأتي بالشيء بعد الشيء على الوهم","citation":"لسان الميزان (2/ 270)","pageId":545195,"verdict":"unclassified"},{"text":"وأما ابن حبان فإن لفظه: يروي عن أنس وأبي الخليل أحاديث مناكير لا أصول لها يهم فيها ؛ لأن الحديث لم يكن من صناعته ؛ فكان يأتي بالشيء بعد الشيء على الوهم ؛ فلا يجوز الاحتجاج بخبره","citation":"لسان الميزان (2/ 270)","pageId":545195,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"له مناكير","citation":"لسان الميزان (2/ 270)","pageId":545195,"verdict":"jarh"}]},{"critic":"البخاري","statements":[{"text":"وقال البخاري: برذعة بن عبد الرحمن، عن أبي الخليل، عن سلمان عن النبي - صلى الله عليه وسلم -: \" سميت ابني باسم ابني هارون \". قاله لنا مالك بن إسماعيل، عن عمرو بن حريث، عن برذعة، إسناده مجهول، انتهى. وليس لبرذعة غير هذا الحديث","citation":"لسان الميزان (2/ 270)","pageId":545195,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"18839":{"id":18839,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \". وقال: يروي عن ابن الزبير، روى عنه سعيد بن زيد وأبو هلال الراسبي","citation":"لسان الميزان (6/ 146)","pageId":554595,"verdict":"tadil"}]},{"critic":"العقيلي","statements":[{"text":"وذكره العقيلي في الضعفاء وأرود له عن عروة عن عائشة مرفوعا: \" لا تسبوا تميما وضبة، فإنهما كانا مسلمين \". وعنه العلاء بن جرير. قال العقيلي: لا يتابع على حديثه ولا يعرف إلا به","citation":"لسان الميزان (6/ 146)","pageId":554595,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"ورد في إسناد مظلم، فيحرر أمره، والخبر باطل","citation":"لسان الميزان (6/ 146)","pageId":554595,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18841":{"id":18841,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"، وقال: روى عنه ابنه عبد الرحمن","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 828)","pageId":580282,"verdict":"tadil"}]},{"critic":"الحسيني","statements":[{"text":"قال الحسيني: محله الصدق","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 828)","pageId":580282,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18843":{"id":18843,"criticCount":3,"statementCount":6,"tally":{"jarh":2,"tadil":2,"mixed":2,"unclassified":0},"critics":[{"critic":"وكيع بن الجراح","statements":[{"text":"ثنا عبد الرحمن، قال: ذكره أبي قال: أنا محمود بن غيلان قال: سمعت وكيعا وسئل عن عبد الرحمن بن خضير، فقال: كان يروي عن أبي نجيح، وأبو نجيح المكي ثقة","citation":"الجرح والتعديل لابن أبي حاتم (5/ 230)","pageId":701211,"verdict":"tadil"},{"text":"وكيع وقواه","citation":"لسان الميزان (5/ 99)","pageId":552272,"verdict":"jarh"}]},{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن، قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين أنه قال: عبد الرحمن بن خضير الهلالي ثقة","citation":"الجرح والتعديل لابن أبي حاتم (5/ 230)","pageId":701211,"verdict":"tadil"},{"text":"ضعفه الفلاس، ومشاه غيره، فوثقه يحيى","citation":"لسان الميزان (5/ 99)","pageId":552272,"verdict":"mixed"}]},{"critic":"الفلاس","statements":[{"text":"نا عبد الرحمن، نا محمد بن إبراهيم، نا عمرو بن علي قال: عبد الرحمن بن خضير ضعيف","citation":"الجرح والتعديل لابن أبي حاتم (5/ 230)","pageId":701211,"verdict":"jarh"},{"text":"ضعفه الفلاس، ومشاه غيره، فوثقه يحيى","citation":"لسان الميزان (5/ 99)","pageId":552272,"verdict":"mixed"}]}],"phenomena":[],"flags":[]},"18846":{"id":18846,"criticCount":2,"statementCount":5,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"وأحسبه: ثبيت بن كثير، الذي روى عنه: يحيى بن عثمان بن سعيد بن كثير بن دينار العابد","citation":"الثقات (6/ 129)","pageId":596887,"verdict":"unclassified"},{"text":"شيخ","citation":"الثقات (6/ 129)","pageId":596887,"verdict":"unclassified"},{"text":"قال ابن حبان: منكر الحديث لا يجوز الاحتجاج بخبره","citation":"لسان الميزان (2/ 395)","pageId":545810,"verdict":"jarh"},{"text":"وذكره ابن حبان في \"الثقات\"","citation":"لسان الميزان (2/ 395)","pageId":545810,"verdict":"tadil"}]},{"critic":"ابن عدي","statements":[{"text":"وقال ابن عدي في ترجمة اليمان بن عدي: ثبيت غير معروف","citation":"لسان الميزان (2/ 395)","pageId":545810,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"18847":{"id":18847,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"ذكره ابن منده","citation":"الإصابة في تمييز الصحابة (1/ 322)","pageId":415057,"verdict":"unclassified"}]},{"critic":"أبو زرعة العراقي","statements":[{"text":"مختلف في صحبته","citation":"تحفة التحصيل في المراسيل (1/ 35)","pageId":679792,"verdict":"unclassified"}]},{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"وقال أبو نعيم: أظنه تابعيا","citation":"الإصابة في تمييز الصحابة (1/ 322)","pageId":415057,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"وقال أبو نعيم: أظنه تابعيا","citation":"الإصابة في تمييز الصحابة (1/ 322)","pageId":415057}]}],"flags":["Sends Mursal Reports"]}}