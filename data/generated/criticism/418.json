l":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"الشيخ الجليل المسند، شيخ الشيوخ","citation":"سير أعلام النبلاء (21/ 269)","pageId":732508,"verdict":"unclassified"},{"text":"وكان شيخ الشيوخ بأصبهان في زمانه","citation":"تاريخ الإسلام (12/ 1069)","pageId":665464,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20941":{"id":20941,"criticCount":3,"statementCount":4,"tally":{"jarh":1,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"أيوب السختياني","statements":[{"text":"وذكره العقيلي في الضعفاء، وكناه أبا عياض، وأن أيوب أنكر حديثه، فساق من طريق سلام بن أبي مطيع، قال: حدث رجل أيوب بحديث فأنكره فقال: من حدثك ؟ قال: محمد بن واسع، قال: ثقة، عمن ؟ قال: عن زيد بن عياض، قال: لا ترده","citation":"لسان الميزان (3/ 560)","pageId":549346,"verdict":"tadil"},{"text":"تكلم فيه أيوب السختياني","citation":"لسان الميزان (3/ 560)","pageId":549346,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"وذكره العقيلي في الضعفاء، وكناه أبا عياض، وأن أيوب أنكر حديثه، فساق من طريق سلام بن أبي مطيع، قال: حدث رجل أيوب بحديث فأنكره فقال: من حدثك ؟ قال: محمد بن واسع، قال: ثقة، عمن ؟ قال: عن زيد بن عياض، قال: لا ترده","citation":"لسان الميزان (3/ 560)","pageId":549346,"verdict":"tadil"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وقد ذكر ابن أبي حاتم زيدا مختصرا ولم يضعفه","citation":"لسان الميزان (3/ 560)","pageId":549346,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20943":{"id":20943,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"أحمد بن محمد العتيقي","statements":[{"text":"وقال العتيقي: حدث عن ابن مبشر الواسطي، وكان يذهب إلى الاعتزال، ثقة في الحديث","citation":"لسان الميزان (3/ 37)","pageId":547017,"verdict":"tadil"}]},{"critic":"البرقاني","statements":[{"text":"وقال البرقاني: كان معتزليا، وكان يتشيع، إلا أنه تبين أنه صدوق","citation":"لسان الميزان (3/ 37)","pageId":547017,"verdict":"tadil"}]},{"critic":"الحسين بن إسماعيل المحاملي","statements":[{"text":"عن القاضي المحاملي، سماعه صحيح، لكنه رافضي معتزلي، مات سنة 402، انتهى","citation":"لسان الميزان (3/ 37)","pageId":547017,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"20944":{"id":20944,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان صدوقا","citation":"تاريخ بغداد (2/ 118)","pageId":816620,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"قال الخطيب: حدثنا عنه الكتاني بدمشق، وكان صدوقا","citation":"تاريخ الإسلام (9/ 323)","pageId":650087,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20945":{"id":20945,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"علي ابن المديني","statements":[{"text":"قال ابن المديني: مجهول. روى عن سلمة بن سلامة بن وقش، ولا يدرى سمع منه أم لا لأنه لم يقل: سمعت","citation":"لسان الميزان (2/ 424)","pageId":545974,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"20949":{"id":20949,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"البخاري","statements":[{"text":"قال البخاري: له صحبة، وهو والد علقمة وبكر. كذا قال، وفرق غيره بين والد علقمة ووالد بكر، منهم أبو داود، وبه جزم ابن صاعد فيما حكاه ابن السكن، وقال البغوي: حدثنا علي بن الحسن، حدثنا أبو إسحاق الفزاري، عن حميد الطويل، عن بكر بن عبد الله المزني، قال: قال لي علقمة بن عبد الله المزني: غسل أباك أربعة من أصحاب بدر. (قلت) : وليس في هذا ما يثبت كون بكر أخا علقمة، ولا ما ينفيه، وروى ابن جرير من طريق أبي معشر، عن محمد بن كعب وغيره في تسمية البكائين، الذين أتوا النبي - صلى الله عليه وسلم - ليحملهم، فذكر منهم عبد الله بن عمرو المزني، وكذا ذكره ابن مردويه، من حديث مجمع بن جارية. (قلت) : وقد تقدم أن والد علقمة هو عبد الله بن سنان، فكأن صاحب هذه الترجمة هو والد بكر","citation":"الإصابة في تمييز الصحابة (6/ 316)","pageId":424670,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}