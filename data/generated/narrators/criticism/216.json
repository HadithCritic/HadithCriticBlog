unt":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن القطان الفاسي","statements":[{"text":"وقال ابن القطان: لا يعرف","citation":"لسان الميزان (7/ 241)","pageId":557518,"verdict":"unclassified"},{"text":"قال ابن القطان: لا يعرف","citation":"تهذيب التهذيب (3/ 605)","pageId":478649,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول الحال","citation":"تقريب التهذيب (1/ 861)","pageId":520480,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"10822":{"id":10822,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"ووهم من وحدهما","citation":"تقريب التهذيب (1/ 862)","pageId":520504,"verdict":"unclassified"},{"text":"ذكر صاحب \" الأطراف \" حديثه في ترجمة محمد بن علي بن عبد الله بن عباس، فوهم وهو عم ذاك","citation":"تهذيب التهذيب (3/ 607)","pageId":478669,"verdict":"unclassified"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 862)","pageId":520504,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10825":{"id":10825,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 613)","pageId":478706,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \"الثقات\"","citation":"تهذيب الكمال (25/ 533)","pageId":453752,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 864)","pageId":520542,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"ذكر صاحب \" الكمال \" أن الشيخين أخرجا له. قال المزي: لم أقف على رواية أحد منهما","citation":"تهذيب التهذيب (3/ 613)","pageId":478706,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10828":{"id":10828,"criticCount":6,"statementCount":6,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو الغنائم الهمذاني","statements":[{"text":"قال شيرويه في \" طبقات الهمذانيين \": كان أحد الثقات الصالحين يقال: إنه حج نيفا وأربعين حجة، وخمسا وأربعين غزاة، وكان من كبار النساك ببلدنا. ثم روى في \" مسنده \" عن أبي ميسرة محمد بن الحسين أنه قال: انشق محرابه ثاني يوم وفاته. قال شيرويه: وكان يحيى بن معين قد أخذ بركابه وهو يريد الركوب ببغداد، فقيل له في ذلك. فقال: ألا أفعل هذا برجل لا نراه إلا راحلا في طلب العلم أو واردا من غزو أو صادرا عن حج","citation":"تهذيب التهذيب (3/ 622)","pageId":478756,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق عابد","citation":"تقريب التهذيب (1/ 868)","pageId":520600,"verdict":"tadil"}]},{"critic":"الحافظ أبو شجاع شيرويه بن شهرذار الديلمي الهمذاني","statements":[{"text":"قال الحافظ أبو شجاع شيرويه بن شهرذار الديلمي الهمذاني في الطبقة الثانية من كتاب طبقات أهل همذان: محمد بن عبد الجبار القرشي، ويعرف بسندول، وهو أحد الثقات والصالحين يقال: حج نيفا وأربعين حجة، وخمسا وأربعين غزوة، وكان أبو نعيم إذا رآه قال: هذا الذي لا تجف له لبدة، إما حاج، وإما غازي، وكان من كبار التناء ببلدنا","citation":"تهذيب الكمال (25/ 585)","pageId":453806,"verdict":"tadil"}]},{"critic":"المزي","statements":[{"text":"ثقة جليل كبير المحل، وكان من كبار التناء بهمذان، وقيل: إنه صنف كتابا كبيرا","citation":"تهذيب الكمال (25/ 585)","pageId":453806,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"قال شيرويه في \" طبقات الهمذانيين \": كان أحد الثقات الصالحين يقال: إنه حج نيفا وأربعين حجة، وخمسا وأربعين غزاة، وكان من كبار النساك ببلدنا. ثم روى في \" مسنده \" عن أبي ميسرة محمد بن الحسين أنه قال: انشق محرابه ثاني يوم وفاته. قال شيرويه: وكان يحيى بن معين قد أخذ بركابه وهو يريد الركوب ببغداد، فقيل له في ذلك. فقال: ألا أفعل هذا برجل لا نراه إلا راحلا في طلب العلم أو واردا من غزو أو صادرا عن حج","citation":"تهذيب التهذيب (3/ 622)","pageId":478756,"verdict":"tadil"}]},{"critic":"الفضل بن دكين","statements":[{"text":"وكان أبو نعيم إذا رآه قال: هذا الذي لا تجف له لبدة إما حاج وإما غاز","citation":"تهذيب التهذيب (3/ 622)","pageId":478756,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10829":{"id":10829,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 868)","pageId":520602,"verdict":"unclassified"}]},{"critic":"الحاكم","statements":[{"text":"قال الحاكم: كان من وجوه نيسابور، ولما ورد الأصمعي نيسابور نزل داره","citation":"تهذيب التهذيب (3/ 622)","pageId":478758,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10830":{"id":10830,"criticCount":3,"statementCount":6,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال أبو حاتم: ما أرى بحديثه بأسا، محله الصدق","citation":"تهذيب الكمال (25/ 644)","pageId":453853,"verdict":"unclassified"},{"text":"روى عن: أبيه والمقبري، روى عنه: مروان الفزاري وأبو عامر العقدي، سمعت أبي يقول ذلك، ويقول: ما أرى بحديثه بأسا ومحله الصدق","citation":"الجرح والتعديل لابن أبي حاتم (7/ 319)","pageId":711693,"verdict":"unclassified"},{"text":"قال أبو حاتم: ما أرى بحديثه بأسا محله الصدق","citation":"تهذيب التهذيب (3/ 630)","pageId":478802,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 630)","pageId":478802,"verdict":"tadil"},{"text":"وذكره ابن حبان في كتاب \"الثقات\"","citation":"تهذيب الكمال (25/ 644)","pageId":453853,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 871)","pageId":520654,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"10831":{"id":10831,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 872)","pageId":520666,"verdict":"jarh"},{"text":"وعنه: مجاهد، وقيل: عن مجاهد عن عبد الله بن عبد الرحمن، وقيل: عن مجاهد، عن ابن أبي ذباب غير مسمى، وفيه اختلاف كثير على مجاهد","citation":"تهذيب التهذيب (3/ 631)","pageId":478816,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وعنه مجاهد: \" لا يدخل الجنة ولد زنا \"، لم يصح","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 155)","pageId":500225,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10832":{"id":10832,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 873)","pageId":520684,"verdict":"tadil"}]},{"critic":"مسلمة بن القاسم","statements":[{"text":"قال مسلمة بن قاسم: لا بأس به","citation":"تهذيب التهذيب (3/ 633)","pageId":478828,"verdict":"tadil"}]},{"critic":"النسائي","statements":[{"text":"وقال حمزة الكناني: سألت النسائي عنه، فقال: كتبت عنه شيئا يسيرا، ولم أخرج عنه إلا حديثا واحدا في الصلاة. قلت: ما حاله ؟ قال: لا أدري","citation":"تهذيب التهذيب (3/ 633)","pageId":478828,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10833":{"id":10833,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 634)","pageId":478838,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (26/ 21)","pageId":453890,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"وعنه روح بن عبادة فقط","citation":"لسان الميزان (9/ 411)","pageId":571182,"verdict":"unclassified"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 873)","pageId":520692,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"قال الذهبي: لا يعرف","citation":"تهذيب التهذيب (3/ 634)","pageId":478838,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10834":{"id":10834,"criticCount":4,"statementCount":7,"tally":{"jarh":1,"tadil":2,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"، وقال: يعتبر حديثه إذا بين السماع، فإنه كان مدلسا","citation":"تهذيب التهذيب (3/ 635)","pageId":47884