mentCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وفي الثقات لابن حبان: بشر بن قيس التغلبي، روى عن عمر بن الخطاب، وعنه زياد بن علاقة، فالظاهر أنه هو هذا. ثم ذكر ابن حبان في أتباع التابعين من الثقات: بشر بن قيس التغلبي، روى عن أبيه عن سهل ابن الحنظلية، وعنه هشام بن سعد. كذا قال، والظاهر أن شيخ هشام بن سعد هو قيس بن بشر بن قيس، لكن قال البخاري في تاريخه: بشر سمع أبا الدرداء وابن الحنظلية، قاله لنا أبو نعيم عن هشام بن سعد عن قيس بن بشر، سمع أباه، وكان جليسا لأبي الدرداء. وهكذا أخرجه أبو داود من طريق أبي عامر العقدي عن هشام بن سعد. وكذلك أخرجه الطبراني عن علي بن عبد العزيز عن أبي نعيم، فالله أعلم","citation":"تهذيب التهذيب (1/ 230)","pageId":465608,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 170)","pageId":508264,"verdict":"tadil"}]},{"critic":"مغلطاي","statements":[{"text":"كذا نسبه المزي إيهاما منه، فيقال: لم أر في هذه الطبقة عند البخاري وابن أبي حاتم وابن حبان في كتاب « الثقات » منسوبا من اسمه بشر بن قيس وينسب تغلبيا غير واحد عرفوه بروايته عن عمر بن الخطاب، وأن زياد ابن علاقة روى عنه، والله أعلم. ولم يذكر المزي هذين في ترجمته","citation":"إكمال تهذيب الكمال (2/ 408)","pageId":532794,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"948":{"id":948,"criticCount":5,"statementCount":6,"tally":{"jarh":1,"tadil":2,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"كذا قال ابن حبان في الثقات","citation":"تهذيب التهذيب (1/ 233)","pageId":465632,"verdict":"tadil"},{"text":"وفي كتاب « الثقات » لابن حبان: بشر بن دينار يروي عن أنس، وروى عنه ليث بن أبي سليم ومحمد بن عثمان","citation":"إكمال تهذيب الكمال (2/ 415)","pageId":532818,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 171)","pageId":508288,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"لا شيء","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 165)","pageId":491025,"verdict":"unclassified"}]},{"critic":"مغلطاي","statements":[{"text":"وقول من قال من المتأخرين لا يعرف قصور منه كعادته","citation":"إكمال تهذيب الكمال (2/ 415)","pageId":532818,"verdict":"unclassified"}]},{"critic":"الحاكم","statements":[{"text":"وخرج الحاكم حديثه في « صحيحه »","citation":"إكمال تهذيب الكمال (2/ 415)","pageId":532818,"verdict":"unclassified"}]}],"phenomena":[{"key":"التوثيق الضمني","label":"Implicit Authentication","statements":[{"text":"وخرج الحاكم حديثه في « صحيحه »","citation":"إكمال تهذيب الكمال (2/ 415)","pageId":532818}]}],"flags":[]}}