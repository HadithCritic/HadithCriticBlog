dict":"jarh"}]}],"phenomena":[],"flags":[]},"628":{"id":628,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":1,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قلت: ذكره ابن حبان في الثقات في أتباع التابعين فقال إسماعيل مولى عبد الله بن عمرو بن العاص. روى عنه إبراهيم بن المهاجر قوله فكأنه لم يقف على هذا الحديث الذي رواه إبراهيم عنه مسندا","citation":"تهذيب التهذيب (1/ 171)","pageId":465099,"verdict":"mixed"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 145)","pageId":507804,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف، تفرد عنه إبراهيم بن مهاجر","citation":"لسان الميزان (9/ 261)","pageId":566350,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"631":{"id":631,"criticCount":5,"statementCount":6,"tally":{"jarh":2,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في الثقات. وقال: مات في ربيع الأول سنة (194)","citation":"تهذيب التهذيب (1/ 142)","pageId":464909,"verdict":"tadil"},{"text":"ذكره أبو حاتم بن حبان في كتاب \" الثقات \". وقال: مات في ربيع الأول سنة أربع وتسعين ومائة","citation":"تهذيب الكمال (3/ 37)","pageId":441416,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"ثقة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 112)","pageId":490516,"verdict":"tadil"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: ليس لحديثه أصل","citation":"إكمال تهذيب الكمال (2/ 151)","pageId":532200,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"لين الحديث","citation":"تقريب التهذيب (1/ 136)","pageId":507630,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"وقال المزي: روى عنه بكر بن أحمد بن مقبل الحافظ البصري، وفيه نظر، لأن ابن قانع وغيره ذكروا أن بكرا هذا توفي سنة أربع وثلاثمائة، وإسماعيل حكى المزي وفاته سنة أربع وتسعين ومائة، فعلى هذا تبعد روايته عنه مشافهة، والله أعلم","citation":"إكمال تهذيب الكمال (2/ 151)","pageId":532200,"verdict":"jarh"}]