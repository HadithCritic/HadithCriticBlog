{"16600":{"id":16600,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"ورأيت له تصانيف، منها: كتاب الاحتراف، ذكر فيه أحاديث وآثارا في فضائل التجارة لا أصل لها","citation":"لسان الميزان (1/ 472)","pageId":543217,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16601":{"id":16601,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال ابن السمعاني: هو ثقة، مكثر","citation":"تاريخ الإسلام (11/ 717)","pageId":659782,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16602":{"id":16602,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"وقال أبو نعيم: يروي عن سهل بن عثمان وعمرو بن علي، حدث بمناكير. منها: عن عمرو بن علي، عن ابن مهدي، عن مالك، عن نافع، عن ابن عمر قال: قال عمر: يا نبي الله ما لك أفصحنا ؟ فقال: \" جاءني جبريل فلقنني لغة أبي: إسماعيل \"","citation":"لسان الميزان (1/ 691)","pageId":544034,"verdict":"jarh"}]},{"critic":"ابن مردويه","statements":[{"text":"تكلم فيه بن مردويه","citation":"لسان الميزان (1/ 691)","pageId":544034,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"له ما ينكر","citation":"لسان الميزان (1/ 691)","pageId":544034,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16603":{"id":16603,"criticCount":3,"statementCount":6,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":6},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"قال السمعاني في \" الأنساب \" كان شيخا صالحا عابدا معمرا، رحل إليه من البلاد","citation":"سير أعلام النبلاء (19/ 246)","pageId":731019,"verdict":"unclassified"},{"text":"قال السمعاني في كتاب الأنساب: كان صالحا، عابدا، معمرا، رحل إليه من البلاد، وسمع الحيري، والصيرفي، وعبد القاهر بن طاهر، ومحمد بن إبراهيم المزكي، وقد دخل أصبهان، وسمع بها من ابن ريذة، وأبي طاهر بن عبد الرحيم. أحضرني والدي مجلسه، وكان أبوه يروي عن المخلص، وهو فقد أجاز لمن شاء الرواية عنه. وهو من قرية كونابذ، ثم عربت، فقيل: جنابذ، بفتح الباء، وهي من قهستان من رساتيق نيسابور. وكان صالحا، عفيفا، يتجر إلى البلاد مضاربة بأموال الناس، ثم عجز، وانقطع لتسميع الحديث، وكان مكثرا","citation":"تاريخ الإسلام (11/ 136)","pageId":657033,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"الشيخ الصالح، العابد المعمر، مسند العصر","citation":"سير أعلام النبلاء (19/ 246)","pageId":731019,"verdict":"unclassified"},{"text":"وانقطع لتسميع الحديث، وكان مكثرا، ألحق الأحفاد بالأجداد، وبعد صيته، وسمع منه من دب ودرج، ولم تتغير حواسه، بل ضعف بصره","citation":"سير أعلام النبلاء (19/ 246)","pageId":731019,"verdict":"unclassified"}]},{"critic":"رضوان الأصبهاني","statements":[{"text":"قال الفضل بن عبد الواحد الأصبهاني: سمعت الرئيس الثقفي يقول: لا جاء الله من خراسان بأحد إلا بأبي بكر الشيرويي ؛ فإنه أخيرهم وأنفعهم","citation":"تاريخ الإسلام (11/ 136)","pageId":657033,"verdict":"unclassified"},{"text":"قال الفضل بن عبد الواحد الأصبهاني: سمعت الرئيس الثقفي يقول: لا جاء الله من خراسان بأحد إلا بأبي بكر الشيروي، فإنه أخيرهم، وأنفعهم","citation":"سير أعلام النبلاء (19/ 246)","pageId":731019,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16605":{"id":16605,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان صدوقا","citation":"تاريخ بغداد (7/ 286)","pageId":823235,"verdict":"tadil"}]},{"critic":"عسكر بن الحصين النخشبي","statements":[{"text":"عن أبي تراب أنه قال: إسماعيل السكري درة لا يزيده مرور الأيام عليه إلا نورا","citation":"تاريخ بغداد (7/ 286)","pageId":823235,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16607":{"id":16607,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الخليلي","statements":[{"text":"قال أبو يعلى الخليلي: هو عالم حافظ، له مصنفات","citation":"سير أعلام النبلاء (13/ 349)","pageId":726620,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"المحدث العالم المصنف","citation":"سير أعلام النبلاء (13/ 349)","pageId":726620,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16611":{"id":16611,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"محمد بن يوسف المهلبي","statements":[{"text":"وقال: ابن مسدي: في ثامن صفر. وقال: كان ذا عناية بالرواية","citation":"تاريخ الإسلام (13/ 206)","pageId":667067,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16613":{"id":16613,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"أحد العباد المشهورين بطلب العلم، المنفقين مالهم على الحديث","citation":"تاريخ الإسلام (7/ 589)","pageId":641813,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16615":{"id":16615,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"الذهبى","statements":[{"text":"الإمام الصالح، معيد الأمينية","citation":"سير أعلام النبلاء (21/ 196)","pageId":732418,"verdict":"unclassified"},{"text":"الفقيه","citation":"تاريخ الإسلام (12/ 834)","pageId":664492,"verdict":"unclassified"}]},{"critic":"عمر بن محمد الأميني","statements":[{"text":"قال ابن الحاجب: وكان فقيها، عدلا، صالحا، يقرأ كل يوم وليلة ختمة","citation":"تاريخ الإسلام (12/ 834)","pageId":664492,"verdict":"unclassified"},{"text":"قال ابن الحاجب: كان فقيها عدلا صالحا، يتلو كل يوم وليلة ختمة","citation":"سير أعلام النبلاء (21/ 196)","pageId":732418,"verdict":"unclassified"}]},{"critic":"محمد بن علي الصابوني","statements":[{"text":"وأنبأني أبو حامد ابن الصابوني أن أبا محمد ابن الخرقي أعاد مدة بالأمينية لجمال الإسلام أبي الحسن السلمي، وكان من جلة العدول بدمشق، وأضر في الآخر وأقعد، فاحتاج ليلة إلى الوضوء، ولم يكن عنده في البيت أحد. فذكر عنه أنه قال: فبينا أنا أتفكر إذا بنور من السماء دخل البيت، فبصرت بالماء فتوضأت، حدث بذلك بعض إخوانه، وأوصاه أن لا يخبر بها إلا بعد موته","citation":"تاريخ الإسلام (12/ 834)","pageId":664492,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16616":{"id":16616,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"الصالح","citation":"تاريخ الإسلام (13/ 240)","pageId":667246,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16617":{"id":16617,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"مستقيم الأمر في الحديث","citation":"الثقات (8/ 307)","pageId":610024,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16619":{"id":16619,"criticCount":3,"statementCount":6,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":6},"critics":[{"critic":"الذهبى","statements":[{"text":"الشيخ الصالح المحدث","citation":"سير أعلام النبلاء (19/ 235)","pageId":731001,"verdict":"unclassified"},{"text":"شيخ صالح بغدادي من بيت الحديث","citation":"تاريخ الإسلام (10/ 829)","pageId":656317,"verdict":"unclassified"}]},{"critic":"عبد الوهاب الأنماطي","statements":[{"text":"أثنى عليه عبد الوهاب الأنماطي","citation":"سير أعلام النبلاء (19/ 235)","pageId":731001,"verdict":"unclassified"},{"text":"أثنى عليه عبد الوهاب الأنماطي","citation":"تاريخ الإسلام (10/ 829)","pageId":656317,"verdict":"unclassified"}]},{"critic":"محمد بن ناصر السلامي","statements":[{"text":"وقال ابن ناصر: كان كثير البكاء من خشية الله","citation":"تاريخ الإسلام (10/ 829)","pageId":656317,"verdict":"unclassified"},{"text":"وقال ابن ناصر: كان كثير البكاء من خشية الله","citation":"سير أعلام النبلاء (19/ 235)","pageId":731001,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16626":{"id":16626,"criticCount":2,"statementCount":6,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":3},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"قال الخطيب كتبت عنه، وكان ثقة صالحا","citation":"سير أعلام النبلاء (18/ 48)","pageId":730091,"verdict":"tadil"},{"text":"قال الخطيب: كتبت عنه، وكان ثقة صالحا","citation":"تاريخ الإسلام (10/ 23)","pageId":652635,"verdict":"tadil"},{"text":"كتبت عنه وكان ثقة دينا صالحا","citation":"تاريخ بغداد (4/ 179)","pageId":819269,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وكان أبو طالب خيرا زاهدا، عالما فقيها، واسع الرواية صحب أبا عبد الله بن بطة، وأبا عبد الله بن حامد. وتفقه لأحمد","citation":"تاريخ الإسلام (10/ 23)","pageId":652635,"verdict":"unclassified"},{"text":"وقد أدخل في سماعه ما لم يتفطن له","citation":"سير أعلام النبلاء (18/ 48)","pageId":730091,"verdict":"unclassified"},{"text":"قلت: قد كان أبو طالب فقيها، عالما، زاهدا، خيرا، مكثرا، صحب أبا عبد الله بن بطة، وأبا عبد الله بن حامد، وتفقه لأحمد","citation":"سير أعلام النبلاء (18/ 48)","pageId":730091,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16627":{"id":16627,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"أحد العباد ببلده","citation":"تاريخ الإسلام (8/ 668)","pageId":647463,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16628":{"id":16628,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"الشيخ الصدوق","citation":"سير أعلام النبلاء (16/ 402)","pageId":728852,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"16631":{"id":16631,"criticCount":1,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان شيخا صالحا، صحيح السماع","citation":"تاريخ الإسلام (11/ 39)","pageId":656547,"verdict":"unclassified"},{"text":"الشيخ الصالح المعمر الصدوق","citation":"سير أعلام النبلاء (19/ 240)","pageId":731009,"verdict":"tadil"},{"text":"سمع أبا علي بن شاذان، وأبا الحسن بن مخلد البزاز، وسماعه صحيح","citation":"سير أعلام النبلاء (19/ 240)","pageId":731009,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16634":{"id":16634,"criticCount":4,"statementCount":6,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":6},"critics":[{"critic":"أبو سعد السمعاني","statements":[{"text":"وقال أبو سعد السمعاني: هو إمام بارع مبرز، جامع لأنواع الفضل من العلوم، وكان سديد السيرة، مكثرا من الحديث","citation":"سير أعلام النبلاء (20/ 337)","pageId":731930,"verdict":"unclassified"},{"text":"وقال ابن السمعاني: إمام بارع، مبرز، جامع لأنواع الفضل من العلوم الشرعية، وكان سديد السيرة، مكثرا من الحديث. توفي يوم عيد الأضحى","citation":"تاريخ الإسلام (12/ 72)","pageId":661582,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"الإمام العلامة القدوة","citation":"سير أعلام النبلاء (20/ 337)","pageId":731930,"verdict":"unclassified"}]},{"critic":"القاسم بن عبد الله ابن الصفار النيسابوري","statements":[{"text":"قال حفيده القاسم: كان جدي نظيرا لمحمد بن يحيى، وكان يزيد على ابن يحيى بعلم الأصلين","citation":"تاريخ الإسلام (12/ 72)","pageId":661582,"verdict":"unclassified"},{"text":"قال حفيده القاسم: كان جدي نظيرا لمحمد بن يحيى الفقيه وكان يزيد عليه بمعرفة الأصلين","citation":"سير أعلام النبلاء (20/ 337)","pageId":731930,"verdict":"unclassified"}]},{"critic":"عبد الغافر بن إسماعيل الفارسي","statements":[{"text":"وقال عبد الغافر في \" تاريخه \": شاب فاضل دين ورع، أحد وجوه الفقهاء","citation":"سير أعلام النبلاء (20/ 337)","pageId":731930,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16635":{"id":16635,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال أبو حاتم: من عتق الشيعة","citation":"لسان الميزان (8/ 273)","pageId":560034,"verdict":"unclassified"}]},{"critic":"ابن قانع","statements":[{"text":"ضعفه ابن قانع","citation":"لسان الميزان (8/ 273)","pageId":560034,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"16642":{"id":16642,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن عساكر","statements":[{"text":"لينه الحافظ أبو القاسم الدمشقي","citation":"لسان الميزان (6/ 54)","pageId":554271,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16643":{"id":16643,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"رأى عمر","citation":"الثقات (5/ 568)","pageId":595397,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"رأى عمر. روى عنه: محمد بن إسحاق. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 410)","pageId":721008,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"رأى عمر","citation":"الثقات (5/ 568)","pageId":595397},{"text":"رأى عمر. روى عنه: محمد بن إسحاق. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 410)","pageId":721008}]}],"flags":[]},"16644":{"id":16644,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وكان من عباد الله الصالحين. يتكلم بالحكمة","citation":"الجرح والتعديل لابن أبي حاتم (2/ 300)","pageId":685490,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"16647":{"id":16647,"criticCount":4,"statementCount":5,"tally":{"jarh":1,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سئل أبي عنه فقال: ثقة","citation":"الجرح والتعديل لابن أبي حاتم (7/ 195)","pageId":710349,"verdict":"tadil"},{"text":"وذكره ابن أبي حاتم فكناه أبا زهير، وذكر له عدة مشايخ، وقال: كان رفيق أبي في الرحلة، وقال أبي: هو ثقة. قلت: وهو أعلى إسنادا من أبي حاتم، فإنه روى عن يحيى القطان وطبقته","citation":"لسان الميزان (6/ 551)","pageId":556388,"verdict":"tadil"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات","citation":"لسان الميزان (6/ 551)","pageId":556388,"verdict":"tadil"}]},{"critic":"الأزدي","statements":[{"text":"ذكره الأزدي، وقال: فيه نظر","citation":"لسان الميزان (6/ 551)","pageId":556388,"verdict":"jarh"}]},{"critic":"البخاري","statements":[{"text":"ولم يذكر البخاري فيه جرحا","citation":"لسان الميزان (6/ 551)","pageId":556388,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}