s":[]},"187":{"id":187,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1163)","pageId":526253,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"188":{"id":188,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"لا يدرى من هو","citation":"لسان الميزان (9/ 99)","pageId":562681,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"189":{"id":189,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات","citation":"تهذيب التهذيب (4/ 541)","pageId":484553,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (33/ 430)","pageId":459179,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1163)","pageId":526259,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"ثقة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 65)","pageId":504141,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"190":{"id":190,"criticCount":4,"statementCount":4,"tally":{"jarh":2,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1177)","pageId":526557,"verdict":"unclassified"}]},{"critic":"العجلي","statements":[{"text":"وقال العجلي: أبو العجلان المحاربي شامي تابعي ثقة","citation":"تهذيب التهذيب (4/ 555)","pageId":484876,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"مجهول","citation":"لسان الميزان (9/ 476)","pageId":573160,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"وروى الترمذي عن هناد بن السري، عن علي بن مسهر، عن الفضل بن يزيد الثمالي، عن أبي المخارق، عن ابن عمر، عن النبي صلى الله عليه وسلم قال: \" إن الكافر ليسحب لسانه الفرسخ والفرسخين يتوطؤه الناس \". هكذا قال، وهو خطأ. رواه منجاب بن الحارث عن علي بن مسهر، عن الفضل بن يزيد، عن أبي العجلان المحاربي، عن ابن عمر. وكذلك رواه أبو عقيل الثقفي، ومروان بن معاوية الفزاري، عن الفضل بن يزيد، وهو الصواب. والخطأ في ذلك إما من الترمذي وإما من شيخه، والله أعلم","citation":"تهذيب الكمال (34/ 81)","pageId":459463,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"191":{"id":191,"criticCount":4,"statementCount":6,"tally":{"jarh":3,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: تبع ابن ماكولا أبا حاتم في تسميته تبيعا، وسماه البخاري منيعا، بميم ثم نون. قال يوسف بن خليل الحافظ: هذا مما وهم فيه أبو حاتم وابنه، وتبعه ابن ماكولا، والصواب ما قال البخاري، وتبعه ابن حبان في \" الثقات \" والناس","citation":"تهذيب التهذيب (1/ 257)","pageId":465835,"verdict":"tadil"},{"text":"مجهول","citation":"تقريب التهذيب (1/ 1177)","pageId":526559,"verdict":"jarh"},{"text":"مجهول","citation":"تقريب التهذيب (1/ 181)","pageId":508477,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"وقرأت بخط الذهبي: فيه جهالة","citation":"تهذيب التهذيب (1/ 257)","pageId":465835,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"ورواه ابن ماجه، عن علي بن محمد، عن وكيع، عن مسعر، عن أبي مرزوق، عن أبي العدبس، عن أبي أمامة هكذا. قال: وهو خطأ، والصواب الأول، ووقع في بعض النسخ المتأخرة من كتاب ابن ماجه: عن مسعر، عن أبي مرزوق، عن أبي وائل (م)، عن أبي أمامة، وهو خطأ أيضا","citation":"تهذيب الكمال (4/ 308)","pageId":442217,"verdict":"jarh"}]},{"critic":"ابن حبان","statements":[{"text":"قلت: تبع ابن ماكولا أبا حاتم في تسميته تبيعا، وسماه البخاري منيعا، بميم ثم نون. قال يوسف بن خليل الحافظ: هذا مما وهم فيه أبو حاتم وابنه، وتبعه ابن ماكولا، والصواب ما قال البخاري، وتبعه ابن حبان في \" الثقات \" والناس","citation":"تهذيب التهذيب (1/ 257)","pageId":465835,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"192":{"id":192,"criticCount":3,"statementCount":7,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":6},"critics":[{"critic":"ابن حجر","statements":[{"text":"روى عطاء الخراساني عنه أنه استفتى رسول الله صلى الله عليه وآله وسلم في حجة كانت على أبيه. قلت: عطاء الخراساني لم يسمع من هذا الصحابي، ولعله حمل الحديث عن بعض أصحاب ابن عباس، عن أبي الغوث بن حصين بن عوف قال: قلت: يا رسول الله، إن أبي أدركه الحج الحديث","citation":"تهذيب التهذيب (4/ 572)","pageId":485170,"verdict":"tadil"},{"text":"روى عنه عطاء الخراساني، ولم يسمع منه","citation":"الإصابة في تمييز الصحابة (12/ 516)","pageId":436333,"verdict":"unclassified"},{"text":"ولم يسمع منه","citation":"تقريب التهذيب (1/ 1189)","pageId":526826,"verdict":"unclassified"},{"text":"صحابي","citation":"تقريب التهذيب (1/ 1189)","pageId":526826,"verdict":"unclassified"},{"text":"له صحبة","citation":"تهذيب التهذيب (4/ 572)","pageId":485170,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"صحابي","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 92)","pageId":504523,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"له صحبة","citation":"تهذيب الكمال (34/ 180)","pageId":459722,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"روى عنه عطاء الخراساني، ولم يسمع منه","citation":"الإصابة في تمييز الصحابة (12/ 516)","pageId":436333},{"text":"روى عطاء الخراساني عنه أنه استفتى رسول الله صلى الله عليه وآله وسلم في حجة كانت على أبيه. قلت: عطاء الخراساني لم يسمع من هذا الصحابي، ولعله حمل الحديث عن بعض أصحاب ابن عباس، عن أبي الغوث بن حصين بن عوف قال: قلت: يا رسول الله، إن أبي أدركه الحج الحديث","citation":"تهذيب التهذيب (4/ 572)","pageId":485170},{"text":"ولم يسمع منه","citation":"تقريب التهذيب (1/ 1189)","pageId":526826}]}],"flags":["Sends Mursal Reports"]},"193":{"id":193,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1191)","pageId":526857,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"194":{"id":194,"criticCount":2,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن القطان الفاسي","statements":[{"text":"قال أبو الحسن القطان: مجهول","citation":"تهذيب التهذيب (4/ 573)","pageId":485202,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1191)","pageId":526855,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"199":{"id":199,"criticCount":5,"statementCount":6,"tally":{"jarh":1,"tadil":3,"mixed":1,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (34/ 305)","pageId":460049,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 590)","pageId":485559,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 114)","pageId":504772,"verdict":"tadil"}]},{"critic":"الطحاوي","statements":[{"text":"وهذا الحديث إنما رجع إلى أبي المعتمر الذي لا يعرف ولا يدرى من هو، ولا سمعنا له ذكرا إلا في هذا الحديث، ومن هذه سبيله فليس ممن يجوز أن يحتج به في هذا المعنى، مع أنه لو كان ثابتا لكان حديث الزهري، عن أبي بكر، عن أبي هريرة أولى منه، لأنه قد روته الأئمة الذين تقوم الحجة برواياتهم، والذين لا يجب أن يعارض ما رووا بمثل ما روى أبو المعتمر الذي لا يعرف ولا يدرى من هو، ولو تدبر حديث أبي المعتمر لوقف على أن لا حجة فيه، لأن فيه: أيما رجل أفلس أو مات، فقد يحتمل أن يكون ذلك على الشك، فيعود الحديث إلى أن لا يدرى ما فيه مما ذكر عن النبي صلى الله عليه وسلم، هل هو في التفليس أو في الموت، وما وجدنا أحدا من أهل العلم أخذ بكل ما في هذا الحديث، إلا مالك بن أنس، فأما من سواه فقد ذكرنا أقوالهم في هذا الباب، ونسأل الله التوفيق","citation":"شرح مشكل الآثار (12/ 22)","pageId":295273,"verdict":"mixed"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول الحال","citation":"تقريب التهذيب (1/ 1207)","pageId":527181,"verdict":"jarh"}]},{"critic":"ابن عبد البر","statements":[{"text":"وقال ابن عبد البر: ليس بمعروف بحمل العلم","citation":"تهذيب التهذيب (4/ 590)","pageId":485559,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}