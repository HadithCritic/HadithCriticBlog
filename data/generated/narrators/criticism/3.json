{"150":{"id":150,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"صحابي","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 149)","pageId":505374,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"151":{"id":151,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا يعرف","citation":"تقريب التهذيب (1/ 1252)","pageId":528161,"verdict":"unclassified"},{"text":"قلت: فيه اضطراب شديد","citation":"تهذيب التهذيب (4/ 619)","pageId":486582,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"لم يسم","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 149)","pageId":505386,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"152":{"id":152,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"كأن اسمه محمد، فإن يعقوب بن محمد الزهري روى عن عبد الرحمن بن محمد بن عمر بن أبي سلمة عن أبيه عن جده أحاديث","citation":"تهذيب التهذيب (4/ 620)","pageId":486656,"verdict":"unclassified"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 1255)","pageId":528235,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"روى يعقوب بن محمد بن عيسى الزهري، عن عبد الرحمن بن محمد بن عمر بن أبي سلمة، عن أبيه، عن جده أحاديث، فيحتمل أن يكون هذا، والله أعلم","citation":"تهذيب الكمال (34/ 464)","pageId":461057,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"153":{"id":153,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1270)","pageId":528560,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف، روى عنه أبو بكر بن عياش، وبنو وهب عبد الله وعبد الرحمن وأيوب ؛ ليسوا بالمشهورين","citation":"لسان الميزان (9/ 236)","pageId":565650,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"ذكر يحيى بن معين، وغيره أن لوهب بن منبه ابنين: أحدهما عبد الله وهو الأكبر، والآخر عبد الرحمن وهو الأصغر. أما عبد الله فقد تقدم في الأسماء. وأما عبد الرحمن فيروي عنه هشام ابن يوسف الصنعاني. وذكر بعضهم أن له ابنا آخر اسمه أيوب وأنه يروي عنه يوسف بن زكريا الصنعاني، فالله أعلم","citation":"تهذيب الكمال (34/ 482)","pageId":461372,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"154":{"id":154,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"صحابية","citation":"تقريب التهذيب (1/ 1387)","pageId":531049,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"155":{"id":155,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حجر","statements":[{"text":"كانت فقيهة","citation":"تهذيب التهذيب (4/ 704)","pageId":489721,"verdict":"unclassified"},{"text":"كانت فقيهة، مدنية. لها ذكر في أوائل البخاري","citation":"تقريب التهذيب (1/ 1387)","pageId":531056,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"استشهد بها البخاري في الحيض","citation":"تهذيب الكمال (35/ 397)","pageId":463812,"verdict":"unclassified"},{"text":"استشهد بها البخاري في الحيض","citation":"تهذيب التهذيب (4/ 704)","pageId":489721,"verdict":"unclassified"}]}],"phenomena":[{"key":"التوثيق الضمني","label":"Implicit Authentication","statements":[{"text":"استشهد بها البخاري في الحيض","citation":"تهذيب الكمال (35/ 397)","pageId":463812},{"text":"استشهد بها البخاري في الحيض","citation":"تهذيب التهذيب (4/ 704)","pageId":489721}]}],"flags":[]},"156":{"id":156,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا تعرف","citation":"تقريب التهذيب (1/ 1387)","pageId":531062,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"159":{"id":159,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1106)","pageId":524992,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"نكرة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 7)","pageId":503316,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"160":{"id":160,"criticCount":3,"statementCount":5,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: قرأت بخط الذهبي، قال ابن القطان: حاله مجهولة. قال الذهبي: قد روى عنه غير صفوان بن عمرو، فهو شيخ محله الصدق كذا قال، ولم يسم الراوي الآخر، وقد جزم ابن القطان بأنه ما روى عنه غير صفوان، وقول الذهبي: إن من روى عنه أكثر من واحد فهو شيخ محله الصدق لا يوافقه عليه من يبتغي على الإسلام مزيد العدالة، بل هذه الصفة هي صفة المستورين الذين اختلفت الأئمة في قبول أحاديثهم، والله تعالى أعلم","citation":"تهذيب التهذيب (4/ 479)","pageId":483150,"verdict":"jarh"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 1106)","pageId":524988,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"قلت: قرأت بخط الذهبي، قال ابن القطان: حاله مجهولة. قال الذهبي: قد روى عنه غير صفوان بن عمرو، فهو شيخ محله الصدق كذا قال، ولم يسم الراوي الآخر، وقد جزم ابن القطان بأنه ما روى عنه غير صفوان، وقول الذهبي: إن من روى عنه أكثر من واحد فهو شيخ محله الصدق لا يوافقه عليه من يبتغي على الإسلام مزيد العدالة، بل هذه الصفة هي صفة المستورين الذين اختلفت الأئمة في قبول أحاديثهم، والله تعالى أعلم","citation":"تهذيب التهذيب (4/ 479)","pageId":483150,"verdict":"jarh"},{"text":"لا يعرف","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 7)","pageId":503312,"verdict":"unclassified"}]},{"critic":"ابن القطان الفاسي","statements":[{"text":"قلت: قرأت بخط الذهبي، قال ابن القطان: حاله مجهولة. قال الذهبي: قد روى عنه غير صفوان بن عمرو، فهو شيخ محله الصدق كذا قال، ولم يسم الراوي الآخر، وقد جزم ابن القطان بأنه ما روى عنه غير صفوان، وقول الذهبي: إن من روى عنه أكثر من واحد فهو شيخ محله الصدق لا يوافقه عليه من يبتغي على الإسلام مزيد العدالة، بل هذه الصفة هي صفة المستورين الذين اختلفت الأئمة في قبول أحاديثهم، والله تعالى أعلم","citation":"تهذيب التهذيب (4/ 479)","pageId":483150,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"161":{"id":161,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1106)","pageId":524994,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"162":{"id":162,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1107)","pageId":525014,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"163":{"id":163,"criticCount":3,"statementCount":5,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"قلت: وذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 480)","pageId":483203,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1108)","pageId":525044,"verdict":"jarh"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"قال ابن أبي حاتم عن أبي زرعة: لا أعرف اسمه","citation":"تهذيب التهذيب (4/ 480)","pageId":483203,"verdict":"unclassified"},{"text":"قال ابن أبي حاتم عن أبي زرعة: لا أعرف اسمه","citation":"تهذيب التهذيب (4/ 480)","pageId":483203,"verdict":"unclassified"},{"text":"قال عبد الرحمن بن أبي حاتم: سئل أبو زرعة عنه، فقال: لا أعرف اسمه","citation":"تهذيب الكمال (33/ 34)","pageId":458014,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"167":{"id":167,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1106)","pageId":525004,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"170":{"id":170,"criticCount":3,"statem