ا يحتج به","citation":"لسان الميزان (2/ 286)","pageId":545281,"verdict":"jarh"},{"text":"وبقية كلام أبي حاتم: مضطرب الحديث يكتب حديثه","citation":"لسان الميزان (2/ 286)","pageId":545281,"verdict":"jarh"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"كذبه أبو زرعة","citation":"لسان الميزان (2/ 286)","pageId":545281,"verdict":"unclassified"}]},{"critic":"ابن عدي","statements":[{"text":"قال الشيخ: وبشار بن قيراط هذا الذي روى أحاديث غير محفوظة وله أحاديث مناكير عمن يحدث عنه، وهو إلى الضعف أقرب منه إلى الصدق، وبشار بن الحكم خير منه","citation":"الكامل في الضعفاء (2/ 186)","pageId":574771,"verdict":"jarh"},{"text":"وقال ابن عدي: هو إلى الضعف أقرب. ومن مناكيره: حدثني ابن ابن سعد بن أبي وقاص عن أبيه عن جده مرفوعا قال: \" ليباشر الرجل درهمه بنفسه فإنه لا يؤجر على غبنه \". وقال ابن عدي: كان ينتحل الرأي وروى عنه عمار بن الحسن","citation":"لسان الميزان (2/ 286)","pageId":545281,"verdict":"jarh"}]},{"critic":"الخليلي","statements":[{"text":"وقال الخليلي: كان يتفقه على رأي أبي حنيفة، رضيه الحنفية بخراسان، ولم يتفقه عليه حفاظ خراسان","citation":"لسان الميزان (2/ 286)","pageId":545281,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17420":{"id":17420,"criticCount":4,"statementCount":5,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن الباقلاني","statements":[{"text":"ووثقه ابن خيرون","citation":"تاريخ الإسلام (10/ 203)","pageId":653425,"verdict":"tadil"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"وقال الخطيب: كتبت عنه، وكان صدوقا","citation":"تاريخ الإسلام (10/ 203)","pageId":653425,"verdict":"tadil"},{"text":"كتبت عنه، وكان صدوقا","citation":"تاريخ بغداد (5/ 494)","pageId":821329,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"من بيت حشمة، ذكر أن كتبه ذهبت في حريق الكرخ","citation":"تاريخ الإسلام (10/ 203)","pageId":653425,"verdict":"unclassified"}]},{"critic":"أبو سعد السمعاني","statements":[{"text":"قال أبو سعد السمعاني: كبر وضعف، وكان مقلا من الحديث، وسماعه صحيح. قال: ورأيت بخط بعض المحدثين أنه كان يتشيع",