{"19003":{"id":19003,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن عبد البر","statements":[{"text":"ذكره أبو عمر","citation":"الإصابة في تمييز الصحابة (6/ 181)","pageId":424391,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19006":{"id":19006,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الأزدي","statements":[{"text":"ذكره الأزدي فقال: زائغ ضعيف","citation":"لسان الميزان (4/ 89)","pageId":549782,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19008":{"id":19008,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن القطان الفاسي","statements":[{"text":"قال ابن القطان: مجهول","citation":"لسان الميزان (7/ 161)","pageId":557191,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19009":{"id":19009,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"أحمد بن محمد الإشبيلي","statements":[{"text":"وقال النباتي: ليس بالمشهور","citation":"لسان الميزان (4/ 86)","pageId":549760,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف، وأتى بخبر منكر","citation":"لسان الميزان (4/ 86)","pageId":549760,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: لا يتابع عليه، وهو خطأ","citation":"لسان الميزان (4/ 86)","pageId":549760,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19010":{"id":19010,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن ابن عمر، وأدخل يحيى بن أيوب بينه، وبين ابن عمر أبا بكر بن يزيد بن سرجس، روى عنه الليث بن سعد، ويحيى بن أيوب سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (8/ 108)","pageId":712765,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19012":{"id":19012,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"الجوزجاني","statements":[{"text":"ذكره الجوزجاني في كتاب \"الضعفاء\"","citation":"لسان الميزان (8/ 246)","pageId":559909,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وكان نافع هذا من رؤوس الخوارج، وإليه تنسب الطائفة الأزارقة، وكان قد خرج في أواخر دولة يزيد بن معاوية. فذكر ابن أبي خيثمة عن خالد بن خداش أن نافع بن الأزرق لما تفرقت آراء الخوارج أقام بسرق الأهواز يعترض الناس، فأثخن القتل في الناس حتى في النساء والصبيان، وجعل يقرأ: \" لا تذر على الأرض من الكافرين ديارا \" إلى \" فاجرا كفارا \". فاشتدت شوكته، فارتاع أهل البصرة، وقصتهم طويلة إلى أن كان قتله في جمادى الآخرة سنة خمس وستين. وكان يطلب العلم، وله أسئلة عن ابن عباس مجموعة في \"جزء\" من رواية... عن نافع المذكور، وأخرج الطبراني بعضها في مسند ابن عباس من \"المعجم الكبير\"","citation":"لسان الميزان (8/ 246)","pageId":559909,"verdict":"unclassified"},{"text":"من رؤوس الخوارج","citation":"لسان الميزان (8/ 246)","pageId":559909,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19013":{"id":19013,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (5/ 94)","pageId":552252,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19019":{"id":19019,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي المقاطيع","citation":"الثقات (8/ 238)","pageId":609247,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19025":{"id":19025,"criticCount":2,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن يونس المصري","statements":[{"text":"قال ابن يونس: منكر الحديث","citation":"لسان الميزان (5/ 99)","pageId":552270,"verdict":"jarh"}]},{"critic":"الدارقطني","statements":[{"text":"وقال الدارقطني: متروك الحديث، له عن حبيب كاتب مالك، وسعيد بن أبي مريم، وقال في موضع آخر: ضعيف","citation":"لسان الميزان (5/ 99)","pageId":552270,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19026":{"id":19026,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (11/ 284)","pageId":827157,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وكان ثقة","citation":"تاريخ الإسلام (6/ 563)","pageId":635373,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19027":{"id":19027,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن عدي","statements":[{"text":"وهذا كنت أظنه محمد بن شعيب بن شابور، إلى أن وجدت في ترجمة داود بن علي من \"كامل\" ابن عدي: حدثنا ابن صاعد وغيره قالا: حدثنا إبراهيم بن سعيد، حدثنا حسين بن محمد. فذكره، وقال: محمد بن شعيب لا أعرفه","citation":"لسان الميزان (7/ 196)","pageId":557324,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (7/ 196)","pageId":557324,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"ثم وجدت العقيلي ذكره، ومنه أخذ الذهبي، فذكر هذا الحديث من هذا الوجه، وقال: كوفي، حديثه غير محفوظ، والرواية في هذا الباب فيها لين","citation":"لسان الميزان (7/ 196)","pageId":557324,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19028":{"id":19028,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وفي \" الثقات \" لابن حبان: عبد العزيز بن صالح، يروي عن عبد الرحمن بن نعيم، عن أبي هريرة، روى عنه سعيد بن أبي هلال. فهذا من طبقة شيوخ ابن لهيعة، فما أدري إن كان هو المراد، أم غيره. ثم ظهر لي أنه هو، وأن الذهبي تحرف عليه، والصواب: يروي عنه ابن لهيعة. وقد وقع حديثه عند الطحاوي من طريق ابن لهيعة، عن عبد العزيز بن صالح، عن أبي منصور، عن ابن عباس: في عدد الوتر","citation":"لسان الميزان (5/ 207)","pageId":552666,"verdict":"tadil"}]},{"critic":"الأزدي","statements":[{"text":"وقال الأزدي: ضعيف، مجهول","citation":"لسان الميزان (5/ 207)","pageId":552666,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19030":{"id":19030,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"مستقيم الحديث","citation":"الثقات (8/ 383)","pageId":610818,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19031":{"id":19031,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات","citation":"لسان الميزان (5/ 141)","pageId":552435,"verdict":"tadil"}]},{"critic":"الحاكم","statements":[{"text":"قال الحاكم: ليس له راو غير عمرو بن دينار","citation":"لسان الميزان (5/ 141)","pageId":552435,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه عمرو بن دينار المكي، منقطع. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (5/ 285)","pageId":701760,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19033":{"id":19033,"criticCount":3,"statementCount":5,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن يونس المصري","statements":[{"text":"ضعفه أبو سعيد بن يونس","citation":"لسان الميزان (4/ 521)","pageId":551605,"verdict":"jarh"},{"text":"قال ابن يونس: واسم أبي رومان: عبد الملك بن يحيى بن هلال الإسكندري، مولى المعافري، كان يسكن الإسكندرية. ويقال: كان أصله من المغرب، وكان من أصحاب ابن وهب، روى عنه وعن أبيه أبي رومان، وعمه موسى بن يحيى بن هلال، وهو ضعيف الحديث، روى مناكير، توفي في شوال سنة 256","citation":"لسان الميزان (4/ 479)","pageId":551441,"verdict":"jarh"}]},{"critic":"الدارقطني","statements":[{"text":"وهاه الدارقطني","citation":"لسان الميزان (4/ 479)","pageId":551441,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"ضعفه غير واحد، روى حديثا كذبا","citation":"لسان الميزان (4/ 479)","pageId":551441,"verdict":"jarh"},{"text":"وقد أتى بخبر باطل","citation":"لسان الميزان (4/ 521)","pageId":551605,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19034":{"id":19034,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \" وقال: عداده في أهل البصرة، روى عنه سليمان بن كثير","citation":"لسان الميزان (5/ 73)","pageId":552169,"verdict":"tadil"}]},{"critic":"البخاري","statements":[{"text":"قال البخاري: لا يتابع عليه","citation":"لسان الميزان (5/ 73)","pageId":552169,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19035":{"id":19035,"criticCount":5,"statementCount":7,"tally":{"jarh":3,"tadil":1,"mixed":1,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه موسى بن عبيدة الربذي، سمعت أبي يقول ذلك، وسمعته يقول: [هو] منكر الحديث، لم يثبت حديثه","citation":"الجرح والتعديل لابن أبي حاتم (2/ 125)","pageId":683947,"verdict":"mixed"},{"text":"قال أبو حاتم: منكر الحديث","citation":"لسان الميزان (1/ 340)","pageId":542624,"verdict":"jarh"}]},{"critic":"ابن حبان","statements":[{"text":"وكذا قال ابن حبان في \" الضعفاء \": لا أدري ؛ البلية منه أو من موسى","citation":"لسان الميزان (1/ 340)","pageId":542624,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"وقال البخاري: لم يثبت حديثه","citation":"لسان الميزان (1/ 340)","pageId":542624,"verdict":"tadil"},{"text":"وأشار البخاري في \" تاريخه \" إلى أن سبب ضعفه ضعف موسى بن عبيدة","citation":"لسان الميزان (1/ 340)","pageId":542624,"verdict":"jarh"}]},{"critic":"الدارقطني","statements":[{"text":"وقال الدارقطني: ضعيف","citation":"لسان الميزان (1/ 340)","pageId":542624,"verdict":"jarh"}]},{"critic":"العقيلي","statements":[{"text":"وأورد له العقيلي عن أبيه، عن جابر رفعه: \" لا تجعلوني كقدح الراكب \"","citation":"لسان الميزان (1/ 340)","pageId":542624,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19037":{"id":19037,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1335)","pageId":530346,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19038":{"id":19038,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"أدرك أصحاب النبي صلى الله عليه وسلم","citation":"الثقات (5/ 87)","pageId":590769,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"أدرك أصحاب النبي صلى الله عليه وسلم","citation":"الثقات (5/ 87)","pageId":590769}]}],"flags":[]},"19040":{"id":19040,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"العقيلي","statements":[{"text":"مجهول، قاله العقيلي","citation":"لسان الميزان (7/ 550)","pageId":558603,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19043":{"id":19043,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":1,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"عن أبيه بحديث: \" أكرموا الشهود \". وهذا منكر، وما عبد الصمد بحجة، ولعل الحفاظ إنما سكتوا عنه مداراة للدولة، انتهى","citation":"لسان الميزان (5/ 187)","pageId":552610,"verdict":"mixed"}]},{"critic":"العقيلي","statements":[{"text":"وقد ذكره العقيلي في \" الضعفاء \" وساق الحديث من طريقه أخرجه عن أبي يحيى بن أبي مسرة، عنه، عن عبد الصمد بن موسى الهاشمي - وكان أميرا علينا بمكة - حدثني عمي إبراهيم بن محمد، عن عبد الصمد بن علي... فذكره وقال: حديثه غير محفوظ، ولا يعرف إلا به","citation":"لسان الميزان (5/ 187)","pageId":552610,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19044":{"id":19044,"criticCount":3,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"قال الدارقطني: ضعيف","citation":"لسان الميزان (4/ 350)","pageId":550891,"verdict":"jarh"}]},{"critic":"عبد الرحيم العراقي","statements":[{"text":"ومن مناكيره روايته عن يحيى بن عبد الحميد الحماني، عن أبي معاوية، عن الأعمش، عن مسروق، عن ابن مسعود بحديث قس بن ساعدة أورده أبو نعيم في الدلائل، عن ابن السقاء عنه، وقال شيخنا الحافظ العراقي والواهم فيه فيما أعلم طريف. قلت: وليس هذا الحديث في مسند يحيى الحماني","citation":"لسان الميزان (4/ 350)","pageId":550891,"verdict":"jarh"}]},{"critic":"يزيد بن محمد ابن زكرة","statements":[{"text":"وقال أبو زكريا الموصلي في \"تاريخه\" لمن يكن من أهل الحديث. وقد كتبت عنه مات سنة 304","citation":"لسان الميزان (4/ 350)","pageId":550891,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19048":{"id":19048,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"المحدث المسند","citation":"سير أعلام النبلاء (12/ 304)","pageId":726009,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}