tCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 982)","pageId":522730,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"صدوق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 365)","pageId":501697,"verdict":"tadil"}]},{"critic":"النسائي","statements":[{"text":"روى عنه النسائي، وقال: لا بأس به","citation":"تهذيب التهذيب (4/ 179)","pageId":480949,"verdict":"tadil"},{"text":"قال النسائي: لا بأس به","citation":"تهذيب الكمال (29/ 93)","pageId":455823,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"6439":{"id":6439,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 185)","pageId":480973,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (29/ 125)","pageId":455845,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 368)","pageId":501719,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مستور","citation":"تقريب التهذيب (1/ 984)","pageId":522754,"verdict":"unclassified"},{"text":"قلت: الضمير في \" جده \" يعود على موسى. فالحديث من رواية سعيد، وقد ولد في حياة النبي صلى الله عليه وآله وسلم، والظاهر أن له رؤية، وأما عمرو وهو الأشدق، فلا صحبة له، بل ولم يولد إلا في زمان عثمان، والحديث على كل حال مرسل","citation":"تهذيب التهذيب (4/ 185)","pageId":480973,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"قلت: الضمير في \" جده \" يعود على موسى. فالحديث من رواية سعيد، وقد ولد في حياة النبي صلى الله عليه وآله وسلم، والظاهر أن له رؤية، وأما عمرو وهو الأشدق، فلا صحبة له، بل ولم يولد إلا في زمان عثمان، والحديث على كل حال مرسل","citation":"تهذيب التهذيب (4/ 185)","pageId":480973}]}],"flags":["Sends Mursal Reports"]},"6441":{"id":6441,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (29/ 130)","pageId":455853,"verdict":"tadil"},{"text":"وذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 185)","pageId":480981,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 984)","pageId":522762,"verdict":"tadil"}]},{"critic":"محمد بن عبد الله مطين الحضرمي","statements":[{"text":"وقال محمد بن عبد الله الحضرمي: مات سنة ثلاث وثمانين ومائة، وكان ثقة، حدثنا عنه ابن نمير","citation":"تهذيب الكمال (29/ 130)","pageId":455853,"verdict":"tadil"},{"text":"وقال مطين: مات سنة ثلاث وثمانين ومائة، وكان ثقة. له في الصحيح حديث واحد في الغسل","citation":"تهذيب التهذيب (4/ 185)","pageId":480981,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"6442":{"id":6442,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 984)","pageId":522768,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"6443":{"id":6443,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"وقال عبيد الله بن سعد بن إبراهيم بن سعد الزهري عن أبيه وعمه عن أبيهما عن محمد بن إسحاق عن حمزة بن موسى بن أنس، وهذا وهم. قلت: تلخص من هذا أنه موسى بن حمزة بن أنس، وأن إبراهيم بن سعد قلبه، ولكن حمزة بن موسى بن أنس رجل معروف، ولي الشرطة على البصرة لإسماعيل بن علي بن عبد الله بن عباس في أيام إمرته عليها، ذكره عمر بن شبة، وأما موسى بن حمزة بن أنس فلم نعرف من حاله شيئا. وقد خولف الترمذي عن أبي كريب في ذلك، فرواه إبراهيم بن معقل النسفي عن أبي كريب، فسماه موسى بن عبد الله بن المثنى بن أنس، عن عمه ثمامة، وأظنه وهما، والله تعالى أعلم","citation":"تهذيب التهذيب (4/ 192)","pageId":481035,"verdict":"jarh"},{"text":"مجهول","citation":"تقريب التهذيب (1/ 987)","pageId":522820,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"وهذا القول وهم، والله أعلم","citation":"تهذيب الكمال (29/ 173)","pageId":455907,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"6444":{"id":6444,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 984)","pageId":522770,"verdict":"unclassified"}]},{"critic":"مسلم","statements":[{"text":"وفي كتاب «الزهرة»: روى عنه - يعني مسلم - أربعة أحاديث","citation":"إكمال تهذيب الكمال (12/ 34)","pageId":541173,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"6446":{"id":6446,"criticCount":3,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 985)","pageId":522776,"verdict":"jarh"}]},{"critic":"الأزدي","statements":[{"text":"قلت: قال أبو الفتح الأزدي: ليس بذاك","citation":"تهذيب التهذيب (4/ 187)","pageId":480993,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"جهل","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 370)","pageId":501737,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"6447":{"id":6447,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 985)","pageId":522782,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}