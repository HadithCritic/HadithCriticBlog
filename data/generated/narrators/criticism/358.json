text":"وللزبير بن حبيب أحاديث ليست بالكثيرة","citation":"الكامل في الضعفاء (4/ 192)","pageId":575770,"verdict":"unclassified"},{"text":"ولم أجد للزبير غير هذا الذي أخطأ فيه، وحديث عاصم بن عبيد الله، ولا أنكر منهما","citation":"الكامل في الضعفاء (4/ 192)","pageId":575770,"verdict":"unclassified"},{"text":"وتابعه على هذه الرواية فليح بن سليمان، وأخطأا جميعا على العلاء ؛ حيث قالا: عن أبي هريرة، والحديث عن أبي سعيد","citation":"الكامل في الضعفاء (4/ 192)","pageId":575770,"verdict":"unclassified"},{"text":"قال ابن عدي: وهذا مشهور عن نافع","citation":"الكامل في الضعفاء (4/ 192)","pageId":575770,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17908":{"id":17908,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"الأزدي","statements":[{"text":"قال الأزدي: ضعيف مجهول","citation":"لسان الميزان (3/ 492)","pageId":549058,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17909":{"id":17909,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يغرب","citation":"الثقات (8/ 119)","pageId":607853,"verdict":"unclassified"},{"text":"قال ابن حبان في \" الثقات \": حدثنا عنه بكر بن محمد بن عبد الوهاب القزاز، يغرب","citation":"لسان الميزان (2/ 33)","pageId":544242,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17910":{"id":17910,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"، فقال: الكعبي من أهل البصرة، يروي عن شيخ، عن محمد بن المنكدر، روى عنه يعقوب بن سفيان","citation":"لسان الميزان (8/ 547)","pageId":561199,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عنه: محمد بن مرزوق، مولى بني هاشم. سمعت أبي يقول ذلك، ويقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (9/ 311)","pageId":719688,"verdict":"jarh"},{"text":"مجهول","citation":"لسان الميزان (8/ 547)","pageId":561199,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17916":{"id":17916,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"الخطيب البغدادي","statements":[{"text":"وكان ثقة","citation":"تاريخ بغداد (2/ 140)","pageId":816678,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وثقه بعضهم","citation":"تاريخ الإسلام (6/ 391)","pageId":634490,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17917":{"id":17917,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"الذهبى","statements":[{"text":"وكان لا بأس به","citation":"سير أعلام النبلاء (20/ 511)","pageId":732125,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17918":{"id":17918,"criticCount":5,"statementCount":5,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"شجاع بن فارس السهروردي","statements":[{"text":"وقال شجاع الذهلي: صحيح السماع خال من الفهم","citation":"لسان الميزان (3/ 141)","pageId":547423,"verdict":"unclassified"}]},{"critic":"محمد بن سعدون الميورقي","statements":[{"text":"قال أبو عامر العبدري: عامي أمي، لا يحسن يكتب ولا يقرأ، رافضي، لا يحل أن يحمل عنه حرف واحد. وذكر العبدري أيضا أن سماعه صحيح","citation":"لسان الميزان (3/ 141)","pageId":547423,"verdict":"unclassified"}]},{"critic":"أبو سعد السمعاني","statements":[{"text":"وقال السمعاني: سألت أبا الفرج إبراهيم بن سليمان عنه، فقال: لا أروي عنه، كان لا يعرف ما يقرأ عليه","citation":"لسان الميزان (3/ 141)","pageId":547423,"verdict":"unclassified"}]},{"critic":"إسماعيل بن عبد الله الشافعي","statements":[{"text":"وقال ابن الأنماطي: دلنا عليه أبو الغنائم بن أبي عثمان، فمضيت إليه، فقرأت عليه الجزء الذي فيه اسمه، وسألناه: عندك من الأصول شيء ؟ فقال: كان عندي شدة بعتها لابن الطيوري. وكان يعرف بالحافظ ؛ لأنه كان يحفظ ثياب الناس في الحمام","citation":"لسان الميزان (3/ 141)","pageId":547423,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"سمع الكثير من أبي عمر بن مهدي، وأبي سعد الماليني، وم