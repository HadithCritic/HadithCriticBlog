{"17253":{"id":17253,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو نعيم الأصبهاني","statements":[{"text":"قال أبو نعيم: وهم في حديث رواه عن ابن وهب، عن فضيل بن عياض، عن الأعمش، عن أبي الضحى، عن مسروق، عن أبي هريرة. والمحفوظ عن الأعمش، عن أبي صالح، عن أبي هريرة، عن أبي وائل، عن عبد الله أورده في ترجمة فضيل من \" الحلية \"","citation":"لسان الميزان (5/ 47)","pageId":552076,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17255":{"id":17255,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"الذهبى","statements":[{"text":"ولا يعرف","citation":"لسان الميزان (5/ 60)","pageId":552116,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: مجهول بالنقل، لا يقيم الحديث، وحديثه غير محفوظ، لكن يعرف بفضيل بن مرزوق، عن عطية، عن ابن عمر","citation":"لسان الميزان (5/ 60)","pageId":552116,"verdict":"jarh"},{"text":"عن أيوب بن موسى، عن نافع، عن ابن عمر - رضي الله عنهما - قال: \" قرأت على النبي - صلى الله عليه وسلم -: ضعف، فقال: \" اقرأ: ضعف \". وهذا منكر. ذكره العقيلي","citation":"لسان الميزان (5/ 60)","pageId":552116,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17256":{"id":17256,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"مستقيم الحديث","citation":"الثقات (8/ 257)","pageId":609459,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17258":{"id":17258,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو زرعة الرازي","statements":[{"text":"وقد روى عنه أبو زرعة، وقال: ثقة رجل صالح عاقل، خرج إلى المغرب، فمات هناك","citation":"لسان الميزان (3/ 547)","pageId":549291,"verdict":"tadil"},{"text":"حدثنا عبد الرحمن، قال: سئل أبو زرعة عنه فقال: ثقة رجل صالح عاقل، خرج إلى المغرب فمات هناك","citation":"الجرح والتعديل لابن أبي حاتم (3/ 557)","pageId":693594,"verdict":"tadil"}]},{"critic":"ابن حبان","statements":[{"text":"يغرب","citation":"الثقات (8/ 251)","pageId":609389,"verdict":"unclassified"},{"text":"يغرب قاله ابن حبان في \" الثقات","citation":"لسان الميزان (3/ 547)","pageId":549291,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17261":{"id":17261,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"كتبت عنه بالرملة، وهو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (4/ 53)","pageId":694723,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17262":{"id":17262,"criticCount":2,"statementCount":5,"tally":{"jarh":2,"tadil":1,"mixed":1,"unclassified":1},"critics":[{"critic":"ابن عدي","statements":[{"text":"قال ابن عدي: ونافع لو جمع حديثه من التفاريق، لما بلغ خمسين حديثا بدون نسخته عن أبي الزناد، وسعيد عداده في المدنيين","citation":"لسان الميزان (4/ 80)","pageId":549744,"verdict":"unclassified"},{"text":"وأما صاحب الترجمة، فقال ابن عدي: ليس بمستقيم الحديث، وما رواه عن نافع ليس منه شيء، يعني لا أصل له، وقد وجدت له رواية عن ابن لهيعة","citation":"لسان الميزان (4/ 80)","pageId":549744,"verdict":"mixed"},{"text":"ليس بمستقيم الحديث","citation":"الكامل في الضعفاء (4/ 465)","pageId":576006,"verdict":"tadil"},{"text":"حدث عن نافع القارئ، ثنا الأعرج، عن أبي هريرة، عن النبي صلى الله عليه وسلم نسخة طويلة تزيد على المائة فيها مناكير، وعن نافع عن العلاء وسهيل ونافع مولى ابن عمر وغيرهم بأحاديث ليست بمحفوظة، ونافع القارئ لو جمعت حديثه كله من التفاريق لا يبلغ خمسين حديثا دون نسخة ابن أبي فديك، عن نافع، عن أبي الزناد، عن الأعرج، عن أبي هريرة","citation":"الكامل في الضعفاء (4/ 465)","pageId":576006,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف، والخبر الذي رواه منكر، بل روى أحاديث عن نافع عن الأعرج عن أبي هريرة نحو المائة فيها مناكير","citation":"لسان الميزان (4/ 80)","pageId":549744,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17264":{"id":17264,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"قال ابن حبان في \" الثقات \": يخطئ","citation":"لسان الميزان (4/ 110)","pageId":549864,"verdict":"tadil"},{"text":"يخطئ","citation":"الثقات (8/ 297)","pageId":609912,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17267":{"id":17267,"criticCount":5,"statementCount":6,"tally":{"jarh":2,"tadil":1,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الثقات، وقال: يروي عن الحجازيين","citation":"لسان الميزان (2/ 258)","pageId":545130,"verdict":"tadil"}]},{"critic":"الأزدي","statements":[{"text":"وكذا نقل الأزدي عن ابن معين، وقال الأزدي: ضعيف لا يحتج به","citation":"لسان الميزان (2/ 258)","pageId":545130,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"لا يدرى من هو؟","citation":"لسان الميزان (2/ 258)","pageId":545130,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"وكذا نقل الأزدي عن ابن معين، وقال الأزدي: ضعيف لا يحتج به","citation":"لسان الميزان (2/ 258)","pageId":545130,"verdict":"jarh"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"وقال ابن أبي حاتم: روى عنه عبد الرحيم بن مطرف، سئل أبي عنه فقال: لا أعرفه","citation":"لسان الميزان (2/ 258)","pageId":545130,"verdict":"unclassified"},{"text":"سئل أبي عنه فقال: لا أعرفه","citation":"الجرح والتعديل لابن أبي حاتم (2/ 261)","pageId":685118,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17268":{"id":17268,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"ما علمت فيه مقالا","citation":"تاريخ الإسلام (5/ 585)","pageId":629482,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"عبد الخالق بن منصور، قال: سألت يحيى بن معين عن سهل بن نصر يعني المطبخي، فقال: ثقة","citation":"تاريخ بغداد (10/ 168)","pageId":826156,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17269":{"id":17269,"criticCount":1,"statementCount":1,"tally":{