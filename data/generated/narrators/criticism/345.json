7276,"criticCount":2,"statementCount":3,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"وفي كتاب ابن أبي حاتم: الحارث بن زياد قال: دخلت على أبي عازب مسلم بن عمرو في مرضه. روى عنه أبو نعيم قال أبي: مجهول","citation":"لسان الميزان (2/ 513)","pageId":546516,"verdict":"jarh"},{"text":"قال: دخلت على أبي عازب مسلم بن عمرو في مرضه. روى عنه أبو نعيم، سمعت أبي يقول ذلك، وسمعته يقول: هو مجهول","citation":"الجرح والتعديل لابن أبي حاتم (3/ 75)","pageId":688828,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"ضعيف مجهول","citation":"لسان الميزان (2/ 513)","pageId":546516,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17278":{"id":17278,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"كتبت عنه بالطبرية، وهو صدوق","citation":"الجرح والتعديل لابن أبي حاتم (4/ 396)","pageId":697955,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17279":{"id":17279,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \"الثقات\"","citation":"لسان الميزان (4/ 282)","pageId":550576,"verdict":"tadil"}]},{"critic":"الأزدي","statements":[{"text":"قال الأزدي: ضعيف روى عنه شهاب بن خراش، انتهى","citation":"لسان الميزان (4/ 282)","pageId":550576,"verdict":"jarh"},{"text":"ضعفه الأزدي","citation":"لسان الميزان (9/ 324)","pageId":568397,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17280":{"id":17280,"criticCount":3,"statementCount":4,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"روى عن صفوان بن عمران الطائي الأصم، روى عنه: إسماعيل بن عياش ويحيى بن صالح الوحاظي وعبد الله بن عبد الجبار الخبائري، سمعت أبي يقول ذلك، وسمعته يقول: هو منكر الحديث ولا أدري الإنكار منه أو من صفوان الأصم الذي روى عنه: حديثا في طلاق المكره","citation":"الجرح والتعديل لابن أبي حاتم (7/ 58)","pageId":708673,"verdict":"jarh"}]},{"critic":"ابن حزم","statements":[{"text":"وقال ابن حزم في \" المحلى \": مجهول","citation":"لسان الميزان (6/ 294)","pageId":555232,"verdict":"jarh"}]},{"critic":"البخاري","statements":[{"text":"قال البخاري: حديثه منكر في طلاق المكره","citation":"لسان الميزان (6/ 294)","pageId":555232,"verdict":"unclassified"},{"text":"سمعت ابن حماد يقول: قال البخاري: الغاز بن جبلة حديثه منكر في طلاق المكره. وهذا الذي ذكره هو حديث واحد","citation":"الكامل في الضعفاء (7/ 116)","pageId":577547,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17282":{"id":17282,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"محمد بن خفيف بن إسكفشار","statements":[{"text":"وقال محمد بن خفيف الشيرازي: ليس هو عندهم بذاك","citation":"لسان الميزان (4/ 44)","pageId":549560,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"قال ابن أبي حاتم: سألت أبي عنه، فقال: هو شامي","citation":"لسان الميزان (4/ 44)","pageId":549560,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17283":{"id":17283,"criticCount":2,"statementCount":3,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: هو من أهل جيلاباذ في طريق بغداد ليس بالقوي يكتب حديثه","citation":"الجرح والتعديل لابن أبي حاتم (6/ 331)","pageId":706939,"verdict":"jarh"},{"text":"، قال أبو حاتم: ليس بالقوي، انتهى. وبقية كلام أبي حاتم: يكتب حديثه","citation":"لسان الميزان (5/ 442)","pageId":553556,"verdict":"jarh"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"وقال البرذعي، عن أبي زرعة: منكر الحديث","citation":"لسان الميزان (5/ 442)","pageId":553556,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"17284":{"id":17284,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن الجوزي","statements":[{"text":"وأورده ابن الجوزي في العلل، وقال: في إسناده مجاهيل","citation":"لسان الميزان (4/ 295)","pageId":550635,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17286":{"id":17286,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: ذكره أبي، عن إسحاق بن منصور، عن يحيى بن معين أنه قال: صالح بن مسعود الجدلي ثقة","citation":"الجرح والتعديل لابن أبي حاتم (4/ 412)","pageId":698135,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"17288":{"id":17288,"criticCount":5,"statementCount":7,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: [هو] شيخ","citation":"الجرح والتعديل لابن أبي حاتم (4/ 442)","pageId":698401,"verdict":"unclassified"}]},{"critic":"ابن عدي","statements":[{"text":"قال ابن عدي: هو من جملة الشيعة","citation":"لسان الميزان (4/ 303)","pageId":550682,"verdict":"unclassified"},{"text":"قال ابن عدي: وصباح ليس له إلا اليسير من الرواية، عن الحارث بن حصيرة، وقد روى عن الصباح علي بن هاشم بن البريد، وهو شيعي من جملة شيعة الكوفة","citation":"الكامل في الضعفاء (5/ 133)","pageId":576232,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"ونقل عن البخاري أنه قال: فيه نظر","citation":"لسان الميزان (4/ 303)","pageId":550682,"verdict":"jarh"},{"text":"سمعت ابن حماد يقول: قال البخاري: صباح بن يحيى، عن الحارث بن حصيرة رواه عنه علي بن هاشم بن البريد فيه نظر","citation":"الكامل في الضعفاء (5/ 133)","pageId":576232,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"متروك، بل متهم","citation":"لسان الميزان (4/ 303)","pageId":550682,"verdict":"jarh"}]},{"critic":"العقيلي","statements":[{"text":"ولفظ العقيلي صباح بن يحيى، عن الحارث بن حصيرة، عن جميع ثلاثتهم من الشيعة، وكان جميع من رؤسائهم والآفة في هذا الخبر من غيره","citation":"لسان الميزان (4/ 303)","pageId":550682,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17292":{"id":17292,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن الجوزي","statements":[{"text":"وثقه ابن الجوزي","citation":"سير أعلام النبلاء (20/ 158)","pageId":731655,"verdict":"tadil"},{"text":"وقال ابن الجوزي: سافر وركب البحار، وقاسى الشدائد، وتفقه ببغداد على أبي حامد الغزالي، وسمع الحديث، وقرأ الأدب على أبي زكريا التبريزي، وحصل كتبا نفيسة، وقرأت عليه الكثير، وكان ثقة، توفي في عاشر المحرم ببغداد","citation":"تاريخ الإسلام (11/ 782)","pageId":660053,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"الشيخ الإمام، المحدث المتقن","citation":"سير أعلام النبلاء (20/ 158)","pageId":731655,"verdict":"tadil"},{"text":"وكان فقيها، متدينا، عالما، فاضلا","citation":"تاريخ الإسلام (11/ 782)","pageId":660053,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"17294":{"id":17294,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الطحاوي","statements":[{"text":"فكان في هذا الحديث مكان محمد بن أبي بكر فيما رويناه قبله أبو الرجال، وقد خالف يحيى هذا فيه أبو عامر وسعيد بن منصور وأسد بن موسى، وعبد الله بن عبد الوهاب الحجبي، فذكروا أنه عن محمد بن أبي بكر، وأربعة أولى بالحفظ من واحد. ثم نظرنا هل روي فيه شيء من غير هذا الوجه ؟","citation":"شرح مشكل الآثار (6/ 144)","pageId":292213,"verdict":"unclassified"}]},{"critic":"العقيلي","statements":[{"text":"قال العقيلي: حدث بمناكير","citation":"لسان الميزان (8/ 477)","pageId":560879,"verdict":"jarh"}]}],"phenomena":[],"flags":[]}}