{"13050":{"id":13050,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سألت أبي عنه فقال: كان من أجلة أهل الري يسئل عن العدالات","citation":"الجرح والتعديل لابن أبي حاتم (6/ 279)","pageId":706276,"verdict":"unclassified"},{"text":"نا عبد الرحمن قال: سئل أبي عن عيسى بن أبي فاطمة، فقال: صدوق","citation":"الجرح والتعديل لابن أبي حاتم (6/ 279)","pageId":706276,"verdict":"tadil"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"ثنا عبد الرحمن قال: سئل أبو زرعة عنه، فقال: كان صدوقا كتبت عنه الكثير","citation":"الجرح والتعديل لابن أبي حاتم (6/ 279)","pageId":706276,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"13054":{"id":13054,"criticCount":2,"statementCount":3,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال أبو حاتم: ليس بقوي","citation":"لسان الميزان (6/ 278)","pageId":555181,"verdict":"jarh"},{"text":"سمعت أبي يقول ذلك، وسألته عنه فقال: ليس بقوي","citation":"الجرح والتعديل لابن أبي حاتم (6/ 286)","pageId":706365,"verdict":"jarh"}]},{"critic":"العقيلي","statements":[{"text":"وقال العقيلي: مجهول، لا يعرف ولا يتابع","citation":"لسان الميزان (6/ 278)","pageId":555181,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"13055":{"id":13055,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن سمعت أبي يقول: نا عبيس بن مرحوم وكان ثقة وفي حديثه شيء","citation":"الجرح والتعديل لابن أبي حاتم (7/ 34)","pageId":708345,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن، أنا يعقوب بن إسحاق فيما كتب إلي قال: نا عثمان بن سعيد قال: سألت يحيى بن معين عن عبيس كيف حديثه ؟ فقال: ثقة","citation":"الجرح والتعديل لابن أبي حاتم (7/ 34)","pageId":708345,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"13057":{"id":13057,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سئل أبي عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (7/ 50)","pageId":708556,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13058":{"id":13058,"criticCount":2,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حزم","statements":[{"text":"وقال ابن حزم في \" المحلى \": غالب بن عبد الله مجهول","citation":"لسان الميزان (6/ 296)","pageId":555247,"verdict":"jarh"}]},{"critic":"العلائي","statements":[{"text":"وفي الإسناد عمرو بن زياد، وضاع، فأما غالب فلا يعرف. قاله العلائي","citation":"لسان الميزان (6/ 296)","pageId":555247,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"13059":{"id":13059,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":1,"unclassified":1},"critics":[{"critic":"الحاكم","statements":[{"text":"رواة هذا الحديث كلهم ثقات إلا غزال بن محمد ؛ فإنه مجهول لا أعرفه بعدالة ولا جرح. وقد صح الحديث عن ابن عمر - رضي الله عنهما - من قوله من غير مسند ولا متصل","citation":"المستدرك على الصحيحين (4/ 211)","pageId":61878,"verdict":"mixed"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف، وخبره منكر في الحجامة","citation":"لسان الميزان (6/ 302)","pageId":555271,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13060":{"id":13060,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"العقيلي","statements":[{"text":"أخرجه العقيلي من طريق عبد الرحمن بن عمرو بن جبلة، عن عمر بن الفضل، عنه. وقال: لا يعرف إلا بهذا، ولا يتابع عليه","citation":"لسان الميزان (6/ 303)","pageId":555273,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"13061":{"id":13061,"criticCount":1,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"مجهول","citation":"لسان الميزان (6/ 305)","pageId":555282,"verdict":"jarh"},{"text