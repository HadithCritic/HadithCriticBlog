173,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 525)","pageId":478049,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 830)","pageId":519888,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 90)","pageId":499705,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"5531":{"id":5531,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"ثقة","citation":"تقريب التهذيب (1/ 833)","pageId":519939,"verdict":"tadil"}]},{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"قال عبد الرحمن بن أبي حاتم: اجتمع مع أبي في الرحلة بالبصرة أيام الأنصاري","citation":"تهذيب الكمال (25/ 13)","pageId":453216,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5534":{"id":5534,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":2,"mixed":1,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (24/ 586)","pageId":453210,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 531)","pageId":478094,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 833)","pageId":519933,"verdict":"unclassified"},{"text":"قلت: وقع في الهبة: حدثنا محمد بن جعفر أبو جعفر، ولم يذكر نسبه، والذي أظن أنه القومسي فإنه لم يختلف في أن كنيته أبو جعفر بخلاف هذا، والقومسي ثقة حافظ بخلاف هذا فإن له أحاديث خولف فيها. وفي \" الزهرة \": روى عنه مسلم (13) حديثا، وأظنه وهما، فإن شيخ مسلم هو الوركاني، وسبب الوهم أن صاحب \" الزهرة \" سمى جد العبدي زيادا، ومسلم لما يخرج عن الوركاني ينسبه تارة، وتارة لا ينسبه، فكأنه حيث لم ينسبه مسلم ظنه الفيدي فخص الوركاني بحديثين لكونه نسب فيهما، وجعل البقية لفيدي لكونه عنده محمد بن جعفر بن زياد، وتأكد عنده أن مسلما أخرج له لكون البخاري أخرج له عند من جزم بذلك ممن جمع شيوخ البخاري، وقد ذكرت ما فيه","citation":"تهذيب التهذيب (3/ 531)","pageId":478094,"verdict":"mixed"}]}],"phenomena":[],"flags":[]},"5544":{"id":5544,"criticCount":3,"statementCount":5,"tally":{"jarh":0,"tadil":4,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"، وقال: يغرب","citation":"تهذيب التهذيب (3/ 535)","pageId":478117,"verdict":"tadil"},{"text":"يغرب","citation":"الثقات (9/ 86)","pageId":613488,"verdict":"unclassified"},{"text":"ذكره ابن حبان في كتاب \"الثقات\"، وقال: يغرب","citation":"تهذيب الكمال (25/ 28)","pageId":453233,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق يغرب","citation":"تقريب التهذيب (1/ 834)","pageId":519956,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 95)","pageId":499759,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"5549":{"id":5549,"criticCount":4,"statementCount":6,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 537)","pageId":478131,"verdict":"tadil"},{"text":"وذكره ابن حبان في كتاب \"الثقات\"","citation":"تهذيب الكمال (25/ 38)","pageId":453247,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"ثقة","citation":"تقريب التهذيب (1/ 835)","pageId":519970,"verdict":"tadil"}]},{"critic":"النسائي","statements":[{"text":"قال النسائي: ثقة","citation":"تهذيب التهذيب (3/ 537)","pageId":478131,"verdict":"tadil"},{"text":"قال النسائي: ثقة","citation":"تهذيب الكمال (25/ 38)","pageId":453247,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وقال الذهبي: تفرد عنه أخوه سماك","citation":"تهذيب التهذيب (3/ 537)","pageId":478131,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}