gs":[]},"20248":{"id":20248,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وثقه ابن حبان","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 761)","pageId":580102,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"قلت: قرأت بخط ابن المحب في هامش كتاب الحسيني الذي بخطه: هذا ليس في \" المسند \". قلت: وكلام البخاري يدل على أنه لم يرو شيئا مسندا فإنه قال: روى عن ابن مسعود قوله في الصدقة، قاله الثوري عن عبد الله بن السائب يعني عنه، فاختصره ابن أبي حاتم كما نقله الحسيني، وكذلك ابن حبان في التابعين من الثقات، والأصل في \" المسند \" الأحمدي إيراد الأحاديث المرفوعة لا أقوال الصحابة فمن بعدهم","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 761)","pageId":580102,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"20249":{"id":20249,"criticCount":3,"statementCount":6,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":3},"critics":[{"critic":"أبو بكر الإسماعيلي","statements":[{"text":"وأثنى على عبد الرحمن أبو بكر الإسماعيلي","citation":"تاريخ الإسلام (7/ 146)","pageId":639154,"verdict":"unclassified"}]},{"critic":"ابن ماكولا","statements":[{"text":"وقال ابن ماكولا: كان ثقة، يعرف الحديث","citation":"سير أعلام النبلاء (14/ 222)","pageId":727148,"verdict":"tadil"},{"text":"وقال ابن ماكولا: كان ثقة يعرف الحديث","citation":"تاريخ الإسلام (7/ 146)","pageId":639154,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وكان ممن جمع بين العلم والعمل","citation":"تاريخ الإسلام (7/ 146)","pageId":639154,"verdict":"unclassified"},{"text":"وكان من أعيان المحدثين بجرجان","citation":"تاريخ الإسلام (7/ 146)","pageId":639154,"verdict":"unclassified"},{"text":"الإمام الحافظ المفيد الثبت","citation":"سير أعلام النبلاء (14/ 222)","pageId":727148,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}