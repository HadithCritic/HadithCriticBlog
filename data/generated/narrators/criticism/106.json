{"5303":{"id":5303,"criticCount":5,"statementCount":6,"tally":{"jarh":2,"tadil":2,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (24/ 197)","pageId":452918,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"، وقال: كنيته أبو عامر","citation":"تهذيب التهذيب (3/ 472)","pageId":477750,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 812)","pageId":519634,"verdict":"jarh"}]},{"critic":"الترمذي","statements":[{"text":"أخرج له الترمذي حديثه عن أبي هريرة في ذكر الوسيلة، وقال: غريب، وكعب ليس بمعروف، لا نعلم أحدا روى عنه غير ليث بن أبي سليم","citation":"تهذيب التهذيب (3/ 472)","pageId":477750,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"ولما ذكره المزي في \" الأطراف \" قال: كعب المدني أحد المجاهيل","citation":"تهذيب التهذيب (3/ 472)","pageId":477750,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سئل أبي عن كعب الذي روى عن أبي هريرة فقال: هو رجل وقع إلى الكوفة، روى عنه: ليث بن أبي سليم، لا يعرف مجهول، لا أعلم روى عنه غير ليث وأبو عوانة حديثا واحدا","citation":"الجرح والتعديل لابن أبي حاتم (7/ 161)","pageId":709946,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"5304":{"id":5304,"criticCount":4,"statementCount":5,"tally":{"jarh":1,"tadil":0,"mixed":2,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"، وقال: روى عنه تمام بن نجيح، وتمام ضعيف","citation":"تهذيب التهذيب (3/ 468)","pageId":477725,"verdict":"mixed"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"، وقال: روى عنه تمام بن نجيح وتمام ضعيف","citation":"تهذيب الكمال (24/ 175)","pageId":452893,"verdict":"mixed"}]},{"critic":"ابن حجر","statements":[{"text":"فيه لين","citation":"تقريب التهذيب (1/ 811)","pageId":519610,"verdict":"unclassified"}]},{"critic":"البزار","statements":[{"text":"وقال البزار: كعب وتمام ليسا بالقويين في الحديث","citation":"تهذيب التهذيب (3/ 468)","pageId":477725,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"مجهول","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 66)","pageId":499497,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"5317":{"id":5317,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا يعرف حالها","citation":"تقريب التهذيب (1/ 1370)","pageId":530755,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5318":{"id":5318,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"ذكره ابن حبان في \" الثقات \" أيضا، وليس في كتاب البخاري ولا ابن أبي حاتم، وهو أقدم من اللذين قبله","citation":"تهذيب التهذيب (3/ 472)","pageId":477759,"verdict":"tadil"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 812)","pageId":519640,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5321":{"id":5321,"criticCount":6,"statementCount":6,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":6},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة، يقال أنه أخو صفوان بن أمية لأمه، روى عن: عمرو بن عبد الله بن صفوان، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 174)","pageId":710126,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"صحابي له حديث","citation":"تقريب التهذيب (1/ 813)","pageId":519648,"verdict":"unclassified"}]},{"critic":"البخاري","statements":[{"text":"قال البخاري: له صحبة","citation":"الإصابة في تمييز الصحابة (9/ 305)","pageId":430069,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"له صحبة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 68)","pageId":499527,"verdict":"unclassified"}]},{"critic":"محمد بن إسحاق","statements":[{"text":"وقال ابن إسحاق: هو الذي قال يوم حنين لما شهدها مع أخيه صفوان، ووقعت هزيمة المسلمين: بطل السحر، فزجره صفوان في قصة مشهورة","citation":"الإصابة في تمييز الصحابة (9/ 305)","pageId":430069,"verdict":"unclassified"}]},{"critic":"مصعب بن عبد الله بن مصعب الزبيري","statements":[{"text":"وقال المفضل بن غسان الغلابي، عن مصعب بن عبد الله الزبيري: كان كلدة، وعبد الرحمن ابنا حنبل بن مليك من أهل اليمن نزع أبوهم إلى مكة، وكان عدادهما في بني جمح، وهما ابنا صفية بنت معمر بن حبيب بن وهب بن حذافة بن جمح، وكان أمية بن خلف بن وهب بن حذافة بن جمح ابن عم معمر بن حبيب بن وهب، وصديقا له، ونديما، فزعموا أنه شرب معه يوما فمرت ابنته صفية بنت معمر، فقال له أمية بن خلف: من هذه ؟ قال: ابنتي، قال: زوجنيها، فزوجه إياها، فولدت له صفوان بن أمية، فوقع بين أمية وبين معمر شر فجحدها، وقال: ما هي ابنتي، فطلقها أمية بن خلف آنفة حين انتفى منها، فغضب معمر فزوجها حنبل بن مليك، فولدت له: كلدة، وعبد الرحمن، وهما من مسلمة الفتح، وقتل عبد الرحمن مع علي بصفين. وليس لكلدة بن حنبل غير هذا الحديث - يعني: حديث اللبن والجداية والضغابيس","citation":"تهذيب الكمال (24/ 206)","pageId":452931,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5322":{"id":5322,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: ذكر ابن منده وغيره أن اسم والد كليب: الصلت، وترجم له في الصحابة بناء على ظاهر الإسناد، وليس الأمر كذلك، بل هو عثيم بن كثير بن كليب، والصحبة لكليب، وكان من حديث ابن جريج نسب عثيما إلى جده، فصار الظاهر أن الصحابي والد كليب، وإنما كليب هو الصحابي، ولا نعرف لأبيه صحبة","citation":"تهذيب التهذيب (3/ 475)","pageId":477780,"verdict":"unclassified"},{"text":"صحابي قليل الحديث","citation":"تقريب التهذيب (1/ 813)","pageId":519660,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"معدود في \" الصحابة \"","citation":"تهذيب التهذيب (3/ 475)","pageId":477780,"verdict":"unclassified"},{"text":"معدود في الصحابة","citation":"تهذيب الكمال (24/ 216)","pageId":452943,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5323":{"id":5323,"criticCount":4,"statementCount":6,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","stateme