 أبا زرارة الليث بن عاصم يدعو يقول: أسألك صحة في تقوى، وطول عمر في حسن عمل. قال أبي: فأجيبت دعوته، فطال عمره، وحسن عمله، وكان رجلا صالحا","citation":"تهذيب الكمال (24/ 288)","pageId":452997,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وكان ياسين بن عبد الأحد القتباني كثير الرواية عنه","citation":"الثقات (9/ 29)","pageId":612860,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10747":{"id":10747,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: ذكره الخطيب فقال: ليس مستملي وكيع ولم يقل الكلام الأخير، وهو ليس عندي بجيد، بل هو أعلى طبقة من مستملي وكيع، فقد روى أيضا عن يزيد بن جابر، وروى عنه أيضا خلف بن أيوب، ومحمد بن عبد الوهاب، وغيرهما","citation":"تهذيب التهذيب (3/ 488)","pageId":477850,"verdict":"unclassified"},{"text":"مستور","citation":"تقريب التهذيب (1/ 819)","pageId":519718,"verdict":"unclassified"}]},{"critic":"الخطيب البغدادي","statements":[{"text":"قلت: ذكره الخطيب فقال: ليس مستملي وكيع ولم يقل الكلام الأخير، وهو ليس عندي بجيد، بل هو أعلى طبقة من مستملي وكيع، فقد روى أيضا عن يزيد بن جابر، وروى عنه أيضا خلف بن أيوب، ومحمد بن عبد الوهاب، وغيرهما","citation":"تهذيب التهذيب (3/ 488)","pageId":477850,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}