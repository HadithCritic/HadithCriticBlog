ي حاتم (7/ 103)","pageId":709239,"verdict":"unclassified"}]},{"critic":"ابن السكن","statements":[{"text":"وقال ابن السكن: حجازي له صحبة","citation":"الإصابة في تمييز الصحابة (9/ 149)","pageId":429608,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"صحابي، كان أحد المؤلفة، ثم حسن إسلامه","citation":"تقريب التهذيب (1/ 805)","pageId":519493,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"له صحبة","citation":"تهذيب الكمال (24/ 78)","pageId":452774,"verdict":"unclassified"}]},{"critic":"محمد بن إسحاق","statements":[{"text":"وذكره محمد بن إسحاق في المؤلفة","citation":"الإصابة في تمييز الصحابة (9/ 149)","pageId":429608,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"من المؤلفة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 54)","pageId":499414,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5262":{"id":5262,"criticCount":5,"statementCount":5,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"ابن حجر","statements":[{"text":"صحابي","citation":"تقريب التهذيب (1/ 806)","pageId":519503,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"له صحبة","citation":"تهذيب الكمال (24/ 84)","pageId":452784,"verdict":"unclassified"}]},{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"وقال البخاري في قيس بن النعمان: قال عبد الله بن عبد الوهاب: حدثنا خالد بن الحارث سمع أبا القموص زيد بن علي قال: حدثني أحد الوفد، ولم يذكر المتن، وادعى ابن منده أن البخاري جعله، والذي قبله واحدا، والذي في التاريخ الكبير ما وصفت أنه فرق بين الذي روى عنه إياد بن لقيط، والذي روى عنه أبو القموص، ولفظ ابن منده: قال البخاري: حديثه في الكوفيين والبصريين، روى عنه إياد وزيد، وساق ابن منده حديث أبي القموص من وجه آخر، عن عبد الله بن عبد الوهاب بسنده، وقال فيه: إنهم أهدوا إلى رسول الله - صلى الله عليه وسلم - شيئا من تمر فدعا لهم، وقال: نعم الحي عبد القيس أسلموا طائعين غير موتورين. انتهى. وكأن مستند من ظنهما واحدا ذكر الهدية في كلا الحديثين، وليس بجيد ؛ لأن الأول صرح بأن هديته ردت بخلاف الآخر، وبأن السكوني لا يلاقي العبدي في النسب ؛ فإن السكوني من اليمن، وعبد القيس من ربيعة، وقد فرق بينهما غير واحد من الأئمة، وهو المعتمد","citation":"الإصابة في تمييز الصحابة (9/ 156)","pageId":429626,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"له وفادة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 55)","pageId":499420,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"أنه أتى النبي صلى الله عليه وسلم، روى عنه: أبو القموص زيد بن علي، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (7/ 104)","pageId":709247,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5265":{"id":5265,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"صحابي","citation":"تقريب التهذيب (1/ 1286)","pageId":528943,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5267":{"id":5267,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا يعرف حالها","citation":"تقريب التهذيب (1/ 1370)","pageId":530747,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5268":{"id":5268,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"لها صحبة","citation":"تقريب التهذيب (1/ 1370)","pageId":530742,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"صحابية","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 211)","pageId":506376,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"لها صحبة","citation":"تهذيب الكمال (35/ 289)","pageId":463518,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5286":{"id":5286,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"ته