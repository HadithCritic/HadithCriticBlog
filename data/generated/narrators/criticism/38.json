{"1903":{"id":1903,"criticCount":5,"statementCount":6,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":6},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"له صحبة، روى عنه ابن عباس سمعت أبي يقول بعض ذلك، وبعضه وجدته مكتوبا بخطه","citation":"الجرح والتعديل لابن أبي حاتم (3/ 449)","pageId":692540,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"له صحبة","citation":"الثقات (3/ 120)","pageId":583561,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وفرق ابن شاهين بين ذؤيب بن حلحلة والد قبيصة، وبين ذؤيب بن حبيب الذي روى عنه ابن عباس، وزعم ابن عبد البر أن أبا حاتم سبقه إلى ذلك، قال: وهو خطأ. قلت: ولم يظهر لي كونه خطأ، وأما والد قبيصة فقد ذكر الغلابي عن ابن معين أن النبي - صلى الله عليه وسلم - أتي بقبيصة بن ذؤيب ليدعو له بعد وفاة أبيه، فهذا يدل على أنه مات في زمن النبي - صلى الله عليه وسلم -","citation":"الإصابة في تمييز الصحابة (3/ 438)","pageId":419631,"verdict":"unclassified"},{"text":"صحابي","citation":"تقريب التهذيب (1/ 313)","pageId":510820,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"شهد الفتح","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 385)","pageId":492906,"verdict":"unclassified"}]},{"critic":"ابن البرقي","statements":[{"text":"قال ابن البرقي: جاء عنه حديث","citation":"تهذيب الكمال (8/ 522)","pageId":444511,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"1908":{"id":1908,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في «جملة الثقات»","citation":"إكمال تهذيب الكمال (4/ 294)","pageId":534354,"verdict":"tadil"},{"text":"قلت: ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (1/ 580)","pageId":468486,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 313)","pageId":510816,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"1912":{"id":1912,"criticCount":3,"statementCount":3,"tally":{"jarh":0,