tation":"الجرح والتعديل لابن أبي حاتم (8/ 89)","pageId":712575,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"، وسماه محمد بن ميسرة بن عبد الرحمن","citation":"تهذيب التهذيب (3/ 625)","pageId":478780,"verdict":"tadil"},{"text":"وذكره ابن حبان في كتاب \"الثقات\"","citation":"تهذيب الكمال (25/ 608)","pageId":453829,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 869)","pageId":520624,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين أنه قال: أبو عمرو محمد، والد أسباط بن محمد ثقة","citation":"الجرح والتعديل لابن أبي حاتم (8/ 89)","pageId":712575,"verdict":"tadil"}]},{"critic":"أبو داود السجستاني","statements":[{"text":"قال أبو عبيد الآجري: سئل أبو داود عن أبي عمرو الذي حدث عنه سليمان التيمي فقال: هو أبو أسباط بن محمد روى عن عكرمة","citation":"تهذيب الكمال (25/ 608)","pageId":453829,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5715":{"id":5715,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":4,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"ثقة","citation":"تقريب التهذيب (1/ 868)","pageId":520606,"verdict":"tadil"}]},{"critic":"النسائي","statements":[{"text":"قال النسائي: ثقة","citation":"تهذيب التهذيب (3/ 622)","pageId":478762,"verdict":"tadil"},{"text":"قال النسائي: ثقة","citation":"تهذيب الكمال (25/ 589)","pageId":453811,"verdict":"tadil"}]},{"critic":"مسلمة بن القاسم","statements":[{"text":"وقال مسلمة: ثقة","citation":"تهذيب التهذيب (3/ 622)","pageId":478762,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"5718":{"id":5718,"criticCount":4,"statementCount":6,"tally":{"jarh":0,"tadil":0,"mixed":1,"unclassified":5},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \" ثم قال: وليس هو محمد بن عبد الرحمن الذي يكنى أبا غرازة، فذاك ضعيف لا يحتج به","citation":"تهذيب التهذيب (3/ 623)","pageId":478766,"verdict":"mixed"},{"text":"ومن قال: عن عمرو بن دينار، عن أبي السوار فقد وهم","citation":"الثقات (5/ 375)","pageId":593369,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"ويحتمل أن يكون هو الذي روى له أبو داود من رواية أبي حومل العامري عنه، عن أبيه عن جابر، وقد ذكرنا حديثه في ترجمة أبيه. قلت: وهذا يوهم أن أبا داود أخرج لمحمد بن عبد الرحمن الذي روى عنه أبو حومل، وليس كذلك، فإن الذي ذكره المصنف في ترجمة عبد الرحمن ليس فيه لمحمد ذكر، ولفظ المزي في ترجمة عبد الرحمن بن أبي بكر: حجازي، قال: أمنا جابر، قاله إسرائيل، عن أبي حومل، عنه. روى له أبو داود هذا الحديث الواحد، ولا وجدنا له ذكرا في كتب المحدثين","citation":"تهذيب التهذيب (3/ 623)","pageId":478766,"verdict":"unclassified"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 868)","pageId":520610,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"ويحتمل أن يكون هو الذي روى له أبو داود من رواية أبي حومل العامري عنه، عن أبيه عن جابر، وقد ذكرنا حديثه في ترجمة أبيه. قلت: وهذا يوهم أن أبا داود أخرج لمحمد بن عبد الرحمن الذي روى عنه أبو حومل، وليس كذلك، فإن الذي ذكره المصنف في ترجمة عبد الرحمن ليس فيه لمحمد ذكر، ولفظ المزي في ترجمة عبد الرحمن بن أبي بكر: حجازي، قال: أمنا جابر، قاله إسرائيل، عن أبي حومل، عنه. روى له أبو داود هذا الحديث الواحد، ولا وجدنا له ذكرا في كتب المحدثين","citation":"تهذيب التهذيب (3/ 623)","pageId":478766,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع ابن عمر وابن عباس، روى عنه: عمرو بن دينار وعثمان بن الأسود، سمعت أبي يقول","citation":"الجرح والتعديل لابن أبي حاتم (7/ 323)","pageId":711718,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع ابن عمر وابن عباس، روى عنه: عمرو بن دينار وعثمان بن الأسود، سمعت أبي يقول","citation":"الجرح والتعديل لابن أبي حاتم (7/ 323)","pageId":711718}]}],"flags":[]},"5724":{"id":5724,"criticCount":4,"statementCount":7,"tally":{"jarh":0,"tadil":7,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{