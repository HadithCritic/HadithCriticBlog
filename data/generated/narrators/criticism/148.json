:"قال أبو حاتم: لا أعلم روى عنه غير شعبة","citation":"تهذيب التهذيب (4/ 541)","pageId":484564,"verdict":"unclassified"},{"text":"سمعت أبي يقول ذلك، ويقول: أبو الضحاك هذا لا أعلم روى عنه غير شعبة","citation":"الجرح والتعديل لابن أبي حاتم (9/ 395)","pageId":720796,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"7435":{"id":7435,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"وسألته عنه فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (8/ 386)","pageId":715525,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"7436":{"id":7436,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن، قال: قرئ على العباس بن محمد الدوري، قال: سمعت يحيى بن معين، وسئل عن عبد الله بن خالد العبسي، فقال: شيخ مشهور يروي عنه الثوري","citation":"الجرح والتعديل لابن أبي حاتم (5/ 44)","pageId":699395,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"7438":{"id":7438,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"وروى ابن منده من طريق مغيرة، عن الشعبي، عن زياد بن عياض قال: كل شيء رأيت النبي - صلى الله عليه وسلم - يفعله رأيتكم تفعلونه، غير أنكم لا تقلسون في العيد. وهذا وهم فيه شريك على مغيرة، وإنما المحفوظ في هذا عن الشعبي، عن عياض الأشعري. وقد روي عن شريك على الصواب، أخرجه البغوي، وغيره في ترجمة عياض من طريق شريك","citation":"الإصابة في تمييز الصحابة (4/ 143)","pageId":420721,"verdict":"unclassified"},{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (4/ 143)","pageId":420721,"verdict":"unclassified"}]},{"critic":"محمد بن سعد","statements":[{"text":"وذكره ابن سعد في الطبقة الأولى من التابعين","citation":"الإصابة في تمييز الصحابة (4/ 143)","pageId":420721,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإدراك","label":"Idrak (Contemporaneity)","statements":[{"text":"له إدراك","citation":"الإصابة في تمييز الصحابة (4/ 143)","pageId":420721}]}],"flags":[]},"7441":{"id":7441,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمعت أبي يقول ذلك، وسمعته يقول: هو من قدماء أصحاب النخعي. قلت: هو صدوق ؟ قال: نعم","citation":"الجرح والتعديل لابن أبي حاتم (2/ 522)","pageId":687804,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"7442":{"id":7442,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"حدثنا عبد الرحمن، قال: ذكره أبي عن إسحاق بن منصور، عن يحيى بن معين أنه قال: حيان الجعفي ثقة","citation":"الجرح والتعديل لابن أبي حاتم (3/ 245)","pageId":690502,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"7446":{"id":7446,"criticCount":2,"statementCount":6,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"قال أبو حاتم: صالح الحديث","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 371)","pageId":579160,"verdict":"tadil"},{"text":"قال فيه أبو حاتم: صالح الحديث","citation":"لسان الميزان (2/ 391)","pageId":545792,"verdict":"tadil"},{"text":"سمعت أبي يقول ذلك، وسألته عنه فقال: هو صالح الحديث","citation":"الجرح والتعديل لابن أبي حاتم (2/ 458)","pageId":687134,"verdict":"tadil"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \"الثقات\". وقال: ربما أخطأ","citation":"لسان الميزان (2/ 391)","pageId":545792,"verdict":"tadil"},{"text":"وقال ابن حبان في \" الثقات \": ربما أخطأ","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 371)","pageId":579160,"verdict":"tadil"},{"text":"، ربما أخطأ","citation":"الثقات (8/ 158)","pageId":608294,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}