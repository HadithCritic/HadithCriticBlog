":[]},"3367":{"id":3367,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 541)","pageId":473638,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (17/ 332)","pageId":449230,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 594)","pageId":515742,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"3379":{"id":3379,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (17/ 332)","pageId":449232,"verdict":"tadil"},{"text":"وذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 542)","pageId":473640,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 594)","pageId":515744,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (3/ 275)","pageId":496689,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"3385":{"id":3385,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 595)","pageId":515764,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"3387":{"id":3387,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":2,"mixed":1,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 546)","pageId":473672,"verdict":"tadil"},{"text":"له حديث واحد عند أبي داود في الصلاة. قلت: وأخرجه ابن خزيمة وابن حبان في « صحيحيهما ». وقال المنذري في « مختصره »: يشبه أن يكون الزعفراني، يعني الآتي بعد هذا، وليس كما ظن ؛ فإن الزعفراني يصغر عن إدراك يوسف بن ماهك. وأيضا فقد ذكره ابن حبان في « الثقات »، وأما الزعفراني فواهي الحديث كما ترى","citation":"تهذيب التهذيب (2/ 546)","pageId":473672,"verdict":"mixed"},{"text":"ذكره ابن حبان في كتاب \" الثقات","citation":"تهذيب الكمال (17/ 363)","pageId":449261,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 596)","pageId":515776,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"3388":{"id":3388,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول الحال","citation":"تقريب التهذيب (1/ 596)","pageId":515772,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"3390":{"id":3390,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات","citation":"تهذيب الكمال (17/ 371)","pageId":449269,"verdict":"tadil"},{"text":"ذكره ابن حبان في « الثقات ». قلت: لكنه أورده في أتباع التابعين","citation":"تهذيب التهذيب (2/ 548)","pageId":473680,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مستور","citation":"تقريب التهذيب (1/ 596)","pageId":515784,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"3394":{"id":3394,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في الطبقة الثالثة من \" الثقات \"","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 810)","pageId":580232,"verdict":"tadil"}]},{"critic":"الفلاس","statements":[{"text":"وثقه عمرو بن علي الفلاس","citation":"تعجيل المنفعة بزوائد رجال الأئمة الأربعة (1/ 810)","pageId":580232,"verdict":"tadil"},{"text":"نا عبد الرحمن، نا محمد بن إبراهيم، نا أبو حفص عمرو بن علي أنه قال: عبد الرحمن بن مجبر ثقة في الحديث","citation":"الجرح والتعديل لابن أبي حاتم (5/ 287)","pageId":701794,"verdict":"tadil"}]}],"phenomena":[],"flags":[]}}