 حاتم (5/ 256)","pageId":701454,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 522)","pageId":473502,"verdict":"tadil"},{"text":"وذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (17/ 215)","pageId":449104,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 585)","pageId":515606,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10421":{"id":10421,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 589)","pageId":515660,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10424":{"id":10424,"criticCount":4,"statementCount":5,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (17/ 279)","pageId":449174,"verdict":"tadil"},{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 532)","pageId":473574,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 590)","pageId":515678,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"وقال أبو حاتم: لا أعرفه، وحديثه صالح","citation":"تهذيب التهذيب (2/ 532)","pageId":473574,"verdict":"unclassified"}]},{"critic":"ابن القطان الفاسي","statements":[{"text":"وقال ابن القطان: لا يعرف","citation":"تهذيب التهذيب (2/ 532)","pageId":473574,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10428":{"id":10428,"criticCount":3,"statementCount":4,"tally":{"jarh":1,"tadil":2,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 544)","pageId":473652,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (17/ 343)","pageId":449241,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 595)","pageId":515754,"verdict":"unclassified"}]},{"critic":"الحاكم","statements":[{"text":"وقال البخاري في « الصحيح »: واشترى نافع بن عبد الحارث بن صفوان بن أمية دار السجن لعمر، الحديث. وقد رواه ابن عيينة، عن عمرو بن دينار، عن عبد الرحمن بن فروخ، قال: اشترى... فذكره. قلت: لم يسمه البخاري في « صحيحه » في هذا الموضع ولا غيره، وإنما علق القصة حسب، ولو كان المؤلف يلتزم أن يذكر جميع من في تعاليق البخاري ممن لم يصرح بذكرهم لاستدركنا عليه خلقا كثيرا ممن خرجنا أحاديثهم فيما كتبناه على تعاليق البخاري، ولكن موضوع هذا الكتاب وأصله المسمى « بالكمال » يأبى ذلك. وزعم الحاكم أن البخاري ومسلما إنما تركا إخراج حديث عبد الرحمن بن فروخ هذا ؛ لأنه لم يرو عنه غير عمرو بن دينار، يعني تركا أحاديثه الموصولة، وهو على قاعدته في أن شرط من يخرج له في « الصحيح » أن يكون له راويان، وقد تناقض هو فادعى أن هذا شرطهما، ثم استدرك عليهما أشياء مما يخالف ذلك ولا يرد منها شيء ؛ لأنهما لم يصرحا باشتراط ذلك، بل يقوم مقام الراوي الثاني الشهرة مثلا، وقد بدا لي فاستدركت كلما اطلعت عليه مما هذا سبيله، فإن كان الاسم مترجما له بغير رقم نبهت على أنه فاته الرقم، وإلا فالترجمة كاملة، وأعين الباب الذي وقع ذكره فيه والسند كذلك مع ما أطلع عليه من حال الراوي المذكور إن شاء الله تعالى، وكان تتبعي لذلك بعد تبييض النسخة من هذا المختصر بأربعين سنة","citation":"تهذيب التهذيب (2/ 544)","pageId":473652,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"10432":{"id":10432,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 597)","pageId":515802,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (9/ 356)","pageId":569396,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"10435":{"id":10435,"criticCount":4,"statementCount":6,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 600)","pageId":515840,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"مجهول","citation":"الكاشف في معرفة من له رواية في الكتب الستة (3/ 285)","pageId":496761,"verdict":"jarh"}]},{"critic":"علي ابن المديني","statements":[{"text":"روى عطاء بن [أبي] مروان، عن أبيه، عنه ثنا عبد الرحمن، نا محمد بن أحمد بن البراء البغدادي قال: قال علي ابن المديني: عبد الرحمن بن مغيث لا يعرف إلا في هذا الحديث","citation":"الجرح والتعديل لابن أبي حاتم (5/ 287)","pageId":701788,"verdict":"unclassified"},{"text":"قال ابن المديني: عبد الرحمن بن مغيث لا يعرف إلا في هذا الحديث","citation":"تهذيب التهذيب (2/ 555)","pageId":473740,"verdict":"unclassified"},{"text":"قال محمد بن أحمد بن البراء، عن علي ابن المديني: عبد الرحمن بن مغيث لا يعرف إلا في هذا الحديث","citation":"تهذيب الكمال (17/ 422)","pageId":449321,"verdict":"unclassified"}]},{"critic":"الحاكم","statements":[{"text":"وخرج الحاكم أبو عبد الله النيسابوري حديثه في \" صحيحه \"","citation":"إكمال تهذيب الكمال (8/ 231)","pageId":537973,"verdict":"unclassified"}]}],"phenomena":[{"key":"التوثيق الضمني","label":"Implicit Authentication","statements":[{"text":"وخرج الحاكم أبو عبد الله النيسابوري حديثه في \" صحيحه \"","citation":"إكمال تهذيب الكمال (8/ 231)","pageId":537973}]}],"flags":[]},"10436":{"id":10436,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 601)","pageId":515862,"verdict":"unclassified"}]},{"critic":"محمد بن يوسف الكندي","statements":[{"text":"وقال أبو عمر الكندي: كان فقيها عفيفا، وكان من شهود العمري القاضي، ومن أهل الأمانات عنده، وهو أول من أقرأ بمصر بحرف نافع","citation":"تهذيب التهذيب (2/ 559)","pageId":473762,"verdict":"unclassified"}]},{"critic":"الحاكم","statements":[{"text":"وأخرج الحاكم حديثه في « المستدرك »، وقال: رواته مصريون ثقات","citation":"تهذيب التهذيب (2/ 559)","pageId":473762,"verdict":"tadil"}]}],"phenomena":[{"key":"التوثيق الضمني","label":"Implici