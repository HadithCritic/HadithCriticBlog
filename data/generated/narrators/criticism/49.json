470592,"verdict":"unclassified"},{"text":"لا أعلم أحدا روى عنه، إنما الناس يروون معاوية بن سلام، عن جده، ومعاوية بن سلام، عن أخيه، فأما معاوية بن سلام، عن أبيه فلا أعرفه، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (4/ 261)","pageId":696649,"verdict":"unclassified"}]}],"phenomena":[{"key":"التوثيق الضمني","label":"Implicit Authentication","statements":[{"text":"خرج الحاكم حديثه في « مستدركه »","citation":"إكمال تهذيب الكمال (6/ 179)","pageId":536048}]}],"flags":[]},"2492":{"id":2492,"criticCount":4,"statementCount":6,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"خرج ابن حبان حديثه في « صحيحه »، وكذلك أبو عبد الله الحاكم","citation":"إكمال تهذيب الكمال (6/ 179)","pageId":536050,"verdict":"unclassified"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (2/ 139)","pageId":470594,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (12/ 292)","pageId":446415,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 426)","pageId":512783,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 555)","pageId":494469,"verdict":"tadil"}]},{"critic":"الحاكم","statements":[{"text":"خرج ابن حبان حديثه في « صحيحه »، وكذلك أبو عبد الله الحاكم","citation":"إكمال تهذيب الكمال (6/ 179)","pageId":536050,"verdict":"unclassified"}]}],"phenomena":[{"key":"التوثيق الضمني","label":"Implicit Authentication","statements":[{"text":"خرج ابن حبان حديثه في « صحيحه »، وكذلك أبو عبد الله الحاكم","citation":"إكمال تهذيب الكمال (6/ 179)","pageId":536050}]}],"flags":[]},"2495":{"id":2495,"criticCount":5,"statementCount":5,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حبان","statements":[{"text":"لها صحبة","citation":"الثقات (3/ 184)","pageId":583983,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"t