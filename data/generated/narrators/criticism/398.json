{"19903":{"id":19903,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يروي عن أبي هريرة إن كان سمع منه","citation":"الثقات (5/ 207)","pageId":591929,"verdict":"unclassified"}]}],"phenomena":[{"key":"الاختلاف في سماع الراوي","label":"Audition Disputed","statements":[{"text":"يروي عن أبي هريرة إن كان سمع منه","citation":"الثقات (5/ 207)","pageId":591929}]}],"flags":["Audition Disputed"]},"19905":{"id":19905,"criticCount":1,"statementCount":2,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"يحيى بن معين","statements":[{"text":"قال يحيى بن معين: ليس بشيء","citation":"لسان الميزان (5/ 446)","pageId":553581,"verdict":"jarh"},{"text":"ثنا عبد الرحمن قال: قرئ على العباس بن محمد الدوري، عن يحيى بن معين أنه قال: مولى أبي عوانة ليس بشيء","citation":"الجرح والتعديل لابن أبي حاتم (6/ 339)","pageId":707020,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19907":{"id":19907,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"مسلم بن إبراهيم الشحام","statements":[{"text":"نا عبد الرحمن، أنا أبو بكر بن أبي خيثمة فيما كتب إلي فقال: نا مسلم بن إبراهيم، نا عصمة بن سالم الهنائي - وكان صدوقا","citation":"الجرح والتعديل لابن أبي حاتم (7/ 20)","pageId":708172,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19908":{"id":19908,"criticCount":1,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"العقيلي","statements":[{"text":"قال العقيلي: مجهول بالنقل، وهذا له أصل من رواية برد بن سنان، عن الزهري، عن عروة، عن عائشة","citation":"لسان الميزان (5/ 160)","pageId":552507,"verdict":"jarh"},{"text":"قال العقيلي: لا يتابع على حديثه","citation":"لسان الميزان (5/ 160)","pageId":552507,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19915":{"id":19915,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الحاكم","statements":[{"text":"قال الحاكم: حدث بنيسابور بعد محمد بن إسحاق - يعني: الثقفي - عن علي بن حجر، فلم يصدق","citation":"لسان الميزان (6/ 567)","pageId":556442,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19919":{"id":19919,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"مجهول","citation":"لسان الميزان (5/ 429)","pageId":553501,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19920":{"id":19920,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع ابن أبي ليلى وأبا عبد الله الجدلي وسعيد بن جبير، روى عنه إبراهيم بن ميمون، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 397)","pageId":707804,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع ابن أبي ليلى وأبا عبد الله الجدلي وسعيد بن جبير، روى عنه إبراهيم بن ميمون، سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (6/ 397)","pageId":707804}]}],"flags":[]},"19922":{"id":19922,"criticCount":2,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (5/ 427)","pageId":553492,"verdict":"unclassified"},{"text":"امرؤ مجهول","citation":"لسان الميزان (5/ 427)","pageId":553492,"verdict":"jarh"}]},{"critic":"العقيلي","statements":[{"text":"ذكره العقيلي فقال: مجهول بالنقل، روى عن أبي هريرة، وعنه سلمة بن حبيب مثله، وساق له من طريق حجاج بن أرطاة، عنه بهذا السند في: \" النهي عن الانتعال قائما \"، وعن: \" الاستنجاء بعظم أو بما يخرج من بطن \"","citation":"لسان الميزان (5/ 427)","pageId":553492,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19925":{"id":19925,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ما أحلفه أن لا يكون بعزرة الأعور الذي روى عنه البصريون ؛ لأن أحاديث عزرة الأعور مستقيمة، وما روى جعفر بن برقان عن عزرة هذا لا تشبه أحاديث عزرة الأعور كأنهما اثنان، والله أعلم","citation":"الثقات (7/ 300)","pageId":603159,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19932":{"id":19932,"criticCount":3,"statementCount":3,"tally":{"jarh":1,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \"الثقات\"","citation":"لسان الميزان (2/ 420)","pageId":545950,"verdict":"tadil"}]},{"critic":"العقيلي","statements":[{"text":"وقال العقيلي في ترجمة عاصم بن مضرس: جبلة بن سليمان لا بأس به","citation":"لسان الميزان (2/ 420)","pageId":545950,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"قال ابن معين: ليس بثقة","citation":"لسان الميزان (2/ 420)","pageId":545950,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19935":{"id":19935,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"يعتبر حديثه من غير رواية ابنه عنه","citation":"الثقات (7/ 655)","pageId":606656,"verdict":"unclassified"},{"text":"قال ابن حبان في \" الثقات \": يعتبر حديثه من غير رواية ابنه عنه","citation":"لسان الميزان (8/ 517)","pageId":561073,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"19939":{"id":19939,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"لا تعرف","citation":"لسان الميزان (3/ 388)","pageId":548630,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19941":{"id":19941,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الدارقطني","statements":[{"text":"أن الدارقطني ضعف الضراب","citation":"لسان الميزان (3/ 30)","pageId":546981,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"19942":{"id":19942,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"مسلمة بن القاسم","statements":[{"text":"وقال مسلمة في \" الصلة \": كان من أروى الناس عن ابن قتيبة مات بمصر سنة 333. وكان على قضاء القلزم أدركته ولم أكتب عنه، وكان ثقة كثير الحديث","citation":"لسان الميزان (1/ 672)","pageId":543950,"verdict":"tadil"}]},{"critic":"الدارقطني","statements":[{"text":"اتهمه الدارقطني ومشاه غيره انتهى. وصرح الدارقطني في \" غرائب مالك \" بأنه يضع الحديث وروى مرة فيها عن الحسن الضراب عنه عن إسماعيل بن إسحاق عن إسماعيل بن أبي أويس عن مالك، عن سمي، عن أبي صالح، عن أبي هريرة رضي الله عنه حديث: \" سبقت رحمتي غضبي \" وقال: لا يصح بهذا الإسناد والمتهم به أحمد بن مروان وهو عندي ممن كان يضع الحديث","citation":"لسان الميزان (1/ 672)","pageId":543950,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"19949":{"id":19949,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن أبي حاتم الرازي","statements":[{"text":"وروى عن: محمد بن زيد العبدي، ورأى أبا مجلز، ورأى عكرمة يصلي نهارا يجهر بالقراءة","citation":"الجرح والتعديل لابن أبي حاتم (9/ 45)","pageId":717209,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}