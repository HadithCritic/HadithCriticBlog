{"957":{"id":957,"criticCount":4,"statementCount":7,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":5},"critics":[{"critic":"ابن حبان","statements":[{"text":"وفي كتاب « الثقات » لابن حبان: بشير بن المحرر بن غالب الأسدي من أهل الكوفة، يروي عن أخيه بشر بن المحرر، وهو تابعي روى عنه يزيد بن أبي زياد انتهى","citation":"إكمال تهذيب الكمال (2/ 420)","pageId":532837,"verdict":"tadil"},{"text":"شيخ","citation":"الثقات (6/ 100)","pageId":596607,"verdict":"unclassified"},{"text":"وقال ابن حبان في الثقات:، فلعله هذا","citation":"تهذيب التهذيب (1/ 235)","pageId":465657,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 173)","pageId":508311,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"قرأت بخط الذهبي: لا يعرف","citation":"تهذيب التهذيب (1/ 235)","pageId":465657,"verdict":"unclassified"},{"text":"لا يعرف","citation":"لسان الميزان (9/ 268)","pageId":566562,"verdict":"unclassified"}]},{"critic":"مغلطاي","statements":[{"text":"وقول من زعم من المتأخرين: إنه لا يعرف، قصور منه كعادته، والله تعالى أعلم","citation":"إكمال تهذيب الكمال (2/ 420)","pageId":532837,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"966":{"id":966,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حجر","statements":[{"text":"صحابي","citation":"تهذيب التهذيب (1/ 238)","pageId":465682,"verdict":"unclassified"},{"text":"وذكر ابن الكلبي في أولاد أكثم بن أبي الجون معبدا وبصرة وبنتا يقال لها: جلدية، فيحتمل أن يكون بصرة هو صاحب هذا الحديث إن كان الذي قال: ابن أكثم الخزاعي ضبطه","citation":"الإصابة في تمييز الصحابة (1/ 593)","pageId":415791,"verdict":"unclassified"},{"text":"صحابي","citation":"تقريب التهذيب (1/ 174)","pageId":508335,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"له صحبة","citation":"تهذيب الكمال (4/ 189)","pageId":442090,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"970":{"id":970,"criticCount":3,"statementCount":5,"tal