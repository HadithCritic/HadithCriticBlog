{"5450":{"id":5450,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 494)","pageId":477886,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (24/ 334)","pageId":453033,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 821)","pageId":519744,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 77)","pageId":499599,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"5454":{"id":5454,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مستور","citation":"تقريب التهذيب (1/ 856)","pageId":520380,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5467":{"id":5467,"criticCount":3,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 849)","pageId":520248,"verdict":"unclassified"}]},{"critic":"محمد بن إسحاق ابن منده","statements":[{"text":"ذكره ابن منده","citation":"الإصابة في تمييز الصحابة (10/ 27)","pageId":430783,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"وهكذا قال غير واحد، عن مكحول، وهو المحفوظ","citation":"تهذيب الكمال (25/ 284)","pageId":453498,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"5469":{"id":5469,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":1,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 852)","pageId":520308,"verdict":"jarh"}]},{"critic":"ابن حبان","statements":[{"text":"روى له الترمذي حديثا واحدا من رواية ابن عيينة عن إبراهيم بن ميسرة، عن ابن أبي سويد، عن عمر بن عبد العزيز، عن خولة بنت حكيم في الولد مبخلة مجبنة. هكذا رواه الترمذي عن ابن أبي عمر عن ابن عيينة، ولم يسمه، وسماه في موضع آخر محمد بن سويد، وذلك في الحديث، رواه معمر عن الزهري عن سالم عن أبيه أن غيلان أسلم وله عشر نسوة، قال: سمعت محمدا يقول: هذا غير محفوظ، والصحيح ما رواه شعيب وغيره عن الزهري قال: حدثت عن محمد بن سويد الثقفي أن غيلان أسلم، فذكره. قلت: لم يتبين لي أن ابن أبي سويد المبهم في الرواية الأولى هو محمد بن سويد راوي قصة غيلان، ولم يذكر المؤلف دليلا على ذلك، وقد قال ابن حبان في \" الثقات \": محمد بن أبي سويد الثقفي يروي عن جده سفيان بن عبد الله الثقفي، روى عنه الزهري في رواية يونس بن يزيد عنه، وقال إبراهيم بن سعد: عن الزهري، عن محمد بن عبد الرحمن بن ماعز، عن سفيان بن عبد الله. وقال الزبيدي، ومعمر عن الزهري، عن عبد الله بن ماعز، عن سفيان بن عبد الله. قال: والقلب إلى رواية يونس أميل. انتهى. والذي يخيل لي أن ابن أبي سويد المبهم في الرواية الأولى ليس هو هذا المختلف فيه على الزهري، والله أعلم","citation":"تهذيب التهذيب (3/ 584)","pageId":478489,"verdict":"mixed"}]}],"phenomena":[],"flags":[]},"5477":{"id":5477,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 823)","pageId":519772,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"5480":{"id":5480,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (24/ 346)","pageId":453051,"verdict":"tadil"},{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 496)","pageId":477904,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 822)","pageId":519764,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"5487":{"id":5487,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":4,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (24/ 399)","pageId":453079,"verdict":"tadil"},{"text":"وذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (3/ 503)","pageId":477936,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 824)","pageId":519788,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 81)","pageId":499625,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"5493":{"id":5493,"criticCount":4,"statementCount":7,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":2},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"وأبو حاتم، وقال: صدوق","citation":"تهذيب التهذيب (3/ 514)","pageId":477960,"verdict":"tadil"},{"text":"قال أبو حاتم: صدوق","citation":"تهذيب الكمال (24/ 482)","pageId":453103,"verdict":"tadil"},{"text":"نا عبد الرحمن قال: سئل أبي عنه فقال: صدوق","citation":"الجرح والتعديل لابن أبي حاتم (7/ 190)","pageId":710320,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 826)","pageId":519814,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"سمع عبد الرزاق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 85)","pageId":499645,"verdict":"unclassified"},{"text":"صدوق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 85)","pageId":499645,"verdict":"tadil"}]},{"critic":"أبو الحسن بن بانويه","statements":[{"text":"ذكره أبو الحسن بن بانويه في تاريخ الري، وقال: روى عن أبي جعفر محمد بن علي بن موسى الكاظم. روى عنه أبو سعيد سهل بن زياد الآدمي، كان من غلاة الشيعة","citation":"لسان الميزان (6/ 576)","pageId":556480,"verdict":"unclassified"}]}],"phenomena":[{"key":"إثبات سماع الراوي","label":"Audition Established","statements":[{"text":"سمع عبد الرزاق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (4/ 85)","pageId":499645}]}],"flags":[]}}