{"3954":{"id":3954,"criticCount":6,"statementCount":7,"tally":{"jarh":0,"tadil":5,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 445)","pageId":472851,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (16/ 222)","pageId":448514,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 552)","pageId":514970,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (3/ 207)","pageId":496151,"verdict":"tadil"}]},{"critic":"العجلي","statements":[{"text":"وقال العجلي: يمامي ثقة","citation":"تهذيب التهذيب (2/ 445)","pageId":472851,"verdict":"tadil"}]},{"critic":"يحيى بن معين","statements":[{"text":"وقال عثمان الدارمي: وسألته - يعني ابن معين - فقلت: عبد الله بن النعمان عن قيس بن طلق ؟ فقال: يمامية ثقات","citation":"تهذيب التهذيب (2/ 445)","pageId":472851,"verdict":"tadil"}]},{"critic":"ابن خزيمة","statements":[{"text":"وقال ابن خزيمة: لا أعرفه بعدالة ولا جرح","citation":"تهذيب التهذيب (2/ 445)","pageId":472851,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"3957":{"id":3957,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 553)","pageId":514989,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"3958":{"id":3958,"criticCount":3,"statementCount":6,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حجر","statements":[{"text":"وقد أخرج البخاري في \" الأدب المفرد \"، وأبو داود من رواية صفوان بن عيسى، عن عبد الله بن هارون، عن زياد بن سعد حديثا. فيجوز أن يكون هذا","citation":"لسان الميزان (5/ 27)","pageId":551988,"verdict":"unclassified"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 553)","pageId":514987,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"ليس بالقوي","citation":"لسان الميزان (5/ 27)","pageId":551988,"verdict":"jarh"}]},{"critic":"ابن عدي","statements":[{"text":": ذكر ابن عدي في « الكامل »: عبد الله بن هارون البجلي الكوفي، روى عن ليث بن أبي سليم، وزياد بن سعد، وأبان بن أبي عياش، وعنه: حاتم بن إسماعيل، وصفوان بن عيسى، وساق له ثلاثة أحاديث عن هؤلاء الثلاثة، ثم قال: لم أر له غير هذه. وفيها بعض الإنكار، ولم أر للمتقدمين فيه كلاما. فيجوز أن يكون هو المذكور، فلعله كوفي سكن الحجاز أو بالعكس","citation":"تهذيب التهذيب (2/ 447)","pageId":472867,"verdict":"unclassified"},{"text":"قال ابن عدي: كوفي، روى عنه حاتم، وصفوان بن عيسى، وفي أحاديثه بعض النكرة","citation":"لسان الميزان (5/ 27)","pageId":551988,"verdict":"unclassified"},{"text":"ولم أر لعبد الله بن هارون هذا غير هذه الأحاديث التي ذكرتها، ولعل له غيرها، وفي هذه الأحاديث التي ذكرتها بعض الإنكار وقد شرطت في كتابي هذا أني أذكر كل من في رواياته اضطراب وفي متونه مناكير، وأذكره وأبين أمره، ولم أر للمتقدمين في عبد الله كلاما فأذكره","citation":"الكامل في الضعفاء (5/ 426)","pageId":576569,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"3962":{"id":3962,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 554)","pageId":514993,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"3967":{"id":3967,"criticCount":3,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 555)","pageId":515018,"verdict":"jarh"}]},{"critic":"البزار","statements":[{"text":"وهذا الحديث لا نعلمه يروى عن رسول الله صلى الله عليه وسلم بهذا اللفظ إلا من هذا الوجه بهذا الإسناد، وعبد الله بن واقد لم يكن بالحافظ، وقد حدث عنه جماعة كثيرة من أهل العلم، وعبد الله بن واقد كان حراني عفيف كذا في المطبوع: وقال المحقق: كذا بالأصل وهو تصحيف وصوابه: (حرانيا عفيفا).، وكان حافظا متفقها بقول أبي حنيفة وكان يغلط فيلقن الصواب فلا يرجع وكان يكنى أبا قتادة وكان قاضيا","citation":"مسند البزار (11/ 129)","pageId":200364,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"واه","citation":"الكاشف في معرفة من له رواية في الكتب الستة (3/ 210)","pageId":496189,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"3971":{"id":3971,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (16/ 266)","pageId":448565,"verdict":"tadil"},{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 452)","pageId":472907,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 555)","pageId":515026,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"ثقة","citation":"الكاشف في معرفة من له رواية في الكتب الستة (3/ 211)","pageId":496193,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"3977":{"id":3977,"criticCount":1,"statementCount":2,"tally":{"jarh":1,"tadil":1,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول الحال","citation":"تقريب التهذيب (1/ 556)","pageId":515047,"verdict":"jarh"},{"text":"قلت: ذكر ابن حبان في « الثقات » عبد الرحمن بن أمين ؛ فلا أدري هو ذا ؟ أم هو أخوه ؟","citation":"تهذيب التهذيب (2/ 455)","pageId":472927,"verdict":"tadil"}]}],"phenomena":[],"flags":[]},"3978":{"id":3978,"criticCount":3,"statementCount":5,"tally":{"jarh":1,"tadil":4,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 456)","pageId":472935,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (16/ 296)","pageId":448592,"verdict":"tadil"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"لسان الميزان (9/ 348)","pageId":569139,"verdict":"tadil"},{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (3/ 213)","pageId":496213,"verdict":"tadil"}]},{"