{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 621)","pageId":516207,"verdict":"jarh"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"، ثنا عبد الرحمن، قال: سألت أبي عنه، فقال: مجهول","citation":"الجرح والتعديل لابن أبي حاتم (5/ 345)","pageId":702346,"verdict":"jarh"},{"text":"قال أبو حاتم: مجهول","citation":"تهذيب التهذيب (2/ 609)","pageId":474133,"verdict":"jarh"},{"text":"قال أبو حاتم: مجهول","citation":"تهذيب الكمال (18/ 295)","pageId":449679,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"4017":{"id":4017,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 621)","pageId":516209,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"4018":{"id":4018,"criticCount":2,"statementCount":3,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 622)","pageId":516213,"verdict":"unclassified"}]},{"critic":"عثمان بن عبد الله الطبرستانى","statements":[{"text":"قال أبو بكر محمد بن بركة بن الفرداج القنسريني، قلت لعثمان بن خرزاذ: من أصحاب أبي إسحاق الفزاري المتقدمون ؟ قال: معاوية بن عمرو الكوفي، وعبد الملك بن حبيب البزاز، وأبو عثمان الصياد، وأبو صالح الفراء","citation":"تهذيب الكمال (18/ 300)","pageId":449685,"verdict":"unclassified"},{"text":"قال محمد بن بركة، عن عثمان بن خرزاذ: هو من متقدمي أصحاب أبي إسحاق الفزاري","citation":"تهذيب التهذيب (2/ 610)","pageId":474139,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"4031":{"id":4031,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 623)","pageId":516245,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"4032":{"id":4032,"criticCount":3,"statementCount":4,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"الذهبى","statements":[{"text":"شيخ","citation":"الكاشف في معرفة من له رواية في الكتب الستة (3/ 325)","pageId":497057,"verdict":"unclassified"}]},{"critic":"علي ابن المديني","statements":[{"text":"قال ابن المديني: هو رجل مجهول","citation":"تهذيب التهذيب (2/ 619)","pageId":474185,"verdict":"jarh"},{"text":"نا عبد الرحمن، نا محمد بن أحمد بن البراء قال: قال ابن المديني: عبد الملك بن عبيد الذي يروي عنه عمران بن حدير مجهول","citation":"الجرح والتعديل لابن أبي حاتم (5/ 358)","pageId":702477,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول الحال","citation":"تقريب التهذيب (1/ 625)","pageId":516261,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"4039":{"id":4039,"criticCount":4,"statementCount":5,"tally":{"jarh":5,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 625)","pageId":516271,"verdict":"jarh"}]},{"critic":"الأزدي","statements":[{"text":"وقال الأزدي: عبد الملك بن علاق متروك","citation":"تهذيب التهذيب (2/ 621)","pageId":474195,"verdict":"jarh"},{"text":"قال الأزدي - فيما ذكره ابن الجوزي - متروك الحديث","citation":"إكمال تهذيب الكمال (8/ 333)","pageId":538195,"verdict":"jarh"}]},{"critic":"الترمذي","statements":[{"text":"روى له الترمذي حديثا واحدا، وقد وقع لنا بعلو عنه. أخبرنا به أبو إسحاق ابن الدرجي، قال: أنبأنا أبو جعفر الصيدلاني، قال: أخبرنا أبو علي الحداد، قال: أخبرنا أبو نعيم الحافظ، قال: حدثنا محمد بن إبراهيم. (ح) : وأخبرنا أبو الفضل أحمد بن هبة الله بن أحمد، قال: أنبأنا أبو روح عبد المعز بن محمد الهروي، قال: أخبرنا تميم بن أبي سعيد الجرجاني، قال: أخبرنا أبو سعد الكنجروذي، قال: أخبرنا أبو عمرو بن حمدان. قالا: أخبرنا أبو يعلى الموصلي، قال: حدثنا محمد بن بحر، قال: حدثنا محمد بن يعلى، قال: حدثنا عنبسة بن عبد الرحمن، عن عبد الملك بن علاق، عن أنس بن مالك قال: قال رسول الله صلى الله عليه وسلم: \" تعشوا ولو بكف من حشف، فإن ترك العشاء مهرمة \". رواه عن يحيى بن موسى، عن محمد بن يعلى السلمي، فوقع لنا بدلا عاليا، وقال: منكر لا نعرفه إلا من هذا الوجه، وعنبسة يضعف في الحديث، وعبد الملك مجهول","citation":"تهذيب الكمال (18/ 376)","pageId":449737,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"مجهول","citation":"الكاشف في معرفة من له رواية في الكتب الستة (3/ 326)","pageId":497067,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"4041":{"id":4041,"criticCount":4,"statementCount":5,"tally":{"jarh":0,"tadil":3,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في « الثقات »","citation":"تهذيب التهذيب (2/ 619)","pageId":474189,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات","citation":"تهذيب الكمال (18/ 363)","pageId":449731,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 625)","pageId":516265,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"وثق","citation":"الكاشف في معرفة من له رواية في الكتب الستة (3/ 325)","pageId":497061,"verdict":"tadil"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع هرمي بن عبد الله. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (5/ 359)","pageId":702487,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"4048":{"id":4048,"criticCount":3,"statementCount":4,"tally":{"jarh":4,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"أبو داود السجستاني","statements":[{"text":"روى له أبو داود حديثا واحدا منقطعا وضعفه","citation":"تهذيب التهذيب (2/ 623)","pageId":474215,"verdict":"jarh"},{"text":"ضعفه أبو داود","citation":"الكاشف في معرفة من له رواية في الكتب الستة (3/ 327)","pageId":497081,"verdict":"jarh"}]},{"critic":"ابن القطان الفاسي","statements":[{"text":"وقال أبو الحسن بن القطان: حاله مجهولة، وقد يغلط فيه من لا يعرف بمحمد بن عبد الملك بن أيمن الأندلسي","citation":"تهذيب التهذيب (2/ 623)","pageId":474215,"verdict":"jarh"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 626)","pageId":516291,"verdict":"jarh"}]}],"phenomena":[],"flags":[]}}