{"11250":{"id":11250,"criticCount":3,"statementCount":4,"tally":{"jarh":2,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"، وقال: روى عن ابن عباس","citation":"تهذيب التهذيب (4/ 534)","pageId":484363,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \" وقال: روى عن ابن عباس","citation":"تهذيب الكمال (33/ 389)","pageId":459014,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1157)","pageId":526089,"verdict":"jarh"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"مجهول","citation":"لسان الميزان (9/ 471)","pageId":573026,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"11251":{"id":11251,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1158)","pageId":526107,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"سأل ابن عمر","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 58)","pageId":504031,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11253":{"id":11253,"criticCount":4,"statementCount":5,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":5},"critics":[{"critic":"أبو أحمد الحاكم","statements":[{"text":"قال أبو أحمد الحاكم: عداده في موالي رسول الله - صلى الله عليه وسلم - وله صحبة","citation":"الإصابة في تمييز الصحابة (12/ 313)","pageId":435621,"verdict":"unclassified"}]},{"critic":"خليفة بن خياط","statements":[{"text":"وذكره خليفة بن خياط في تسمية الصحابة من موالي بني هاشم","citation":"الإصابة في تمييز الصحابة (12/ 313)","pageId":435621,"verdict":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وروى أبو داود حديثه، والنسائي من رواية سابق، عن أبي سلام، عن رجل خدم النبي صلى الله عليه وآله وسلم، وهو الصواب، وأبو سلام هو الأسود ممطور","citation":"تهذيب التهذيب (4/ 535)","pageId":484396,"verdict":"unclassified"},{"text":"وقد وقع في هذا السند خطأ آخر بينته في ترجمة سابق من حرف السين من القسم الأخير، وحديث شعبة في هذا هو المحفوظ، وأبو سلام المذكور هو ممطور الحبشي، وهو تابعي","citation":"الإصابة في تمييز الصحابة (12/ 313)","pageId":435621,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"وهذا هو الصحيح، وهو أبو سلام الأسود","citation":"تهذيب الكمال (33/ 396)","pageId":459043,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11254":{"id":11254,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"المزي","statements":[{"text":"وروي عن أبي صالح الأشعري، عن أبي هريرة، وعنه، عن كعب الأحبار. وهذا يدل على أن أبا صالح هذا والذي قبله واحد، والله أعلم","citation":"تهذيب الكمال (33/ 414)","pageId":459107,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11255":{"id":11255,"criticCount":4,"statementCount":4,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (33/ 415)","pageId":459111,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1161)","pageId":526191,"verdict":"unclassified"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"لسان الميزان (9/ 472)","pageId":573064,"verdict":"unclassified"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"نا عبد الرحمن قال: سئل أبو زرعة عن أبي صالح الحادي فقال: روى عنه أبو قلابة، لا يعرف اسمه","citation":"الجرح والتعديل لابن أبي حاتم (9/ 392)","pageId":720749,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11256":{"id":11256,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"قلت: وروى أبو إسحاق السبيعي عن أبي الصلت عن عمر حديثا آخر، فجوز أبو أحمد أن يكونا واحدا، وقد فرق بينهما البخاري","citation":"تهذيب التهذيب (4/ 540)","pageId":484544,"verdict":"unclassified"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 1163)","pageId":526251,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11262":{"id":11262,"criticCount":4,"statementCount":5,"tally":{"jarh":3,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"هو إبراهيم بن عبد الرحمن بن عبد الله [207]، وإلا فمجهول","citation":"تقريب التهذيب (1/ 1169)","pageId":526363,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"لا يعرف","citation":"الكاشف في معرفة من له رواية في الكتب الستة (5/ 69)","pageId":504210,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"وأما أبو عائذ الله فمجهول ليس بمعروف","citation":"تهذيب الكمال (34/ 16)","pageId":459277,"verdict":"jarh"},{"text":"الزهري (س) مقرونا بعروة بن الزبير","citation":"تهذيب الكمال (34/ 458)","pageId":460987,"verdict":"unclassified"}]},{"critic":"محمد بن يحيى الذهلي","statements":[{"text":"قال الذهلي: وهذه الوجوه كلها محفوظة إلا قول ابن مسافر غير أني لست أقف على هذا الرجل المقرون مع عروة، إلا أني أتوهم أنه إبراهيم بن عبد الرحمن بن عبد الله بن أبي ربيعة المخزومي، وأمه أم كلثوم بنت أبي بكر ؛ فإن الزهري قد روى عنه حديثين، وهذا مراد يونس، ويحيى بن سعيد بقولهما عن ابن عبد الله بن أبي ربيعة فيما أظن، إلى أن قال: وأما أبو عائذ الله فمجهول لا يعرف","citation":"تهذيب التهذيب (4/ 545)","pageId":484667,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"11264":{"id":11264,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":2,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 547)","pageId":484694,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"، وقال: روى عن أبيه","citation":"تهذيب الكمال (34/ 23)","pageId":459301,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1170)","pageId":526387,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"11267":{"id":11267,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ا