":"unclassified"}]},{"critic":"ابن حجر","statements":[{"text":"وحديثه مرسل","citation":"تقريب التهذيب (1/ 1176)","pageId":526529,"verdict":"unclassified"},{"text":"أرسل حديثا","citation":"تهذيب التهذيب (4/ 553)","pageId":484847,"verdict":"unclassified"},{"text":"مجهول","citation":"تقريب التهذيب (1/ 1176)","pageId":526529,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"أرسل، وعنه ابن جريج، لا يدري من هو","citation":"لسان الميزان (9/ 475)","pageId":573146,"verdict":"unclassified"}]},{"critic":"المزي","statements":[{"text":"له حديث مرسل يرويه عنه ابن جريج (مد) قال: لم يزل يعمل به، ويرفعونه إلى النبي صلى الله عليه وسلم: \" إن الرجل إذا ولد له الولد بعد ما يخرج من أرض المسلمين وأرض الصلح حتى يكون بأرض العدو، وإن كان ذلك أول ما دخلها، فإن لذلك المولود سهما مع المسلمين \" - قال: وسموا الرجل الذي قضى به النبي صلى الله عليه وسلم لولده - \" وأن الرجل إذا مات بعد ما دخل أرض العدو وخرج من أرض المسلمين وأرض الصلح، فإن سهمه لأهله \"","citation":"تهذيب الكمال (34/ 69)","pageId":459435,"verdict":"unclassified"}]}],"phenomena":[{"key":"الإرسال","label":"Irsal (Mursal Transmission)","statements":[{"text":"تابعي، أرسل عن النبي - صلى الله عليه وسلم - رواه أبو داود في المراسيل","citation":"تحفة التحصيل في المراسيل (1/ 618)","pageId":682320},{"text":"أرسل حديثا","citation":"تهذيب التهذيب (4/ 553)","pageId":484847},{"text":"وحديثه مرسل","citation":"تقريب التهذيب (1/ 1176)","pageId":526529}]}],"flags":["Sends Mursal Reports"]},"11280":{"id":11280,"criticCount":1,"statementCount":1,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":0},"critics":[{"critic":"ابن حجر","statements":[{"text":"قال أبو داود: أظنه جسر بن الحسن [930]، وإلا فمجهول","citation":"تقريب التهذيب (1/ 1177)","pageId":526553,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"11281":{"id":11281,"criticCount":2,"statementCount":4,"tally":{"jarh":0,"tadil":2,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حبان","statements":[{"text":"ذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 555)","pageId":484881,"verdict":"tadil"},{"text":"ذكره ابن حبان في كتاب \" الثقات \"","citation":"تهذيب الكمال (34/ 82)","pageId":459467,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1177)","pageId":526561,"verdict":"unclassified"},{"text":"وجعل بعضهم هو والذي قبله واحدا","citation":"تقريب التهذيب (1/ 1177)","pageId":526561,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11286":{"id":11286,"criticCount":1,"statementCount":1,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1180)","pageId":526619,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11287":{"id":11287,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"فمجهول","citation":"تقريب التهذيب (1/ 1183)","pageId":526677,"verdict":"jarh"}]},{"critic":"أبو داود السجستاني","statements":[{"text":"قال الآجري: سألت أبا داود عن سعيد بن أبي سلمة بن أبي الحسام، فقال كلاما، ثم قال: وروى عنه أبو عامر العقدي، فقال: حدثنا أبو عمرو المديني [يعني ابن أبي الحسام]. قلت: وروى أبو محمد بن صاعد في الجزء الخامس من حديثه، حدثنا محمد بن معمر القيسي، حدثنا أبو عامر العقدي، حدثنا أبو عمرو السدوسي، أخبرني عبد الله بن أبي بكر بن حزم فذكر حديثا آخر. قال ابن صاعد: أبو عمرو السدوسي هو سعيد بن سلمة، حدثنا هشام بن علي السيرافي بالبصرة، حدثنا عبد الله بن رجاء، حدثنا سعيد بن سلمة بن أبي الحسام، حدثني عبد الله بن أبي بكر، فذكر ذلك الحديث بعينه، فتعين أن أبا عمرو المديني السدوسي المذكور هو سعيد بن سلمة، كما أشار إليه أبو داود، والله تعالى أعلم","citation":"تهذيب التهذيب (4/ 563)","pageId":485003,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11289":{"id":11289,"criticCount":2,"statementCount":2,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 1184)","pageId":526707,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"بخبر معلل","citation":"لسان الميزان (9/ 478)","pageId":573223,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11290":{"id":11290,"criticCount":5,"statementCount":5,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":4},"critics":[{"critic":"أبو حاتم الرازي","statements":[{"text":"نا عبد الرحمن قال: سمعت أبي يقول: لا يسمى، فقلت: ما حاله ؟ فقال: شيخ","citation":"الجرح والتعديل لابن أبي حاتم (9/ 419)","pageId":721140,"verdict":"unclassified"}]},{"critic":"ابن حبان","statements":[{"text":"وذكره ابن حبان في \" الثقات \"","citation":"تهذيب التهذيب (4/ 566)","pageId":485050,"verdict":"tadil"}]},{"critic":"ابن حجر","statements":[{"text":"مقبول","citation":"تقريب التهذيب (1/ 1185)","pageId":526717,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"نا عبد الرحمن قال: قرئ على العباس بن محمد الدوري قال: قال يحيى بن معين: أبو العنبس الذي يروي عنه شعبة ومسعر لا أعرف اسمه","citation":"الجرح والتعديل لابن أبي حاتم (9/ 419)","pageId":721140,"verdict":"unclassified"}]},{"critic":"أبو زرعة الرازي","statements":[{"text":"قال أبو زرعة: لا يعرف اسمه","citation":"الجرح والتعديل لابن أبي حاتم (9/ 419)","pageId":721140,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11295":{"id":11295,"criticCount":2,"statementCount":3,"tally":{"jarh":1,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"وعنه: ثابت بن محمد البغدادي يحتمل أن يكون هو الباهلي","citation":"تهذيب التهذيب (4/ 570)","pageId":485129,"verdict":"unclassified"},{"text":"، وإلا فمجهول","citation":"تقريب التهذيب (1/ 1188)","pageId":526790,"verdict":"jarh"}]},{"critic":"المزي","statements":[{"text":"ثابت بن محمد العبدي (ق). لا أدري هو الباهلي أو غيره","citation":"تهذيب الكمال (34/ 173)","pageId":459688,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11296":{"id":11296,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":4},"critics":[{"critic":"ابن حجر","statements":[{"text":"مستور","citation":"تقريب التهذيب (1/ 1188)","pageId":526792,"verdict":"unclassified"}]},{"critic":"يحيى بن معين","statements":[{"text":"قال ابن معين: لا أعرفه","citation":"تهذيب التهذيب (4/ 570)","pageId":485131,"verdict":"unclassified"},{"text":"قال يحيى بن معين: لا أعرف أبا غالب هذا","citation":"تهذيب الكمال (34/ 173)","pageId":459690,"verdict":"unclassified"}]},{"critic":"أبو حاتم الرازي","statements":[{"text":"سمع ابن عمر. روى عنه: أبو سنان. سمعت أبي يقول ذلك","citation":"الجرح والتعديل لابن أبي حاتم (9/ 421)","pageId":721187,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"11299":{"id":11299,"criticCount":1,"statementCount":2,"tally":{"jarh":0,"tadil":0,"mixed":0,"unclassified":2},"critics":[{"critic":"ابن حجر","statements":[{"text":"أكثر عنه محمد بن نصر المروزي","citation":"تهذيب التهذيب (4/ 575)","pageId":485240,"verdict":"unclassified"},{"text":"مقبول","citation":"تقريب التهذيب (1/ 1193)","pageId":526888,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]}}