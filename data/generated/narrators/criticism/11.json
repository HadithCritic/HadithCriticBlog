{"558":{"id":558,"criticCount":3,"statementCount":3,"tally":{"jarh":2,"tadil":0,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"مجهول","citation":"تقريب التهذيب (1/ 131)","pageId":507526,"verdict":"jarh"}]},{"critic":"الذهبى","statements":[{"text":"يجهل","citation":"الكاشف في معرفة من له رواية في الكتب الستة (2/ 101)","pageId":490434,"verdict":"unclassified"}]},{"critic":"مسلمة بن القاسم","statements":[{"text":"قال مسلمة بن قاسم الأندلسي: إسحاق بن أبي الفرات مجهول","citation":"تهذيب التهذيب (1/ 126)","pageId":464794,"verdict":"jarh"}]}],"phenomena":[],"flags":[]},"560":{"id":560,"criticCount":3,"statementCount":4,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":3},"critics":[{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب التهذيب (1/ 128)","pageId":507442,"verdict":"tadil"}]},{"critic":"البخاري","statements":[{"text":"قال في « الزهرة »: روى عنه البخاري أربعة أحاديث","citation":"إكمال تهذيب الكمال (2/ 85)","pageId":532055,"verdict":"unclassified"},{"text":"روى البخاري عن إسحاق بن أبي عيسى عن يزيد بن هارون، فقيل: هو هذا، وقيل: إسحاق بن منصور بن الكوسج. قلت: قال أبو علي الجياني في شيوخ أبي داود: إسحاق بن جبريل، وهو ابن أبي عيسى، حدث عنه البخاري، وهذا أخذه من الكلاباذي، فإنه جزم به ابن منده فقال: إسحاق بن أبي عيسى البخاري، واسم ابن أبي عيسى جبرئيل، كذا نسبه بخاريا، وكأنه سكن بغداد. وقال أبو الوليد الباجي في رجال البخاري: الأشبه بالصواب أنه ابن أبي عيسى جبرئيل. انتهى. وما له في البخاري سوى موضع واحد في كتاب التوحيد","citation":"تهذيب التهذيب (1/ 117)","pageId":464712,"verdict":"unclassified"}]},{"critic":"ابن عدي","statements":[{"text":"وقال الحافظ أبو أحمد بن عدي في « أسماء رجال البخاري »: بغدادي أو واسطي، وليس بالمعروف","citation":"إكمال تهذيب الكمال (2/ 85)","pageId":532055,"verdict":"unclassified"}]}],"phenomena":[],"flags":[]},"562":{"id":562,"criticCount":2,"statementCount":2,"tally":{"jarh":0,"tadil":1,"mixed":0,"unclassified":1},"critics":[{"critic":"ابن حجر","statements":[{"text":"صدوق","citation":"تقريب ا