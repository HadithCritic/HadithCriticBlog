---
import BaseLayout from '../../layouts/BaseLayout.astro';

// We can define the mock blog post data here
const posts = [
  {
    title: "The Abbasid Mahdi",
    subtitle: "The Black Banners & Abu Abbas al-Saffah",
    description: "A study of black-banner prophecy reports, Abbasid political memory, and how apocalyptic narration can serve dynastic legitimacy.",
    category: "Hadith Prophecies",
    date: "Jan 18, 2025",
    readingTime: "14 min read",
    url: "/blogs/the-abbasid-mahdi",
    thumbnail: "/images/blog_thumbnails/tn.abbasidmahdi.png"
  }
];
---
<BaseLayout title="Journal & Essays | HadithCritic">
  <main class="blog-index">
    <section class="index-hero">
      <div class="hc-container">
        <h1 class="hc-title hc-title--xl">Journal & Essays</h1>
        <p class="hc-copy" style="max-width: 600px; font-size: 1.2rem; margin-top: 1rem; color: var(--hc-muted);">
          Critical studies, transmission forensics, and historical analyses of prophetic reports and early Islamic source texts.
        </p>
      </div>
    </section>

    <section class="index-grid hc-container">
      <div class="post-grid">
        {posts.map((post) => (
          <a href={post.url} class="post-card">
            {post.thumbnail && <div class="post-card-image" style={`background-image: url('${post.thumbnail}');`}></div>}
            <div class="post-card-content">
              <span class="hc-chip" style="margin-bottom: 1.5rem; display: inline-block;">{post.category}</span>
              <h2 class="hc-title" style="font-size: 1.8rem; margin-bottom: 0.5rem; color: var(--hc-parchment);">{post.title}</h2>
              <h3 class="hc-title" style="font-size: 1.1rem; color: var(--hc-gold); margin-bottom: 1rem;">{post.subtitle}</h3>
              <p class="hc-copy" style="font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">{post.description}</p>
              
              <div class="post-meta">
                <span class="hc-eyebrow">{post.date}</span>
                <span class="hc-eyebrow" style="color: var(--hc-rule-strong);">•</span>
                <span class="hc-eyebrow">{post.readingTime}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .blog-index {
    min-height: 100vh;
    background: radial-gradient(circle at 100% 0%, rgba(216, 177, 102, 0.05), transparent 40%), var(--hc-black);
  }
  
  .index-hero {
    padding: 8rem 0 4rem;
    border-bottom: 1px solid var(--hc-rule);
    background: linear-gradient(180deg, rgba(15, 15, 16, 0.8), var(--hc-black));
  }

  .index-grid {
    padding: 4rem 1rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    background: linear-gradient(145deg, rgba(30, 29, 27, 0.6), rgba(20, 19, 18, 0.8));
    transition: transform 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
    overflow: hidden;
    position: relative;
    height: 100%;
  }

  .post-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--hc-gold), transparent);
    opacity: 0;
    transition: opacity 300ms;
    z-index: 2;
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--hc-gold-dim);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
  }

  .post-card:hover::before {
    opacity: 1;
  }

  .post-card-image {
    height: 220px;
    width: 100%;
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .post-card-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-meta {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hc-rule-soft);
  }
</style>
