---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('articles', ({ data }) => !data.draft && !data.preview);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}

const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const entries = posts.map((post, index) => ({
  post,
  folio: String(posts.length - index).padStart(3, '0'),
  dateLabel: formatDate(post.data.date),
  dateISO: post.data.date.toISOString().slice(0, 10)
}));
---

<BaseLayout
  title="Blogs & Analysis | HadithCritic"
  description="Critical studies, transmission forensics, and historical analyses of prophetic reports and early Islamic source texts."
>
  <div class="archive-page">
    <header class="archive-hero" aria-labelledby="archive-title">
      <div class="hc-container archive-hero__inner">
        <p class="hc-eyebrow archive-hero__label">The HadithCritic Index</p>
        <h1 id="archive-title" class="archive-hero__title">
          Blogs <em>&amp;</em> Analysis
        </h1>
        <div class="archive-hero__meta" aria-label="Archive statistics">
          <span>{posts.length} entries</span>
          <span class="archive-hero__diamond" aria-hidden="true"></span>
          <span>{categories.length} categories</span>
          <span class="archive-hero__diamond" aria-hidden="true"></span>
          <span>Last entry {entries[0]?.dateLabel}</span>
        </div>
        <p class="archive-hero__lead">
          Critical studies, transmission forensics, and historical analyses of prophetic
          reports and early Islamic source texts. Every entry is catalogued below.
        </p>
      </div>
    </header>

    <div class="archive-tools" role="region" aria-label="Filter the index">
      <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress__bar" id="scroll-bar"></div></div>
      <div class="hc-container archive-tools__inner">
        <div class="archive-filters" style="position:relative;" role="group" aria-label="Filter by category">
          <button type="button" class="filter-tab is-active" data-filter="all">
            All <span class="filter-tab__count">{posts.length}</span>
          </button>
          {categories.map((category) => (
            <button type="button" class="filter-tab" data-filter={category.name} data-category={category.name}>
              {category.name} <span class="filter-tab__count">{category.count}</span>
            </button>
          ))}
          <div class="filter-indicator" aria-hidden="true"></div>
        </div>

        <label class="archive-search">
          <kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
          <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <span class="sr-only">Search entries by title</span>
          <input type="search" id="archive-search-input" data-shortcut="k" placeholder="Search the index" autocomplete="off" />
        </label>
      </div>
    </div>

    <section class="archive-ledger hc-container" aria-label="All entries">
      <ol class="ledger" id="ledger">
        {entries.map(({ post, folio, dateLabel, dateISO }, index) => (
          <li
            class="ledger-row"
            data-category={post.data.category}
            data-title={post.data.title.toLowerCase()}
            style={`--row-index: ${Math.min(index, 14)}`}
          >
            <a href={`/blogs/${post.id}`} class="ledger-row__link">
              <span class="ledger-row__folio">
                <span class="ledger-row__no">No. {folio}</span>
                <time class="ledger-row__date" datetime={dateISO}>{dateLabel}</time>
              </span>

              <span class="ledger-row__body">
                <span class="ledger-row__title">{post.data.title}</span>
                {post.data.description && (
                  <span class="ledger-row__desc">{post.data.description}</span>
                )}
              </span>

              <span class="ledger-row__aside">
                <span class="ledger-row__cat" data-category={post.data.category}>{post.data.category}</span>
                <span class="ledger-row__arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ol>

      <p class="ledger-empty" id="ledger-empty" hidden>
        No entries match this filter. Clear the search or choose another category.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector('.archive-page');

  if (page) {
    const chips = [...page.querySelectorAll<HTMLButtonElement>('.filter-tab')];
    const rows = [...page.querySelectorAll<HTMLLIElement>('.ledger-row')];
    const searchInput = page.querySelector<HTMLInputElement>('#archive-search-input');
    const emptyState = page.querySelector<HTMLParagraphElement>('#ledger-empty');

    
    const track = page.querySelector('.archive-filters');
    const indicator = page.querySelector<HTMLElement>('.filter-indicator');
    
    const updateIndicator = (activeTab: HTMLElement) => {
      if (!indicator || !track || !activeTab) return;
      // Use relative offset
      indicator.style.transform = `translateX(${activeTab.offsetLeft}px)`;
      indicator.style.width = `${activeTab.offsetWidth}px`;
    };

    // Initialize on load and resize
    const initIndicator = () => {
      const current = track?.querySelector<HTMLElement>('.is-active');
      if (current) updateIndicator(current);
    };
    // Call once initially (after fonts load or timeout to ensure layout)
    setTimeout(initIndicator, 50);
    window.addEventListener('resize', initIndicator);

    // Keyboard shortcut handler
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    // Scroll progress handler
    const ledgerList = document.getElementById('ledger');
    const scrollBar = document.getElementById('scroll-bar');
    if (ledgerList && scrollBar) {
      window.addEventListener('scroll', () => {
        const rect = ledgerList.getBoundingClientRect();
        // Calculate progress based on ledger position relative to viewport
        const total = ledgerList.scrollHeight - window.innerHeight + 200; // rough offset
        let current = -rect.top;
        if (current < 0) current = 0;
        let progress = (current / total) * 100;
        if (progress > 100) progress = 100;
        if (progress < 0) progress = 0;
        
        // Only show if we actually reached the ledger
        scrollBar.style.width = `${progress}%`;
      }, { passive: true });
    }

    let activeCategory = 'all';
    let query = '';

    const setActiveChip = (category: string) => {
      const chip = chips.find((c) => c.dataset.filter === category);
      if (!chip) return false;
      activeCategory = category;
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      updateIndicator(chip);
      return true;
    };

    const syncUrl = () => {
      const url = new URL(location.href);
      if (activeCategory === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', activeCategory);
      }
      history.replaceState(null, '', url);
    };

    const applyFilters = () => {
      let visible = 0;

      for (const row of rows) {
        const matchesCategory = activeCategory === 'all' || row.dataset.category === activeCategory;
        const matchesQuery = !query || (row.dataset.title ?? '').includes(query);
        const show = matchesCategory && matchesQuery;
        row.hidden = !show;
        if (show) visible += 1;
      }

      if (emptyState) emptyState.hidden = visible > 0;
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        setActiveChip(chip.dataset.filter ?? 'all');
        syncUrl();
        applyFilters();
      });
    }

    searchInput?.addEventListener('input', () => {
      query = searchInput.value.trim().toLowerCase();
      applyFilters();
    });

    const requested = new URLSearchParams(location.search).get('category');
    if (requested && setActiveChip(requested)) {
      applyFilters();
    }
  }
</script>

<style>
  .archive-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 85% 0%, rgba(216, 177, 102, 0.06), transparent 32%),
      linear-gradient(180deg, var(--hc-surface-2) 0%, var(--hc-surface-0) 42%);
  }

  /* Hero */

  .archive-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(6rem, 9vw, 8.5rem) 0 clamp(2.75rem, 5vw, 4rem);
    border-bottom: 1px solid var(--hc-rule);
  }

  .archive-hero::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(216, 177, 102, 0.12);
    pointer-events: none;
  }

  .archive-hero__inner {
    position: relative;
    z-index: 1;
  }

  .archive-hero__label {
    margin: 0 0 1rem;
    animation: heroRise 0.7s var(--ease) both;
  }

  .archive-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.2rem, 6.5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--hc-text-primary);
    animation: heroRise 0.8s var(--ease) 60ms both;
  }

  .archive-hero__title em {
    font-style: italic;
    color: var(--hc-gold);
  }

  .archive-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.6rem;
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    animation: heroRise 0.8s var(--ease) 140ms both;
  }

  .archive-hero__diamond {
    width: 5px;
    height: 5px;
    border: 1px solid var(--hc-gold-dim);
    transform: rotate(45deg);
  }

  .archive-hero__lead {
    max-width: 620px;
    margin: 1.2rem 0 0;
    color: var(--hc-text-secondary);
    font-size: clamp(1.02rem, 0.4vw + 0.98rem, 1.18rem);
    line-height: 1.72;
    animation: heroRise 0.8s var(--ease) 200ms both;
  }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Filter toolbar */

  .archive-tools {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--hc-rule);
    background: rgba(15, 15, 16, 0.92);
    backdrop-filter: blur(10px);
    animation: heroRise 0.8s var(--ease) 260ms both;
  }

  .archive-tools__inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: max-content;
    max-width: 100%;
    margin: 0 auto;
    gap: 0.85rem;
    padding-block: 1.25rem;
  }

  .archive-filters {
    position: relative;
    display: inline-flex;
    flex-wrap: nowrap;
    max-width: 100%;
    gap: 0;
    padding: 4px;
    background: rgba(242, 235, 220, 0.04);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-pill);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .archive-filters::-webkit-scrollbar {
    display: none;
  }

  .filter-tab {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border: none;
    background: transparent;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 250ms ease;
    border-radius: var(--radius-pill);
  }
  

  .filter-tab:hover {
    color: var(--hc-text-primary);
  }

  .filter-tab.is-active {
    color: var(--hc-surface-0);
  }

  .filter-tab__count {
    font-size: 0.68rem;
    opacity: 0.72;
  }

  .archive-search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 260px;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: rgba(242, 235, 220, 0.03);
    transition: all 250ms ease;
  }

  .archive-search:focus-within {
    border-color: var(--hc-gold-dim);
    color: var(--hc-gold);
  }

  .archive-search input {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--hc-text-primary);
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }

  .archive-search input::placeholder {
    color: var(--hc-text-tertiary);
  }

  .archive-search input:focus {
    outline: none;
  }

  /* Ledger */

  .archive-ledger {
    padding-block: clamp(2rem, 4vw, 3.25rem) clamp(5rem, 9vw, 7rem);
  }

  .ledger {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hc-rule);
  }

  .ledger-row {
    border-bottom: 1px solid var(--hc-rule-soft);
    animation: rowEnter 0.6s var(--ease) both;
    animation-delay: calc(var(--row-index, 0) * 45ms);
  }

  @keyframes rowEnter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ledger-row__link {
    position: relative;
    display: grid;
    grid-template-columns: 122px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(0.5rem, 1.5vw, 1.25rem);
    text-decoration: none;
    transition: background 250ms ease;
  }

  .ledger-row__link:hover {
    background: linear-gradient(90deg, rgba(216, 177, 102, 0.06), transparent 60%);
  }

  .ledger-row__folio {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-ui);
  }

  .ledger-row__no {
    color: var(--hc-gold-dim);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ledger-row__date {
    color: var(--hc-text-tertiary);
    font-size: 0.78rem;
  }

  .ledger-row__body {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .ledger-row__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.2vw, 2.1rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--hc-text-primary);
    transition: color 220ms ease;
  }

  .ledger-row__link:hover .ledger-row__title {
    color: var(--hc-gold-soft);
  }

  .ledger-row__desc {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--hc-text-secondary);
    font-size: 0.93rem;
    line-height: 1.5;
  }

  .ledger-row__aside {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .ledger-row__cat {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--cat-border, var(--hc-rule));
    border-radius: var(--radius-pill);
    color: var(--cat-color, var(--hc-gold-soft));
    background: var(--cat-bg, rgba(216, 177, 102, 0.06));
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ledger-row__arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--hc-rule);
    border-radius: 50%;
    color: var(--hc-gold-dim);
    transition: color 250ms ease, border-color 250ms ease, transform 250ms var(--ease);
  }

  .ledger-row__link:hover .ledger-row__arrow {
    color: var(--hc-gold);
    border-color: var(--hc-gold-dim);
    transform: translateX(4px);
  }

  .ledger-empty {
    margin: 2.5rem 0 0;
    padding: 2rem;
    border: 1px solid var(--hc-rule);
    color: var(--hc-text-secondary);
    text-align: center;
    font-family: var(--font-ui);
    font-size: 0.92rem;
  }

  /* Responsive */

  @media (max-width: 900px) {
    .ledger-row__link {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }

    .ledger-row__folio {
      grid-column: 1 / -1;
      grid-template-columns: auto auto;
      align-items: baseline;
      gap: 0.85rem;
    }

    .ledger-row__arrow {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .archive-hero::before {
      inset: 10px;
    }

    .archive-tools__inner {
      justify-content: flex-start;
    }

    .archive-search {
      width: 100%;
    }

    .ledger-row__link {
      grid-template-columns: minmax(0, 1fr);
    }

    .ledger-row__aside {
      justify-content: flex-start;
    }
  }

  .filter-indicator {
    position: absolute;
    top: 4px;
    left: 4px;
    height: calc(100% - 8px);
    background: var(--hc-gold);
    border-radius: var(--radius-pill);
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1), width 350ms cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 1;
    pointer-events: none;
  }

  .archive-search:focus-within {
    border-color: var(--hc-gold-dim);
    background: rgba(242, 235, 220, 0.06);
    box-shadow: 0 0 0 3px rgba(216, 177, 102, 0.08);
  }
  .search-kbd {
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--hc-rule);
    border-radius: 4px;
    color: var(--hc-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    opacity: 0.7;
    transition: opacity 250ms ease, transform 250ms ease;
  }
  .archive-search:focus-within .search-kbd {
    opacity: 0;
    transform: scale(0.8);
  }

  .ledger-row__link {
    overflow: hidden;
  }
  .ledger-row__link::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--hc-gold);
    transform: scaleY(0);
    transition: transform 300ms var(--ease);
  }
  .ledger-row__link:hover::before {
    transform: scaleY(1);
  }
  .ledger-row__link::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(216, 177, 102, 0.04), transparent 40%);
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .ledger-row__link:hover::after {
    opacity: 1;
  }
  
  .scroll-progress {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--hc-rule);
    z-index: 30;
  }
  .scroll-progress__bar {
    height: 100%;
    width: 0%;
    background: var(--hc-gold);
    transition: width 50ms linear;
  }
</style>
