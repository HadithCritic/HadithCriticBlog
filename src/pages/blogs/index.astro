---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isNewPost } from '../../lib/new-badge';

const allPosts = await getCollection('articles', ({ data }) => (import.meta.env.DEV || !data.draft) && !data.preview);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}

const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const calcReadingMinutes = (post?: (typeof posts)[number]) => {
  if (!post) return 1;
  const rawBody = post.body || '';
  const words = rawBody.replace(/<[^>]*>/g, '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
};

const entries = posts.map((post, index) => ({
  post,
  folio: String(posts.length - index).padStart(3, '0'),
  dateLabel: formatDate(post.data.date),
  dateISO: post.data.date.toISOString().slice(0, 10),
  isNew: isNewPost(post.data.date),
  readingMinutes: calcReadingMinutes(post),
  tags: post.data.tags ?? []
}));
---

<BaseLayout
  title="Blogs & Analysis | HadithCritic"
  description="Critical studies, transmission forensics, and historical analyses of prophetic reports and early Islamic source texts."
>
  <div class="archive-page">
    <header class="archive-hero" aria-labelledby="archive-title" data-motion="hero">
      <div class="hc-container">
        <div class="archive-hero__inner">
          <div class="archive-hero__content">
            <div class="archive-hero__eyebrow">
              <span class="archive-hero__kicker-dot" aria-hidden="true"></span>
              <span class="archive-hero__kicker">Research Archive</span>
              <span class="archive-hero__kicker-sep" aria-hidden="true">/</span>
              <span class="archive-hero__kicker-tag">Critical Editions &amp; Forensics</span>
            </div>

            <h1 id="archive-title" class="archive-hero__title">
              Studies <span class="archive-hero__title-accent">&amp; Analysis</span>
            </h1>

            <p class="archive-hero__lead">
              Critical studies, transmission forensics, and historical analyses of prophetic reports and early Islamic source texts.
            </p>
          </div>
        </div>
      </div>
    </header>

    <div class="archive-tools" role="region" aria-label="Filter the index">
      <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress__bar" id="scroll-bar"></div></div>
      <div class="hc-container archive-tools__inner">
        <!-- Search Row -->
        <div class="archive-search-row">
          <div class="archive-search-wrap">
            <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="archive-search-input"
              class="archive-search-input"
              placeholder="Search studies by title, narrator, thesis, tag..."
              autocomplete="off"
              aria-label="Search studies"
            />
            <button type="button" id="archive-search-clear" class="archive-search-clear" aria-label="Clear search" hidden>
              ✕
            </button>
          </div>
          <kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
        </div>

        <!-- Filter Chips Row -->
        <div class="archive-filters-row">
          <div class="archive-filters" role="group" aria-label="Filter by category">
            <div class="archive-filter-magnet-pill" aria-hidden="true"></div>
            <button type="button" class="filter-tab is-active" data-filter="all">
              <span class="filter-tab__dot" aria-hidden="true"></span>
              <span class="filter-tab__label">All Studies</span>
              <span class="filter-tab__count">{posts.length}</span>
            </button>
            {categories.map((category) => (
              <button type="button" class="filter-tab" data-filter={category.name} data-category={category.name}>
                <span class="filter-tab__dot" aria-hidden="true"></span>
                <span class="filter-tab__label">{category.name}</span>
                <span class="filter-tab__count">{category.count}</span>
              </button>
            ))}
          </div>

          <button type="button" id="archive-reset-btn" class="archive-reset-btn" hidden aria-label="Reset all filters">
            <span>Reset Filters</span>
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      </div>
    </div>

    <section class="archive-ledger hc-container" aria-label="All entries">
      <div class="archive-status-bar">
        <p class="archive-result-count" id="archive-result-count" role="status" aria-live="polite">
          Showing <strong>{posts.length}</strong> of {posts.length} studies
        </p>
      </div>

      <ol class="ledger" id="ledger" data-motion="ledger">
        {entries.map(({ post, folio, dateLabel, dateISO, isNew, readingMinutes, tags }) => (
          <li
            class="ledger-row"
            data-id={post.id}
            data-category={post.data.category}
            data-search={`${post.data.title} ${post.data.description ?? ''} ${post.data.category} ${tags.join(' ')} ${post.data.author}`.toLowerCase()}
          >
            <a href={`/blogs/${post.id}/`} class="ledger-row__link">
              <div class="ledger-row__meta">
                <span class="ledger-row__folio">
                  <span class="folio-glyph" aria-hidden="true">◈</span>
                  <span>No. {folio}</span>
                </span>
                <time class="ledger-row__date" datetime={dateISO}>{dateLabel}</time>
                <span class="ledger-row__readtime">
                  <svg class="readtime-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  <span>{readingMinutes} min read</span>
                </span>
                {isNew && <span class="new-badge">New</span>}
              </div>

              <div class="ledger-row__body">
                <div class="ledger-row__header">
                  <span class="ledger-row__cat" data-category={post.data.category}>
                    <span class="ledger-row__cat-dot" aria-hidden="true"></span>
                    {post.data.category}
                  </span>
                  <h2 class="ledger-row__title">{post.data.title}</h2>
                </div>

                {post.data.description && (
                  <p class="ledger-row__desc">{post.data.description}</p>
                )}

                <div class="ledger-row__match" hidden></div>
              </div>

              <div class="ledger-row__action" aria-hidden="true">
                <span class="ledger-row__action-label">Read folio</span>
                <div class="ledger-row__arrow">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <div class="ledger-empty" id="ledger-empty" hidden>
        <div class="ledger-empty__icon" aria-hidden="true">◈</div>
        <h3>No Studies Found</h3>
        <p>No research entries match your active search or category filters.</p>
        <button type="button" class="hc-btn hc-btn--ghost" id="ledger-empty-reset">
          Clear Filters &amp; View All
        </button>
      </div>
    </section>
  </div>

  <style>
  </style>
</BaseLayout>

<script>
  function initArchive() {
    const page = document.querySelector('.archive-page');
    if (!page) return;

    const filterContainer = page.querySelector<HTMLElement>('.archive-filters');
    const filterMagnetPill = filterContainer?.querySelector<HTMLElement>('.archive-filter-magnet-pill');
    const chips = [...page.querySelectorAll<HTMLButtonElement>('.filter-tab')];
    const rows = [...page.querySelectorAll<HTMLLIElement>('.ledger-row')];

    rows.forEach((row) => {
      row.addEventListener('mousemove', (e) => {
        const rect = row.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        row.style.setProperty('--mouse-x', `${x.toFixed(1)}%`);
        row.style.setProperty('--mouse-y', `${y.toFixed(1)}%`);
      });
    });
    const searchInput = page.querySelector<HTMLInputElement>('#archive-search-input');
    const searchClear = page.querySelector<HTMLButtonElement>('#archive-search-clear');
    const resetBtn = page.querySelector<HTMLButtonElement>('#archive-reset-btn');
    const emptyState = page.querySelector<HTMLElement>('#ledger-empty');
    const emptyReset = page.querySelector<HTMLButtonElement>('#ledger-empty-reset');
    const resultCount = page.querySelector<HTMLElement>('#archive-result-count');
    const totalEntries = rows.length;

    const updateMagnetPill = (tab: HTMLElement) => {
      if (!filterMagnetPill || !filterContainer || !tab) return;
      const cRect = filterContainer.getBoundingClientRect();
      const tRect = tab.getBoundingClientRect();
      const left = tRect.left - cRect.left;
      const top = tRect.top - cRect.top;
      filterMagnetPill.style.transform = `translate(${left}px, ${top}px)`;
      filterMagnetPill.style.width = `${tRect.width}px`;
      filterMagnetPill.style.height = `${tRect.height}px`;
      filterMagnetPill.style.opacity = '1';
      const activeBg = getComputedStyle(tab).getPropertyValue('--tab-active-bg').trim() || 'var(--hc-gold)';
      filterMagnetPill.style.backgroundColor = activeBg;
      filterMagnetPill.style.boxShadow = `0 2px 12px color-mix(in srgb, ${activeBg} 40%, transparent)`;
    };

    if (filterContainer && filterMagnetPill) {
      filterContainer.setAttribute('data-magnet-ready', 'true');
      const initialActive = filterContainer.querySelector<HTMLButtonElement>('.filter-tab.is-active');
      if (initialActive) updateMagnetPill(initialActive);
      window.addEventListener('resize', () => {
        const active = filterContainer.querySelector<HTMLButtonElement>('.filter-tab.is-active');
        if (active) updateMagnetPill(active);
      }, { passive: true });
    }

    // Scroll progress handler
    const ledgerList = document.getElementById('ledger');
    const scrollBar = document.getElementById('scroll-bar');
    if (ledgerList && scrollBar) {
      window.addEventListener('scroll', () => {
        const rect = ledgerList.getBoundingClientRect();
        const total = ledgerList.scrollHeight - window.innerHeight + 200;
        let current = -rect.top;
        if (current < 0) current = 0;
        let progress = (current / total) * 100;
        if (progress > 100) progress = 100;
        if (progress < 0) progress = 0;
        scrollBar.style.width = `${progress}%`;
      }, { passive: true });
    }

    interface SearchSection {
      heading: string;
      slug: string;
      text: string;
    }
    interface SearchDoc {
      id: string;
      title: string;
      description: string;
      category: string;
      tags: string[];
      sections: SearchSection[];
      fullText: string;
    }

    const searchMap = new Map<string, SearchDoc>();

    /**
     * 480 KB over the wire, and it only deepens a query that has been typed.
     * Fetched on the first keystroke, or immediately when the page was opened
     * with ?q=, rather than on every visit to the archive.
     */
    let searchIndexRequest: Promise<void> | null = null;

    const loadSearchIndex = () => {
      if (searchIndexRequest) return searchIndexRequest;
      searchIndexRequest = fetch('/search-index.json')
        .then((res) => res.json() as Promise<SearchDoc[]>)
        .then((docs) => {
          docs.forEach((doc) => searchMap.set(doc.id, doc));
          if (query) applyFilters();
        })
        .catch(() => {});
      return searchIndexRequest;
    };

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function createSnippet(text: string, term: string): string {
      const lower = text.toLowerCase();
      const idx = lower.indexOf(term.toLowerCase());
      if (idx === -1) return '';

      const start = Math.max(0, idx - 65);
      const end = Math.min(text.length, idx + term.length + 85);
      let snippet = text.slice(start, end);
      if (start > 0) snippet = '...' + snippet;
      if (end < text.length) snippet = snippet + '...';

      const escapedSnippet = escapeHtml(snippet);
      const escapedTerm = escapeHtml(term);
      const regex = new RegExp(`(${escapedTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      return escapedSnippet.replace(regex, '<mark class="search-match-mark">$1</mark>');
    }

    let activeCategory = 'all';
    let query = '';

    const updateControls = () => {
      const isFiltered = activeCategory !== 'all' || query.length > 0;
      if (resetBtn) resetBtn.hidden = !isFiltered;
      if (searchClear) searchClear.hidden = query.length === 0;
    };

    const setActiveChip = (category: string) => {
      const normalized = category.trim().toLowerCase();
      const chip = chips.find((c) => (c.dataset.filter ?? '').trim().toLowerCase() === normalized) || chips[0];
      activeCategory = chip.dataset.filter ?? 'all';
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      updateMagnetPill(chip);
      updateControls();
      return true;
    };

    const syncUrl = () => {
      const url = new URL(location.href);
      if (activeCategory === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', activeCategory);
      }
      query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
    };

    const applyFilters = () => {
      let visible = 0;

      for (const row of rows) {
        const id = row.dataset.id ?? '';
        const doc = searchMap.get(id);
        const matchesCategory = activeCategory === 'all' || row.dataset.category === activeCategory;

        let matchesQuery = !query;
        let matchSection: SearchSection | null = null;
        let matchSnippetHtml = '';

        if (query) {
          const titleDescMatch = (row.dataset.search ?? '').includes(query);
          if (titleDescMatch) {
            matchesQuery = true;
          }

          if (doc) {
            for (const sec of doc.sections) {
              const inHeading = sec.heading.toLowerCase().includes(query);
              const inText = sec.text.toLowerCase().includes(query);
              if (inHeading || inText) {
                matchesQuery = true;
                matchSection = sec;
                const source = inText ? sec.text : sec.heading;
                matchSnippetHtml = createSnippet(source, query);
                break;
              }
            }

            if (!matchSection && doc.fullText.toLowerCase().includes(query)) {
              matchesQuery = true;
              matchSnippetHtml = createSnippet(doc.fullText, query);
            }
          }
        }

        const show = matchesCategory && matchesQuery;
        row.hidden = !show;
        if (show) {
          visible += 1;
        }

        // Update direct section link, description visibility, and citation box
        const link = row.querySelector<HTMLAnchorElement>('.ledger-row__link');
        const matchBox = row.querySelector<HTMLElement>('.ledger-row__match');
        const descEl = row.querySelector<HTMLElement>('.ledger-row__desc');

        if (link) {
          if (matchSection && matchSection.slug) {
            link.setAttribute('href', `/blogs/${id}/#${matchSection.slug}`);
          } else {
            link.setAttribute('href', `/blogs/${id}/`);
          }
        }

        if (matchBox) {
          if (show && matchSnippetHtml) {
            if (descEl) descEl.hidden = true;
            matchBox.hidden = false;
            const headingLabel = matchSection ? matchSection.heading : 'Article Content';
            matchBox.innerHTML = `
              <div class="search-citation">
                <div class="search-citation__header">
                  <div class="search-citation__meta">
                    <span class="search-citation__badge">
                      <svg class="search-citation__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      </svg>
                      <span>Direct match in</span>
                    </span>
                    <strong class="search-citation__section">${escapeHtml(headingLabel)}</strong>
                  </div>
                  <span class="search-citation__jump">
                    <span>Jump to Section</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </div>
                <div class="search-citation__body">
                  <span class="search-citation__quote-mark" aria-hidden="true">“</span>
                  <p class="search-citation__text">${matchSnippetHtml}</p>
                </div>
              </div>
            `;
          } else {
            if (descEl) descEl.hidden = false;
            matchBox.hidden = true;
            matchBox.innerHTML = '';
          }
        }
      }

      if (emptyState) emptyState.hidden = visible > 0;
      if (resultCount) {
        if (query) {
          const catLabel = activeCategory === 'all' ? '' : ` in <span class="search-feedback-cat">${escapeHtml(activeCategory)}</span>`;
          resultCount.innerHTML = `
            <span class="search-status-chip">
              <span class="search-status-dot" aria-hidden="true"></span>
              <span>Found <strong>${visible}</strong> ${visible === 1 ? 'study' : 'studies'} matching <span class="search-query-highlight">"${escapeHtml(query)}"</span>${catLabel}</span>
            </span>
          `;
        } else {
          const catLabel = activeCategory === 'all' ? '' : ` in ${activeCategory}`;
          resultCount.innerHTML = `Showing <strong>${visible}</strong> of ${totalEntries} studies${catLabel}`;
        }
      }
      updateControls();
    };

    const resetAll = () => {
      activeCategory = 'all';
      query = '';
      if (searchInput) searchInput.value = '';
      setActiveChip('all');
      syncUrl();
      applyFilters();
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        setActiveChip(chip.dataset.filter ?? 'all');
        syncUrl();
        applyFilters();
      });
    }

    searchInput?.addEventListener('input', () => {
      query = searchInput.value.trim().toLowerCase();
      if (query) loadSearchIndex();
      syncUrl();
      applyFilters();
    });

    searchClear?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      query = '';
      syncUrl();
      applyFilters();
    });

    resetBtn?.addEventListener('click', resetAll);
    emptyReset?.addEventListener('click', resetAll);

    // Keyboard shortcut (Cmd/Ctrl + K) to focus search
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    const requested = new URLSearchParams(location.search).get('category');
    if (requested) {
      setActiveChip(requested);
    }
    const requestedQuery = new URLSearchParams(location.search).get('q');
    if (requestedQuery && searchInput) {
      searchInput.value = requestedQuery;
      query = requestedQuery.toLowerCase();
      loadSearchIndex();
    }
    applyFilters();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArchive);
  } else {
    initArchive();
  }
  document.addEventListener('astro:page-load', initArchive);
</script>

<style>
  .archive-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 85% 0%, rgba(216, 177, 102, 0.06), transparent 32%),
      linear-gradient(180deg, var(--hc-surface-2) 0%, var(--hc-surface-0) 42%);
  }

  /* Elevated Archival Hero */
  .archive-hero {
    position: relative;
    border-bottom: 1px solid var(--hc-rule);
    background:
      radial-gradient(ellipse 850px 420px at 15% 25%, rgba(216, 177, 102, 0.05) 0%, transparent 65%),
      linear-gradient(180deg, var(--hc-surface-1) 0%, var(--hc-surface-0) 100%);
    padding: clamp(3rem, 5.5vw, 4.5rem) 0 clamp(2.25rem, 4vw, 3.25rem);
    overflow: hidden;
  }

  .archive-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 90% 10%, rgba(216, 177, 102, 0.03), transparent 45%);
    pointer-events: none;
  }

  .archive-hero__inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .archive-hero__content {
    flex: 1;
    min-width: min(100%, 480px);
    max-width: 680px;
  }

  .archive-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .archive-hero__kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hc-gold);
    box-shadow: 0 0 8px var(--hc-gold);
    flex-shrink: 0;
  }

  .archive-hero__kicker {
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .archive-hero__kicker-sep {
    color: var(--hc-rule-strong);
    font-size: 0.75rem;
  }

  .archive-hero__kicker-tag {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .archive-hero__title {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 5.2vw, 3.75rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--hc-text-primary);
  }

  .archive-hero__title-accent {
    font-style: normal;
    color: var(--hc-gold);
  }

  .archive-hero__lead {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.02rem, 1.25vw, 1.15rem);
    line-height: 1.65;
    color: var(--hc-text-secondary);
    max-width: 58ch;
  }



  /* Toolbar Search Row */
  .archive-search-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 0 0.5rem;
  }

  .archive-search-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--hc-surface-1, #141416);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.1));
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    transition: border-color 0.2s ease;
  }

  .archive-search-wrap:focus-within {
    border-color: var(--hc-gold, #c8a755);
  }

  .archive-search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--hc-text-primary, #f5f2eb);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.92rem;
    min-width: 0;
  }

  .archive-search-input::placeholder {
    color: var(--hc-text-tertiary, #858077);
  }

  .archive-search-clear {
    background: transparent;
    border: none;
    color: var(--hc-text-tertiary, #858077);
    cursor: pointer;
    font-size: 0.84rem;
    padding: 0.1rem 0.3rem;
  }

  .archive-search-clear:hover {
    color: var(--hc-text-primary, #f5f2eb);
  }

  .search-kbd {
    font-family: var(--font-ui, monospace);
    font-size: 0.8rem;
    color: var(--hc-text-tertiary, #858077);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.1));
    border-radius: 4px;
    padding: 0.2rem 0.45rem;
    flex-shrink: 0;
  }

  /* Filter toolbar */
  .archive-tools {
    position: sticky;
    top: var(--site-header-height, 72px);
    z-index: 40;
    border-bottom: 1px solid var(--hc-rule);
    background: rgba(20, 19, 18, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  :global([data-theme="light"]) .archive-tools {
    background: rgba(251, 249, 244, 0.94);
  }

  .scroll-progress {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: transparent;
  }

  .scroll-progress__bar {
    height: 100%;
    width: 0%;
    background: var(--hc-gold);
    transition: width 100ms ease;
  }

  .archive-tools__inner {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-block: 1rem;
  }

  /* Search Row */
  .archive-search-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .archive-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-height: 46px;
    padding: 0 1rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm, 8px);
    background: var(--hc-surface-1);
    transition: border-color 200ms ease, box-shadow 200ms ease, background 200ms ease;
  }

  .archive-search-wrap:focus-within {
    border-color: var(--hc-gold);
    box-shadow: 0 0 0 3px rgba(216, 177, 102, 0.18);
    background: var(--hc-surface-2);
  }

  .search-icon {
    color: var(--hc-gold-dim);
    margin-right: 0.75rem;
    flex-shrink: 0;
  }

  .archive-search-input {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--hc-text-primary);
    font-family: var(--font-body);
    font-size: 1.03rem;
  }

  .archive-search-input::placeholder {
    color: var(--hc-text-tertiary);
  }

  .archive-search-clear {
    background: none;
    border: none;
    color: var(--hc-text-tertiary);
    font-size: 1.01rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    transition: color 180ms ease;
  }

  .archive-search-clear:hover {
    color: var(--hc-text-primary);
  }

  .search-kbd {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--hc-rule);
    border-radius: 6px;
    font-family: var(--font-ui);
    font-size: 0.81rem;
    font-weight: 600;
    color: var(--hc-text-tertiary);
    background: var(--hc-surface-1);
  }

  /* Filters Row */
  .archive-filters-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
  }

  .archive-filters-row::-webkit-scrollbar {
    display: none;
  }

  .archive-filters {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: nowrap;
  }

  .archive-filter-magnet-pill {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: var(--radius-pill);
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition:
      transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      width 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      height 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms ease,
      box-shadow 180ms ease,
      opacity 120ms ease;
  }

  /* Unique Category Color System for Filters .
     The --tab-active-bg fills stay theme-fixed: the active tab prints a fixed
     near-black label on them, so a fill that inverted with the theme would put
     dark text on dark ground on paper. Only the unfilled --tab-color follows
     the palette. */
  .filter-tab[data-filter="all"] {
    --tab-color: var(--hc-gold);
    --tab-bg: rgba(200, 155, 75, 0.12);
    --tab-border: rgba(200, 155, 75, 0.35);
    --tab-active-bg: #c89b4b;
    --tab-active-text: #141312;
  }

  .filter-tab[data-category="Origins & Early History"],
  .filter-tab[data-filter="Origins & Early History"] {
    --tab-color: var(--cat-history-text);
    --tab-bg: rgba(212, 139, 82, 0.12);
    --tab-border: rgba(212, 139, 82, 0.35);
    --tab-active-bg: #c4783d;
    --tab-active-text: #ffffff;
  }

  .filter-tab[data-category="Prophecies & Eschatology"],
  .filter-tab[data-filter="Prophecies & Eschatology"] {
    --tab-color: var(--cat-prophecies-text);
    --tab-bg: rgba(224, 90, 71, 0.12);
    --tab-border: rgba(224, 90, 71, 0.35);
    --tab-active-bg: #c94532;
    --tab-active-text: #ffffff;
  }

  .filter-tab[data-category="Theology & Epistemology"],
  .filter-tab[data-filter="Theology & Epistemology"] {
    --tab-color: var(--cat-theology-text);
    --tab-bg: rgba(79, 168, 108, 0.12);
    --tab-border: rgba(79, 168, 108, 0.35);
    --tab-active-bg: #3f8e58;
    --tab-active-text: #ffffff;
  }

  .filter-tab[data-category="Transmission & Narrators"],
  .filter-tab[data-filter="Transmission & Narrators"] {
    --tab-color: var(--cat-philosophy-text);
    --tab-bg: rgba(96, 143, 214, 0.12);
    --tab-border: rgba(96, 143, 214, 0.35);
    --tab-active-bg: #4f78b8;
    --tab-active-text: #ffffff;
  }

  .filter-tab {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.9rem;
    border: 1px solid var(--tab-border, var(--hc-rule));
    border-radius: var(--radius-pill);
    background: var(--hc-surface-1);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 200ms ease;
  }

  .filter-tab__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tab-color, var(--hc-gold));
    display: inline-block;
    flex-shrink: 0;
    transition: transform 200ms ease, background 200ms ease;
  }

  .filter-tab:hover {
    color: var(--tab-color, var(--hc-text-primary));
    border-color: var(--tab-color, var(--hc-rule-strong));
    background: var(--tab-bg, var(--hc-surface-2));
  }

  .filter-tab:hover .filter-tab__dot {
    transform: scale(1.25);
  }

  .filter-tab.is-active {
    color: var(--tab-active-text, #ffffff);
    background: var(--tab-active-bg, var(--hc-gold));
    border-color: var(--tab-active-bg, var(--hc-gold));
    font-weight: 700;
    box-shadow: 0 2px 12px color-mix(in srgb, var(--tab-active-bg) 40%, transparent);
  }

  .archive-filters[data-magnet-ready="true"] .filter-tab.is-active {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .filter-tab.is-active .filter-tab__dot {
    background: currentColor;
  }

  .filter-tab__count {
    font-size: 0.8rem;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.18);
    /* The tint darkens the ground under what is already the dimmest text
       token, so the count takes the primary colour rather than inheriting. */
    color: var(--hc-text-primary);
  }

  .filter-tab.is-active .filter-tab__count {
    /* Lightens rather than darkens: the active tab already sits on a mid-tone
       gold, and darkening it dropped the dark label below 4.5:1. */
    background: rgba(255, 255, 255, 0.32);
    color: currentColor;
  }

  .archive-reset-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px dashed var(--hc-rule-strong);
    background: transparent;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.81rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    white-space: nowrap;
    transition: all 180ms ease;
  }

  .archive-reset-btn:hover {
    border-color: var(--hc-gold);
    background: rgba(216, 177, 102, 0.1);
  }

  /* Ledger Section */
  .archive-ledger {
    padding-block: 2rem 6rem;
  }

  .archive-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    min-height: 2.2rem;
  }

  .archive-result-count {
    margin: 0;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    letter-spacing: 0.03em;
  }

  .archive-result-count strong {
    color: var(--hc-gold);
    font-weight: 700;
  }

  :global(.search-status-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(216, 177, 102, 0.08);
    border: 1px solid rgba(216, 177, 102, 0.22);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.84rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  :global(.search-status-dot) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hc-gold);
    box-shadow: 0 0 8px var(--hc-gold);
    flex-shrink: 0;
  }

  :global(.search-query-highlight) {
    color: var(--hc-gold);
    font-weight: 600;
  }

  :global(.search-feedback-cat) {
    color: var(--hc-text);
    font-weight: 600;
  }

  .ledger {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hc-rule);
  }

  .ledger-row {
    position: relative;
    border-bottom: 1px solid var(--hc-rule-soft);
    transition:
      background 280ms ease,
      border-bottom-color 240ms ease,
      box-shadow 240ms ease;
  }

  .ledger-row[data-category="Origins & Early History"] {
    --cat-color: var(--cat-history-text);
  }

  .ledger-row[data-category="Prophecies & Eschatology"] {
    --cat-color: var(--cat-prophecies-text);
  }

  .ledger-row[data-category="Theology & Epistemology"] {
    --cat-color: var(--cat-theology-text);
  }

  .ledger-row[data-category="Transmission & Narrators"] {
    --cat-color: var(--cat-philosophy-text);
  }

  .ledger-row:hover {
    background: radial-gradient(
      700px circle at var(--mouse-x, 35%) var(--mouse-y, 50%),
      color-mix(in srgb, var(--cat-color, var(--hc-gold)) 10%, rgba(20, 19, 18, 0.65)) 0%,
      rgba(15, 14, 13, 0.4) 55%,
      transparent 85%
    );
    border-bottom-color: color-mix(in srgb, var(--cat-color, var(--hc-gold)) 35%, var(--hc-rule));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--cat-color, var(--hc-gold)) 25%, transparent),
      0 10px 28px -10px rgba(0, 0, 0, 0.45);
  }

  :global([data-theme="light"]) .ledger-row:hover {
    background: radial-gradient(
      700px circle at var(--mouse-x, 35%) var(--mouse-y, 50%),
      color-mix(in srgb, var(--cat-color, var(--hc-gold)) 14%, rgba(245, 240, 230, 0.8)) 0%,
      rgba(240, 234, 222, 0.45) 55%,
      transparent 85%
    );
    border-bottom-color: color-mix(in srgb, var(--cat-color, var(--hc-gold)) 40%, var(--hc-rule));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--cat-color, var(--hc-gold)) 25%, transparent),
      0 6px 20px -6px rgba(0, 0, 0, 0.08);
  }

  .ledger-row__link {
    display: grid;
    grid-template-columns: 155px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.2rem, 2.5vw, 2.4rem);
    padding: clamp(1.25rem, 1.8vw, 1.65rem) clamp(0.75rem, 1.2vw, 1.35rem);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .ledger-row__meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-ui);
  }

  .ledger-row__folio {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.18rem 0.55rem;
    border-radius: 4px;
    background: rgba(216, 177, 102, 0.05);
    border: 1px solid var(--hc-rule-soft);
    color: var(--hc-gold);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: var(--font-mono, monospace);
    width: fit-content;
    transition: all 220ms ease;
  }

  .folio-glyph {
    font-size: 0.75rem;
    color: var(--cat-color, var(--hc-gold));
    opacity: 0.45;
    transform: scale(0.9);
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 200ms ease, color 200ms ease;
  }

  .ledger-row:hover .ledger-row__folio {
    background: rgba(216, 177, 102, 0.12);
    border-color: color-mix(in srgb, var(--cat-color, var(--hc-gold)) 40%, var(--hc-rule));
    color: var(--hc-gold-bright, #ffffff);
    box-shadow: 0 0 12px rgba(216, 177, 102, 0.2);
  }

  .ledger-row:hover .folio-glyph {
    opacity: 1;
    transform: scale(1.15) rotate(45deg);
    color: var(--cat-color, var(--hc-gold));
  }

  .ledger-row__date {
    color: var(--hc-text-tertiary);
    font-size: 0.82rem;
  }

  .ledger-row__readtime {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
  }

  .new-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.14rem 0.5rem;
    border-radius: var(--radius-pill);
    background: rgba(224, 90, 71, 0.14);
    border: 1px solid rgba(224, 90, 71, 0.4);
    color: var(--cat-prophecies-text);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ledger-row__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .ledger-row__header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ledger-row__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    width: fit-content;
    padding: 0.18rem 0.65rem;
    border: 1px solid var(--badge-border, rgba(216, 177, 102, 0.3));
    border-radius: var(--radius-pill);
    color: var(--badge-color, var(--hc-gold-soft));
    background: var(--badge-bg, rgba(216, 177, 102, 0.08));
    box-shadow: 0 1px 6px var(--badge-glow, rgba(0, 0, 0, 0.15)), inset 0 0 6px var(--badge-glow-inner, transparent);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 220ms ease,
      box-shadow 220ms ease,
      background 220ms ease;
  }

  .ledger-row__cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor, 0 0 10px currentColor;
    flex-shrink: 0;
    display: inline-block;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 220ms ease;
  }

  .ledger-row:hover .ledger-row__cat {
    transform: translateY(-1px);
    border-color: var(--badge-border-hover, var(--badge-color));
    box-shadow: 0 2px 14px var(--badge-glow-strong, rgba(216, 177, 102, 0.3)), inset 0 0 8px var(--badge-glow-inner, transparent);
  }

  .ledger-row:hover .ledger-row__cat-dot {
    transform: scale(1.3);
    box-shadow: 0 0 8px currentColor, 0 0 14px currentColor;
  }

  .ledger-row__cat[data-category="Origins & Early History"] {
    --badge-color: var(--cat-history-text);
    --badge-bg: rgba(212, 139, 82, 0.12);
    --badge-border: rgba(212, 139, 82, 0.35);
    --badge-border-hover: rgba(212, 139, 82, 0.65);
    --badge-glow: rgba(212, 139, 82, 0.16);
    --badge-glow-inner: rgba(212, 139, 82, 0.08);
    --badge-glow-strong: rgba(212, 139, 82, 0.35);
  }

  .ledger-row__cat[data-category="Prophecies & Eschatology"] {
    --badge-color: var(--cat-prophecies-text);
    --badge-bg: rgba(224, 90, 71, 0.12);
    --badge-border: rgba(224, 90, 71, 0.35);
    --badge-border-hover: rgba(224, 90, 71, 0.65);
    --badge-glow: rgba(224, 90, 71, 0.16);
    --badge-glow-inner: rgba(224, 90, 71, 0.08);
    --badge-glow-strong: rgba(224, 90, 71, 0.35);
  }

  .ledger-row__cat[data-category="Theology & Epistemology"] {
    --badge-color: var(--cat-theology-text);
    --badge-bg: rgba(79, 168, 108, 0.12);
    --badge-border: rgba(79, 168, 108, 0.35);
    --badge-border-hover: rgba(79, 168, 108, 0.65);
    --badge-glow: rgba(79, 168, 108, 0.16);
    --badge-glow-inner: rgba(79, 168, 108, 0.08);
    --badge-glow-strong: rgba(79, 168, 108, 0.35);
  }

  .ledger-row__cat[data-category="Transmission & Narrators"] {
    --badge-color: var(--cat-philosophy-text);
    --badge-bg: rgba(96, 143, 214, 0.12);
    --badge-border: rgba(96, 143, 214, 0.35);
    --badge-border-hover: rgba(96, 143, 214, 0.65);
    --badge-glow: rgba(96, 143, 214, 0.16);
    --badge-glow-inner: rgba(96, 143, 214, 0.08);
    --badge-glow-strong: rgba(96, 143, 214, 0.35);
  }

  .ledger-row__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.35rem, 2vw, 1.58rem);
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: var(--hc-text-primary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 6px;
    text-decoration-thickness: 1.5px;
    transition: color 200ms ease, text-decoration-color 260ms ease;
  }

  .ledger-row:hover .ledger-row__title {
    color: var(--hc-gold-soft);
    text-decoration-color: var(--cat-color, var(--hc-gold));
  }

  /* Multi-line rich description preview */
  .ledger-row__desc {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--hc-text-secondary);
    font-size: 0.98rem;
    line-height: 1.58;
  }

  .ledger-row__desc[hidden] {
    display: none !important;
  }

  /* Deep Content Search Match Citation Plaque */
  .ledger-row__match {
    margin-top: 0.75rem;
  }

  :global(.search-citation) {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-sm);
    background: rgba(18, 18, 22, 0.85);
    border: 1px solid rgba(216, 177, 102, 0.24);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    overflow: hidden;
    transition: border-color 220ms ease, background 220ms ease, box-shadow 220ms ease;
  }

  .ledger-row:hover :global(.search-citation) {
    border-color: rgba(216, 177, 102, 0.5);
    background: rgba(24, 24, 30, 0.95);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4), 0 0 24px rgba(216, 177, 102, 0.09);
  }

  :global(.search-citation__header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    background: rgba(216, 177, 102, 0.07);
    border-bottom: 1px solid rgba(216, 177, 102, 0.14);
    flex-wrap: wrap;
  }

  :global(.search-citation__meta) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  :global(.search-citation__badge) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    background: rgba(216, 177, 102, 0.14);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
  }

  :global(.search-citation__section) {
    font-family: var(--font-ui);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--hc-text);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.search-citation__jump) {
    display: inline-flex;
