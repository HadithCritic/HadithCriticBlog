---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isNewPost } from '../../lib/new-badge';

const allPosts = await getCollection('articles', ({ data }) => (import.meta.env.DEV || !data.draft) && !data.preview);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}

const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const entries = posts.map((post, index) => ({
  post,
  folio: String(posts.length - index).padStart(3, '0'),
  dateLabel: formatDate(post.data.date),
  dateISO: post.data.date.toISOString().slice(0, 10),
  isNew: isNewPost(post.data.date),
  tags: post.data.tags ?? []
}));
---

<BaseLayout
  title="Blogs & Analysis | HadithCritic"
  description="Critical studies, transmission forensics, and historical analyses of prophetic reports and early Islamic source texts."
>
  <div class="archive-page">
    <header class="archive-hero" aria-labelledby="archive-title" data-motion="hero">
      <div class="hc-container archive-hero__inner">
        <p class="hc-eyebrow archive-hero__label">The HadithCritic Research Archive</p>
        <h1 id="archive-title" class="archive-hero__title">
          Studies <em>&amp;</em> Analysis
        </h1>
        <div class="archive-hero__meta" aria-label="Archive statistics">
          <span>{posts.length} Studies Catalogued</span>
          <span class="archive-hero__diamond" aria-hidden="true"></span>
          <span>{categories.length} Research Fields</span>
          <span class="archive-hero__diamond" aria-hidden="true"></span>
          <span>Latest: {entries[0]?.dateLabel}</span>
        </div>
        <p class="archive-hero__lead">
          Critical studies, transmission forensics, and historical analyses of prophetic
          reports and early Islamic source texts. Search by topic, narrator, or category below.
        </p>
      </div>
    </header>

    <div class="archive-tools" role="region" aria-label="Filter the index">
      <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress__bar" id="scroll-bar"></div></div>
      <div class="hc-container archive-tools__inner">
        <!-- Search Bar Row -->
        <div class="archive-search-row">
          <div class="archive-search-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              type="search"
              id="archive-search-input"
              class="archive-search-input"
              placeholder="Search studies by title, narrator, thesis, tag, or author..."
              autocomplete="off"
              aria-label="Search studies"
            />
            <button type="button" id="archive-search-clear" class="archive-search-clear" aria-label="Clear search" hidden>
              ✕
            </button>
          </div>
          <kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
        </div>

        <!-- Filter Chips Row -->
        <div class="archive-filters-row">
          <div class="archive-filters" role="group" aria-label="Filter by category">
            <button type="button" class="filter-tab is-active" data-filter="all">
              <span class="filter-tab__dot" aria-hidden="true"></span>
              <span class="filter-tab__label">All Studies</span>
              <span class="filter-tab__count">{posts.length}</span>
            </button>
            {categories.map((category) => (
              <button type="button" class="filter-tab" data-filter={category.name} data-category={category.name}>
                <span class="filter-tab__dot" aria-hidden="true"></span>
                <span class="filter-tab__label">{category.name}</span>
                <span class="filter-tab__count">{category.count}</span>
              </button>
            ))}
          </div>

          <button type="button" id="archive-reset-btn" class="archive-reset-btn" hidden aria-label="Reset all filters">
            <span>Reset Filters</span>
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      </div>
    </div>

    <section class="archive-ledger hc-container" aria-label="All entries">
      <div class="archive-status-bar">
        <p class="archive-result-count" id="archive-result-count" role="status" aria-live="polite">
          Showing <strong>{posts.length}</strong> of {posts.length} studies
        </p>
      </div>

      <ol class="ledger" id="ledger" data-motion="ledger">
        {entries.map(({ post, folio, dateLabel, dateISO, isNew, tags }) => (
          <li
            class="ledger-row"
            data-id={post.id}
            data-category={post.data.category}
            data-search={`${post.data.title} ${post.data.description ?? ''} ${post.data.category} ${tags.join(' ')} ${post.data.author}`.toLowerCase()}
          >
            <a href={`/blogs/${post.id}`} class="ledger-row__link">
              <div class="ledger-row__meta">
                <span class="ledger-row__folio">No. {folio}</span>
                <time class="ledger-row__date" datetime={dateISO}>{dateLabel}</time>
                {isNew && <span class="new-badge">New</span>}
              </div>

              <div class="ledger-row__body">
                <div class="ledger-row__header">
                  <span class="ledger-row__cat" data-category={post.data.category}>{post.data.category}</span>
                  <h2 class="ledger-row__title">{post.data.title}</h2>
                </div>

                {post.data.description && (
                  <p class="ledger-row__desc">{post.data.description}</p>
                )}

                <div class="ledger-row__match" hidden></div>

                {tags.length > 0 && (
                  <div class="ledger-row__tags" aria-label="Keywords">
                    {tags.slice(0, 4).map((tag: string) => (
                      <span class="ledger-tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>

              <div class="ledger-row__arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <div class="ledger-empty" id="ledger-empty" hidden>
        <div class="ledger-empty__icon" aria-hidden="true">◈</div>
        <h3>No Studies Found</h3>
        <p>No research entries match your active search or category filters.</p>
        <button type="button" class="hc-btn hc-btn--ghost" id="ledger-empty-reset">
          Clear Filters &amp; View All
        </button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initArchive() {
    const page = document.querySelector('.archive-page');
    if (!page) return;

    const chips = [...page.querySelectorAll<HTMLButtonElement>('.filter-tab')];
    const rows = [...page.querySelectorAll<HTMLLIElement>('.ledger-row')];
    const searchInput = page.querySelector<HTMLInputElement>('#archive-search-input');
    const searchClear = page.querySelector<HTMLButtonElement>('#archive-search-clear');
    const resetBtn = page.querySelector<HTMLButtonElement>('#archive-reset-btn');
    const emptyState = page.querySelector<HTMLElement>('#ledger-empty');
    const emptyReset = page.querySelector<HTMLButtonElement>('#ledger-empty-reset');
    const resultCount = page.querySelector<HTMLElement>('#archive-result-count');
    const totalEntries = rows.length;

    // Scroll progress handler
    const ledgerList = document.getElementById('ledger');
    const scrollBar = document.getElementById('scroll-bar');
    if (ledgerList && scrollBar) {
      window.addEventListener('scroll', () => {
        const rect = ledgerList.getBoundingClientRect();
        const total = ledgerList.scrollHeight - window.innerHeight + 200;
        let current = -rect.top;
        if (current < 0) current = 0;
        let progress = (current / total) * 100;
        if (progress > 100) progress = 100;
        if (progress < 0) progress = 0;
        scrollBar.style.width = `${progress}%`;
      }, { passive: true });
    }

    interface SearchSection {
      heading: string;
      slug: string;
      text: string;
    }
    interface SearchDoc {
      id: string;
      title: string;
      description: string;
      category: string;
      tags: string[];
      sections: SearchSection[];
      fullText: string;
    }

    const searchMap = new Map<string, SearchDoc>();

    fetch('/search-index.json')
      .then((res) => res.json() as Promise<SearchDoc[]>)
      .then((docs) => {
        docs.forEach((doc) => searchMap.set(doc.id, doc));
        if (query) applyFilters();
      })
      .catch(() => {});

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function createSnippet(text: string, term: string): string {
      const lower = text.toLowerCase();
      const idx = lower.indexOf(term.toLowerCase());
      if (idx === -1) return '';

      const start = Math.max(0, idx - 65);
      const end = Math.min(text.length, idx + term.length + 85);
      let snippet = text.slice(start, end);
      if (start > 0) snippet = '...' + snippet;
      if (end < text.length) snippet = snippet + '...';

      const escapedSnippet = escapeHtml(snippet);
      const escapedTerm = escapeHtml(term);
      const regex = new RegExp(`(${escapedTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      return escapedSnippet.replace(regex, '<mark class="search-match-mark">$1</mark>');
    }

    let activeCategory = 'all';
    let query = '';

    const updateControls = () => {
      const isFiltered = activeCategory !== 'all' || query.length > 0;
      if (resetBtn) resetBtn.hidden = !isFiltered;
      if (searchClear) searchClear.hidden = query.length === 0;
    };

    const setActiveChip = (category: string) => {
      const normalized = category.trim().toLowerCase();
      const chip = chips.find((c) => (c.dataset.filter ?? '').trim().toLowerCase() === normalized) || chips[0];
      activeCategory = chip.dataset.filter ?? 'all';
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      updateControls();
      return true;
    };

    const syncUrl = () => {
      const url = new URL(location.href);
      if (activeCategory === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', activeCategory);
      }
      query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
    };

    const applyFilters = () => {
      let visible = 0;

      for (const row of rows) {
        const id = row.dataset.id ?? '';
        const doc = searchMap.get(id);
        const matchesCategory = activeCategory === 'all' || row.dataset.category === activeCategory;

        let matchesQuery = !query;
        let matchSection: SearchSection | null = null;
        let matchSnippetHtml = '';

        if (query) {
          const titleDescMatch = (row.dataset.search ?? '').includes(query);
          if (titleDescMatch) {
            matchesQuery = true;
          }

          if (doc) {
            for (const sec of doc.sections) {
              const inHeading = sec.heading.toLowerCase().includes(query);
              const inText = sec.text.toLowerCase().includes(query);
              if (inHeading || inText) {
                matchesQuery = true;
                matchSection = sec;
                const source = inText ? sec.text : sec.heading;
                matchSnippetHtml = createSnippet(source, query);
                break;
              }
            }

            if (!matchSection && doc.fullText.toLowerCase().includes(query)) {
              matchesQuery = true;
              matchSnippetHtml = createSnippet(doc.fullText, query);
            }
          }
        }

        const show = matchesCategory && matchesQuery;
        row.hidden = !show;
        if (show) {
          visible += 1;
        }

        // Update direct section link and snippet box
        const link = row.querySelector<HTMLAnchorElement>('.ledger-row__link');
        const matchBox = row.querySelector<HTMLElement>('.ledger-row__match');

        if (link) {
          if (matchSection && matchSection.slug) {
            link.setAttribute('href', `/blogs/${id}#${matchSection.slug}`);
          } else {
            link.setAttribute('href', `/blogs/${id}`);
          }
        }

        if (matchBox) {
          if (show && matchSnippetHtml) {
            matchBox.hidden = false;
            const headingLabel = matchSection ? matchSection.heading : 'Article Content';
            matchBox.innerHTML = `
              <div class="search-match-box">
                <span class="search-match-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  <span>Matched in: <strong>${escapeHtml(headingLabel)}</strong></span>
                </span>
                <p class="search-match-text">${matchSnippetHtml}</p>
                <span class="search-match-jump">Jump to this section <span aria-hidden="true">→</span></span>
              </div>
            `;
          } else {
            matchBox.hidden = true;
            matchBox.innerHTML = '';
          }
        }
      }

      if (emptyState) emptyState.hidden = visible > 0;
      if (resultCount) {
        const catLabel = activeCategory === 'all' ? '' : ` in ${activeCategory}`;
        resultCount.innerHTML = `Showing <strong>${visible}</strong> of ${totalEntries} studies${catLabel}`;
      }
      updateControls();
    };

    const resetAll = () => {
      activeCategory = 'all';
      query = '';
      if (searchInput) searchInput.value = '';
      setActiveChip('all');
      syncUrl();
      applyFilters();
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        setActiveChip(chip.dataset.filter ?? 'all');
        syncUrl();
        applyFilters();
      });
    }

    searchInput?.addEventListener('input', () => {
      query = searchInput.value.trim().toLowerCase();
      syncUrl();
      applyFilters();
    });

    searchClear?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      query = '';
      syncUrl();
      applyFilters();
    });

    resetBtn?.addEventListener('click', resetAll);
    emptyReset?.addEventListener('click', resetAll);

    // Keyboard shortcut (Cmd/Ctrl + K) to focus search
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    const requested = new URLSearchParams(location.search).get('category');
    if (requested) {
      setActiveChip(requested);
    }
    const requestedQuery = new URLSearchParams(location.search).get('q');
    if (requestedQuery && searchInput) {
      searchInput.value = requestedQuery;
      query = requestedQuery.toLowerCase();
    }
    applyFilters();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArchive);
  } else {
    initArchive();
  }
  document.addEventListener('astro:page-load', initArchive);
</script>

<style>
  .archive-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 85% 0%, rgba(216, 177, 102, 0.06), transparent 32%),
      linear-gradient(180deg, var(--hc-surface-2) 0%, var(--hc-surface-0) 42%);
  }

  /* Hero */
  .archive-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 8vw, 7.5rem) 0 clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--hc-rule);
  }

  .archive-hero::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(216, 177, 102, 0.12);
    pointer-events: none;
  }

  .archive-hero__inner {
    position: relative;
    z-index: 1;
  }

  .archive-hero__label {
    margin: 0 0 1rem;
    animation: heroRise 0.7s var(--ease) both;
  }

  .archive-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--hc-text-primary);
    animation: heroRise 0.8s var(--ease) 60ms both;
  }

  .archive-hero__title em {
    font-style: italic;
    color: var(--hc-gold);
  }

  .archive-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.6rem;
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    animation: heroRise 0.8s var(--ease) 140ms both;
  }

  .archive-hero__diamond {
    width: 5px;
    height: 5px;
    border: 1px solid var(--hc-gold-dim);
    transform: rotate(45deg);
  }

  .archive-hero__lead {
    max-width: 680px;
    margin: 1.2rem 0 0;
    color: var(--hc-text-secondary);
    font-size: clamp(1.02rem, 0.4vw + 0.98rem, 1.18rem);
    line-height: 1.72;
    animation: heroRise 0.8s var(--ease) 200ms both;
  }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Filter toolbar */
  .archive-tools {
    position: sticky;
    top: var(--site-header-height, 72px);
    z-index: 40;
    border-bottom: 1px solid var(--hc-rule);
    background: rgba(20, 19, 18, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  :global([data-theme="light"]) .archive-tools {
    background: rgba(251, 249, 244, 0.94);
  }

  .scroll-progress {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: transparent;
  }

  .scroll-progress__bar {
    height: 100%;
    width: 0%;
    background: var(--hc-gold);
    transition: width 100ms ease;
  }

  .archive-tools__inner {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-block: 1rem;
  }

  /* Search Row */
  .archive-search-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .archive-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-height: 46px;
    padding: 0 1rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm, 8px);
    background: var(--hc-surface-1);
    transition: border-color 200ms ease, box-shadow 200ms ease, background 200ms ease;
  }

  .archive-search-wrap:focus-within {
    border-color: var(--hc-gold);
    box-shadow: 0 0 0 3px rgba(216, 177, 102, 0.18);
    background: var(--hc-surface-2);
  }

  .search-icon {
    color: var(--hc-gold-dim);
    margin-right: 0.75rem;
    flex-shrink: 0;
  }

  .archive-search-input {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--hc-text-primary);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    outline: none;
  }

  .archive-search-input::placeholder {
    color: var(--hc-text-tertiary);
  }

  .archive-search-clear {
    background: none;
    border: none;
    color: var(--hc-text-tertiary);
    font-size: 0.9rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    transition: color 180ms ease;
  }

  .archive-search-clear:hover {
    color: var(--hc-text-primary);
  }

  .search-kbd {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--hc-rule);
    border-radius: 6px;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--hc-text-tertiary);
    background: var(--hc-surface-1);
  }

  /* Filters Row */
  .archive-filters-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
  }

  .archive-filters-row::-webkit-scrollbar {
    display: none;
  }

  .archive-filters {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: nowrap;
  }

  /* Unique Category Color System for Filters */
  .filter-tab[data-filter="all"] {
    --tab-color: #c89b4b;
    --tab-bg: rgba(200, 155, 75, 0.12);
    --tab-border: rgba(200, 155, 75, 0.35);
    --tab-active-bg: #c89b4b;
    --tab-active-text: #141312;
  }

  .filter-tab[data-category="Origins & Early History"],
  .filter-tab[data-filter="Origins & Early History"] {
    --tab-color: #d48b52;
    --tab-bg: rgba(212, 139, 82, 0.12);
    --tab-border: rgba(212, 139, 82, 0.35);
    --tab-active-bg: #c4783d;
    --tab-active-text: #ffffff;
  }

  .filter-tab[data-category="Prophecies & Eschatology"],
  .filter-tab[data-filter="Prophecies & Eschatology"] {
    --tab-color: #e05a47;
    --tab-bg: rgba(224, 90, 71, 0.12);
    --tab-border: rgba(224, 90, 71, 0.35);
    --tab-active-bg: #c94532;
    --tab-active-text: #ffffff;
  }

  .filter-tab[data-category="Theology & Epistemology"],
  .filter-tab[data-filter="Theology & Epistemology"] {
    --tab-color: #4fa86c;
    --tab-bg: rgba(79, 168, 108, 0.12);
    --tab-border: rgba(79, 168, 108, 0.35);
    --tab-active-bg: #3f8e58;
    --tab-active-text: #ffffff;
  }

  .filter-tab[data-category="Transmission & Narrators"],
  .filter-tab[data-filter="Transmission & Narrators"] {
    --tab-color: #608fd6;
    --tab-bg: rgba(96, 143, 214, 0.12);
    --tab-border: rgba(96, 143, 214, 0.35);
    --tab-active-bg: #4f78b8;
    --tab-active-text: #ffffff;
  }

  .filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.9rem;
    border: 1px solid var(--tab-border, var(--hc-rule));
    border-radius: var(--radius-pill);
    background: var(--hc-surface-1);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    white-space: nowrap;
    transition: all 200ms ease;
  }

  .filter-tab__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tab-color, var(--hc-gold));
    display: inline-block;
    flex-shrink: 0;
    transition: transform 200ms ease, background 200ms ease;
  }

  .filter-tab:hover {
    color: var(--tab-color, var(--hc-text-primary));
    border-color: var(--tab-color, var(--hc-rule-strong));
    background: var(--tab-bg, var(--hc-surface-2));
  }

  .filter-tab:hover .filter-tab__dot {
