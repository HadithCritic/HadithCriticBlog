---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ArchiveEntry from '../../components/ArchiveEntry.astro';
import { getCollection } from 'astro:content';
import { OG } from '../../lib/seo';
import { CATEGORIES } from '../../lib/categories';
import { toEntries, byYear } from '../../lib/article-index';
import '../../styles/blog-index.css';

const posts = await getCollection('articles', ({ data }) => (import.meta.env.DEV || !data.draft) && !data.preview);
const entries = toEntries(posts);
const years = byYear(entries);

const [lead] = entries;

/* Branches, largest first, for the archive's filter list. */
const branches = CATEGORIES.map((category) => ({
  ...category,
  count: entries.filter((entry) => entry.post.data.category === category.name).length
})).filter((branch) => branch.count > 0).sort((a, b) => b.count - a.count);

const plural = (count: number, one: string, many = `${one}s`) => `${count} ${count === 1 ? one : many}`;
---

<BaseLayout
  image={OG.blogs}
  title="Blog: Research and Analysis | HadithCritic"
  description="Critical studies, transmission forensics, and historical analyses of prophetic reports and early Islamic source texts."
>
  <div class="hc-page bi-page">
    <PageHero
      class="bi-hero"
      title="Research, analysis,"
      accent="and critical inquiry."
      titleId="bi-title"
      kicker="Blog"
      art="/images/editorial/blog-hero.webp"
      focus="80% center"
      measure="20ch"
    >
      <p class="hc-hero__lede">
        Critical studies, transmission forensics, and historical analyses of prophetic reports
        and early Islamic source texts.
      </p>
      <Fragment slot="actions">
        <a href="#archive" class="hc-btn">Search the archive</a>
        <a href="/rss.xml" class="hc-btn hc-btn--ghost">Follow by RSS</a>
      </Fragment>
    </PageHero>

    <!-- The latest study as one wide card. -->
    <section class="bi-lead-band" aria-labelledby="bi-lead-title">
      <div class="hc-container">
        <h2 id="bi-lead-title" class="sr-only">Latest study</h2>
        <article class="bi-lead hc-parchment" data-category={lead.post.data.category} data-timestamp={lead.post.data.date.valueOf()}>
          <div class="bi-lead__copy">
            <p class="bi-lead__meta">
              <span>{lead.post.data.category}</span>
              <time datetime={lead.dateISO}>{lead.dateLabel}</time>
              <span>{lead.minutes} min read</span>
            </p>
            <h3 class="bi-lead__title">
              <a href={`/blogs/${lead.post.id}/`} class="bi-lead__link">{lead.post.data.title}</a>
            </h3>
            {lead.post.data.description && <p class="bi-lead__desc">{lead.post.data.description}</p>}
            <span class="bi-lead__cta" aria-hidden="true">Read the study <span>→</span></span>
          </div>
          <img
            class="bi-lead__image"
            src={lead.artwork?.src ?? lead.post.data.thumbnail ?? "/images/blog/thumbnails/tn.generic.webp"}
            srcset={lead.artwork?.srcset}
            sizes="(max-width: 860px) 100vw, 560px"
            width={lead.artwork?.width ?? 1672}
            height={lead.artwork?.height ?? 941}
            alt=""
            loading="eager"
            decoding="async"
          />
        </article>
      </div>
    </section>

    <!-- The whole archive, by year, with search and branch filters. -->
    <section class="hc-band bi-archive" id="archive" aria-labelledby="bi-archive-title">
      <div class="hc-container bi-archive__grid">
        <aside class="bi-tools" aria-label="Search and filter the archive">
          <div class="bi-tools__sticky">
            <h2 id="bi-archive-title" class="hc-head__title">The complete <span>archive</span></h2>
            <p class="hc-head__note">Every study, newest first, grouped by year of publication.</p>

            <form id="archive-search-form" class="bi-search" action="/blogs/" method="get" role="search" data-js-only hidden>
              <label class="sr-only" for="archive-search-input">Search titles, topics and the full text of every study</label>
              <div class="hc-field">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input type="search" id="archive-search-input" name="q" placeholder="Search the archive" autocomplete="off" spellcheck="false" />
                <button id="archive-search-clear" type="button" hidden>Clear</button>
              </div>
              <p class="bi-search__note">Titles, topics and the full text of every study.</p>
            </form>

            <nav class="bi-filter-nav" aria-label="Filter by branch">
              <ul class="hc-filters" id="bi-filters">
                <li>
                  <a href="/blogs/" class="hc-filter bi-chip is-active" data-filter="all" aria-current="true">
                    <span>All branches</span><span class="hc-filter__n">{entries.length}</span>
                  </a>
                </li>
                {branches.map((branch) => (
                  <li>
                    <a href={`/blogs/category/${branch.slug}/`} class="hc-filter bi-chip" data-filter={branch.name} data-category={branch.name}>
                      <span>{branch.name}</span><span class="hc-filter__n">{branch.count}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <div class="bi-tools__row" data-js-only hidden>
              <label class="bi-order">
                <span>Order</span>
                <select id="archive-order" class="hc-select">
                  <option value="latest">Newest first</option>
                  <option value="oldest">Oldest first</option>
                </select>
              </label>
              <button type="button" id="archive-reset-btn" class="bi-reset" hidden>Reset</button>
            </div>

            <p id="archive-result-count" class="bi-status" role="status" aria-live="polite">
              <span class="bi-status-text">{entries.length} studies in the archive</span>
            </p>
            <noscript>
              <p class="bi-status">Each branch above opens its own index. Your browser's Find command searches this page.</p>
            </noscript>
          </div>
        </aside>

        <div class="bi-ledger-wrap">
          <div id="ledger" class="bi-years">
            {years.map((group) => (
              <section class="bi-year" data-year={group.year} aria-labelledby={`bi-year-${group.year}`}>
                <header class="bi-year__head">
                  <h3 id={`bi-year-${group.year}`} class="bi-year__title">{group.year}</h3>
                  <span class="bi-year__count" data-total={group.entries.length}>{plural(group.entries.length, 'study', 'studies')}</span>
                </header>
                <ol class="bi-ledger">
                  {group.entries.map((entry) => <ArchiveEntry entry={entry} />)}
                </ol>
              </section>
            ))}
          </div>

          <div class="bi-empty" id="ledger-empty" hidden>
            <h3>No studies found</h3>
            <p>Nothing in the archive matches this search and branch.</p>
            <button type="button" id="ledger-empty-reset" class="hc-btn hc-btn--ghost">Clear search and filters</button>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>import '../../lib/blog-index';</script>
