---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ArchiveEntry from '../../../components/ArchiveEntry.astro';
import { getCollection } from 'astro:content';
import { OG, collectionPage } from '../../../lib/seo';
import { CATEGORIES } from '../../../lib/categories';
import { toEntries, byYear } from '../../../lib/article-index';
import '../../../styles/blog-index.css';

/**
 * Topic hub for one of the four study branches.
 *
 * These exist for discovery rather than for navigation: /blogs already
 * filters by branch, but a client-side filter is not a crawlable address and
 * cannot accumulate topical authority. Each hub is a stable URL that states
 * what the topic is and lists every study in it.
 */

export async function getStaticPaths() {
  const posts = await getCollection('articles', ({ data }) => !data.draft && !data.preview);
  return CATEGORIES.map((category) => ({
    params: { slug: category.slug },
    props: { category, all: posts, posts: posts.filter((post) => post.data.category === category.name) }
  }));
}

const { category, all, posts } = Astro.props;

/* Folios are numbered across the whole archive, so a study keeps its number here. */
const entries = toEntries(posts, all);
const years = byYear(entries);
const frontispiece = entries.find((entry) => entry.artwork);
const others = CATEGORIES.map((other) => ({
  ...other,
  count: all.filter((post) => post.data.category === other.name).length
})).filter((other) => other.slug !== category.slug && other.count > 0);

const pageUrl = new URL(`/blogs/category/${category.slug}/`, Astro.site).href;
const schema = [
  collectionPage({
    url: pageUrl,
    title: `${category.name} | HadithCritic`,
    description: category.blurb,
    about: category.about,
    items: posts.map((post) => ({ name: post.data.title, url: `/blogs/${post.id}/` }))
  })
];
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blogs/' },
  { name: category.name, url: `/blogs/category/${category.slug}/` }
];
const plural = (count: number) => `${count} ${count === 1 ? 'study' : 'studies'}`;
---

<BaseLayout
  image={OG.category(category.slug)}
  title={`${category.name} | HadithCritic`}
  description={category.blurb}
  canonical={`/blogs/category/${category.slug}/`}
  schema={schema}
  crumbs={crumbs}
>
  <div class="hc-page hc-plate bi-page bi-hub" data-category={category.name}>
    <PageHero title={category.name} titleId="hub-title" kicker="Blog" kickerHref="/blogs/" class="bi-hub-hero" measure="16ch">
      <p class="hc-hero__lede">{category.blurb}</p>
      {frontispiece?.artwork && (
        <figure slot="aside" class="bi-hub-plate">
          <img src={frontispiece.artwork.srcset.split(' ')[0]} alt={frontispiece.artwork.alt} width="720" height="480" loading="eager" decoding="async" />
          <figcaption>
            <span>Latest illustrated study</span>
            <a href={`/blogs/${frontispiece.post.id}/`}>{frontispiece.post.data.title}</a>
          </figcaption>
        </figure>
      )}
      <Fragment slot="register">
        <span><strong>{entries.length}</strong> {entries.length === 1 ? 'study' : 'studies'} in this branch</span>
        {years.length > 0 && (
          <span>Published <strong>{years[years.length - 1].year}</strong> to <strong>{years[0].year}</strong></span>
        )}
        <a href="/blogs/#archive">Search the whole archive</a>
      </Fragment>
    </PageHero>

    <section class="hc-band hc-band--warm" aria-labelledby="hub-list-title">
      <div class="hc-container bi-hub__layout">
        <div>
          <h2 id="hub-list-title" class="sr-only">Studies in {category.name}</h2>
          {years.length > 0 ? (
            <div class="bi-years">
              {years.map((group) => (
                <section class="bi-year" aria-labelledby={`hub-year-${group.year}`}>
                  <header class="bi-year__head">
                    <h3 id={`hub-year-${group.year}`} class="bi-year__title">{group.year}</h3>
                    <span class="bi-year__count">{plural(group.entries.length)}</span>
                  </header>
                  <ol class="bi-ledger">
                    {group.entries.map((entry) => <ArchiveEntry entry={entry} showCategory={false} />)}
                  </ol>
                </section>
              ))}
            </div>
          ) : (
            <p class="bi-status">No studies have been published in this branch yet.</p>
          )}
        </div>

        <aside class="bi-hub__aside" aria-labelledby="hub-others-title">
          <p class="hc-rubric" id="hub-others-title">Other branches</p>
          <ul class="hc-filters">
            {others.map((other) => (
              <li>
                <a href={`/blogs/category/${other.slug}/`} class="hc-filter" data-category={other.name}>
                  <span>{other.name}</span><span class="hc-filter__n">{other.count}</span>
                </a>
              </li>
            ))}
            <li>
              <a href="/blogs/" class="hc-filter">
                <span>The whole archive</span><span class="hc-filter__n">{all.length}</span>
              </a>
            </li>
          </ul>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>
