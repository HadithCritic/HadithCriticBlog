---
/**
 * An article page: one text column with its contents in the margin on wide
 * screens, the header as a title page, the body styled by
 * src/styles/article.css, and the end matter after the last note. There is
 * deliberately no progress bar, reading-settings panel, toolbar or floating
 * control.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHeader from '../../components/article/shell/ArticleHeader.astro';
import ArticleContents from '../../components/article/shell/ArticleContents.astro';
import ArticleEnd from '../../components/article/shell/ArticleEnd.astro';
import FootnoteSheet from '../../components/article/shell/FootnoteSheet.astro';
import { getCollection, render } from 'astro:content';
import { scholarlyArticle, author } from '../../lib/seo';
import { categoryByName } from '../../lib/categories';
import { blogArtwork } from '../../data/blog-artwork';

const includeBlogMakerPreview = process.env.BLOG_MAKER_PREVIEW === 'true';

export async function getStaticPaths() {
  const posts = await getCollection('articles', ({ data }) => {
    if (data.preview) return includeBlogMakerPreview;
    return import.meta.env.DEV || !data.draft;
  });

  const sorted = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const folio = (post: (typeof sorted)[number]) => String(sorted.length - sorted.indexOf(post)).padStart(3, '0');
  const dateLabel = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  return sorted.map((post, index) => {
    const sameBranch = sorted.filter((p) => p.data.category === post.data.category);
    const further = sameBranch
      .filter((p) => p.id !== post.id)
      .slice(0, 3) // three, newest first: enough to continue, not a feed
      .map((p) => ({ href: `/blogs/${p.id}/`, title: p.data.title, folio: folio(p), dateLabel: dateLabel(p.data.date) }));
    const earlier = sorted[index + 1];
    const later = sorted[index - 1];
    return {
      params: { id: post.id },
      props: {
        post,
        folio: folio(post),
        further,
        categoryCount: sameBranch.length,
        earlier: earlier ? { href: `/blogs/${earlier.id}/`, title: earlier.data.title } : undefined,
        later: later ? { href: `/blogs/${later.id}/`, title: later.data.title } : undefined
      }
    };
  });
}

const { post, folio, further, categoryCount, earlier, later } = Astro.props;
const { Content, headings } = await render(post);
const artwork = blogArtwork[post.id];
const articleImage = artwork?.src ?? post.data.thumbnail;

const rawBody = post.body || '';
const wordCount = rawBody.replace(/<[^>]*>/g, '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
const longDate = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

/* Contents: sections and subsections, once each, never the footnote label. */
const seen = new Set<string>();
const contents = headings
  .filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label')
  .filter((h) => (seen.has(h.slug) ? false : (seen.add(h.slug), true)))
  .map((h) => ({ depth: h.depth, text: h.text, slug: h.slug }));
const showContents = contents.length >= 2;

const category = categoryByName(post.data.category);
const categoryHref = category ? `/blogs/category/${category.slug}/` : '/blogs/';

const articleSchema = [
  author(post.data.author),
  scholarlyArticle({
    url: new URL(`/blogs/${post.id}/`, Astro.site).href,
    title: post.data.title,
    description: post.data.description,
    authorName: post.data.author,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.updated?.toISOString(),
    image: articleImage,
    section: post.data.category,
    keywords: post.data.tags,
    wordCount,
    about: category?.about
  })
];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Studies', url: '/blogs/' },
  ...(category ? [{ name: category.name, url: categoryHref }] : []),
  { name: post.data.title, url: `/blogs/${post.id}/` }
];
---

<BaseLayout
  title={`${post.data.title} | HadithCritic`}
  description={post.data.description}
  image={articleImage}
  canonical={`/blogs/${post.id}/`}
  type="article"
  schema={articleSchema}
  crumbs={crumbs}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.updated?.toISOString()}
  section={post.data.category}
  tags={post.data.tags}
>
  {/* A div, not a second main: BaseLayout supplies the page's one main
      landmark, and tests/routes.spec.ts asserts there is exactly one. */}
  <div class="hc-article" data-category={post.data.category}>
    {/* The title page spans the page, above the reading column and its margin. */}
    <ArticleHeader
      title={post.data.title}
      description={post.data.description}
      category={post.data.category}
      categoryHref={categoryHref}
      author={post.data.author}
      dateISO={post.data.date.toISOString()}
      dateLabel={longDate(post.data.date)}
      updatedISO={post.data.updated?.toISOString()}
      updatedLabel={post.data.updated ? longDate(post.data.updated) : undefined}
      readingMinutes={readingMinutes}
      folio={folio}
      heroImage={articleImage}
      heroSrcset={artwork?.srcset}
      heroWidth={artwork?.width}
      heroHeight={artwork?.height}
      heroAlt={artwork?.alt ?? post.data.heroAlt}
      heroEngraving={Boolean(artwork)}
    />

    <div class="hc-article__grid">
      {showContents && (
        <aside class="hc-article__margin">
          <ArticleContents headings={contents} placement="margin" />
        </aside>
      )}

      <article id="main-article" class="hc-article__main" aria-labelledby="article-title">
        {showContents && <ArticleContents headings={contents} placement="inline" />}

        <div class="hc-article-body">
          <Content />
        </div>

        <ArticleEnd
          tags={post.data.tags}
          category={post.data.category}
          categoryHref={categoryHref}
          categoryCount={categoryCount}
          earlier={earlier}
          later={later}
          further={further}
        />
      </article>
    </div>

    {/* Inside the article so the dialog inherits the reader palette. */}
    <FootnoteSheet />
  </div>
</BaseLayout>
