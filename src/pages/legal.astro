---
import BaseLayout from '../layouts/BaseLayout.astro';

const lastUpdated = 'June 26, 2026';

const privacyNotes = [
  {
    title: 'What we collect',
    body:
      'HadithCritic does not run user accounts, comments, paywalls, or public profiles. If you use the contact form, we collect the name, email address, topic, and message you submit so we can read and respond to the inquiry. The site host may also process ordinary technical logs such as IP address, browser type, requested pages, timestamps, and security events.'
  },
  {
    title: 'Contact form handling',
    body:
      'Messages submitted through the contact page are processed by a form service before reaching HadithCritic. Do not send passwords, private documents, payment information, or sensitive personal material through the form unless you are comfortable transmitting it through a third-party form provider.'
  },
  {
    title: 'Cookies and local storage',
    body:
      'The site may use essential browser storage for basic preferences, such as remembering light or dark mode. HadithCritic does not need tracking cookies for ordinary reading. Embedded services, such as video players or external platforms, may set their own cookies or collect usage information when you choose to interact with them.'
  },
  {
    title: 'How information is used',
    body:
      'Information is used to operate and secure the site, respond to messages, prevent spam or abuse, improve pages and navigation, preserve necessary records, and comply with lawful obligations. HadithCritic does not sell personal information.'
  },
  {
    title: 'Retention and deletion',
    body:
      'Contact messages may be kept as long as reasonably needed for correspondence, corrections, source submissions, abuse prevention, or recordkeeping. You may ask for a prior contact message to be deleted, and reasonable requests will be honored unless retention is necessary for security, legal, or archival reasons.'
  },
  {
    title: 'Security limits',
    body:
      'Reasonable measures are used to protect the site and correspondence, but no website, hosting platform, form backend, email system, or internet transmission can be guaranteed perfectly secure.'
  }
];

const termNotes = [
  {
    title: 'Research and commentary',
    body:
      'The site publishes independent research, criticism, source analysis, historical argument, and commentary. It is not a religious authority, legal service, academic institution, publisher of official doctrine, or professional advisory service.'
  },
  {
    title: 'Use of the site',
    body:
      'You may read, link to, and quote limited portions of the site with attribution. Do not scrape the site abusively, interfere with security, misrepresent HadithCritic material as your own, or use the site in a way that damages the project or violates the rights of others.'
  },
  {
    title: 'Original material',
    body:
      'Original articles, diagrams, page designs, translations, notes, and code-based visuals are owned by HadithCritic or their respective contributors unless a page states otherwise. Permission is required before republishing, redistributing, or commercially using substantial portions of the site.'
  },
  {
    title: 'Quoted sources',
    body:
      'The site quotes, translates, summarizes, cites, or links to third-party texts for research, criticism, commentary, and educational discussion. Third-party rights remain with their respective owners. If you believe material has been used improperly, contact HadithCritic with the page URL and relevant details.'
  },
  {
    title: 'Accuracy and corrections',
    body:
      'HadithCritic aims for careful source-level argument, but errors in references, translation, formatting, dates, interpretation, or external links can occur. Corrections and source notes are welcome through the contact page.'
  },
  {
    title: 'External sites and embeds',
    body:
      'Links, embeds, social platforms, video players, repositories, archives, and other external services are controlled by their own operators. HadithCritic is not responsible for their content, availability, privacy practices, security, or later changes.'
  }
];
---

<BaseLayout
  title="Privacy & Terms | HadithCritic"
  description="The HadithCritic privacy policy and terms of use for a research blog."
>
  <div class="legal-page">
    <div class="hc-container legal-container">
      {/* Logo + Title lockup */}
      <div class="legal-header">
        <div class="legal-lockup">
          <img
            src="/images/brand/hc-logo-transparent-512.png"
            alt=""
            width="48"
            height="48"
            class="legal-logo"
          />
          <h1 class="legal-title">Privacy &amp; Terms</h1>
        </div>
        <div class="legal-rule" aria-hidden="true"></div>
      </div>

      {/* Intro */}
      <div class="legal-intro">
        <p>
          A plain-language policy for a research blog: minimal data collection, clear use of
          source material, and practical rules for reading, quoting, contacting, and linking.
          HadithCritic does not use user accounts and does not sell personal data.
        </p>
        <p class="legal-updated">Last updated: {lastUpdated}</p>
      </div>

      {/* Privacy Policy */}
      <h2 class="legal-section-title">Privacy Policy</h2>
      {privacyNotes.map((note) => (
        <div class="legal-clause">
          <h3 class="legal-clause-title">{note.title}</h3>
          <p class="legal-clause-body">{note.body}</p>
        </div>
      ))}

      {/* Terms of Use */}
      <h2 class="legal-section-title">Terms of Use</h2>
      {termNotes.map((note) => (
        <div class="legal-clause">
          <h3 class="legal-clause-title">{note.title}</h3>
          <p class="legal-clause-body">{note.body}</p>
        </div>
      ))}

      {/* General Disclaimer */}
      <h2 class="legal-section-title">General Disclaimer</h2>
      <div class="legal-clause">
        <p class="legal-clause-body">
          HadithCritic provides the site and its content without guarantees of uninterrupted
          availability, error-free operation, or complete accuracy. To the fullest extent permitted
          by law, HadithCritic and its operators are not liable for losses arising from use of the
          site, reliance on its content, external links, embeds, or temporary unavailability.
        </p>
        <p class="legal-clause-body">
          Policies may be updated as the site changes. Continued use of the site after an update
          means you accept the revised version.
        </p>
      </div>

      {/* Contact */}
      <h2 class="legal-section-title">Contact Information</h2>
      <div class="legal-clause">
        <p class="legal-clause-body">
          For any questions or concerns regarding the privacy policy or terms of use, please send a message through the <a href="/contact">contact page</a>.
        </p>
      </div>

      {/* Footer link */}
      <div class="legal-footer-links">
        <a href="/">← Home</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-page {
    padding: clamp(4rem, 10vw, 7rem) 0 clamp(5rem, 12vw, 9rem);
  }

  .legal-container {
    max-width: 680px;
    margin: 0 auto;
    width: 100%;
  }

  /* ── Header: logo + title lockup ── */
  .legal-header {
    margin-bottom: 2.5rem;
  }

  .legal-lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .legal-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
    flex-shrink: 0;
    opacity: 0.9;
  }

  .legal-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 2.9rem);
    font-weight: 500;
    color: var(--hc-fixed-parchment);
    margin: 0;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .legal-rule {
    height: 1px;
    background: linear-gradient(90deg, var(--hc-gold-dim), transparent 70%);
    opacity: 0.6;
  }

  /* ── Intro ── */
  .legal-intro {
    margin-bottom: 3rem;
  }

  .legal-intro p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--hc-text-secondary);
    margin: 0 0 0.75rem;
  }

  .legal-updated {
    font-family: var(--font-ui);
    font-size: 0.82rem !important;
    color: var(--hc-gold-dim) !important;
    letter-spacing: 0.04em;
    margin-top: 1rem !important;
  }

  /* ── Section titles ── */
  .legal-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 500;
    color: var(--hc-fixed-parchment);
    margin: 3.5rem 0 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--hc-rule);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  /* ── Clauses ── */
  .legal-clause {
    margin-bottom: 1.75rem;
  }

  .legal-clause-title {
    font-family: var(--font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--hc-fixed-parchment);
    margin: 0 0 0.5rem;
    letter-spacing: 0.01em;
  }

  .legal-clause-body {
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--hc-text-secondary);
    margin: 0 0 1rem;
  }

  .legal-clause-body:last-child {
    margin-bottom: 0;
  }

  .legal-clause a {
    color: var(--hc-gold);
    text-decoration: none;
    border-bottom: 1px solid rgba(216, 177, 102, 0.25);
    padding-bottom: 0.1em;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .legal-clause a:hover {
    color: var(--hc-gold-soft);
    border-bottom-color: var(--hc-gold-soft);
  }

  /* ── Footer links ── */
  .legal-footer-links {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hc-rule);
  }

  .legal-footer-links a {
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--hc-gold-dim);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 200ms ease;
  }

  .legal-footer-links a:hover {
    color: var(--hc-gold);
  }
</style>
