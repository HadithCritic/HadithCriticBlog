---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeometricEmblem from '../components/GeometricEmblem.astro';

const lastUpdated = 'August 31, 2026';
const documentVersion = 'v3.4';

const principles = [
  {
    num: '01',
    label: 'Tracking',
    claim: 'Zero Commercial Trackers',
    desc: 'No third-party advertising pixels, behavioral analytics, or monetization cookies are ever loaded.'
  },
  {
    num: '02',
    label: 'Language',
    claim: 'Plain-Language Terms',
    desc: 'Written clearly for students, researchers, and readers without deceptive legal obfuscation.'
  },
  {
    num: '03',
    label: 'Citation',
    claim: 'Open Academic Use',
    desc: 'Unrestricted quotation, isnād critique, and academic fair dealing with transparent attribution.'
  },
  {
    num: '04',
    label: 'Control',
    claim: 'Direct Data Erasure',
    desc: 'Voluntarily submitted contact inquiries are deleted promptly upon simple email or form request.'
  }
];

const sections = [
  {
    id: 'privacy',
    roman: 'I',
    title: 'Privacy & Data Protection',
    subtitle: 'Minimal data footprint, absence of user accounts, and technical log handling.',
    clauses: [
      {
        id: 'no-accounts',
        code: '§ 1.1',
        name: 'Absence of User Accounts & Public Profiles',
        badge: 'Zero Accounts',
        thesis: 'HadithCritic operates without user registrations, login portals, comment systems, or paywalls.',
        prose: 'Every published investigation, interactive diagram, and research catalog on this website is completely open and accessible without user registration or credential harvesting. We do not build user profiles, track reading histories across sessions, or monetize visitor data in any form.',
        annotation: 'Because there are no user accounts, you never store passwords or personal identity credentials on our servers.'
      },
      {
        id: 'contact-transmission',
        code: '§ 1.2',
        name: 'Contact Inquiries & Form Transmission',
        badge: 'Encrypted Relay',
        thesis: 'Messages submitted via our contact page are relayed securely to prevent raw email scraping.',
        prose: 'When you submit a research inquiry, source submission, or errata report, we collect only the details you voluntarily provide: name, email address, topic, and message body. These inquiries are processed through Web3Forms API to safeguard our editorial inbox from automated bot harvesting.',
        annotation: 'Do not transmit private financial data, sensitive passwords, or confidential identity documents through public contact forms.'
      },
      {
        id: 'cookies-storage',
        code: '§ 1.3',
        name: 'Local Browser Preferences & Cookies',
        badge: 'Essential UI Only',
        thesis: 'We use local storage exclusively for essential UI state, such as remembering your light or dark theme.',
        prose: 'HadithCritic does not deploy advertising cookies, tracking beacons, or cross-site fingerprinting scripts. Your browser’s localStorage is utilized strictly to persist your preferred color mode (Dark Archive vs. Sunlit Manuscript).',
        annotation: 'If you interact with embedded third-party video players (e.g., YouTube lectures), those external hosts may set their own technical or analytics cookies.'
      },
      {
        id: 'data-erasure',
        code: '§ 1.4',
        name: 'Data Retention & Right to Immediate Erasure',
        badge: 'Erasure Guarantee',
        thesis: 'Correspondence is retained solely for editorial follow-up and expunged upon request.',
        prose: 'Contact correspondence is maintained only as long as necessary to address research inquiries or incorporate verified errata into published studies. You retain the right to request permanent deletion of past messages at any time.',
        annotation: 'To request message deletion, submit an inquiry via the contact page. Verified erasure requests are honored without delay.'
      },
      {
        id: 'security-infrastructure',
        code: '§ 1.5',
        name: 'Transport Encryption & Edge Infrastructure',
        badge: 'TLS 1.3 & Edge CDN',
        thesis: 'All network traffic is encrypted via HTTPS and distributed through high-resilience edge networks.',
        prose: 'HadithCritic is served exclusively over HTTPS with modern TLS encryption and deployed across Cloudflare edge infrastructure to ensure high availability, DDoS mitigation, and tamper-resistant delivery.',
        annotation: 'While strict industry measures are maintained, no internet transmission can be guaranteed completely immune from external service interruptions.'
      }
    ]
  },
  {
    id: 'terms',
    roman: 'II',
    title: 'Terms of Use & Archive Access',
    subtitle: 'Institutional scope, acceptable network conduct, and intellectual property boundaries.',
    clauses: [
      {
        id: 'archive-scope',
        code: '§ 2.1',
        name: 'Independent Research & Scholarly Scope',
        badge: 'Editorial Scope',
        thesis: 'HadithCritic is an independent critical publication and historical research archive.',
        prose: 'The work published here consists of independent textual criticism, transmission forensics, isnad-cum-matn analysis, and historiographical commentary on early Islamic literature. This project does not function as an ecclesiastical authority, a fatwa board, an institutional legal service, or an official arbiter of theological orthodoxy.',
        annotation: 'Readers are encouraged to examine primary manuscript sources and evaluate arguments on the basis of verifiable evidence.'
      },
      {
        id: 'network-conduct',
        code: '§ 2.2',
        name: 'Acceptable Use & Network Protection',
        badge: 'Access Standards',
        thesis: 'Non-commercial study, citation, and educational discussion are encouraged; malicious scraping is prohibited.',
        prose: 'You are welcome to read, link to, download for personal reference, and cite all open material across the archive. You agree not to engage in aggressive automated scraping that degrades infrastructure performance, attempt to bypass network security controls, or misrepresent HadithCritic research as your own.',
        annotation: 'Fair automated indexing for public search engines and academic discovery tools is permitted under standard robots.txt protocols.'
      },
      {
        id: 'original-material',
        code: '§ 2.3',
        name: 'Original Research, Diagrams & Data Visualizations',
        badge: 'Attribution Rights',
        thesis: 'Original essays, synthesized isnād graphs, and data tools are protected with open citation rights.',
        prose: 'All original critical essays, synthesized isnād diagrams, custom graph datasets, interactive tools, and editorial design are the intellectual property of HadithCritic. Scholarly citation, brief quotation, and critical review are welcomed with clear attribution and a link back to the source.',
        annotation: 'Full-scale commercial mirroring, automated content republishing, or bulk reproduction without prior written consent is strictly prohibited.'
      },
      {
        id: 'classical-sources',
        code: '§ 2.4',
        name: 'Quotation of Historical Manuscripts & Classical Texts',
        badge: 'Fair Dealing',
        thesis: 'Historical manuscripts and classical Arabic compendia are quoted under academic fair dealing.',
        prose: 'This archive translates, annotates, collates, and critiques historical manuscripts and classical Arabic compendia (such as the works of al-Bukhārī, Muslim, al-Shāfiʿī, Ibn Abī Shayba, and al-Dhahabī) in the public interest for academic critique, educational debate, and historical inquiry.',
        annotation: 'If any copyright holder believes an excerpt exceeds legitimate academic fair dealing, please contact the editorial desk for review.'
      }
    ]
  },
  {
    id: 'citation',
    roman: 'III',
    title: 'Evidentiary Standards & Citation Ethics',
    subtitle: 'Verification over reputation, errata protocols, and external manuscript links.',
    clauses: [
      {
        id: 'evidentiary-ethos',
        code: '§ 3.1',
        name: 'Evidentiary Ethos: Verification Over Reputation',
        badge: 'Core Ethos',
        thesis: 'Traditions and historical claims are evaluated strictly against empirical textual and transmission evidence.',
        prose: 'Our core commitment is Verification Over Reputation: reports are examined through rigorous isnad-cum-matn collation, chronological stratification, and primary manuscript cross-checks rather than traditional prestige or canonical consensus.',
        annotation: 'We publish our arguments with full citation apparatus so that every claim can be audited by independent scholars.'
      },
      {
        id: 'errata-peer-review',
        code: '§ 3.2',
        name: 'Errata & Source Submission Policy',
        badge: 'Open Peer Review',
        thesis: 'Factual accuracy is foundational; verified corrections are welcomed and incorporated transparently.',
        prose: 'Scholarly critique demands continuous precision. If you identify a factual error in citation, Arabic transliteration, transmission attribution, or chronological dating, we invite you to submit the primary source reference via our contact form.',
        annotation: 'Verified corrections are integrated into published articles with editorial transparency and attribution.'
      },
      {
        id: 'external-repositories',
        code: '§ 3.3',
        name: 'Third-Party Repositories & External Media',
        badge: 'External Archives',
        thesis: 'Links to external academic repositories and platforms operate under their own independent terms.',
        prose: 'HadithCritic links to external academic repositories, YouTube video lectures, GitBook monographs, and digital manuscript libraries for educational reference. HadithCritic does not control and assumes no liability for external website availability or third-party content changes.',
        annotation: 'Always verify external terms and licensing when referencing materials hosted on outside academic servers.'
      }
    ]
  },
  {
    id: 'disclaimers',
    roman: 'IV',
    title: 'Disclaimers & Limitations of Liability',
    subtitle: 'Educational warranties, liability boundaries, and timestamped policy revisions.',
    clauses: [
      {
        id: 'no-warranty',
        code: '§ 4.1',
        name: 'No Warranty & Educational Disclaimers',
        badge: 'As-Is Basis',
        thesis: 'Published research is provided for educational and critical study without operational warranties.',
        prose: 'Material on HadithCritic is offered on an "as-is" and "as-available" basis for historical inquiry and educational discussion. While exhaustive methodological care is exercised, no warranty is made regarding complete immunity from historical debate or uninterrupted website availability.',
        annotation: 'Readers are encouraged to exercise critical judgment and examine cited primary literature independently.'
      },
      {
        id: 'liability-limits',
        code: '§ 4.2',
        name: 'Limitation of Legal Liability',
        badge: 'Legal Limit',
        thesis: 'HadithCritic and its contributors are not liable for indirect damages arising from archive access.',
        prose: 'To the fullest extent permitted by applicable law, HadithCritic, its contributors, and operators shall not be liable for any direct, indirect, or consequential damages resulting from the use or inability to use this educational resource.',
        annotation: 'This includes reliance upon historical deductions, external manuscript links, or temporary network maintenance.'
      },
      {
        id: 'revision-protocol',
        code: '§ 4.3',
        name: 'Modifications & Revision Timestamp Protocol',
        badge: 'Revisions',
        thesis: 'Policies are updated transparently with clear effective dates posted at the head of this document.',
        prose: 'These guidelines may be refined periodically as the research archive expands or new visual tools are deployed. Revisions take effect immediately upon publication with an updated effective date at the top of the page.',
        annotation: 'Continued interaction with the website following a revision constitutes acceptance of the updated terms.'
      }
    ]
  }
];
---

<BaseLayout
  title="Privacy Policy & Terms of Use | HadithCritic"
  description="Institutional privacy policy, terms of use, academic citation standards, and editorial ethics for the HadithCritic research archive."
>
  <article class="codex-page">
    <!-- Editorial Masthead -->
    <header class="codex-masthead">
      <div class="hc-container">
        <div class="masthead-inner">
          <div class="masthead-eyebrow">
            <span class="masthead-glyph" aria-hidden="true">◈</span>
            <span>Archival Governance · Editorial Standards</span>
          </div>

          <h1 class="masthead-title">
            Privacy Policy <em>&amp;</em> Terms of Use
          </h1>

          <p class="masthead-lead">
            The institutional framework governing independent research, reader privacy, evidentiary integrity, and academic fair dealing for the HadithCritic research archive.
          </p>

          <div class="masthead-meta-strip" role="region" aria-label="Document Metadata">
            <span class="meta-item">
              <span class="meta-dot" aria-hidden="true"></span>
              Effective: <strong>{lastUpdated}</strong>
            </span>
            <span class="meta-sep" aria-hidden="true">/</span>
            <span class="meta-item">Document: <strong>{documentVersion}</strong></span>
            <span class="meta-sep" aria-hidden="true">/</span>
            <span class="meta-item">Scope: <strong>Open Academic Commons</strong></span>
            <span class="meta-sep" aria-hidden="true">/</span>
            <span class="meta-item">Tracking: <strong>Zero Commercial Pixels</strong></span>
          </div>
        </div>
      </div>
    </header>

    <!-- Institutional Charter: Typographic Ledger Specimen -->
    <section class="codex-charter" aria-labelledby="charter-heading">
      <div class="hc-container">
        <h2 id="charter-heading" class="sr-only">Core Institutional Principles</h2>
        <div class="charter-specimen">
          {principles.map((p) => (
            <div class="charter-column">
              <div class="charter-tag">
                <span class="charter-num">{p.num}</span>
                <span class="charter-label">{p.label}</span>
              </div>
              <h3 class="charter-claim">{p.claim}</h3>
              <p class="charter-desc">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Main Ledger Body (Marginalia Split Architecture) -->
    <div class="hc-container codex-body">
      <div class="codex-layout">
        <!-- Sticky Left Directory Navigation -->
        <aside class="codex-aside" aria-label="Policy Directory">
          <div class="codex-sticky-wrap">
            <div class="codex-directory-card">
              <div class="directory-head">
                <GeometricEmblem size="32px" animate="hover" />
                <span class="directory-title">Document Directory</span>
              </div>

              <!-- Quick In-Document Search -->
              <div class="directory-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input
                  type="search"
                  id="codex-search-input"
                  placeholder="Filter clauses by keyword…"
                  aria-label="Filter policy clauses"
                />
              </div>

              <nav class="directory-nav" id="directory-nav">
                <ul class="directory-list">
                  {sections.map((sec) => (
                    <li>
                      <a href={`#section-${sec.id}`} class="directory-link" data-section-link={sec.id}>
                        <span class="link-roman">{sec.roman}</span>
                        <span class="link-label">{sec.title}</span>
                      </a>
                    </li>
                  ))}
                  <li>
                    <a href="#section-inquiries" class="directory-link" data-section-link="inquiries">
                      <span class="link-roman">V</span>
                      <span class="link-label">Governance &amp; Errata Desk</span>
                    </a>
                  </li>
                </ul>
              </nav>

              <div class="directory-foot">
                <span class="foot-label">Editorial Contact</span>
                <p>Have an inquiry, data deletion request, or errata to submit?</p>
                <a href="/contact" class="directory-btn">
                  Write to HadithCritic &rarr;
                </a>
              </div>
            </div>
          </div>
        </aside>

        <!-- Right Column: The Policy Ledger -->
        <main class="codex-main" id="codex-main">
          {sections.map((sec) => (
            <section class="ledger-section" id={`section-${sec.id}`} data-section-anchor={sec.id}>
              <!-- Section Header -->
              <header class="section-head">
                <div class="section-badge">
                  <span>Section {sec.roman}</span>
                </div>
                <h2 class="section-title">{sec.title}</h2>
                <p class="section-subtitle">{sec.subtitle}</p>
              </header>

              <!-- Clauses Ledger Stack -->
              <div class="clauses-ledger">
                {sec.clauses.map((clause) => (
                  <article
                    class="clause-row"
                    id={clause.id}
                    data-clause-filter={`${clause.code} ${clause.name} ${clause.badge} ${clause.thesis} ${clause.prose} ${clause.annotation}`.toLowerCase()}
                  >
                    <!-- Marginalia / Left Header Column -->
                    <div class="clause-marginalia">
                      <span class="marginalia-code">{clause.code}</span>
                      <span class="marginalia-badge">{clause.badge}</span>
                      <h3 class="marginalia-title">{clause.name}</h3>
                    </div>

                    <!-- Editorial Content / Right Column -->
                    <div class="clause-content">
                      <div class="clause-thesis-block">
                        <p class="clause-thesis">{clause.thesis}</p>
                      </div>

                      <p class="clause-prose">{clause.prose}</p>

                      <div class="clause-annotation-box">
                        <span class="annotation-glyph" aria-hidden="true">¶</span>
                        <p class="annotation-text">{clause.annotation}</p>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}

          <!-- No Results Indicator for Live Filter -->
          <div class="filter-empty-state" id="filter-empty-state" hidden>
            <span class="empty-glyph">◈</span>
            <h3>No matching clauses found</h3>
            <p>No policy clauses match your active keyword filter.</p>
            <button type="button" class="hc-btn hc-btn--ghost" id="clear-codex-filter">
              Reset Filter
            </button>
          </div>

          <!-- Section V: Inquiries & Errata Desk -->
          <section class="ledger-section" id="section-inquiries" data-section-anchor="inquiries">
            <header class="section-head">
              <div class="section-badge">
                <span>Section V</span>
              </div>
              <h2 class="section-title">Governance &amp; Errata Desk</h2>
              <p class="section-subtitle">Formal inquiries, right to erasure requests, and source citation peer review.</p>
            </header>

            <div class="governance-desk">
              <div class="governance-desk__main">
                <p class="governance-statement">
                  Our research archive depends on rigorous textual verification and reader trust. For any questions regarding policy application, requests for permanent data deletion, or proposed corrections to published investigations:
                </p>
                <div class="governance-actions">
                  <a href="/contact" class="hc-btn">
                    Submit Inquiry or Errata &rarr;
                  </a>
                  <a href="/academia" class="hc-btn hc-btn--ghost">
                    Examine Research Methodology
                  </a>
                </div>
              </div>

              <div class="governance-desk__spec">
                <div class="spec-row">
                  <span class="spec-label">Editorial Response</span>
                  <span class="spec-val">Prompt Review</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">Source Verification</span>
                  <span class="spec-val">Manuscript Collation</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">Data Retention</span>
                  <span class="spec-val">Voluntary &amp; Erasable</span>
                </div>
              </div>
            </div>
          </section>

          <!-- Colophon Footer Links -->
          <div class="codex-colophon">
            <a href="/" class="colophon-link">
              <span aria-hidden="true">&larr;</span> Return to Home
            </a>
            <a href="/blogs" class="colophon-link">
              Browse Research Archive &rarr;
            </a>
          </div>
        </main>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  function initCodexPage() {
    const searchInput = document.getElementById('codex-search-input') as HTMLInputElement | null;
    const sections = document.querySelectorAll<HTMLElement>('.ledger-section');
    const emptyState = document.getElementById('filter-empty-state');
    const clearBtn = document.getElementById('clear-codex-filter');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.directory-link');

    // Live search / filter
    const performFilter = (query: string) => {
      const q = query.trim().toLowerCase();
      let visibleCount = 0;

      sections.forEach((sec) => {
        const rows = sec.querySelectorAll<HTMLElement>('.clause-row');
        let secVisible = 0;

        rows.forEach((row) => {
          const text = row.dataset.clauseFilter || '';
          const match = !q || text.includes(q);
          row.hidden = !match;
          if (match) {
            secVisible++;
            visibleCount++;
          }
        });

        // If it has clause rows, hide the section if none match; if it's the governance section, keep it visible if no query
        if (rows.length > 0) {
          sec.hidden = secVisible === 0;
        } else {
          sec.hidden = !!q;
        }
      });

      if (emptyState) {
        emptyState.hidden = visibleCount > 0 || !q;
      }
    };

    searchInput?.addEventListener('input', () => {
      performFilter(searchInput.value);
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      performFilter('');
    });

    // Smooth scroll for nav links
    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('href')?.replace('#', '');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          e.preventDefault();
          const top = targetEl.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top, behavior: 'smooth' });
          history.replaceState(null, '', `#${targetId}`);
        }
      });
    });

    // Scrollspy
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const anchor = entry.target.getAttribute('data-section-anchor');
            navLinks.forEach((link) => {
              const matches = link.dataset.sectionLink === anchor;
              link.classList.toggle('is-active', matches);
            });
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    sections.forEach((sec) => observer.observe(sec));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCodexPage);
  } else {
    initCodexPage();
  }
  document.addEventListener('astro:page-load', initCodexPage);
</script>

<style>
  .codex-page {
    min-height: 100vh;
    background-color: var(--hc-surface-0, #0f0f10);
    color: var(--hc-text-primary, #f2ebdc);
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }

  /* ═══════════════════════════════════════════════════════════════
     EDITORIAL MASTHEAD
     ═══════════════════════════════════════════════════════════════ */
  .codex-masthead {
    padding: clamp(4rem, 8vw, 6rem) 0 clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--hc-rule, rgba(216, 177, 102, 0.32));
    background:
      radial-gradient(circle at 50% 0%, rgba(216, 177, 102, 0.08), transparent 50%),
      linear-gradient(180deg, var(--hc-surface-1, #141416) 0%, var(--hc-surface-0, #0f0f10) 100%);
  }

  .masthead-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .masthead-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui, sans-serif);
    font-size: 0.81rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hc-gold, #d8b166);
    margin-bottom: 1.25rem;
  }

  .masthead-glyph {
    font-size: 0.9rem;
    color: var(--hc-gold, #d8b166);
  }

  .masthead-title {
    font-family: var(--font-display, serif);
    font-size: clamp(2.21rem, 6vw, 3.57rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--hc-text-primary, #f2ebdc);
    margin: 0 0 1.35rem;
  }

  .masthead-title em {
    font-style: italic;
    font-family: var(--font-display, serif);
    color: var(--hc-gold, #d8b166);
  }

  .masthead-lead {
    font-family: var(--font-body, serif);
    font-size: clamp(1.05rem, 2vw, 1.18rem);
    line-height: 1.7;
    color: var(--hc-text-secondary, #c7beab);
    max-width: 68ch;
    margin: 0 0 2rem;
  }

  .masthead-meta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.12));
    font-family: var(--font-ui, sans-serif);
    font-size: 0.85rem;
    color: var(--hc-text-tertiary, #8c8577);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-item strong {
    color: var(--hc-text-primary, #f2ebdc);
  }

  .meta-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--hc-gold, #d8b166);
  }

  .meta-sep {
    color: var(--hc-rule-soft, rgba(242, 235, 220, 0.2));
  }

  /* ═══════════════════════════════════════════════════════════════
     INSTITUTIONAL CHARTER: TYPOGRAPHIC SPECIMEN STRIP
     ═══════════════════════════════════════════════════════════════ */
  .codex-charter {
    padding: 0;
    border-bottom: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.14));
    background: rgba(242, 235, 220, 0.015);
  }

  .charter-specimen {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    divide-x: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.1));
  }

  .charter-column {
    padding: clamp(1.75rem, 3vw, 2.25rem) clamp(1.25rem, 2vw, 1.75rem);
    border-right: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.1));
    transition: background 160ms ease;
  }

  .charter-column:last-child {
    border-right: none;
  }

  .charter-column:hover {
    background: rgba(216, 177, 102, 0.03);
  }

