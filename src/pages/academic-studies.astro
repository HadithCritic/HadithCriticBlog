---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Redirecting to Academic Studies | HadithCritic"
  description="Redirecting to HadithCritic Academic Studies and ICMA Monographs."
>
  <head slot="head">
    <meta http-equiv="refresh" content="0;url=/projects/academic-studies" />
    <link rel="canonical" href="https://hadithcriticblog.com/projects/academic-studies" />
  </head>
  <div class="hc-container" style="padding: clamp(4rem, 8vw, 6rem) 1rem; text-align: center;">
    <p class="hc-eyebrow">Redirecting</p>
    <h1 style="font-family: var(--font-display); font-size: 1.8rem; margin: 1rem 0;">
      Academic Studies & ICMA Monographs
    </h1>
    <p style="color: var(--hc-text-secondary); margin-bottom: 2rem;">
      If you are not redirected automatically, follow this link:
    </p>
    <a href="/projects/academic-studies" class="hc-btn">
      Go to Academic Studies Shelf <span aria-hidden="true">→</span>
    </a>
  </div>
</BaseLayout>
