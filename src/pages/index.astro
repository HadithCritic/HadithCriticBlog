  }

  .home-ledger-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: clamp(1.42rem, 2.5vw, 1.85rem);
    color: var(--hc-text-primary);
  }

  .home-ledger-subtitle {
    margin: 0.35rem 0 0;
    color: var(--hc-text-secondary);
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .home-ledger-filters {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .home-filter-magnet-pill {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: var(--radius-pill);
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition:
      transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      width 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      height 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms ease,
      box-shadow 180ms ease,
      opacity 120ms ease;
  }

  /* Unique Category Color System for Home Filters .
     As in blogs/index.astro, the --home-tab-active-bg fills stay theme-fixed
     because the active label is a fixed near-black. */
  .home-filter-tab[data-home-filter="all"] {
    --home-tab-color: var(--hc-gold);
    --home-tab-bg: rgba(200, 155, 75, 0.12);
    --home-tab-border: rgba(200, 155, 75, 0.35);
    --home-tab-active-bg: #c89b4b;
    --home-tab-active-text: #141312;
  }

  .home-filter-tab[data-category="Origins & Early History"],
  .home-filter-tab[data-home-filter="Origins & Early History"] {
    --home-tab-color: var(--cat-history-text);
    --home-tab-bg: rgba(212, 139, 82, 0.12);
    --home-tab-border: rgba(212, 139, 82, 0.35);
    --home-tab-active-bg: #c4783d;
    --home-tab-active-text: #ffffff;
  }

  .home-filter-tab[data-category="Prophecies & Eschatology"],
  .home-filter-tab[data-home-filter="Prophecies & Eschatology"] {
    --home-tab-color: var(--cat-prophecies-text);
    --home-tab-bg: rgba(224, 90, 71, 0.12);
    --home-tab-border: rgba(224, 90, 71, 0.35);
    --home-tab-active-bg: #c94532;
    --home-tab-active-text: #ffffff;
  }

  .home-filter-tab[data-category="Theology & Epistemology"],
  .home-filter-tab[data-home-filter="Theology & Epistemology"] {
    --home-tab-color: var(--cat-theology-text);
    --home-tab-bg: rgba(79, 168, 108, 0.12);
    --home-tab-border: rgba(79, 168, 108, 0.35);
    --home-tab-active-bg: #3f8e58;
    --home-tab-active-text: #ffffff;
  }

  .home-filter-tab[data-category="Transmission & Narrators"],
  .home-filter-tab[data-home-filter="Transmission & Narrators"] {
    --home-tab-color: var(--cat-philosophy-text);
    --home-tab-bg: rgba(96, 143, 214, 0.12);
    --home-tab-border: rgba(96, 143, 214, 0.35);
    --home-tab-active-bg: #4f78b8;
    --home-tab-active-text: #ffffff;
  }

  .home-filter-tab {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--home-tab-border, var(--hc-rule));
    background: var(--hc-surface-1);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.81rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: all 180ms ease;
  }

  .home-tab__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--home-tab-color, var(--hc-gold));
    display: inline-block;
    flex-shrink: 0;
    transition: transform 180ms ease;
  }

  .home-filter-tab:hover {
    color: var(--home-tab-color, var(--hc-text-primary));
    border-color: var(--home-tab-color, var(--hc-rule-strong));
    background: var(--home-tab-bg, var(--hc-surface-2));
  }

  .home-filter-tab:hover .home-tab__dot {
    transform: scale(1.25);
  }

  .home-filter-tab.is-active {
    color: var(--home-tab-active-text, #ffffff);
    background: var(--home-tab-active-bg, var(--hc-gold));
    border-color: var(--home-tab-active-bg, var(--hc-gold));
    font-weight: 700;
    box-shadow: 0 2px 10px
      color-mix(in srgb, var(--home-tab-active-bg) 40%, transparent);
  }

  .home-ledger-filters[data-magnet-ready="true"] .home-filter-tab.is-active {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .home-filter-tab.is-active .home-tab__dot {
    background: currentColor;
  }

  .home-ledger {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hc-rule);
  }

  .home-ledger-row {
    position: relative;
    border-bottom: 1px solid var(--hc-rule-soft);
    transition:
      background 280ms ease,
      border-bottom-color 240ms ease,
      box-shadow 240ms ease;
  }

  .home-ledger-row[data-category="Origins & Early History"] {
    --cat-color: var(--cat-history-text);
  }

  .home-ledger-row[data-category="Prophecies & Eschatology"] {
    --cat-color: var(--cat-prophecies-text);
  }

  .home-ledger-row[data-category="Theology & Epistemology"] {
    --cat-color: var(--cat-theology-text);
  }

  .home-ledger-row[data-category="Transmission & Narrators"] {
    --cat-color: var(--cat-philosophy-text);
  }

  .home-ledger-row:hover {
    background: radial-gradient(
      700px circle at var(--mouse-x, 35%) var(--mouse-y, 50%),
      color-mix(in srgb, var(--cat-color, var(--hc-gold)) 10%, rgba(20, 19, 18, 0.65)) 0%,
      rgba(15, 14, 13, 0.4) 55%,
      transparent 85%
    );
    border-bottom-color: color-mix(in srgb, var(--cat-color, var(--hc-gold)) 35%, var(--hc-rule));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--cat-color, var(--hc-gold)) 25%, transparent),
      0 10px 28px -10px rgba(0, 0, 0, 0.45);
  }

  :global([data-theme="light"]) .home-ledger-row:hover {
    background: radial-gradient(
      700px circle at var(--mouse-x, 35%) var(--mouse-y, 50%),
      color-mix(in srgb, var(--cat-color, var(--hc-gold)) 14%, rgba(245, 240, 230, 0.8)) 0%,
      rgba(240, 234, 222, 0.45) 55%,
      transparent 85%
    );
    border-bottom-color: color-mix(in srgb, var(--cat-color, var(--hc-gold)) 40%, var(--hc-rule));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--cat-color, var(--hc-gold)) 25%, transparent),
      0 6px 20px -6px rgba(0, 0, 0, 0.08);
  }

  .home-ledger-link {
    display: grid;
    grid-template-columns: 155px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.2rem, 2.5vw, 2.4rem);
    padding: clamp(1.15rem, 1.6vw, 1.45rem) clamp(0.75rem, 1.2vw, 1.35rem);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .home-ledger-folio {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-ui);
  }

  .home-ledger-no {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.18rem 0.55rem;
    border-radius: 4px;
    background: rgba(216, 177, 102, 0.05);
    border: 1px solid var(--hc-rule-soft);
    color: var(--hc-gold);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: var(--font-mono, monospace);
    width: fit-content;
    transition: all 220ms ease;
  }

  .folio-glyph {
    font-size: 0.75rem;
    color: var(--cat-color, var(--hc-gold));
    opacity: 0.45;
    transform: scale(0.9);
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 200ms ease, color 200ms ease;
  }

  .home-ledger-row:hover .home-ledger-no {
    background: rgba(216, 177, 102, 0.12);
    border-color: color-mix(in srgb, var(--cat-color, var(--hc-gold)) 40%, var(--hc-rule));
    color: var(--hc-gold-bright, #ffffff);
    box-shadow: 0 0 12px rgba(216, 177, 102, 0.2);
  }

  .home-ledger-row:hover .folio-glyph {
    opacity: 1;
    transform: scale(1.15) rotate(45deg);
    color: var(--cat-color, var(--hc-gold));
  }

  .home-ledger-folio time {
    color: var(--hc-text-tertiary);
    font-size: 0.82rem;
  }

  .home-ledger-readtime {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
  }

  .home-ledger-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .home-ledger-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .home-ledger-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 22px;
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-pill);
    color: var(--hc-gold-soft);
    background: rgba(216, 177, 102, 0.06);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .home-ledger-cat-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  .home-ledger-cat[data-category="Origins & Early History"] {
    color: var(--cat-history-text);
    background: rgba(212, 139, 82, 0.12);
    border-color: rgba(212, 139, 82, 0.32);
  }

  .home-ledger-cat[data-category="Prophecies & Eschatology"] {
    color: var(--cat-prophecies-text);
    background: rgba(224, 90, 71, 0.12);
    border-color: rgba(224, 90, 71, 0.32);
  }

  .home-ledger-cat[data-category="Theology & Epistemology"] {
    color: var(--cat-theology-text);
    background: rgba(79, 168, 108, 0.12);
    border-color: rgba(79, 168, 108, 0.32);
  }

  .home-ledger-cat[data-category="Transmission & Narrators"] {
    color: var(--cat-philosophy-text);
    background: rgba(96, 143, 214, 0.12);
    border-color: rgba(96, 143, 214, 0.32);
  }

  .home-ledger-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.24rem, 1.7vw, 1.45rem);
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: var(--hc-text-primary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 6px;
    text-decoration-thickness: 1.5px;
    transition: color 200ms ease, text-decoration-color 260ms ease;
  }

  .home-ledger-row:hover .home-ledger-heading {
    color: var(--hc-gold-soft);
    text-decoration-color: var(--cat-color, var(--hc-gold));
  }

  .home-ledger-desc {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--hc-text-secondary);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .home-ledger-action {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .home-ledger-action-label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cat-color, var(--hc-gold));
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 220ms ease, transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    white-space: nowrap;
    pointer-events: none;
  }

  .home-ledger-arrow {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--hc-rule);
    border-radius: 50%;
    color: var(--hc-gold);
    background: var(--hc-surface-1);
    transition: all 220ms ease;
  }

  .home-ledger-row:hover .home-ledger-action-label {
    opacity: 1;
    transform: translateX(0);
  }

  .home-ledger-row:hover .home-ledger-arrow {
    color: var(--hc-fixed-black, #141312);
    border-color: var(--cat-color, var(--hc-gold));
    background: var(--cat-color, var(--hc-gold));
    transform: translateX(3px);
    box-shadow: 0 0 16px color-mix(in srgb, var(--cat-color, var(--hc-gold)) 50%, transparent);
  }

  .home-ledger-footer {
    margin-top: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    border-radius: var(--radius-sm);
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-rule-soft);
  }

  :global([data-theme="light"]) .home-ledger-footer {
    background: var(--hc-surface-2);
    border-color: var(--hc-rule);
  }

  .home-ledger-footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--hc-text-secondary);
  }

  .home-ledger-footer-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hc-gold);
