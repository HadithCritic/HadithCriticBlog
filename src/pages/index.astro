---
import BaseLayout from '../layouts/BaseLayout.astro';
import Emblem from '../components/Emblem.astro';
---

<BaseLayout title="HadithCritic | Verification Over Reputation">
  <main class="home-page">
    <header class="hero">
      <div class="container hero-layout">
        
        <!-- Centerpiece: The Fractured Link Emblem -->
        <div class="hero-emblem-container">
          <Emblem variant="primary" size="hero" className="hero-emblem" />
        </div>

        <section class="hero-copy" aria-labelledby="hero-title">
          <h1 id="hero-title">
            Unveiling the<br />
            <em>History of Hadith</em>
          </h1>
          <div class="hero-divider"></div>
          <p class="hero-lede">
            A rigorous examination of traditional Islamic narratives through historical criticism,
            source analysis, and the Qur’anic demand for verification.
          </p>

          <div class="hero-actions">
            <a href="/research" class="btn btn-primary">
              Read Research
            </a>
            <a href="/academia" class="btn btn-outline">
              Academic Papers
            </a>
          </div>
        </section>

      </div>
    </header>
  </main>
</BaseLayout>

<style>
  .home-page {
    /* Subtle parchment texture or glow behind hero */
    background: radial-gradient(circle at 50% 30%, rgba(184, 134, 11, 0.05), transparent 40rem);
    min-height: calc(100vh - 200px);
  }

  .hero {
    padding: 6rem 2rem;
    display: flex;
    justify-content: center;
  }

  .hero-layout {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-emblem-container {
    margin-bottom: 3rem;
    position: relative;
  }

  /* Subtle glow behind the emblem */
  .hero-emblem-container::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 140px;
    height: 140px;
    transform: translate(-50%, -50%);
    background: var(--accent-primary);
    filter: blur(80px);
    opacity: 0.15;
    z-index: -1;
    border-radius: 50%;
  }

  .hero-copy h1 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .hero-copy h1 em {
    color: var(--accent-primary);
    font-style: italic;
    font-weight: 500;
  }

  .hero-divider {
    width: 80px;
    height: 2px;
    background: var(--accent-primary);
    margin: 0 auto 2rem;
    position: relative;
  }
  
  .hero-divider::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
    width: 6px;
    height: 6px;
    background: var(--accent-primary);
  }

  .hero-lede {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3rem 1rem;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
      margin: 0 auto;
    }
    .btn {
      width: 100%;
    }
  }
</style>
