---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const GENERIC_THUMB = "/images/blog_thumbnails/tn.generic.webp";

const allPosts = await getCollection(
  "articles",
  ({ data }) => !data.draft && !data.preview,
);
const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const categoryDescriptions: Record<string, string> = {
  History:
    "Transmission history, narrator politics, common links, and the growth of the corpus.",
  Prophecies:
    "Mahdi reports, apocalyptic claims, black banners, and dynastic memory.",
  Theology:
    "Quranic authority, law, abrogation, and anti-traditionalist critique.",
  Philosophy: "Epistemology, testimony, language, and probability.",
  Blog: "Site notes, announcements, and shorter reflections.",
};

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(
    post.data.category,
    (categoryCounts.get(post.data.category) ?? 0) + 1,
  );
}

const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({
    name,
    count,
    description: categoryDescriptions[name] ?? "",
  }));

const featured = posts[0];
const featuredThumb = featured?.data.thumbnail ?? GENERIC_THUMB;
const recent = posts.slice(0, 6);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });

const folioOf = (post: (typeof posts)[number]) =>
  String(posts.length - posts.indexOf(post)).padStart(3, "0");

const videoIds = [
  "HWHjCfaPn_0",
  "6bpJBji3E0M",
  "3B0rnPGWgKU",
  "CG5i14GAZTQ",
  "boG5JTD5yXU",
  "MLaRB6uGhAk",
];
---

<BaseLayout title="HadithCritic | Verification Over Reputation">
  <link slot="head" rel="preload" as="image" href="/images/asset1.webp" />
  <section class="hero-section hc-theme-dark">
    <div class="hc-container">
      <div class="hero-content">
        <span class="hc-eyebrow hero-eyebrow">Quran-centered criticism</span>
        <h1 class="hc-title hc-title--xl">
          Better narrations<br />through better questions.
        </h1>
        <div class="hc-divider hero-divider"></div>
        <p class="hc-copy hero-subtitle">
          Textual criticism, transmission analysis, and source verification, so
          the truth is sought through evidence and transmitted with integrity.
        </p>
        <div class="hero-actions">
          <a href="/blogs" class="hc-btn"
            >Browse the archive <span aria-hidden="true">→</span></a
          >
          <a href="/academia" class="hc-btn hc-btn--ghost">Read the research</a>
        </div>
      </div>
    </div>
  </section>

  <section
    class="hc-section archive-journal-section"
    aria-labelledby="archive-journal-title"
  >
    <div class="hc-container">
      <header class="journal-header">
        <div>
          <h2 id="archive-journal-title" class="hc-title hc-title--md">
            From the <em>archive</em>
          </h2>
          <p class="hc-copy journal-header-copy">
            Essays and research notes on transmission, prophecy reports, Quranic
            authority, epistemology, and scriptural history.
          </p>
        </div>
        <a href="/blogs" class="hc-btn hc-btn--ghost">
          Browse all {posts.length} entries <span aria-hidden="true">→</span>
        </a>
      </header>

      <div class="journal-feature-grid">
        <a
          href={`/blogs/${featured.id}`}
          class="journal-feature-card"
          data-category={featured.data.category}
        >
          <div
            class="journal-feature-image"
            style={`background-image:url('${featuredThumb}')`}
            role="img"
            aria-label={`Cover illustration for ${featured.data.title}`}
          >
          </div>
          <div class="journal-feature-copy">
            <span class="journal-category">Featured study</span>
            <h3>{featured.data.title}</h3>
            <p>{featured.data.description}</p>
            <div class="journal-meta">
              <span>{featured.data.category}</span>
              <span>{formatDate(featured.data.date)}</span>
              <span class="journal-meta-cta">Read the study</span>
            </div>
          </div>
        </a>

        <nav class="journal-categories" aria-label="Browse entries by category">
          {
            categories.map((category) => (
              <a
                href={`/blogs?category=${encodeURIComponent(category.name)}`}
                class="journal-category-tile"
                data-category={category.name}
              >
                <span class="journal-category-count">{category.count}</span>
                <strong>{category.name}</strong>
                {category.description && <p>{category.description}</p>}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="home-ledger-wrap">
        <h3 class="home-ledger-title">Latest entries</h3>
        <ol class="home-ledger">
          {
            recent.map((post) => (
              <li class="home-ledger-row" data-category={post.data.category}>
                <a href={`/blogs/${post.id}`} class="home-ledger-link">
                  <span class="home-ledger-folio">
                    <span class="home-ledger-no">No. {folioOf(post)}</span>
                    <time datetime={post.data.date.toISOString().slice(0, 10)}>
                      {formatDate(post.data.date)}
                    </time>
                  </span>
                  <span class="home-ledger-body">
                    <span class="home-ledger-heading">{post.data.title}</span>
                    <span class="home-ledger-desc">
                      {post.data.description}
                    </span>
                  </span>
                  <span class="home-ledger-cat">{post.data.category}</span>
                  <span class="home-ledger-arrow" aria-hidden="true">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section
    class="hc-section youtube-preview-section"
    aria-labelledby="lectures-title"
  >
    <div class="hc-container">
      <header class="journal-header">
        <div>
          <h2 id="lectures-title" class="hc-title hc-title--md">
            Lectures in <em>video</em>
          </h2>
          <p class="hc-copy journal-header-copy">
            Deep dives into transmission history and source criticism, in visual
            form.
          </p>
        </div>
        <a href="/youtube" class="hc-btn hc-btn--ghost">
          Visit the channel <span aria-hidden="true">→</span>
        </a>
      </header>

      <div class="youtube-grid">
        {
          videoIds.map((id) => (
            <button
              type="button"
              class="yt-lite"
              data-video-id={id}
              aria-label="Play video lecture"
            >
              <img
                src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="yt-play" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M8 5.5v13l11-6.5z" />
                </svg>
              </span>
              <span class="yt-label" aria-hidden="true">
                Watch
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="hc-section projects-section" aria-labelledby="projects-title">
    <div class="hc-container">
      <header class="journal-header">
        <div>
          <h2 id="projects-title" class="hc-title hc-title--md">
            Large-scale <em>projects</em>
          </h2>
          <p class="hc-copy journal-header-copy">
            Research infrastructure for reports, chains, variants, transmitters,
            and source comparison.
          </p>
        </div>
        <a href="/projects" class="hc-btn hc-btn--ghost">
          See all projects <span aria-hidden="true">→</span>
        </a>
      </header>

      <div class="projects-grid--brand">
        <a
          href="/silsilah/"
          class="project-card project-card--large project-card--link"
        >
          <span class="hc-chip">Now live</span>
          <h3>Silsilah Hadith Database</h3>
          <p class="hc-copy">
            Nineteen classical collections and 153,000+ reports with Arabic
            text, translation, chains, and gradings.
          </p>
          <span class="project-card-cta"
            >Enter the database <span aria-hidden="true">→</span></span
          >
          <div class="project-lines" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </a>
        <a href="/corpus-map/" class="project-card project-card--link">
          <span class="hc-chip">Research phase</span>
          <h3>Corpus Mapping</h3>
          <p class="hc-copy">
            Digital tools for tracing reports across early Sunni and Shīʿī
            collections.
          </p>
          <span class="project-card-cta"
            >Explore the map <span aria-hidden="true">→</span></span
          >
        </a>
        <a href="/studies/" class="project-card project-card--link">
          <span class="hc-chip">In development</span>
          <h3>Common-Link Studies</h3>
          <p class="hc-copy">
            Visual studies of transmission clusters, narrator pathways, and
            textual growth.
          </p>
          <span class="project-card-cta"
            >View the studies <span aria-hidden="true">→</span></span
          >
        </a>
      </div>
    </div>
  </section>

  <section class="hc-section closing-banner-section">
    <div class="hc-container">
      <div class="closing-banner hc-theme-dark">
        <div class="closing-copy">
          <h2 class="hc-title hc-title--md">
            Truth is sought through evidence and transmitted with integrity.
          </h2>
          <p class="closing-lead">
            Questions, corrections, collaboration, and source submissions are
            welcome.
          </p>
          <a href="/contact" class="hc-btn">Write to HadithCritic</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */

  .hero-section {
    position: relative;
    min-height: clamp(400px, 45vw, 760px);
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--hc-rule);
    background:
      linear-gradient(
        90deg,
        rgba(15, 15, 16, 0.98) 0%,
        rgba(15, 15, 16, 0.96) 28%,
        rgba(15, 15, 16, 0.68) 46%,
        rgba(15, 15, 16, 0.18) 72%,
        rgba(15, 15, 16, 0.08) 100%
      ),
      radial-gradient(
        circle at 18% 44%,
        rgba(216, 177, 102, 0.08),
        transparent 28%
      ),
      url("/images/asset1.webp");
    background-size: cover, cover, contain;
    background-position:
      center,
      center,
      right center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(216, 177, 102, 0.16);
    pointer-events: none;
    z-index: 3;
  }

  .hero-section::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(15, 15, 16, 0.1),
        rgba(15, 15, 16, 0.02) 45%,
        rgba(15, 15, 16, 0.5)
      ),
      radial-gradient(
        circle at 75% 58%,
        rgba(216, 177, 102, 0.1),
        transparent 30%
      );
    pointer-events: none;
  }

  .hero-section .hc-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 680px;
    padding-block: 5rem;
  }

  .hero-eyebrow {
    display: block;
    margin-bottom: 1rem;
    animation: rise 0.7s var(--ease) both;
  }

  .hero-content .hc-title--xl {
    font-size: clamp(3.4rem, 5.5vw, 4.65rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
    animation: rise 0.8s var(--ease) 70ms both;
  }

  .hero-divider {
    max-width: 320px;
    margin: 2.25rem 0 1.35rem;
    animation: rise 0.8s var(--ease) 140ms both;
  }

  .hero-subtitle {
    max-width: 28rem;
    margin: 0 0 2.35rem;
    color: rgba(242, 235, 220, 0.86);
    animation: rise 0.8s var(--ease) 200ms both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    animation: rise 0.8s var(--ease) 260ms both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Shared section header */

  .journal-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .journal-header > div {
    max-width: 720px;
  }

  .journal-header .hc-title em {
    font-style: italic;
    color: var(--hc-gold);
  }

  .journal-header-copy {
    margin: 0.85rem 0 0;
    max-width: 56ch;
  }

  /* Featured study */

  .journal-feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .journal-feature-card {
    min-height: 415px;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    overflow: hidden;
    border-radius: var(--radius-sm);
    text-decoration: none;
    border: 1px solid var(--cat-border, var(--hc-rule));
    outline: 2px solid transparent;
    outline-offset: 4px;
    background: linear-gradient(
      180deg,
      var(--cat-bg, rgba(38, 35, 31, 0.8)),
      color-mix(in srgb, var(--hc-black) 95%, transparent)
    );
    transition:
      border-color 300ms ease,
      outline-color 300ms ease,
      transform 300ms var(--ease);
  }

  .journal-feature-card:hover {
    border-color: var(--cat-color, var(--hc-rule-strong));
    outline-color: var(--cat-border, rgba(216, 177, 102, 0.3));
    transform: translateY(-2px);
  }

  .journal-feature-image {
    min-height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    background-color: rgba(10, 10, 10, 0.4);
    filter: saturate(0.9) contrast(1.03);
    transition: transform 450ms var(--ease);
  }

  .journal-feature-card:hover .journal-feature-image {
    transform: scale(1.02);
  }

  .journal-feature-copy {
    padding: clamp(1.5rem, 3vw, 2.35rem);
    display: flex;
    flex-direction: column;
    justify-content: end;
  }

  .journal-category {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 0.85rem;
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--cat-border, var(--hc-rule));
    border-radius: var(--radius-pill);
    color: var(--cat-color, var(--hc-gold-soft));
    background: var(--cat-bg, rgba(216, 177, 102, 0.08));
    font-family: var(--font-ui);
    font-size: 0.67rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  .journal-feature-copy h3 {
    margin: 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: clamp(2.1rem, 3vw, 3.1rem);
    line-height: 1.05;
    text-wrap: balance;
    transition: color 300ms ease;
  }

  .journal-feature-card:hover h3 {
    color: var(--cat-color, var(--hc-gold-soft));
  }

  .journal-feature-copy > p {
    color: var(--hc-muted);
    margin: 1rem 0 0;
    max-width: 46ch;
  }

  .journal-meta {
    margin-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    color: var(--hc-ash);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .journal-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .journal-meta span:not(:last-child)::after {
    content: "•";
    color: var(--hc-gold-dim);
    margin-left: 0.5rem;
  }

  .journal-meta-cta {
    color: var(--cat-color, var(--hc-gold));
    transition: opacity 250ms ease;
  }

  /* Category tiles */

  .journal-categories {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background-color: var(--hc-rule);
    overflow: hidden;
  }

  .journal-category-tile {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.2rem 1.1rem;
    padding: 1.35rem 1.4rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--hc-charcoal) 60%, transparent),
      color-mix(in srgb, var(--hc-black) 90%, transparent)
    );
    text-decoration: none;
    border-top: 2px solid transparent;
    transition:
      background 300ms ease,
      border-color 300ms ease,
      transform 300ms var(--ease);
  }

  .journal-category-tile:hover {
    background: linear-gradient(
      180deg,
      var(--cat-bg, rgba(216, 177, 102, 0.12)),
      color-mix(in srgb, var(--hc-black) 96%, transparent)
    );
    border-top-color: var(--cat-color, var(--hc-gold));
  }

  .journal-category-count {
    grid-row: span 2;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--cat-border, var(--hc-rule));
    border-radius: 50%;
    color: var(--cat-color, var(--hc-gold));
    background: var(--cat-bg, transparent);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 500;
    transition:
      transform 300ms var(--ease),
      background 300ms ease,
      color 300ms ease;
  }

  .journal-category-tile:hover .journal-category-count {
    transform: scale(1.08);
    background: var(--cat-color, var(--hc-gold));
    color: var(--hc-fixed-black);
  }

  .journal-category-tile strong {
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: 1.45rem;
    line-height: 1.05;
    transition: color 300ms ease;
  }

  .journal-category-tile:hover strong {
    color: var(--cat-color, var(--hc-gold-soft));
  }

  .journal-category-tile p {
    margin: 0.3rem 0 0;
    color: var(--hc-muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  /* Latest entries ledger */

  .home-ledger-wrap {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .home-ledger-title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    color: var(--hc-parchment);
  }

  .home-ledger {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hc-rule);
  }

  .home-ledger-row {
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .home-ledger-link {
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr) auto 36px;
    align-items: center;
    gap: clamp(1.1rem, 2.5vw, 2.25rem);
    padding: clamp(1rem, 1.8vw, 1.35rem) clamp(0.4rem, 1.2vw, 1rem);
    text-decoration: none;
    transition: background 300ms ease;
  }

  .home-ledger-link:hover {
    background: linear-gradient(
      90deg,
      var(--cat-bg, rgba(216, 177, 102, 0.06)),
      transparent 60%
    );
  }

  .home-ledger-folio {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-ui);
  }

  .home-ledger-no {
    color: var(--hc-gold-dim);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .home-ledger-folio time {
    color: var(--hc-ash);
    font-size: 0.78rem;
  }

  .home-ledger-body {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .home-ledger-heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.35rem, 1.9vw, 1.8rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--hc-parchment);
    transition: color 300ms ease;
  }

  .home-ledger-link:hover .home-ledger-heading {
    color: var(--cat-color, var(--hc-gold-soft));
  }

  .home-ledger-desc {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--hc-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .home-ledger-cat {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--cat-border, var(--hc-rule));
    border-radius: var(--radius-pill);
    color: var(--cat-color, var(--hc-gold-soft));
    background: var(--cat-bg, rgba(216, 177, 102, 0.06));
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .home-ledger-arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--cat-border, var(--hc-rule));
    border-radius: 50%;
    color: var(--cat-border, var(--hc-gold-dim));
    transition:
      color 300ms ease,
      border-color 300ms ease,
      transform 300ms var(--ease),
      background 300ms ease;
  }

  .home-ledger-link:hover .home-ledger-arrow {
    color: var(--hc-fixed-black);
    border-color: var(--cat-color, var(--hc-gold-dim));
    background: var(--cat-color, var(--hc-gold));
    transform: translateX(4px);
  }

  /* Video lectures */

  .youtube-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .yt-lite {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    overflow: hidden;
