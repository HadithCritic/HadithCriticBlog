<script>
  document.addEventListener('DOMContentLoaded', () => {
    const rail = document.getElementById('blog-carousel') as HTMLElement | null;
    const prevBtn = document.querySelector('.carousel-prev') as HTMLElement | null;
    const nextBtn = document.querySelector('.carousel-next') as HTMLElement | null;

    if (rail && prevBtn && nextBtn) {
      const scrollAmount = () => {
        const firstCard = rail.firstElementChild as HTMLElement | null;
        return firstCard ? firstCard.clientWidth + 1 : 0;
      };

      prevBtn.addEventListener('click', () => {
        rail.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        rail.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    }
  });
</script>
