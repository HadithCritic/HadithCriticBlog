---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectoryCard from '../components/DirectoryCard.astro';
import ReportCard from '../components/ReportCard.astro';

const directory = [
  {
    title: 'Blog',
    description: 'Essays, reflections, and critical notes on hadith, history, theology, and textual transmission.',
    label: 'Articles & Essays',
    href: '/blogs',
    theme: 'parchment',
    imgSrc: '/assets/illustrations/scholar-writing-strip.png'
  },
  {
    title: 'Academia',
    description: 'Published papers, formal research, long-form studies, and downloadable academic work.',
    label: 'Formal Research',
    href: '/academia',
    theme: 'charcoal',
    imgSrc: '/assets/illustrations/manuscript-review-strip.png'
  },
  {
    title: 'Projects',
    description: 'Large-scale research tools, datasets, databases, and digital humanities work in progress.',
    label: 'Digital Humanities',
    href: '/projects',
    theme: 'charcoal',
    imgSrc: '/assets/illustrations/transmission-map-strip.png'
  },
  {
    title: 'Resources',
    description: 'Bibliographies, source lists, reading guides, corpora, PDFs, and research aids.',
    label: 'Archive',
    href: '/resources',
    theme: 'charcoal',
    imgSrc: '/assets/illustrations/archive-shelves-strip.png'
  },
  {
    title: 'YouTube',
    description: 'Video essays, lectures, breakdowns, and visual explanations.',
    label: 'Video Lectures',
    href: '/youtube',
    theme: 'parchment',
    imgSrc: '/assets/illustrations/lecture-circle-strip.png'
  },
  {
    title: 'Contact',
    description: 'Questions, corrections, collaboration, or source submissions.',
    label: 'Correspondence',
    href: '/contact',
    theme: 'charcoal',
    imgSrc: '/assets/illustrations/letter-seal-strip.png'
  }
];

const blogCategories = [
  {
    name: 'Hadith Prophecies',
    slug: 'prophecy',
    count: 18,
    description: 'Mahdī reports, apocalyptic claims, banners, signs, and dynastic memory.'
  },
  {
    name: 'Isnād & Transmission',
    slug: 'transmission',
    count: 29,
    description: 'Narrator politics, common links, rijāl criticism, and transmission growth.'
  },
  {
    name: 'Quranic Theology',
    slug: 'theology',
    count: 16,
    description: 'Quranic authority, law, anti-traditionalist critique, and legal theory.'
  },
  {
    name: 'Philosophy',
    slug: 'philosophy',
    count: 4,
    description: 'Epistemology, testimony, language, probability, and verification.'
  },
  {
    name: 'Comparative Religion',
    slug: 'comparative',
    count: 7,
    description: 'Scriptural history, revelation parallels, and cross-tradition isnād claims.'
  }
];

const blogPosts = [
  {
    title: 'The Abbasid Mahdī',
    subtitle: 'Black banners, Khurāsān, and the capture of Hāshimite hope',
    category: 'Hadith Prophecies',
    categorySlug: 'prophecy',
    excerpt: 'A study of black-banner prophecy reports, Abbasid political memory, and how apocalyptic narration can serve dynastic legitimacy.',
    date: 'Jan 18, 2025',
    readTime: '24 min read',
    thumbnail: '/images/blog_thumbnails/tn.abbasidmahdi.png',
    bgPosition: 'right center',
    href: '/blogs/the-abbasid-mahdi'
  },
  {
    title: 'The Sunni-Quranic Abrogation Dilemma',
    subtitle: 'How legal theory absorbs contradiction',
    category: 'Quranic Theology',
    categorySlug: 'theology',
    excerpt: 'Examining classical approaches to textual abrogation and the pressure they place on Quranic clarity and completion.',
    date: 'Feb 10, 2025',
    readTime: '10 min read',
    thumbnail: '/images/blog_thumbnails/tn.abrogationdilemma.png',
    href: '#'
  },
  {
    title: 'Battle of the Isnads',
    subtitle: 'Judaism, Christianity, Islam, and the politics of testimony',
    category: 'Comparative Religion',
    categorySlug: 'comparative',
    excerpt: 'A comparative look at transmitted authority, witness claims, and how religious communities construct memory.',
    date: 'Mar 5, 2025',
    readTime: '12 min read',
    thumbnail: '/images/blog_thumbnails/tn.isnadbattle.png',
    href: '#'
  },
  {
    title: "Isnād Politics: Hishām & al-Aʿmash",
    subtitle: 'Narrator relationships under political pressure',
    category: 'Isnād & Transmission',
    categorySlug: 'transmission',
    excerpt: 'A forensic look at the political pressures shaping narrator relationships in Kūfa.',
    date: 'Apr 2, 2025',
    readTime: '15 min read',
    thumbnail: '/images/blog_thumbnails/tn.isnadpoliticshishamamash.png',
    href: '#'
  },
  {
    title: 'Wittgenstein and Hadith Interpretation',
    subtitle: 'Language games and inherited meaning',
    category: 'Philosophy',
    categorySlug: 'philosophy',
    excerpt: 'Applying language-game theory to inherited interpretive habits and apparent contradictions in tradition.',
    date: 'May 14, 2025',
    readTime: '9 min read',
    thumbnail: '/images/blog_thumbnails/tn.witgenstein.png',
    href: '#'
  }
];

const homepageBlogPosts = blogPosts.slice(0, 19);
const featuredPost = blogPosts[0];
---

<BaseLayout title="HadithCritic | Verification Over Reputation">
  <section class="hero-section">
    <div class="hc-container">
      <div class="hero-content">
        <span class="hc-eyebrow hero-eyebrow">Quran-centered criticism</span>
        <h1 class="hc-title hc-title--xl">Better narrations<br />through better questions.</h1>
        <div class="hc-divider hero-divider"></div>
        <p class="hc-copy hero-subtitle">
          Textual criticism, transmission analysis, and source verification, so the truth is sought through evidence and transmitted with integrity.
        </p>
        <div class="hero-actions">
          <a href="/reports" class="hc-btn">Explore Reports <span aria-hidden="true">→</span></a>
          <a href="/methodology" class="hc-btn hc-btn--ghost">Learn Our Method</a>
        </div>
      </div>
    </div>
  </section>

  <section class="hc-section archive-journal-section" aria-labelledby="archive-journal-title">
    <div class="hc-container">
      <header class="journal-header">
        <div>
          <span class="hc-label">From the blog</span>
          <h2 id="archive-journal-title" class="hc-title hc-title--md">Latest studies from the archive.</h2>
          <p class="hc-copy">
            Essays and research notes on transmission, prophecy reports, Quranic authority, epistemology, and scriptural history.
          </p>
        </div>
        <a href="/blogs" class="hc-btn hc-btn--ghost">View all essays <span aria-hidden="true">→</span></a>
      </header>

      <div class="journal-feature-grid">
        <a href={featuredPost.href} class={`journal-feature-card journal-feature-card--${featuredPost.categorySlug}`}>
          <div class="journal-feature-image" style={`background-image:url('${featuredPost.thumbnail}'); background-position: ${featuredPost.bgPosition || 'center'};`}></div>
          <div class="journal-feature-copy">
            <span class="journal-category">{featuredPost.category}</span>
            <h3>{featuredPost.title}</h3>
            <p class="journal-subtitle">{featuredPost.subtitle}</p>
            <p>{featuredPost.excerpt}</p>
            <div class="journal-meta">
              <span>{featuredPost.date}</span>
              <span>{featuredPost.readTime}</span>
              <span>Read study</span>
            </div>
          </div>
        </a>

        <div class="journal-categories" aria-label="Blog categories">
          {blogCategories.map(category => (
            <a href={`/blogs?category=${category.slug}`} class={`journal-category-tile journal-category-tile--${category.slug}`}>
              <span class="journal-category-count">{category.count}</span>
              <strong>{category.name}</strong>
              <p>{category.description}</p>
            </a>
          ))}
        </div>
      </div>

      <div class="journal-rail-wrap">
        <div class="journal-rail-heading">
          <span class="hc-label">Recent essays</span>
        </div>

        <div class="carousel-container">
          <button class="carousel-btn carousel-prev" aria-label="Previous posts">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          
          <div class="journal-rail" aria-label="Recent blog posts" id="blog-carousel">
          {homepageBlogPosts.map((post, index) => (
            <a href={post.href} class={`journal-card journal-card--${post.categorySlug}`}>
              <div class="journal-card-image" style={`background-image:url('${post.thumbnail}'); background-position: ${post.bgPosition || 'center'};`}></div>
              <div class="journal-card-body">
                <span class="journal-category">{post.category}</span>
                <h3>{post.title}</h3>
                <p>{post.excerpt}</p>
                <div class="journal-meta">
                  <span>{post.date}</span>
                  <span>{post.readTime}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="hc-section hc-section--tight youtube-preview-section">
    <div class="hc-container">
      <header class="hc-section-head">
        <span class="hc-label">Video Lectures</span>
        <h2 class="hc-title hc-title--md">Visual breakdowns from the archive.</h2>
        <p class="hc-copy">Watch our latest deep dives into transmission history and source criticism.</p>
      </header>

      <div class="youtube-gallery">
        <div class="youtube-grid">
          <iframe src="https://www.youtube.com/embed/HWHjCfaPn_0" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <iframe src="https://www.youtube.com/embed/6bpJBji3E0M" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <iframe src="https://www.youtube.com/embed/3B0rnPGWgKU" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <iframe src="https://www.youtube.com/embed/CG5i14GAZTQ" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <iframe src="https://www.youtube.com/embed/boG5JTD5yXU" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <iframe src="https://www.youtube.com/embed/MLaRB6uGhAk" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="hc-section method-section">
    <div class="hc-container">
      <div class="method-strip method-strip--brand">
        <div class="method-intro">
          <span class="hc-label">Standards</span>
          <h2 class="hc-title hc-title--md">Method before opinion.</h2>
          <p class="hc-copy">HadithCritic is built around a simple rule: the reader should be able to see why a judgment was made.</p>
        </div>

        {[
          ['fa-scale-balanced', 'Rigor', 'Reports are read through chains, transmitters, variants, and source history.'],
          ['fa-eye', 'Fairness', 'Claims are judged carefully, without sectarian convenience or inherited reputation.'],
          ['fa-book-open', 'Transparency', 'Sources, parallels, and reasoning should be visible to the reader.'],
          ['fa-landmark', 'Context', 'Factional, political, and doctrinal settings matter when reports emerge from contested history.']
        ].map(pillar => (
          <div class="method-pillar">
            <div class="pillar-icon"><i class={`fa-solid ${pillar[0]}`}></i></div>
            <h3>{pillar[1]}</h3>
            <p>{pillar[2]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hc-section projects-section">
    <div class="hc-container">
      <header class="journal-header">
        <div>
          <span class="hc-label">Digital Humanities</span>
          <h2 class="hc-title hc-title--md">Large-scale projects</h2>
          <p class="hc-copy">Research infrastructure for reports, chains, variants, transmitters, and source comparison.</p>
        </div>
        <a href="/projects" class="hc-btn hc-btn--ghost">See all projects <span aria-hidden="true">→</span></a>
      </header>

      <div class="projects-grid projects-grid--brand">
        <article class="project-card project-card--large">
          <span class="hc-chip">Coming Soon</span>
          <h3 class="hc-title">Hadith Database</h3>
          <p class="hc-copy">A searchable database for reports, chains, variants, transmitters, and source comparison.</p>
          <div class="project-lines" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </article>
        <article class="project-card">
          <span class="hc-chip">Research Phase</span>
          <h3 class="hc-title">Corpus Mapping</h3>
          <p class="hc-copy">Digital tools for tracing reports across early Sunni and Shīʿī collections.</p>
        </article>
        <article class="project-card">
          <span class="hc-chip">In Development</span>
          <h3 class="hc-title">Common-Link Studies</h3>
          <p class="hc-copy">Visual studies of transmission clusters, narrator pathways, and textual growth.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="hc-section closing-banner-section">
    <div class="hc-container">
      <div class="closing-banner">
        <div class="closing-copy">
          <span class="hc-label">A legacy of inquiry</span>
          <h2 class="hc-title hc-title--md">We preserve the standards of the scholars by showing the evidence.</h2>
          <a href="/methodology" class="hc-btn hc-btn--ghost">Read the method</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section,
  .archive-journal-section,
  .archive-wings-section,
  .featured-reports,
  .method-section,
  .projects-section,
  .closing-banner-section {
    position: relative;
  }

  .hero-section {
    min-height: clamp(400px, 45vw, 800px);
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--hc-rule);
    background:
      linear-gradient(90deg, rgba(15,15,16,0.98) 0%, rgba(15,15,16,0.96) 28%, rgba(15,15,16,0.68) 46%, rgba(15,15,16,0.18) 72%, rgba(15,15,16,0.08) 100%),
      radial-gradient(circle at 18% 44%, rgba(216,177,102,0.08), transparent 28%),
      url('/images/asset1.png');
    background-size: cover, cover, contain;
    background-position: center, center, right center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(216, 177, 102, 0.16);
    pointer-events: none;
    z-index: 3;
  }

  .hero-section::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(15,15,16,0.1), rgba(15,15,16,0.02) 45%, rgba(15,15,16,0.5)),
      radial-gradient(circle at 75% 58%, rgba(216,177,102,0.1), transparent 30%);
    pointer-events: none;
  }

  .hero-section .hc-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 680px;
    position: relative;
    padding-block: 5rem;
  }

  .hero-eyebrow {
    display: block;
    margin-bottom: 1rem;
  }

  .hero-content .hc-title--xl {
    font-size: 4.65rem;
    line-height: 0.92;
    letter-spacing: 0;
    max-width: 8.7em;
    text-wrap: normal;
  }

  .hero-divider {
    max-width: 320px;
    margin: 2.25rem 0 1.35rem;
  }

  .hero-subtitle {
    max-width: 26rem;
    margin: 0 0 2.35rem;
    color: rgba(242, 235, 220, 0.82);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .archive-journal-section {
    background:
      linear-gradient(180deg, rgba(15,15,16,0.94), rgba(20,19,18,0.9)),
      radial-gradient(circle at 12% 10%, rgba(216,177,102,0.07), transparent 30%);
  }

  .journal-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .journal-header > div {
    max-width: 780px;
  }

  .journal-header .hc-title {
    margin-top: 0.4rem;
  }

  .journal-feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
    gap: 1.4rem;
    align-items: stretch;
  }

  .journal-feature-card {
    min-height: 520px;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
    overflow: hidden;
    text-decoration: none;
    border: 1px solid var(--hc-rule);
    background:
      linear-gradient(180deg, rgba(38,35,31,0.8), rgba(15,15,16,0.95)),
      url('/assets/textures/charcoal-paper.png');
    box-shadow: var(--shadow);
  }

  .journal-feature-card::before,
  .journal-categories::before,
  .journal-rail-wrap::before,
  .featured-reports-shell::before,
  .method-strip--brand::before,
  .projects-grid--brand::before,
  .closing-banner::before {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(216,177,102,0.12);
    pointer-events: none;
  }

  .journal-feature-image {
    min-height: 100%;
    background-size: cover;
    background-position: center;
    filter: saturate(0.86) contrast(1.04);
  }

  .journal-feature-copy {
    padding: clamp(1.5rem, 3vw, 2.35rem);
    display: flex;
    flex-direction: column;
    justify-content: end;
    background:
      linear-gradient(90deg, rgba(15,15,16,0.12), rgba(15,15,16,0.92) 22%),
      linear-gradient(180deg, transparent, rgba(0,0,0,0.35));
  }

  .journal-category {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 0.85rem;
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-pill);
    color: var(--hc-gold-soft);
    background: rgba(216,177,102,0.08);
    font-family: var(--font-ui);
    font-size: 0.67rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  .journal-feature-copy h3,
  .journal-card h3,
  .journal-category-tile strong,
  .project-card h3 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .journal-feature-copy h3 {
    margin: 0;
    color: var(--hc-parchment);
    font-size: clamp(3rem, 5vw, 5.4rem);
    line-height: 0.9;
  }

  .journal-subtitle {
    color: var(--hc-gold);
    font-style: italic;
    font-size: 1.2rem;
    margin: 0.85rem 0 0.9rem;
  }

  .journal-feature-copy > p:not(.journal-subtitle) {
    color: var(--hc-muted);
    margin: 0;
  }

  .journal-meta {
    margin-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    color: var(--hc-ash);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .journal-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .journal-meta span:not(:last-child)::after {
    content: "•";
    color: var(--hc-gold-dim);
    margin-left: 0.5rem;
  }

  .journal-categories {
    position: relative;
    border: 1px solid var(--hc-rule);
    background: rgba(15,15,16,0.46);
    display: grid;
    gap: 1px;
    background-color: var(--hc-rule);
  }

  .journal-category-tile {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 0.95rem;
    padding: 1.2rem;
    background:
      linear-gradient(180deg, rgba(38,35,31,0.92), rgba(15,15,16,0.96)),
      url('/assets/textures/charcoal-paper.png');
    text-decoration: none;
  }

  .journal-category-tile:hover {
    background:
      linear-gradient(180deg, rgba(216,177,102,0.1), rgba(15,15,16,0.96)),
      url('/assets/textures/charcoal-paper.png');
  }

  .journal-category-count {
    grid-row: span 2;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid var(--hc-rule);
    border-radius: 50%;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.78rem;
  }

  .journal-category-tile strong {
    color: var(--hc-parchment);
    font-size: 1.45rem;
    line-height: 1;
  }

  .journal-category-tile p {
    margin: 0.35rem 0 0;
    color: var(--hc-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .journal-category-tile--prophecy { --cat-accent: #a46a3f; }
  .journal-category-tile--transmission { --cat-accent: #9d7a3c; }
  .journal-category-tile--theology { --cat-accent: #5b496e; }
  .journal-category-tile--philosophy { --cat-accent: #6d7880; }
  .journal-category-tile--comparative { --cat-accent: #d8b166; }

  .journal-category-tile {
    box-shadow: inset 3px 0 0 var(--cat-accent, var(--hc-gold-dim));
  }

  .journal-rail-wrap {
    position: relative;
    margin-top: 1.4rem;
    padding: 1.2rem;
    border: 1px solid var(--hc-rule);
    background:
      linear-gradient(180deg, rgba(15,15,16,0.68), rgba(15,15,16,0.9)),
      url('/assets/textures/charcoal-paper.png');
  }

  .journal-rail-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .carousel-container {
    position: relative;
    width: 100%;
    margin-top: 2rem;
  }

  .journal-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2px) / 3);
    gap: 1px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    background: var(--hc-rule);
    border: 1px solid var(--hc-rule);
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }

  .journal-rail::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: rgba(15, 15, 16, 0.96);
    border: 1px solid var(--hc-rule);
    color: var(--hc-gold);
    border-radius: 50%;
    cursor: pointer;
