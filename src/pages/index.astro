            </div>

            <div class="project-module-card__footer">
              <span class="project-module-card__cta">
                Explore the corpus <span aria-hidden="true">→</span>
              </span>
              <span class="project-module-card__meta">Open access · No login required</span>
            </div>
          </a>

          <!-- MODULE 2: NARRATOR BIOGRAPHIES -->
          <a
