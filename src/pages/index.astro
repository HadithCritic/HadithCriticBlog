    font-weight: 600;
  }

  /* Video lectures */

  .youtube-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .yt-lite {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-md);
    background: var(--hc-surface-1);
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease,
      transform 300ms var(--ease);
  }

  .yt-lite::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(15, 15, 16, 0) 50%,
      rgba(15, 15, 16, 0.7) 100%
    );
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 300ms ease;
  }

  .yt-lite:hover {
    border-color: var(--hc-gold-dim);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transform: translateY(-4px);
  }

  .yt-lite:hover::after {
    opacity: 0.9;
  }

  .yt-lite img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
    transition:
      transform 450ms var(--ease),
      filter 250ms ease;
  }

  .yt-lite:hover img {
    transform: scale(1.05);
    filter: saturate(1.1) contrast(1.05);
  }

  .yt-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    color: var(--hc-fixed-parchment);
    background: color-mix(in srgb, var(--hc-fixed-black) 60%, transparent);
    border: 1px solid rgba(216, 177, 102, 0.3);
    backdrop-filter: blur(8px);
    transition:
      background 300ms ease,
      color 300ms ease,
      transform 300ms var(--ease),
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .yt-play svg {
    margin-left: 3px;
  }

  .yt-lite:hover .yt-play {
    background: var(--hc-gold);
    color: var(--hc-text-inverse);
    border-color: var(--hc-gold);
    transform: translate(-50%, -50%) scale(1.12);
    box-shadow: 0 0 25px rgba(216, 177, 102, 0.35);
  }

  .yt-label {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 2;
    background: color-mix(in srgb, var(--hc-fixed-black) 85%, transparent);
    color: var(--hc-gold-soft);
    border: 1px solid rgba(216, 177, 102, 0.2);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.65rem;
    font-family: var(--font-ui);
    font-size: 0.81rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    backdrop-filter: blur(4px);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 300ms ease,
      transform 300ms var(--ease);
  }

  .yt-lite:hover .yt-label {
    opacity: 1;
    transform: translateY(0);
  }

  .yt-lite iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Projects Section — 3-Column Minimalist Research Suite */

  .projects-renovation {
    display: flex;
    flex-direction: column;
  }

  .projects-live-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .project-module-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 2.2vw, 2rem);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--hc-surface-2) 65%, transparent),
      var(--hc-surface-0)
    );
    text-decoration: none;
    transition:
      transform var(--motion-base) var(--ease),
      border-color var(--motion-base) ease,
      box-shadow var(--motion-base) ease;
  }

  .project-module-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 85% 0%,
      rgba(216, 177, 102, 0.07),
      transparent 55%
