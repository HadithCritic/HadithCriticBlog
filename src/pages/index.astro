    border: 1px solid var(--hc-rule-soft);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-secondary);
    transition:
      transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 200ms ease,
      opacity 200ms ease,
      box-shadow 200ms ease;
  }

  .dossier-slip-folio {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--hc-gold);
    font-weight: 600;
    flex-shrink: 0;
  }

  .dossier-slip-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.2;
    font-size: 0.75rem;
  }

  .dossier-slip--1 {
    top: 0;
    z-index: 3;
    transform: translateY(0) scale(1);
  }

  .dossier-slip--2 {
    top: 6px;
    z-index: 2;
    transform: translateY(6px) scale(0.96);
    background: var(--hc-surface-1);
    opacity: 0.85;
  }

  .dossier-slip--3 {
    top: 12px;
    z-index: 1;
    transform: translateY(12px) scale(0.92);
    background: var(--hc-surface-0);
    opacity: 0.65;
  }

  .journal-category-tile:hover .dossier-slip--1,
  .journal-category-tile.is-active .dossier-slip--1 {
    transform: translateY(-8px) scale(1);
    border-color: var(--cat-border, var(--hc-rule-strong));
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
    color: var(--hc-text-primary);
  }

  .journal-category-tile:hover .dossier-slip--2,
  .journal-category-tile.is-active .dossier-slip--2 {
    transform: translateY(2px) scale(0.97);
    opacity: 0.95;
    border-color: var(--cat-border, var(--hc-rule));
  }

  .journal-category-tile:hover .dossier-slip--3,
  .journal-category-tile.is-active .dossier-slip--3 {
    transform: translateY(12px) scale(0.94);
    opacity: 0.8;
  }

  /* Mobile Compact Peek - hidden on desktop */
  .dossier-mobile-peek {
    display: none;
  }

  .journal-category-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--hc-rule-soft);
    margin-top: auto;
  }

  .dossier-filter-hint {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--hc-text-tertiary);
    font-weight: 600;
  }

  .hint-active-text {
    display: none;
  }

  .journal-category-tile.is-active .hint-filter-text {
    display: none;
  }

  .journal-category-tile.is-active .hint-active-text {
    display: inline;
    color: var(--hc-gold);
    font-weight: 700;
  }

  .journal-category-foot-link {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--cat-color, var(--hc-gold));
    padding: 0.18rem 0.48rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--cat-border, var(--hc-rule-soft));
    transition: background 180ms ease, border-color 180ms ease;
  }

  .journal-category-foot-link:hover {
    background: var(--cat-bg, rgba(216, 177, 102, 0.16));
    border-color: var(--cat-color, var(--hc-gold));
  }

  .journal-category-foot .foot-glyph {
    transition: transform 200ms ease;
  }

  .journal-category-tile:hover .journal-category-foot .foot-glyph {
    transform: translateX(3px);
  }

  /* Latest entries ledger */

  .home-ledger-wrap {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .home-ledger-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .home-ledger-header-copy {
    display: flex;
    flex-direction: column;
  }

  .home-ledger-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
  }

  .home-ledger-kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hc-gold);
    box-shadow: 0 0 8px rgba(216, 177, 102, 0.7);
  }

  .home-ledger-kicker-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .home-ledger-kicker-count {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
