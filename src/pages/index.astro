---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Home">
  <section class="container" style="text-align: center; padding-top: 4rem; padding-bottom: 4rem;">
    <h1 style="font-size: 3rem; margin-bottom: 1rem;">HadithCritic</h1>
    <p style="font-size: 1.25rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto;">
      A scholarly digital research platform for hadith criticism, isnād analysis, early Islamic history, and source criticism.
    </p>
  </section>

  <section class="container" style="margin-top: 2rem;">
    <h2>Latest Research</h2>
    <div style="display: grid; gap: 2rem; margin-top: 2rem;">
      {sortedArticles.slice(0, 5).map(article => (
        <article class="source-card" style="margin: 0; transition: transform 0.2s; border-left: 4px solid var(--accent-color);">
          <a href={`/articles/${article.id}`} style="text-decoration: none;">
            <h3 style="margin: 0; color: var(--text-primary); font-size: 1.5rem;">{article.data.title}</h3>
            <p style="color: var(--text-secondary); margin-top: 0.5rem;">{article.data.description}</p>
            <div style="margin-top: 1rem; font-size: 0.85rem; color: var(--text-muted); display: flex; gap: 1rem;">
              <span>{article.data.date.toLocaleDateString()}</span>
              <span>{article.data.category}</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
