---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { CORPUS_META } from "../lib/corpus-config";
import { blogArtwork } from "../data/blog-artwork";
import qiraatIndex from "../data/qiraat/index.json";
import SubscribeForm from "../components/SubscribeForm.astro";
import "../styles/home.css";

const GENERIC_THUMB = "/images/blog_thumbnails/tn.generic.webp";

const posts = (
  await getCollection("articles", ({ data }) => (import.meta.env.DEV || !data.draft) && !data.preview)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
type Post = (typeof posts)[number];

/* The newest study leads; the next three follow as cards. */
const [lead, ...rest] = posts;
const recent = rest.slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const readingMinutes = (post: Post) => {
  const words = (post.body || "").replace(/<[^>]*>/g, "").trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
};
const thumbOf = (post: Post) => blogArtwork[post.id]?.thumbnail ?? post.data.thumbnail ?? GENERIC_THUMB;
const leadArt = blogArtwork[lead.id];

const videos = [
  { id: "HWHjCfaPn_0", thumb: "https://i.ytimg.com/vi/HWHjCfaPn_0/maxresdefault.jpg" },
  { id: "6bpJBji3E0M", thumb: "https://i.ytimg.com/vi/6bpJBji3E0M/maxresdefault.jpg" },
  { id: "3B0rnPGWgKU", thumb: "https://i.ytimg.com/vi/3B0rnPGWgKU/maxresdefault.jpg" },
];

/* Every figure below is read from the data each project is built from. */
const n = (value: number) => value.toLocaleString("en-US");

const projects = [
  {
    href: "/hadith/",
    title: "Hadith Corpus",
    desc: "Narrations in facing Arabic and English, searchable across every compilation.",
    figure: `${n(CORPUS_META.counts.hadith)} narrations`,
  },
  {
    href: "/narrators/",
    title: "Rijāl Register",
    desc: "Classical transmitters with their teachers, students and every critic’s verdict.",
    figure: `${n(CORPUS_META.counts.narrators)} transmitters`,
  },
  {
    href: "/projects/quran/",
    title: "The Qirāʾāt Variants",
    desc: "The ten readings side by side, word by word, with the books that report them.",
    figure: `${qiraatIndex.suras_with_data} of 114 suras`,
  },
  {
    href: "/projects/history/",
    title: "History (Tārīkh)",
    desc: "Early historical works brought together for source-based study.",
    figure: "Coming soon",
  },
];
---

<BaseLayout title="HadithCritic | Verification Over Reputation">
  <div class="home">
    <section class="home-hero" aria-labelledby="home-title">
      <img
        class="home-hero__art"
        src="/images/platform/home.webp"
        srcset="/images/platform/home-1086.webp 1086w, /images/platform/home.webp 2172w"
        sizes="(max-width: 640px) 100vw, 72vw"
        width="2172"
        height="724"
        alt=""
        fetchpriority="high"
      />
      <div class="hc-container home-hero__inner">
        <h1 id="home-title" class="home-hero__title">
          Tracing the origins of{" "}
          <span class="home-hero__accent">early traditions.</span>
        </h1>
        <p class="home-hero__lede">
          Textual criticism, transmission forensics, and source verification:
          recovering early Islamic history through rigorous evidentiary research.
        </p>
        <div class="home-hero__actions">
          <a href="/blogs/" class="hc-btn">Browse the archive</a>
          <a href="/academia/" class="hc-btn hc-btn--ghost">Read the research</a>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="latest-title">
      <div class="hc-container">
        <header class="home-head">
          <h2 id="latest-title" class="home-head__title">Latest studies</h2>
          <a href="/blogs/" class="home-head__link">All {posts.length} studies <span aria-hidden="true">→</span></a>
        </header>

        <article class="home-lead">
          <div class="home-lead__copy">
            <p class="home-meta">
              <span>{lead.data.category}</span>
              <time datetime={isoDate(lead.data.date)}>{formatDate(lead.data.date)}</time>
              <span>{readingMinutes(lead)} min read</span>
            </p>
            <h3 class="home-lead__title">
              <a href={`/blogs/${lead.id}/`} class="home-card__link">{lead.data.title}</a>
            </h3>
            {lead.data.description && <p class="home-lead__desc">{lead.data.description}</p>}
            <span class="home-lead__cta" aria-hidden="true">Read the study <span>→</span></span>
          </div>
          <img
            class="home-lead__image"
            src={leadArt?.src ?? lead.data.thumbnail ?? GENERIC_THUMB}
            srcset={leadArt?.srcset}
            sizes="(max-width: 860px) 100vw, 560px"
            width={leadArt?.width ?? 1536}
            height={leadArt?.height ?? 1024}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </article>

        <ul class="home-cards">
          {recent.map((post) => (
            <li class="home-card">
              <img src={thumbOf(post)} alt="" width="480" height="320" loading="lazy" decoding="async" />
              <p class="home-meta">
                <span>{post.data.category}</span>
                <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
              </p>
              <h3 class="home-card__title">
                <a href={`/blogs/${post.id}/`} class="home-card__link">{post.data.title}</a>
              </h3>
              {post.data.description && <p class="home-card__desc">{post.data.description}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="home-section" aria-labelledby="lectures-title">
      <div class="hc-container">
        <header class="home-head">
          <h2 id="lectures-title" class="home-head__title">Lectures</h2>
          <a href="/youtube/" class="home-head__link">Visit the channel <span aria-hidden="true">→</span></a>
        </header>

        <div class="home-videos">
          {videos.map((vid) => (
            <a href={`https://www.youtube.com/watch?v=${vid.id}`} class="yt-lite" data-video-id={vid.id} aria-label="Play video lecture">
              <img src={vid.thumb} alt="" width="800" height="450" loading="lazy" decoding="async" />
              <span class="yt-play" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="projects-title">
      <div class="hc-container">
        <header class="home-head">
          <h2 id="projects-title" class="home-head__title">Research projects</h2>
          <a href="/projects/" class="home-head__link">All projects <span aria-hidden="true">→</span></a>
        </header>

        <ul class="home-projects">
          {projects.map((project) => (
            <li>
              <a href={project.href} class="home-project">
                <span class="home-project__title">{project.title}</span>
                <span class="home-project__desc">{project.desc}</span>
                <span class="home-project__figure">{project.figure}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="home-closing" aria-labelledby="closing-title">
      <div class="hc-container home-closing__inner">
        <h2 id="closing-title" class="home-closing__title">
          Truth is sought through evidence and transmitted with integrity.
        </h2>
        <p class="home-closing__lead">
          Get one email when a new study is published, with a direct link to read it.
        </p>
        <SubscribeForm variant="closing" />
        <p class="home-closing__contact">
          Questions, corrections and source submissions are welcome.
          <a href="/contact/">Write to HadithCritic</a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /* Lite YouTube player. Each tile is a real link to the video; with script
     it is swapped for the privacy-enhanced embed in place. */
  function initHome() {
    for (const link of document.querySelectorAll<HTMLAnchorElement>("a.yt-lite")) {
      if (link.dataset.ready) continue;
      link.dataset.ready = "1";
      link.addEventListener("click", (event) => {
        const id = link.dataset.videoId;
        if (!id || event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        const frame = document.createElement("div");
        frame.className = link.className;
        frame.dataset.videoId = id;
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
        iframe.title = "YouTube video player";
        iframe.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        frame.appendChild(iframe);
        link.replaceWith(frame);
        iframe.focus();
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHome);
  } else {
    initHome();
  }
  document.addEventListener("astro:page-load", initHome);
</script>
