              <div class="project-stat-item">
                <span class="project-stat-item__num">276,347</span>
                <span class="project-stat-item__lbl">Attested Reports</span>
              </div>
              <div class="project-stat-item">
                <span class="project-stat-item__num">33</span>
                <span class="project-stat-item__lbl">Compilations</span>
              </div>
              <div class="project-stat-item">
                <span class="project-stat-item__num">Bilingual</span>
                <span class="project-stat-item__lbl">FTS5 Search</span>
              </div>
            </div>

            <div class="project-module-card__pills-row">
              <span class="project-pills-label">Key Compilations</span>
              <div class="project-pills">
                <span class="project-pill">Ṣaḥīḥ al-Bukhārī</span>
                <span class="project-pill">Ṣaḥīḥ Muslim</span>
                <span class="project-pill">Musnad Aḥmad</span>
                <span class="project-pill">Al-Kāfī</span>
