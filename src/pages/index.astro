---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeSection from "../components/home/HomeSection.astro";
import HomeButton from "../components/home/HomeButton.astro";
import MedallionBand from "../components/home/MedallionBand.astro";
import CompilerMap from "../components/home/CompilerMap.astro";
import FacingText from "../components/home/FacingText.astro";
import ChronologyRail from "../components/home/ChronologyRail.astro";
import VerseLayers from "../components/home/VerseLayers.astro";
import SurahCoverage from "../components/home/SurahCoverage.astro";
import GenerationLadder from "../components/home/GenerationLadder.astro";
import BiographyCard from "../components/home/BiographyCard.astro";
import StudiesTabs from "../components/home/StudiesTabs.astro";
import MethodPipeline, { type MethodStep } from "../components/home/MethodPipeline.astro";
import ResourceShelf from "../components/home/ResourceShelf.astro";
import ToolTiles from "../components/home/ToolTiles.astro";
import GitBookBand from "../components/home/GitBookBand.astro";
import ChannelLectures from "../components/home/ChannelLectures.astro";
import SetupCard from "../components/home/SetupCard.astro";
import DataTree from "../components/home/DataTree.astro";
import { loadHomeData } from "../lib/home-data";
import "../styles/home.css";
import "../styles/yt-lite.css";
import "../styles/home-hero.css";
import "../styles/home-sections.css";
import "../styles/home-closing.css";

/* Section order and the figure each will carry are set out in
   docs/home/front-page-plan.md. Every figure comes from loadHomeData(). */
const home = await loadHomeData();

const YOUTUBE_CHANNEL = "https://www.youtube.com/@HadithCritic";

/* How a study is built. Each step names the part of the site that does it. */
const method: MethodStep[] = [
  { title: "Collect the variants", text: "Gather every version of a report across the early compilations.", href: "/hadith/", link: "Hadith corpus" },
  { title: "Identify the narrators", text: "Resolve each name in the chains to a person, with dates and grades from the Taqrīb.", href: "/projects/rijal/", link: "Narrators register" },
  { title: "Map the chains", text: "Draw the transmission paths and find where they meet in a common link.", href: "/projects/academic-studies/", link: "ICMA register" },
  { title: "Compare the wording", text: "Set the versions side by side and trace what each transmitter changed.", href: "/blogs/category/transmission-narrators/", link: "Transmission studies" },
  { title: "Date the report", text: "Place the tradition in time and name who put it into circulation.", href: "/blogs/", link: "All studies" },
];

---

<BaseLayout title="HadithCritic | Verification Over Reputation">
  <div class="home">
    <section class="home-hero" aria-labelledby="home-title">
      <img
        class="home-hero__art"
        src="/images/platform/home-hero.webp"
        srcset="/images/platform/home-hero-960.webp 960w, /images/platform/home-hero.webp 1672w"
        sizes="100vw"
        width="1672"
        height="941"
        alt=""
        fetchpriority="high"
      />
      <div class="hc-container home-hero__copy">
        <p class="home-kicker home-kicker--light">Independent historical criticism</p>
        <h1 id="home-title" class="home-hero__title">
          Verification over <em>reputation.</em>
        </h1>
        <p class="home-hero__lede">
          Textual criticism, transmission forensics, and source verification:
          recovering early Islamic history through rigorous evidentiary research.
        </p>
        <div class="home-hero__actions">
          <HomeButton href="/blogs/" variant="light">Explore the archive</HomeButton>
          <HomeButton href="#method" variant="glass">How a study is built</HomeButton>
        </div>
      </div>
      <a class="home-hero__cue" href="#method">The method <span aria-hidden="true">↓</span></a>
    </section>

    <MedallionBand medallions={home.hero.medallions} />

    <HomeSection
      id="method"
      tone="panel"
      defer={false}
      kicker="How a study is built"
      title="From scattered reports to a dated tradition."
      lede="Every study on this site follows the same path through the sources. Each step has its own part of the site."
    >
      <MethodPipeline steps={method} />
    </HomeSection>

    <HomeSection id="latest" align="split" kicker="The latest from the archive" title="Recent studies">
      <a slot="aside" href="/blogs/" class="home-link">All {home.studies.all.length} studies <span aria-hidden="true">→</span></a>

      <StudiesTabs tabs={home.studies.tabs} />
    </HomeSection>

    <HomeSection
      id="corpus"
      tone="parchment"
      kicker="Hadith corpus"
      title="Read the early compilations in their own order."
      lede="Narrations in facing Arabic and English, laid out the way each printed edition arranges them."
    >
      <div class="corpus-figures">
        <div class="reveal"><CompilerMap map={home.corpus.map} /></div>
        <div class="reveal reveal--d1"><FacingText narration={home.corpus.narration} /></div>
      </div>
      <div class="section-actions section-actions--center">
        <HomeButton href="/hadith/" variant="dark">Open all {home.hadith.collections} collections</HomeButton>
      </div>
    </HomeSection>

    <HomeSection
      id="narrators"
      tone="dark"
      kicker="Narrators register"
      title="Every name in the chains, from Ibn Ḥajar's Taqrīb."
      lede="The biographies of the Taqrīb al-Tahdhīb in Arabic and English, with each narrator's generation, grade and death date read from the entry."
    >
      <div class="narrator-figures">
        <GenerationLadder ladder={home.narrators.ladder} crossReferences={home.narrators.crossReferences} />
        <BiographyCard biography={home.narrators.biography} />
      </div>
      <div class="section-actions section-actions--center">
        <HomeButton href="/projects/rijal/" variant="light">Open the register</HomeButton>
      </div>
    </HomeSection>

    <HomeSection
      id="tafsir"
      tone="dark"
      notch
      kicker="Tafsir"
      title="Four commentaries, one verse at a time."
      lede="The early commentaries on the Qur'an, read verse by verse with the Arabic beside the English."
    >
      <div class="tafsir-figures">
        <VerseLayers figure={home.tafsir.layers} />
        <SurahCoverage coverage={home.tafsir.coverage} />
      </div>
      <div class="section-actions section-actions--center">
        <HomeButton href="/projects/tafsir/" variant="light">Open the tafsir library</HomeButton>
      </div>
    </HomeSection>

    <HomeSection
      id="tarikh"
      tone="parchment"
      kicker="Tārīkh"
      title="The earliest histories, in the order they were written."
      lede="Arabic histories of early Islam in English, each in its own reader with the chapters beside the text."
    >
      <ChronologyRail chronology={home.history.chronology} />
      <div class="section-actions section-actions--center">
        <HomeButton href="/projects/history/" variant="dark">Open the history library</HomeButton>
      </div>
    </HomeSection>

    <HomeSection
      id="resources"
      tone="dark"
      kicker="Resources"
      title="Works, tools and archives worth keeping."
      lede="Books, digital manuscripts, documentaries and tools from the wider Quran-centered research community."
    >
      <div class="resource-figures">
        <ResourceShelf figure={home.resources} />
        <ToolTiles tools={home.resources.tools} />
      </div>
      <GitBookBand items={home.resources.gitbooks} />
      <div class="section-actions section-actions--center">
        <HomeButton href="/resources/" variant="light">Browse all {home.resources.entries} resources</HomeButton>
      </div>
    </HomeSection>

    <HomeSection
      id="lectures"
      tone="dark"
      notch
      kicker="On YouTube"
      title="Lectures & discussions"
      lede="Lectures from the HadithCritic YouTube channel on textual evidence, historical claims, and the methods used to examine them."
    >
      <ChannelLectures youtube={home.youtube} />
      <div class="section-actions section-actions--center">
        <HomeButton href={YOUTUBE_CHANNEL} variant="light" external>Visit the YouTube channel</HomeButton>
      </div>
    </HomeSection>

    <HomeSection
      id="open-source"
      tone="parchment"
      kicker="Open source"
      title="The site and its data are open."
      lede="The code behind every page is on GitHub, and each hadith collection is published as a bilingual JSON file you can use in your own work."
    >
      <div class="open-figures">
        <SetupCard tabs={home.openSource.tabs} />
        <DataTree tree={home.openSource.tree} files={home.openSource.files} />
      </div>
      <div class="section-actions section-actions--center">
        <HomeButton href={home.openSource.repo} variant="dark" external>View the repository on GitHub</HomeButton>
      </div>
    </HomeSection>

    <section class="home-closing" id="subscribe" aria-labelledby="closing-title">
      <div class="hc-container home-closing__inner reveal" data-subscribe-form>
        <h2 id="closing-title" class="home-closing__title">Stay with the evidence.</h2>
        <p class="home-closing__lead">One email when a new study is published.</p>
        <form class="home-closing__form" data-subscribe-form-el hidden>
          <label class="sr-only" for="closing-email">Email address</label>
          <div class="home-closing__field">
            <input type="email" id="closing-email" name="email" placeholder="you@example.com" required autocomplete="email" inputmode="email" />
            <!-- Honeypot: never shown or focusable, so only a bot fills it. -->
            <input type="text" name="website" hidden tabindex="-1" autocomplete="off" />
            <button type="submit">Subscribe</button>
          </div>
        </form>
        <p class="home-closing__status" data-subscribe-form-status role="status" aria-live="polite"></p>
        <noscript><p class="home-closing__lead">Enable JavaScript to subscribe, or <a href="/rss.xml">follow by RSS</a>.</p></noscript>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { bindSubscribeForms } from "../lib/subscribe-client";
  import { initHomeMotion } from "../lib/home-motion";
  import { initCompilerMap } from "../lib/home-compiler-map";
  import { initDetailPanels } from "../lib/home-detail-panel";
  import { initTafsirFigures } from "../lib/home-tafsir-figures";
  import { initLectures } from "../lib/home-lectures";
  import { initCopyButtons } from "../lib/home-copy";

  let stopFigures: (() => void) | undefined;
  document.addEventListener("astro:before-swap", () => {
    stopFigures?.();
    stopFigures = undefined;
  });

  function initHome() {
    if (!document.querySelector(".home")) return;
    bindSubscribeForms();
    initHomeMotion(document);
    stopFigures?.();
    const stops = [
      initCompilerMap(document),
      initDetailPanels(document),
      initTafsirFigures(document),
      initLectures(document),
      initCopyButtons(document),
    ];
    stopFigures = () => stops.forEach((stop) => stop());
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHome);
  } else {
    initHome();
  }
  document.addEventListener("astro:page-load", initHome);
</script>
