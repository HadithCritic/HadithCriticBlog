---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogSlider from '../components/BlogSlider.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Home">
    <!-- Hero Section -->
    <header class="hero">
        <div class="particles" id="particleSystem"></div>
        <div class="container hero-layout">
            <div class="hero-text">
                <h1>Unveiling The<br><em>History of Hadith</em></h1>
                <div class="hero-divider"></div>
                <p>
                    A rigorous examination of traditional Islamic narratives through historical criticism, philosophical
                    analysis, and the Quranic mandate. Questioning isnād-based methodology and mainstream assumptions of
                    authenticity.
                </p>
                <div class="hero-btns">
                    <a href="/blogs" class="btn btn-primary">
                        Read Blogs <i class="fas fa-arrow-right"></i>
                    </a>
                    <a href="https://youtube.com/@HadithCritic" target="_blank" class="btn btn-outline">
                        <i class="fab fa-youtube"></i> YouTube
                    </a>
                </div>
            </div>

            <!-- Isnad Network Visualization -->
            <div class="hero-visual">
                <div class="orbital-rings">
                    <div class="analysis-ring analysis-ring-1"></div>
                    <div class="analysis-ring analysis-ring-2"></div>
                    <div class="analysis-ring analysis-ring-3"></div>
                </div>
                <div class="particle-burst" id="particleBurst"></div>
                <svg class="isnad-canvas" id="isnadCanvas"></svg>
                <div class="isnad-network" id="isnadNetwork">
                    <div class="isnad-bundle left-1">
                        <div class="narrator-node" data-name="Rawī A">R1</div>
                        <div class="narrator-node common-link" data-name="Muḥaddith X" data-common="true">M</div>
                        <div class="narrator-node" data-name="Rawī B">R2</div>
                    </div>
                    <div class="isnad-bundle left-2">
                        <div class="narrator-node" data-name="Rawī C">R3</div>
                        <div class="narrator-node common-link" data-name="Weak Link Y" data-common="true">W</div>
                        <div class="narrator-node" data-name="Rawī D">R4</div>
                    </div>
                    <div class="isnad-bundle right-1">
                        <div class="narrator-node" data-name="Rawī H">R8</div>
                        <div class="narrator-node common-link" data-name="Disputed P" data-common="true">D</div>
                    </div>
                    <div class="isnad-bundle right-2">
                        <div class="narrator-node common-link" data-name="Liar Q" data-common="true">L</div>
                        <div class="narrator-node" data-name="Rawī J">R10</div>
                    </div>
                </div>
                <div class="critic-container">
                    <img src="https://hadithcriticblog.com/wp-content/uploads/2026/02/cropped-HCpfp.jpg"
                        class="hero-image" alt="HadithCritic">
                    <div class="analysis-status">EXTRACTING HISTORICAL REALITY</div>
                </div>
                <div class="extraction-beam" id="beam1"></div>
                <div class="extraction-beam" id="beam2"></div>
            </div>
        </div>
    </header>
    <!-- Blog Slider Component -->
    <BlogSlider articles={sortedArticles.slice(0, 12)} compact={true} />

    <!-- Academia Section -->
    <section class="academia-preview">
        <div class="academia-bg-grid"></div>
        <div class="container">
            <div class="academia-shell">
                <div class="academia-preview-text">
                    <span class="section-kicker"><i class="fas fa-university"></i> Peer-Reviewed & Published</span>
                    <h2>Academic Monographs<br> &amp; Research Papers</h2>
                    <p>Dive deep into our formally published critical methodologies, comprehensive refutations, and foundational texts in the field of Islamic studies.</p>
                    
                    <ul class="academia-features">
                        <li><i class="fas fa-check-circle"></i> Historical Criticism</li>
                        <li><i class="fas fa-check-circle"></i> Quranic Epistemology</li>
                        <li><i class="fas fa-check-circle"></i> Methodological Refutations</li>
                    </ul>

                    <a href="/academia" class="btn btn-gold-glow">
                        Explore Publications <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
                <div class="academia-preview-visual">
                    <div class="book-showcase">
                        <div class="book-glow-back"></div>
                        <div class="book-mini">
                            <div class="badge-mini">
                                <span class="badge-dot"></span> New Release
                            </div>
                            <img src="/images/RefutationKJI_FC.png" alt="Book Cover" class="book-mini-img">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* Premium Academia Section */
    .academia-preview {
        position: relative;
        padding: 100px 20px;
        background: linear-gradient(180deg, #0a0a0a 0%, #111 100%);
        border-top: 1px solid rgba(255,255,255,0.04);
        overflow: hidden;
    }

    .academia-bg-grid {
        position: absolute;
        inset: 0;
        background-image: 
            linear-gradient(to right, rgba(255,255,255,0.02) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(circle at 70% 50%, black, transparent 60%);
        pointer-events: none;
    }

    .academia-shell {
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 60px;
        align-items: center;
        position: relative;
        z-index: 10;
        background: rgba(20, 20, 20, 0.6);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 32px;
        padding: 50px 60px;
        box-shadow: 0 40px 100px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.05);
        backdrop-filter: blur(20px);
    }

    .academia-shell::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 32px;
        background: radial-gradient(circle at 80% 20%, rgba(202, 138, 4, 0.12), transparent 400px);
        pointer-events: none;
    }

    .section-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--hc-gold, #ca8a04);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        margin-bottom: 16px;
        background: rgba(202, 138, 4, 0.1);
        padding: 6px 14px;
        border-radius: 999px;
        border: 1px solid rgba(202, 138, 4, 0.2);
    }

    .academia-preview-text h2 {
        font-family: var(--font-display);
        font-size: clamp(32px, 4vw, 48px);
        color: var(--text-heading);
        margin: 0 0 20px 0;
        line-height: 1.15;
        letter-spacing: 0.02em;
    }

    .academia-preview-text p {
        color: var(--text-body);
        font-size: 16px;
        line-height: 1.7;
        margin: 0 0 30px 0;
        max-width: 480px;
    }

    .academia-features {
        list-style: none;
        padding: 0;
        margin: 0 0 40px 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .academia-features li {
        color: #e2e8f0;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
    }

    .academia-features li i {
        color: var(--hc-gold, #ca8a04);
        font-size: 15px;
    }

    .btn-gold-glow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient(135deg, #ca8a04 0%, #a16207 100%);
        color: #fff;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
        box-shadow: 0 10px 30px rgba(202, 138, 4, 0.25);
        transition: all 0.3s ease;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .btn-gold-glow:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(202, 138, 4, 0.4);
        background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    }

    .academia-preview-visual {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
    }

    .book-showcase {
        position: relative;
        perspective: 1200px;
    }

    .book-glow-back {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 180px;
        height: 240px;
        transform: translate(-50%, -50%);
        background: #ca8a04;
        filter: blur(60px);
        opacity: 0.25;
        border-radius: 50%;
        z-index: 0;
        transition: opacity 0.5s ease;
    }

    .book-showcase:hover .book-glow-back {
        opacity: 0.45;
    }

    .book-mini {
        position: relative;
        z-index: 10;
        transform-style: preserve-3d;
    }

    .book-mini-img {
        width: 220px;
        border-radius: 5px 12px 12px 5px;
        box-shadow: -15px 20px 40px rgba(0,0,0,0.6), inset 3px 0 8px rgba(255,255,255,0.25);
        transform: rotateY(-18deg) rotateX(4deg) rotateZ(2deg);
        transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.6s ease;
    }
    
    .book-showcase:hover .book-mini-img {
        transform: rotateY(-5deg) rotateX(0deg) rotateZ(0deg) scale(1.05);
        box-shadow: -8px 15px 30px rgba(0,0,0,0.5), inset 2px 0 5px rgba(255,255,255,0.3);
    }

    .badge-mini {
        position: absolute;
        top: -15px;
        right: -25px;
        background: rgba(15,15,15,0.9);
        color: #fff;
        padding: 8px 16px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 10px 25px rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        gap: 8px;
        z-index: 20;
        transform: translateZ(30px);
        backdrop-filter: blur(10px);
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        background: #4ade80;
        border-radius: 50%;
        box-shadow: 0 0 10px #4ade80;
        animation: pulseDot 2s infinite;
    }

    @keyframes pulseDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.2); }
    }

    @media (max-width: 900px) {
        .academia-shell {
            grid-template-columns: 1fr;
            padding: 40px 30px;
            text-align: center;
            gap: 50px;
        }
        .academia-preview-text p {
            margin: 0 auto 30px auto;
        }
        .academia-features {
            align-items: center;
        }
        .badge-mini {
            right: 50%;
            transform: translateX(50%) translateZ(30px);
            top: -25px;
        }
    }
</style>
