<style>
  /* Hero */

  /* The hero ground is a single flat surface colour. The illustration sits on
     its own masked layer (.hero-media) rather than as a background layer here,
     because a background image cannot be masked independently of the gradients
     stacked with it — which is what produced the visible vertical seam where
     `background-size: contain` ended.

     The two grounds also did not match: asset1.webp letterboxes to a warm
     rgb(12,12,10) while --hc-surface-0 is a cool rgb(15,15,16), so the join
     shifted hue as well as value. Masking the illustration's edges to nothing
     makes the exact black irrelevant in both themes. */
  .hero-section {
    position: relative;
    border-bottom: 1px solid var(--hc-rule);
    background-color: var(--hc-surface-0);
    background-image: radial-gradient(
      circle at 18% 44%,
      rgba(216, 177, 102, 0.08),
      transparent 28%
    );
    overflow: hidden;
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(2rem, 3.5vw, 2.75rem);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("/images/asset1.webp");
    background-size: contain;
    background-position: right center;
    background-repeat: no-repeat;
    pointer-events: none;
    /* Dissolve every edge into the ground. The horizontal stops reproduce the
       weighting of the scrim this replaced (2% / 4% / 32% / 82% / 92% visible),
       so the illustration keeps its original prominence behind the headline —
       the difference is that it now fades to nothing on the left instead of
       ending on a vertical line, and the vertical mask does the same top and
       bottom. */
    --hero-fade-y: 10%;
    -webkit-mask-image:
      linear-gradient(
        90deg,
        transparent 0%,
        rgba(0, 0, 0, 0.04) 28%,
        rgba(0, 0, 0, 0.32) 46%,
        rgba(0, 0, 0, 0.82) 72%,
        rgba(0, 0, 0, 0.92) 100%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        #000 var(--hero-fade-y),
        #000 calc(100% - var(--hero-fade-y)),
        transparent 100%
      );
    mask-image:
      linear-gradient(
        90deg,
        transparent 0%,
        rgba(0, 0, 0, 0.04) 28%,
        rgba(0, 0, 0, 0.32) 46%,
        rgba(0, 0, 0, 0.82) 72%,
        rgba(0, 0, 0, 0.92) 100%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        #000 var(--hero-fade-y),
        #000 calc(100% - var(--hero-fade-y)),
        transparent 100%
      );
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  :global([data-theme="light"]) .hero-media {
    background-image: url("/images/asset1-light.webp");
