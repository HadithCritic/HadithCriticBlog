---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { isNewPost } from "../lib/new-badge";

const GENERIC_THUMB = "/images/blog_thumbnails/tn.generic.webp";

const allPosts = await getCollection(
  "articles",
  ({ data }) => (import.meta.env.DEV || !data.draft) && !data.preview,
);
const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const categoryDescriptions: Record<string, string> = {
  "Origins & Early History":
    "Early Islamic history, specific events, and broad origins.",
  "Prophecies & Eschatology":
    "Mahdi reports, apocalyptic claims, black banners, and dynastic memory.",
  "Transmission & Narrators":
    "Isnād politics, common links, and specific narrators.",
  "Theology & Epistemology":
    "Quranic authority, law, abrogation, and probability.",
  Blog: "Site notes, announcements, and shorter reflections.",
};

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(
    post.data.category,
    (categoryCounts.get(post.data.category) ?? 0) + 1,
  );
}

const categoryTopPosts = new Map<string, typeof posts>();
for (const post of posts) {
  const list = categoryTopPosts.get(post.data.category) ?? [];
  if (list.length < 3) {
    list.push(post);
    categoryTopPosts.set(post.data.category, list);
  }
}

const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => {
    const previewPosts = categoryTopPosts.get(name) ?? [];
    return {
      name,
      count,
      description: categoryDescriptions[name] ?? "",
      previewPosts,
      topPost: previewPosts[0] ?? null,
    };
  });

const featured = posts[0];
const featuredThumb = featured?.data.thumbnail ?? GENERIC_THUMB;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });

const folioOf = (post: (typeof posts)[number]) =>
  String(posts.length - posts.indexOf(post)).padStart(3, "0");

const calcReadingMinutes = (post?: (typeof posts)[number]) => {
  if (!post) return 1;
  const rawBody = post.body || "";
  const words = rawBody.replace(/<[^>]*>/g, "").trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
};

const featuredReadingMinutes = calcReadingMinutes(featured);

const previewDataMap: Record<string, any> = {
  all: {
    id: featured.id,
    href: `/blogs/${featured.id}/`,
    title: featured.data.title,
    description: featured.data.description,
    category: featured.data.category,
    date: formatDate(featured.data.date),
    rawDate: featured.data.date.toISOString().slice(0, 10),
    isNew: isNewPost(featured.data.date),
    thumbnail: featuredThumb,
    readingMinutes: featuredReadingMinutes,
    folio: folioOf(featured),
    tags: (featured.data.tags || []).slice(0, 4),
    badgeText: "Latest Investigation",
  },
};

for (const cat of categories) {
  if (cat.topPost) {
    previewDataMap[cat.name] = {
      id: cat.topPost.id,
      href: `/blogs/${cat.topPost.id}/`,
      title: cat.topPost.data.title,
      description: cat.topPost.data.description,
      category: cat.topPost.data.category,
      date: formatDate(cat.topPost.data.date),
      rawDate: cat.topPost.data.date.toISOString().slice(0, 10),
      isNew: isNewPost(cat.topPost.data.date),
      thumbnail: cat.topPost.data.thumbnail ?? GENERIC_THUMB,
      readingMinutes: calcReadingMinutes(cat.topPost),
      folio: folioOf(cat.topPost),
      tags: (cat.topPost.data.tags || []).slice(0, 4),
      badgeText: `Lead Study // ${cat.name}`,
    };
  }
}

const videos = [
  { id: "HWHjCfaPn_0", thumb: "/images/yt tn/1.webp" },
  { id: "6bpJBji3E0M", thumb: "/images/yt tn/3.webp" },
  { id: "3B0rnPGWgKU", thumb: "/images/yt tn/8.webp" },
  { id: "CG5i14GAZTQ", thumb: "/images/yt tn/9.webp" },
  { id: "boG5JTD5yXU", thumb: "/images/yt tn/7.webp" },
  { id: "MLaRB6uGhAk", thumb: "/images/yt tn/4.webp" },
];
---

<BaseLayout title="HadithCritic | Verification Over Reputation">
  <link slot="head" rel="preload" as="image" href="/images/asset1.webp" />
  <section class="hero-section" data-motion="hero">
    <div class="hero-media" aria-hidden="true"></div>
    <div class="hc-container">
      <div class="hero-content">
        <h1 class="hero-title">
          Tracing the origins of <span class="hero-title-accent">early traditions.</span>
        </h1>
        <p class="hero-subtitle">
          Textual criticism, transmission forensics, and source verification—recovering early Islamic history through rigorous evidentiary research.
        </p>
        <div class="hero-actions">
          <a href="/blogs/" class="hc-btn hero-btn-primary">
            Browse the archive <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="/academia/" class="hc-btn hc-btn--ghost hero-btn-ghost">Read the research</a>
        </div>
      </div>
    </div>
  </section>

  <section
    data-motion="reveal"
    class="hc-section archive-journal-section"
    aria-labelledby="archive-journal-title"
  >
    <div class="hc-container">
      <header class="journal-header">
        <div>
          <h2 id="archive-journal-title" class="hc-title hc-title--md">
            From the <em>archive</em>
          </h2>
          <p class="hc-copy journal-header-copy">
            Essays and research notes on transmission, prophecy reports, Quranic
            authority, epistemology, and scriptural history.
          </p>
        </div>
        <a href="/blogs/" class="hc-btn hc-btn--ghost">
          Browse all {posts.length} entries <span aria-hidden="true">→</span>
        </a>
      </header>

      <div class="archive-preview-container">
        <!-- Live Filter Status Banner (reveals when category is active) -->
        <div class="archive-filter-banner" id="archive-filter-banner" hidden>
          <div class="filter-banner__left">
            <span class="filter-banner__dot" aria-hidden="true"></span>
            <span class="filter-banner__label">Filtering by Branch:</span>
            <strong class="filter-banner__cat" id="filter-banner-cat">Category Name</strong>
            <span class="filter-banner__count" id="filter-banner-count">(N Studies)</span>
          </div>
          <div class="filter-banner__actions">
            <a href="/blogs/" class="filter-banner__explore-btn" id="filter-banner-explore-link">
              Browse All in Category <span aria-hidden="true">→</span>
            </a>
            <button type="button" class="filter-banner__reset-btn" id="filter-banner-reset-btn" aria-label="Reset filter to show overall latest">
              Reset <span aria-hidden="true">✕</span>
            </button>
          </div>
        </div>

        <div class="journal-feature-grid">
          <a
            href={`/blogs/${featured.id}/`}
            class="journal-feature-card"
            id="journal-feature-card"
            data-category={featured.data.category}
          >
            <div class="journal-feature-media">
              <img
                src={featuredThumb}
                alt={`Cover illustration for ${featured.data.title}`}
                class="journal-feature-img"
                id="journal-feature-img"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="journal-feature-copy">
              <div class="journal-feature-kicker">
                <div class="journal-feature-badge" id="journal-feature-badge">
                  <span class="feature-badge__dot"></span>
                  <span class="feature-badge__text">Latest Investigation</span>
                </div>
                <div class="journal-feature-folio-tag" id="journal-feature-folio">
                  <span class="folio-tag__prefix">FOLIO</span>
                  <span class="folio-tag__val">HC-{folioOf(featured)}</span>
                </div>
              </div>
              <div class="journal-feature-top">
                <span
                  class="journal-category"
                  id="journal-feature-cat"
                  data-category={featured.data.category}
                >
                  {featured.data.category}
                </span>
                <time
                  class="journal-feature-date"
                  id="journal-feature-date"
                  datetime={featured.data.date.toISOString().slice(0, 10)}
                >
                  {formatDate(featured.data.date)}
                </time>
                <span class="journal-feature-readtime" id="journal-feature-readtime">
                  <svg class="readtime-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span>{featuredReadingMinutes} min read</span>
                </span>
                {
                  isNewPost(featured.data.date) && (
                    <span class="new-badge" id="journal-feature-new">New</span>
                  )
                }
              </div>
              <h3 id="journal-feature-title">{featured.data.title}</h3>
              <p id="journal-feature-desc">{featured.data.description}</p>
              <div class="journal-feature-tags" id="journal-feature-tags">
                {
                  featured.data.tags && featured.data.tags.slice(0, 4).map((tag: string) => (
                    <span class="journal-tag">#{tag}</span>
                  ))
                }
              </div>
              <div class="journal-meta">
                <span class="journal-meta-cta">
                  Read the investigation <span class="journal-meta-arrow" aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>

          <!-- Archive Filter Instruction Bar -->
          <div class="archive-categories-intro">
            <div class="categories-intro-heading">
              <span class="intro-glyph" aria-hidden="true">✦</span>
              <span class="intro-title">Filter by Research Branch</span>
            </div>
            <p class="intro-hint">Select a dossier below to preview branch investigations</p>
          </div>

          <nav class="journal-categories" aria-label="Browse entries by category">
            {
              categories.map((category, catIdx) => (
                <div
                  class="journal-category-tile dossier-folder"
                  data-category={category.name}
                  data-cat-index={catIdx}
                  role="button"
                  tabindex="0"
                  aria-pressed="false"
                  aria-label={`Filter archive preview by ${category.name}, ${category.count} ${category.count === 1 ? 'Study' : 'Studies'}`}
                >
                  <!-- Archival Dossier Header -->
                  <div class="dossier-tab-header">
                    <span class="dossier-tab-tag">
                      <span class="dossier-code">DOSSIER // 0{catIdx + 1}</span>
                    </span>
                    <span class="dossier-category-pill">
                      <span class="journal-category-dot" />
                      <span>{category.count} {category.count === 1 ? 'Study' : 'Studies'}</span>
                    </span>
                  </div>

                  <div class="dossier-body">
                    <h3 class="journal-category-title">{category.name}</h3>
                  </div>

                  <!-- Desktop Manuscript Slips (Peek Preview) -->
                  {category.previewPosts.length > 0 && (
                    <div class="dossier-slips-pocket" aria-hidden="true">
                      {category.previewPosts.map((preview, pIdx) => (
                        <div class={`dossier-slip dossier-slip--${pIdx + 1}`}>
                          <span class="dossier-slip-folio">No. {folioOf(preview)}</span>
                          <span class="dossier-slip-title">{preview.data.title}</span>
                        </div>
                      ))}
                    </div>
                  )}

                  <!-- Mobile Compact Slip (clean single-line reference without clipping) -->
                  {category.previewPosts[0] && (
                    <div class="dossier-mobile-peek" aria-hidden="true">
                      <span class="mobile-peek-label">Lead:</span>
                      <span class="mobile-peek-title">{category.previewPosts[0].data.title}</span>
                    </div>
                  )}

                  <div class="journal-category-foot">
                    <span class="dossier-filter-hint">
                      <span class="hint-filter-text">Filter Preview</span>
                      <span class="hint-active-text">Active Filter</span>
                    </span>
                    <a
                      href={`/blogs?category=${encodeURIComponent(category.name)}`}
                      class="journal-category-foot-link"
                      tabindex="0"
                      aria-label={`Open full archive for ${category.name}`}
                    >
                      <span>Explore</span>
                      <span class="foot-glyph" aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              ))
            }
          </nav>
        </div>

        <script is:inline id="archive-preview-payloads" type="application/json" set:html={JSON.stringify(previewDataMap)} />
      </div>

      <div class="home-ledger-wrap">
        <div class="home-ledger-header">
          <div class="home-ledger-header-copy">
            <div class="home-ledger-kicker">
              <span class="home-ledger-kicker-dot" aria-hidden="true"></span>
              <span class="home-ledger-kicker-text">Chronological Dispatches</span>
              <span class="home-ledger-kicker-count">{posts.length} Studies</span>
            </div>
            <h3 class="home-ledger-title">Latest studies &amp; analysis</h3>
            <p class="home-ledger-subtitle">
              Recent critical investigations into transmission chains and early texts.
            </p>
          </div>
          <div
            class="home-ledger-filters"
            role="group"
            aria-label="Filter latest studies by category"
          >
            <div class="home-filter-magnet-pill" aria-hidden="true"></div>
            <button
              type="button"
              class="home-filter-tab is-active"
              data-home-filter="all"
              data-total-count={posts.length}
            >
              <span class="home-tab__dot" aria-hidden="true"></span>
              <span>All ({posts.length})</span>
            </button>
            {
              categories.map((c) => (
                <button
                  type="button"
                  class="home-filter-tab"
                  data-home-filter={c.name}
                  data-category={c.name}
                  data-total-count={c.count}
                >
                  <span class="home-tab__dot" aria-hidden="true" />
                  <span>
                    {c.name} ({c.count})
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <ol class="home-ledger" id="home-ledger">
          {
            posts.map((post, index) => (
              <li
                class="home-ledger-row"
                data-category={post.data.category}
                hidden={index >= 5}
              >
                <a href={`/blogs/${post.id}/`} class="home-ledger-link">
                  <div class="home-ledger-folio">
                    <span class="home-ledger-no">
                      <span class="folio-glyph" aria-hidden="true">◈</span>
                      <span>No. {folioOf(post)}</span>
                    </span>
                    <time datetime={post.data.date.toISOString().slice(0, 10)}>
                      {formatDate(post.data.date)}
                    </time>
                    <span class="home-ledger-readtime">
                      <svg class="readtime-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                      <span>{calcReadingMinutes(post)} min read</span>
                    </span>
                  </div>
                  <div class="home-ledger-body">
                    <div class="home-ledger-top">
                      <span
                        class="home-ledger-cat"
                        data-category={post.data.category}
                      >
                        <span class="home-ledger-cat-dot" aria-hidden="true"></span>
                        {post.data.category}
                      </span>
                      {isNewPost(post.data.date) && (
                        <span class="new-badge">New</span>
                      )}
                    </div>
                    <h4 class="home-ledger-heading">{post.data.title}</h4>
                    {post.data.description && (
                      <p class="home-ledger-desc">
                        {post.data.description}
                      </p>
                    )}
                  </div>
                  <div class="home-ledger-action" aria-hidden="true">
                    <span class="home-ledger-action-label">Read folio</span>
                    <div class="home-ledger-arrow">
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
        </ol>

        <div class="home-ledger-footer">
          <div class="home-ledger-footer-status">
            <span class="home-ledger-footer-dot" aria-hidden="true"></span>
            <span id="home-ledger-count-label">Showing 5 of {posts.length} investigations</span>
          </div>
          <a href="/blogs/" class="hc-btn hc-btn--ghost home-ledger-cta-btn" id="home-ledger-cta">
            Explore All {posts.length} Studies in Archive <span
              aria-hidden="true">→</span
            >
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    data-motion="reveal"
    class="hc-section youtube-preview-section"
    aria-labelledby="lectures-title"
  >
    <div class="hc-container">
      <header class="journal-header">
        <div>
          <h2 id="lectures-title" class="hc-title hc-title--md">
            Lectures in <em>video</em>
          </h2>
          <p class="hc-copy journal-header-copy">
            Deep dives into transmission history and source criticism, in visual
            form.
          </p>
        </div>
        <a href="/youtube/" class="hc-btn hc-btn--ghost">
          Visit the channel <span aria-hidden="true">→</span>
        </a>
      </header>

      <div class="youtube-grid">
        {
          videos.map((vid) => (
            <button
              type="button"
              class="yt-lite"
              data-video-id={vid.id}
              aria-label="Play video lecture"
            >
              <img
                src={vid.thumb}
                alt=""
                width="800"
                height="450"
                loading="lazy"
                decoding="async"
              />
              <span class="yt-play" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M8 5.5v13l11-6.5z" />
                </svg>
              </span>
              <span class="yt-label" aria-hidden="true">
                Watch
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="hc-section projects-section"
    aria-labelledby="projects-title"
    data-motion="reveal"
  >
    <div class="hc-container">
      <header class="journal-header">
        <div>
          <h2 id="projects-title" class="hc-title hc-title--md">
            Large-scale <em>projects</em>
          </h2>
          <p class="hc-copy journal-header-copy">
            Research infrastructure for source criticism, transmission analysis, and manuscript verification.
          </p>
        </div>
        <a href="/projects/" class="hc-btn hc-btn--ghost">
          See all projects <span aria-hidden="true">→</span>
        </a>
      </header>

      <div class="projects-renovation">
        <div class="projects-live-grid">
          <!-- MODULE 1: HADITH CORPUS -->
          <a
            href="/hadith/"
            class="project-module-card project-module-card--link"
          >
            <div class="project-module-card__header">
              <span class="project-module-card__kicker">01 / Corpus</span>
            </div>

            <div class="project-module-card__title-row">
              <h3 class="project-module-card__title">Hadith Corpus</h3>
              <span class="project-module-card__ar" dir="rtl" lang="ar">المكنز الحديثي الشامل</span>
            </div>

            <p class="project-module-card__desc">
              Searchable critical edition of 276,347 narrations across 33 collections with bilingual full-text retrieval and linked chains.
            </p>

            <div class="project-stats-band" aria-label="Corpus statistics">
              <div class="project-stat-item">
                <span class="project-stat-item__num">276,347</span>
                <span class="project-stat-item__lbl">Reports</span>
              </div>
              <div class="project-stat-item">
                <span class="project-stat-item__num">33</span>
                <span class="project-stat-item__lbl">Collections</span>
              </div>
              <div class="project-stat-item">
                <span class="project-stat-item__num">Bilingual</span>
                <span class="project-stat-item__lbl">FTS5 Search</span>
              </div>
            </div>

            <div class="project-module-card__footer">
              <span class="project-module-card__cta">
                Explore corpus <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>

          <!-- MODULE 2: RIJAL REGISTER -->
          <a
            href="/narrators/"
            class="project-module-card project-module-card--link"
          >
            <div class="project-module-card__header">
              <span class="project-module-card__kicker">02 / Register</span>
            </div>

            <div class="project-module-card__title-row">
              <h3 class="project-module-card__title">Rijāl Register</h3>
              <span class="project-module-card__ar" dir="rtl" lang="ar">طبقات الرواة والرجال</span>
            </div>

            <p class="project-module-card__desc">
              Prosopographical register of 20,950+ transmitters across 14 generations with teacher–student lineage and classical evaluations.
            </p>

            <div class="project-stats-band" aria-label="Transmitter statistics">
              <div class="project-stat-item">
                <span class="project-stat-item__num">20,950</span>
                <span class="project-stat-item__lbl">Transmitters</span>
              </div>
              <div class="project-stat-item">
                <span class="project-stat-item__num">14</span>
                <span class="project-stat-item__lbl">Generations</span>
              </div>
              <div class="project-stat-item">
                <span class="project-stat-item__num">Attributed</span>
                <span class="project-stat-item__lbl">Evaluations</span>
              </div>
            </div>

            <div class="project-module-card__footer">
              <span class="project-module-card__cta">
                Browse register <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>

          <!-- MODULE 3: ACADEMIC STUDIES -->
          <a
            href="/projects/academic-studies/"
            class="project-module-card project-module-card--link"
          >
            <div class="project-module-card__header">
              <span class="project-module-card__kicker">03 / Studies</span>
            </div>

            <div class="project-module-card__title-row">
              <h3 class="project-module-card__title">Academic Studies</h3>
              <span class="project-module-card__ar" dir="rtl" lang="ar">الدراسات الأكاديمية</span>
            </div>

            <p class="project-module-card__desc">
              Specialized isnād-cum-matn monographs and Harald Motzki case studies reconstructing early transmission horizons and textual origins.
            </p>

            <div class="project-stats-band" aria-label="Academic studies statistics">
              <div class="project-stat-item">
                <span class="project-stat-item__num">27</span>
                <span class="project-stat-item__lbl">Monographs</span>
              </div>
              <div class="project-stat-item">
                <span class="project-stat-item__num">17</span>
                <span class="project-stat-item__lbl">Motzki Studies</span>
              </div>
              <div class="project-stat-item">
                <span class="project-stat-item__num">1st–3rd C.</span>
                <span class="project-stat-item__lbl">Termini</span>
              </div>
            </div>

            <div class="project-module-card__footer">
              <span class="project-module-card__cta">
                Read studies <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>


  <section class="hc-section closing-banner-section" data-motion="reveal">
    <div class="hc-container">
      <div class="closing-banner">
        <div class="closing-copy">
          <h2 class="hc-title hc-title--md">
            Truth is sought through evidence and transmitted with integrity.
          </h2>
          <p class="closing-lead">
            Questions, corrections, collaboration, and source submissions are
            welcome.
