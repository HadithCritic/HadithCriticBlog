</style>

<script>
  function initHome() {
    // YouTube Lite Player
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      ".yt-lite",
    )) {
      button.addEventListener(
        "click",
        () => {
          const id = button.dataset.videoId;
          if (!id) return;
          const iframe = document.createElement("iframe");
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
          iframe.title = "YouTube video player";
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.allowFullscreen = true;
          button.replaceChildren(iframe);
        },
        { once: true },
      );
    }

    // Home Ledger Filter Tabs - Show first 5 blogs of each category
    const filterContainer = document.querySelector<HTMLElement>(".home-ledger-filters");
    const filterMagnetPill = filterContainer?.querySelector<HTMLElement>(".home-filter-magnet-pill");
    const filterTabs =
      document.querySelectorAll<HTMLButtonElement>(".home-filter-tab");
    const ledgerRows = [
      ...document.querySelectorAll<HTMLLIElement>(".home-ledger-row"),
    ];

    ledgerRows.forEach((row) => {
      row.addEventListener("mousemove", (e) => {
        const rect = row.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        row.style.setProperty("--mouse-x", `${x.toFixed(1)}%`);
        row.style.setProperty("--mouse-y", `${y.toFixed(1)}%`);
      });
    });
    const ctaBtn = document.getElementById("home-ledger-cta");

    const updateMagnetPill = (tab: HTMLElement) => {
      if (!filterMagnetPill || !filterContainer || !tab) return;
      const cRect = filterContainer.getBoundingClientRect();
      const tRect = tab.getBoundingClientRect();
      const left = tRect.left - cRect.left;
      const top = tRect.top - cRect.top;
      filterMagnetPill.style.transform = `translate(${left}px, ${top}px)`;
      filterMagnetPill.style.width = `${tRect.width}px`;
      filterMagnetPill.style.height = `${tRect.height}px`;
      filterMagnetPill.style.opacity = "1";
      const activeBg = getComputedStyle(tab).getPropertyValue('--home-tab-active-bg').trim() || 'var(--hc-gold)';
      filterMagnetPill.style.backgroundColor = activeBg;
      filterMagnetPill.style.boxShadow = `0 2px 10px color-mix(in srgb, ${activeBg} 40%, transparent)`;
    };

    if (filterContainer && filterMagnetPill) {
      filterContainer.setAttribute("data-magnet-ready", "true");
      const initialActive = filterContainer.querySelector<HTMLButtonElement>(".home-filter-tab.is-active");
      if (initialActive) updateMagnetPill(initialActive);
      window.addEventListener("resize", () => {
        const active = filterContainer.querySelector<HTMLButtonElement>(".home-filter-tab.is-active");
        if (active) updateMagnetPill(active);
      }, { passive: true });
    }

    const countLabel = document.getElementById("home-ledger-count-label");

    const applyFilter = (filter: string, totalCount?: string) => {
      let count = 0;
      ledgerRows.forEach((row) => {
        const rowCategory = row.dataset.category ?? "";
        const matches = filter === "all" || rowCategory === filter;
        if (matches && count < 5) {
          row.hidden = false;
          row.style.opacity = "1";
          count++;
        } else {
          row.hidden = true;
        }
      });

      if (countLabel) {
        if (filter === "all") {
          countLabel.textContent = `Showing ${count} of ${ledgerRows.length} investigations`;
        } else {
          countLabel.textContent = `Showing ${count} of ${totalCount || count} in ${filter}`;
        }
      }

      if (ctaBtn) {
        if (filter === "all") {
          ctaBtn.setAttribute("href", "/blogs");
          ctaBtn.innerHTML =
            'Explore All Studies in Archive <span aria-hidden="true">→</span>';
        } else {
          ctaBtn.setAttribute(
            "href",
            `/blogs?category=${encodeURIComponent(filter)}`,
          );
          ctaBtn.innerHTML = `Explore All in ${filter} <span aria-hidden="true">→</span>`;
        }
      }
    };

    filterTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const filter = tab.dataset.homeFilter ?? "all";
        const totalCount = tab.dataset.totalCount;
        filterTabs.forEach((t) => t.classList.toggle("is-active", t === tab));
        updateMagnetPill(tab);
        applyFilter(filter, totalCount);
      });
    });

    // --- Archive Feature & Dossier Filter Controller ---
    const initArchiveFeature = () => {
      const card = document.getElementById("journal-feature-card") as HTMLAnchorElement | null;
      const banner = document.getElementById("archive-filter-banner");
      const bannerCat = document.getElementById("filter-banner-cat");
      const bannerCount = document.getElementById("filter-banner-count");
      const bannerExplore = document.getElementById("filter-banner-explore-link") as HTMLAnchorElement | null;
      const bannerReset = document.getElementById("filter-banner-reset-btn");
      const payloadEl = document.getElementById("archive-preview-payloads");
      if (!card || !payloadEl) return;

      let payloads: Record<string, any> = {};
      try {
        payloads = JSON.parse(payloadEl.textContent || "{}");
      } catch {
        return;
      }

      const categoryFolders = document.querySelectorAll<HTMLElement>(".journal-category-tile.dossier-folder");
      let activeFilter: string | null = null;

      // Mouse-tracking spotlight on preview card
      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        card.style.setProperty("--spotlight-x", `${x.toFixed(1)}%`);
        card.style.setProperty("--spotlight-y", `${y.toFixed(1)}%`);
      });

      // Mouse-tracking spotlight on category folder cards
      categoryFolders.forEach((folder) => {
        folder.addEventListener("mousemove", (e) => {
          const rect = folder.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          folder.style.setProperty("--card-spotlight-x", `${x.toFixed(1)}%`);
          folder.style.setProperty("--card-spotlight-y", `${y.toFixed(1)}%`);
        });
      });

      const updatePreview = (catName: string | null) => {
        const data = (catName && payloads[catName]) ? payloads[catName] : payloads["all"];
        if (!data) return;

        card.classList.add("is-transitioning");

        setTimeout(() => {
          card.href = data.href;
          card.setAttribute("data-category", data.category);

          const img = document.getElementById("journal-feature-img") as HTMLImageElement | null;
          if (img) {
            img.src = data.thumbnail;
            img.alt = `Cover illustration for ${data.title}`;
          }

          const badge = document.getElementById("journal-feature-badge");
          if (badge) {
            const text = badge.querySelector<HTMLElement>(".feature-badge__text");
            if (text) text.textContent = data.badgeText || "Investigation";
          }

          const folio = document.getElementById("journal-feature-folio");
          if (folio) {
            const val = folio.querySelector<HTMLElement>(".folio-tag__val");
            if (val) val.textContent = `HC-${data.folio}`;
          }

          const catEl = document.getElementById("journal-feature-cat");
          if (catEl) {
            catEl.textContent = data.category;
            catEl.setAttribute("data-category", data.category);
          }

          const dateEl = document.getElementById("journal-feature-date");
          if (dateEl) {
            dateEl.textContent = data.date;
            dateEl.setAttribute("datetime", data.rawDate);
          }

          const readTime = document.getElementById("journal-feature-readtime");
          if (readTime) {
            const span = readTime.querySelector("span");
            if (span) span.textContent = `${data.readingMinutes} min read`;
          }

          const newBadge = document.getElementById("journal-feature-new");
          if (newBadge) {
            newBadge.style.display = data.isNew ? "inline-flex" : "none";
          }

          const titleEl = document.getElementById("journal-feature-title");
          if (titleEl) titleEl.textContent = data.title;

          const descEl = document.getElementById("journal-feature-desc");
          if (descEl) descEl.textContent = data.description;

          const tagsEl = document.getElementById("journal-feature-tags");
          if (tagsEl) {
            tagsEl.innerHTML = (data.tags || [])
              .map((t: string) => `<span class="journal-tag">#${t}</span>`)
              .join("");
          }

          card.classList.remove("is-transitioning");
        }, 140);

        if (catName && catName !== "all" && payloads[catName]) {
          if (banner && bannerCat && bannerExplore) {
            banner.hidden = false;
            bannerCat.textContent = catName;
            if (bannerCount) {
              const folder = [...categoryFolders].find((f) => f.dataset.category === catName);
              const countPill = folder?.querySelector(".dossier-category-pill span:last-child");
              bannerCount.textContent = countPill ? `(${countPill.textContent})` : "";
            }
            bannerExplore.href = `/blogs?category=${encodeURIComponent(catName)}`;
            bannerExplore.innerHTML = `Browse All in ${catName} <span aria-hidden="true">→</span>`;
          }
        } else {
          if (banner) banner.hidden = true;
        }

        categoryFolders.forEach((folder) => {
          const isActive = folder.dataset.category === catName;
          folder.classList.toggle("is-active", isActive);
          folder.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
      };

      categoryFolders.forEach((folder) => {
        folder.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          if (target.closest(".journal-category-foot-link")) {
            return;
          }
          e.preventDefault();
          const cat = folder.dataset.category ?? "";
          if (activeFilter === cat) {
            activeFilter = null;
            updatePreview(null);
          } else {
            activeFilter = cat;
            updatePreview(cat);
          }
        });

        folder.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            const target = e.target as HTMLElement;
            if (target.closest(".journal-category-foot-link")) return;
            e.preventDefault();
            folder.click();
          }
        });
      });

      if (bannerReset) {
        bannerReset.addEventListener("click", () => {
          activeFilter = null;
          updatePreview(null);
        });
      }
    };

    initArchiveFeature();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHome);
  } else {
    initHome();
  }
  document.addEventListener("astro:page-load", initHome);
</script>
