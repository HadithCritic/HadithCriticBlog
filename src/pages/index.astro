---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogSlider from '../components/BlogSlider.astro';
---

<BaseLayout title="Home">
    <!-- Hero Section -->
    <header class="hero">
        <div class="particles" id="particleSystem"></div>
        <div class="container hero-layout">
            <div class="hero-text">
                <h1>Unveiling The<br><em>History of Hadith</em></h1>
                <p class="hero-desc">
                    A rigorous examination of traditional Islamic narratives through historical criticism, philosophical
                    analysis, and the Quranic mandate. Questioning isnād-based methodology and mainstream assumptions of
                    authenticity.
                </p>
                <div class="hero-btns">
                    <a href="/blogs" class="btn btn-primary">
                        Read Blogs <i class="fas fa-arrow-right"></i>
                    </a>
                    <a href="https://youtube.com/@HadithCritic" target="_blank" class="btn btn-outline">
                        <i class="fab fa-youtube"></i> YouTube
                    </a>
                </div>
                <div class="hero-strip">
                    <span>50+ Articles</span>
                    <span class="strip-sep">·</span>
                    <span>12 Publications</span>
                    <span class="strip-sep">·</span>
                    <span>10K+ Readers</span>
                </div>
            </div>

            <!-- Isnad Network Visualization -->
            <div class="hero-visual">
                <div class="orbital-rings">
                    <div class="analysis-ring analysis-ring-1"></div>
                    <div class="analysis-ring analysis-ring-2"></div>
                    <div class="analysis-ring analysis-ring-3"></div>
                </div>
                <div class="particle-burst" id="particleBurst"></div>
                <svg class="isnad-canvas" id="isnadCanvas"></svg>
                <div class="isnad-network" id="isnadNetwork">
                    <div class="isnad-bundle left-1">
                        <div class="narrator-node" data-name="Rawī A">R1</div>
                        <div class="narrator-node common-link" data-name="Muḥaddith X" data-common="true">M</div>
                        <div class="narrator-node" data-name="Rawī B">R2</div>
                    </div>
                    <div class="isnad-bundle left-2">
                        <div class="narrator-node" data-name="Rawī C">R3</div>
                        <div class="narrator-node common-link" data-name="Weak Link Y" data-common="true">W</div>
                        <div class="narrator-node" data-name="Rawī D">R4</div>
                    </div>
                    <div class="isnad-bundle right-1">
                        <div class="narrator-node" data-name="Rawī H">R8</div>
                        <div class="narrator-node common-link" data-name="Disputed P" data-common="true">D</div>
                    </div>
                    <div class="isnad-bundle right-2">
                        <div class="narrator-node common-link" data-name="Liar Q" data-common="true">L</div>
                        <div class="narrator-node" data-name="Rawī J">R10</div>
                    </div>
                </div>
                <div class="critic-container">
                    <img src="https://hadithcriticblog.com/wp-content/uploads/2026/02/cropped-HCpfp.jpg"
                        class="hero-image" alt="HadithCritic">
                    <div class="analysis-status">EXTRACTING HISTORICAL REALITY</div>
                </div>
                <div class="extraction-beam" id="beam1"></div>
                <div class="extraction-beam" id="beam2"></div>
            </div>
        </div>
    </header>

    <!-- Blog Slider -->
    <BlogSlider />

    <!-- Academia Section -->
    <section class="academia-preview">
        <div class="container">
            <div class="academia-inner">
                <div class="academia-text">
                    <h2>Academic Monographs<br><em>&amp; Research Papers</em></h2>
                    <p>Formally published critical methodologies, comprehensive refutations, and foundational texts in Islamic studies.</p>
                    <ul class="academia-features">
                        <li>Historical Criticism</li>
                        <li>Quranic Epistemology</li>
                        <li>Methodological Refutations</li>
                    </ul>
                    <a href="/academia" class="btn btn-primary">
                        Explore Publications <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
                <div class="academia-visual">
                    <div class="book-showcase">
                        <div class="book-glow-back"></div>
                        <div class="book-mini">
                            <img src="/images/RefutationKJI_FC.png" alt="The Decisive Refutation book cover" class="book-mini-img">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* ── Hero Text ───────────────────────────────── */
    .hero-text {
        position: relative;
        z-index: 2;
    }

    .hero h1 {
        font-size: clamp(2.25rem, 5.5vw, 4rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.025em;
        color: var(--text-heading);
        margin-bottom: clamp(18px, 3vw, 28px);
        text-transform: none;
    }

    .hero h1 em {
        font-style: italic;
        color: var(--blue-700);
        display: block;
    }

    .hero-desc {
        font-size: clamp(0.95rem, 1.6vw, 1.1rem);
        color: var(--text-body);
        line-height: 1.8;
        margin-bottom: clamp(28px, 4vw, 36px);
        max-width: 52ch;
    }

    .hero-btns {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: clamp(32px, 4vw, 44px);
    }

    .hero-strip {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-dim);
        letter-spacing: 0.06em;
    }

    .strip-sep {
        opacity: 0.3;
    }

    /* ── Academia Section ────────────────────────── */
    .academia-preview {
        padding: clamp(72px, 10vw, 120px) 0;
        background: var(--bg-panel);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .academia-inner {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: clamp(48px, 6vw, 80px);
        align-items: center;
    }

    .academia-text h2 {
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 3.5vw, 2.75rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.025em;
        color: var(--text-heading);
        margin-bottom: 20px;
        text-transform: none;
    }

    .academia-text h2 em {
        font-style: italic;
        color: var(--blue-700);
    }

    .academia-text p {
        color: var(--text-body);
        font-size: 16px;
        line-height: 1.75;
        margin-bottom: 28px;
        max-width: 46ch;
    }

    .academia-features {
        list-style: none;
        padding: 0;
        margin: 0 0 36px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .academia-features li {
        font-family: var(--font-sans);
        font-size: 14px;
        color: var(--text-body);
        padding-left: 18px;
        position: relative;
    }

    .academia-features li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--blue-500);
    }

    .academia-visual {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* ── Book Showcase ───────────────────────────── */
    .book-showcase {
        position: relative;
        perspective: 1200px;
    }

    .book-glow-back {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 180px;
        height: 240px;
        transform: translate(-50%, -50%);
        background: var(--blue-500);
        filter: blur(60px);
        opacity: 0.18;
        border-radius: 50%;
        z-index: 0;
        transition: opacity 0.5s ease;
    }

    .book-showcase:hover .book-glow-back {
        opacity: 0.32;
    }

    .book-mini {
        position: relative;
        z-index: 10;
        transform-style: preserve-3d;
    }

    .book-mini-img {
        width: 220px;
        border-radius: 4px 10px 10px 4px;
        box-shadow: -12px 16px 36px rgba(0, 0, 0, 0.55), inset 2px 0 6px rgba(255, 255, 255, 0.2);
        transform: rotateY(-18deg) rotateX(4deg) rotateZ(2deg);
        transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.6s ease;
    }

    .book-showcase:hover .book-mini-img {
        transform: rotateY(-5deg) rotateX(0deg) rotateZ(0deg) scale(1.04);
        box-shadow: -6px 12px 28px rgba(0, 0, 0, 0.5), inset 2px 0 5px rgba(255, 255, 255, 0.25);
    }

    .badge-mini {
        position: absolute;
        top: -14px;
        right: -20px;
        background: rgba(15, 15, 15, 0.94);
        color: var(--text-body);
        padding: 7px 14px;
        border-radius: 999px;
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 600;
        border: 1px solid var(--border-strong);
        box-shadow: var(--shadow-sm);
        display: flex;
        align-items: center;
        gap: 7px;
        z-index: 20;
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        background: #4ade80;
        border-radius: 50%;
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.6);
        animation: pulseDot 2s infinite;
    }

    @keyframes pulseDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.2); }
    }

    @media (prefers-reduced-motion: reduce) {
        .badge-dot { animation: none; }
        .book-mini-img { transition: none; }
    }

    /* ── Responsive ──────────────────────────────── */
    @media (max-width: 900px) {
        .academia-inner {
            grid-template-columns: 1fr;
            gap: 48px;
            text-align: center;
        }

        .academia-text p {
            max-width: unset;
            margin-left: auto;
            margin-right: auto;
        }

        .academia-features {
            align-items: center;
        }

        .academia-features li {
            padding-left: 0;
        }

        .academia-features li::before {
            display: none;
        }

        .badge-mini {
            right: 50%;
            transform: translateX(50%);
            top: -24px;
        }
    }

    @media (max-width: 640px) {
        .hero h1 {
            font-size: clamp(2rem, 8vw, 2.75rem);
        }
    }
</style>
