---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectoryCard from '../components/DirectoryCard.astro';
import ReportCard from '../components/ReportCard.astro';

const directory = [
  {
    title: 'Blog',
    description: 'Essays, reflections, and critical notes on hadith, history, theology, and textual transmission.',
    label: 'Articles & Essays',
    ctaText: 'Read the Blog',
    href: '/blogs',
    theme: 'parchment',
    icon: 'fa-feather-pointed'
  },
  {
    title: 'Academia',
    description: 'Published papers, formal research, long-form studies, and downloadable academic work.',
    label: 'Formal Research',
    ctaText: 'View Published Work',
    href: '/academia',
    theme: 'charcoal',
    icon: 'fa-scroll'
  },
  {
    title: 'Projects',
    description: 'Large-scale research tools, datasets, databases, and digital humanities work in progress.',
    label: 'Digital Humanities',
    ctaText: 'See Projects',
    href: '/projects',
    theme: 'charcoal',
    icon: 'fa-network-wired'
  },
  {
    title: 'Resources',
    description: 'Bibliographies, source lists, reading guides, corpora, PDFs, and research aids.',
    label: 'Archive',
    ctaText: 'Browse Resources',
    href: '/resources',
    theme: 'charcoal',
    icon: 'fa-book-bookmark'
  },
  {
    title: 'YouTube',
    description: 'Video essays, lectures, breakdowns, and visual explanations.',
    label: 'Video Lectures',
    ctaText: 'Watch Videos',
    href: '/youtube',
    theme: 'parchment',
    icon: 'fa-circle-play'
  },
  {
    title: 'Contact',
    description: 'Questions, corrections, collaboration, or source submissions.',
    label: 'Correspondence',
    ctaText: 'Contact',
    href: '/contact',
    theme: 'charcoal',
    icon: 'fa-envelope-open-text'
  }
];

const featuredReports = [
  {
    title: "On the fasting of the Day of 'Arafah",
    chapter: "Fasting",
    tags: ["'Arafah", "Fasting", "Virtues"],
    grade: "Good",
    gradeLabel: "B+",
    reportId: "1247",
    href: "#"
  },
  {
    title: "The command to kill dogs in Medina",
    chapter: "Animals & Purity",
    tags: ["Dogs", "Medina", "Legal History"],
    grade: "Weak",
    gradeLabel: "C-",
    reportId: "842",
    href: "#"
  }
];

const blogPosts = [
  {
    title: "The Quranic Epistemology of Verification (Q. 49:6)",
    category: "Philosophy",
    excerpt: "Before determining if a report is true, we must establish the standard of evidence required by the Quran itself.",
    date: "Mar 3, 2026",
    readTime: "12 min read"
  },
  {
    title: "Most Popular Hadith Website Caught Manipulating Hadith",
    category: "Transmission",
    excerpt: "An investigation into how modern translations subtly alter the meaning of classical Arabic texts to fit contemporary theology.",
    date: "Feb 5, 2026",
    readTime: "8 min read"
  },
  {
    title: "More on: The Fabricated 'Baghdad' Hadith Prophecy",
    category: "Prophecies",
    excerpt: "Tracing the political utility of apocalyptic narratives during the Abbasid revolution.",
    date: "Nov 6, 2025",
    readTime: "15 min read"
  }
];
---

<BaseLayout
  title="HadithCritic | Verification Over Reputation"
>
  <!-- Section 1: Hero -->
  <section class="section hc-hero">
    <div class="wrap hero-grid">
      <div class="hero-content">
        <h1 class="hero-title">Better narrations through better questions.</h1>
        <p class="hero-subtitle">
          HadithCritic studies transmission, text, factional context, and source history so reports can be weighed with rigor and clarity.
        </p>
        <div class="hero-actions">
          <a href="/reports" class="btn btn-primary">Explore Reports</a>
          <a href="/methodology" class="btn">Read the Method</a>
        </div>
      </div>
      <div class="hero-illustration">
        <!-- Placeholder for generated illustration -->
        <div class="illustration-placeholder">
          <span class="hc-label">Illustration: Council of Muḥaddithūn</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Directory -->
  <section class="section hc-directory">
    <div class="wrap">
      <div class="directory-grid">
        {directory.map(item => (
          <DirectoryCard {...item as any} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Featured Reports -->
  <section class="section hc-reports">
    <div class="wrap">
      <header class="section-header">
        <span class="hc-label">Featured Reports</span>
        <h2 class="section-title">A report is not a verdict dropped from nowhere.</h2>
        <p class="section-desc">It is a traceable argument: chain, text, context, parallels, and judgment.</p>
      </header>

      <div class="reports-grid">
        <div class="reports-list">
          {featuredReports.map(report => (
            <ReportCard {...report} />
          ))}
        </div>
        
        <div class="reports-context hc-context-note">
          <div class="context-inner">
            <span class="hc-label"><i class="fa-solid fa-circle-exclamation"></i> Context Note</span>
            <p>Reports are frequently transmitted within factional contexts. When transmitters are known for partisanship, structural reliance on their solitary claims requires elevated scrutiny.</p>
            <div class="context-meter">
              <span class="meter-label">Judgment impact: Moderate</span>
              <div class="meter-bar"><div class="meter-fill" style="width: 50%"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Method -->
  <section class="section hc-method">
    <div class="wrap">
      <header class="section-header text-center">
        <h2 class="section-title text-gold">Method before opinion.</h2>
      </header>
      
      <div class="method-grid">
        <div class="method-pillar">
          <div class="pillar-icon"><i class="fa-solid fa-scale-balanced"></i></div>
          <h3>Rigor</h3>
          <p>Reports are read through chains, transmitters, variants, and source history.</p>
        </div>
        <div class="method-pillar">
          <div class="pillar-icon"><i class="fa-solid fa-eye"></i></div>
          <h3>Fairness</h3>
          <p>Claims are judged carefully, without sectarian convenience or inherited reputation.</p>
        </div>
        <div class="method-pillar">
          <div class="pillar-icon"><i class="fa-solid fa-book-open"></i></div>
          <h3>Transparency</h3>
          <p>Sources, parallels, and reasoning should be visible to the reader.</p>
        </div>
        <div class="method-pillar">
          <div class="pillar-icon"><i class="fa-solid fa-landmark"></i></div>
          <h3>Context</h3>
          <p>Factional, political, and doctrinal settings matter when reports emerge from contested history.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap"><div class="ornamental-divider"></div></div>

  <!-- Section 5: Academia -->
  <section class="section hc-academia">
    <div class="wrap academia-grid">
      <div class="academia-content">
        <span class="hc-label">Published Works</span>
        <h2 class="section-title">Formal papers, long-form studies, and research essays.</h2>
      </div>
      <div class="academia-list">
        <div class="citation-card hc-card--parchment">
          <span class="citation-number">1</span>
          <div class="citation-body">
            <h3>The Problem of Factional Transmission in Early Kufa</h3>
            <p class="citation-meta">Working Paper • 2025</p>
            <a href="#" class="citation-link">Download PDF <i class="fa-solid fa-download"></i></a>
          </div>
        </div>
        <div class="citation-card hc-card--parchment">
          <span class="citation-number">2</span>
          <div class="citation-body">
            <h3>Structural Weaknesses in Apocalyptic Narratives</h3>
            <p class="citation-meta">Journal Article • 2024</p>
            <a href="#" class="citation-link">Read Online <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Projects -->
  <section class="section hc-projects">
    <div class="wrap">
      <header class="section-header">
        <span class="hc-label">Digital Humanities</span>
        <h2 class="section-title">Large-scale projects</h2>
      </header>
      
      <div class="projects-grid">
        <div class="project-card hc-card">
          <span class="status-chip chip-gold">Coming Soon</span>
          <h3>Hadith Database</h3>
          <p>A searchable database for reports, chains, variants, transmitters, and source comparison.</p>
        </div>
        <div class="project-card hc-card">
          <span class="status-chip chip-ash">Research Phase</span>
          <h3>Corpus Mapping</h3>
          <p>Digital tools for tracing reports across early Sunni and Shīʿī collections.</p>
        </div>
        <div class="project-card hc-card">
          <span class="status-chip chip-ash">In Development</span>
          <h3>Common-Link Studies</h3>
          <p>Visual studies of transmission clusters, narrator pathways, and textual growth.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 7: Quote Banner -->
  <section class="section hc-quote-banner">
    <div class="wrap">
      <div class="quote-container">
        <!-- Background illustration would go here via CSS -->
        <div class="quote-overlay">
          <h2>Truth is sought through evidence and transmission.</h2>
          <p>— Imam al-Dhahabī</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 8: Latest Blog -->
  <section class="section hc-latest-blog">
    <div class="wrap">
      <header class="section-header">
        <span class="hc-label">Editorial Notes</span>
        <h2 class="section-title">Latest Writing</h2>
      </header>

      <div class="blog-grid">
        {blogPosts.map(post => (
          <a href="#" class="blog-card hc-card">
            <div class="blog-meta-top">
              <span class="hc-label">{post.category}</span>
            </div>
            <h3 class="blog-title">{post.title}</h3>
            <p class="blog-excerpt">{post.excerpt}</p>
            <div class="blog-meta-bottom">
              <span class="blog-date">{post.date}</span>
              <span class="blog-read-time">{post.readTime}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Base Section Styles */
  .section-header {
    margin-bottom: 3rem;
  }
  
  .text-center {
    text-align: center;
  }

  .text-gold {
    color: var(--hc-gold);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    color: var(--hc-parchment);
    line-height: 1.1;
    margin: 0.5rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: 1.2rem;
    color: var(--hc-ash);
    max-width: 60ch;
  }

  /* Hero */
  .hc-hero {
    padding-top: clamp(4rem, 8vw, 8rem);
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 6vw, 5.5rem);
    font-weight: 500;
    line-height: 1.05;
    color: var(--hc-parchment);
    margin: 0 0 1.5rem;
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--hc-ash);
    line-height: 1.6;
    margin: 0 0 2.5rem;
    max-width: 48ch;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  .illustration-placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    border: 1px solid var(--hc-rule);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(216, 177, 102, 0.05);
    border-radius: var(--radius-sm);
  }

  /* Directory */
  .directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  /* Reports */
  .reports-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
  }

  .reports-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .context-inner {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .context-inner p {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 1.5rem 0;
    flex-grow: 1;
  }

  .context-meter {
    margin-top: auto;
  }

  .meter-label {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .meter-bar {
    width: 100%;
    height: 4px;
    background: rgba(242, 235, 220, 0.2);
    border-radius: 2px;
    overflow: hidden;
  }

  .meter-fill {
    height: 100%;
    background: var(--hc-parchment);
  }

  /* Method */
  .method-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: 4rem;
  }

  .method-pillar {
    text-align: center;
  }

  .pillar-icon {
    font-size: 2rem;
    color: var(--hc-gold);
    margin-bottom: 1.5rem;
  }

  .method-pillar h3 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--hc-parchment);
    margin: 0 0 1rem;
  }

  .method-pillar p {
    color: var(--hc-ash);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Academia */
  .academia-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: center;
  }

  .academia-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .citation-card {
    display: flex;
    padding: 2rem;
    gap: 1.5rem;
  }

  .citation-number {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--hc-umber);
    line-height: 1;
  }

  .citation-body h3 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .citation-meta {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--hc-charcoal-2);
    margin: 0 0 1.5rem;
  }

  .citation-link {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hc-umber-dark);
    text-decoration: none;
  }

  /* Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .project-card {
    padding: 2rem;
  }

  .status-chip {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: var(--radius-pill);
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .chip-gold {
    background: rgba(216, 177, 102, 0.15);
    color: var(--hc-gold);
    border: 1px solid rgba(216, 177, 102, 0.3);
  }

  .chip-ash {
    background: rgba(140, 138, 134, 0.1);
    color: var(--hc-ash);
    border: 1px solid rgba(140, 138, 134, 0.2);
  }

  .project-card h3 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--hc-parchment);
    margin: 0 0 1rem;
  }

  .project-card p {
    color: var(--hc-ash);
    line-height: 1.6;
    margin: 0;
  }

  /* Quote Banner */
  .quote-container {
    background: var(--hc-black-soft);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    min-height: 400px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .quote-overlay {
    text-align: center;
    position: relative;
    z-index: 2;
    padding: 3rem;
  }

  .quote-overlay h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: var(--hc-gold);
    max-width: 25ch;
    margin: 0 auto 1.5rem;
    line-height: 1.2;
    font-style: italic;
  }

  .quote-overlay p {
    font-family: var(--font-ui);
    color: var(--hc-ash);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
  }

  /* Blog */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .blog-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    border-color: var(--hc-gold-dim);
  }

  .blog-meta-top {
    margin-bottom: 1.5rem;
  }

  .blog-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--hc-parchment);
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .blog-excerpt {
    color: var(--hc-ash);
    line-height: 1.6;
    margin: 0 0 2rem;
    flex-grow: 1;
  }

  .blog-meta-bottom {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--hc-muted);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  @media (max-width: 1024px) {
    .hero-grid, .reports-grid, .academia-grid {
      grid-template-columns: 1fr;
    }
    
    .method-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .projects-grid, .blog-grid {
      grid-template-columns: 1fr;
    }
    
    .method-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
