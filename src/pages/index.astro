---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { isNewPost } from "../lib/new-badge";
import { categoryByName, categorySlug } from "../lib/categories";
import { CORPUS_META } from "../lib/corpus-config";
import { blogArtwork } from "../data/blog-artwork";
import { academicStudies } from "../data/academic-studies";
import qiraatIndex from "../data/qiraat/index.json";
import researchGraph from "../data/research-graph.json";
import names from "../data/quran-sura-names.json";
import "../styles/home.css";

const GENERIC_THUMB = "/images/blog_thumbnails/tn.generic.webp";
const LEDGER_SIZE = 5;

const allPosts = await getCollection(
  "articles",
  ({ data }) => (import.meta.env.DEV || !data.draft) && !data.preview,
);
const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
type Post = (typeof posts)[number];

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}

const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({
    name,
    count,
    href: categoryByName(name) ? `/blogs/category/${categorySlug(name)}/` : "/blogs/",
    /* One line per branch; the hubs carry the long blurbs. */
    description: categoryByName(name)?.summary ?? "",
    /* The featured study already leads the section, so each branch previews
       its most recent other study. */
    latest: posts.find((post) => post !== posts[0] && post.data.category === name) ?? null,
  }));

/* The featured study leads the archive, so the contents list starts after it. */
const ledgerPosts = posts.slice(1);
const ledgerCount = (name: string) => ledgerPosts.filter((post) => post.data.category === name).length;

const featured = posts[0];
const featuredArt = blogArtwork[featured.id];
const featuredSrc = featuredArt?.src ?? featured.data.thumbnail ?? GENERIC_THUMB;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const folioOf = (post: Post) => String(posts.length - posts.indexOf(post)).padStart(3, "0");
const readingMinutes = (post: Post) => {
  const words = (post.body || "").replace(/<[^>]*>/g, "").trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
};
const thumbOf = (post: Post) => blogArtwork[post.id]?.thumbnail ?? post.data.thumbnail ?? GENERIC_THUMB;

const videos = [
  { id: "HWHjCfaPn_0", thumb: "https://i.ytimg.com/vi/HWHjCfaPn_0/maxresdefault.jpg" },
  { id: "6bpJBji3E0M", thumb: "https://i.ytimg.com/vi/6bpJBji3E0M/maxresdefault.jpg" },
  { id: "3B0rnPGWgKU", thumb: "https://i.ytimg.com/vi/3B0rnPGWgKU/maxresdefault.jpg" },
  { id: "CG5i14GAZTQ", thumb: "https://i.ytimg.com/vi/CG5i14GAZTQ/maxresdefault.jpg" },
  { id: "boG5JTD5yXU", thumb: "https://i.ytimg.com/vi/boG5JTD5yXU/maxresdefault.jpg" },
  { id: "MLaRB6uGhAk", thumb: "/images/yt tn/yt-MLaRB6uGhAk.webp" },
];

/* Every figure below is read from the data each project is built from. */
const n = (value: number) => value.toLocaleString("en-US");
const icmaCount = academicStudies.filter((study) => study.category === "icma").length;
const totalVerses = names.reduce((sum, sura) => sum + sura.verses, 0);

const databases = [
  {
    href: "/hadith/",
    art: "corpus",
    kind: "Textual corpus",
    arabic: "الحديث",
    title: "Hadith Corpus",
    desc: "Narrations in facing Arabic and English, searchable across every compilation, with each chain linked to its transmitters.",
    figures: [`${n(CORPUS_META.counts.hadith)} narrations`, `${CORPUS_META.counts.collections} collections`],
    action: "Search the corpus",
  },
  {
    href: "/narrators/",
    art: "rijal",
    kind: "Biographical register",
    arabic: "الرجال",
    title: "Rijāl Register",
    desc: "Classical transmitters with dates, teachers and students, and every critic’s statement attributed to its author.",
    figures: [`${n(CORPUS_META.counts.narrators)} transmitters`, `${n(CORPUS_META.counts.criticismStatements)} statements`],
    action: "Browse the register",
  },
  {
    href: "/projects/quran/",
    art: "qiraat",
    kind: "Variant readings",
    arabic: "القراءات",
    title: "The Qirāʾāt Variants",
    desc: "The ten readings set side by side, word by word, with the classical books that report each one.",
    figures: ["10 readers", `${qiraatIndex.suras_with_data} of 114 suras`],
    action: "Compare the readings",
  },
  {
    href: "/projects/tafsir/",
    art: "tafsir",
    kind: "Verse-first reader",
    arabic: "التفسير",
    title: "Tafsir Reader",
    desc: "A reading framework built around the verse as its stable unit, organized sura by sura.",
    figures: ["114 suras", `${n(totalVerses)} verses`],
    action: "Open the reader",
  },
];

const research = [
  {
    href: "/projects/islamic-studies-atlas/",
    art: "atlas",
    kind: "Research network",
    arabic: "الدراسات",
    title: "Islamic Studies Atlas",
    desc: "Modern scholarship on ḥadīth criticism, with the citations between works traced one study at a time.",
    figures: [`${researchGraph.works.length} works`, `${researchGraph.scholars.length} scholars`],
    action: "Explore the atlas",
  },
  {
    href: "/projects/academic-studies/",
    art: "icma",
    kind: "Isnād-cum-matn studies",
    arabic: "الإسناد والمتن",
    title: "The ICMA Register",
    desc: "Studies that trace a tradition to its common link and date it, grouped by research family.",
    figures: [`${icmaCount} studies`, "Common link and dating on every entry"],
    action: "Browse the register",
  },
];
---

<BaseLayout title="HadithCritic | Verification Over Reputation">
  <div class="home hc-plate">
    <section class="home-hero" aria-labelledby="home-title">
      <img
        class="home-hero__art"
        src="/images/platform/home.webp"
        srcset="/images/platform/home-1086.webp 1086w, /images/platform/home.webp 2172w"
        sizes="(max-width: 640px) 100vw, 72vw"
        width="2172"
        height="724"
        alt=""
        fetchpriority="high"
      />
      <div class="hc-container home-hero__inner">
        <h1 id="home-title" class="home-hero__title">
          Tracing the origins of{" "}
          <span class="home-hero__accent">early traditions.</span>
        </h1>
        <span class="hc-ornament home-hero__ornament" aria-hidden="true"></span>
        <p class="home-hero__lede">
          Textual criticism, transmission forensics, and source verification:
          recovering early Islamic history through rigorous evidentiary research.
        </p>
        <div class="home-hero__actions">
          <a href="/blogs/" class="hc-btn">Browse the archive <span aria-hidden="true">→</span></a>
          <a href="/academia/" class="hc-btn hc-btn--ghost">Read the research</a>
        </div>
      </div>
    </section>

    <section class="home-archive" aria-labelledby="archive-title">
      <div class="hc-container">
        <header class="home-head">
          <div class="home-head__main">
            <h2 id="archive-title" class="home-head__title">From the <span>archive</span></h2>
            <p class="home-head__note">
              Essays and research notes on transmission, prophecy reports, Quranic
              authority, epistemology, and scriptural history.
            </p>
          </div>
          <a href="/blogs/" class="home-head__link">
            Browse all {posts.length} entries <span aria-hidden="true">→</span>
          </a>
        </header>

        <article class="home-feature hc-parchment" data-category={featured.data.category}>
          <div class="home-feature__copy">
            <p class="home-feature__meta">
              <span class="home-feature__label">Latest investigation</span>
              <span class="home-cat" data-category={featured.data.category}>{featured.data.category}</span>
              <time datetime={isoDate(featured.data.date)}>{formatDate(featured.data.date)}</time>
              <span>{readingMinutes(featured)} min read</span>
              {isNewPost(featured.data.date) && <span class="home-new">New</span>}
            </p>
            <h3 class="home-feature__title">
              <a href={`/blogs/${featured.id}/`} class="home-feature__link">{featured.data.title}</a>
            </h3>
            {featured.data.description && <p class="home-feature__desc">{featured.data.description}</p>}
            <p class="home-feature__foot">
              <span class="home-feature__folio">Folio {folioOf(featured)}</span>
              <span class="home-feature__cta" aria-hidden="true">Read the investigation <span>→</span></span>
            </p>
          </div>
          <figure class="home-feature__plate">
            <img
              src={featuredSrc}
              srcset={featuredArt?.srcset}
              sizes="(max-width: 800px) 100vw, 40vw"
              width={featuredArt?.width ?? 1536}
              height={featuredArt?.height ?? 1024}
              alt={featuredArt?.alt ?? ""}
              loading="eager"
              decoding="async"
            />
          </figure>
        </article>

        <nav class="home-branches" aria-label="Research branches">
          <ul>
            {categories.map((category) => (
              <li class="home-branch" data-category={category.name}>
                <p class="home-branch__head">
                  <a href={category.href} class="home-branch__name">{category.name}</a>
                  <span class="home-branch__count">{category.count} {category.count === 1 ? "study" : "studies"}</span>
                </p>
                <p class="home-branch__desc">{category.description}</p>
                {category.latest && (
                  <p class="home-branch__latest">
                    <span class="home-branch__latest-label">Recent</span>{" "}
                    <a href={`/blogs/${category.latest.id}/`}>{category.latest.data.title}</a>
                  </p>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </section>

    <section class="home-contents" aria-labelledby="contents-title">
      <div class="hc-container home-contents__grid">
        <header class="home-contents__head">
          <h2 id="contents-title" class="home-head__title">Latest studies <span>&amp;</span> analysis</h2>
          <p class="home-head__note">Recent critical investigations into transmission chains and early texts.</p>

          <!-- Filtering is a script enhancement; without it the branch links above
               lead to each category's full index. -->
          <div class="home-ledger-filters" role="group" aria-label="Filter latest studies by category" hidden>
            <button type="button" class="home-filter-tab is-active" data-home-filter="all" aria-pressed="true">
              <span class="home-filter-tab__name">All branches</span>
              <span class="home-filter-tab__n">{ledgerPosts.length}</span>
            </button>
            {categories.map((category) => (
              <button
                type="button"
                class="home-filter-tab"
                data-home-filter={category.name}
                data-category={category.name}
                data-href={category.href}
                aria-pressed="false"
              >
                <span class="home-filter-tab__name">{category.name}</span>
                <span class="home-filter-tab__n">{ledgerCount(category.name)}</span>
              </button>
            ))}
          </div>

          <p class="home-contents__status">
            <span id="home-ledger-count-label">Showing {Math.min(LEDGER_SIZE, ledgerPosts.length)} of {ledgerPosts.length} earlier studies</span>
            <a href="/blogs/" id="home-ledger-cta" class="home-head__link">Open the full archive <span aria-hidden="true">→</span></a>
          </p>
        </header>

        <ol class="home-ledger" id="home-ledger">
          {ledgerPosts.map((post, index) => (
            <li class="home-ledger-row" data-category={post.data.category} hidden={index >= LEDGER_SIZE}>
              <article class="home-entry">
                <p class="home-entry__folio" aria-hidden="true">
                  <span>No.</span>
                  <span class="home-entry__num">{folioOf(post)}</span>
                </p>
                <div class="home-entry__body">
                  <p class="home-entry__cat">
                    <span class="home-cat" data-category={post.data.category}>{post.data.category}</span>
                    {isNewPost(post.data.date) && <span class="home-new">New</span>}
                  </p>
                  <h3 class="home-entry__title">
                    <a href={`/blogs/${post.id}/`} class="home-entry__link">{post.data.title}</a>
                  </h3>
                  {post.data.description && <p class="home-entry__desc">{post.data.description}</p>}
                  <p class="home-entry__meta">
                    <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                    <span>{readingMinutes(post)} min read</span>
                    <span class="sr-only">Folio {folioOf(post)}</span>
                  </p>
                </div>
                <div class="home-entry__aside">
                  <img src={thumbOf(post)} alt="" width="160" height="160" loading="lazy" decoding="async" />
                  <span class="home-entry__go" aria-hidden="true">Read <span>→</span></span>
                </div>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="home-lectures" aria-labelledby="lectures-title">
      <div class="hc-container">
        <header class="home-head">
          <div class="home-head__main">
            <h2 id="lectures-title" class="home-head__title">Lectures in <span>video</span></h2>
            <p class="home-head__note">Deep dives into transmission history and source criticism, in visual form.</p>
          </div>
          <a href="/youtube/" class="home-head__link">Visit the channel <span aria-hidden="true">→</span></a>
        </header>

        <div class="youtube-grid">
          {videos.map((vid, index) => (
            <a
              href={`https://www.youtube.com/watch?v=${vid.id}`}
              class:list={["yt-lite", index === 0 && "yt-lite--lead"]}
              data-video-id={vid.id}
              aria-label="Play video lecture"
            >
              <img src={vid.thumb} alt="" width="800" height="450" loading="lazy" decoding="async" />
              <span class="yt-play" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-projects" aria-labelledby="projects-title">
      <div class="hc-container">
        <header class="home-head">
          <div class="home-head__main">
            <h2 id="projects-title" class="home-head__title">Large-scale <span>projects</span></h2>
            <p class="home-head__note">
              Research infrastructure for source criticism, transmission analysis, and manuscript verification.
            </p>
          </div>
          <a href="/projects/" class="home-head__link">See all projects <span aria-hidden="true">→</span></a>
        </header>

        <div class="home-suite">
          <h3 class="home-suite__label">Databases <span>Reference instruments, read in your browser</span></h3>
          <ul class="home-suite__grid home-suite__grid--databases">
            {databases.map((project) => (
              <li>
                <a href={project.href} class={`home-project home-project--${project.art}`}>
                  <img class="home-project__art" src={`/images/platform/${project.art}-1086.webp`} alt="" width="1086" height="362" loading="lazy" decoding="async" />
                  <span class="home-project__kind">
                    {project.kind}
                    <span class="home-project__ar" lang="ar" dir="rtl">{project.arabic}</span>
                  </span>
                  <span class="home-project__title">{project.title}</span>
                  <span class="home-project__desc">{project.desc}</span>
                  <span class="home-project__figures">
                    {project.figures.map((figure) => <span>{figure}</span>)}
                  </span>
                  <span class="home-project__action">{project.action} <span aria-hidden="true">→</span></span>
                </a>
              </li>
            ))}
          </ul>

          <h3 class="home-suite__label">Research <span>Maps and registers of the scholarship</span></h3>
          <ul class="home-suite__grid home-suite__grid--research">
            {research.map((project) => (
              <li>
                <a href={project.href} class={`home-project home-project--wide home-project--${project.art}`}>
                  <img class="home-project__art" src={`/images/platform/${project.art}-1086.webp`} alt="" width="1086" height="362" loading="lazy" decoding="async" />
                  <span class="home-project__kind">
                    {project.kind}
                    <span class="home-project__ar" lang="ar" dir="rtl">{project.arabic}</span>
                  </span>
                  <span class="home-project__title">{project.title}</span>
                  <span class="home-project__desc">{project.desc}</span>
                  <span class="home-project__figures">
                    {project.figures.map((figure) => <span>{figure}</span>)}
                  </span>
                  <span class="home-project__action">{project.action} <span aria-hidden="true">→</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="home-closing" aria-labelledby="closing-title">
      <div class="hc-container">
        <div class="closing-banner hc-parchment">
          <figure class="closing-banner__plate">
            <img src="/images/editorial/contact-hero-1086.webp" alt="" width="1086" height="362" loading="lazy" decoding="async" />
          </figure>
          <div class="closing-banner__copy">
            <h2 id="closing-title" class="closing-banner__title">
              Truth is sought through evidence and transmitted with integrity.
            </h2>
            <p class="closing-banner__lead">
              Questions, corrections, collaboration, and source submissions are welcome.
            </p>
          </div>
          <a href="/contact/" class="closing-banner__action">Write to HadithCritic <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initHome() {
    /* Lite YouTube player. Each tile is a real link to the video; with script
       it is swapped for the privacy-enhanced embed in place. */
    for (const link of document.querySelectorAll<HTMLAnchorElement>("a.yt-lite")) {
      if (link.dataset.ready) continue;
      link.dataset.ready = "1";
      link.addEventListener("click", (event) => {
        const id = link.dataset.videoId;
        if (!id || event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        const frame = document.createElement("div");
        frame.className = link.className;
        frame.dataset.videoId = id;
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
        iframe.title = "YouTube video player";
        iframe.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        frame.appendChild(iframe);
        link.replaceWith(frame);
        iframe.focus();
      });
    }

    /* Contents filter. The group ships hidden and is revealed here, so a reader
       without script never meets a control that does nothing. */
    const group = document.querySelector<HTMLElement>(".home-ledger-filters");
    if (!group || group.dataset.ready) return;
    group.dataset.ready = "1";
    group.hidden = false;

    const tabs = [...group.querySelectorAll<HTMLButtonElement>(".home-filter-tab")];
    const rows = [...document.querySelectorAll<HTMLLIElement>(".home-ledger-row")];
    const label = document.getElementById("home-ledger-count-label");
    const cta = document.getElementById("home-ledger-cta") as HTMLAnchorElement | null;
    const SIZE = 5;

    const apply = (tab: HTMLButtonElement) => {
      const filter = tab.dataset.homeFilter ?? "all";
      let shown = 0;
      let total = 0;
      for (const row of rows) {
        const matches = filter === "all" || row.dataset.category === filter;
        if (matches) total += 1;
        row.hidden = !(matches && shown < SIZE);
        if (!row.hidden) shown += 1;
      }
      for (const other of tabs) {
        const active = other === tab;
        other.classList.toggle("is-active", active);
        other.setAttribute("aria-pressed", String(active));
      }
      if (label) {
        label.textContent = filter === "all"
          ? `Showing ${shown} of ${total} earlier studies`
          : `Showing ${shown} of ${total} in ${filter}`;
      }
      if (cta) {
        cta.href = tab.dataset.href ?? "/blogs/";
        cta.firstChild!.textContent = filter === "all" ? "Open the full archive " : `All of ${filter} `;
      }
    };

    for (const tab of tabs) tab.addEventListener("click", () => apply(tab));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHome);
  } else {
    initHome();
  }
  document.addEventListener("astro:page-load", initHome);
</script>
