---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectoryCard from '../components/DirectoryCard.astro';
import ReportCard from '../components/ReportCard.astro';

const directory = [
  {
    title: 'Blog',
    description: 'Essays, reflections, and critical notes on hadith, history, theology, and textual transmission.',
    label: 'Articles & Essays',
    href: '/blogs',
    theme: 'parchment',
    imgSrc: '/assets/illustrations/scholar-writing-strip.png'
  },
  {
    title: 'Academia',
    description: 'Published papers, formal research, long-form studies, and downloadable academic work.',
    label: 'Formal Research',
    href: '/academia',
    theme: 'charcoal',
    imgSrc: '/assets/illustrations/manuscript-review-strip.png'
  },
  {
    title: 'Projects',
    description: 'Large-scale research tools, datasets, databases, and digital humanities work in progress.',
    label: 'Digital Humanities',
    href: '/projects',
    theme: 'charcoal',
    imgSrc: '/assets/illustrations/transmission-map-strip.png'
  },
  {
    title: 'Resources',
    description: 'Bibliographies, source lists, reading guides, corpora, PDFs, and research aids.',
    label: 'Archive',
    href: '/resources',
    theme: 'charcoal',
    imgSrc: '/assets/illustrations/archive-shelves-strip.png'
  },
  {
    title: 'YouTube',
    description: 'Video essays, lectures, breakdowns, and visual explanations.',
    label: 'Video Lectures',
    href: '/youtube',
    theme: 'parchment',
    imgSrc: '/assets/illustrations/lecture-circle-strip.png'
  },
  {
    title: 'Contact',
    description: 'Questions, corrections, collaboration, or source submissions.',
    label: 'Correspondence',
    href: '/contact',
    theme: 'charcoal',
    imgSrc: '/assets/illustrations/letter-seal-strip.png'
  }
];

const featuredReports = [
  {
    title: "On the fasting of the Day of 'Arafah",
    chapter: "Fasting",
    tags: ["'Arafah", "Fasting", "Virtues"],
    grade: "Good",
    gradeLabel: "B+",
    reportId: "1247",
    href: "#"
  },
  {
    title: "The command to kill dogs in Medina",
    chapter: "Animals & Purity",
    tags: ["Dogs", "Medina", "Legal History"],
    grade: "Weak",
    gradeLabel: "C-",
    reportId: "842",
    href: "#"
  }
];

const blogPosts = [
  {
    title: "The Quranic Epistemology of Verification (Q. 49:6)",
    category: "Philosophy",
    excerpt: "Before determining if a report is true, we must establish the standard of evidence required by the Quran itself.",
    date: "Mar 3, 2026",
    readTime: "12 min read"
  },
  {
    title: "Most Popular Hadith Website Caught Manipulating Hadith",
    category: "Transmission",
    excerpt: "An investigation into how modern translations subtly alter the meaning of classical Arabic texts to fit contemporary theology.",
    date: "Feb 5, 2026",
    readTime: "8 min read"
  },
  {
    title: "More on: The Fabricated 'Baghdad' Hadith Prophecy",
    category: "Prophecies",
    excerpt: "Tracing the political utility of apocalyptic narratives during the Abbasid revolution.",
    date: "Nov 6, 2025",
    readTime: "15 min read"
  }
];
---

<BaseLayout
  title="HadithCritic | Verification Over Reputation"
>
  <!-- Section 1: Hero -->
  <section class="hero-section" style="background-color: var(--hc-black); background-image: linear-gradient(90deg, #0f0f10 20%, rgba(15,15,16,0.3) 50%, transparent 80%), url('/images/asset1.png'); background-size: auto 95%; background-position: right bottom; background-repeat: no-repeat; border-bottom: 1px solid var(--hc-rule);">
    <div class="hc-container">
      <div class="hero-content">
        <span class="hc-eyebrow" style="display:block; margin-bottom: 1rem;">Quran-centered criticism</span>
        <h1 class="hc-title hc-title--xl">Better narrations<br />through better questions.</h1>
        <div class="hc-divider" style="max-width: 320px; margin: 2.5rem 0 1.5rem;"></div>
        <p class="hc-copy hero-subtitle">
          Textual criticism, transmission analysis, and source verification—so the truth is sought through evidence and transmitted with integrity.
        </p>
        <div class="hero-actions">
          <a href="/reports" class="hc-btn">Explore Reports</a>
          <a href="/methodology" class="hc-btn hc-btn--ghost">Learn Our Method</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Featured Reports (Apparatus Strip) -->
  <section class="hc-section hc-section--tight featured-reports">
    <div class="hc-container">
      <header class="hc-section-head">
        <span class="hc-label">Featured Reports</span>
        <h2 class="hc-title hc-title--md">A report is not a verdict dropped from nowhere.</h2>
        <p class="hc-copy">It is a traceable argument: chain, text, context, parallels, and judgment.</p>
      </header>

      <div class="featured-reports-shell">
        <div class="featured-report-grid">
          
          <!-- Card 1: Featured Report -->
          <div style="display: flex;">
            <ReportCard 
              title="On the fasting of the Day of 'Arafah"
              chapter="Fasting"
              tags={["'Arafah", "Fasting", "Virtues"]}
              grade="Good"
              gradeLabel="B+"
              reportId="1247"
              href="#"
            />
          </div>
          
          <!-- Card 2: Context Note -->
          <div class="hc-context-note">
            <div class="context-inner">
              <span class="hc-eyebrow" style="margin-bottom: 1rem; display: block; color: var(--hc-parchment);">Weak / Factional Context Note</span>
              <span class="hc-label" style="display: flex; align-items: center; gap: 0.5rem; color: var(--hc-parchment);"><i class="fa-solid fa-circle-exclamation"></i> Context Note</span>
              <p class="hc-copy" style="color: var(--hc-parchment); margin: 0.8rem 0;">This narration is reported within a factional context. Some transmitters were known for partisanship, which may affect their reliability.</p>
              <div class="context-meter" style="margin-top: 1rem;">
                <span class="hc-label meter-label" style="color: var(--hc-parchment); margin-bottom: 0.5rem;">Judgment impact: Moderate</span>
                <div class="meter-bar" style="background: rgba(242, 235, 220, 0.2);"><div class="meter-fill" style="width: 50%; background: var(--hc-parchment);"></div></div>
              </div>
            </div>
          </div>

          <!-- Card 3: Apparatus -->
          <div class="hc-apparatus" style="display: flex; flex-direction: column;">
            <span class="hc-eyebrow" style="margin-bottom: 1.5rem; display: block;">Apparatus / Transmission Overview</span>
            
            <div class="hc-apparatus-row" style="border-bottom: 1px solid var(--hc-rule-soft); padding-bottom: 0.5rem; margin-bottom: 0.5rem;">
              <span class="hc-small" style="color: var(--hc-gold); width: 24px;">1</span>
              <span class="hc-copy" style="flex: 1; font-size: 0.95rem;">Mālik b. Anas</span>
              <span class="hc-chip" style="font-size: 0.7rem; min-height: 24px;">Thiqah</span>
            </div>
            <div class="hc-apparatus-row" style="border-bottom: 1px solid var(--hc-rule-soft); padding-bottom: 0.5rem; margin-bottom: 0.5rem;">
              <span class="hc-small" style="color: var(--hc-gold); width: 24px;">2</span>
              <span class="hc-copy" style="flex: 1; font-size: 0.95rem;">Nāfiʿ</span>
              <span class="hc-chip" style="font-size: 0.7rem; min-height: 24px;">Thiqah</span>
            </div>
            <div class="hc-apparatus-row" style="border-bottom: 1px solid var(--hc-rule-soft); padding-bottom: 0.5rem; margin-bottom: 0.5rem;">
              <span class="hc-small" style="color: var(--hc-gold); width: 24px;">3</span>
              <span class="hc-copy" style="flex: 1; font-size: 0.95rem;">Ibn ʿUmar</span>
              <span class="hc-chip" style="font-size: 0.7rem; min-height: 24px;">Thiqah</span>
            </div>
            <div class="hc-apparatus-row">
              <span class="hc-small" style="color: var(--hc-gold); width: 24px;">4</span>
              <span class="hc-copy" style="flex: 1; font-size: 0.95rem;">The Prophet</span>
            </div>
            
            <div style="display: flex; justify-content: space-between; margin-top: auto; padding-top: 1.5rem;">
              <div>
                <span class="hc-eyebrow" style="display: block;">Isnad Type</span>
                <span class="hc-copy" style="font-size: 0.9rem;">Muttaṣil</span>
              </div>
              <div style="text-align: right;">
                <span class="hc-eyebrow" style="display: block;">Grade (Prelim.)</span>
                <span class="hc-copy" style="font-size: 0.9rem;">Good (B+)</span>
              </div>
            </div>
          </div>

          <!-- Card 4: Footnote -->
          <div class="hc-card" style="display: flex; flex-direction: column;">
            <div style="padding: clamp(1rem, 2vw, 1.5rem);">
              <span class="hc-eyebrow" style="margin-bottom: 1rem; display: block;">Footnote & References</span>
              <div class="hc-card--parchment" style="padding: 1.5rem; display: flex; gap: 1rem; border-radius: var(--radius-xs);">
                <div class="hc-chip" style="background: var(--hc-gold); color: var(--hc-black); min-height: 24px; padding: 0.1rem 0.5rem; align-self: flex-start;">1</div>
                <div class="hc-small" style="color: #4b4033;">
                  <p style="margin: 0 0 0.5rem;"><em>Al-ʿIlal</em>, by Ibn Abī Ḥātim, 1/274.</p>
                  <p style="margin: 0 0 0.5rem;">See also: <em>Tahdhīb al-Kamāl</em>, 8/162.</p>
                  <p style="margin: 0;">Additional discussion in Appendix A.</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Directory -->
  <section class="hc-section hc-section--tight">
    <div class="hc-container">
      <div class="hc-directory-grid">
        {directory.map(item => (
          <DirectoryCard {...item as any} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Method -->
  <section class="hc-section">
    <div class="hc-container">
      <header class="hc-section-head hc-section-head--center">
        <h2 class="hc-title hc-title--md" style="color: var(--hc-gold)">Method before opinion.</h2>
      </header>
      
      <div class="method-strip">
        <div class="method-pillar">
          <div class="pillar-icon"><i class="fa-solid fa-scale-balanced"></i></div>
          <h3 class="hc-title">Rigor</h3>
          <p class="hc-copy">Reports are read through chains, transmitters, variants, and source history.</p>
        </div>
        <div class="method-pillar">
          <div class="pillar-icon"><i class="fa-solid fa-eye"></i></div>
          <h3 class="hc-title">Fairness</h3>
          <p class="hc-copy">Claims are judged carefully, without sectarian convenience or inherited reputation.</p>
        </div>
        <div class="method-pillar">
          <div class="pillar-icon"><i class="fa-solid fa-book-open"></i></div>
          <h3 class="hc-title">Transparency</h3>
          <p class="hc-copy">Sources, parallels, and reasoning should be visible to the reader.</p>
        </div>
        <div class="method-pillar">
          <div class="pillar-icon"><i class="fa-solid fa-landmark"></i></div>
          <h3 class="hc-title">Context</h3>
          <p class="hc-copy">Factional, political, and doctrinal settings matter when reports emerge from contested history.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="hc-container"><div class="hc-divider"></div></div>

  <!-- Section 5: Projects -->
  <section class="hc-section">
    <div class="hc-container">
      <header class="hc-section-head">
        <span class="hc-label">Digital Humanities</span>
        <h2 class="hc-title hc-title--md">Large-scale projects</h2>
      </header>
      
      <div class="projects-grid">
        <div class="project-card hc-card">
          <span class="hc-chip" style="margin-bottom: 1.5rem;">Coming Soon</span>
          <h3 class="hc-title">Hadith Database</h3>
          <p class="hc-copy">A searchable database for reports, chains, variants, transmitters, and source comparison.</p>
        </div>
        <div class="project-card hc-card">
          <span class="hc-chip" style="margin-bottom: 1.5rem;">Research Phase</span>
          <h3 class="hc-title">Corpus Mapping</h3>
          <p class="hc-copy">Digital tools for tracing reports across early Sunni and Shīʿī collections.</p>
        </div>
        <div class="project-card hc-card">
          <span class="hc-chip" style="margin-bottom: 1.5rem;">In Development</span>
          <h3 class="hc-title">Common-Link Studies</h3>
          <p class="hc-copy">Visual studies of transmission clusters, narrator pathways, and textual growth.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Quote Banner -->
  <section class="hc-section">
    <div class="hc-container">
      <div class="quote-container hc-card">
        <div class="quote-overlay">
          <h2 class="hc-title hc-title--md" style="color: var(--hc-gold); font-style: italic;">Truth is sought through evidence and transmission.</h2>
          <p class="hc-label" style="margin-top: 1.5rem;">— Imam al-Dhahabī</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 7: Latest Blog -->
  <section class="hc-section">
    <div class="hc-container">
      <header class="hc-section-head">
        <span class="hc-label">Editorial Notes</span>
        <h2 class="hc-title hc-title--md">Latest Writing</h2>
      </header>

      <div class="blog-grid">
        {blogPosts.map(post => (
          <a href="#" class="blog-card hc-card">
            <div class="blog-meta-top">
              <span class="hc-label">{post.category}</span>
            </div>
            <h3 class="hc-title">{post.title}</h3>
            <p class="hc-copy">{post.excerpt}</p>
            <div class="blog-meta-bottom">
              <span class="hc-small">{post.date}</span>
              <span class="hc-small">{post.readTime}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero Styles */
  .hero-section {
    padding-top: clamp(3rem, 6vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 8rem);
    min-height: calc(90vh - 68px);
    display: flex;
    align-items: center;
  }

  .hero-content {
    max-width: 900px;
    position: relative;
    z-index: 2;
  }

  .hero-content .hc-title--xl {
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    max-width: none;
  }

  .hero-subtitle {
    max-width: 560px;
    margin-top: 1.35rem;
    font-size: clamp(1.05rem, 1.2vw, 1.25rem);
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  /* Featured Reports Styles */
  .featured-reports .hc-section-head h2 {
    font-size: clamp(3rem, 5.2vw, 5.2rem);
    max-width: 900px;
  }

  .featured-reports-shell {
    border: 1px solid var(--hc-rule);
    background:
      linear-gradient(rgba(15,15,16,0.82), rgba(15,15,16,0.94)),
      url("/assets/textures/charcoal-paper.png");
    padding: clamp(1rem, 2vw, 1.5rem);
    box-shadow: var(--hc-shadow);
  }

  .featured-report-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .context-inner {
    padding: clamp(1.2rem, 3vw, 1.75rem);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .context-inner p {
    margin: 1.2rem 0;
    flex-grow: 1;
  }

  .context-meter {
    margin-top: auto;
  }

  .meter-label {
    display: block;
    margin-bottom: 0.5rem;
  }

  .meter-bar {
    width: 100%;
    height: 4px;
    background: rgba(242, 235, 220, 0.2);
    border-radius: 2px;
    overflow: hidden;
  }

  .meter-fill {
    height: 100%;
    background: var(--hc-parchment);
  }

  /* Method Styles */
  .method-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--hc-rule);
    background: rgba(15, 15, 16, 0.4);
    margin-top: 3rem;
  }

  .method-pillar {
    text-align: center;
    padding: 3rem 2rem;
    border-right: 1px solid var(--hc-rule-soft);
  }

  .method-pillar:last-child {
    border-right: none;
  }

  .pillar-icon {
    font-size: 2rem;
    color: var(--hc-gold);
    margin-bottom: 1.5rem;
  }

  .method-pillar h3 {
    margin-bottom: 1rem;
  }

  /* Projects Styles */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .project-card {
    padding: 2rem;
  }

  .project-card h3 {
    margin: 0 0 1rem;
  }

  .project-card p {
    margin: 0;
  }

  /* Quote Banner Styles */
  .quote-container {
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .quote-overlay {
    text-align: center;
    position: relative;
    z-index: 2;
    padding: 3rem;
  }

  .quote-overlay h2 {
    max-width: 25ch;
    margin: 0 auto;
  }

  /* Blog Styles */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .blog-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    border-color: var(--hc-gold-dim);
  }

  .blog-meta-top {
    margin-bottom: 1.5rem;
  }

  .blog-card h3 {
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .blog-card p {
    margin: 0 0 2rem;
    flex-grow: 1;
  }

  .blog-meta-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .hero-grid {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .hero-content .hc-title--xl {
      font-size: clamp(3.7rem, 18vw, 5.6rem);
    }

    .hero-illustration {
      min-height: 360px;
    }
    
    .featured-report-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 1024px) {
    .method-strip {
      grid-template-columns: 1fr 1fr;
    }
    .method-pillar {
      border-bottom: 1px solid var(--hc-rule-soft);
    }
    .method-pillar:nth-child(even) {
      border-right: none;
    }
  }

  @media (max-width: 768px) {
    .projects-grid, .blog-grid {
      grid-template-columns: 1fr;
    }
    
    .method-strip {
      grid-template-columns: 1fr;
    }
    .method-pillar {
      border-right: none;
    }
  }
</style>
