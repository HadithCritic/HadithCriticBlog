---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { isNewPost } from "../lib/new-badge";

const GENERIC_THUMB = "/images/blog_thumbnails/tn.generic.webp";

const allPosts = await getCollection(
  "articles",
  ({ data }) => (import.meta.env.DEV || !data.draft) && !data.preview,
);
const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const categoryDescriptions: Record<string, string> = {
  "Origins & Early History":
    "Early Islamic history, specific events, and broad origins.",
  "Prophecies & Eschatology":
    "Mahdi reports, apocalyptic claims, black banners, and dynastic memory.",
  "Transmission & Narrators":
    "Isnād politics, common links, and specific narrators.",
  "Theology & Epistemology":
    "Quranic authority, law, abrogation, and probability.",
  Blog: "Site notes, announcements, and shorter reflections.",
};

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(
    post.data.category,
    (categoryCounts.get(post.data.category) ?? 0) + 1,
  );
}

const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({
    name,
    count,
    description: categoryDescriptions[name] ?? "",
  }));

const featured = posts[0];
const featuredThumb = featured?.data.thumbnail ?? GENERIC_THUMB;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });

const folioOf = (post: (typeof posts)[number]) =>
  String(posts.length - posts.indexOf(post)).padStart(3, "0");

const videoIds = [
  "HWHjCfaPn_0",
  "6bpJBji3E0M",
  "3B0rnPGWgKU",
  "CG5i14GAZTQ",
  "boG5JTD5yXU",
  "MLaRB6uGhAk",
];
---

<BaseLayout title="HadithCritic | Verification Over Reputation">
  <link slot="head" rel="preload" as="image" href="/images/asset1.webp" />
  <section class="hero-section" data-motion="hero">
    <div class="hero-media" aria-hidden="true"></div>
    <div class="hc-container">
      <div class="hero-content">
        <h1 class="hero-title">
          Tracing the origins of <span class="hero-title-accent">early traditions.</span>
        </h1>
        <p class="hero-subtitle">
          Textual criticism, transmission forensics, and source verification—recovering early Islamic history through rigorous evidentiary research.
        </p>
        <div class="hero-actions">
          <a href="/blogs" class="hc-btn hero-btn-primary">
            Browse the archive <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="/academia" class="hc-btn hc-btn--ghost hero-btn-ghost">Read the research</a>
        </div>
      </div>
    </div>
  </section>

  <section
    data-motion="reveal"
    class="hc-section archive-journal-section"
    aria-labelledby="archive-journal-title"
  >
    <div class="hc-container">
      <header class="journal-header">
        <div>
          <h2 id="archive-journal-title" class="hc-title hc-title--md">
            From the <em>archive</em>
          </h2>
          <p class="hc-copy journal-header-copy">
            Essays and research notes on transmission, prophecy reports, Quranic
            authority, epistemology, and scriptural history.
          </p>
        </div>
        <a href="/blogs" class="hc-btn hc-btn--ghost">
          Browse all {posts.length} entries <span aria-hidden="true">→</span>
        </a>
      </header>

      <div class="journal-feature-grid">
        <a
          href={`/blogs/${featured.id}`}
          class="journal-feature-card"
          data-category={featured.data.category}
        >
          <div class="journal-feature-media">
            <img
              src={featuredThumb}
              alt={`Cover illustration for ${featured.data.title}`}
              class="journal-feature-img"
              loading="eager"
              decoding="async"
            />
            <div class="journal-feature-badge">
              <span class="feature-badge__dot"></span>
              <span>Latest Investigation</span>
            </div>
          </div>
          <div class="journal-feature-copy">
            <div class="journal-feature-top">
              <span
                class="journal-category"
                data-category={featured.data.category}
                >{featured.data.category}</span
              >
              <time
                class="journal-feature-date"
                datetime={featured.data.date.toISOString().slice(0, 10)}
              >
                {formatDate(featured.data.date)}
              </time>
              {
                isNewPost(featured.data.date) && (
                  <span class="new-badge">New</span>
                )
              }
            </div>
            <h3>{featured.data.title}</h3>
            <p>{featured.data.description}</p>
            {
              featured.data.tags && featured.data.tags.length > 0 && (
                <div class="journal-feature-tags">
                  {featured.data.tags.slice(0, 4).map((tag: string) => (
                    <span class="journal-tag">#{tag}</span>
                  ))}
                </div>
              )
            }
            <div class="journal-meta">
              <span class="journal-meta-cta">
                Read the investigation <span
                  class="journal-meta-arrow"
                  aria-hidden="true">→</span
                >
              </span>
            </div>
          </div>
        </a>

        <nav class="journal-categories" aria-label="Browse entries by category">
          {
            categories.map((category) => (
              <a
                href={`/blogs?category=${encodeURIComponent(category.name)}`}
                class="journal-category-tile"
                data-category={category.name}
              >
                <div class="journal-category-head">
                  <span class="journal-category-pill">
                    <span class="journal-category-dot" />
                    <span>{category.count} Studies</span>
                  </span>
                  <span class="journal-category-arrow" aria-hidden="true">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="7" y1="17" x2="17" y2="7" />
                      <polyline points="7 7 17 7 17 17" />
                    </svg>
                  </span>
                </div>
                <h3 class="journal-category-title">{category.name}</h3>
                {category.description && (
                  <p class="journal-category-desc">{category.description}</p>
                )}
                <div class="journal-category-foot">
                  <span>Explore Field</span>
                  <span class="foot-glyph" aria-hidden="true">
                    →
                  </span>
                </div>
              </a>
            ))
          }
        </nav>
      </div>

      <div class="home-ledger-wrap">
        <div class="home-ledger-header">
          <div>
            <h3 class="home-ledger-title">Latest studies &amp; analysis</h3>
            <p class="home-ledger-subtitle">
              Recent critical investigations into transmission chains and early
              texts.
            </p>
          </div>
          <div
            class="home-ledger-filters"
            role="group"
            aria-label="Filter latest studies by category"
          >
            <button
              type="button"
              class="home-filter-tab is-active"
              data-home-filter="all"
            >
              <span class="home-tab__dot" aria-hidden="true"></span>
              <span>All ({posts.length})</span>
            </button>
            {
              categories.map((c) => (
                <button
                  type="button"
                  class="home-filter-tab"
                  data-home-filter={c.name}
                  data-category={c.name}
                >
                  <span class="home-tab__dot" aria-hidden="true" />
                  <span>
                    {c.name} ({c.count})
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <ol class="home-ledger" id="home-ledger">
          {
            posts.map((post, index) => (
              <li
                class="home-ledger-row"
                data-category={post.data.category}
                hidden={index >= 5}
              >
                <a href={`/blogs/${post.id}`} class="home-ledger-link">
                  <span class="home-ledger-folio">
                    <span class="home-ledger-no">No. {folioOf(post)}</span>
                    <time datetime={post.data.date.toISOString().slice(0, 10)}>
                      {formatDate(post.data.date)}
                    </time>
                  </span>
                  <span class="home-ledger-body">
                    <span class="home-ledger-top">
                      <span
                        class="home-ledger-cat"
                        data-category={post.data.category}
                      >
                        {post.data.category}
                      </span>
                      {isNewPost(post.data.date) && (
                        <span class="new-badge">New</span>
                      )}
                    </span>
                    <span class="home-ledger-heading">{post.data.title}</span>
                    {post.data.description && (
                      <span class="home-ledger-desc">
                        {post.data.description}
                      </span>
                    )}
                    {post.data.tags && post.data.tags.length > 0 && (
                      <span class="home-ledger-tags">
                        {post.data.tags.slice(0, 3).map((tag: string) => (
                          <span class="home-tag">#{tag}</span>
                        ))}
                      </span>
                    )}
                  </span>
                  <span class="home-ledger-arrow" aria-hidden="true">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>

        <div class="home-ledger-footer">
          <a href="/blogs" class="hc-btn hc-btn--ghost" id="home-ledger-cta">
            Explore All {posts.length} Studies in Archive <span
              aria-hidden="true">→</span
            >
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    data-motion="reveal"
    class="hc-section youtube-preview-section"
    aria-labelledby="lectures-title"
  >
    <div class="hc-container">
      <header class="journal-header">
        <div>
          <h2 id="lectures-title" class="hc-title hc-title--md">
            Lectures in <em>video</em>
          </h2>
          <p class="hc-copy journal-header-copy">
            Deep dives into transmission history and source criticism, in visual
            form.
          </p>
        </div>
        <a href="/youtube" class="hc-btn hc-btn--ghost">
          Visit the channel <span aria-hidden="true">→</span>
        </a>
      </header>

      <div class="youtube-grid">
        {
          videoIds.map((id) => (
            <button
              type="button"
              class="yt-lite"
              data-video-id={id}
              aria-label="Play video lecture"
            >
              <img
                src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="yt-play" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M8 5.5v13l11-6.5z" />
                </svg>
              </span>
              <span class="yt-label" aria-hidden="true">
                Watch
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section
