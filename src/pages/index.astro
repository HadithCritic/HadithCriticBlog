---
import BaseLayout from '../layouts/BaseLayout.astro';

const topics = [
  {
    href: '/category/prophecies',
    count: '18 articles',
    title: 'Prophecies and apocalyptic narratives',
    img: 'https://hadithcriticblog.com/wp-content/uploads/2025/11/new-black-thumbnails-10.png'
  },
  {
    href: '/category/isnad',
    count: '29 articles',
    title: 'Isnad, rijal, and transmission forensics',
    img: 'https://hadithcriticblog.com/wp-content/uploads/2026/02/theychangedit.jpg'
  },
  {
    href: '/category/quranic-theology',
    count: '16 articles',
    title: 'Quranic theology, law, and critique',
    img: 'https://hadithcriticblog.com/wp-content/uploads/2025/09/new-black-thumbnails-3.png'
  },
  {
    href: '/category/philosophy',
    count: '4 articles',
    title: 'Philosophy and epistemology of hadith',
    img: 'https://hadithcriticblog.com/wp-content/uploads/2026/03/new-black-thumbnails.png'
  },
  {
    href: '/category/comparative-religion',
    count: '7 articles',
    title: 'Comparative religion and scriptural history',
    img: 'https://hadithcriticblog.com/wp-content/uploads/2025/08/ChatGPT-Image-Aug-9-2025-09_35_55-PM.png'
  }
];

const articles = [
  {
    href: 'https://hadithcriticblog.com/the-quranic-epistemology-of-verification/',
    title: 'The Quranic Epistemology of Verification (Q. 49:6)',
    label: 'Philosophy',
    date: 'Mar 3, 2026',
    datetime: '2026-03-03',
    img: 'https://hadithcriticblog.com/wp-content/uploads/2026/03/new-black-thumbnails.png'
  },
  {
    href: 'https://hadithcriticblog.com/green-arabia-hadith-sunnah-com-translation-change-fabrication/',
    title: 'Most Popular Hadith Website Caught Manipulating Hadith',
    label: 'Transmission',
    date: 'Feb 5, 2026',
    datetime: '2026-02-05',
    img: 'https://hadithcriticblog.com/wp-content/uploads/2026/02/theychangedit.jpg'
  },
  {
    href: 'https://hadithcriticblog.com/more-on-the-fabricated-baghdad-hadith-prophecy/',
    title: "More on: The Fabricated 'Baghdad' Hadith Prophecy",
    label: 'Prophecies',
    date: 'Nov 6, 2025',
    datetime: '2025-11-06',
    img: 'https://hadithcriticblog.com/wp-content/uploads/2025/11/new-black-thumbnails-10.png'
  },
  {
    href: 'https://hadithcriticblog.com/sunnis-have-disbelieved-in-53-of-the-quran/',
    title: 'Sunnis Have Disbelieved in 5:3 of The Quran',
    label: 'Theology',
    date: 'Sep 29, 2025',
    datetime: '2025-09-29',
    img: 'https://hadithcriticblog.com/wp-content/uploads/2025/09/new-black-thumbnails-3.png'
  }
];

const methodSteps = [
  ['Locate the earliest forms', 'Map the report across collections before treating one wording as original.'],
  ['Reconstruct transmission', 'Track clusters, common links, regional patterns, and suspicious bottlenecks.'],
  ['Read the historical setting', 'Ask who benefits from the report and when the claim becomes useful.'],
  ['Test by the Quran', 'Use the Quran as criterion when inherited reports make theological or legal claims.']
];

const dossiers = [
  ['Abu Hurayra', 'Medinan reports, volume anomalies, legal narratives'],
  ['Aisha', 'Domestic reports, legal memory, disputed attributions'],
  ['Al-Zuhri', 'Umayyad patronage, compilation history, common links'],
  ['Abu Tufayl', 'Kaysani material, late survival claims, sectarian setting']
];
---

<BaseLayout
  title="HadithCritic | Verification Over Reputation"
  description="Historical criticism, Quranic scholarship, and source-level analysis of hadith traditions."
>
  <section class="home-hero">
    <div class="wrap hero-shell">
      <div class="hero-copy">
        <p class="eyebrow">Quran-centered criticism</p>
        <h1>HadithCritic</h1>
        <p class="hero-claim">Verification over reputation.</p>
        <p class="hero-lede">
          Source-level research on inherited reports: transmission paths, sectarian context, transmitter history, and the Quranic demand for evidence.
        </p>
        <div class="hero-actions">
          <a href="/blogs" class="btn btn-primary">
            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
            Read research
          </a>
          <a href="/methodology" class="btn btn-ghost">
            <i class="fa-solid fa-diagram-project" aria-hidden="true"></i>
            Study the method
          </a>
        </div>
      </div>

      <aside class="hero-feature" aria-label="Featured article">
        <a href="https://hadithcriticblog.com/green-arabia-hadith-sunnah-com-translation-change-fabrication/" target="_blank" rel="noreferrer" class="hero-feature-link">
          <div class="hero-feature-media">
            <img
              src="https://hadithcriticblog.com/wp-content/uploads/2026/02/theychangedit.jpg"
              alt="Thumbnail for an article about a changed Sunnah.com translation"
              loading="eager"
            />
          </div>
          <div class="hero-feature-body">
            <span>Featured investigation</span>
            <strong>Most Popular Hadith Website Caught Manipulating Hadith</strong>
            <time datetime="2026-02-05">Feb 5, 2026</time>
          </div>
        </a>
      </aside>
    </div>
  </section>

  <section class="topic-strip" aria-label="Research categories">
    <div class="wrap topic-strip-inner">
      {topics.map((topic) => (
        <a href={topic.href} class="topic-tile">
          <img src={topic.img} alt="" loading="lazy" />
          <span>{topic.count}</span>
          <strong>{topic.title}</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="section latest-section">
    <div class="wrap">
      <div class="latest-head">
        <div class="section-heading">
          <p class="eyebrow">Latest work</p>
          <h2>New arguments, dated and traceable.</h2>
          <p>
            Each article makes the chain of reasoning visible: what the report claims, who carried it, where it appears, and what pressure the evidence can bear.
          </p>
        </div>
        <a href="/blogs" class="text-link">Browse all articles &rarr;</a>
      </div>

      <div class="article-grid">
        {articles.map((article, index) => (
          <a href={article.href} target="_blank" rel="noreferrer" class:list={['article-card', { 'article-card--wide': index === 0 }]}>
            <div class="article-card-thumb">
              <img src={article.img} alt="" loading="lazy" />
              <span>{article.label}</span>
            </div>
            <div class="article-card-body">
              <h3>{article.title}</h3>
              <time datetime={article.datetime}>{article.date}</time>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight archive-section">
    <div class="wrap archive-grid">
      <div class="archive-stat">
        <span>74</span>
        <p>Articles, dossiers, books, and videos collected for repeatable source checking.</p>
      </div>
      <div class="archive-copy">
        <h2>Built for readers who want receipts, not vibes.</h2>
        <p>
          HadithCritic treats reports as historical claims. The work moves slowly on purpose: cite the text, identify the carriers, compare the variants, then test the claim.
        </p>
      </div>
    </div>
  </section>

  <section class="section method-section">
    <div class="wrap method-grid">
      <div class="section-heading">
        <p class="eyebrow">Method</p>
        <h2>How a report gets tested.</h2>
        <p>Every analysis follows the same chain: origin, transmission, context, criterion.</p>
      </div>
      <ol class="method-list">
        {methodSteps.map(([title, text], index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <strong>{title}</strong>
              <p>{text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section library-section">
    <div class="wrap library-grid">
      <figure class="library-cover">
        <img src="/images/RefutationKJI_FC.png" alt="Cover for a HadithCritic refutation publication" loading="lazy" />
      </figure>
      <div class="library-copy">
        <p class="eyebrow">Research library</p>
        <h2>Books, dossiers, and long-form refutations.</h2>
        <p>
          Longer investigations need room: full refutations, transmitter profiles, bibliography work, and source-by-source argument maps.
        </p>
        <div class="library-links">
          <a href="/books">Books and PDFs <span>&rarr;</span></a>
          <a href="/dossiers">Transmitter dossiers <span>&rarr;</span></a>
          <a href="/bibliography">Bibliography <span>&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section dossier-section">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Dossiers</p>
        <h2>Profiles built around evidence, not inherited rank.</h2>
      </div>
      <div class="dossier-grid" aria-label="Key transmitter dossiers">
        {dossiers.map(([name, description]) => (
          <a href={`/dossiers/${name.toLowerCase().replaceAll(' ', '-').replace('al-zuhri', 'al-zuhri')}`} class="dossier-card">
            <strong>{name}</strong>
            <span>{description}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section media-section">
    <div class="wrap media-grid">
      <div class="section-heading">
        <p class="eyebrow">Video lectures</p>
        <h2>Watch the argument unfold.</h2>
        <p>Selected lectures and explainers for readers who want the method spoken through step by step.</p>
        <a href="https://www.youtube.com/@HadithCritic" target="_blank" rel="noreferrer" class="text-link">View the channel &rarr;</a>
      </div>

      <div class="video-stack" aria-label="Selected video lectures">
        <a href="https://youtu.be/CG5i14GAZTQ" target="_blank" rel="noreferrer" class="video-card">
          <img src="https://img.youtube.com/vi/CG5i14GAZTQ/hqdefault.jpg" alt="The Broken Chain lecture thumbnail" loading="lazy" />
          <span>The Broken Chain: an introduction to isnad criticism</span>
        </a>
        <a href="https://youtu.be/boG5JTD5yXU" target="_blank" rel="noreferrer" class="video-card">
          <img src="https://img.youtube.com/vi/boG5JTD5yXU/hqdefault.jpg" alt="Quranic supremacy lecture thumbnail" loading="lazy" />
          <span>Quranic supremacy over hadith: a methodological framework</span>
        </a>
        <a href="https://youtu.be/3B0rnPGWgKU" target="_blank" rel="noreferrer" class="video-card">
          <img src="https://img.youtube.com/vi/3B0rnPGWgKU/hqdefault.jpg" alt="Abu Hurayra dossier lecture thumbnail" loading="lazy" />
          <span>Dossier: Abu Hurayra and the narration explosion</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section newsletter-section">
    <div class="wrap newsletter-panel">
      <div>
        <p class="eyebrow">Research updates</p>
        <h2>New work when the evidence is ready.</h2>
        <p>Articles, dossiers, and video lectures. No filler.</p>
      </div>
      <form class="newsletter-form" action="/subscribe" method="post">
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input id="newsletter-email" class="input" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </section>

  <style>
    .home-hero {
      position: relative;
      padding: clamp(4.5rem, 8vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
      overflow: clip;
    }

    .home-hero::before {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--line-strong), transparent);
    }

    .hero-shell {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.72fr);
      gap: clamp(2rem, 6vw, 5rem);
      align-items: end;
    }

    .hero-copy {
      min-width: 0;
    }

    .hero-copy h1 {
      max-width: 9ch;
      margin: 0.35rem 0 0;
      color: var(--ink);
      font-family: var(--font-display);
      font-size: clamp(4.5rem, 14vw, 9.5rem);
      font-weight: 500;
      letter-spacing: -0.07em;
      line-height: 0.82;
      text-wrap: balance;
    }

    .hero-claim {
      margin: clamp(1.4rem, 3vw, 2.2rem) 0 0;
      color: var(--accent-2);
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 3.3vw, 3rem);
      letter-spacing: -0.04em;
      line-height: 1.05;
    }

    .hero-lede {
      max-width: 62ch;
      margin: 1.1rem 0 0;
      color: var(--ink-2);
      font-family: var(--font-ui);
      font-size: clamp(1rem, 0.6vw + 0.92rem, 1.2rem);
      line-height: 1.7;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: clamp(1.5rem, 3vw, 2.3rem);
    }

    .hero-feature {
      min-width: 0;
    }

    .hero-feature-link {
      display: grid;
      text-decoration: none;
      color: var(--surface-ink);
      background: var(--surface);
      border: 1px solid color-mix(in srgb, var(--surface-ink) 14%, transparent);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow);
      transform: rotate(1.2deg);
      transition: transform 240ms var(--ease), box-shadow 240ms var(--ease);
    }

    .hero-feature-link:hover {
      transform: rotate(0deg) translateY(-5px);
      box-shadow: 0 32px 90px rgba(0, 0, 0, 0.52);
    }

    .hero-feature-media {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: var(--surface-2);
    }

    .hero-feature-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(0.88) contrast(1.02);
      transition: transform 420ms var(--ease);
    }

    .hero-feature-link:hover img {
      transform: scale(1.04);
    }

    .hero-feature-body {
      display: grid;
      gap: 0.45rem;
      padding: clamp(1.1rem, 3vw, 1.6rem);
    }

    .hero-feature-body span,
    .article-card-thumb span,
    .topic-tile span {
      color: var(--accent);
      font-family: var(--font-ui);
      font-size: 0.76rem;
      font-weight: 800;
      line-height: 1.1;
    }

    .topic-tile span {
      color: #ff7348;
      text-shadow: 0 1px 16px rgba(0, 0, 0, 0.5);
    }

    .hero-feature-body strong {
      font-family: var(--font-display);
      font-size: clamp(1.35rem, 2.2vw, 2rem);
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1.05;
      text-wrap: pretty;
    }

    .hero-feature-body time {
      color: color-mix(in srgb, var(--surface-ink) 64%, transparent);
      font-family: var(--font-ui);
      font-size: 0.82rem;
      font-weight: 700;
    }

    .topic-strip {
      border-bottom: 1px solid var(--line);
      background: color-mix(in srgb, var(--bg-2) 84%, transparent);
    }

    .topic-strip-inner {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1px;
      background: var(--line);
    }

    .topic-tile {
      position: relative;
      min-height: 210px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 0.35rem;
      padding: 1rem;
      overflow: hidden;
      text-decoration: none;
      background: var(--bg);
      isolation: isolate;
    }

    .topic-tile img {
      position: absolute;
      inset: 0;
      z-index: -2;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.42;
      filter: grayscale(0.35) brightness(0.62) saturate(0.75);
      transition: transform 440ms var(--ease), opacity 220ms ease, filter 220ms ease;
    }

    .topic-tile::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(180deg, transparent 5%, rgba(16, 17, 15, 0.42) 42%, rgba(16, 17, 15, 0.94));
    }

    .topic-tile:hover img {
      opacity: 0.6;
      filter: grayscale(0.05) brightness(0.75) saturate(0.95);
      transform: scale(1.05);
    }

    .topic-tile strong {
      color: #f7f1e4;
      font-family: var(--font-display);
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      font-weight: 500;
      line-height: 1.12;
      letter-spacing: -0.025em;
      text-wrap: pretty;
      text-shadow: 0 1px 18px rgba(0, 0, 0, 0.62);
    }

    .latest-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1.5rem;
      margin-bottom: clamp(1.25rem, 3vw, 2rem);
    }

    .article-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    .article-card {
      min-width: 0;
      display: grid;
      grid-template-rows: auto 1fr;
      color: var(--ink);
      text-decoration: none;
      background: color-mix(in srgb, var(--bg-2) 88%, transparent);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition: transform 220ms var(--ease), border-color 180ms ease, background 180ms ease;
    }

    .article-card--wide {
      grid-column: span 2;
    }

    .article-card:hover {
      transform: translateY(-4px);
      border-color: var(--line-strong);
      background: var(--bg-3);
    }

    .article-card-thumb {
      position: relative;
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }

    .article-card-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(0.72) brightness(0.82);
      transition: transform 360ms var(--ease), filter 220ms ease;
    }

    .article-card:hover img {
      transform: scale(1.04);
      filter: saturate(0.95) brightness(0.94);
    }

    .article-card-thumb span {
      position: absolute;
      left: 0.8rem;
      bottom: 0.8rem;
      padding: 0.36rem 0.55rem;
      border-radius: var(--radius-pill);
      color: var(--accent-ink);
      background: var(--accent-2);
    }

    .article-card-body {
      display: grid;
      align-content: space-between;
      gap: 1rem;
      padding: 1rem;
    }

    .article-card h3 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(1.18rem, 1.6vw, 1.55rem);
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1.08;
      text-wrap: pretty;
    }

    .article-card time {
      color: var(--ink-3);
      font-family: var(--font-ui);
      font-size: 0.82rem;
      font-weight: 700;
    }

    .archive-section {
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: var(--accent);
      color: var(--accent-ink);
    }

    .archive-grid {
      display: grid;
      grid-template-columns: minmax(220px, 0.45fr) 1fr;
      gap: clamp(1.5rem, 5vw, 4rem);
      align-items: center;
    }

    .archive-stat {
      display: grid;
      gap: 0.75rem;
    }

    .archive-stat span {
      font-family: var(--font-display);
      font-size: clamp(5rem, 14vw, 10rem);
      font-weight: 500;
      letter-spacing: -0.08em;
      line-height: 0.75;
    }

    .archive-stat p,
    .archive-copy p {
      margin: 0;
      max-width: 62ch;
      font-family: var(--font-ui);
      font-size: 1rem;
      line-height: 1.65;
    }

    .archive-copy h2 {
      max-width: 13ch;
      margin: 0 0 1rem;
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 6vw, 5.4rem);
      font-weight: 500;
      letter-spacing: -0.07em;
      line-height: 0.9;
    }

    .method-grid,
    .library-grid,
    .media-grid {
      display: grid;
      grid-template-columns: minmax(240px, 0.62fr) 1fr;
      gap: clamp(2rem, 6vw, 5rem);
      align-items: start;
    }

    .method-list {
      display: grid;
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--line);
    }

    .method-list li {
      display: grid;
      grid-template-columns: 3.4rem 1fr;
      gap: 1rem;
      padding: clamp(1.1rem, 2.5vw, 1.6rem) 0;
      border-bottom: 1px solid var(--line);
    }

    .method-list li > span {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.82rem;
      font-weight: 800;
    }

    .method-list strong {
      display: block;
      color: var(--ink);
      font-family: var(--font-display);
      font-size: clamp(1.35rem, 2.5vw, 2rem);
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1;
    }

    .method-list p {
      max-width: 58ch;
      margin: 0.45rem 0 0;
      color: var(--ink-3);
      font-family: var(--font-ui);
      font-size: 0.98rem;
      line-height: 1.6;
    }

    .library-section {
      background: color-mix(in srgb, var(--bg-2) 76%, transparent);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .library-cover {
      max-width: 320px;
      margin: 0;
      padding: 0.65rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: color-mix(in srgb, var(--bg) 70%, transparent);
      box-shadow: var(--shadow-soft);
    }

    .library-cover img {
      border-radius: calc(var(--radius-md) - 5px);
      aspect-ratio: 3 / 4;
      object-fit: cover;
    }

    .library-copy h2,
    .newsletter-panel h2 {
      margin: 0.35rem 0 0;
      color: var(--ink);
      font-family: var(--font-display);
      font-size: clamp(2.1rem, 5vw, 4.6rem);
      font-weight: 500;
      letter-spacing: -0.055em;
      line-height: 0.95;
      text-wrap: balance;
    }

    .library-copy p,
    .newsletter-panel p {
      max-width: 64ch;
      margin: 1rem 0 0;
      color: var(--ink-3);
      font-family: var(--font-ui);
      line-height: 1.65;
    }

    .library-links {
      display: grid;
      margin-top: clamp(1.4rem, 3vw, 2rem);
      border-top: 1px solid var(--line);
    }

    .library-links a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 58px;
      color: var(--ink-2);
      font-family: var(--font-ui);
      font-size: 0.98rem;
      font-weight: 760;
      text-decoration: none;
      border-bottom: 1px solid var(--line);
    }

    .library-links a:hover {
