---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogSlider from '../components/BlogSlider.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Home">
    <!-- Hero Section -->
    <header class="hero">
        <div class="particles" id="particleSystem"></div>
        <div class="container hero-layout">
            <div class="hero-text">
                <h1>Unveiling The<br><em>History of Hadith</em></h1>
                <div class="hero-divider"></div>
                <p>
                    A rigorous examination of traditional Islamic narratives through historical criticism, philosophical
                    analysis, and the Quranic mandate. Questioning isnād-based methodology and mainstream assumptions of
                    authenticity.
                </p>
                <div class="hero-btns">
                    <a href="/blogs" class="btn btn-primary">
                        Read Blogs <i class="fas fa-arrow-right"></i>
                    </a>
                    <a href="https://youtube.com/@HadithCritic" target="_blank" class="btn btn-outline">
                        <i class="fab fa-youtube"></i> YouTube
                    </a>
                </div>
            </div>

            <!-- Isnad Network Visualization -->
            <div class="hero-visual">
                <div class="orbital-rings">
                    <div class="analysis-ring analysis-ring-1"></div>
                    <div class="analysis-ring analysis-ring-2"></div>
                    <div class="analysis-ring analysis-ring-3"></div>
                </div>
                <div class="particle-burst" id="particleBurst"></div>
                <svg class="isnad-canvas" id="isnadCanvas"></svg>
                <div class="isnad-network" id="isnadNetwork">
                    <div class="isnad-bundle left-1">
                        <div class="narrator-node" data-name="Rawī A">R1</div>
                        <div class="narrator-node common-link" data-name="Muḥaddith X" data-common="true">M</div>
                        <div class="narrator-node" data-name="Rawī B">R2</div>
                    </div>
                    <div class="isnad-bundle left-2">
                        <div class="narrator-node" data-name="Rawī C">R3</div>
                        <div class="narrator-node common-link" data-name="Weak Link Y" data-common="true">W</div>
                        <div class="narrator-node" data-name="Rawī D">R4</div>
                    </div>
                    <div class="isnad-bundle right-1">
                        <div class="narrator-node" data-name="Rawī H">R8</div>
                        <div class="narrator-node common-link" data-name="Disputed P" data-common="true">D</div>
                    </div>
                    <div class="isnad-bundle right-2">
                        <div class="narrator-node common-link" data-name="Liar Q" data-common="true">L</div>
                        <div class="narrator-node" data-name="Rawī J">R10</div>
                    </div>
                </div>
                <div class="critic-container">
                    <img src="https://hadithcriticblog.com/wp-content/uploads/2026/02/cropped-HCpfp.jpg"
                        class="hero-image" alt="HadithCritic">
                    <div class="analysis-status">EXTRACTING HISTORICAL REALITY</div>
                </div>
                <div class="extraction-beam" id="beam1"></div>
                <div class="extraction-beam" id="beam2"></div>
            </div>
        </div>
    </header>
    <!-- Blog Slider Component -->
    <BlogSlider articles={sortedArticles.slice(0, 12)} compact={true} />

    <!-- Academia Section -->
    <section class="academia-preview">
        <div class="container">
            <div class="academia-preview-content">
                <div class="academia-preview-text">
                    <h2>Academia</h2>
                    <p>Academic publications, papers, and critical research methodologies in the field of Islamic studies.</p>
                    <a href="/academia" class="btn btn-outline" style="margin-top: 20px;">
                        Explore Academic Works <i class="fas fa-university"></i>
                    </a>
                </div>
                <div class="academia-preview-visual">
                    <div class="book-mini">
                        <img src="/images/RefutationKJI_FC.png" alt="Book Cover" class="book-mini-img">
                        <div class="badge-mini">Latest Publication</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .academia-preview {
        padding: 80px 20px;
        background: rgba(15, 15, 15, 0.6);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .academia-preview-content {
        max-width: 1000px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 60px;
        background: linear-gradient(135deg, rgba(202, 138, 4, 0.05) 0%, transparent 100%);
        border: 1px solid rgba(202, 138, 4, 0.1);
        border-radius: 24px;
        padding: 40px;
    }

    .academia-preview-text h2 {
        font-family: var(--font-display);
        font-size: 32px;
        color: var(--text-heading);
        margin: 0 0 16px 0;
    }

    .academia-preview-text p {
        color: var(--text-body);
        font-size: 16px;
        line-height: 1.6;
        margin: 0;
        max-width: 400px;
    }

    .book-mini {
        position: relative;
        perspective: 1000px;
    }

    .book-mini-img {
        width: 160px;
        border-radius: 4px 8px 8px 4px;
        box-shadow: -5px 10px 25px rgba(0,0,0,0.6), inset 2px 0 5px rgba(255,255,255,0.2);
        transform: rotateY(-15deg);
        transition: transform 0.5s ease;
    }
    
    .book-mini:hover .book-mini-img {
        transform: rotateY(-5deg) scale(1.05);
    }

    .badge-mini {
        position: absolute;
        top: -30px;
        left: 50%;
        transform: translateX(-50%);
        background: #ca8a04;
        color: #fff;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 4px 12px rgba(202, 138, 4, 0.4);
        white-space: nowrap;
        z-index: 10;
    }

    @media (max-width: 768px) {
        .academia-preview-content {
            flex-direction: column-reverse;
            text-align: center;
            gap: 40px;
        }
        .academia-preview-text p {
            margin: 0 auto;
        }
    }
</style>
