---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FiqhCompassNav from "../../components/FiqhCompassNav.astro";
import { answerOptions, axes, questions } from "../../data/fiqh-compass";
import figureData from "../../data/fiqh-compass-figures.json";
import { candidateProfiles, issueGroups } from "../../data/fiqh-compass-research";
import "../../styles/project-pages.css";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Projects", url: "/projects/" },
  { name: "Fiqh Compass", url: "/projects/fiqh-compass/" },
];

const axisOf = new Map(axes.map((axis) => [axis.id, axis]));
/* Four statements from the question bank, one per dimension, quoted exactly. */
const examples = ["Q01", "Q09", "Q17", "Q22"].map((id) => {
  const question = questions.find((q) => q.id === id)!;
  return { question, axis: axisOf.get(question.axis)! };
});
/* The example result uses three real dimensions as its axes. Markers and coverage are illustrative. */
const itemsPerAxis = Math.round(questions.length / axes.length);
/* Counts in prose come from the data, so the copy cannot drift from the question bank again
   (it said 24 statements, two per dimension, after the bank grew to 96, eight per dimension). */
const WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"];
const inWords = (n: number) => WORDS[n] ?? String(n);
const capital = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const figureCount = figureData.figures.length;
const candidateCount = candidateProfiles.length;
const issueCount = issueGroups.reduce((sum, group) => sum + group.issues.length, 0);
const sampleAxes = [
  { axis: axisOf.get("A01")!, marker: 62, scored: 2 },
  { axis: axisOf.get("A05")!, marker: 36, scored: 2 },
  { axis: axisOf.get("A09")!, marker: 71, scored: 2 },
];
---

<BaseLayout
  title="Fiqh Compass | HadithCritic Projects"
  description="An evidence-minded, twelve-dimension prototype for exploring approaches to Islamic legal reasoning."
  canonical="/projects/fiqh-compass/"
  crumbs={crumbs}
>
  <div class="fiqh-compass pj" id="top">
    <FiqhCompassNav current="overview" />
    <header class="pj-hero" aria-labelledby="compass-title">
      <div class="pj-shell pj-hero__inner">
        <p class="pj-hero__eyebrow">Fiqh Compass · HadithCritic research project</p>
        <h1 class="pj-hero__title fc-title" id="compass-title">How do you approach Islamic law?</h1>
        <p class="pj-hero__lede">Explore how you approach sources, reasoning, authority, and uncertainty in Islamic law.</p>
        <p class="pj-hero__notice">The compass describes your answers to {questions.length} draft statements; it does not identify your religious affiliation, decide which view is correct, or issue a fatwa.</p>
        <div class="pj-hero__actions">
          <a class="hc-btn fc-cta" href="/projects/fiqh-compass/quiz/">Begin the quiz <span aria-hidden="true">→</span></a>
        </div>
        <ul class="pj-hero__facts" aria-label="Prototype contents">
          <li>{questions.length} draft statements</li>
          <li>{axes.length} dimensions</li>
          <li>About 15–20 min</li>
          <li>Saved on this device</li>
        </ul>
      </div>
    </header>

    <div class="pj-shell fc-body">
      <section class="pj-section" id="examples" aria-labelledby="examples-title">
        <header class="pj-head">
          <h2 id="examples-title" class="pj-head__title">What the quiz asks, and what it returns</h2>
          <span class="pj-head__rule" aria-hidden="true"></span>
        </header>
        <div class="fc-preview">
          <div>
            <p class="fc-preview__cap">Example statements, quoted from the question bank. Answers here are not recorded.</p>
            <ol class="fc-examples">
              {examples.map(({ question, axis }) => (
                <li class="pj-card fc-example">
                  <p class="fc-example__axis"><span>{axis.id}</span> {axis.title}</p>
                  <p class="fc-example__prompt">{question.prompt}</p>
                  <ol class="fc-scale" aria-label="Response scale">
                    {answerOptions.map((option) => <li>{option.label}</li>)}
                  </ol>
                </li>
              ))}
            </ol>
            <a class="fc-more" href="/projects/fiqh-compass/quiz/">Answer all {questions.length} in the quiz <span aria-hidden="true">→</span></a>
          </div>

          <aside class="fc-sample pj-card" aria-label="Illustration of the quiz result layout, not a real result">
            <div class="fc-sample__topline"><span>Illustrative result view</span><span>{axes.length} dimensions</span></div>
            <h3>Your method profile</h3>
            <p class="fc-sample__caption">A response map with its coverage shown.</p>
            <div class="fc-sample__axes">
              {sampleAxes.map(({ axis, marker, scored }) => (
                <div>
                  <p class="fc-sample__name"><span>{axis.id}</span> {axis.title}</p>
                  <i aria-hidden="true"><b style={`--marker: ${marker}%`}></b></i>
                  <p class="fc-sample__poles"><span>{axis.low}</span><span>{axis.high}</span></p>
                  <p class="fc-sample__coverage">{scored} of {itemsPerAxis} items scored</p>
                </div>
              ))}
            </div>
            <div class="fc-sample__foot"><span>Illustration only</span><span>Coverage accompanies every axis</span></div>
          </aside>
        </div>
      </section>

      <section class="pj-section" id="methodology" aria-labelledby="method-title">
        <p class="fc-kicker">A guided process</p>
        <header class="pj-head">
          <h2 id="method-title" class="pj-head__title">How the Fiqh Compass works</h2>
          <span class="pj-head__rule" aria-hidden="true"></span>
        </header>
        <p class="pj-lede">Move from your answers to a transparent, limited summary.</p>
        <ol class="fc-steps">
          <li><span>01</span><h3>Answer the questions</h3><p>Respond to {questions.length} short statements. Skip any item that does not fit your view.</p></li>
          <li><span>02</span><h3>Review twelve dimensions</h3><p>See where your answers fall, with the number of scored items shown beside each axis.</p></li>
          <li><span>03</span><h3>Read the limits</h3><p>Interpret a provisional method profile and the closest historical figures, each with the passages behind it. Neither is a school label or a ruling.</p></li>
        </ol>
      </section>

      <section class="fc-limits" aria-labelledby="boundaries-title">
        <h2 id="boundaries-title" class="fc-limits__title">What a compass can’t decide</h2>
        <p class="fc-limits__line"><b>Your answers are not a verdict.</b> Different questions need different evidence. This prototype keeps its claims narrow.</p>
        <ul class="fc-limits__chips">
          <li><details class="fc-limit"><summary class="pj-chip">No school label</summary><p>People’s views may cross conventional school boundaries.</p></details></li>
          <li><details class="fc-limit"><summary class="pj-chip">No right or wrong score</summary><p>A coordinate describes your responses, not correctness or certainty.</p></details></li>
          <li><details class="fc-limit"><summary class="pj-chip">No fatwa</summary><p>General method questions cannot decide what you should do in a case.</p></details></li>
          <li><details class="fc-limit"><summary class="pj-chip">No reviewed historical match</summary><p>Figures are placed only where a cited passage states a view. The readings are machine-assisted and not yet reviewed by a specialist.</p></details></li>
        </ul>
      </section>

      <section class="pj-section" id="more" aria-labelledby="more-title">
        <header class="pj-head">
          <h2 id="more-title" class="pj-head__title">More about the compass</h2>
          <span class="pj-head__rule" aria-hidden="true"></span>
        </header>
        <div class="fc-discs">
          <details class="pj-disc pj-disc--card" id="introduction">
            <summary><span class="pj-disc__title">A fuller portrait of your legal reasoning.</span><span class="pj-disc__meta">More than one dimension</span></summary>
            <div class="pj-disc__body">
              <p class="pj-lede">Explore principles that are often bundled together. The prototype keeps their questions and results distinct.</p>
              <ul class="fc-features">
                <li><span>01</span><div><h3>Sources</h3><p>Which sources can establish binding religious requirements?</p></div></li>
                <li><span>02</span><div><h3>Transmission</h3><p>What evidentiary weight can reports and inherited practice carry?</p></div></li>
                <li><span>03</span><div><h3>Reasoning</h3><p>How might analogy, reason, welfare, and custom inform a judgment?</p></div></li>
                <li><span>04</span><div><h3>Context</h3><p>When can a change in circumstances affect an application?</p></div></li>
                <li><span>05</span><div><h3>Authority</h3><p>How do you approach schools, qualified authorities, and disagreement?</p></div></li>
                <li><span>06</span><div><h3>Uncertainty</h3><p>How should unresolved evidence and possible abrogation be handled?</p></div></li>
              </ul>
              <div class="fc-result-layers" aria-label="Planned result layers and current availability">
                <article><span>AVAILABLE IN THIS PROTOTYPE</span><h3>Legal method</h3><p>A provisional map of your answers across twelve draft dimensions.</p></article>
                <article><span>RESEARCH IN PROGRESS</span><h3>Practical positions</h3><p>Precisely defined cases will be compared only after issue evidence is reviewed.</p></article>
                <article><span>AVAILABLE IN THIS PROTOTYPE</span><h3>Historical figures</h3><p>The closest of {figureData.figures.length} figures on the dimensions you share, each placement shown with the passage it rests on. The readings are unreviewed.</p></article>
              </div>
            </div>
          </details>

          <details class="pj-disc pj-disc--card" id="axis-index">
            <summary><span class="pj-disc__title">Twelve dimensions under study</span><span class="pj-disc__meta">Question map · {capital(inWords(itemsPerAxis))} draft items each</span></summary>
            <div class="pj-disc__body">
              <ol class="fc-axis-list">
                {axes.map((axis) => (
                  <li id={`axis-${axis.id}`}>
                    <span class="fc-axis-list__id">{axis.id}</span>
                    <div class="fc-axis-list__body">
                      <h3>{axis.title}</h3>
                      <p class="fc-axis-list__range"><span>{axis.low}</span><span aria-hidden="true">→</span><span>{axis.high}</span></p>
                      <p class="fc-axis-list__note">{axis.note}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </details>

          <details class="pj-disc pj-disc--card fc-faq" id="faq">
            <summary><span class="pj-disc__title">Frequently asked questions</span><span class="pj-disc__meta">Before you begin</span></summary>
            <div class="pj-disc__body">
              <p class="pj-lede">What this first research prototype can and cannot tell you.</p>
              <div class="fc-faq__list">
                <details class="pj-disc pj-disc--row"><summary>What does the quiz measure?</summary><p>It asks about general approaches to legal sources, reasoning, authority, context, and uncertainty. It does not ask you to choose a school or resolve a practical case.</p></details>
                <details class="pj-disc pj-disc--row"><summary>Is the questionnaire validated?</summary><p>No. This is an early prototype with {inWords(itemsPerAxis)} draft items per dimension. The wording and the axes still need source review and comprehension research.</p></details>
                <details class="pj-disc pj-disc--row"><summary>Will it tell me which school I belong to?</summary><p>No. The result summarizes your answers to these questions. It does not assign a religious identity or claim that one school is internally uniform.</p></details>
                <details class="pj-disc pj-disc--row"><summary>Are my answers sent to HadithCritic?</summary><p>No. Progress is saved in this browser’s local storage. The quiz does not send answers to a server.</p></details>
                <details class="pj-disc pj-disc--row"><summary>How are historical figures compared?</summary><p>The result compares your coordinates with {figureCount} historical figures on the dimensions you share, and needs at least two in common. A figure is placed on a dimension only where a cited passage, from the figure’s own work, a named reporter, or an editor’s introduction, states a view, and each placement shows that passage. A school name or a later summary is not enough to place a figure. The readings were made with machine assistance and have not been reviewed by a specialist.</p></details>
              </div>
            </div>
          </details>
        </div>
      </section>

      <section class="pj-section" aria-labelledby="catalog-title">
        <p class="fc-kicker">Explore the research</p>
        <header class="pj-head">
          <h2 id="catalog-title" class="pj-head__title">Browse questions and profile coverage.</h2>
          <span class="pj-head__rule" aria-hidden="true"></span>
        </header>
        <p class="pj-lede">These indexes show the research behind the quiz. Proposed prompts and candidate authors are not scored findings, and the figure placements are not yet reviewed by a specialist.</p>
        <ul class="fc-catalog">
          <li>
            <a class="fc-catalog__link" href="/projects/fiqh-compass/issues/">
              <span class="fc-catalog__name">Issue register <span class="fc-catalog__count">{issueCount} proposed prompts</span></span>
              <span class="fc-catalog__desc">Browse the bounded legal questions selected for investigation, grouped by their primary dimensions.</span>
              <span class="fc-catalog__go">Browse proposed questions <span aria-hidden="true">→</span></span>
            </a>
          </li>
          <li>
            <a class="fc-catalog__link" href="/projects/fiqh-compass/profiles/">
              <span class="fc-catalog__name">Historical figures and profiles <span class="fc-catalog__count">{figureCount} figures · {candidateCount} candidate authors</span></span>
              <span class="fc-catalog__desc">The historical figures the quiz compares you with, each placement shown with the Arabic passage it rests on, and the candidate profiles still being researched.</span>
              <span class="fc-catalog__go">View figures and profiles <span aria-hidden="true">→</span></span>
            </a>
          </li>
        </ul>
        <p class="fc-catalog__note">There is no left–right replacement spectrum here. Legal traditions and authors are not single, uniform ideologies; results stay on separate axes and show how many draft items support each point.</p>
      </section>

      <section class="fc-close" aria-labelledby="depth-title">
        <div>
          <p class="fc-kicker">Start with the prototype</p>
          <h2 id="depth-title">{questions.length} draft statements. {capital(inWords(axes.length))} dimensions.</h2>
          <p>Try the research prototype and see how your answers map onto its provisional dimensions.</p>
        </div>
        <a class="hc-btn fc-cta" href="/projects/fiqh-compass/quiz/">Begin the quiz <span aria-hidden="true">→</span></a>
      </section>

      <footer class="fc-status" aria-labelledby="feedback-title">
        <p><span class="fc-status__k">Research status</span> <b id="feedback-title">The question set is provisional.</b> The axes and first-pass items follow the project roadmap. Source dossiers, expert review, and comprehension testing remain ahead. Draft questions may change as that work proceeds.</p>
        <a href="/projects/fiqh-compass/corrections/">Send a correction or note <span aria-hidden="true">→</span></a>
      </footer>
    </div>
  </div>
</BaseLayout>

<script>
  /* Links to #axis-index, #faq or an axis open the disclosure that holds them. */
  const openTarget = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    const box = target?.closest("details") ?? (target instanceof HTMLDetailsElement ? target : null);
    if (box) { box.open = true; target!.scrollIntoView(); }
  };
  openTarget();
  window.addEventListener("hashchange", openTarget);
</script>

<style>
  .fiqh-compass {
    --fc-bg: var(--hc-surface-0);
    --fc-ink: var(--hc-text-primary);
    --fc-text: var(--hc-text-secondary);
    --fc-muted: var(--hc-text-tertiary);
    --fc-line: var(--hc-rule-soft);
    --fc-paper: var(--hc-surface-1);
    --fc-accent: var(--hc-gold);
    min-height: 100vh;
    color: var(--fc-ink);
    background: var(--fc-bg);
  }
  .fc-body { padding-bottom: clamp(4rem, 8vw, 6rem); }
  .fc-title { max-width: 18ch; }
  .fiqh-compass .fc-cta { min-height: 44px; border-color: var(--hc-gold); background: var(--hc-gold); color: var(--hc-text-inverse); }
  .fiqh-compass .fc-cta:hover { border-color: var(--hc-gold-bright); background: var(--hc-gold-bright); color: var(--hc-text-inverse); }
  .fc-kicker { margin: 0 0 0.45rem; color: var(--hc-gold); font: 600 0.78rem/1.4 var(--font-ui); letter-spacing: 0.12em; text-transform: uppercase; }

  /* Example statements beside the example result. */
  .fc-preview { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.85fr); gap: clamp(1rem, 3vw, 2rem); align-items: start; }
  .fc-preview__cap { margin: 0 0 0.75rem; color: var(--fc-muted); font: 500 0.88rem/1.5 var(--font-ui); }
  .fc-examples { display: grid; gap: var(--pj-gap); margin: 0; padding: 0; list-style: none; }
  .fc-example__axis { margin: 0 0 0.45rem; color: var(--fc-text); font: 500 0.85rem/1.4 var(--font-ui); }
  .fc-example__axis span { margin-inline-end: 0.35rem; color: var(--fc-accent); font-weight: 600; letter-spacing: 0.06em; }
  .fc-example__prompt { max-width: var(--pj-measure); margin: 0 0 0.85rem; color: var(--fc-ink); font: 500 1.08rem/1.55 var(--font-display); }
  .fc-scale { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; margin: 0; padding: 0; list-style: none; }
  .fc-scale li { display: flex; align-items: center; justify-content: center; min-height: 2.6rem; padding: 0.3rem; border: 1px solid var(--fc-line); border-radius: var(--radius-xs); color: var(--fc-text); font: 500 0.78rem/1.25 var(--font-ui); text-align: center; }
  .fc-scale li:nth-child(n + 6) { border-style: dashed; }
  .fc-more { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; margin-top: 0.4rem; color: var(--hc-gold); font: 500 0.92rem/1.4 var(--font-ui); text-decoration: none; }
  .fc-more:hover { color: var(--hc-gold-bright); }

  /* The example result: a dark card with real dimensions as its axes, labelled as an illustration. */
  .fc-sample { position: sticky; top: calc(var(--pj-top) + 1rem); padding: 1.15rem 1.25rem; }
  .fc-sample__topline, .fc-sample__foot { display: flex; justify-content: space-between; gap: 1rem; color: var(--fc-muted); font: 600 0.78rem/1.45 var(--font-ui); }
  .fc-sample__topline { padding-bottom: 0.75rem; border-bottom: 1px solid var(--fc-line); letter-spacing: 0.06em; text-transform: uppercase; }
  .fc-sample h3 { margin: 0.9rem 0 0.2rem; color: var(--fc-ink); font: 600 1.35rem/1.25 var(--font-display); }
  .fc-sample__caption { margin: 0 0 1rem; color: var(--fc-text); font-size: 0.92rem; }
  .fc-sample__axes { display: grid; gap: 1.05rem; }
  .fc-sample__name { margin: 0 0 0.45rem; color: var(--fc-ink); font: 600 0.9rem/1.35 var(--font-ui); }
  .fc-sample__name span { margin-inline-end: 0.3rem; color: var(--fc-accent); }
  .fc-sample__axes i { position: relative; display: block; height: 3px; background: var(--hc-rule); }
  .fc-sample__axes b { position: absolute; top: 50%; left: var(--marker); width: 13px; height: 13px; border: 2px solid var(--hc-surface-1); border-radius: 50%; background: var(--hc-gold); box-shadow: 0 0 0 1px var(--hc-gold); transform: translate(-50%, -50%); }
  .fc-sample__poles { display: flex; justify-content: space-between; gap: 1rem; margin: 0.45rem 0 0; color: var(--fc-text); font: 400 0.8rem/1.4 var(--font-ui); }
  .fc-sample__poles span:last-child { text-align: right; }
  .fc-sample__coverage { margin: 0.25rem 0 0; color: var(--fc-muted); font: 500 0.8rem/1.4 var(--font-ui); }
  .fc-sample__foot { margin-top: 1.1rem; padding-top: 0.75rem; border-top: 1px solid var(--fc-line); }

  .fc-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border-block: 1px solid var(--fc-line); }
  .fc-steps li { padding: 1rem 1.25rem 1.1rem 0; }
  .fc-steps li + li { padding-left: 1.25rem; border-left: 1px solid var(--fc-line); }
  .fc-steps span, .fc-features span { color: var(--fc-accent); font: 600 0.78rem/1.5 var(--font-ui); letter-spacing: 0.08em; }
  .fc-steps h3, .fc-features h3 { margin: 0.35rem 0 0; color: var(--fc-ink); font: 600 1.05rem/1.4 var(--font-display); }
  .fc-steps p, .fc-features p { max-width: 36ch; margin: 0.3rem 0 0; color: var(--fc-text); font-size: 0.93rem; line-height: 1.6; }

  /* Limits: one slim line of four chips, each opening its own sentence. */
  .fc-limits { display: grid; gap: 0.5rem; margin-top: clamp(2rem, 4vw, 3rem); padding-block: 1rem; border-block: 1px solid var(--fc-line); }
  .fc-limits__title { margin: 0; color: var(--fc-muted); font: 600 0.78rem/1.3 var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; }
  .fc-limits__line { margin: 0; color: var(--fc-text); font-size: 0.98rem; line-height: 1.6; }
  .fc-limits__line b { color: var(--fc-ink); font-weight: 600; }
  .fc-limits__chips { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
  .fc-limit > summary { list-style: none; color: var(--fc-ink); }
  .fc-limit > summary::-webkit-details-marker { display: none; }
  .fc-limit > summary::after { content: ""; width: 0.4rem; height: 0.4rem; border-right: 1.5px solid var(--hc-gold); border-bottom: 1.5px solid var(--hc-gold); transform: translateY(-20%) rotate(45deg); }
  .fc-limit[open] > summary { border-color: var(--hc-gold); }
  .fc-limit[open] > summary::after { transform: translateY(15%) rotate(-135deg); }
  .fc-limit p { max-width: 30ch; margin: 0.4rem 0 0.2rem; color: var(--fc-text); font-size: 0.9rem; line-height: 1.55; }

  .fc-discs { display: grid; gap: var(--pj-gap); }
  .fc-features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 1.5rem; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--fc-line); }
  .fc-features li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.5rem; padding: 0.9rem 0; border-bottom: 1px solid var(--fc-line); }
  .fc-features h3 { margin-top: 0; }
  .fc-result-layers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--pj-gap); margin-top: 1.25rem; }
  .fc-result-layers article { padding: 0.9rem 1rem; border: 1px solid var(--fc-line); border-radius: var(--radius-xs); background: var(--hc-surface-0); }
  .fc-result-layers span { color: var(--fc-accent); font: 600 0.78rem/1.4 var(--font-ui); letter-spacing: 0.08em; }
  .fc-result-layers h3 { margin: 0.5rem 0 0; color: var(--fc-ink); font: 600 1.02rem/1.35 var(--font-display); }
  .fc-result-layers p { margin: 0.3rem 0 0; color: var(--fc-text); font-size: 0.9rem; line-height: 1.55; }

  .fc-axis-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; margin: 0; padding: 0; list-style: none; }
  .fc-axis-list li { display: grid; grid-template-columns: 2.6rem minmax(0, 1fr); gap: 0.5rem; padding: 0.85rem 0; border-bottom: 1px solid var(--fc-line); scroll-margin-top: calc(var(--pj-top) + 1rem); }
  .fc-axis-list__id { color: var(--fc-accent); font: 600 0.82rem/1.6 var(--font-ui); letter-spacing: 0.06em; }
  .fc-axis-list h3 { margin: 0; color: var(--fc-ink); font: 600 1rem/1.4 var(--font-display); }
  .fc-axis-list__range { display: flex; flex-wrap: wrap; gap: 0.15rem 0.45rem; margin: 0.25rem 0 0; color: var(--fc-text); font: 500 0.85rem/1.45 var(--font-ui); }
  .fc-axis-list__range span:nth-child(2) { color: var(--fc-accent); }
  .fc-axis-list__note { margin: 0.3rem 0 0; color: var(--fc-muted); font-size: 0.88rem; line-height: 1.55; }

  .fc-faq__list { border-top: 1px solid var(--fc-line); }
