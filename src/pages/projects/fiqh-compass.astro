---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FiqhCompassNav from "../../components/FiqhCompassNav.astro";
import { axes } from "../../data/fiqh-compass";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Projects", url: "/projects/" },
  { name: "Fiqh Compass", url: "/projects/fiqh-compass/" },
];
---

<BaseLayout
  title="Fiqh Compass | HadithCritic Projects"
  description="An evidence-minded, twelve-dimension prototype for exploring approaches to Islamic legal reasoning."
  canonical="/projects/fiqh-compass/"
  crumbs={crumbs}
>
  <div class="fiqh-compass" id="top">
    <FiqhCompassNav current="overview" />
    <header class="hc-project-hero" aria-labelledby="compass-title">
      <div class="hc-container hc-project-hero__inner">
        <div class="hc-project-hero__main">
          <p class="hc-project-hero__kicker">Fiqh Compass · HadithCritic research project</p>
          <h1 class="hc-project-hero__title" id="compass-title">How do you approach Islamic law?</h1>
          <p class="hc-project-hero__lead">
            Explore how you approach sources, reasoning, authority, and uncertainty in Islamic law. The compass describes answers to a small set of draft questions; it does not identify your religious affiliation, decide which view is correct, or issue a fatwa.
          </p>
          <div class="hc-project-hero__actions">
            <a class="hc-btn" href="/projects/fiqh-compass/quiz/">Begin the quiz <span aria-hidden="true">→</span></a>
            <a class="hc-btn hc-btn--ghost" href="#methodology">How it works</a>
          </div>
        </div>
        <aside class="fc-sample" aria-label="Illustration of the quiz result layout, not a real result">
          <div class="fc-sample__topline"><span>Illustrative result view</span><span>12 dimensions</span></div>
          <h2>Your method profile</h2>
          <p class="fc-sample__caption">A response map with its coverage shown.</p>
          <div class="fc-sample__axes" aria-hidden="true">
            <div><span>Sources of law</span><i><b style="--marker: 62%"></b></i><small>Restricted <span>Accepted</span></small></div>
            <div><span>Analogy</span><i><b style="--marker: 36%"></b></i><small>Limited <span>Qualified</span></small></div>
            <div><span>Context</span><i><b style="--marker: 71%"></b></i><small>Continuity <span>Variation</span></small></div>
          </div>
          <div class="fc-sample__foot"><span>Illustration only</span><span>Coverage accompanies every axis</span></div>
        </aside>
      </div>
    </header>

    <section class="fc-introduction hc-container" id="introduction" aria-labelledby="intro-title">
      <header class="fc-section-heading fc-intro-heading">
        <div>
          <p class="fc-kicker">More than one dimension</p>
          <h2 id="intro-title">A fuller portrait of your legal reasoning.</h2>
        </div>
        <p>Explore principles that are often bundled together. The prototype keeps their questions and results distinct.</p>
      </header>
      <ul class="fc-features">
        <li><span>01</span><div><h3>Sources</h3><p>Which sources can establish binding religious requirements?</p></div></li>
        <li><span>02</span><div><h3>Transmission</h3><p>What evidentiary weight can reports and inherited practice carry?</p></div></li>
        <li><span>03</span><div><h3>Reasoning</h3><p>How might analogy, reason, welfare, and custom inform a judgment?</p></div></li>
        <li><span>04</span><div><h3>Context</h3><p>When can a change in circumstances affect an application?</p></div></li>
        <li><span>05</span><div><h3>Authority</h3><p>How do you approach schools, qualified authorities, and disagreement?</p></div></li>
        <li><span>06</span><div><h3>Uncertainty</h3><p>How should unresolved evidence and possible abrogation be handled?</p></div></li>
      </ul>
      <dl class="fc-protocol" aria-label="Prototype contents">
        <div><dt>Questions</dt><dd>24 draft items</dd></div>
        <div><dt>Dimensions</dt><dd>12 axes</dd></div>
        <div><dt>Time</dt><dd>About 5–8 min</dd></div>
        <div><dt>Privacy</dt><dd>Saved on this device</dd></div>
      </dl>
      <div class="fc-result-layers" aria-label="Planned result layers and current availability">
        <article><span>AVAILABLE IN THIS PROTOTYPE</span><h3>Legal method</h3><p>A provisional map of your answers across twelve draft dimensions.</p></article>
        <article><span>RESEARCH IN PROGRESS</span><h3>Practical positions</h3><p>Precisely defined cases will be compared only after issue evidence is reviewed.</p></article>
        <article><span>NOT AVAILABLE YET</span><h3>Historical affinities</h3><p>Jurist comparisons need source-backed, bounded profiles and adequate coverage.</p></article>
      </div>
    </section>

    <section class="fc-methodology" id="methodology" aria-labelledby="method-title">
      <div class="hc-container">
        <header class="fc-section-heading">
          <div>
            <p class="fc-kicker">A guided process</p>
            <h2 id="method-title">How the Fiqh Compass works</h2>
          </div>
          <p>Move from your answers to a transparent, limited summary.</p>
        </header>
        <ol class="fc-steps">
          <li><span>01</span><h3>Answer the questions</h3><p>Respond to 24 short statements. Skip any item that does not fit your view.</p></li>
          <li><span>02</span><h3>Review twelve dimensions</h3><p>See where your answers fall, with the number of scored items shown beside each axis.</p></li>
          <li><span>03</span><h3>Read the limits</h3><p>Interpret a provisional method profile, not a school label, ruling, or historical match.</p></li>
        </ol>
      </div>
    </section>

    <section class="fc-axis-index hc-container" id="axis-index" aria-labelledby="axis-index-title">
      <header class="fc-section-heading">
        <div>
          <p class="fc-kicker">Question map</p>
          <h2 id="axis-index-title">Twelve dimensions under study</h2>
        </div>
        <span>Two draft items each</span>
      </header>
      <ol class="fc-axis-list">
        {axes.map((axis) => (
          <li id={`axis-${axis.id}`}>
            <span class="fc-axis-list__id">{axis.id}</span>
            <div class="fc-axis-list__body">
              <h3>{axis.title}</h3>
              <p>{axis.note}</p>
              <div class="fc-axis-list__range"><span>{axis.low}</span><span aria-hidden="true">→</span><span>{axis.high}</span></div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="fc-catalog hc-container" aria-labelledby="catalog-title">
      <header class="fc-section-heading">
        <div><p class="fc-kicker">Explore the research</p><h2 id="catalog-title">Browse questions and profile coverage.</h2></div>
        <p>These indexes show the planned research surface. Candidate prompts and names are not scored findings.</p>
      </header>
      <div class="fc-catalog__grid">
        <a class="fc-catalog-card" href="/projects/fiqh-compass/issues/">
          <span class="fc-catalog-card__eyebrow">20 proposed prompts</span>
          <h3>Issue register</h3>
          <p>Browse the bounded legal questions selected for investigation, grouped by their primary dimensions.</p>
          <span class="fc-catalog-card__link">Browse proposed questions <span aria-hidden="true">→</span></span>
        </a>
        <a class="fc-catalog-card" href="/projects/fiqh-compass/profiles/">
          <span class="fc-catalog-card__eyebrow">3 roadmap starting points</span>
          <h3>Candidate profiles</h3>
          <p>See which author profiles the roadmap suggests starting with and what source review remains.</p>
          <span class="fc-catalog-card__link">View profile coverage <span aria-hidden="true">→</span></span>
        </a>
      </div>
      <p class="fc-catalog__note">There is no left–right replacement spectrum here. Legal traditions and authors are not single, uniform ideologies; results stay on separate axes and show how many draft items support each point.</p>
    </section>

    <section class="fc-boundaries hc-container" aria-labelledby="boundaries-title">
      <header class="fc-section-heading">
        <div>
          <p class="fc-kicker">What a compass can’t decide</p>
          <h2 id="boundaries-title">Your answers are not a verdict.</h2>
        </div>
        <p>Different questions need different evidence. This prototype keeps its claims narrow.</p>
      </header>
      <div class="fc-boundary-grid">
        <article><span>01</span><h3>No school label</h3><p>People’s views may cross conventional school boundaries.</p></article>
        <article><span>02</span><h3>No right or wrong score</h3><p>A coordinate describes your responses, not correctness or certainty.</p></article>
        <article><span>03</span><h3>No fatwa</h3><p>General method questions cannot decide what you should do in a case.</p></article>
        <article><span>04</span><h3>No historical match yet</h3><p>Jurist comparisons wait for source-backed profiles and review.</p></article>
      </div>
    </section>

    <section class="fc-faq hc-container" aria-labelledby="faq-title">
      <header class="fc-section-heading">
        <div><p class="fc-kicker">Before you begin</p><h2 id="faq-title">Frequently asked questions</h2></div>
        <p>What this first research prototype can and cannot tell you.</p>
      </header>
      <div class="fc-faq__list">
        <details><summary>What does the quiz measure?</summary><p>It asks about general approaches to legal sources, reasoning, authority, context, and uncertainty. It does not ask you to choose a school or resolve a practical case.</p></details>
        <details><summary>Is the questionnaire validated?</summary><p>No. This is an early prototype with two draft items per dimension. The wording and the axes still need source review and comprehension research.</p></details>
        <details><summary>Will it tell me which school I belong to?</summary><p>No. The result summarizes your answers to these questions. It does not assign a religious identity or claim that one school is internally uniform.</p></details>
        <details><summary>Are my answers sent to HadithCritic?</summary><p>No. Progress is saved in this browser’s local storage. The quiz does not send answers to a server.</p></details>
        <details><summary>Why aren’t historical jurists matched yet?</summary><p>The research project first needs traceable passages, careful attribution, and review for each profile. A school name or a later summary is not enough to create a responsible match.</p></details>
      </div>
    </section>

    <section class="fc-depth" aria-labelledby="depth-title">
      <div class="hc-container fc-depth__inner">
        <div><p class="fc-kicker">Start with the prototype</p><h2 id="depth-title">Twenty-four draft questions. Twelve dimensions.</h2><p>Try the research prototype and see how your answers map onto its provisional dimensions.</p></div>
        <a class="hc-btn" href="/projects/fiqh-compass/quiz/">Begin the quiz <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="fc-feedback hc-container" aria-labelledby="feedback-title">
      <div>
        <p class="fc-kicker">Research status</p>
        <h2 id="feedback-title">The question set is provisional.</h2>
        <p>The axes and first-pass items follow the project roadmap. Source dossiers, expert review, and comprehension testing remain ahead. Draft questions may change as that work proceeds.</p>
      </div>
      <a class="hc-btn hc-btn--ghost" href="/projects/fiqh-compass/corrections/">Send a correction or note <span aria-hidden="true">→</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .fiqh-compass {
    --fc-bg: var(--hc-surface-0);
    --fc-ink: var(--hc-text-primary);
    --fc-text: var(--hc-text-secondary);
    --fc-muted: var(--hc-text-tertiary);
    --fc-line: var(--hc-rule-soft);
    --fc-paper: var(--hc-surface-2);
    --fc-green: var(--hc-gold);
    --fc-green-soft: var(--hc-gold-bright);
    --fc-accent: var(--hc-gold);
    min-height: 100vh;
    padding-bottom: clamp(4rem, 8vw, 7rem);
    color: var(--fc-ink);
    background: var(--fc-bg);
  }
  .fiqh-compass .hc-project-hero { overflow: hidden; background: linear-gradient(90deg, rgba(15, 15, 16, 0.98) 0%, rgba(15, 15, 16, 0.9) 43%, rgba(15, 15, 16, 0.28) 100%), url('/images/hadith-corpus-art.webp') center 57% / cover, var(--hc-fixed-black); border-color: var(--hc-rule); color: var(--hc-fixed-parchment); }
  .fiqh-compass .hc-project-hero::before { background: var(--hc-gold); opacity: 0.72; }
  .fiqh-compass .hc-project-hero__inner { grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.8fr); gap: clamp(2rem, 7vw, 6rem); padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem); }
  .fiqh-compass .hc-project-hero__kicker, .fc-kicker { color: var(--hc-gold); }
  .fiqh-compass .hc-project-hero__kicker { color: var(--hc-fixed-parchment-deep); }
  .fiqh-compass .hc-project-hero__title { max-width: 12ch; color: var(--hc-fixed-parchment); font: 600 clamp(3.1rem, 7.2vw, 6rem)/1.02 var(--font-editorial); letter-spacing: -0.01em; }
  .fiqh-compass .hc-project-hero__lead { max-width: 55ch; color: var(--hc-fixed-muted); font-size: clamp(1.02rem, 1.5vw, 1.14rem); }
  .fiqh-compass .hc-project-hero__actions { border-color: var(--fc-line); }
  .fiqh-compass .hc-btn { min-height: 44px; border-color: var(--hc-gold); background: var(--hc-gold); color: var(--hc-text-inverse); }
  .fiqh-compass .hc-btn:hover { border-color: var(--hc-gold-bright); background: var(--hc-gold-bright); color: var(--hc-text-inverse); }
  .fiqh-compass .hc-project-hero .hc-btn:not(.hc-btn--ghost) { border-color: var(--hc-fixed-parchment-deep); background: var(--hc-fixed-parchment-deep); color: var(--hc-fixed-parchment-ink); }
  .fiqh-compass .hc-project-hero .hc-btn:not(.hc-btn--ghost):hover { border-color: var(--hc-fixed-parchment); background: var(--hc-fixed-parchment); color: var(--hc-fixed-parchment-ink); }
  .fiqh-compass .hc-project-hero .hc-btn--ghost { border-color: rgba(216, 177, 102, 0.62); background: rgba(15, 15, 16, 0.38); color: var(--hc-fixed-parchment); }
  .fiqh-compass .hc-project-hero .hc-btn--ghost:hover { border-color: var(--hc-gold-bright); background: rgba(15, 15, 16, 0.7); color: var(--hc-fixed-parchment); }
  .fc-sample { --fc-ink: var(--hc-fixed-parchment-ink); --fc-text: #4e463b; --fc-muted: #63594b; --fc-line: rgba(92, 66, 34, 0.24); --fc-paper: var(--hc-fixed-parchment); align-self: center; padding: clamp(1.2rem, 2.5vw, 1.8rem); border: 1px solid var(--hc-gold); border-radius: var(--radius-xs); background: var(--hc-fixed-parchment); box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, 0.34); }
  .fc-sample__topline, .fc-sample__foot { display: flex; justify-content: space-between; gap: 1rem; color: var(--fc-muted); font: 600 0.75rem/1.45 var(--font-ui); }
  .fc-sample__topline { padding-bottom: 0.85rem; border-bottom: 1px solid var(--fc-line); text-transform: uppercase; letter-spacing: 0.06em; }
  .fc-sample h2 { margin: 1rem 0 0.25rem; color: var(--fc-ink); font: 600 clamp(1.3rem, 2vw, 1.7rem)/1.25 var(--font-critical); }
  .fc-sample__caption { margin: 0 0 1.1rem; color: var(--fc-text); font-size: 0.92rem; }
  .fc-sample__axes { display: grid; gap: 0.85rem; }
  .fc-sample__axes > div { display: grid; gap: 0.35rem; color: var(--fc-ink); font-size: 0.88rem; }
  .fc-sample__axes i { position: relative; height: 5px; background: var(--fc-line); }
  .fc-sample__axes i::before { position: absolute; inset: 0 auto 0 0; width: var(--marker); background: #8c682e; content: ""; }
  .fc-sample__axes b { position: absolute; z-index: 1; top: 50%; left: var(--marker); width: 12px; height: 12px; border: 2px solid var(--fc-paper); border-radius: 50%; background: #8c682e; box-shadow: 0 0 0 1px #8c682e; transform: translate(-50%, -50%); }
  .fc-sample__axes small { display: flex; justify-content: space-between; color: var(--fc-muted); font-size: 0.75rem; }
  .fc-sample__foot { margin-top: 1.1rem; padding-top: 0.8rem; border-top: 1px solid var(--fc-line); text-transform: none; letter-spacing: 0; }
  .fc-introduction, .fc-axis-index, .fc-catalog, .fc-boundaries, .fc-faq { padding-block: clamp(4rem, 8vw, 7rem); scroll-margin-top: 6rem; }
  .fc-introduction, .fc-axis-index, .fc-catalog, .fc-faq { border-top: 1px solid var(--fc-line); }
  .fc-kicker { margin: 0 0 0.55rem; font: 600 0.75rem/1.4 var(--font-ui); letter-spacing: 0.13em; text-transform: uppercase; }
  .fc-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.8rem; }
  .fc-section-heading h2, .fc-results h2, .fc-feedback h2 { max-width: 22ch; margin: 0; color: var(--fc-ink); font: 600 clamp(1.9rem, 3.6vw, 3rem)/1.08 var(--font-editorial); letter-spacing: -0.01em; text-wrap: balance; }
  .fc-section-heading > p { max-width: 38ch; margin: 0; color: var(--fc-text); line-height: 1.65; }
  .fc-features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--fc-line); }
  .fc-features li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.75rem; min-height: 7.4rem; padding: 1.1rem 1rem 1.1rem 0; border-bottom: 1px solid var(--fc-line); }
  .fc-features li > span, .fc-steps li > span, .fc-boundary-grid article > span { color: var(--fc-accent); font: 600 0.75rem/1.5 var(--font-ui); letter-spacing: 0.08em; }
  .fc-features h3, .fc-steps h3, .fc-boundary-grid h3 { margin: 0; color: var(--fc-ink); font: 600 1rem/1.4 var(--font-critical); }
  .fc-features p, .fc-steps p, .fc-boundary-grid p { margin: 0.25rem 0 0; color: var(--fc-text); font-size: 0.9rem; line-height: 1.55; }
  .fc-result-layers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; margin-top: 2rem; }
  .fc-result-layers article { padding: 1.05rem 1.15rem; border: 1px solid var(--fc-line); border-radius: var(--radius-xs); background: var(--fc-paper); }
  .fc-result-layers article > span, .fc-catalog-card__eyebrow { color: var(--fc-accent); font: 600 0.75rem/1.4 var(--font-ui); letter-spacing: 0.08em; text-transform: uppercase; }
  .fc-result-layers h3 { margin: 0.65rem 0 0; color: var(--fc-ink); font: 600 1.05rem/1.35 var(--font-display); }
  .fc-result-layers p { margin: 0.3rem 0 0; color: var(--fc-text); font-size: 0.87rem; line-height: 1.55; }
  .fc-protocol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 2.2rem 0 0; border-top: 1px solid var(--fc-line); }
  .fc-protocol div { padding: 0.9rem 1rem 0.9rem 0; border-bottom: 1px solid var(--fc-line); }
  .fc-protocol dt { color: var(--fc-muted); font: 600 0.75rem/1.3 var(--font-ui); letter-spacing: 0.09em; text-transform: uppercase; }
  .fc-protocol dd { margin: 0.25rem 0 0; color: var(--fc-ink); font-size: 0.95rem; }
  .fc-methodology { padding-block: clamp(4rem, 8vw, 7rem); border-block: 1px solid var(--fc-line); background: var(--hc-surface-1); color: var(--fc-ink); }
  .fc-methodology .fc-kicker { color: var(--hc-gold); }
  .fc-methodology .fc-section-heading h2 { color: var(--fc-ink); }
  .fc-methodology .fc-section-heading > p { color: var(--fc-text); }
  .fc-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--fc-line); }
  .fc-steps li { min-height: 11rem; padding: 1.25rem 1.5rem 0 0; }
  .fc-steps li + li { padding-left: 1.5rem; border-left: 1px solid var(--fc-line); }
  .fc-steps li > span { color: var(--hc-gold); }
  .fc-methodology .fc-steps h3 { margin-top: 1rem; color: var(--fc-ink); font-size: 1.15rem; }
  .fc-methodology .fc-steps p { max-width: 33ch; margin-top: 0.45rem; color: var(--fc-text); line-height: 1.65; }
  .fc-axis-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.8rem; margin: 0; padding: 0; list-style: none; }
  .fc-axis-list li { min-width: 0; padding: 1.05rem; border: 1px solid var(--fc-line); border-radius: var(--radius-xs); background: var(--fc-paper); }
  .fc-axis-list__id { color: var(--fc-accent); font: 600 0.75rem/1.4 var(--font-ui); letter-spacing: 0.07em; }
  .fc-axis-list__body h3 { margin: 0.45rem 0 0; color: var(--fc-ink); font: 600 1rem/1.4 var(--font-display); }
  .fc-axis-list__body p { min-height: 4.5rem; margin: 0.35rem 0 0.8rem; color: var(--fc-text); font-size: 0.85rem; line-height: 1.55; }
  .fc-axis-list__range { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.35rem; align-items: start; padding-top: 0.7rem; border-top: 1px solid var(--fc-line); color: var(--fc-muted); font: 500 0.75rem/1.45 var(--font-ui); }
  .fc-axis-list__range span:last-child { text-align: right; }
  .fc-axis-list__range span:nth-child(2) { color: var(--fc-accent); }
  .fc-catalog { border-top: 1px solid var(--fc-line); }
  .fc-catalog__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem; }
  .fc-catalog-card { display: flex; flex-direction: column; min-height: 14rem; padding: clamp(1.2rem, 2vw, 1.7rem); border: 1px solid var(--fc-line); border-radius: var(--radius-xs); background: var(--fc-paper); color: var(--fc-ink); text-decoration: none; transition: border-color 150ms ease, transform 150ms ease; }
  .fc-catalog-card:hover { transform: translateY(-2px); border-color: var(--fc-accent); }
  .fc-catalog-card h3 { margin: 0.7rem 0 0; font: 600 1.35rem/1.3 var(--font-display); }
  .fc-catalog-card p { max-width: 52ch; margin: 0.45rem 0 1.2rem; color: var(--fc-text); line-height: 1.6; }
  .fc-catalog-card__link { display: flex; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 0.8rem; border-top: 1px solid var(--fc-line); color: var(--fc-ink); font: 600 0.83rem/1.5 var(--font-ui); }
  .fc-catalog__note { max-width: 78ch; margin: 1.4rem 0 0; color: var(--fc-muted); font-size: 0.86rem; line-height: 1.65; }
  .fc-boundaries { border-top: 1px solid var(--fc-line); }
  .fc-boundary-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; }
  .fc-boundary-grid article { min-height: 10rem; padding: 1.1rem; border: 1px solid var(--fc-line); border-radius: var(--radius-xs); background: color-mix(in srgb, var(--fc-accent) 8%, var(--fc-paper)); }
  .fc-boundary-grid h3 { margin-top: 1.2rem; }
  .fc-faq__list { border-top: 1px solid var(--fc-line); }
  .fc-faq details { border-bottom: 1px solid var(--fc-line); }
  .fc-faq summary { display: flex; justify-content: space-between; gap: 1rem; min-height: 3.5rem; align-items: center; color: var(--fc-ink); font: 600 0.95rem/1.45 var(--font-display); cursor: pointer; list-style: none; }
  .fc-faq summary::-webkit-details-marker { display: none; }
  .fc-faq summary::after { content: "+"; color: var(--fc-accent); font: 500 1.2rem/1 var(--font-display); }
  .fc-faq details[open] summary::after { content: "−"; }
