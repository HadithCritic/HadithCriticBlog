---
/* The history library: the early Arabic histories open to read in English, in
   order of their authors' deaths. Each work leads to its own title page
   (history/[book]/index.astro). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HistoryFonts from '../../components/history/HistoryFonts.astro';
import HistorySourceCard from '../../components/history/HistorySourceCard.astro';
import { historySources } from '../../data/history/history';
import { bookFacts, loadBook, type BookFacts } from '../../lib/history-library';
import '../../styles/history.css';

const facts = new Map<string, BookFacts>();
for (const source of historySources) {
  if (source.reader) facts.set(source.id, bookFacts(await loadBook(source.reader.slug)));
}
const open = [...facts.values()];
const words = open.reduce((total, item) => total + item.words, 0);
const pages = open.reduce((total, item) => total + item.pages, 0);
const earliest = historySources[0].died;
const latest = historySources[historySources.length - 1].died;
---

<BaseLayout
  title="History (Tārīkh) | HadithCritic"
  description="The earliest Arabic histories of Islam in English. Each book is read a page at a time, laid out the way its author arranged it."
  image="/images/history/archive-hero-v2-1600.webp"
  imageAlt="A painted early Islamic river landscape with a provincial town, cultivated land and small groups of travellers."
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Projects', url: '/projects/' }, { name: 'History', url: '/projects/history/' }]}
>
  <HistoryFonts slot="head" />
  <div class="hx hx-home history-page" data-hx-home>
    <header class="history-hero" aria-labelledby="history-title">
      <div class="hx-wrap history-hero__inner">
        <div class="history-hero__copy">
          <p class="hx-label">Early histories in translation</p>
          <h1 id="history-title">History <span>(Tārīkh)</span></h1>
          <p class="history-hero__lead">The earliest Arabic histories of Islam, in English. A chronicle is read year by year, a conquest history region by region, a book of lists one list at a time: each work keeps the order its author gave it.</p>
          <nav class="history-hero__actions" aria-label="History project sections">
            <a class="hx-btn hx-btn--solid" href="#sources">Browse the books <span aria-hidden="true">↓</span></a>
          </nav>
        </div>
        <dl class="history-hero__facts">
          <div><dt>Open to read</dt><dd>{open.length} of {historySources.length} works</dd></div>
          <div><dt>Authors died</dt><dd>{earliest.ah} to {latest.ah} AH</dd></div>
          <div><dt>In English</dt><dd>{(words / 1e6).toFixed(1)} million words</dd></div>
          <div><dt>Reading pages</dt><dd>{pages.toLocaleString('en-US')}</dd></div>
        </dl>
      </div>
      <figure class="hx-wrap history-hero__plate">
        <img src="/images/history/archive-hero-v2-1600.webp" srcset="/images/history/archive-hero-v2-800.webp 800w, /images/history/archive-hero-v2-1600.webp 1600w" sizes="(min-width: 1280px) 1200px, calc(100vw - 2.5rem)" width="1600" height="900" alt="" fetchpriority="high" decoding="async" />
      </figure>
    </header>

    <section id="sources" aria-labelledby="sources-title" class="history-library">
      <div class="hx-wrap">
        <header class="history-library__head">
          <h2 id="sources-title" class="hx-h2">The library</h2>
          <p>In the order their authors died. The date beside each work is its author’s death date.</p>
        </header>
        <ol class="history-shelf" aria-label="Historical works">
          {historySources.map((source) => <li><HistorySourceCard source={source} facts={facts.get(source.id) ?? null} /></li>)}
        </ol>
        <p class="history-art-note">Interpretive illustrations evoke each work’s subjects and settings; they are not evidence for the historical claims in the texts.</p>
      </div>
    </section>

    <section class="history-contribute" aria-labelledby="history-closing-title">
      <div class="hx-wrap">
        <div class="history-closing">
          <div>
            <h2 id="history-closing-title" class="hx-h2">Contribute to the archive.</h2>
            <p>Editions, translations and corrections for these works are welcome, as are leads on other early histories.</p>
          </div>
          <a class="hx-btn history-text-link" href="/contact/?topic=History%20project#contact-form">Contribute to the archive <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <dialog class="history-viewer" data-history-viewer aria-labelledby="history-viewer-caption">
      <figure>
        <img alt="" width="1600" height="900" />
        <figcaption>
          <span id="history-viewer-caption"></span>
          <span>Interpretive painting</span>
        </figcaption>
      </figure>
      <form method="dialog">
        <button class="history-viewer__close" type="submit">Close <span aria-hidden="true">✕</span></button>
      </form>
    </dialog>
  </div>
</BaseLayout>

<script>
  import '../../lib/history-contents.js';

  // Progressive enhancement: without script each painting is a plain link to
  // the full image. With it, the image opens in a modal dialog on the page.
  const viewer = document.querySelector<HTMLDialogElement>('[data-history-viewer]');
  const image = viewer?.querySelector('img');
  const caption = viewer?.querySelector('#history-viewer-caption');
  if (viewer && image && caption && typeof viewer.showModal === 'function') {
    let trigger: HTMLAnchorElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-history-zoom]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        trigger = link;
        image.src = link.href;
        image.alt = link.querySelector('img')?.alt ?? '';
        caption.textContent = link.dataset.caption ?? '';
        viewer.showModal();
      });
    });
    viewer.addEventListener('close', () => trigger?.focus());
    // A click on the backdrop lands on the dialog itself, not its contents.
    viewer.addEventListener('click', event => {
      if (event.target === viewer) viewer.close();
    });
  }
</script>
