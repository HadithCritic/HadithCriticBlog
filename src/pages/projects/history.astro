---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HistorySourceCard from '../../components/history/HistorySourceCard.astro';
import { deathDate, historySources } from '../../data/history';
import '../../styles/house.css';
import '../../styles/history.css';

const tools = [
  {
    title: 'Read the history',
    body: 'Follow chapters and passages in their original order, with facing Arabic and English, page references and translation credits.',
  },
  {
    title: 'Trace time and place',
    body: 'Explore dated events and locations through timelines and maps that link back to the passages behind them.',
  },
  {
    title: 'Compare the accounts',
    body: 'Read different sources on the same event side by side, keeping their wording, chronology and disagreements visible.',
  },
];
---

<BaseLayout
  title="History (Tārīkh) | HadithCritic"
  description="A source library in preparation: digitized historical works in Arabic and English, with plans to explore events, places and parallel accounts."
  image="/images/history/archive-hero-v2-1600.webp"
  imageAlt="A painted early Islamic river landscape with a provincial town, cultivated land and small groups of travellers."
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Projects', url: '/projects/' }, { name: 'History', url: '/projects/history/' }]}
>
  <div class="hc-page hc-plate history-page">
    <header class="history-hero" aria-labelledby="history-title">
      <img class="history-hero__art" src="/images/history/archive-hero-v2-1600.webp" srcset="/images/history/archive-hero-v2-800.webp 800w, /images/history/archive-hero-v2-1600.webp 1600w" sizes="100vw" width="1600" height="900" alt="" fetchpriority="high" decoding="async" />
      <div class="hc-container history-hero__inner">
        <div class="history-hero__copy">
          <p class="history-kicker">Historical sources in translation</p>
          <h1 id="history-title">History <span>(Tārīkh)</span></h1>
          <p class="history-hero__arabic" lang="ar" dir="rtl">التاريخ</p>
          <span class="hc-ornament history-hero__ornament" aria-hidden="true"></span>
          <p class="history-hero__lead">Explore translated histories through their people, places and events, with every account anchored to its source.</p>
          <nav class="history-hero__actions" aria-label="History project sections">
            <a class="hc-btn" href="#sources">Explore the source library <span aria-hidden="true">→</span></a>
            <a class="hc-btn hc-btn--ghost" href="#approach">The reading approach</a>
          </nav>
        </div>
      </div>
    </header>

    <section class="history-chronology" aria-labelledby="chronology-title">
      <div class="hc-container">
        <div class="history-chronology__head">
          <div>
            <p class="history-section-label">Chronology</p>
            <h2 id="chronology-title">A century of <span>historical writing</span></h2>
          </div>
          <ul class="hc-figures history-chronology__figures" aria-label="Project scope and availability">
            <li>{historySources.length} works in the archive</li>
            <li>207–310 AH</li>
            <li>Arabic &amp; English</li>
            <li>Full-text reader in preparation</li>
          </ul>
        </div>
        <div class="history-timeline">
          <ol class="history-timeline__events" aria-label="The sources by their authors' death dates">
            {historySources.map(source => (
              <li>
                <a href={`#${source.id}`}>
                  <span class="history-timeline__date">{deathDate(source)}</span>
                  <span class="history-timeline__author">{source.author}</span>
                  <span class="history-timeline__work">{source.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <p class="history-timeline__note">Death dates in hijrī and common-era years. Select an author to go to their work.</p>
      </div>
    </section>

    <section id="sources" aria-labelledby="sources-title" class="history-library">
      <div class="hc-container">
        <header class="hc-head history-library__head">
          <div class="hc-head__main">
            <p class="hc-head__kicker">The source library</p>
            <h2 id="sources-title" class="hc-head__title">Begin with <span>the work itself</span></h2>
            <p class="hc-head__note">Preserve its sequence, its edition and the voice of its translation. The library is taking shape: full texts, timelines and maps are not yet published, and each record states what is available today.</p>
          </div>
        </header>
        <ol class="history-shelf" aria-label="Historical works">
          {historySources.map((source, index) => <li><HistorySourceCard source={source} index={index} /></li>)}
        </ol>
        <p class="history-art-note">Interpretive illustrations evoke each work’s subjects and settings; they are not evidence for the historical claims in the texts.</p>
      </div>
    </section>

    <section id="approach" aria-labelledby="approach-title" class="hc-band hc-band--soft history-approach">
      <div class="hc-container">
        <header class="hc-head">
          <div class="hc-head__main">
            <p class="hc-head__kicker">Planned reading tools</p>
            <h2 id="approach-title" class="hc-head__title">History, with its <span>sources in view</span></h2>
            <p class="hc-head__note">The project will bring digitized translations into a continuous reading experience, then connect their accounts across time and place.</p>
          </div>
          <p class="history-approach__status">These capabilities are in preparation.</p>
        </header>
        <ol class="history-tools">
          {tools.map((tool, index) => (
            <li>
              <span class="history-tools__step" aria-hidden="true">{['I', 'II', 'III'][index]}</span>
              <h3>{tool.title}</h3>
              <p>{tool.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="history-principles" aria-labelledby="method-title">
      <div class="hc-container history-principles__inner">
        <div class="history-principles__copy">
          <p class="history-section-label">Research principles</p>
          <h2 id="method-title">The text comes first.</h2>
          <p>Each edition will retain its own identity. Translation method, review status, page references and gaps will be stated explicitly. Dates and places inferred for a visualization will be distinguished from what the source says.</p>
        </div>
        <dl class="history-provenance" aria-label="The record each source will retain">
          <div><dt>Source identity</dt><dd>The work, the edition, the passage.</dd></div>
          <div><dt>Translation record</dt><dd>The method, the credits, the review status.</dd></div>
          <div><dt>Historical evidence</dt><dd>Source wording kept distinct from editorial reconstruction.</dd></div>
        </dl>
      </div>
      <div class="hc-container">
        <div class="hc-closing hc-parchment history-closing">
          <figure class="hc-closing__plate" style="--plate-focus: 62% 60%">
            <img src="/images/history/archive-hero-v2-800.webp" alt="" width="800" height="450" loading="lazy" decoding="async" />
          </figure>
          <div class="hc-closing__copy">
            <h2 id="history-closing-title" class="hc-closing__title">Contribute to the archive.</h2>
            <p class="hc-closing__lead">Editions, translations and corrections for these works are welcome, as are leads on other early histories.</p>
          </div>
          <div class="hc-closing__actions">
            <a class="hc-ink-btn history-text-link" href="/contact/?topic=History%20project#contact-form">Contribute to the archive <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <dialog class="history-viewer hc-plate" data-history-viewer aria-labelledby="history-viewer-caption">
      <figure>
        <img alt="" width="1600" height="900" />
        <figcaption>
          <span id="history-viewer-caption"></span>
          <span>Interpretive painting</span>
        </figcaption>
      </figure>
      <form method="dialog">
        <button class="history-viewer__close" type="submit">Close <span aria-hidden="true">✕</span></button>
      </form>
    </dialog>
  </div>
</BaseLayout>

<script>
  // Progressive enhancement: without script each painting is a plain link to
  // the full image. With it, the image opens in a modal dialog on the page.
  const viewer = document.querySelector<HTMLDialogElement>('[data-history-viewer]');
  const image = viewer?.querySelector('img');
  const caption = viewer?.querySelector('#history-viewer-caption');
  if (viewer && image && caption && typeof viewer.showModal === 'function') {
    let trigger: HTMLAnchorElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-history-zoom]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        trigger = link;
        image.src = link.href;
        image.alt = link.querySelector('img')?.alt ?? '';
        caption.textContent = link.dataset.caption ?? '';
        viewer.showModal();
      });
    });
    viewer.addEventListener('close', () => trigger?.focus());
    // A click on the backdrop lands on the dialog itself, not its contents.
    viewer.addEventListener('click', event => {
      if (event.target === viewer) viewer.close();
    });
  }
</script>
