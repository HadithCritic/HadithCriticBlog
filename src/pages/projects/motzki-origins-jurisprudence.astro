    box-shadow: 0 0 6px rgba(223, 190, 125, 0.6);
  }

  .rail-toc-sublist {
    list-style: none;
    margin: 0.15rem 0 0.35rem 1.6rem;
    padding-left: 0.65rem;
    border-left: 1px solid rgba(223, 190, 125, 0.2);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .rail-toc-sublink {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: "Gentium Plus", Georgia, serif;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--hc-text-tertiary);
    text-decoration: none;
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    transition: color 140ms ease, background 140ms ease;
  }

  .rail-toc-bullet {
    color: var(--hc-gold-dim);
    font-size: 0.82rem;
  }

  .rail-toc-sublink:hover {
    color: var(--hc-gold-soft);
    background: rgba(223, 190, 125, 0.05);
  }

  .rail-toc-sublink.is-active {
    color: var(--hc-gold-bright, #ebd5a3);
    font-weight: 700;
    background: rgba(223, 190, 125, 0.1);
  }

  .rail-toc-sublink.is-active .rail-toc-bullet {
    color: var(--hc-gold);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     3. TYPESET ACADEMIC READING FOLIO (Gentium Plus)
     ═══════════════════════════════════════════════════════════════════════════ */
  .monograph-reading-folio {
    min-width: 0;
    width: 100%;
    grid-column: 2;
    grid-row: 1;
    background: var(--hc-surface-0);
    border: 1px solid var(--hc-rule);
    outline: 1px solid rgba(223, 190, 125, 0.15);
    outline-offset: -5px;
    border-radius: var(--radius-xs, 4px);
    padding: clamp(2rem, 4vw, 3.75rem) clamp(1.5rem, 3.5vw, 3.25rem);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    font-family: "Gentium Plus", Georgia, serif;
    color: var(--hc-text-primary);
  }

  /* Running Folio Header Bar */
  .folio-running-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
    padding-bottom: 0.65rem;
    margin-bottom: 3.5rem;
    position: relative;
  }

  .folio-running-head::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background:
      linear-gradient(var(--hc-rule-strong, var(--hc-rule)), var(--hc-rule-strong, var(--hc-rule))) top / 100% 1px no-repeat,
      linear-gradient(var(--hc-rule), var(--hc-rule)) bottom / 100% 1px no-repeat;
  }

  .running-head-center {
    font-family: "Gentium Plus", serif;
    font-style: italic;
    letter-spacing: normal;
    text-transform: none;
    font-size: 0.88rem;
    color: var(--hc-text-secondary);
  }

  /* Scholarly Body Typography */
  .monograph-scholarly-body {
    font-family: "Gentium Plus", Georgia, serif;
    font-size: clamp(1.12rem, 1.2vw + 0.1rem, 1.24rem);
    line-height: 1.82;
    color: var(--hc-text-primary);
  }

  .monograph-section {
    margin-bottom: 4.5rem;
    position: relative;
    scroll-margin-top: calc(var(--site-header-height, 73px) + 2rem);
  }

  /* Section Headings */
  .section-heading {
    scroll-margin-top: calc(var(--site-header-height, 73px) + 2rem);
    margin: 4.5rem 0 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--hc-rule);
    position: relative;
    font-family: "Gentium Plus", serif;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    text-wrap: balance;
  }

  .section-heading::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 56px;
    height: 2px;
    background: var(--hc-gold);
    box-shadow: 0 0 10px rgba(223, 190, 125, 0.45);
  }

  .heading-roman {
    font-family: "Gentium Plus", serif;
    font-size: clamp(1.45rem, 2.1vw, 1.95rem);
    font-weight: 700;
    color: var(--hc-gold);
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .heading-title {
    font-family: "Gentium Plus", serif;
    font-size: clamp(1.6rem, 2.3vw, 2.15rem);
    font-weight: 700;
    line-height: 1.22;
    color: var(--hc-text-primary);
  }

  .sub-heading {
    scroll-margin-top: calc(var(--site-header-height, 73px) + 2rem);
    margin: 3.25rem 0 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed rgba(216, 177, 102, 0.28);
    font-family: "Gentium Plus", serif;
    font-size: clamp(1.25rem, 1.7vw, 1.55rem);
    font-weight: 700;
    line-height: 1.35;
    color: var(--hc-text-primary);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  /* Paragraphs and Dropcap: Pure scholarly typesetting without mid-word cutting */
  .monograph-scholarly-body p {
    margin: 0 0 1.65rem;
    text-align: justify;
    text-justify: inter-word;
    word-break: normal;
    overflow-wrap: break-word;
    hyphens: none;
    text-indent: 1.75em;
  }

  .monograph-scholarly-body p.is-continuation,
  .monograph-scholarly-body p.has-dropcap {
    text-indent: 0;
  }

  .monograph-scholarly-body p.is-continuation {
    margin-top: -0.65rem;
  }

  @media (max-width: 640px) {
    .monograph-scholarly-body p {
      text-align: left;
      text-indent: 1.25em;
    }

    .monograph-scholarly-body p.is-continuation,
    .monograph-scholarly-body p.has-dropcap {
      text-indent: 0;
    }
  }

  .has-dropcap {
    position: relative;
    overflow: visible;
  }

  .illuminated-dropcap {
    float: left;
    font-family: "Gentium Plus", serif;
    font-size: 3.8rem;
    line-height: 0.76;
    margin: 0.08em 0.2em 0.05em 0;
    padding: 0.04em 0.12em 0.02em;
    color: var(--hc-gold);
    font-weight: 700;
    text-shadow: 0 2px 10px rgba(223, 190, 125, 0.3);
  }



  /* Scholarly Lead Points & Callouts — set as a printed pull-quote,
     not a colored-left-border "infobox" card. */
  .monograph-scholarly-body p.monograph-lead-point,
  .monograph-scholarly-body p.monograph-callout-text {
    position: relative;
    margin: 2.5rem auto;
    max-width: 92%;
    padding: 1.5rem 2.75rem;
    font-style: italic;
    text-align: center;
    text-align-last: center;
    text-indent: 0;
  }

  .monograph-lead-point {
    font-size: 1.22rem;
    line-height: 1.6;
  }

  .monograph-callout-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--hc-text-secondary);
  }

  .monograph-lead-point::before,
  .monograph-callout-text::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    width: 2.5rem;
    height: 3px;
    transform: translateX(-50%);
    background:
      linear-gradient(var(--hc-rule-strong, var(--hc-rule)), var(--hc-rule-strong, var(--hc-rule))) top / 100% 1px no-repeat,
      linear-gradient(var(--hc-rule), var(--hc-rule)) bottom / 100% 1px no-repeat;
  }

  .monograph-lead-point::after,
  .monograph-callout-text::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 2.5rem;
    height: 3px;
    transform: translateX(-50%);
    background:
      linear-gradient(var(--hc-rule-strong, var(--hc-rule)), var(--hc-rule-strong, var(--hc-rule))) top / 100% 1px no-repeat,
      linear-gradient(var(--hc-rule), var(--hc-rule)) bottom / 100% 1px no-repeat;
  }

  .monograph-lead-point strong,
  .monograph-callout-text strong {
    font-style: normal;
    color: var(--hc-gold);
    font-weight: 700;
  }

  /* Footnote Reference Links */
  .fn-ref-wrap {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 0;
    vertical-align: baseline;
    position: relative;
    top: -0.45em;
    margin-left: 1px;
  }

  .fn-anchor {
    color: var(--hc-gold);
    text-decoration: none;
    padding: 0.1em 0.3em;
    border-radius: 2px;
    transition: background 160ms ease, color 160ms ease;
  }

  .fn-anchor:hover,
  .fn-anchor:focus {
    color: #ffffff;
    background: var(--hc-gold);
  }

  /* Manuscript Foundations Panel */
  .monograph-manuscript-panel {
    margin: 2.25rem 0;
    padding: 1.75rem 2rem;
    background: color-mix(in srgb, var(--hc-surface-1) 90%, transparent);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 4px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  .panel-header {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hc-gold);
    margin-bottom: 1.15rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--hc-rule);
  }

  .panel-list {
    margin: 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  .panel-list li {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--hc-text-secondary);
  }

  .panel-list strong {
    color: var(--hc-text-primary);
  }

  /* Riwāyāt Monograph Ledger */
  .monograph-riwaya-ledger {
    margin: 2.5rem 0;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 4px);
    background: color-mix(in srgb, var(--hc-surface-1) 85%, transparent);
    overflow: hidden;
  }

  .riwaya-ledger-title {
    padding: 0.85rem 1.25rem;
    background: color-mix(in srgb, var(--hc-surface-2) 90%, transparent);
    border-bottom: 1px solid var(--hc-rule);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .riwaya-ledger-entry {
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--hc-rule);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1.25rem;
    row-gap: 0.45rem;
    align-items: start;
  }

  .riwaya-ledger-entry:last-child {
    border-bottom: none;
  }

  .entry-strand {
    grid-row: 1 / span 2;
    font-family: "Gentium Plus", serif;
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--hc-gold);
    line-height: 1.3;
    padding-right: 1.25rem;
    border-right: 1px solid var(--hc-rule);
    white-space: nowrap;
  }

  .entry-path {
    font-family: "Gentium Plus", serif;
    font-size: 1.02rem;
    font-weight: 700;
    font-style: italic;
    color: var(--hc-text-primary);
    line-height: 1.45;
  }

  .entry-scope {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--hc-text-secondary);
  }

  @media (max-width: 560px) {
    .riwaya-ledger-entry {
      grid-template-columns: 1fr;
    }

    .entry-strand {
      grid-row: auto;
      border-right: none;
      padding-right: 0;
      padding-top: 0;
      white-space: normal;
    }
  }

  /* Informant Share Matrix: 5-across unified row on desktop */
  .monograph-share-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.85rem;
    margin: 2rem 0;
  }

  @media (max-width: 900px) {
    .monograph-share-grid {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }
  }

  .share-card {
    background: color-mix(in srgb, var(--hc-surface-1) 90%, transparent);
    border: 1px solid var(--hc-rule);
    border-top: 2px solid var(--hc-gold-dim);
    border-radius: 0 0 var(--radius-xs, 4px) var(--radius-xs, 4px);
    padding: 1.15rem 0.75rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .share-card__name {
    font-family: "Gentium Plus", serif;
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--hc-text-primary);
    line-height: 1.25;
  }

  .share-card__pct {
    font-family: "Gentium Plus", serif;
    font-size: 2.1rem;
    font-weight: 700;
    color: var(--hc-gold);
    line-height: 1.1;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .share-card__note {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
    line-height: 1.3;
  }

  /* Profile Dossiers: Balanced 2x2 grid */
  .monograph-profile-dossiers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin: 2.25rem 0;
  }

  @media (max-width: 680px) {
    .monograph-profile-dossiers {
      grid-template-columns: 1fr;
    }
  }

  .profile-dossier {
    background: color-mix(in srgb, var(--hc-surface-1) 85%, transparent);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 4px);
    padding: 1.25rem 1.4rem;
  }

  .profile-dossier__title {
    margin: 0 0 0.65rem;
    font-family: "Gentium Plus", serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--hc-gold);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--hc-rule);
  }

  .profile-dossier p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.65;
    text-indent: 0;
  }

  /* Academic Table 1 */
  .monograph-table-wrapper {
    margin: 2.75rem 0;
    overflow-x: auto;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 4px);
    background: var(--hc-surface-0);
  }

  .table-caption {
    padding: 0.85rem 1.25rem;
    background: color-mix(in srgb, var(--hc-surface-1) 90%, transparent);
    border-bottom: 1px solid var(--hc-rule);
    font-size: 0.95rem;
    color: var(--hc-text-secondary);
  }

  .table-caption strong {
    color: var(--hc-text-primary);
  }

  .monograph-academic-table {
    width: 100%;
    border-collapse: collapse;
    font-family: "Gentium Plus", Georgia, serif;
    font-size: 0.96rem;
  }

  .monograph-academic-table th,
  .monograph-academic-table td {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--hc-rule);
    text-align: right;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .monograph-academic-table thead th {
    background: color-mix(in srgb, var(--hc-surface-2) 80%, transparent);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-gold);
    border-bottom: 2px solid var(--hc-rule-strong);
    white-space: nowrap;
  }

  /* Hand-set statistical-exhibit zebra tinting */
  .monograph-academic-table tbody tr:nth-child(even) td {
    background: color-mix(in srgb, var(--hc-surface-1) 55%, transparent);
  }

  .monograph-academic-table .cell-label {
    text-align: left;
    font-weight: 600;
    color: var(--hc-text-primary);
    font-variant-numeric: normal;
    border-right: 1px solid var(--hc-rule);
  }

  .monograph-academic-table .cell-num {
    color: var(--hc-text-secondary);
    font-feature-settings: "tnum" 1, "lnum" 1;
    letter-spacing: 0.01em;
  }

  .monograph-academic-table tr:hover td {
    background: rgba(223, 190, 125, 0.08);
  }

  .monograph-academic-table .row-summary th,
  .monograph-academic-table .row-summary td {
    font-weight: 700;
    color: var(--hc-text-primary);
    background: color-mix(in srgb, var(--hc-surface-1) 92%, transparent) !important;
    border-top: 2px double var(--hc-rule-strong);
  }

  .monograph-academic-table .row-summary .cell-num {
    color: var(--hc-gold);
  }

  /* Isnād Extracts & Chains */
  .monograph-isnad-extract {
    margin: 2.25rem 0;
    padding: 1.35rem 1.75rem;
    background: color-mix(in srgb, var(--hc-surface-1) 85%, transparent);
    border-left: 3px solid var(--hc-gold);
    border-radius: 0 var(--radius-xs, 4px) var(--radius-xs, 4px) 0;
  }

  .extract-label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hc-gold);
    margin-bottom: 0.5rem;
  }

  .extract-body {
    margin: 0;
    font-family: "Gentium Plus", serif;
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.65;
    color: var(--hc-text-primary);
  }

  .monograph-chain-display {
    margin: 2.25rem 0;
    padding: 1.1rem 0 1.1rem 1.5rem;
    border-left: 1px solid var(--hc-rule);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  /* Isnād rendered as a running typographic sequence, not stacked cards */
  .chain-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.6rem;
    font-family: "Gentium Plus", serif;
    font-size: 1.08rem;
    line-height: 1.5;
  }

  .chain-arrow {
    color: var(--hc-gold);
    font-weight: 400;
    font-size: 0.95em;
  }

  .chain-item code {
    font-family: "Gentium Plus", serif;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--hc-text-primary);
    background: none;
    padding: 0;
  }

  .chain-ref {
    align-self: flex-start;
  }

  /* Controversy & Prerequisite Blocks */
  .monograph-controversy-list,
  .monograph-prerequisite-block {
    margin: 2.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .controversy-item,
  .prereq-item {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 1rem;
    padding: 1.35rem 1.65rem;
    background: color-mix(in srgb, var(--hc-surface-1) 85%, transparent);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 4px);
  }

  .controversy-num,
  .prereq-index {
    font-family: "Gentium Plus", serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--hc-gold);
    line-height: 1.4;
  }

  .controversy-content,
  .prereq-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--hc-text-secondary);
  }

  .controversy-content strong,
  .prereq-content strong {
    color: var(--hc-text-primary);
  }

  .monograph-nested-list {
    margin: 1.5rem 0;
    padding-left: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .monograph-nested-list li {
    font-size: 1.05rem;
    line-height: 1.65;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     4. CRITICAL FOOTNOTES APPARATUS (109 Notes)
     ═══════════════════════════════════════════════════════════════════════════ */
  .monograph-apparatus {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 2px solid var(--hc-rule-strong);
  }

  .apparatus-ornament {
    text-align: center;
    color: var(--hc-gold);
    font-size: 1rem;
    letter-spacing: 0.85em;
    margin-bottom: 1.5rem;
  }

  .apparatus-heading {
    margin: 0 0 2rem;
    font-family: "Gentium Plus", serif;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 700;
    color: var(--hc-text-primary);
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--hc-rule);
  }

  .apparatus-list {
    margin: 0;
    padding-left: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  /* Crisp two-tier apparatus: two hand-set columns once there is room,
     reading top-to-bottom then across, like a Brill back-matter apparatus. */
  @media (min-width: 900px) {
    .apparatus-list {
      display: block;
      column-count: 2;
      column-gap: 3rem;
      column-rule: 1px solid var(--hc-rule);
      padding-left: 0;
    }

    .apparatus-list li {
      break-inside: avoid;
      -webkit-column-break-inside: avoid;
      page-break-inside: avoid;
      margin: 0 0 0.95rem 1.6rem;
    }
  }

  .apparatus-list li {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--hc-text-secondary);
    padding-left: 0.5rem;
    text-align: left;
  }

  .apparatus-list li::marker {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--hc-gold-dim);
  }

  .apparatus-list li:target {
    background: rgba(223, 190, 125, 0.15);
    border-radius: 2px;
    padding: 0.4rem 0.6rem;
    margin-left: calc(1.6rem - 0.6rem);
    color: var(--hc-text-primary);
  }

