<script>
  function initMonographInteractions() {
    // 1. Reading Progress Bar (Top Bar)
    const topBar = document.querySelector<HTMLElement>('[data-progress-bar]');
    const source = document.querySelector<HTMLElement>('[data-reading-source]');
    
    // 2. Active Section & Subsection Detection
    const tocLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-toc-target]'));
    
    const structure = [
      { id: 'genre-provenance', subs: [] },
      { id: 'schacht-critique', subs: [] },
      { id: 'section-a', subs: ['the-edition', 'the-sources'] },
      { id: 'section-b', subs: ['al-dabari-transmission', 'hawting-rebuttal'] },
      { id: 'section-c', subs: ['juynboll-rebuttal', 'meccan-jurisprudence'] },
      { id: 'footnotes', subs: [] }
    ];

    const updateScrollState = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      
      // Top reading progress bar
      if (source && topBar) {
        const rect = source.getBoundingClientRect();
        const targetTop = rect.top + scrollTop;
        const targetHeight = source.offsetHeight;
        const windowHeight = window.innerHeight;
        const start = targetTop - 80;
        const end = Math.max(start + 1, targetTop + targetHeight - windowHeight);
        const progress = Math.min(1, Math.max(0, (scrollTop - start) / (end - start)));
        topBar.style.transform = `scaleX(${progress})`;
      }

      // Determine active main section
      const activationLine = 160;
      let activeSectionId = structure[0].id;

      for (const sec of structure) {
        const el = document.getElementById(sec.id);
        if (el) {
          const top = el.getBoundingClientRect().top;
          if (top <= activationLine) {
            activeSectionId = sec.id;
          }
        }
      }

      // Determine active subsection ONLY within the currently active section
      let activeSubId = '';
      const currentSec = structure.find((s) => s.id === activeSectionId);
      if (currentSec && currentSec.subs.length > 0) {
        for (const subId of currentSec.subs) {
          const subEl = document.getElementById(subId);
          if (subEl) {
            const top = subEl.getBoundingClientRect().top;
            if (top <= activationLine) {
              activeSubId = subId;
            }
          }
        }
      }

      // Update link active states strictly: sublinks match activeSubId; main links match activeSectionId
      tocLinks.forEach((link) => {
        const target = link.dataset.tocTarget;
        const isSub = link.classList.contains('rail-toc-sublink');
        const isCurrent = isSub ? target === activeSubId : target === activeSectionId;
        link.classList.toggle('is-active', isCurrent);
        if (isCurrent) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    let frame = 0;
    const requestTick = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        updateScrollState();
      });
    };

    window.addEventListener('scroll', requestTick, { passive: true });
    window.addEventListener('resize', requestTick, { passive: true });
    updateScrollState();

    // 3. In-Situ Scholarly Footnote Tooltips
    const tooltip = document.getElementById('fn-tooltip');
    const tooltipBadge = tooltip?.querySelector<HTMLElement>('[data-fn-tooltip-badge]');
    const tooltipBody = tooltip?.querySelector<HTMLElement>('[data-fn-tooltip-body]');
    const tooltipJump = tooltip?.querySelector<HTMLAnchorElement>('[data-fn-tooltip-jump]');
    const tooltipClose = tooltip?.querySelector<HTMLButtonElement>('[data-fn-tooltip-close]');
    const fnAnchors = Array.from(document.querySelectorAll<HTMLElement>('.fn-anchor'));

    if (tooltip && tooltipBadge && tooltipBody && tooltipJump) {
      let activeAnchor: HTMLElement | null = null;
      let hideTimeout: number = 0;

      const showTooltip = (anchor: HTMLElement) => {
        window.clearTimeout(hideTimeout);
        activeAnchor = anchor;
        const num = anchor.dataset.fnNum || '';
        const text = anchor.dataset.fnText || '';
        if (!text) return;

        tooltipBadge.textContent = `Note ${num}`;
        tooltipBody.textContent = text;
        tooltipJump.href = `#fn${num}`;

        const rect = anchor.getBoundingClientRect();
        const tooltipWidth = Math.min(380, window.innerWidth - 32);
        let left = rect.left + window.scrollX - (tooltipWidth / 2) + (rect.width / 2);
        if (left < 16) left = 16;
        if (left + tooltipWidth > window.innerWidth - 16) {
          left = window.innerWidth - tooltipWidth - 16;
        }

        let top = rect.top + window.scrollY - 10;
        tooltip.style.width = `${tooltipWidth}px`;
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${top}px`;
        tooltip.style.transform = 'translateY(-100%)';
        tooltip.classList.add('is-visible');
        tooltip.setAttribute('aria-hidden', 'false');
      };

      const hideTooltip = () => {
        hideTimeout = window.setTimeout(() => {
          tooltip.classList.remove('is-visible');
          tooltip.setAttribute('aria-hidden', 'true');
          activeAnchor = null;
        }, 180);
      };

      fnAnchors.forEach((anchor) => {
        anchor.addEventListener('mouseenter', () => showTooltip(anchor));
        anchor.addEventListener('mouseleave', hideTooltip);
        anchor.addEventListener('focus', () => showTooltip(anchor));
        anchor.addEventListener('blur', hideTooltip);
        anchor.addEventListener('click', (e) => {
          if (window.innerWidth <= 768) {
            e.preventDefault();
            if (tooltip.classList.contains('is-visible') && activeAnchor === anchor) {
              hideTooltip();
            } else {
              showTooltip(anchor);
            }
          }
        });
      });

      tooltip.addEventListener('mouseenter', () => window.clearTimeout(hideTimeout));
      tooltip.addEventListener('mouseleave', hideTooltip);
      tooltipClose?.addEventListener('click', () => {
        tooltip.classList.remove('is-visible');
        tooltip.setAttribute('aria-hidden', 'true');
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && tooltip.classList.contains('is-visible')) {
          tooltip.classList.remove('is-visible');
          tooltip.setAttribute('aria-hidden', 'true');
          activeAnchor?.focus();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMonographInteractions);
  } else {
    initMonographInteractions();
  }
  document.addEventListener('astro:page-load', initMonographInteractions);
</script>

