const relatedMethods = [
  {
    title: 'Sadeghi — The Traveling Tradition Test',
    label: 'Adjacent method',
    author: 'Behnam Sadeghi',
    year: '2010',
    text: 'A related dating technique that correlates the transmission geography of traditions with their content and circulation history.',
  },
  {
