    summary: 'This study belongs in the Motzki research dossier but is not an ICMA case. He tests the claim that non-Arab converts came to dominate early Islamic jurisprudence through a statistical analysis of the biographical evidence.',
    points: [
      'The overall sample contains 63 Arab and 52 non-Arab scholars, rather than a clear non-Arab majority.',
      'The proportions change substantially across generations, contradicting a simple linear story of mawālī dominance.',
      'Regional patterns differ sharply, with non-Arab scholars especially prominent in some centers but not others.',
      'Motzki argues that the conventional picture results partly from overgeneralizing a limited set of prominent examples.'
    ]
  }
];

const relatedMethods = [
  {
    title: 'Sadeghi — The Traveling Tradition Test',
    label: 'Adjacent method',
    author: 'Behnam Sadeghi',
    year: '2010',
    text: 'A related dating technique that correlates the transmission geography of traditions with their content and circulation history.',
  },
  {
    title: 'Görke, Motzki & Schoeler — First-Century Sources for the Life of Muḥammad?',
    label: 'Methodological debate',
    author: 'Andreas Görke, Harald Motzki & Gregor Schoeler',
    year: '2012',
    text: 'A major discussion of early-source reconstruction and the methodological questions surrounding isnād-cum-matn analysis.',
  },
  {
    title: 'Pavlovitch — The Origin of the Isnād and al-Mukhtār’s Revolt',
    label: 'Isnād-focused / related',
    author: 'Pavel Pavlovitch',
    year: '2018',
    text: 'Highly relevant to transmission history, while the study itself does not present a full isnād-cum-matn analysis of its central material.',
  },
  {
    title: 'Juynboll — Muslim Traditions',
    label: 'Precursor / common-link analysis',
    author: 'G.H.A. Juynboll',
    year: '1983',
    text: 'Important for the genealogy of transmission-network analysis, especially common-link work, but not synonymous with ICMA itself.',
  },
];
---

<BaseLayout
  title="Academic Studies & ICMA Register | HadithCritic Projects"
  description="An institutional research register of Isnād-cum-matn analysis, transmission criticism, common-link studies, and related scholarship on early hadith traditions."
>
  <div class="studies-page">
    <header class="studies-hero" aria-labelledby="studies-title">
      <div class="hc-container">
        <div class="hero-grid">
          <div class="studies-hero__copy">
            <div class="hero-kicker-row">
              <span class="hc-eyebrow">Project Module 03</span>
              <span class="hero-rule" aria-hidden="true"></span>
              <span class="hero-kicker-text">Historical-critical hadith research</span>
            </div>
            <h1 id="studies-title" class="studies-title">
              Academic Studies <span class="studies-title-accent">&amp; ICMA Register</span>
            </h1>
            <p class="studies-intro">
              A curated research index for <strong>Isnād-cum-matn analysis (ICMA)</strong>, transmission criticism, and the historical reconstruction of hadith traditions. The register distinguishes direct ICMA studies from adjacent methods so that each work is identified by what it actually does.
            </p>
            <div class="hero-meta-line">
              <span>METHOD</span><strong>Transmission + text</strong>
              <span>FOCUS</span><strong>Early hadith</strong>
              <span>MODE</span><strong>Comparative criticism</strong>
            </div>
          </div>

          <aside class="hero-index" aria-label="Research index quick links">
            <div class="hero-index__label">Research index</div>
            <div class="hero-index__code">HC / ICMA / 03</div>
            <div class="hero-index__line"></div>
            <dl class="hero-index__list">
              <div>
                <dt><a href="#shelf-title" class="hero-index__link">Archive Studies</a></dt>
                <dd>{String(icmaStudies.length).padStart(2, '0')}</dd>
              </div>
              <div>
                <dt><a href="#register-title" class="hero-index__link">Register entries</a></dt>
                <dd>{String(icmaRegister.length).padStart(2, '0')}</dd>
              </div>
              <div>
                <dt><a href="#related-title" class="hero-index__link">Adjacent methods</a></dt>
                <dd>04</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </header>

    <main>
      <section class="studies-shelf hc-container" aria-labelledby="shelf-title">
        <div class="studies-shelf__header">
          <div class="studies-shelf__intro">
            <span class="section-kicker">Archival Corpus · 27 Monograph Editions</span>
            <h2 id="shelf-title" class="section-title">ICMA Studies in the Archive</h2>
            <p class="studies-shelf__lead">
              An institutional register of research monographs applying <em>isnād-cum-matn</em> analysis (ICMA). Every study correlates transmission pathways across early regional centers with textual variant stratification to reconstruct and date the historical emergence of classical traditions.
            </p>
          </div>
        </div>

        {/* ── RESEARCH DISCOVERY: search + family filter ──
             Hidden by default and revealed by script once it can actually do
             something: with JavaScript off, visitors get the complete ledger
             below exactly as before, rather than an inert search box. */}
        <div class="studies-discovery" data-studies-discovery hidden>
          <div class="studies-discovery__search">
            <span class="studies-discovery__icon" aria-hidden="true">⌕</span>
            <label class="sr-only" for="studies-search-input">Search monograph titles, traditions, and common links</label>
            <input
              id="studies-search-input"
              type="text"
              class="studies-discovery__input"
              placeholder="Search by title, tradition, or common link…"
              data-studies-search
              autocomplete="off"
            />
            <button type="button" class="studies-discovery__clear" data-studies-clear hidden aria-label="Clear search">×</button>
          </div>

          <div class="studies-discovery__tabs" data-studies-filter-group role="group" aria-label="Filter by research family">
            <button type="button" class="studies-tab is-active" data-family-filter="all" aria-pressed="true">
              All <span class="studies-tab__n">{icmaStudies.length}</span>
            </button>
            {familyCounts.map(({ family, n, label }) => (
              <button type="button" class="studies-tab" data-family-filter={family} aria-pressed="false">
                {label} <span class="studies-tab__n">{n}</span>
              </button>
            ))}
          </div>

          <span class="studies-discovery__status" data-studies-status aria-live="polite">
            {icmaStudies.length} studies
          </span>
        </div>

        {/* ── 1. THE MONOGRAPH DOSSIER READER ── */}
        <div class="studies-dossier-wrap" data-studies-dossier-wrap>
          {/* Quick-Selector Ribbon: Scannable list of all 27 accession items */}
          <div class="studies-ribbon" role="tablist" aria-label="Quick jump to monograph">
            <div class="studies-ribbon__track" data-studies-ribbon>
              {icmaStudies.map((study, index) => {
                const art = icmaArtDirections[study.slug] || defaultArtDirection;
                const num = String(index + 1).padStart(2, '0');
                return (
                  <button
                    type="button"
                    class={`studies-ribbon__item${index === 0 ? ' is-active' : ''}`}
                    data-studies-nav={index}
                    data-family={art.family}
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    title={`Study ${num}: ${study.title}`}
                  >
                    <span class="studies-ribbon__num">{num}</span>
                    <span class="studies-ribbon__title">{study.title}</span>
                  </button>
                );
              })}
            </div>
          </div>

          <div class="studies-carousel" data-studies-carousel>
            <div class="studies-carousel__topbar">
              <div class="studies-carousel__eyebrow">
                <span class="studies-carousel__kicker">Critical Edition Dossier</span>
                <span class="studies-carousel__line" aria-hidden="true"></span>
                <span data-active-motif-label>Sacred Geography · Syrian Regional Isnād Axis</span>
              </div>
              <div class="studies-carousel__counter" aria-live="polite">
                <span>Study</span>
                <strong data-studies-current>01</strong>
                <span>of</span>
                <span>{String(icmaStudies.length).padStart(2, '0')}</span>
              </div>
            </div>

            <div class="studies-carousel__stage" data-studies-stage>
              {icmaStudies.map((study, index) => {
                const art = icmaArtDirections[study.slug] || defaultArtDirection;
                const articleUrl = articleMap.get(study.slug) || articleMap.get(study.id) || `/blogs/${study.slug}`;
                const num = String(index + 1).padStart(2, '0');
                const cite = study.citeKey || `ICMA-${num}`;
                return (
                  <article
                    class={`icma-card icma-card--${art.family}${index === 0 ? ' is-active' : ''}`}
                    data-studies-slide={index}
                    data-family={art.family}
                    data-motif-label={art.motifLabel}
                    id={study.slug}
                    aria-hidden={index === 0 ? 'false' : 'true'}
                  >
                    {/* 1. Folio Topbar: Monograph Accession & Classification */}
                    <div class="icma-card__folio-bar">
                      <div class="icma-card__folio-left">
                        <span class="icma-card__folio-badge">FOLIO {num}</span>
                        <span class="icma-card__folio-sep" aria-hidden="true">/</span>
                        <span class="icma-card__cite-pill">{cite}</span>
                        <span class="icma-card__folio-sep" aria-hidden="true">·</span>
                        <span class="icma-card__series-name">ICMA Monograph Archive</span>
                      </div>
                      <div class="icma-card__folio-right">
                        <span class={`icma-card__family-chip icma-card__family-chip--${art.family}`}>
                          {familyLabels[art.family] || art.family}
                        </span>
                        {study.status && <span class="icma-card__status-dot">{study.status}</span>}
                      </div>
                    </div>

                    {/* 2. Hero Monograph Title & Subject Focus */}
                    <div class="icma-card__hero">
                      <div class="icma-card__motif-line">
                        <span class="icma-card__motif-mark" aria-hidden="true">§</span>
                        <span class="icma-card__motif-title">{art.motifLabel}</span>
                      </div>

                      <h3 class="icma-card__title">
                        <a href={articleUrl} class="icma-card__title-link">{study.title}</a>
                      </h3>

                      {study.subtitle && (
                        <p class="icma-card__subtitle">{study.subtitle}</p>
                      )}
                    </div>

                    {/* 3. Compact Research Content & Scholarly Specs */}
                    <div class="icma-card__body">
                      <div class="icma-card__col-main">
                        <p class="icma-card__abstract">{study.abstract}</p>

                        <div class="icma-card__apparatus-strip">
                          <span class="icma-card__apparatus-tag">Apparatus Insight:</span>
                          <p class="icma-card__apparatus-note">{art.analyticalNote}</p>
                        </div>
                      </div>

                      <div class="icma-card__col-side">
                        <div class="icma-card__specs">
                          <div class="icma-card__spec-item">
                            <span class="icma-card__spec-label">Tradition Analyzed</span>
                            <span class="icma-card__spec-val">{study.tradition || '—'}</span>
                          </div>
                          <div class="icma-card__spec-item">
                            <span class="icma-card__spec-label">Common Link Disseminator</span>
                            <span class="icma-card__spec-val icma-card__spec-val--accent">{study.commonLink || '—'}</span>
                          </div>
                        </div>

                        {study.keyFindings && study.keyFindings.length > 0 && (
                          <div class="icma-card__findings">
                            <span class="icma-card__findings-head">Empirical Variant Conclusions:</span>
                            <ul class="icma-card__findings-list">
                              {study.keyFindings.map((finding) => (
                                <li>
                                  <span class="icma-card__findings-mark" aria-hidden="true">—</span>
                                  <span>{finding}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    </div>

                    {/* 4. Colophon & Direct Research Actions */}
                    <footer class="icma-card__colophon">
                      <div class="icma-card__cite-stamp">
                        <span class="icma-card__stamp-label">Archival Citation:</span>
                        <code>HadithCritic ICMA Archive · {cite}</code>
                      </div>

                      <div class="icma-card__actions">
                        {study.pdfUrl && (
                          <a href={study.pdfUrl} class="icma-btn icma-btn--ghost" download>
                            Download PDF <span aria-hidden="true">↓</span>
                          </a>
                        )}
                        <a href={articleUrl} class="icma-btn icma-btn--primary">
                          Read Full Critical Study <span aria-hidden="true">→</span>
                        </a>
                      </div>
                    </footer>
                  </article>
                );
              })}
            </div>

            <div class="studies-carousel__controls">
              <button type="button" class="studies-carousel__button" data-studies-prev aria-label="Previous monograph study">
                ← <span>Previous Study</span>
              </button>
              <div class="studies-carousel__dots" role="tablist" aria-label="ICMA archive monograph study slides">
                {icmaStudies.map((study, index) => (
                  <button
                    type="button"
                    class={`studies-carousel__dot${index === 0 ? ' is-active' : ''}`}
                    data-studies-dot={index}
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-label={`Jump to study ${index + 1}: ${study.title}`}
                  ></button>
                ))}
              </div>
              <button type="button" class="studies-carousel__button" data-studies-next aria-label="Next monograph study">
                <span>Next Study</span> →
              </button>
            </div>
          </div>
        </div>

        {/* ── 2. THE COMPLETE ARCHIVAL INDEX LEDGER (100% visible with No-JS fallback) ── */}
        <div class="studies-ledger" id="register-title" data-studies-ledger>
          <header class="studies-ledger__header">
            <div>
              <span class="studies-ledger__kicker">Institutional Register</span>
              <h3 class="studies-ledger__title">Complete 27-Monograph Archival Index</h3>
            </div>
            <span class="studies-ledger__meta">All entries citable · Cross-referenced with research editions</span>
          </header>

          <div class="studies-ledger__table-wrap">
            <table class="studies-ledger__table">
              <thead>
                <tr>
                  <th scope="col" class="th-code">Accession</th>
                  <th scope="col" class="th-title">Monograph Title &amp; Target Tradition</th>
                  <th scope="col" class="th-link">Common Link Disseminator</th>
                  <th scope="col" class="th-method">Methodology</th>
                  <th scope="col" class="th-action">Actions</th>
                </tr>
              </thead>
              <tbody>
                {icmaStudies.map((study, index) => {
                  const art = icmaArtDirections[study.slug] || defaultArtDirection;
                  const articleUrl = articleMap.get(study.slug) || articleMap.get(study.id) || `/blogs/${study.slug}`;
                  const num = String(index + 1).padStart(2, '0');
                  const cite = study.citeKey || `ICMA-${num}`;
                  const haystack = `${study.title} ${study.subtitle || ''} ${study.tradition || ''} ${study.commonLink || ''} ${cite}`.toLowerCase();
                  return (
                    <tr class="studies-ledger__row" data-ledger-row={index} data-family={art.family} data-search-haystack={haystack}>
                      <td class="td-code">
                        <span class="studies-ledger__cite-code">{cite}</span>
                      </td>
                      <td class="td-title">
                        <a href={articleUrl} class="studies-ledger__entry-link">
                          <strong>{study.title}</strong>
                        </a>
                        {study.subtitle && <span class="studies-ledger__subtitle">{study.subtitle}</span>}
                        <span class="studies-ledger__tradition">{study.tradition}</span>
                      </td>
                      <td class="td-link">
                        <span class="studies-ledger__common-link">{study.commonLink || '—'}</span>
                      </td>
                      <td class="td-method">
                        <span class={`studies-ledger__badge studies-ledger__badge--${art.family}`}>
                          {familyLabels[art.family] || art.family}
                        </span>
                      </td>
                      <td class="td-action">
                        <div class="studies-ledger__actions">
                          <button
                            type="button"
                            class="studies-ledger__inspect-btn"
                            data-inspect-slide={index}
                            title={`Inspect ${study.title} in dossier reader`}
                          >
                            Inspect
                          </button>
                          <a href={articleUrl} class="studies-ledger__read-link" title={`Read full investigation: ${study.title}`}>
                            Read <span aria-hidden="true">→</span>
                          </a>
                        </div>
                      </td>
                    </tr>
                  );
                })}
                <tr class="studies-ledger__empty" data-ledger-empty>
                  <td colspan="5">
                    No studies match <strong data-empty-query></strong>. Try a different term, or clear the family filter above.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="motzki-section hc-container" aria-labelledby="motzki-title">
        <div class="motzki-header">
          <div>
            <span class="section-kicker">Harald Motzki · research dossier</span>
            <h2 id="motzki-title" class="section-title">Motzki case studies</h2>
            <p class="motzki-lead">
              A compact study-by-study record of Motzki’s principal applications of transmission criticism, source reconstruction, and isnād-cum-matn analysis. Each case isolates what he examines and the conclusions he draws from it.
            </p>
          </div>
        </div>

        <div class="motzki-carousel" data-motzki-carousel>
          <div class="motzki-carousel__topbar">
            <div class="motzki-carousel__eyebrow">
              <span>Motzki corpus</span>
              <span class="motzki-carousel__line" aria-hidden="true"></span>
              <span>{String(motzkiStudies.length).padStart(2, '0')} studies</span>
            </div>
            <div class="motzki-carousel__counter" aria-live="polite">
              <strong data-motzki-current>01</strong><span>/</span><span>{String(motzkiStudies.length).padStart(2, '0')}</span>
            </div>
          </div>

          <div class="motzki-carousel__stage" data-motzki-stage>
            {motzkiStudies.map((study, index) => (
              <article class={`motzki-card${index === 0 ? ' is-active' : ''}${study.visualFamily ? ` motzki-card--${study.visualFamily}` : ''}`} data-motzki-slide={index} aria-hidden={index === 0 ? 'false' : 'true'}>
                {study.seriesTitle && (
                  <div class="motzki-card__series-strip">
                    <span>{study.seriesTitle}</span>
                  </div>
                )}

                <div class="motzki-card__topline">
                  <div class="motzki-card__meta">
                    <span>{study.type}</span>
                    <span>{study.year}</span>
                    <span>{study.classification}</span>
                  </div>
                </div>

                <div class="motzki-card__rule" aria-hidden="true"></div>

                <div class="motzki-card__heading">
                  <span class="motzki-card__subject">{study.subject}</span>
                  <h3>{study.title}</h3>
                  {study.visualFamily === 'biography-muhammad' && study.bookSubtitle && (
                    <div class="motzki-card__sources-tag">
                      <span class="motzki-card__dash">—</span>
                      <em>{study.bookSubtitle}</em>
                      <span class="motzki-card__dash">—</span>
                    </div>
                  )}
                </div>

                <div class="motzki-card__body">
                  <div class="motzki-card__summary-wrap">
                    <span class="motzki-card__label">What Motzki examines</span>
                    <p class="motzki-card__summary">{study.summary}</p>
                    {study.link && (
                      <div class="motzki-card__action">
                        <a href={study.link.url} class="motzki-card__action-btn">
                          <span>{study.link.label}</span>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                          </svg>
                        </a>
                      </div>
                    )}
                  </div>

                  <div class="motzki-card__points">
                    <div class="motzki-card__points-head">
                      <span>Principal points</span>
                      <span>{String(study.points.length).padStart(2, '0')}</span>
                    </div>
                    <ul>
                      {study.points.map((point) => (
                        <li><span class="motzki-point-mark" aria-hidden="true">+</span><span>{point}</span></li>
                      ))}
                    </ul>
                  </div>
                </div>

                {study.publisher && (
                  <div class="motzki-card__footer">
                    <div class="motzki-card__edition-info">
                      {study.bookTitle && <span class="motzki-card__edition-title">{study.bookTitle}</span>}
                      {study.bookSubtitle && study.visualFamily !== 'biography-muhammad' && (
                        <span class="motzki-card__edition-sub"> · {study.bookSubtitle}</span>
                      )}
                    </div>
                    <div class="motzki-card__publisher-tag">{study.publisher}</div>
                  </div>
                )}
              </article>
            ))}
          </div>

          <div class="motzki-carousel__controls">
            <button type="button" class="motzki-carousel__button" data-motzki-prev aria-label="Previous Motzki study">← <span>Previous</span></button>
            <div class="motzki-carousel__dots" role="tablist" aria-label="Motzki case studies">
              {motzkiStudies.map((study, index) => (
                <button
                  type="button"
                  class={`motzki-carousel__dot${index === 0 ? ' is-active' : ''}`}
                  data-motzki-dot={index}
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-label={`Show Motzki study ${study.number}: ${study.title}`}
                ></button>
              ))}
            </div>
            <button type="button" class="motzki-carousel__button" data-motzki-next aria-label="Next Motzki study"><span>Next</span> →</button>
          </div>
        </div>
      </section>

      <section class="related-section hc-container" aria-labelledby="related-title">
        <div class="section-intro">
          <div>
            <span class="section-kicker">Adjacent scholarship</span>
            <h2 id="related-title" class="section-title">Related transmission methods</h2>
          </div>
          <a href="/academia" class="hc-link">View Academia <span aria-hidden="true">→</span></a>
        </div>

        <div class="related-method-grid">
          {relatedMethods.map((item) => (
            <article class="related-method">
              <div class="related-method__meta">
                <span class="related-method__label">{item.label}</span>
                {item.year && <span class="related-method__year">{item.year}</span>}
              </div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

        {otherStudies.length > 0 && (
          <div class="other-works">
            <div class="other-works__head">
              <span>Archive overflow</span>
              <a href="/academia">{otherStudies.length} additional academic works & formal treatises →</a>
            </div>
          </div>
        )}
      </section>
    </main>
  </div>
</BaseLayout>



<script>
  function initStudiesCarousel() {
    const shelf = document.querySelector<HTMLElement>('.studies-shelf');
    const root = shelf?.querySelector<HTMLElement>('[data-studies-carousel]');
    if (!shelf || !root || root.dataset.studiesInitialized === 'true') return;
    root.dataset.studiesInitialized = 'true';

    const stage = root.querySelector<HTMLElement>('[data-studies-stage]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-studies-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-studies-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-studies-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-studies-next]');
    const current = root.querySelector<HTMLElement>('[data-studies-current]');
    const motifLabel = root.querySelector<HTMLElement>('[data-active-motif-label]');

    // Connected views
    const ribbonButtons = Array.from(shelf.querySelectorAll<HTMLButtonElement>('[data-studies-nav]'));
    const ledgerRows = Array.from(shelf.querySelectorAll<HTMLTableRowElement>('[data-ledger-row]'));
    const inspectButtons = Array.from(shelf.querySelectorAll<HTMLButtonElement>('[data-inspect-slide]'));

    if (!stage || !slides.length) return;
    stage.style.height = '';

    let index = 0;

    function show(nextIndex: number) {
      index = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      ribbonButtons.forEach((btn, i) => {
        const active = i === index;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      ledgerRows.forEach((row, i) => {
        row.classList.toggle('is-active', i === index);
      });

      if (current) current.textContent = String(index + 1).padStart(2, '0');

      const currentSlide = slides[index];
      if (motifLabel && currentSlide?.dataset.motifLabel) {
        motifLabel.textContent = currentSlide.dataset.motifLabel;
      }

      dots[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      ribbonButtons[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    // Prev / Next controls
    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    // Ribbon quick-jump navigation
    ribbonButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = Number(btn.dataset.studiesNav);
        if (!Number.isNaN(target)) show(target);
      });
    });

    // Ledger "Inspect" navigation
    inspectButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = Number(btn.dataset.inspectSlide);
        if (!Number.isNaN(target)) {
          show(target);
          const dossier = shelf.querySelector<HTMLElement>('[data-studies-dossier-wrap]');
          (dossier || root).scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    let touchStartX = 0;
    stage.addEventListener('touchstart', (e) => {
      if (e.changedTouches && e.changedTouches[0]) {
        touchStartX = e.changedTouches[0].screenX;
      }
    }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (e.changedTouches && e.changedTouches[0]) {
        const touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 45) show(index + 1);
        if (touchEndX - touchStartX > 45) show(index - 1);
      }
    }, { passive: true });

    // Research discovery: search + family filter. Both act on the ledger
    // rows and ribbon items already in the DOM; nothing here fetches or
    // re-renders content, so it stays cheap even at archive scale.
    const discovery = shelf.querySelector<HTMLElement>('[data-studies-discovery]');
    const searchInput = shelf.querySelector<HTMLInputElement>('[data-studies-search]');
    const clearButton = shelf.querySelector<HTMLButtonElement>('[data-studies-clear]');
    const filterButtons = Array.from(shelf.querySelectorAll<HTMLButtonElement>('[data-family-filter]'));
    const statusEl = shelf.querySelector<HTMLElement>('[data-studies-status]');
    const emptyRow = shelf.querySelector<HTMLTableRowElement>('[data-ledger-empty]');
    const emptyQueryEl = emptyRow?.querySelector<HTMLElement>('[data-empty-query]');

    let activeFamily = 'all';

    function applyFilter() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const filtered = activeFamily !== 'all' || query.length > 0;
      let visible = 0;
      let firstVisible = -1;

      ledgerRows.forEach((row, i) => {
        const haystack = row.dataset.searchHaystack || '';
        const family = row.dataset.family || '';
        const matches = (activeFamily === 'all' || family === activeFamily) && (!query || haystack.includes(query));
        row.classList.toggle('is-hidden', !matches);
        if (matches) {
          visible += 1;
          if (firstVisible === -1) firstVisible = i;
        }
      });

      ribbonButtons.forEach((btn, i) => {
        btn.classList.toggle('is-hidden', Boolean(ledgerRows[i]?.classList.contains('is-hidden')));
      });

      if (clearButton) clearButton.hidden = query.length === 0;

      if (emptyRow) {
        emptyRow.classList.toggle('is-visible', visible === 0);
        if (emptyQueryEl) emptyQueryEl.textContent = query ? `"${query}"` : 'this filter';
      }

      if (statusEl) {
        statusEl.textContent = filtered
          ? `${visible} of ${slides.length} studies match`
          : `${slides.length} studies`;
      }

      // Keep the dossier reader pointed at something the filter didn't hide.
      if (firstVisible !== -1 && ledgerRows[index]?.classList.contains('is-hidden')) {
        show(firstVisible);
      }
    }

    searchInput?.addEventListener('input', applyFilter);
    clearButton?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      applyFilter();
    });
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFamily = btn.dataset.familyFilter || 'all';
        filterButtons.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', String(on));
        });
        applyFilter();
      });
    });

    // Reveal last: with JavaScript off, the bar never appears and visitors
    // get the complete, always-visible ledger below exactly as before.
    if (discovery) discovery.hidden = false;

    show(0);
  }

  function initMotzkiCarousel() {
    const root = document.querySelector<HTMLElement>('[data-motzki-carousel]');
    if (!root || root.dataset.motzkiInitialized === 'true') return;
    root.dataset.motzkiInitialized = 'true';

    const stage = root.querySelector<HTMLElement>('[data-motzki-stage]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-motzki-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-motzki-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-motzki-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-motzki-next]');
    const current = root.querySelector<HTMLElement>('[data-motzki-current]');

    if (!stage || !slides.length) return;
    stage.style.height = '';

    let index = 0;

    function show(nextIndex: number) {
      index = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      if (current) current.textContent = String(index + 1).padStart(2, '0');
    }

    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    show(0);
  }

  function initCarousels() {
    initStudiesCarousel();
    initMotzkiCarousel();
  }

  document.addEventListener('DOMContentLoaded', initCarousels);
  initCarousels();
</script>

