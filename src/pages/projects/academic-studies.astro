---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { academicStudies } from '../../data/academic-studies';
import { icmaArtDirections, defaultArtDirection } from '../../data/icma-art-directions';

const icmaStudies = academicStudies.filter((s) => s.category === 'icma');
const otherStudies = academicStudies.filter((s) => s.category !== 'icma');


const icmaRegister = [
  {
    author: 'Harald Motzki',
    year: '2000',
    title: 'Dating Muslim Traditions: A Survey',
    classification: 'Core ICMA / methodology',
    category: 'methodology',
    note: 'Foundational methodological work establishing the systematic correlation of transmission lines with textual variations.',
    citation: 'Motzki, Harald. "Dating Muslim Traditions: A Survey." Arabica 52, no. 2 (2005): 204–253.',
  },
  {
    author: 'Harald Motzki',
    year: '2001',
    title: 'Methods of Dating Early Legal Traditions',
    classification: 'Core ICMA / methodology',
    category: 'methodology',
    note: 'Comprehensive methodological treatment of approaches for reconstructing and dating early transmitted juristic material.',
    citation: 'Motzki, Harald. "The Murder of Ibn Abī l-Ḥuqayq: On the Origin and Reliability of Early Muslim Traditions." In The Biography of Muḥammad (Leiden: Brill, 2000), 170–239.',
  },
  {
    author: 'Harald Motzki',
    year: '1991',
    title: 'Reconstruction of a Source of Ibn Isḥāq’s Life of the Prophet and Early Qurʾān Exegesis',
    classification: 'Applied ICMA / source reconstruction',
    category: 'applied',
    note: 'Major source-reconstruction study using transmission pathways and textual variation together to recover early material.',
    citation: 'Motzki, Harald. "The Reconstruction of a Source of Ibn Isḥāq\'s Life of the Prophet." Journal of the American Oriental Society 111, no. 4 (1991): 709–720.',
  },
  {
    author: 'Harald Motzki',
    year: '2002',
    title: 'The Origins of Islamic Jurisprudence',
    classification: 'Applied ICMA / source reconstruction',
    category: 'applied',
    note: 'Large-scale reconstruction of early legal transmission through isnād and matn evidence from ʿAbd al-Razzāq’s Muṣannaf.',
    citation: 'Motzki, Harald. The Origins of Islamic Jurisprudence: Meccan Fiqh Before the Classical Schools. Leiden: Brill, 2002.',
  },
  {
    author: 'Gregor Schoeler / Andreas Görke',
    year: '2008',
    title: 'Prospects and Limits in the Study of the Historical Muḥammad',
    classification: 'ICMA methodology / application',
    category: 'methodology',
    note: 'Important discussion of the use, strengths, and limits of combined isnād-matn analysis for early traditions.',
    citation: 'Görke, Andreas, and Gregor Schoeler. "Prospects and Limits in the Study of the Historical Muḥammad." Der Islam 84, no. 1 (2008): 137–171.',
  },
  {
    author: 'Pavel Pavlovitch',
    year: '2016',
    title: 'The Formation of the Islamic Understanding of Kalāla in the Second Century AH',
    classification: 'Applied ICMA',
    category: 'applied',
    note: 'Explicitly structures its investigation around isnād-cum-matn analysis and transmission stratification.',
    citation: 'Pavlovitch, Pavel. The Formation of the Islamic Understanding of Kalāla in the Second Century AH. Leiden: Brill, 2016.',
  },
  {
    author: 'Pavel Pavlovitch / David S. Powers',
    year: '2012',
    title: '“A Bequest May Not Exceed One-Third”: An Isnād-cum-Matn Analysis and Beyond',
    classification: 'Explicit ICMA study',
    category: 'applied',
    note: 'A named ICMA study that reconstructs the circulation and development of a specific legal report across regional centers.',
    citation: 'Pavlovitch, Pavel, and David S. Powers. "\'A Bequest May Not Exceed One-Third\': An Isnād-cum-Matn Analysis and Beyond." Islamic Law and Society 19, no. 3 (2012): 233–272.',
  },
  {
    author: 'Joshua Little',
    year: '2022',
