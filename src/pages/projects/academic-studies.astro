  .studies-carousel__counter strong {
    font-size: 0.84rem;
    color: var(--hc-text-primary);
  }

  .studies-carousel__stage {
    position: relative;
    overflow: hidden;
    transition: height 280ms ease;
  }

  /* ═══════════════════════════════════════════════════════════════════════
     ICMA ARCHIVAL MONOGRAPH CARDS (SISTER SYSTEM TO MOTZKI CARDS)
     Full-card editorial research compositions representing historical criticism
     ═══════════════════════════════════════════════════════════════════════ */

  /* Base ICMA Card Architecture */
  .icma-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    padding: clamp(1.6rem, 2.8vw, 2.3rem) clamp(1.8rem, 3.2vw, 2.6rem);
    opacity: 0;
    transform: translateX(24px);
    pointer-events: none;
    visibility: hidden;
    isolation: isolate;
    overflow: hidden;
    box-sizing: border-box;
    transition: opacity 240ms ease, transform 280ms ease;

    /* Authentic Academic Monograph Bookcloth Ground */
    background:
      radial-gradient(ellipse at 50% 10%, rgba(255, 245, 230, 0.06), transparent 70%),
      linear-gradient(180deg, var(--icma-bg, #14171d) 0%, var(--icma-bg-accent, #0a0c10) 100%);
    color: var(--icma-paper, #f7f3ea);
    border: 1px solid var(--icma-border, rgba(216, 186, 130, 0.32));
    outline: 1px solid var(--icma-rule, rgba(216, 186, 130, 0.16));
    outline-offset: -7px;
    box-shadow: inset 0 0 95px rgba(0, 0, 0, 0.55), 0 10px 32px rgba(0, 0, 0, 0.45);
  }

  .icma-card.is-active {
    position: relative;
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    visibility: visible;
  }

  /* Archival Material Texture & Watermark Layer */
  .icma-card__art {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .icma-card__texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Tactile Material Textures */
  .icma-card__texture[data-texture="laid"],
  .icma-card--texture-laid .icma-card__texture {
    background: repeating-linear-gradient(0deg, transparent, transparent 27px, rgba(255, 255, 255, 0.018) 28px);
  }

  .icma-card__texture[data-texture="buckram"],
  .icma-card--texture-buckram .icma-card__texture {
    background-image:
      linear-gradient(0deg, rgba(255, 255, 255, 0.014) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.014) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .icma-card__texture[data-texture="morocco"],
  .icma-card--texture-morocco .icma-card__texture {
    background:
      radial-gradient(circle at 85% 15%, rgba(255, 240, 220, 0.04), transparent 50%),
      radial-gradient(circle at 15% 85%, rgba(0, 0, 0, 0.35), transparent 60%);
  }

  .icma-card__texture[data-texture="ledger"],
  .icma-card--texture-ledger .icma-card__texture {
    background: repeating-linear-gradient(180deg, transparent, transparent 38px, var(--icma-rule) 39px);
    opacity: 0.32;
  }

  .icma-card__texture[data-texture="vellum"],
  .icma-card--texture-vellum .icma-card__texture {
    background: radial-gradient(ellipse at 45% 45%, rgba(255, 248, 235, 0.035), transparent 70%);
  }

  .icma-card__watermark {
    position: absolute;
    right: 2.2rem;
    top: 1.8rem;
    font-family: "Gentium Plus", var(--font-display);
    font-size: clamp(6.5rem, 14vw, 11rem);
    font-weight: 700;
    line-height: 0.8;
    color: var(--icma-accent, var(--hc-gold));
    opacity: 0.04;
    user-select: none;
    pointer-events: none;
    z-index: 1;
    letter-spacing: -0.04em;
  }

  /* Card content sits safely on top of texture layer */
  .icma-card > *:not(.icma-card__art) {
    position: relative;
    z-index: 3;
  }

  /* Archive Topline */
  .icma-card__topline {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--icma-muted, rgba(250, 245, 235, 0.72));
  }

  .icma-card__accession {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .icma-card__series-tag {
    color: var(--icma-accent, var(--hc-gold));
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .icma-card__index-num {
    color: var(--icma-paper, #ffffff);
    font-weight: 600;
  }

  .icma-card__sep {
    color: var(--icma-rule, rgba(255, 255, 255, 0.25));
  }

  .icma-card__ref-code {
    font-family: var(--font-ui);
    color: var(--icma-paper, #f7f4ea);
  }

  .icma-card__status-line {
    color: var(--icma-accent, var(--hc-gold));
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .icma-card__rule {
    height: 1px;
    background: var(--icma-rule, rgba(216, 186, 130, 0.2));
    margin: 0.8rem 0 1rem;
  }

  /* Main Editorial Heading Block */
  .icma-card__heading {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-width: 950px;
  }

  .icma-card__kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--icma-accent, var(--hc-gold));
    font-weight: 600;
  }

  .icma-card__period {
    color: var(--icma-muted, rgba(247, 243, 234, 0.65));
    font-weight: 400;
  }

  .icma-card__title {
    margin: 0.15rem 0 0;
    font-family: "Gentium Plus", var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 2.1rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--icma-paper, #ffffff);
    text-wrap: balance;
  }

  .icma-card__title-link {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .icma-card__title-link:hover {
    color: var(--icma-accent-bright, var(--hc-gold));
  }

  .icma-card__subtitle {
    margin: 0.15rem 0 0;
    font-size: 0.94rem;
    line-height: 1.45;
    font-style: italic;
    color: var(--icma-muted, rgba(247, 243, 234, 0.82));
  }

  .icma-card__arabic {
    margin-top: 0.35rem;
    font-family: var(--font-arabic);
    font-size: 1.25rem;
    line-height: 1.35;
    color: var(--icma-accent, var(--hc-gold));
    text-align: right;
  }

  /* Abstract & Critical Synthesis */
  .icma-card__abstract-wrap {
    margin-top: 1rem;
    max-width: 860px;
  }

  .icma-card__abstract {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.68;
    color: var(--icma-paper, rgba(255, 255, 255, 0.92));
    opacity: 0.94;
  }

  /* Critical Evidence Dossier (Clean Bibliographic Register - No Boxed Tables) */
  .icma-card__dossier {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 1.25rem 0 0;
    padding: 0.9rem 0;
    border-top: 1px solid var(--icma-rule, rgba(216, 186, 130, 0.2));
    border-bottom: 1px solid var(--icma-rule, rgba(216, 186, 130, 0.2));
  }

  .icma-card__dossier-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .icma-card__dossier-term {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--icma-accent, var(--hc-gold));
    opacity: 0.9;
  }

  .icma-card__dossier-desc {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.45;
    font-weight: 500;
    color: var(--icma-paper, #ffffff);
  }

  /* Methodological Apparatus (Quiet Scholarly Note - No AI Side-Stripes) */
  .icma-card__apparatus {
    margin-top: 1rem;
    padding: 0.4rem 0 0;
  }

  .icma-card__apparatus-text {
    margin: 0;
    font-size: 0.83rem;
    line-height: 1.58;
    color: var(--icma-muted, rgba(250, 245, 235, 0.78));
  }

  .icma-card__apparatus-lead {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--icma-accent, var(--hc-gold));
  }

  /* Card Footer (Archive / Citation / Download) */
  .icma-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.3rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--icma-rule, rgba(216, 186, 130, 0.2));
    font-family: var(--font-ui);
    font-size: 0.75rem;
    flex-wrap: wrap;
  }

  .icma-card__citation {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--icma-muted, rgba(255, 255, 255, 0.75));
  }

  .icma-card__citation code {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--icma-accent-bright, var(--hc-gold));
    background: rgba(0, 0, 0, 0.25);
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--icma-rule, rgba(255, 255, 255, 0.15));
  }

  .icma-card__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* ═══════════════════════════════════════════════════════════════════════
     ICMA VISUAL FAMILIES (Subtle Scholarly Architectural Accents)
     ═══════════════════════════════════════════════════════════════════════ */

  .icma-card--legal {
    outline-offset: -9px;
  }

  .icma-card--polemics {
    box-shadow: inset 0 0 110px rgba(0, 0, 0, 0.65), 0 10px 32px rgba(0, 0, 0, 0.45);
  }

  /* Carousel Controls */
  .studies-carousel__controls {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--hc-rule);
  }

  .studies-carousel__button {
    background: transparent;
    border: 1px solid var(--hc-rule-strong);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.45rem 0.8rem;
    cursor: pointer;
    transition: all var(--motion-fast) ease;
  }

  .studies-carousel__button:hover {
    border-color: var(--hc-gold);
    color: var(--hc-gold);
  }

  .studies-carousel__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.35rem 0.5rem;
    max-width: 100%;
  }

  .studies-carousel__dots::-webkit-scrollbar {
    display: none;
  }

  .studies-carousel__dot {
    flex: 0 0 auto;
    width: 14px;
    height: 3px;
    padding: 0;
    border: 1px solid var(--hc-rule);
    background: transparent;
    cursor: pointer;
    transition: width 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .studies-carousel__dot:hover {
    border-color: var(--hc-gold-dim);
  }

  .studies-carousel__dot.is-active {
    width: 28px;
    background: var(--hc-gold);
    border-color: var(--hc-gold);
  }

  /* ── Motzki Case Files ── */
  .motzki-section { padding-top: clamp(4.5rem, 8vw, 7rem); }
  .motzki-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 1.4rem; }
  .motzki-lead { max-width: 760px; margin: .8rem 0 0; font-size: .92rem; line-height: 1.68; color: var(--hc-text-secondary); }

  .motzki-carousel { border: 1px solid var(--hc-rule-strong); background: color-mix(in srgb, var(--hc-surface-1) 82%, transparent); }
  .motzki-carousel__topbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .75rem 1rem; border-bottom: 1px solid var(--hc-rule); font-family: var(--font-ui); font-size: .76rem; text-transform: uppercase; letter-spacing: .1em; color: var(--hc-text-tertiary); }
  .motzki-carousel__eyebrow { display: flex; align-items: center; gap: .65rem; }
  .motzki-carousel__line { display: inline-block; width: 28px; height: 1px; background: var(--hc-rule-strong); }
  .motzki-carousel__eyebrow span:first-child { color: var(--hc-gold); }
  .motzki-carousel__counter { display: inline-flex; align-items: baseline; gap: .35rem; }
  .motzki-carousel__counter strong { font-size: .82rem; color: var(--hc-text-primary); }

  .motzki-carousel__stage { position: relative; overflow: hidden; transition: height 280ms var(--ease, ease); }
  .motzki-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem 1.35rem 1.2rem;
    opacity: 0;
    transform: translateX(22px);
    pointer-events: none;
    visibility: hidden;
    background: color-mix(in srgb, var(--hc-surface-1) 88%, transparent);
    transition: opacity 220ms ease, transform 260ms ease;
  }
  .motzki-card.is-active { position: relative; opacity: 1; transform: translateX(0); pointer-events: auto; visibility: visible; }
  .motzki-card__topline { display: flex; align-items: center; justify-content: flex-end; gap: 1rem; }
  .motzki-card__meta { display: flex; gap: .5rem .75rem; flex-wrap: wrap; justify-content: flex-end; font-family: var(--font-ui); font-size: .76rem; text-transform: uppercase; letter-spacing: .08em; color: var(--hc-text-tertiary); text-align: right; }
  .motzki-card__meta span + span::before { content: '·'; margin-right: .75rem; color: var(--hc-rule-strong); }
  .motzki-card__rule { height: 1px; background: var(--hc-rule); margin: .72rem 0 .85rem; }
  .motzki-card__heading { display: flex; flex-direction: column; gap: .28rem; }
  .motzki-card__subject, .motzki-card__label { font-family: var(--font-ui); font-size: .76rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--hc-gold); }
  .motzki-card h3 { max-width: 980px; margin: 0; font-family: "Gentium Plus", serif; font-size: clamp(1.35rem, 2.25vw, 2rem); line-height: 1.15; font-weight: 700; color: var(--hc-text-primary); }
  .motzki-card__body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .9fr); gap: 1.25rem 2rem; margin-top: 1rem; }
  .motzki-card__summary-wrap { min-width: 0; }
  .motzki-card__label { display: block; margin-bottom: .45rem; color: var(--hc-text-tertiary); }
  .motzki-card__summary { margin: 0; max-width: 760px; font-size: .88rem; line-height: 1.65; color: var(--hc-text-secondary); }
  .motzki-card__points { min-width: 0; padding-left: 1.15rem; border-left: 1px solid var(--hc-rule); }
  .motzki-card__points-head { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: .45rem; font-family: var(--font-ui); font-size: .76rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--hc-text-tertiary); }
  .motzki-card__points-head span:last-child { color: var(--hc-gold); }
  .motzki-card__points ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .34rem; }
  .motzki-card__points li { display: grid; grid-template-columns: 13px minmax(0,1fr); gap: .4rem; font-size: .84rem; line-height: 1.5; color: var(--hc-text-secondary); }
  .motzki-point-mark { color: var(--hc-gold); font-family: var(--font-ui); font-weight: 700; }

  /* ═══════════════════════════════════════════════════════════════════════
     MOTZKI PUBLICATION FAMILIES
     Directly reflecting the 5 physical book editions:
     1. 📕 The Origins of Islamic Jurisprudence (Brill, 2002) - 01 to 06
     2. 📗 Analysing Muslim Traditions (Brill, 2010) - 07 to 09
     3. 📘 The Biography of Muḥammad (Brill, 2000) - 10
     4. 📙 Reconstruction of a Source of Ibn Isḥāq… (Gorgias, 2017) - 11
     5. 📓 Ḥadīth: Origins and Developments (Routledge, 2004) - 12
     ═══════════════════════════════════════════════════════════════════════ */

  /* Common elements for edition-styled cards */
  .motzki-card__series-strip {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-bottom: 0.6rem;
    color: var(--hc-gold);
    opacity: 0.92;
  }

  .motzki-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1.35rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hc-rule);
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .motzki-card__edition-title {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-style: italic;
    letter-spacing: 0.02em;
    opacity: 0.88;
  }

  .motzki-card__edition-sub {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    opacity: 0.7;
    letter-spacing: 0.05em;
  }

  .motzki-card__publisher-tag {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.9;
  }

  /* ───────────────────────────────────────────────────────────────────────
     1. 📕 Brill — The Origins of Islamic Jurisprudence (01–06)
     Cover: Bold crimson ground, authentic Brill gold foil framing lines,
     refined ivory typography, gold series tag.
     ─────────────────────────────────────────────────────────────────────── */
  .motzki-card--origins-jurisprudence {
    --brill-red-top: #8a1322;
    --brill-red-mid: #6f0c1b;
    --brill-red-deep: #500612;
    --brill-ivory: #faf5ea;
    --brill-gold: #dfbe7d;
    --brill-rule: rgba(223, 190, 125, 0.28);
    isolation: isolate;
    overflow: hidden;
    padding: 1.5rem 1.85rem 1.4rem;
    color: var(--brill-ivory);
    background:
      radial-gradient(ellipse at 50% 15%, rgba(255, 235, 205, 0.08), transparent 60%),
      linear-gradient(180deg, var(--brill-red-top) 0%, var(--brill-red-mid) 50%, var(--brill-red-deep) 100%);
    box-shadow: inset 0 0 85px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(223, 190, 125, 0.35);
    outline: 1px solid rgba(223, 190, 125, 0.16);
    outline-offset: -6px;
  }
  .motzki-card--origins-jurisprudence .motzki-card__series-strip { color: var(--brill-gold); letter-spacing: 0.18em; }
  .motzki-card--origins-jurisprudence .motzki-card__meta { color: rgba(250, 245, 234, 0.74); }
  .motzki-card--origins-jurisprudence .motzki-card__meta span + span::before { color: rgba(223, 190, 125, 0.4); }
  .motzki-card--origins-jurisprudence .motzki-card__rule { background: var(--brill-rule); }
  .motzki-card--origins-jurisprudence .motzki-card__subject { color: var(--brill-gold); letter-spacing: 0.14em; }
  .motzki-card--origins-jurisprudence h3 { font-family: "Gentium Plus", serif; font-weight: 700; color: #ffffff; text-wrap: balance; }
  .motzki-card--origins-jurisprudence .motzki-card__label { color: rgba(250, 245, 234, 0.68); letter-spacing: 0.12em; }
  .motzki-card--origins-jurisprudence .motzki-card__summary,
  .motzki-card--origins-jurisprudence .motzki-card__points li { color: rgba(255, 250, 242, 0.94); }
  .motzki-card--origins-jurisprudence .motzki-card__points { border-left-color: var(--brill-rule); }
  .motzki-card--origins-jurisprudence .motzki-card__points-head { color: rgba(250, 245, 234, 0.72); }
  .motzki-card--origins-jurisprudence .motzki-card__points-head span:last-child,
  .motzki-card--origins-jurisprudence .motzki-point-mark { color: var(--brill-gold); }
  .motzki-card--origins-jurisprudence .motzki-card__footer { border-top-color: var(--brill-rule); color: rgba(250, 245, 234, 0.88); }
  .motzki-card--origins-jurisprudence .motzki-card__publisher-tag { letter-spacing: 0.26em; color: #ffffff; }

  /* ───────────────────────────────────────────────────────────────────────
     2. 📗 Brill — Analysing Muslim Traditions (07–09)
     Cover: Deep wine/ruby ground, left spine ribbon with vertical gold/ivory
     series text, stately typography and gold accents.
     ─────────────────────────────────────────────────────────────────────── */
  .motzki-card--analysing-traditions {
    --analysing-wine-top: #781726;
    --analysing-wine-mid: #61101d;
    --analysing-wine-deep: #480812;
    --analysing-cream: #faf4e8;
    --analysing-gold: #d8ba82;
    --analysing-rule: rgba(250, 244, 232, 0.22);
    isolation: isolate;
    overflow: hidden;
    padding: 1.5rem 1.85rem 1.4rem 3.8rem;
    color: var(--analysing-cream);
    background:
      radial-gradient(ellipse at 50% 18%, rgba(255, 235, 215, 0.07), transparent 65%),
      linear-gradient(180deg, var(--analysing-wine-top) 0%, var(--analysing-wine-mid) 50%, var(--analysing-wine-deep) 100%);
