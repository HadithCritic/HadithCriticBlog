    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 0;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    opacity: 0;
    transform: translateY(8px);
    visibility: hidden;
    pointer-events: none;
    transition: opacity 180ms ease, transform 220ms ease;
  }

  .icma-card.is-active {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  /* Family modifiers remain semantic hooks */
  .icma-card--polemics,
  .icma-card--geography,
  .icma-card--chronology,
  .icma-card--legal,
  .icma-card--source-reconstruction,
  .icma-card--variants,
  .icma-card--network {
    background: transparent;
  }

  .icma-card__folio-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--hc-rule);
  }

  .icma-card__folio-left,
  .icma-card__folio-right {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.45rem 0.65rem;
    min-width: 0;
  }

  .icma-card__folio-right {
    justify-content: flex-end;
  }

  .icma-card__folio-badge,
  .icma-card__cite-pill,
  .icma-card__series-name,
  .icma-card__family-chip,
  .icma-card__status-dot {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.35;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .icma-card__folio-badge {
    color: var(--hc-text-primary);
    font-weight: 700;
  }

  .icma-card__cite-pill {
    color: var(--hc-gold);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .icma-card__series-name,
  .icma-card__family-chip,
  .icma-card__status-dot {
    color: var(--hc-text-tertiary);
  }

  .icma-card__folio-sep {
    color: var(--hc-rule-strong);
  }

  .icma-card__family-chip,
  .icma-card__status-dot {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .icma-card__hero {
    max-width: 72rem;
    padding: 0.5rem 0 0.5rem;
  }

  .icma-card__motif-line {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .icma-card__motif-mark {
    display: inline-block;
    color: var(--hc-gold);
    font-weight: 700;
  }

  .icma-card__motif-title {
    color: var(--hc-text-secondary);
  }

  .icma-card__title {
    max-width: 30ch;
    margin: 0;
    font-family: var(--font-display, serif);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .icma-card__title-link {
    color: var(--hc-text-primary);
    text-decoration: none;
  }

  .icma-card__title-link:hover,
  .icma-card__title-link:focus-visible {
    color: var(--hc-gold);
  }

  .icma-card__subtitle {
    max-width: 58ch;
    margin: 0.65rem 0 0;
    font-family: var(--font-display, serif);
    font-size: 1.02rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--hc-text-secondary);
  }

  .icma-card__body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
    align-items: start;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .icma-card__col-main,
  .icma-card__col-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .icma-card__abstract {
    max-width: 66ch;
    margin: 0;
    font-size: 0.96rem;
    line-height: 1.75;
    color: var(--hc-text-secondary);
  }

  .icma-card__specs {
    display: grid;
    background: color-mix(in srgb, var(--hc-surface-2) 40%, transparent);
    padding: 0.25rem 1rem;
    border-radius: var(--radius-xs, 4px);
    border: 1px solid var(--hc-rule);
  }

  .icma-card__spec-item {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--hc-rule);
  }

  .icma-card__spec-item:last-child {
    border-bottom: none;
  }

  .icma-card__spec-label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .icma-card__spec-val {
    font-family: var(--font-display, serif);
    font-size: 0.98rem;
    line-height: 1.35;
    color: var(--hc-text-primary);
  }

  .icma-card__spec-val--accent {
    color: var(--hc-gold);
  }

  .icma-card__apparatus-strip {
    margin-top: 0.5rem;
    padding: 1rem 0 0;
    border-top: 1px solid var(--hc-rule);
  }

  .icma-card__apparatus-tag,
  .icma-card__findings-head {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--hc-gold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .icma-card__apparatus-note {
    max-width: 66ch;
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--hc-text-secondary);
  }

  .icma-card__findings {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hc-rule);
  }

  .icma-card__findings-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .icma-card__findings-list li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.4rem;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--hc-text-secondary);
  }

  .icma-card__findings-mark {
    color: var(--hc-gold);
    font-family: var(--font-ui);
  }

  .icma-card__colophon {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem 2rem;
    align-items: end;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--hc-rule-strong);
  }

  .icma-card__cite-stamp {
    min-width: 0;
  }

  .icma-card__stamp-label {
    display: block;
    margin-bottom: 0.3rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .icma-card__cite-stamp code {
    display: block;
    overflow-wrap: anywhere;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--hc-text-secondary);
  }

  .icma-card__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .icma-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-xs, 4px);
    background: transparent;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .icma-btn--ghost {
    color: var(--hc-text-secondary);
    border: 1px solid var(--hc-rule);
  }

  .icma-btn--primary {
    color: var(--hc-gold);
    border: 1px solid var(--hc-gold);
    background: color-mix(in srgb, var(--hc-gold) 10%, transparent);
  }

  .icma-btn--ghost:hover,
  .icma-btn--ghost:focus-visible {
    color: var(--hc-text-primary);
    border-color: var(--hc-rule-strong);
  }

  .icma-btn--primary:hover,
  .icma-btn--primary:focus-visible {
    color: #ffffff;
    background: var(--hc-gold);
  }

  /* -----------------------------------------------------------------------
     05 — Dossier controls
     ----------------------------------------------------------------------- */

  .studies-carousel__controls,
  .motzki-carousel__controls {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--hc-rule);
    background: var(--hc-surface-1);
  }

  .studies-carousel__button,
  .motzki-carousel__button {
    justify-self: start;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 4px);
    background: transparent;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .studies-carousel__button:last-child,
  .motzki-carousel__button:last-child {
    justify-self: end;
  }

  .studies-carousel__button:hover,
  .studies-carousel__button:focus-visible,
  .motzki-carousel__button:hover,
  .motzki-carousel__button:focus-visible {
    color: var(--hc-text-primary);
    border-color: var(--hc-rule-strong);
  }

  .studies-carousel__dots,
  .motzki-carousel__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .studies-carousel__dots::-webkit-scrollbar,
  .motzki-carousel__dots::-webkit-scrollbar {
    display: none;
  }

  .studies-carousel__dot,
  .motzki-carousel__dot {
    width: 1.65rem;
    height: 3px;
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    border-radius: 1px;
    background: var(--hc-rule);
    cursor: pointer;
    transition: background 150ms ease;
  }

  .studies-carousel__dot:hover,
  .studies-carousel__dot.is-active,
  .motzki-carousel__dot:hover,
  .motzki-carousel__dot.is-active {
    background: var(--hc-gold);
  }

  /* -----------------------------------------------------------------------
     06 — Complete archival ledger
     ----------------------------------------------------------------------- */

  .studies-ledger {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    border-top: 1px solid var(--hc-rule-strong);
  }

  .studies-ledger__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--hc-rule);
  }

  .studies-ledger__kicker {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--hc-gold);
  }

  .studies-ledger__title {
    margin: 0;
    font-family: var(--font-display, serif);
    font-size: clamp(1.55rem, 2.8vw, 2.35rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .studies-ledger__meta {
    max-width: 36ch;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--hc-text-tertiary);
    text-align: right;
  }

  .studies-ledger__table-wrap {
    overflow-x: auto;
  }

  .studies-ledger__table {
    width: 100%;
    min-width: 980px;
    border-collapse: collapse;
  }

  .studies-ledger__table th {
    padding: 0.85rem 0.85rem;
    border-bottom: 1px solid var(--hc-rule-strong);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-align: left;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
    white-space: nowrap;
  }

  .studies-ledger__table td {
    padding: 1rem 0.85rem;
    border-bottom: 1px solid var(--hc-rule);
    vertical-align: top;
  }

  .studies-ledger__row {
    transition: background 120ms ease;
  }

  .studies-ledger__row:hover,
  .studies-ledger__row.is-active {
    background: var(--hc-surface-1);
  }

  .studies-ledger__row.is-hidden {
    display: none;
  }

  .studies-ledger__empty {
    display: none;
  }

  .studies-ledger__empty.is-visible {
    display: table-row;
  }

  .studies-ledger__empty td {
    padding: 1.75rem 0.9rem;
    color: var(--hc-text-secondary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    text-align: center;
  }

  .studies-ledger__empty strong {
    color: var(--hc-text-primary);
  }

  .studies-ledger__cite-code {
    display: inline-block;
    min-width: 4.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    color: var(--hc-gold);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .studies-ledger__entry-link {
    display: block;
    color: var(--hc-text-primary);
    text-decoration: none;
  }

  .studies-ledger__entry-link strong {
    display: block;
    max-width: 54ch;
    font-family: var(--font-display, serif);
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .studies-ledger__entry-link:hover strong,
  .studies-ledger__entry-link:focus-visible strong {
    color: var(--hc-gold);
  }

  .studies-ledger__subtitle,
  .studies-ledger__arabic,
  .studies-ledger__tradition {
    display: block;
    margin-top: 0.28rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--hc-text-tertiary);
  }

  .studies-ledger__common-link {
    font-family: var(--font-display, serif);
    font-size: 0.94rem;
    line-height: 1.4;
    color: var(--hc-text-secondary);
  }

  .studies-ledger__badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 4px);
    background: color-mix(in srgb, var(--hc-surface-2) 50%, transparent);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--hc-text-secondary);
    white-space: nowrap;
  }

  .th-action,
  .td-action {
    text-align: right;
  }

  .studies-ledger__actions {
    display: inline-flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .studies-ledger__inspect-btn,
  .studies-ledger__read-link {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 4px);
    background: transparent;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .studies-ledger__read-link {
    color: var(--hc-gold);
    border-color: var(--hc-rule-strong);
  }

  .studies-ledger__inspect-btn:hover,
  .studies-ledger__inspect-btn:focus-visible {
    color: var(--hc-text-primary);
    border-color: var(--hc-rule-strong);
  }

  .studies-ledger__read-link:hover,
  .studies-ledger__read-link:focus-visible {
    color: #ffffff;
    background: var(--hc-gold);
    border-color: var(--hc-gold);
  }

  /* -----------------------------------------------------------------------
     07 — Motzki research dossier
     ----------------------------------------------------------------------- */

  .motzki-section {
    padding-top: clamp(4.5rem, 8vw, 7rem);
  }

  .motzki-header {
    margin-bottom: 2.25rem;
  }

  .motzki-lead {
    max-width: 66ch;
    margin: 0.8rem 0 0;
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--hc-text-secondary);
  }

  .motzki-carousel {
    border: 1px solid var(--hc-rule-strong);
    border-radius: var(--radius-xs, 4px);
    background: var(--hc-surface-1);
    overflow: hidden;
  }

  .motzki-carousel__topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--hc-rule);
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
  }

  .motzki-carousel__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .motzki-carousel__eyebrow span:first-child {
    color: var(--hc-gold);
    font-weight: 700;
  }

  .motzki-carousel__line {
    width: 2.4rem;
    height: 1px;
    background: var(--hc-rule-strong);
  }

  .motzki-carousel__counter {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .motzki-carousel__counter strong {
    color: var(--hc-text-primary);
  }

  .motzki-carousel__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .motzki-card {
    grid-area: 1 / 1 / 2 / 2;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    opacity: 0;
    transform: translateY(8px);
    visibility: hidden;
    pointer-events: none;
    transition: opacity 180ms ease, transform 220ms ease;
  }

  .motzki-card.is-active {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .motzki-card--origins-jurisprudence,
  .motzki-card--analysing-traditions,
  .motzki-card--biography-muhammad,
  .motzki-card--reconstruction-ishaq,
  .motzki-card--hadith-origins {
    background: transparent;
    color: inherit;
  }

  .motzki-card__topline {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: 1rem;
  }

  .motzki-card__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
    text-align: right;
  }

  .motzki-card__meta span + span::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--hc-rule-strong);
  }

  .motzki-card__rule {
    height: 1px;
    margin: 0.25rem 0 0.5rem;
    background: var(--hc-rule);
  }

  .motzki-card__heading {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .motzki-card__subject,
  .motzki-card__label {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--hc-gold);
  }

  .motzki-card h3 {
    max-width: 32ch;
    margin: 0;
    font-family: var(--font-display, serif);
    font-size: clamp(1.65rem, 2.8vw, 2.35rem);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .motzki-card__sources-tag {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.25rem;
    font-family: var(--font-display, serif);
    font-size: 0.98rem;
    color: var(--hc-text-secondary);
  }

  .motzki-card__dash {
    color: var(--hc-rule-strong);
  }

  .motzki-card__body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-top: 0.5rem;
  }

  .motzki-card__summary-wrap {
    min-width: 0;
  }

  .motzki-card__summary {
    max-width: 68ch;
    margin: 0.55rem 0 0;
    font-size: 0.95rem;
    line-height: 1.78;
    color: var(--hc-text-secondary);
  }

  .motzki-card__points {
    min-width: 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--hc-rule);
  }

  .motzki-card__points-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
