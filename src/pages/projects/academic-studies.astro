---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { OG } from "../../lib/seo";
import { getCollection } from "astro:content";
import { academicStudies } from "../../data/research/academic-studies";
import { FAMILIES, familyText, studyFamily, type IcmaFamily } from "../../data/research/icma-families";
import { relatedMethods } from "../../data/research/related-methods";
import "../../styles/icma-register.css";

/* The ICMA Register: one featured study, a short key to what an entry
   records, then every study as a card that can be searched, narrowed to a
   research family and reordered (src/lib/icma-register.ts). Each card heads
   with a plate in its family's fixed jacket colors and the study's Arabic
   title, so the families read apart at a glance in either theme. Further
   reading on the method closes the page. */

/* The study set out above the register. The build fails if it goes missing. */
const FEATURED_SLUG = "78-the-scroll-and-the-sword-the-polemical-use-of-alis-authority";

const articles = await getCollection("articles");
const articleUrl = new Map(
  articles.map((entry) => [entry.id.split("/").pop()!.replace(/\.mdx?$/, ""), `/blogs/${entry.id}/`])
);

const studies = academicStudies
  .filter((study) => study.category === "icma")
  .map((study, index) => {
    const family: IcmaFamily = studyFamily[study.slug] ?? "network";
    const text = familyText(family);
    const { bg, ink, accent, label } = FAMILIES[family];
    return {
      ...study,
      index: index + 1,
      no: String(index + 1).padStart(2, "0"),
      family,
      familyLabel: label,
      style: `--fam-bg:${bg};--fam-ink:${ink};--fam-accent:${accent};--fam-light:${text.light};--fam-dark:${text.dark}`,
      href: articleUrl.get(study.slug) ?? `/blogs/${study.slug}/`,
      search: [study.title, study.subtitle, study.tradition, study.commonLink, study.dating, study.abstract, study.citeKey, label]
        .filter(Boolean)
        .join(" ")
    };
  });

const featured = studies.find((study) => study.slug === FEATURED_SLUG);
if (!featured) throw new Error(`ICMA Register: featured study "${FEATURED_SLUG}" is missing`);

/* Newest first, as the grid opens. */
const register = [...studies].reverse();

/* Families largest first, so the filters lead with the bigger groups. */
const families = (Object.keys(FAMILIES) as IcmaFamily[])
  .map((id) => {
    const text = familyText(id);
    return {
      id,
      label: FAMILIES[id].label,
      count: studies.filter((study) => study.family === id).length,
      style: `--fam-light:${text.light};--fam-dark:${text.dark}`
    };
  })
  .filter((family) => family.count > 0)
  .sort((a, b) => b.count - a.count);

const KEY = [
  {
    term: "Tradition studied",
    text: "The report under study, with every version of its wording gathered from the collections."
  },
  {
    term: "Common link",
    text: "The transmitter in whom the chains of those versions meet, and below whom they divide."
  },
  {
    term: "Dated",
    text: "When and where the wording took shape, read from the common link and the variants after it."
  }
];
---

<BaseLayout
  image={OG.icma}
  title="The ICMA Register | HadithCritic Projects"
  description="A register of isnād-cum-matn studies, each traced to its common link and dated."
>
  <div class="hc-page ic-page">
    <PageHero
      title="The ICMA"
      accent="Register."
      titleId="ic-title"
      kicker="Projects"
      kickerHref="/projects/"
      art="/images/platform/icma.webp"
      focus="70% center"
      measure="9ch"
    >
      <p class="hc-hero__lede">
        Isnād-cum-matn studies that gather every version of a tradition, find the transmitter where
        its chains meet, and date the wording from there.
      </p>
      <Fragment slot="actions">
        <a class="hc-btn" href="#register">Browse the register</a>
        <a class="hc-btn hc-btn--ghost" href="#key">How an entry reads</a>
      </Fragment>
    </PageHero>

    <!-- The featured study. -->
    <section class="hc-band ic-feature-band" aria-labelledby="ic-feature-title">
      <div class="hc-container">
        <article class="ic-feature ic-fam" style={featured.style}>
          <div class={`ic-plate ic-plate--${featured.family} ic-plate--large`}>
            <p class="ic-plate__no">No. {featured.no}</p>
            <p class="ic-plate__ar" lang="ar" dir="rtl">{featured.arabicTitle}</p>
          </div>
          <div class="ic-feature__copy">
            <p class="ic-feature__label">
              Featured study <span aria-hidden="true">·</span> <span class="ic-family">{featured.familyLabel}</span>
            </p>
            <h2 id="ic-feature-title" class="ic-feature__title">
              <a href={featured.href}>{featured.title}</a>
            </h2>
            {featured.subtitle && <p class="ic-feature__sub">{featured.subtitle}</p>}
            <p class="ic-feature__abstract">{featured.abstract}</p>
            <dl class="ic-facts ic-facts--row">
              <div><dt>Tradition studied</dt><dd>{featured.tradition}</dd></div>
              <div><dt>Common link</dt><dd>{featured.commonLink}</dd></div>
              <div><dt>Dated</dt><dd>{featured.dating}</dd></div>
            </dl>
            <a class="hc-link" href={featured.href}>Read the study <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </section>

    <!-- What each entry records. -->
    <section class="ic-key-band" id="key" aria-labelledby="ic-key-title">
      <div class="hc-container ic-key">
        <h2 id="ic-key-title" class="ic-key__title">How an entry reads</h2>
        <ol class="ic-key__list">
          {KEY.map((item, index) => (
            <li>
              <span class="ic-key__n" aria-hidden="true">{index + 1}</span>
              <span class="ic-key__term">{item.term}</span>
              <span class="ic-key__text">{item.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- The register. -->
    <section class="hc-band ic-register" id="register" aria-labelledby="ic-register-title">
      <div class="hc-container">
        <div class="ic-tools">
          <div class="ic-tools__head">
            <h2 id="ic-register-title" class="hc-head__title">The complete <span>register</span></h2>
            <div class="ic-tools__controls" data-js-only hidden>
              <div class="ic-search" role="search">
                <label class="sr-only" for="ic-query">Search titles, traditions and common links</label>
                <div class="hc-field">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                  <input id="ic-query" type="search" placeholder="Search the register" autocomplete="off" spellcheck="false" data-icma-query />
                </div>
              </div>
              <label class="ic-order">
                <span class="sr-only">Order</span>
                <select class="hc-select" data-icma-order>
                  <option value="newest">Newest first</option>
                  <option value="oldest">Oldest first</option>
                  <option value="title">Title A to Z</option>
                </select>
              </label>
            </div>
          </div>

          <div class="ic-tools__bar" data-js-only hidden>
            <ul class="hc-chips ic-chips" aria-label="Research family">
              <li>
                <button type="button" class="hc-chip" data-icma-family="all" data-label="all families" aria-pressed="true">
                  All families <span class="hc-chip__n">{studies.length}</span>
                </button>
              </li>
              {families.map((family) => (
                <li>
                  <button
                    type="button"
                    class="hc-chip ic-chip ic-fam"
                    style={family.style}
                    data-icma-family={family.id}
                    data-label={family.label}
                    aria-pressed="false"
                  >
                    <span class="ic-chip__dot" aria-hidden="true"></span>
                    {family.label} <span class="hc-chip__n">{family.count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <div class="ic-status-row">
            <p class="ic-status" role="status" aria-live="polite" data-icma-status>{studies.length} studies</p>
            <button type="button" class="ic-reset" data-icma-reset hidden>Clear</button>
          </div>
        </div>

        <ol class="ic-grid" data-icma-grid>
          {register.map((study) => (
            <li
              class="ic-card ic-fam"
              style={study.style}
              data-study
              data-family={study.family}
              data-no={study.index}
              data-title={study.title}
              data-search={study.search}
            >
              <article class="ic-card__inner">
                <div class={`ic-plate ic-plate--${study.family}`}>
                  <p class="ic-plate__no">No. {study.no}</p>
                  <p class="ic-plate__ar" lang="ar" dir="rtl">{study.arabicTitle}</p>
                </div>
                <div class="ic-card__body">
                  <p class="ic-family">{study.familyLabel}</p>
                  <h3 class="ic-card__title"><a class="ic-card__link" href={study.href}>{study.title}</a></h3>
                  {study.subtitle && <p class="ic-card__sub">{study.subtitle}</p>}
                  <dl class="ic-facts">
                    <div><dt>Tradition studied</dt><dd>{study.tradition}</dd></div>
                    <div><dt>Common link</dt><dd>{study.commonLink}</dd></div>
                    <div><dt>Dated</dt><dd>{study.dating}</dd></div>
                  </dl>
                </div>
              </article>
            </li>
          ))}
        </ol>

        <div class="ic-empty" data-icma-empty hidden>
          <p>No study matches this search.</p>
          <button type="button" class="hc-btn hc-btn--ghost">Clear search and filter</button>
        </div>
      </div>
    </section>

    <!-- Further reading on the method. -->
    <section class="hc-band ic-reading" aria-labelledby="ic-reading-title">
      <div class="hc-container">
        <h2 id="ic-reading-title" class="hc-head__title ic-reading__title">Further reading <span>on the method</span></h2>
        <ul class="ic-methods">
          {relatedMethods.map((item) => (
            <li class="ic-method">
              <p class="ic-method__year">{item.year}</p>
              <div class="ic-method__body">
                <p class="ic-method__label">{item.label}</p>
                <h3 class="ic-method__title">{item.title}</h3>
                <p class="ic-method__by">{item.author}</p>
                <p class="ic-method__text">{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  import { initIcmaRegister } from "../../lib/icma-register";

  function init(): void {
    const page = document.querySelector<HTMLElement>(".ic-page");
    if (!page || page.dataset.ready === "1") return;
    page.dataset.ready = "1";
    initIcmaRegister(document);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
</script>
