---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { academicStudies } from '../../data/academic-studies';
import { icmaArtDirections, defaultArtDirection } from '../../data/icma-art-directions';
import { getCollection } from 'astro:content';

const icmaStudies = academicStudies.filter((s) => s.category === 'icma');
const otherStudies = academicStudies.filter((s) => s.category !== 'icma');

// Build live article route lookup for all 27 ICMA studies
const allArticles = await getCollection('articles');
const articleMap = new Map<string, string>();
for (const art of allArticles) {
  const filename = art.id.split('/').pop()?.replace(/\.mdx?$/, '') || art.id;
  articleMap.set(filename, `/blogs/${art.id}`);
  articleMap.set(art.id, `/blogs/${art.id}`);
}

const familyLabels: Record<string, string> = {
  chronology: 'Chronology',
  polemics: 'Polemics',
  geography: 'Sacred Geography',
  legal: 'Legal & Penal',
  'source-reconstruction': 'Reconstruction',
  variants: 'Textual Variants',
  network: 'Transmission Network'
};

// Facet counts for the research-family filter in the discovery bar. Derived
// from the same art-direction data the dossier cards and ledger badges
// already read, so a new family added there appears here automatically.
const familyCounts = Object.entries(
  icmaStudies.reduce<Record<string, number>>((acc, study) => {
    const family = (icmaArtDirections[study.slug] || defaultArtDirection).family;
    acc[family] = (acc[family] || 0) + 1;
    return acc;
  }, {})
)
  .map(([family, n]) => ({ family, n, label: familyLabels[family] || family }))
  .sort((a, b) => b.n - a.n);

