<script>
  function initStudiesCarousel() {
    const root = document.querySelector<HTMLElement>('[data-studies-carousel]');
    if (!root || root.dataset.studiesInitialized === 'true') return;
    root.dataset.studiesInitialized = 'true';

    const stage = root.querySelector<HTMLElement>('[data-studies-stage]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-studies-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-studies-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-studies-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-studies-next]');
    const current = root.querySelector<HTMLElement>('[data-studies-current]');

    if (!stage || !slides.length) return;

    let index = 0;

    function syncHeight() {
      const active = slides[index];
      if (stage && active) stage.style.height = `${active.scrollHeight}px`;
    }

    function show(nextIndex: number) {
      index = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      if (current) current.textContent = String(index + 1).padStart(2, '0');
      dots[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      requestAnimationFrame(syncHeight);
    }

    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    let touchStartX = 0;
    stage.addEventListener('touchstart', (e) => {
      if (e.changedTouches && e.changedTouches[0]) {
        touchStartX = e.changedTouches[0].screenX;
      }
    }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (e.changedTouches && e.changedTouches[0]) {
        const touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 45) show(index + 1);
        if (touchEndX - touchStartX > 45) show(index - 1);
      }
    }, { passive: true });

    window.addEventListener('resize', syncHeight);
    show(0);
  }

  function initMotzkiCarousel() {
    const root = document.querySelector<HTMLElement>('[data-motzki-carousel]');
    if (!root || root.dataset.motzkiInitialized === 'true') return;
    root.dataset.motzkiInitialized = 'true';

    const stage = root.querySelector<HTMLElement>('[data-motzki-stage]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-motzki-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-motzki-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-motzki-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-motzki-next]');
    const current = root.querySelector<HTMLElement>('[data-motzki-current]');

    if (!stage || !slides.length) return;

    let index = 0;

    function syncHeight() {
      const active = slides[index];
      if (stage && active) stage.style.height = `${active.scrollHeight}px`;
    }

    function show(nextIndex: number) {
      index = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      if (current) current.textContent = String(index + 1).padStart(2, '0');
      requestAnimationFrame(syncHeight);
    }

    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    window.addEventListener('resize', syncHeight);
    show(0);
  }

  function initCarousels() {
    initStudiesCarousel();
    initMotzkiCarousel();
  }

  document.addEventListener('DOMContentLoaded', initCarousels);
  initCarousels();
</script>

