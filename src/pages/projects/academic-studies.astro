  /* ── Adjacent Scholarship ── */
  .related-section {
    padding-top: clamp(5rem, 9vw, 8rem);
  }

  .related-method-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--hc-rule);
  }

  .related-method {
    position: relative;
    padding: 1.4rem 1.2rem 1.5rem;
    border-right: 1px solid var(--hc-rule);
    border-bottom: 1px solid var(--hc-rule);
    background: color-mix(in srgb, var(--hc-surface-1) 50%, transparent);
    transition: background var(--motion-fast) ease;
  }

  .related-method:first-child {
    border-left: 1px solid var(--hc-rule);
  }

  .related-method:hover {
    background: color-mix(in srgb, var(--hc-surface-2) 65%, transparent);
  }

  .related-method__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .related-method__label {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--hc-text-tertiary);
  }

  .related-method__year {
    font-family: var(--font-ui);
    font-size: 0.76rem;
    color: var(--hc-gold);
  }

  .related-method h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.3;
    font-weight: 500;
    color: var(--hc-text-primary);
  }

  .related-method p {
    margin: 0.5rem 0 0;
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--hc-text-secondary);
  }

  .other-works {
    margin-top: 1.5rem;
    border-top: 1px solid var(--hc-rule);
  }

  .other-works__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hc-text-tertiary);
    flex-wrap: wrap;
  }

  .other-works__head a {
    color: var(--hc-gold);
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  .other-works__head a:hover {
    text-decoration: underline;
  }

  /* ── Light Mode Calibration ── */
  :root[data-theme="light"] .studies-page {
    background:
      radial-gradient(circle at 8% 0%, color-mix(in srgb, var(--hc-gold) 12%, transparent), transparent 28rem),
      linear-gradient(180deg, var(--hc-surface-0) 0%, var(--hc-surface-1) 50%, var(--hc-surface-0) 100%);
  }

  :root[data-theme="light"] .archival-cover-stage {
    background: linear-gradient(155deg, #22201d 0%, #171514 60%, #0d0c0b 100%);
    color: #f7f3ea;
  }

  :root[data-theme="light"] .archival-cover-border {
    border-color: rgba(216, 177, 102, 0.45);
  }


  /* ── Responsive ── */
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-index {
      min-height: auto;
      border-left: 0;
      border-top: 1px solid var(--hc-rule);
      padding: 1.2rem 0 0;
    }

    .hero-index__list {
      margin-top: 1rem;
    }

    .icma-card {
      padding: 1.4rem 1.6rem;
    }

    .icma-card__art-diagram {
      width: clamp(200px, 38%, 340px);
      opacity: 0.16;
    }

    .icma-card__art-watermark {
      font-size: clamp(5rem, 10vw, 7.5rem);
      top: 1rem;
      right: 1.2rem;
    }

    .register-row {
      grid-template-columns: 190px minmax(0, 1fr) 80px;
    }

    .register-row--head span:nth-child(3),
    .register-classification {
      display: none;
    }


    .related-method-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .related-method:nth-child(2n + 1) {
      border-left: 1px solid var(--hc-rule);
    }
  }

  @media (max-width: 720px) {
    .studies-title {
      font-size: clamp(1.95rem, 8vw, 2.65rem);
    }

    .section-intro,
    .register-header {
      align-items: flex-start;
      flex-direction: column;
    }


    .icma-card {
      padding: 1.25rem 1.15rem;
    }

    .icma-card__art-diagram {
      display: none;
    }

    .icma-card__art-watermark {
      font-size: 5rem;
      top: 0.5rem;
      right: 0.6rem;
      opacity: 0.04;
    }

    .icma-card__title {
      font-size: clamp(1.25rem, 4.8vw, 1.55rem);
    }

    .icma-card__arabic {
      font-size: 1.1rem;
    }

    .icma-card__dossier {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .icma-card__footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .studies-carousel__topbar {
      align-items: flex-start;
    }

    .studies-carousel__controls {
      grid-template-columns: auto 1fr auto;
    }

    .studies-carousel__dots {
      overflow: auto;
      justify-content: flex-start;
      scrollbar-width: none;
    }

    .studies-carousel__dots::-webkit-scrollbar {
      display: none;
    }

    .studies-carousel__dot {
      flex: 0 0 auto;
    }

    .studies-carousel__button span {
      display: none;
    }

    .register-toolbar {
      flex-direction: column;
      align-items: stretch;
    }

    .register-search-wrap {
      max-width: none;
    }

    .register-row {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .register-row--head {
      display: none;
    }

    .register-action {
      justify-content: flex-start;
    }


    .related-method-grid {
      grid-template-columns: 1fr;
    }

    .related-method:first-child,
    .related-method:nth-child(2n + 1) {
      border-left: 1px solid var(--hc-rule);
    }

    .related-method {
      border-right: 1px solid var(--hc-rule);
    }
  }


  @media (max-width: 900px) {
    .motzki-card__body { grid-template-columns: 1fr; }
    .motzki-card__points { padding-left: 0; border-left: 0; padding-top: .9rem; border-top: 1px solid var(--hc-rule); }
  }

