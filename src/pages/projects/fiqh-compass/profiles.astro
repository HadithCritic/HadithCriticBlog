---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FiqhCompassNav from "../../../components/FiqhCompassNav.astro";
import { candidateProfiles, plannedTraditions } from "../../../data/fiqh-compass-research";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Projects", url: "/projects/" },
  { name: "Fiqh Compass", url: "/projects/fiqh-compass/" },
  { name: "Profile candidates", url: "/projects/fiqh-compass/profiles/" },
];
---

<BaseLayout
  title="Profile candidates and coverage | Fiqh Compass"
  description="See the candidate author profiles named in the Fiqh Compass roadmap and the source review required before any historical positions can be scored."
  canonical="/projects/fiqh-compass/profiles/"
  crumbs={crumbs}
>
  <div class="fiqh-compass fc-profiles-page">
    <FiqhCompassNav current="profiles" />
    <header class="fc-profiles-hero hc-container">
      <p class="fc-kicker">Historical profile directory · candidates only</p>
      <h1>Profiles need evidence before coordinates.</h1>
      <p>A school name or a jurist’s reputation cannot fill in twelve scores. The roadmap begins with a few author-and-text candidates; each answer must remain unknown until a relevant passage, edition, locator, attribution, and qualification have been reviewed.</p>
      <dl class="fc-profile-stats">
        <div><dt>Suggested starting candidates</dt><dd>{candidateProfiles.length}</dd></div>
        <div><dt>Reviewed profiles with scores</dt><dd>0</dd></div>
        <div><dt>Broader coverage goals</dt><dd>{plannedTraditions.length}</dd></div>
      </dl>
    </header>

    <section class="fc-profile-directory hc-container" aria-labelledby="candidate-title">
      <header class="fc-profile-section-heading">
        <div><p class="fc-kicker">M1 roadmap starting points</p><h2 id="candidate-title">Candidate authors</h2></div>
        <p>These entries describe proposed research leads, not completed profiles or positions.</p>
      </header>
      <ol class="fc-profile-cards">
        {candidateProfiles.map((profile, index) => (
          <li>
            <span class="fc-profile-card__number">0{index + 1}</span>
            <div class="fc-profile-card__body">
              <span class="fc-profile-status">{profile.status}</span>
              <h3>{profile.name}</h3>
              <p class="fc-profile-work">Roadmap source leads: <i>{profile.work}</i></p>
              <p>{profile.note}</p>
              <div class="fc-profile-card__coverage"><span>Axis coordinates</span><strong>Not encoded</strong><span>Issue-level evidence</span><strong>Not reviewed here</strong></div>
              <a class="fc-profile-correction" href={`/projects/fiqh-compass/corrections/?kind=profile&record=${encodeURIComponent(profile.id)}`}>Suggest a profile correction</a>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="fc-coverage hc-container" aria-labelledby="coverage-title">
      <div>
        <p class="fc-kicker">Coverage goals, not catalog entries</p>
        <h2 id="coverage-title">Which traditions the research is working toward.</h2>
        <p>The roadmap calls for source acquisition and coverage checks beyond its initial Sunni-heavy catalog. These are research goals, not claims of completed representation.</p>
      </div>
      <ul>{plannedTraditions.map((tradition) => <li><span aria-hidden="true">◇</span>{tradition}<small>Evidence collection planned</small></li>)}</ul>
    </section>

    <section class="fc-profile-standard hc-container" aria-labelledby="profile-standard-title">
      <p class="fc-kicker">What a publishable profile will show</p>
      <h2 id="profile-standard-title">A bounded author, a visible evidence trail.</h2>
      <ul>
        <li>Author, work, period, edition, and the profile’s scope.</li>
        <li>Passages with locators, translation, and attribution type.</li>
        <li>Qualifications, competing positions, and unresolved claims.</li>
        <li>Axis coverage that preserves unknowns instead of filling gaps.</li>
      </ul>
      <a class="fc-profile-link" href="/projects/fiqh-compass/issues/">Browse the proposed issue register <span aria-hidden="true">→</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .fiqh-compass.fc-profiles-page { --fc-bg: var(--hc-surface-0); --fc-ink: var(--hc-text-primary); --fc-text: var(--hc-text-secondary); --fc-muted: var(--hc-text-tertiary); --fc-line: var(--hc-rule-soft); --fc-paper: var(--hc-surface-2); --fc-green: var(--hc-gold); --fc-accent: var(--hc-gold); color: var(--fc-ink); background: var(--fc-bg); padding-bottom: clamp(4rem, 8vw, 7rem); }
  .fc-profiles-hero { padding-block: clamp(3.5rem, 7vw, 6rem) 2.5rem; }
  .fc-kicker { margin: 0 0 0.55rem; color: var(--fc-accent); font: 600 0.75rem/1.4 var(--font-ui); letter-spacing: 0.12em; text-transform: uppercase; }
  .fc-profiles-hero h1 { max-width: 20ch; margin: 0; font: 500 clamp(2.4rem, 5vw, 4.4rem)/1.08 var(--font-display); letter-spacing: -0.045em; text-wrap: balance; }
  .fc-profiles-hero > p:not(.fc-kicker) { max-width: 76ch; margin: 1rem 0 0; color: var(--fc-text); line-height: 1.7; }
  .fc-profile-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 2rem 0 0; border-top: 1px solid var(--fc-line); }
  .fc-profile-stats div { padding: 0.9rem 1rem 0.9rem 0; border-bottom: 1px solid var(--fc-line); }
  .fc-profile-stats dt { color: var(--fc-muted); font: 600 0.75rem/1.4 var(--font-ui); letter-spacing: 0.08em; text-transform: uppercase; }
  .fc-profile-stats dd { margin: 0.2rem 0 0; color: var(--fc-ink); font: 600 1.1rem/1.4 var(--font-display); }
  .fc-profile-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.3rem; }
  .fc-profile-section-heading h2, .fc-coverage h2, .fc-profile-standard h2 { max-width: 24ch; margin: 0; font: 500 clamp(1.8rem, 3.2vw, 2.7rem)/1.12 var(--font-display); letter-spacing: -0.035em; }
  .fc-profile-section-heading > p { max-width: 38ch; margin: 0; color: var(--fc-text); line-height: 1.6; }
  .fc-profile-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; margin: 0; padding: 0; list-style: none; }
  .fc-profile-cards li { --fc-ink: var(--hc-fixed-parchment-ink); --fc-text: #4e4842; --fc-muted: #58534c; --fc-line: rgba(92, 66, 34, 0.24); --fc-accent: var(--hc-fixed-parchment-ink); display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.8rem; min-width: 0; padding: 1.15rem; border: 1px solid var(--fc-line); border-radius: 0.12rem; background: var(--hc-fixed-parchment); }
  .fc-profile-card__number { color: var(--fc-accent); font: 600 0.75rem/1.5 var(--font-ui); letter-spacing: 0.08em; }
  .fc-profile-status { display: inline-block; padding: 0.24rem 0.5rem; border: 1px solid var(--fc-line); border-radius: 999px; color: var(--fc-muted); font: 600 0.75rem/1.35 var(--font-ui); }
  .fc-profile-card__body h3 { margin: 0.7rem 0 0; color: var(--fc-ink); font: 600 1.22rem/1.3 var(--font-display); }
  .fc-profile-card__body p { margin: 0.45rem 0 0; color: var(--fc-text); font-size: 0.84rem; line-height: 1.55; }
  .fc-profile-card__body .fc-profile-work { color: var(--fc-muted); }
  .fc-profile-card__coverage { display: grid; grid-template-columns: 1fr auto; gap: 0.35rem 0.65rem; margin-top: 0.9rem; padding-top: 0.75rem; border-top: 1px solid var(--fc-line); color: var(--fc-muted); font: 500 0.75rem/1.4 var(--font-ui); }
  .fc-profile-card__coverage strong { color: var(--fc-ink); font-weight: 600; text-align: right; }
  .fc-profile-correction { display: inline-block; margin-top: 0.9rem; color: var(--fc-ink); font: 600 0.78rem/1.4 var(--font-ui); text-underline-offset: 0.18em; }
  .fc-coverage { display: grid; grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.8fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; margin-top: clamp(4rem, 8vw, 6.5rem); padding-block: clamp(2rem, 4vw, 3rem); border-block: 1px solid var(--fc-line); }
  .fc-coverage p:not(.fc-kicker) { max-width: 60ch; margin-bottom: 0; color: var(--fc-text); line-height: 1.65; }
  .fc-coverage ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .fc-coverage li { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr) auto; align-items: center; gap: 0.55rem; padding: 0.7rem 0.8rem; border: 1px solid var(--fc-line); border-radius: var(--radius-xs); background: var(--fc-paper); color: var(--fc-ink); font: 600 0.83rem/1.4 var(--font-display); }
  .fc-coverage li > span { color: var(--fc-accent); font-size: 1.2rem; }
  .fc-coverage li small { color: var(--fc-muted); font: 500 0.75rem/1.3 var(--font-ui); text-align: right; }
  .fc-profile-standard { padding-top: clamp(3rem, 7vw, 5rem); }
  .fc-profile-standard ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.55rem 2rem; max-width: 68rem; margin: 1.3rem 0 1.5rem; padding-left: 1.2rem; color: var(--fc-text); line-height: 1.55; }
  .fc-profile-standard li::marker { color: var(--fc-accent); }
  .fc-profile-link { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--fc-ink); font: 600 0.84rem/1.4 var(--font-ui); }
  @media (max-width: 900px) { .fc-profile-cards { grid-template-columns: 1fr; } .fc-coverage { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .fc-profile-stats { grid-template-columns: 1fr; } .fc-profile-section-heading { align-items: flex-start; flex-direction: column; gap: 0.7rem; } .fc-profile-standard ul { grid-template-columns: 1fr; } .fc-coverage li { grid-template-columns: 1.5rem 1fr; } .fc-coverage li small { grid-column: 2; text-align: left; } }
</style>
