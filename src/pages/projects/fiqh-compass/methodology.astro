---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FiqhCompassNav from "../../../components/FiqhCompassNav.astro";
import { questions } from "../../../data/fiqh-compass";
import figureData from "../../../data/fiqh-compass-figures.json";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Projects", url: "/projects/" },
  { name: "Fiqh Compass", url: "/projects/fiqh-compass/" },
  { name: "Methodology", url: "/projects/fiqh-compass/methodology/" },
];

const researchSteps = [
  {
    number: "01",
    title: "Bound the question",
    detail: "State the legal issue, the facts that matter, and the limits of the comparison. A result about one case is not expanded into a general doctrine.",
  },
  {
    number: "02",
    title: "Locate and identify the source",
    detail: "Record the work, author attribution, edition or manuscript witness, catalog claims, and the locator system. A digital page label is not silently treated as a printed page.",
  },
  {
    number: "03",
    title: "Read the passage in context",
    detail: "Separate the author's own reasoning from quoted scripture or reports, named jurists, transmitted school positions, and an editor's explanation. Preserve qualifications and disagreement.",
  },
  {
    number: "04",
    title: "Review Arabic, translation, and rights",
    detail: "Keep the Arabic text and its English translation paired for review. Record uncertainty in wording, attribution, edition matching, or reuse rights instead of filling gaps by inference.",
  },
  {
    number: "05",
    title: "Keep evidence and answers distinct",
    detail: "A respondent's answer describes that respondent. A historical profile requires its own reviewed, issue-bounded evidence; the two are never treated as interchangeable.",
  },
];

const attributionLayers = [
  { label: "Author's statement", treatment: "Use only when the passage is the author's own position in the identified layer and context." },
  { label: "Quoted text or report", treatment: "Name the quoted source where known. A quotation is not automatically the author's view." },
  { label: "Reported jurist or school view", treatment: "Keep the reporting author's attribution visible and do not present it as an independent survey." },
  { label: "Editorial explanation", treatment: "Label it as editorial interpretation, keep it separate from the source wording, and preserve uncertainty." },
];

const placementCount = figureData.placements.length;
const figureCount = figureData.figures.length;

const currentStatus = [
  { label: "Questionnaire", value: `${questions.length} English draft statements across 12 provisional dimensions, eight on each; not a validated instrument.` },
  { label: "Historical issues", value: "20 research dossiers contain candidate readings; specialist approval is still outstanding." },
  { label: "Historical figures", value: `${figureCount} figures placed through ${placementCount} readings, each citing a passage in the Shamela corpus with its Arabic wording. The readings are machine-assisted and unreviewed; no school match is computed.` },
  { label: "Evidence shown in results", value: "Each figure comparison shows the passages behind it, with locators. No passage has yet passed the specialist review and rights gate kept for the reviewed evidence layer." },
  { label: "Arabic experience", value: "Not available yet. Draft strings exist privately; none has bilingual approval." },
];

---

<BaseLayout
  title="Methodology and safeguards | Fiqh Compass"
  description="How Fiqh Compass scopes legal questions, records source evidence, handles attribution and uncertainty, and limits its current results."
  canonical="/projects/fiqh-compass/methodology/"
  crumbs={crumbs}
>
  <div class="fiqh-compass fc-method-page">
    <FiqhCompassNav current="methodology" />

    <header class="fc-method-hero hc-container">
      <div class="fc-method-hero__copy">
        <p class="fc-kicker">Method and safeguards</p>
        <h1>Evidence first. Limits in view.</h1>
        <p class="fc-method-hero__lede">Fiqh Compass is a research prototype for describing answers to questions about legal reasoning. It does not decide which ruling is correct, identify a person's religious affiliation, or issue a fatwa.</p>
      </div>
      <aside class="fc-method-status" aria-label="Current project status">
        <span>Current stage</span>
        <strong>Research prototype</strong>
        <p>Questions, readings, and scoring remain under review. Historical comparisons are unavailable.</p>
      </aside>
    </header>

    <section class="fc-method-section hc-container" aria-labelledby="process-title">
      <header class="fc-method-heading">
        <p class="fc-kicker">Research sequence</p>
        <h2 id="process-title">From a bounded question to a reviewable record</h2>
      </header>
      <ol class="fc-method-steps">
        {researchSteps.map((step) => (
          <li>
            <span class="fc-method-step__number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="fc-method-section fc-method-section--ruled hc-container" aria-labelledby="layers-title">
      <header class="fc-method-heading">
        <p class="fc-kicker">Attribution rules</p>
        <h2 id="layers-title">A passage can contain more than one voice</h2>
      </header>
      <p class="fc-method-intro">Before a passage supports a claim, its speaker and function must be identified. These labels are not interchangeable.</p>
      <dl class="fc-attribution-list">
        {attributionLayers.map((layer) => (
          <div>
            <dt>{layer.label}</dt>
            <dd>{layer.treatment}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="fc-method-section hc-container" aria-labelledby="results-title">
      <header class="fc-method-heading">
        <p class="fc-kicker">Respondent results</p>
        <h2 id="results-title">An answer summary is not a historical score</h2>
      </header>
      <div class="fc-method-prose">
        <p>The prototype groups {questions.length} draft statements under 12 provisional dimensions. Its provisional coordinates summarize the answers given to those statements. “I am not sure,” “Not applicable,” and skipped items do not contribute to a coordinate; the result shows how many answers were included.</p>
        <p>The result then compares those coordinates with historical figures on the dimensions both share. A figure is placed on a dimension only where a cited passage states a view, from the figure's own work, a named reporter, or an editor's introduction, and that passage is shown with the comparison. Similarity is 100 minus the average distance on the shared dimensions; a leave-one-out check reports how often the closest figure stays closest.</p>
        <p>None of this is a probability, a measure of correctness, a religious identity label, or a school match. The item set and scoring rule have not been validated with readers or specialists, and the placements have not been reviewed by one.</p>
      </div>
      <nav class="fc-method-links" aria-label="Explore the current research records">
        <a href="/projects/fiqh-compass/issues/">Read the issue register <span aria-hidden="true">→</span></a>
        <a href="/projects/fiqh-compass/profiles/">Review profile coverage <span aria-hidden="true">→</span></a>
      </nav>
    </section>

    <section class="fc-method-section fc-method-section--ruled hc-container" aria-labelledby="status-title">
      <header class="fc-method-heading">
        <p class="fc-kicker">What is available now</p>
        <h2 id="status-title">Current review status</h2>
      </header>
      <dl class="fc-method-register">
        {currentStatus.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="fc-method-section fc-method-privacy hc-container" aria-labelledby="privacy-title">
      <div class="fc-method-privacy__copy">
        <p class="fc-kicker">Privacy and corrections</p>
        <h2 id="privacy-title">Your answers stay in your browser</h2>
        <p>The quiz stores answers in this browser for local resume and results. The tested quiz flow does not send answers to HadithCritic. Resetting the quiz removes its saved answers from this browser.</p>
        <p>The correction form is separate and uses Web3Forms, a third-party service. Its account retention settings have not been independently verified. Do not submit information you consider sensitive.</p>
      </div>
      <div class="fc-method-privacy__links">
        <a href="/projects/fiqh-compass/quiz/">Open the quiz <span aria-hidden="true">→</span></a>
        <a href="/projects/fiqh-compass/corrections/">Send a source-based correction <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .fc-method-page { --fc-bg: var(--hc-surface-0); --fc-ink: var(--hc-text-primary); --fc-text: var(--hc-text-secondary); --fc-muted: var(--hc-text-tertiary); --fc-line: var(--hc-rule-soft); --fc-accent: var(--hc-gold); color: var(--fc-ink); background: var(--fc-bg); padding-bottom: clamp(4rem, 8vw, 7rem); }
  .fc-method-hero { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 0.65fr); align-items: end; gap: clamp(2rem, 7vw, 6rem); padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.5rem, 5vw, 4rem); }
  .fc-method-hero__copy { max-width: 65ch; }
  .fc-kicker { margin: 0 0 0.7rem; color: var(--fc-accent); font: 600 0.78rem/1.4 var(--font-ui); letter-spacing: 0.11em; text-transform: uppercase; }
  .fc-method-hero h1 { max-width: 13ch; margin: 0; font: 600 clamp(2.7rem, 6vw, 5rem)/1.07 var(--font-editorial); letter-spacing: -0.01em; text-wrap: balance; }
  .fc-method-hero__lede { max-width: 62ch; margin: 1.3rem 0 0; color: var(--fc-text); font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 1.7; }
  .fc-method-status { padding: 1.1rem 0 0.4rem; border-top: 1px solid var(--hc-rule-strong); }
  .fc-method-status span { color: var(--fc-accent); font: 600 0.75rem/1.4 var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; }
  .fc-method-status strong { display: block; margin-top: 0.45rem; font: 500 1.25rem/1.35 var(--font-critical); }
  .fc-method-status p { margin: 0.45rem 0 0; color: var(--fc-text); font-size: 0.95rem; line-height: 1.6; }
  .fc-method-section { padding-block: clamp(2.7rem, 6vw, 4.8rem); }
  .fc-method-section--ruled { border-top: 1px solid var(--fc-line); }
  .fc-method-heading { display: grid; grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 1.25fr); align-items: start; gap: clamp(1.5rem, 4vw, 4rem); margin-bottom: 1.7rem; }
  .fc-method-heading .fc-kicker { margin: 0; }
  .fc-method-heading h2, .fc-method-privacy h2 { max-width: 26ch; margin: 0; font: 600 clamp(1.8rem, 3.5vw, 2.7rem)/1.08 var(--font-editorial); letter-spacing: -0.01em; text-wrap: balance; }
  .fc-method-steps { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--fc-line); }
  .fc-method-steps li { display: grid; grid-template-columns: 3rem minmax(12rem, 0.72fr) minmax(0, 1.28fr); align-items: baseline; gap: 1rem 1.25rem; padding: 1.1rem 0; border-bottom: 1px solid var(--fc-line); }
  .fc-method-step__number { color: var(--fc-accent); font: 600 0.78rem/1.4 var(--font-ui); font-variant-numeric: tabular-nums; }
  .fc-method-steps h3 { margin: 0; font: 600 1rem/1.45 var(--font-critical); }
  .fc-method-steps p { max-width: 67ch; margin: 0; color: var(--fc-text); font-size: 0.94rem; line-height: 1.65; }
  .fc-method-intro { max-width: 68ch; margin: -0.4rem 0 1.5rem; color: var(--fc-text); line-height: 1.65; }
  .fc-attribution-list, .fc-method-register { margin: 0; border-top: 1px solid var(--fc-line); }
  .fc-attribution-list > div, .fc-method-register > div { display: grid; grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr); gap: 1rem 2rem; padding: 1rem 0; border-bottom: 1px solid var(--fc-line); }
  .fc-attribution-list dt, .fc-method-register dt { font: 600 0.98rem/1.5 var(--font-critical); }
  .fc-attribution-list dd, .fc-method-register dd { max-width: 70ch; margin: 0; color: var(--fc-text); line-height: 1.65; }
  .fc-method-prose { max-width: 70ch; color: var(--fc-text); line-height: 1.75; }
  .fc-method-prose p { margin: 0 0 1rem; }
  .fc-method-links, .fc-method-privacy__links { display: flex; flex-wrap: wrap; gap: 0.8rem 2rem; margin-top: 1.7rem; padding-top: 1rem; border-top: 1px solid var(--fc-line); }
  .fc-method-links a, .fc-method-privacy__links a { min-height: 44px; display: inline-flex; align-items: center; gap: 0.55rem; color: var(--fc-accent); font: 600 0.83rem/1.45 var(--font-ui); text-decoration: none; }
  .fc-method-links a:hover, .fc-method-privacy__links a:hover { color: var(--hc-gold-bright); }
  .fc-method-privacy { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 0.8fr); gap: clamp(2rem, 6vw, 5rem); border-top: 1px solid var(--fc-line); }
  .fc-method-privacy__copy { max-width: 68ch; }
  .fc-method-privacy__copy > p:not(.fc-kicker) { color: var(--fc-text); line-height: 1.7; }
  .fc-method-privacy h2 { margin-bottom: 1rem; }
  .fc-method-privacy__links { align-self: end; flex-direction: column; gap: 0.35rem; margin: 0; }
  @media (max-width: 780px) {
    .fc-method-hero, .fc-method-privacy { grid-template-columns: minmax(0, 1fr); }
    .fc-method-heading { grid-template-columns: minmax(0, 1fr); gap: 0.7rem; }
    .fc-method-steps li { grid-template-columns: 2.5rem minmax(0, 1fr); gap: 0.4rem 1rem; }
    .fc-method-steps p { grid-column: 2; }
  }
  @media (max-width: 640px) {
    .fc-attribution-list > div, .fc-method-register > div { grid-template-columns: minmax(0, 1fr); gap: 0.35rem; }
    .fc-method-links, .fc-method-privacy__links { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
  }
</style>
