---
import BaseLayout from "../../../../../../layouts/BaseLayout.astro";
import { OG } from '../../../../../../lib/seo';
import SuraTafsir from "../../../../../../components/tafsir/SuraTafsir.astro";
import names from "../../../../../../data/quran-sura-names.json";
import { versePartsOf } from "../../../../../../lib/tafsir-core";

/* The second part onward of a long sura. Suras that fit on one page have none. */
export function getStaticPaths() {
  return names.flatMap((sura) =>
    versePartsOf(sura.verses)
      .filter((part) => part.index > 1)
      .map((part) => ({ params: { n: String(sura.n), p: String(part.index) } })),
  );
}

const { n, p } = Astro.params;
const name = names[Number(n) - 1];
const part = versePartsOf(name.verses)[Number(p) - 1];
---

<BaseLayout image={OG.tafsir}
  title={`${name.latin}, Sura ${name.n}, verses ${part.first} to ${part.last} | Tafsir reader | HadithCritic Projects`}
  description={`The early commentaries, Mujāhid to al-Ṭabarī, on ${name.latin}, Sura ${name.n}, verses ${part.first} to ${part.last}, each passage cited to its printed edition.`}
>
  <SuraTafsir name={name} part={part} />
</BaseLayout>
