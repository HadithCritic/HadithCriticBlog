---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { OG } from '../../../../../lib/seo';
import SuraTafsir from "../../../../../components/tafsir/SuraTafsir.astro";
import names from "../../../../../data/quran-sura-names.json";
import { versePartsOf } from "../../../../../lib/tafsir-core";

/* One page per sura, all 114. A long sura opens on its first part; the rest live under /part/. */
export function getStaticPaths() {
  return Array.from({ length: 114 }, (_, i) => ({ params: { n: String(i + 1) } }));
}

const name = names[Number(Astro.params.n) - 1];
const part = versePartsOf(name.verses)[0];
---

<BaseLayout image={OG.tafsir}
  title={`${name.latin}, Sura ${name.n} | Tafsir reader | HadithCritic Projects`}
  description={`The early commentaries, Mujāhid to al-Ṭabarī, on ${name.latin}, Sura ${name.n}, verse by verse, each passage cited to its printed edition.`}
>
  <SuraTafsir name={name} part={part} />
</BaseLayout>
