---
/* Only the approved al-Fātiḥa release is emitted by this route. */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { OG } from '../../../../../lib/seo';
import { pageCount, surahs, verseHref, works } from '../../../../../data/tafsir';
import { pad } from '../../../../../lib/tafsir-render';
import '../../../../../styles/tafsir.css';

export function getStaticPaths() {
  return works
    .filter((work) => work.id === 'tabari')
    .flatMap((work) => surahs
      .filter((surah) => surah.n === 1 && work.imported.has(1))
      .flatMap((surah) => Array.from({ length: Math.min(pageCount(work, surah.n), 7) }, (_, i) => ({
        params: { work: work.id, surah: '1', verse: String(i + 1) },
        props: { workId: work.id, verse: i + 1 },
      }))));
}

const { workId, verse } = Astro.props as { workId: string; verse: number };
const work = works.find((item) => item.id === workId)!;
const surah = surahs.find((item) => item.n === 1)!;
const pageHtml = readFileSync(
  resolve(process.cwd(), 'src/data/tafsir-pages/tabari/001', `${pad(verse, 3)}.html`),
  'utf8',
);
const title = `${surah.latin} ${pad(1)}:${pad(verse)} · ${work.name} | Tafsīr`;
const description = `Al-Ṭabarī's commentary on Qur'an 1:${verse}, with the Arabic verse, English translation, transmitted reports and editor's notes.`;
---

<BaseLayout
  title={title}
  description={description}
  image={OG.tafsir}
  standalone={verse === 1}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Projects', url: '/projects/' },
    { name: 'Tafsīr', url: '/projects/tafsir/' },
    { name: 'al-Fātiḥa', url: verseHref(work, 1, 1) },
    { name: `${pad(1)}:${pad(verse)}`, url: verseHref(work, 1, verse) },
  ]}
>
  <Fragment set:html={pageHtml} />
  <script>
    import { initReader } from '../../../../../lib/tafsir-reader';
    initReader();
  </script>
</BaseLayout>
