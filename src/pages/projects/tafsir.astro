---
import BaseLayout from "../../layouts/BaseLayout.astro";
import names from "../../data/quran-sura-names.json";

const ordinal = (n: number) => String(n).padStart(3, "0");
---

<BaseLayout
  title="Tafsir reader | HadithCritic Projects"
  description="A verse-first reader framework for the Qur’an, under structural revision."
>
  <main class="reader-home">
    <header class="hc-masthead" aria-labelledby="reader-title">
      <div class="hc-container hc-masthead__inner">
        <div>
          <nav class="hc-eyebrow" aria-label="Breadcrumb">
            <a href="/">Home</a> / <a href="/projects/">Projects</a> / <span aria-current="page">Tafsir</span>
          </nav>
          <h1 id="reader-title" class="hc-masthead__title">Tafsir reader</h1>
          <p class="hc-masthead__lead">
            The reader is being reshaped around the verse as its stable unit. The text and page structure are available to refine; commentary content is not currently displayed.
          </p>
          <div class="hc-masthead__actions">
            <a class="hc-btn" href="#suras">Choose a sura</a>
          </div>
        </div>
        <aside class="reader-home__note" aria-label="Reader structure">
          <span class="reader-home__eyebrow">Reader structure</span>
          <p>One verse anchor</p>
          <span aria-hidden="true">↓</span>
          <p>One space for its text and future reading layers</p>
        </aside>
      </div>
    </header>

    <section class="hc-container reader-home__suras" id="suras" aria-labelledby="suras-title">
      <header class="reader-home__section-head">
        <div>
          <p class="reader-home__eyebrow">Browse</p>
          <h2 id="suras-title">Choose a sura</h2>
        </div>
        <span>114 suras</span>
      </header>
      <ol class="reader-home__grid">
        {names.map((sura) => (
          <li>
            <a href={`/projects/tafsir/sura/${sura.n}/`}>
              <span class="reader-home__number">{ordinal(sura.n)}</span>
              <span class="reader-home__name">
                <span class="reader-home__latin">{sura.latin}</span>
                <span class="reader-home__arabic hc-quran" lang="ar" dir="rtl">{sura.ar}</span>
              </span>
              <span class="reader-home__verses">{sura.verses} verses</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>

<style>
  .reader-home__note {
    align-self: center;
    display: grid;
    justify-items: start;
    gap: 0.8rem;
    max-width: 22rem;
    padding: 1.5rem;
    border-inline-start: 2px solid var(--hc-gold);
    background: var(--hc-surface-1);
  }
  .reader-home__eyebrow {
    margin: 0;
    color: var(--hc-gold);
    font: 700 0.75rem/1.4 var(--font-ui);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .reader-home__note p { margin: 0; color: var(--hc-text-primary); font: 500 1rem/1.5 var(--font-body); }
  .reader-home__note > span[aria-hidden] { color: var(--hc-text-tertiary); }
  .reader-home__suras { padding-block: clamp(2.5rem, 6vw, 5rem); }
  .reader-home__section-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--hc-rule); }
  .reader-home__section-head h2 { margin: 0.3rem 0 0; color: var(--hc-text-primary); font: 500 clamp(1.4rem, 3vw, 2rem)/1.2 var(--font-display); }
  .reader-home__section-head > span { color: var(--hc-text-secondary); font: 500 0.8rem/1.5 var(--font-ui); }
  .reader-home__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hc-rule-soft); }
  .reader-home__grid li { min-width: 0; border-bottom: 1px solid var(--hc-rule-soft); }
  .reader-home__grid a { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) auto; align-items: center; gap: 0.8rem; min-height: 4.5rem; padding: 0.7rem 0.65rem; color: var(--hc-text-primary); text-decoration: none; transition: background var(--motion-fast) var(--ease-standard); }
  .reader-home__grid a:hover, .reader-home__grid a:focus-visible { background: var(--hc-surface-1); }
  .reader-home__number { color: var(--hc-gold); font: 600 0.8rem/1 var(--font-ui); font-variant-numeric: tabular-nums; }
  .reader-home__name { display: flex; min-width: 0; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; }
  .reader-home__latin { font: 500 0.9rem/1.4 var(--font-body); }
  .reader-home__arabic { color: var(--hc-text-secondary); font-size: 1.05rem; }
  .reader-home__verses { color: var(--hc-text-tertiary); font: 400 0.75rem/1.4 var(--font-ui); white-space: nowrap; }
  @media (max-width: 760px) {
    .reader-home__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reader-home__grid a { grid-template-columns: 2.2rem minmax(0, 1fr); gap: 0.55rem; }
    .reader-home__verses { grid-column: 2; }
  }
  @media (max-width: 480px) { .reader-home__grid { grid-template-columns: 1fr; } }
</style>
