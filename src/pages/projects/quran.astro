---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { OG } from '../../lib/seo';
import ResearchHero from "../../components/ResearchHero.astro";
import names from "../../data/quran-sura-names.json";
import index from "../../data/qiraat/index.json";
import silent from "../../data/qiraat/silent-suras.json";
import vanPutten from "../../data/qiraat/van-putten-taysir.json";
import authorities from "../../data/qiraat/sura-001.json";
import QiraatReaderCard from "../../components/qiraat/QiraatReaderCard.astro";
import "../../styles/qiraat.css";
import "../../styles/qiraat-ui.css";
import QiraatSectionHeader from "../../components/qiraat/QiraatSectionHeader.astro";
import QiraatDefinitionList from "../../components/qiraat/QiraatDefinitionList.astro";
import QiraatBadge from "../../components/qiraat/QiraatBadge.astro";

/* The hub for the qirāʾāt module: every sura, what has been extracted, and how to read the colors. */
const bySura = new Map(index.suras.map((entry) => [entry.sura, entry]));
const silentOf = new Map(Object.entries(silent.suras).map(([n, entry]) => [Number(n), entry]));
/* al-Danis words on a silent sura, in van Putten's translation, shown before the Arabic quotations. */
type VpEntry = { sura: number | null; section: string; pretzl_pages: number[]; text: string };
const vpSilent = new Map<number, VpEntry[]>();
for (const st of vanPutten.statements as VpEntry[]) {
  if (st.section === "farsh" && st.sura !== null && silentOf.has(st.sura)) vpSilent.set(st.sura, [...(vpSilent.get(st.sura) ?? []), st]);
}
const SILENT_META: Record<string, string> = { none: "No difference stated", rule: "Only a general rule", report: "Only an outside report" };
const rulesCount = index.rules?.rules ?? 0;
const sevenIds = ["nafi", "ibn_kathir", "abu_amr", "ibn_amir", "asim", "hamza", "kisai"];
const additionalIds = ["abu_jafar", "yaqub", "khalaf_ashir"];
const qariOf = new Map(authorities.qaris.map((qari) => [qari.id, qari]));
const seven = sevenIds.map((id) => qariOf.get(id)!);
const additional = additionalIds.map((id) => qariOf.get(id)!);
const regionOf: Record<string, { key: string; label: string }> = {
  nafi: { key: "medina", label: "Medina" },
  ibn_kathir: { key: "mecca", label: "Mecca" },
  abu_amr: { key: "basra", label: "Basra" },
  ibn_amir: { key: "syria", label: "Syria" },
  asim: { key: "kufa", label: "Kufa" },
  hamza: { key: "kufa", label: "Kufa" },
  kisai: { key: "kufa", label: "Kufa" },
  abu_jafar: { key: "medina", label: "Medina" },
  yaqub: { key: "basra", label: "Basra" },
  khalaf_ashir: { key: "kufa", label: "Kufa" },
};
const readers = [
  ...seven.map((reader) => ({ reader, additional: false, region: regionOf[reader.id] })),
  ...additional.map((reader) => ({ reader, additional: true, region: regionOf[reader.id] })),
];

const totalVerses = names.reduce((sum, sura) => sum + sura.verses, 0);
---

<BaseLayout image={OG.quran}
  title="The Qirāʾāt Variants | HadithCritic Projects"
  description="The ten qirāʾāt set side by side, word by word, sura by sura, with the classical books that report each reading."
>
  <div class="qh q-ui rp-page rp-qiraat">
    <ResearchHero artwork="qiraat" variant="readings" title="The Qirāʾāt Variants" titleId="qh-title" kicker="A comparative reading register" arabic="القراءات">
      <p>The ten qirāʾāt, set side by side word by word, with the classical books that report each reading.
            Every reading is a proposal that no reviewer has checked yet, and every quotation is checked against its page.</p>
      <div slot="actions"><nav class="q-nav" aria-label="Qur’an project sections">
            <a href="#readers">Readers <span>10</span></a>
            <a href="#suras">Sura register <span>114</span></a>
            <a href="/projects/quran/rules/">General rules <span>{rulesCount}</span></a>
            <a href="/projects/quran/transmission/">Transmission</a>
          </nav></div>
      <figure slot="signature" class="rp-readers">
        <figcaption class="rp-sig__caption">The ten readers, each with his own hue</figcaption>
        <ol class="rp-readers__list">
          {readers.map(({ reader, additional }) => (
            <li class:list={[`q-${reader.id}`, { "is-added": additional }]}>
              <span class="sw" aria-hidden="true"></span>
              <span class="rp-readers__name">{reader.display}</span>
              <span class="rp-readers__ar" lang="ar" dir="rtl">{reader.name_ar}</span>
            </li>
          ))}
        </ol>
      </figure>
      <div slot="stats" class="rp-figures" aria-label="Coverage at a glance">
        <p><span class="hc-project-hero__figure">{index.suras_with_data}</span> of 114 suras with readings</p>
        <p><span>{rulesCount}</span> general rules</p>
        <p><span>10</span> readers and their <span>{authorities.riwayat.length}</span> transmitters</p>
      </div>
    </ResearchHero>

    <div class="hc-container qh-body">
      <section class="sec" id="readers" aria-labelledby="readers-h">
        <QiraatSectionHeader id="readers-h">
          <Fragment slot="title">The ten readers</Fragment>
          <Fragment slot="count">10</Fragment>
        </QiraatSectionHeader>
        <p class="lede">The seven readers associated with Ibn Mujāhid’s list appear first. Ibn al-Jazarī’s ten-reading list adds three more. The distinction marks the history of the lists, not a ranking of readings. <a class="hc-ulink" href="https://en.wikipedia.org/wiki/Qira%27at#The_seven_canonical_qira%27at">Source for the grouping <span aria-hidden="true">↗</span></a></p>
        <ol class="roster" aria-label="The seven primary and three additional qirāʾāt readers">
          {readers.map(({ reader, additional, region }, i) => (
            <li><QiraatReaderCard reader={reader} rank={i + 1} additional={additional} region={region} /></li>
          ))}
        </ol>
      </section>

      <section class="sec" id="suras" aria-labelledby="suras-h">
        <QiraatSectionHeader id="suras-h">
          <Fragment slot="title">The suras</Fragment>
          <Fragment slot="count">114</Fragment>
        </QiraatSectionHeader>
        <p class="lede">A sura opens once the books have been read for it. The number under each name is how many words in it have a difference among the ten readers.</p>
        <ol class="grid">
          {names.map((sura) => {
            const entry = bySura.get(sura.n);
            return (
              <li class:list={["cell", { "cell--off": !entry }]}>
                {entry ? (
                  <a href={`/projects/quran/sura/${sura.n}/`}>
                    <span class="cell__n">{sura.n}</span>
                    <span class="cell__ar hc-quran" lang="ar">{sura.ar}</span>
                    <span class="cell__latin">{sura.latin}</span>
                    <span class="cell__meta"><b>{entry.positions}</b> {entry.positions === 1 ? "position" : "positions"}</span>
                  </a>
                ) : (
                  <div>
                    <span class="cell__n">{sura.n}</span>
                    <span class="cell__ar hc-quran" lang="ar">{sura.ar}</span>
                    <span class="cell__latin">{sura.latin}</span>
                    <span class="cell__meta">{silentOf.has(sura.n) ? <a href="#silent" class="cell__why">{SILENT_META[silentOf.get(sura.n)!.status]}</a> : "Not extracted yet"}</span>
                  </div>
                )}
              </li>
            );
          })}
        </ol>
      </section>

      <section class="sec" id="silent" aria-labelledby="silent-h">
        <QiraatSectionHeader id="silent-h">
          <Fragment slot="title">Suras with no word-level position</Fragment>
          <Fragment slot="count">{silentOf.size}</Fragment>
        </QiraatSectionHeader>
        <p class="lede">
          These suras have no page because the books give them none, not because they have not been read. Taḥbīr prints a heading only for a sura it has something to say about,
          and Ibn Mujāhid often writes that there is no difference in a sura. Each statement below is quoted from the page named.
        </p>
        <ul class="silent">
          {[...silentOf.entries()].map(([n, entry]) => {
            const sura = names.find((s) => s.n === n)!;
            return (
              <li>
                <details>
                  <summary>
                    <b class="silent__n">{n}</b> <span lang="ar" class="hc-quran silent__ar">{sura.ar}</span> {sura.latin}
                    <QiraatBadge class="silent__tag">{SILENT_META[entry.status]}</QiraatBadge>
                  </summary>
                  <p class="silent__say">{entry.summary}</p>
                  {(vpSilent.get(n) ?? []).map((st) => (
                    <p class="silent__en">
                      al-Dānī, in van Putten’s translation: “{st.text}” <span class="silent__ref">at-Taysīr, ed. Pretzl, p. {st.pretzl_pages.join("–")}; CC BY-NC 4.0.</span>
                    </p>
                  ))}
                  <ul class="silent__quotes">
                    {entry.quotes.map((quote) => (
                      <li>
                        <p class="silent__ref">{quote.book}, {quote.page}</p>
                        <blockquote lang="ar" class="silent__ar-quote">{quote.quote}</blockquote>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            );
          })}
        </ul>
      </section>

      <section class="sec" id="status" aria-labelledby="status-h">
        <QiraatSectionHeader id="status-h">
          <Fragment slot="title">How it is made, and what is checked</Fragment>
        </QiraatSectionHeader>
        <QiraatDefinitionList>
          <div><dt>Source</dt><dd>Ibn al-Jazarī’s <i>Taḥbīr at-Taysīr</i> states the readings of all ten readers word by word, sura by sura. Other classical books are added as second witnesses.</dd></div>
          <div><dt>What the machine checks</dt><dd>That each quoted passage is on the cited page, that every reader named is in the passage, and that the word matches a word of the Cairo text. Nothing is corrected.</dd></div>
          <div><dt>What nobody has checked</dt><dd>Whether a reader was assigned to the right reading. That takes a person reading the passage, and it has not happened yet.</dd></div>
          <div><dt>Labels</dt><dd>The short English labels and the grouping are ours. The Arabic beside them is the book’s. Nothing here grades a reading.</dd></div>
        </QiraatDefinitionList>
        <p class="attribution">
          Verse text: Corpus Coranicum, Cairo 1924 edition, TEI export pinned to commit <code>57cb2b7be321</code>, CC BY-SA 4.0. The Qur’an has {totalVerses.toLocaleString("en-US")} verses in 114 suras.
          Quoted readings come from editions in the Maktaba Shamela, cited by page.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
