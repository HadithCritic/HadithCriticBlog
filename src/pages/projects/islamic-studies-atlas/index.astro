---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { OG } from '../../../lib/seo';
import ResearchHero from "../../../components/ResearchHero.astro";
import '../../../styles/atlas-explorer.css';
import { graph, authorLine, venueLine, THEME_ORDER } from '../../../lib/research-graph';

const { data, workById, cites, citedBy, partOf, parts, partPage } = graph;

const themeCounts = THEME_ORDER.map((name) => ({ name, count: data.works.filter((w) => w.themes.includes(name)).length })).filter((t) => t.count > 0);

const listed = [...data.works].sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || a.title.localeCompare(b.title));

const decades = new Map<number, number>();
for (const w of data.works) if (w.year) decades.set(Math.floor(w.year / 10) * 10, (decades.get(Math.floor(w.year / 10) * 10) ?? 0) + 1);
const decadeRows = [...decades.entries()].sort((a, b) => a[0] - b[0]);
const decadeMax = Math.max(...decades.values());

const leadScholars = data.scholars.filter((s) => s.works.length > 0);
const plain = (id: string) => workById.get(id)!.title;

/* Citation explorer metadata, keyed by work id. */
const atlas = Object.fromEntries(
  data.works.map((w) => [
    w.id,
    {
      t: w.title,
      a: authorLine(w),
      y: w.year ?? null,
      v: venueLine(w),
      d: w.doi ?? null,
      c: cites.get(w.id) ?? [],
      b: citedBy.get(w.id) ?? [],
      p: partOf.get(w.id) ?? null,
      k: parts.get(w.id) ?? [],
      s: w.site ?? [],
      themes: w.themes,
      page: partPage.get(w.id) ?? null
    }
  ])
);
const atlasJson = JSON.stringify(atlas).replace(/</g, '\\u003c');

---

<BaseLayout image={OG.atlas}
  title="Islamic Studies Atlas | HadithCritic Research"
  description="A map of modern scholarship on hadith criticism: who wrote what, when, and which works cite which."
>
  <div class="atlas-page rp-page rp-atlas">
    <ResearchHero artwork="atlas" variant="atlas" title="Islamic Studies Atlas" titleId="atlas-title" kicker="Research atlas" arabic="الدراسات الإسلامية">
      <p>Modern scholarship on ḥadīth criticism, with the citations between works. Search the collection and explore one work’s citations at a time.</p>
      <div slot="actions">
            <a href="#works" class="hc-btn" data-explorer-start>Explore citations</a>
            <a href="#works" class="hc-back-link hc-back-link--ruled">Browse all works <span aria-hidden="true">→</span></a>
          </div>
      <figure slot="signature" class="rp-decades atlas-hero__decades">
        <figcaption class="rp-sig__caption">Works in the collection, by decade of publication</figcaption>
        <ol class="decades">
          {decadeRows.map(([decade, n]) => (
            <li>
              <span class="decades__label">{decade}s</span>
              <span class="decades__bar hc-hatch" style={`--w:${(n / decadeMax) * 100}%`} aria-hidden="true"></span>
              <span class="decades__n">{n}</span>
            </li>
          ))}
        </ol>
      </figure>
      <div slot="stats" class="rp-figures" aria-label="The atlas at a glance">
        <p><span class="hc-project-hero__figure">{data.works.length}</span> works</p>
        <p><span>{data.scholars.length}</span> scholars</p>
        <p><span>{data.edges.filter((edge) => edge.type === "cites").length.toLocaleString()}</span> citations traced between works</p>
      </div>
    </ResearchHero>

    <section id="map" class="map hc-container" aria-labelledby="map-title" data-explorer hidden>
      <header class="sec__head">
        <h2 id="map-title" class="sec__title">Explore the collection</h2>
        <span class="sec__rule" aria-hidden="true"></span>
      </header>
      <p class="map__lead">Find a work by title, author or topic. Then follow its citations, one work at a time. Connections are limited to this collection.</p>
      <div class="dock" role="search">
        <label class="dock__field">
          <span class="sr-only">Search the atlas</span>
          <input id="atlas-query" class="dock__input" type="search" placeholder="Search title, author or venue" autocomplete="off" />
          <kbd class="dock__kbd" aria-hidden="true">/</kbd>
        </label>
        <label class="dock__select">Topic
          <select id="atlas-theme">
            <option value="">All topics</option>
            {themeCounts.map(theme => <option value={theme.name}>{theme.name} ({theme.count})</option>)}
          </select>
        </label>
        <label class="dock__select">Order
          <select id="atlas-sort">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="title">Title A-Z</option>
          </select>
        </label>
      </div>
      <div class="explorer">
        <div class="catalogue">
          <p id="atlas-count" class="catalogue__count" aria-live="polite"></p>
          <ol class="catalogue__list" data-catalogue aria-label="Works in the collection"></ol>
          <button type="button" class="hc-btn hc-btn--ghost catalogue__more" data-more hidden>Show more works</button>
          <div id="atlas-empty" class="empty" hidden>
            <p>No works match these filters.</p>
            <button type="button" id="atlas-reset" class="hc-btn hc-btn--ghost">Clear search and filters</button>
          </div>
        </div>
        <div class="focus" data-focus>
          <div class="focus__empty" data-focus-empty>
            <h3>Choose a work to begin</h3>
            <p>Its title and bibliography stay in view while you explore the connections.</p>
            <div class="focus__guide">
              <div><h4>Cites</h4><p>Works named in the selected text.</p></div>
              <div><h4>Cited by</h4><p>Works that name the selected text.</p></div>
            </div>
            <p>You can also <a href="#works">browse the full bibliography</a>, including studies printed inside volumes.</p>
          </div>
          <div data-focus-body hidden></div>
        </div>
      </div>
    </section>
    <noscript><div class="hc-container"><p>The full bibliography below includes each work’s citation connections. Open “Cites / Cited by” to explore them.</p></div></noscript>

    <section id="works" class="works hc-container" aria-labelledby="works-title">
      <header class="sec__head">
        <h2 id="works-title" class="sec__title">Works</h2>
        <span class="sec__rule" aria-hidden="true"></span>
        <span class="sec__count">{data.works.length}</span>
      </header>
      <details class="bibliography" data-bibliography open>
        <summary>Full bibliography and source notes</summary>
      <ol class="list">
        {listed.map((w) => {
          const out = cites.get(w.id) ?? [];
          const inn = citedBy.get(w.id) ?? [];
          return (
            <li
              class="work"
              id={w.id}
              data-work
              data-themes={w.themes.join('|')}
              data-search={`${w.title} ${w.publishedTitle ?? ''} ${authorLine(w)} ${venueLine(w)} ${w.year ?? ''} ${partOf.has(w.id) ? plain(partOf.get(w.id)!) : ''}`}
            >
              <span class="work__year">{w.year ?? 'n.d.'}</span>
              <div class="work__main">
                <h3 class="work__title">
                  {w.doi ? (
                    <a href={`https://doi.org/${w.doi}`} target="_blank" rel="noopener noreferrer">{w.title}<span class="sr-only"> (opens in a new tab)</span></a>
                  ) : (
                    w.title
                  )}
                </h3>
                <p class="work__by">{authorLine(w)}{venueLine(w) ? ` · ${venueLine(w)}` : ''}</p>
                {partOf.has(w.id) && (
                  <p class="work__in">
                    Printed inside <a href={`#${partOf.get(w.id)}`}>{plain(partOf.get(w.id)!)}</a>
                    {partPage.has(w.id) ? `, beginning on page ${partPage.get(w.id)}` : ''}.
                  </p>
                )}
                <p class="work__meta">
                  {w.themes.join(' · ')}
                  {w.openAccess && <span class="work__oa"> · Open access</span>}
                </p>
                {w.methods && w.methods.length > 0 && <p class="work__meta work__meta--quiet">Method terms in the text: {w.methods.join(', ')}</p>}
                {w.publishedTitle && <p class="work__meta work__meta--quiet">Published title: {w.publishedTitle}</p>}
                {w.originalNote && <p class="work__meta work__meta--quiet">First edition: {w.originalNote}</p>}
                {w.revisedCopy && <p class="work__meta work__meta--quiet">The copy in the library is a later revision of this work.</p>}
                {w.unconfirmed && <p class="work__meta work__meta--quiet">Some bibliographic details are still to be confirmed.</p>}
                {w.site && w.site.length > 0 && (
                  <p class="work__site">
                    {w.site.map((link) => (
                      <a class="hc-back-link" href={link.slug ? `/blogs/${link.slug}/` : link.href}>{link.label} <span aria-hidden="true">→</span></a>
                    ))}
                  </p>
                )}
                {(parts.get(w.id)?.length ?? 0) > 0 && (
                  <details class="work__rel">
                    <summary>Prints {parts.get(w.id)!.length} studies, each listed as its own work</summary>
                    <ul>{parts.get(w.id)!.map((id) => <li><a href={`#${id}`}>{plain(id)}</a>{partPage.has(id) ? `, page ${partPage.get(id)}` : ''}</li>)}</ul>
                  </details>
                )}
                {(out.length > 0 || inn.length > 0) && (
                  <details class="work__rel">
                    <summary>Cites {out.length} · Cited by {inn.length} in this collection</summary>
                    {out.length > 0 && (
                      <>
                        <h4>Cites</h4>
                        <ul>{out.map((id) => <li><a href={`#${id}`}>{plain(id)}</a></li>)}</ul>
                      </>
                    )}
                    {inn.length > 0 && (
                      <>
                        <h4>Cited by</h4>
                        <ul>{inn.map((id) => <li><a href={`#${id}`}>{plain(id)}</a></li>)}</ul>
                      </>
                    )}
                  </details>
                )}
              </div>
              <button type="button" class="work__show" data-show={w.id} hidden>Explore citations</button>
            </li>
          );
        })}
      </ol>
      </details>
    </section>

    <section id="scholars" class="scholars hc-container" aria-labelledby="scholars-title">
      <header class="sec__head">
        <h2 id="scholars-title" class="sec__title">Scholars</h2>
        <span class="sec__rule" aria-hidden="true"></span>
        <span class="sec__count">{leadScholars.length}</span>
      </header>
      <ul class="people">
        {leadScholars.map((s) => (
          <li>
            <details class="person">
              <summary>
                <span class="person__name">{s.name}</span>
                <span class="person__meta">{s.works.length} {s.works.length === 1 ? 'work' : 'works'}{s.firstYear ? ` · ${s.firstYear === s.lastYear ? s.firstYear : `${s.firstYear}–${s.lastYear}`}` : ''}</span>
              </summary>
              <ul class="person__works">
                {s.works.map((id) => <li><a href={`#${id}`}>{plain(id)}</a></li>)}
              </ul>
            </details>
          </li>
        ))}
      </ul>
    </section>

    <section class="note hc-container" aria-labelledby="note-title">
      <div class="note__tray">
        <div class="note__well">
          <p class="hc-eyebrow">About this atlas</p>
          <h2 id="note-title" class="note__title">What it covers, and what it does not</h2>
          <ul class="note__list">
            <li><strong>Scope.</strong> It maps the {data.works.length} works in the HadithCritic research library, not the whole field. Coverage grows as works are added.</li>
            <li><strong>Studies inside books.</strong> Where a book prints several studies, each study is a work of its own and is marked as printed inside the book, with the page it begins on, so the original volume is one click away.</li>
            <li><strong>Relations.</strong> One work is linked to another when its text names the other's title beside the author's surname. Each link is traceable to the citing work's pages.</li>
            <li><strong>Bibliography.</strong> Titles, years and DOIs are checked against Crossref and each work's own title page. Anything not yet confirmed is marked.</li>
            <li><strong>No grades.</strong> The atlas does not rate works or scholars. Colors mark a main theme only.</li>
            <li><strong>Pending.</strong> A few scanned books are still awaiting OCR, and a feed of newly published work is planned.</li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <script is:inline type="application/json" id="atlas-data" set:html={atlasJson}></script>
</BaseLayout>

<script>
  import { initAtlasExplorer } from '../../../lib/atlas-explorer';
  initAtlasExplorer();
</script>

<style>
  .atlas-page { min-height: 100vh; background: var(--hc-surface-0); }
  .atlas-page [hidden] { display: none !important; }

  .decades { margin: 0; padding: 0; list-style: none; }
  .decades li { display: grid; grid-template-columns: 3.1rem minmax(0, 1fr) 1.4rem; align-items: center; gap: 0.55rem; padding: 0.18rem 0; }
  .decades__label, .decades__n { font: 500 0.78rem var(--font-ui); font-variant-numeric: tabular-nums; }
  .decades__label { color: var(--hc-text-secondary); }
  .decades__bar { display: block; width: var(--w); min-width: 4px; height: 7px; }
  .decades__n { color: var(--hc-text-primary); text-align: right; }

  /* Search controls */
  .dock { display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, auto) auto; gap: 0.75rem; align-items: end; margin-bottom: 1.5rem; }
  .dock__field { display: flex; align-items: center; gap: 0.6rem; min-height: 48px; padding: 0 0.8rem; border: 1px solid var(--hc-rule); border-radius: var(--radius-xs); background: var(--hc-surface-1); color: var(--hc-text-tertiary); }
  .dock__field:focus-within { border-color: var(--hc-gold); }
  .dock__input { --hc-focus-width: 0px; flex: 1; min-width: 0; width: 100%; border: 0; background: none; color: var(--hc-text-primary); font: 400 0.95rem var(--font-body); }
  .dock__input::placeholder { color: var(--hc-text-tertiary); }
  .dock__kbd { font: 700 0.8rem var(--font-ui); }
  .dock__select { display: grid; gap: 0.35rem; color: var(--hc-text-secondary); font: 700 0.75rem var(--font-ui); letter-spacing: 0.08em; text-transform: uppercase; }
  .dock__select select { width: 100%; max-width: 100%; min-height: 48px; padding: 0.6rem 2rem 0.6rem 0.75rem; border: 1px solid var(--hc-rule); border-radius: var(--radius-xs); color: var(--hc-text-primary); background: var(--hc-surface-1); font: 400 0.85rem var(--font-body); }

  /* Section heads */
  .map, .works, .scholars, .note { padding-top: clamp(2.5rem, 5vw, 4rem); scroll-margin-top: 8rem; }
  .sec__head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.1rem; }
  .sec__title { margin: 0; font-family: var(--font-editorial); font-size: clamp(2rem, 3vw, 2.6rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.005em; color: var(--hc-text-primary); }
  .sec__rule { flex: 1; height: 1px; background: linear-gradient(90deg, var(--hc-rule), transparent); }
  .sec__count { min-width: 1.9rem; padding: 0.1rem 0.5rem; border: 1px solid var(--hc-rule-soft); border-radius: var(--radius-pill, 999px); color: var(--hc-text-secondary); font: 500 0.85rem var(--font-ui); text-align: center; font-variant-numeric: tabular-nums; }

  /* Map */
  .map__lead { max-width: 68ch; margin: 0 0 1.5rem; color: var(--hc-text-secondary); line-height: 1.7; }
  .explorer { display: grid; grid-template-columns: minmax(17rem, 0.8fr) minmax(0, 1.8fr); align-items: start; gap: 2rem; }
  .catalogue { min-width: 0; }
  .catalogue__count { margin: 0 0 0.75rem; color: var(--hc-text-secondary); font: 400 0.85rem/1.5 var(--font-body); }
  .catalogue__list { max-height: 38rem; overflow-y: auto; overscroll-behavior: contain; margin: 0; padding: 0.2rem; list-style: none; border-top: 1px solid var(--hc-rule); }
  .catalogue__more { margin-top: 0.75rem; width: 100%; }
  .focus { min-width: 0; padding: 1.5rem; border: 1px solid var(--hc-rule); border-radius: var(--radius-xs); background: var(--hc-surface-1); }
  .focus__empty h3 { margin: 0; font: 500 1.5rem/1.4 var(--font-display); }
  .focus__empty p { color: var(--hc-text-secondary); font-size: 0.95rem; line-height: 1.7; }
  .focus__guide { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-block: 2rem; padding-top: 1rem; border-top: 1px solid var(--hc-rule); }
  .focus__guide h4 { margin: 0; color: var(--hc-gold); font: 700 0.8rem var(--font-ui); letter-spacing: 0.08em; text-transform: uppercase; }
  .focus__guide p { margin-bottom: 0; }
  .bibliography > summary { min-height: 48px; padding: 0.75rem 0; color: var(--hc-gold); cursor: pointer; font: 500 1rem/1.5 var(--font-body); }

  /* Works */
  .list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hc-rule-soft); }
  .work { display: grid; grid-template-columns: 4rem minmax(0, 1fr) auto; gap: 0.5rem 1.25rem; padding: 1.1rem 0.6rem 1.2rem 0; border-bottom: 1px solid var(--hc-rule-soft); scroll-margin-top: 9rem; transition: background 0.2s ease, box-shadow 0.2s ease; }
  .work:target { background: rgba(216, 177, 102, 0.08); box-shadow: inset 2px 0 0 var(--hc-gold-dim); }
  .work__year { padding-left: 0.6rem; color: var(--hc-gold-dim); font: 500 0.98rem var(--font-display); font-variant-numeric: lining-nums tabular-nums; }
  .work__main { min-width: 0; }
  .work__main > * { margin: 0; }
  .work__title { color: var(--hc-text-primary); font: 600 1.05rem/1.4 var(--font-display); letter-spacing: -0.015em; text-wrap: balance; }
  .work__title a { color: inherit; text-decoration: none; }
  .work__title a:hover { color: var(--hc-gold-bright); }
  .work__by { margin-top: 0.25rem !important; color: var(--hc-text-secondary); font-size: 0.92rem; line-height: 1.5; }
  .work__meta { margin-top: 0.45rem !important; color: var(--hc-gold-dim); font: 700 0.78rem/1.5 var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; }
  .work__meta--quiet { color: var(--hc-text-tertiary); font-weight: 500; letter-spacing: 0.02em; text-transform: none; font-size: 0.85rem; }
  .work__oa { color: var(--hc-text-secondary); }
  .work__in { margin-top: 0.35rem !important; color: var(--hc-text-secondary); font-size: 0.9rem; line-height: 1.5; }
  .work__in a { color: var(--hc-text-primary); }
  .work__site { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; margin-top: 0.5rem !important; }
  .work__rel { margin-top: 0.7rem; }
  .work__rel summary { display: inline-flex; min-height: 36px; align-items: center; color: var(--hc-text-secondary); font: 500 0.9rem var(--font-ui); cursor: pointer; }
  .work__rel h4 { margin: 0.7rem 0 0.25rem; color: var(--hc-text-tertiary); font: 700 0.75rem/1.3 var(--font-ui); letter-spacing: 0.12em; text-transform: uppercase; }
  .work__rel ul { margin: 0; padding-left: 1.1rem; color: var(--hc-text-secondary); font-size: 0.9rem; line-height: 1.6; }
  .work__rel a { color: var(--hc-text-primary); }
  .work__show { align-self: start; min-height: 36px; padding: 0 0.85rem; border: 1px solid var(--hc-rule-soft); border-radius: 2px; background: none; color: var(--hc-gold); font: 500 0.88rem var(--font-ui); cursor: pointer; }
  .work__show:hover { border-color: var(--hc-gold); }
  .empty { margin-top: 1.5rem; padding: 2.5rem 1.5rem; border: 1px dashed var(--hc-rule); border-radius: 2px; color: var(--hc-text-secondary); text-align: center; }
  .empty p { margin: 0 0 1rem; }

  /* Scholars */
  .people { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 0 clamp(1.5rem, 4vw, 3rem); margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hc-rule-soft); }
  .person { border-bottom: 1px solid var(--hc-rule-soft); }
  .person summary { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.2rem 1rem; min-height: 44px; padding: 0.7rem 0.4rem 0.7rem 0; cursor: pointer; }
  .person__name { color: var(--hc-text-primary); font: 600 1rem var(--font-display); letter-spacing: -0.015em; }
  .person__meta { color: var(--hc-text-tertiary); font: 500 0.86rem var(--font-ui); font-variant-numeric: tabular-nums; }
  .person__works { margin: 0 0 0.9rem; padding-left: 1.1rem; color: var(--hc-text-secondary); font-size: 0.9rem; line-height: 1.6; }
  .person__works a { color: var(--hc-text-primary); }

  /* Note */
  .note { padding-bottom: clamp(4rem, 8vw, 7rem); }
  .note__tray { padding: 6px; border: 1px solid var(--hc-rule); border-radius: 4px; background: var(--hc-surface-2); }
  .note__well { padding: clamp(1.4rem, 3vw, 2.2rem); border: 1px solid var(--hc-rule-soft); border-radius: 2px; background: var(--hc-surface-1); }
  .note__title { margin: 0.45rem 0 1rem; font-family: var(--font-display); font-size: clamp(1.3rem, 2.6vw, 1.6rem); font-weight: 600; line-height: 1.3; letter-spacing: -0.02em; color: var(--hc-text-primary); }
  .note__list { display: grid; gap: 0.7rem; max-width: 70ch; margin: 0; padding-left: 1.1rem; color: var(--hc-text-secondary); line-height: 1.65; }
  .note__list strong { color: var(--hc-text-primary); }

  @media (max-width: 900px) {
    .explorer { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .catalogue__list { max-height: 22rem; }
    .dock { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .dock__field { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .sec__rule { display: none; }
    .focus { padding: 1rem; }
    .focus__guide { grid-template-columns: 1fr; }
    .work { grid-template-columns: minmax(0, 1fr); }
    .work__year { padding-left: 0; }
    .work__show { justify-self: start; }
  }
  @media (max-width: 460px) {
    .glance { grid-template-columns: minmax(0, 1fr); row-gap: 1rem; }
    .glance__figure + .glance__figure { padding-top: 1rem; border-top: 1px dashed rgba(26, 23, 21, 0.4); border-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-page * { transition: none !important; }
  }
</style>
