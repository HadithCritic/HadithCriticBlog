---
/* One reading edition of an early history, inside the site's own header and
   footer. The book's text is a prebuilt fragment (src/data/history-readers),
   rendered as is; history-reader.css sets it and history-reader.js adds the
   contents sidebar, place marker, text size and note popovers. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { deathDate, openReaders, type HistorySource, type ReaderFacts } from '../../../data/history';
import '../../../styles/history-reader.css';

interface Props {
  source: HistorySource;
  reader: ReaderFacts;
  previous: { source: HistorySource; reader: ReaderFacts } | null;
  next: { source: HistorySource; reader: ReaderFacts } | null;
}

export function getStaticPaths() {
  return openReaders.map(({ source, reader }, index) => ({
    params: { book: reader.href.split('/').filter(Boolean).pop() },
    props: {
      source,
      reader,
      previous: openReaders[index - 1] ?? null,
      next: openReaders[index + 1] ?? null,
    },
  }));
}

const { source, reader, previous, next } = Astro.props;
const { book } = Astro.params;

const fragments = import.meta.glob<string>('../../../data/history-readers/*.html', { query: '?raw', import: 'default' });
const load = fragments[`../../../data/history-readers/${book}.html`];
if (!load) throw new Error(`No reading edition for ${book}`);
const text = await load();

const heading = text.match(/<section class="cover">[\s\S]*?<h1>([\s\S]*?)<\/h1>/)?.[1].replace(/<[^>]+>/g, '').trim() ?? source.title;
const art = text.match(/class="cover-art" src="([^"]+)"/)?.[1] ?? `${source.imageBase}-1600.webp`;
const fontHref = 'https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Sorts+Mill+Goudy:ital@0;1&display=swap';
/* Sorts Mill Goudy has no dot-below letters or ʿayn and hamza marks; EB Garamond
   supplies only those glyphs, so transliterated names stay in one design. */
const fillHref = `https://fonts.googleapis.com/css2?family=EB+Garamond:ital@0;1&display=swap&text=${encodeURIComponent('ḤḥṢṣḌḍṬṭẒẓṆṇʿʾ')}`;
---

<BaseLayout
  title={`${heading} | History (Tārīkh) | HadithCritic`}
  description={source.description}
  image={art}
  imageAlt={source.imageAlt}
  type="article"
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Projects', url: '/projects/' },
    { name: 'History', url: '/projects/history/' },
    { name: heading, url: reader.href },
  ]}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />
    <link rel="stylesheet" href={fillHref} />
    <link rel="preload" as="image" href={art} fetchpriority="high" />
  </Fragment>

  <Fragment set:html={text} />

  <section class="bk-end" aria-labelledby="bk-end-title">
    <div class="bk-end__inner">
      <p class="bk-kicker">The history library</p>
      <h2 id="bk-end-title" class="bk-end__title">Continue with another history.</h2>
      <p class="bk-end__lede">
        {source.author} ({deathDate(source)}) is one of {openReaders.length} early histories open to read in English.
      </p>
      <nav class="bk-end__books" aria-label="Neighboring books in the library">
        {previous && (
          <a class="bk-end__book" href={previous.reader.href}>
            <span class="bk-end__dir">← Earlier</span>
            <span class="bk-end__name">{previous.source.title}</span>
            <span class="bk-end__by">{previous.source.author} · {deathDate(previous.source)}</span>
          </a>
        )}
        {next && (
          <a class="bk-end__book bk-end__book--next" href={next.reader.href}>
            <span class="bk-end__dir">Later →</span>
            <span class="bk-end__name">{next.source.title}</span>
            <span class="bk-end__by">{next.source.author} · {deathDate(next.source)}</span>
          </a>
        )}
      </nav>
      <a class="bk-end__all" href="/projects/history/">All histories <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../../lib/history-reader.js';
</script>
