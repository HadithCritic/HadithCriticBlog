---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from '../../../lib/seo';
import rulesData from "../../../data/qiraat/rules.json";
import "../../../styles/qiraat.css";
import "../../../styles/qiraat-ui.css";
import QiraatSectionHeader from "../../../components/qiraat/QiraatSectionHeader.astro";
import QiraatDefinitionList from "../../../components/qiraat/QiraatDefinitionList.astro";

/* The general rules of the ten readers: how each treats a whole class of words, from the chapters
   before the word-by-word section of Taḥbīr at-Taysīr. Built by scripts/quran/qiraat/build-rules-data.py. */
type Reader = { qari: string; display: string; whole: boolean; riwayat: { id: string; display: string }[] };
type Claim = { id: string; book_id: string; page: string; quote: string; quote_is_exact_raw: boolean; via: string[]; note: string | null };
type Group = {
  kind: "reading" | "differs" | "reported" | "unstated"; tone: number | null; short: string; members: string[];
  readers: Reader[]; qaris: string[]; member_count: number; value_label?: string;
  forms?: { text: string; book_id: string; page: string }[]; claims?: Claim[];
  by_book?: { book_id: string; values: { label: string }[] }[]; values?: { label: string }[];
};
type Report = Claim & { readers: Reader[]; value_label: string; basis: string };
type Rule = {
  id: string; lemma: string; note?: string | null; unresolved?: { span: string; reason: string }[];
  groups: Group[]; reports: Report[]; books: string[];
};
type Chapter = { title_ar: string; rules: Rule[] };

const data = rulesData as unknown as {
  counts: { rules: number; chapters: number; claims: number; books: number };
  qaris: { id: string; display: string; name_ar: string; riwayat: string[] }[];
  riwayat: { id: string; qari: string; display: string; name_ar: string }[];
  books: { book_id: string; short_title: string; mark: string }[];
  chapters: Chapter[];
};
const total = data.riwayat.length;
const bookOf = new Map(data.books.map((book) => [book.book_id, book]));
const bookName = (id: string) => bookOf.get(id)?.short_title ?? id;
const qariOf = new Map(data.qaris.map((q) => [q.id, q]));
const labelLang = (text: string | undefined) => (/[؀-ۿ]/u.test(text ?? "") ? "ar" : undefined);
const noteParts = (text: string) => text.split(/([؀-ۿ]+(?:\s+[؀-ۿ]+)*)/u);
const letter = (group: Group) => String.fromCharCode(65 + (group.tone ?? 0));
const tally = (rule: Rule) => rule.groups.map((g) => `${g.kind === "reading" ? letter(g) : g.short} ${g.member_count}`);

const VIA: Record<string, string> = {
  direct: "The book names this transmitter",
  qari: "The book names the qāriʾ; applied to both his transmitters",
  rest: "The book says “the others”; applied to the readers it covers",
};
const BASIS: Record<string, string> = {
  report: "Reported through a named student",
  rejected: "Recorded, then rejected in the book",
  disputed: "The book says there is a dispute over this reader",
  permitted: "The book permits this as a way of beginning the word",
};
const KIND_LABEL = { differs: "The books differ", reported: "Reported, not listed", unstated: "Not stated in the books cited" };
const KIND_TITLE = { differs: "What each book gives", reported: "Reports only", unstated: "No book states these readers" };

function spans(groups: Group[]): number[] {
  if (groups.length === 1) return [6];
  if (groups.length === 2) {
    const [a, b] = groups.map((group) => group.member_count);
    return Math.max(a, b) >= 14 ? (a >= b ? [4, 2] : [2, 4]) : [3, 3];
  }
  return groups.map((group, index) => (index === 0 && group.member_count >= 10 ? 6 : 3));
}

const chapters = data.chapters.map((chapter, index) => ({ ...chapter, slug: `ch-${index + 1}`, number: index + 1 }));
let counter = 0;
const numbered = new Map<string, string>();
for (const chapter of chapters) for (const rule of chapter.rules) numbered.set(rule.id, String((counter += 1)).padStart(3, "0"));
---

<BaseLayout image={OG.quran}
  title="General rules | Quran | HadithCritic Projects"
  description="How each of the ten readers treats whole classes of words, with the classical book and page for each statement."
>
  <div class="qr q-ui">
    <header class="qr-hero" aria-labelledby="qr-title">
      <div class="hc-container qr-hero__inner">
        <div class="qr-hero__main">
          <p class="qr-kicker">Qurʾān · reading principles</p>
          <h1 id="qr-title">General rules</h1>
          <p class="qr-hero__lead">
            How each reader treats a whole class of words: the hamza, the madd, the imāla, merging one letter into another, stopping.
            They come from the chapters that precede the word-by-word section of Ibn al-Jazarī’s <i>Taḥbīr at-Taysīr</i>.
            Every statement is a proposal that no reviewer has checked yet, and every quotation is checked against its page.
          </p>
          <nav class="qr-nav" aria-label="General rules sections">
            <a href="#chapters">Chapters <span>{data.counts.chapters}</span></a>
            <a href="#status">Scope and method</a>
            <a href="/projects/quran/">The Qirāʾāt Variants</a>
            <a href="/projects/quran/transmission/">Transmission</a>
          </nav>
        </div>
        <aside class="qr-coverage" aria-label="Coverage at a glance">
          <p class="hc-project-hero__aside-label">Rules catalog</p>
          <p class="hc-project-hero__figure">{data.counts.rules}</p>
          <p class="hc-project-hero__caption">Across {data.counts.chapters} chapters</p>
          <p class="qr-coverage__note">{data.counts.claims} cited statements from pages 181–281 of <i>Taḥbīr at-Taysīr</i>. A reader not named for a reading is not assigned one. Short English notes are ours; the Arabic is the book’s.</p>
        </aside>
      </div>
    </header>

    <div class="hc-container qr-body">
      <section class="sec" id="chapters" aria-labelledby="chapters-h">
        <QiraatSectionHeader id="chapters-h">
          <Fragment slot="title">Chapters</Fragment>
          <Fragment slot="count">{chapters.length}</Fragment>
        </QiraatSectionHeader>
        <ol class="toc">
          {chapters.map((chapter) => (
            <li><a href={`#${chapter.slug}`}><span class="toc__ar hc-quran" lang="ar">{chapter.title_ar}</span> <b>{chapter.rules.length}</b></a></li>
          ))}
        </ol>
      </section>

      {chapters.map((chapter) => (
        <section class="sec" id={chapter.slug} aria-labelledby={`${chapter.slug}-h`}>
          <QiraatSectionHeader id={`${chapter.slug}-h`} arabic>
            <Fragment slot="title">{chapter.title_ar}</Fragment>
            <Fragment slot="count">{chapter.rules.length}</Fragment>
          </QiraatSectionHeader>
          {chapter.rules.map((rule) => (
            <article class="pos" id={rule.id} aria-labelledby={`${rule.id}-h`}>
              <header class="pos__head">
                <div>
                  <p class="pos__no"><span class="disc disc--lg">{numbered.get(rule.id)}</span> Rule</p>
                  <h3 class="pos__title pos__title--ar hc-quran" id={`${rule.id}-h`} lang="ar">{rule.lemma}</h3>
                  <div class="gs" role="img" aria-label={`Who reads what: ${tally(rule).join(", ")}`}>
                    {rule.groups.map((group) => (
                      <div class="gs__g"><span class="gs__k">{group.kind === "reading" ? letter(group) : group.short} <b>{group.member_count}</b></span></div>
                    ))}
                  </div>
                </div>
              </header>
              {rule.note && <p class="pos__flag">{noteParts(rule.note).map((text) => <bdi lang={labelLang(text)}>{text}</bdi>)}</p>}
              {rule.unresolved && rule.unresolved.length > 0 && (
                <p class="pos__flag">
                  Not assigned to any reader:{" "}
                  {rule.unresolved.map((u, i) => (
                    <>{i > 0 && "; "}<bdi lang="ar">{u.span}</bdi> ({noteParts(u.reason).map((text) => <bdi lang={labelLang(text)}>{text}</bdi>)})</>
                  ))}
                </p>
              )}
              <ol class="cards">
                {(() => {
                  const layout = spans(rule.groups);
                  return rule.groups.map((group, index) => (
                    <li class={`card card--${group.kind}`} style={`grid-column: span ${layout[index]}`}>
                      <div class="card__top">
                        <p class="card__kind">
                          {group.kind === "reading" && <b class="lt lt--lg">{letter(group)}</b>}
                          {group.kind === "reading" ? "Reading" : KIND_LABEL[group.kind]}
                        </p>
                        <p class="card__n"><b>{group.member_count}</b> of {total}</p>
                      </div>
                      <h4 class="card__title"><bdi lang={labelLang(group.value_label)}>{group.kind === "reading" ? group.value_label : KIND_TITLE[group.kind]}</bdi></h4>
                      {group.forms && group.forms.length > 0 && (
                        <ul class="forms" aria-label="As written in the book">
                          {group.forms.map((form) => (
                            <li><bdi class="forms__ar" lang="ar">{form.text}</bdi><span class="forms__src">{bookOf.get(form.book_id)?.mark} · {form.page}</span></li>
                          ))}
                        </ul>
                      )}
                      {group.by_book && (
                        <ul class="bybook">
                          {group.by_book.map((entry) => (
                            <li><b class="mk mk--on">{bookOf.get(entry.book_id)?.mark}</b>{entry.values.map((v, i) => <>{i > 0 && "; "}<bdi lang={labelLang(v.label)}>{v.label}</bdi></>)}</li>
                          ))}
                        </ul>
                      )}
                      {group.values && <p class="card__note">Reports only: {group.values.map((v, i) => <>{i > 0 && "; "}<bdi lang={labelLang(v.label)}>{v.label}</bdi></>)}. See below.</p>}
                      <p class="card__who">
                        <span class="card__k">{group.kind === "unstated" ? "Not stated for" : "Read by"}</span>
                        {group.readers.map((reader, i) => (
                          <>
                            {i > 0 && " "}
                            <span class={`who q-${reader.qari}`}>
                              <i class={reader.whole ? "sw" : `sw sw--${qariOf.get(reader.qari)!.riwayat.indexOf(reader.riwayat[0].id)}`} aria-hidden="true"></i>
                              {reader.display}{!reader.whole && ` (${reader.riwayat.map((r) => r.display).join(", ")})`}{i < group.readers.length - 1 && ","}
                            </span>
                          </>
                        ))}
                      </p>
                      {group.claims && group.claims.length > 0 && (
                        <details class="card__src">
                          <summary>Quotations ({group.claims.length})</summary>
                          <ul class="quotes">
                            {group.claims.map((claim) => (
                              <li>
                                <p class="quotes__ref">{bookName(claim.book_id)}, {claim.page}</p>
                                <blockquote class="quotes__ar" lang="ar">{claim.quote}</blockquote>
                                <p class="quotes__how">
                                  {claim.via.map((v) => VIA[v]).join(". ")}{!claim.quote_is_exact_raw && ". The quotation runs over a page break, so its vowel marks are omitted"}
                                </p>
                              </li>
                            ))}
                          </ul>
                        </details>
                      )}
                    </li>
                  ));
                })()}
              </ol>
              {rule.reports.length > 0 && (
                <details class="reports">
                  <summary>Also reported in the book ({rule.reports.length})</summary>
                  <ul>
                    {rule.reports.map((report) => (
                      <li class="rep">
                        <p class="quotes__ref">
                          {bookName(report.book_id)}, {report.page}. {report.readers.map((r) => (r.whole ? r.display : `${r.display} (${r.riwayat.map((w) => w.display).join(", ")})`)).join(", ")}: <bdi lang={labelLang(report.value_label)}>{report.value_label}</bdi>. {BASIS[report.basis]}.
                        </p>
                        <blockquote class="quotes__ar" lang="ar">{report.quote}</blockquote>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </article>
          ))}
        </section>
      ))}

      <section class="sec" id="status" aria-labelledby="status-h">
        <QiraatSectionHeader id="status-h">
          <Fragment slot="title">What is and is not here</Fragment>
        </QiraatSectionHeader>
        <QiraatDefinitionList>
          <div><dt>What the machine checks</dt><dd>That each quoted passage is on the cited page and that every reader named is in the passage. Nothing is corrected.</dd></div>
          <div><dt>What nobody has checked</dt><dd>Whether a reader was assigned to the right treatment. That takes a person reading the passage, and it has not happened yet.</dd></div>
          <div><dt>Left out on purpose</dt><dd>Agreements of all readers, the views of teachers outside the ten, the author’s own routes beyond the book, and the yāʾāt and dropped yāʾāt, which are entered place by place under each sura.</dd></div>
          <div><dt>Labels</dt><dd>The short English notes and the grouping are ours. The Arabic beside them is the book’s. Nothing here grades a reading.</dd></div>
        </QiraatDefinitionList>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .qr-hero { position: relative; border-bottom: 1px solid var(--hc-rule-soft); background: var(--hc-surface-0); }
  .qr-hero::before { position: absolute; inset: 0 auto 0 max(0px, calc((100% - var(--hc-container)) / 2)); width: 1px; background: var(--hc-rule-soft); content: ""; }
  .qr-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, 21rem); gap: clamp(2.5rem, 8vw, 8rem); align-items: end; padding-block: clamp(3rem, 7vw, 6rem) 2rem; }
  .qr-hero__main { min-width: 0; }
  .qr-kicker { margin: 0 0 0.45rem; color: var(--hc-gold); font: 600 0.75rem/1.4 var(--font-ui); letter-spacing: 0.14em; text-transform: uppercase; }
  .qr-hero h1 { max-width: 11ch; margin: 0; color: var(--hc-text-primary); font: 500 clamp(3.4rem, 8vw, 6.8rem)/0.98 var(--font-display); letter-spacing: -0.065em; }
  .qr-hero__lead { max-width: 62ch; margin: 1.35rem 0 2rem; color: var(--hc-text-secondary); font-size: 1.02rem; line-height: 1.7; }
  .qr-nav { display: flex; flex-wrap: wrap; gap: 0 1.4rem; border-top: 1px solid var(--hc-rule-soft); }
  .qr-nav a { display: flex; align-items: center; gap: 0.55rem; padding: 0.75rem 0; color: var(--hc-text-primary); font: 500 0.84rem/1.35 var(--font-ui); text-decoration: none; }
  .qr-nav a:hover { color: var(--hc-gold-bright); }
  .qr-nav a span { color: var(--hc-text-tertiary); font-size: 0.75rem; font-variant-numeric: tabular-nums; }
  .qr-coverage { padding: 1.1rem 0 0.35rem; border-top: 1px solid var(--hc-rule-strong); }
  .qr-coverage__note { max-width: 38ch; margin: 0.8rem 0 0; color: var(--hc-text-tertiary); font-size: 0.82rem; line-height: 1.6; }
  @media (max-width: 900px) {
    .qr-hero__inner { grid-template-columns: minmax(0, 1fr) minmax(13rem, 17rem); gap: 2rem; }
  }
  @media (max-width: 760px) {
    .qr-hero::before { display: none; }
    .qr-hero__inner { grid-template-columns: 1fr; gap: 2rem; }
    .qr-coverage { max-width: 32rem; }
  }
  @media (max-width: 480px) {
    .qr-hero h1 { font-size: clamp(3rem, 16vw, 4.8rem); }
  }
</style>
