---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { OG } from '../../../../lib/seo';
import transmission from "../../../../data/quran-transmission.json";
import isnadTranslations from "../../../../data/qiraat-isnad-translations.json";
import researchNotes from "../../../../data/qiraat-research-notes.json";
import "../../../../styles/qiraat.css";
import "../../../../styles/project-pages.css";

type Reader = (typeof transmission.readers)[number];
type Person = (typeof transmission.persons)[number];
type Edge = (typeof transmission.edges)[number];
type LinkEntry = { edge: Edge; person: Person };
type TranslationEntry = { label: string; locator: string; translation: string; note?: string };
type ReaderTranslations = { teachers?: TranslationEntry[]; students?: TranslationEntry[] };

const pageLabel = (edge: Edge) => {
  const witness = edge.witnesses[0];
  return `${witness.volume ? `vol. ${witness.volume}, ` : ""}p. ${witness.page}`;
};

export function getStaticPaths() {
  const personById = new Map(transmission.persons.map((person) => [person.id, person]));
  const sevenIds = new Set(["nafi", "ibn_kathir", "abu_amr", "ibn_amir", "asim", "hamza", "kisai"]);
  return transmission.readers.map((reader, index) => {
    const teachers = transmission.edges
      .filter((edge) => edge.student === reader.id)
      .map((edge) => ({ edge, person: personById.get(edge.teacher)! }));
    const students = transmission.edges
      .filter((edge) => edge.teacher === reader.id)
      .map((edge) => ({ edge, person: personById.get(edge.student)! }));
    return {
      params: { id: reader.id },
      props: {
        reader,
        person: personById.get(reader.id)!,
        readerGroup: sevenIds.has(reader.id) ? "One of Ibn Mujāhid’s seven" : "One of three additional readers",
        teachers,
        students,
        previous: transmission.readers[index - 1] ?? null,
        next: transmission.readers[index + 1] ?? null,
      },
    };
  });
}

const { reader, person, readerGroup, teachers, students, previous, next } = Astro.props as {
  reader: Reader;
  person: Person;
  readerGroup: string;
  teachers: LinkEntry[];
  students: LinkEntry[];
  previous: Reader | null;
  next: Reader | null;
};
const riwayat = reader.riwayat.map((id) => transmission.persons.find((entry) => entry.id === id)!);
const citation = `${transmission.source.author}, ${transmission.source.title}`;
/* The short title for the source chip: "an-Nashr" from "an-Nashr fi l-qiraat al-ashr". */
const shortTitle = transmission.source.title.replace(/\s+f[iī]\s.*$/u, "");
const readerResearchNotes = researchNotes.notes.filter((note) => note.readerId === reader.id);
const readerTranslations = isnadTranslations.readers[reader.id as keyof typeof isnadTranslations.readers] as ReaderTranslations | undefined;
const teacherTranslations = readerTranslations?.teachers ?? [];
const studentTranslations = readerTranslations?.students ?? [];

/* Translations mark italics with asterisks. */
const italics = (text: string) => text.split(/(\*[^*]+\*)/g).map((part, partIndex) => ({ text: partIndex % 2 === 1 ? part.slice(1, -1) : part, em: partIndex % 2 === 1 }));

/*
 * One row per link. Where several links quote the identical excerpt at the
 * identical page (Qālūn and Warsh are named in one sentence of an-Nashr), they
 * share one row that names everyone it covers. Every note is kept: a note
 * that differs is shown under the name it belongs to, and a note that is the
 * same for several names is shown once with all of them.
 */
type Row = {
  names: string[];
  translated: TranslationEntry | undefined;
  quote: string;
  locator: string;
  translationNotes: { text: string; names: string[] }[];
  indexNotes: { text: string; names: string[] }[];
};
function rowsOf(links: LinkEntry[], translations: TranslationEntry[]): Row[] {
  const rows = new Map<string, Row>();
  const addNote = (list: Row["indexNotes"], text: string | undefined | null, name: string) => {
    if (!text) return;
    const same = list.find((note) => note.text === text);
    if (same) same.names.push(name);
    else list.push({ text, names: [name] });
  };
  links.forEach(({ edge, person: other }, index) => {
    const translated = translations[index];
    const locator = translated?.locator ?? pageLabel(edge);
    const quote = edge.witnesses[0].quote;
    const key = `${translated?.translation ?? ""}\u0000${locator}\u0000${quote}`;
    const row = rows.get(key) ?? { names: [], translated, quote, locator, translationNotes: [], indexNotes: [] };
    row.names.push(other.latin);
    addNote(row.translationNotes, translated?.note, other.latin);
    addNote(row.indexNotes, edge.witnesses[0].note, other.latin);
    rows.set(key, row);
  });
  return [...rows.values()];
}
const teacherRows = rowsOf(teachers, teacherTranslations);
const studentRows = rowsOf(students, studentTranslations);
const sections = [
  { id: "teachers", title: "Teachers named in the index", noun: "teacher", count: teachers.length, rows: teacherRows, empty: "No teacher link for this reader is listed in the current extraction." },
  { id: "students", title: "Students named in the index", noun: "student", count: students.length, rows: studentRows, empty: "No student link for this reader is listed in the current extraction." },
];
---

<BaseLayout image={OG.quran}
  title={`${reader.display} | Quran | HadithCritic Projects`}
  description={`The teachers and students named for ${reader.display} in Ibn al-Jazarī’s cited account of Qurʾānic reading transmission.`}
>
  <div class={`rd pj q-${reader.id}`}>
    <header class="pj-hero" aria-labelledby="rp-title">
      <div class="pj-shell pj-hero__inner">
        <p class="pj-hero__eyebrow">{readerGroup}</p>
        <h1 id="rp-title" class="pj-hero__title">{reader.display} <span class="pj-hero__ar hc-quran" lang="ar">{person.ar_full}</span></h1>
        <p class="pj-hero__lede">The transmission index names these teachers and students for {reader.display}, with each link tied to a page in {citation}.</p>
        <p class="pj-hero__notice">The excerpts below show what the cited page says; they are not an assessment of the reading.</p>
        <div class="pj-hero__actions" role="group" aria-labelledby="rd-riwayat-label">
          <span class="rd-label" id="rd-riwayat-label">The two transmitted riwāyāt</span>
          {riwayat.map((entry, index) => (
            <a class={`pj-chip shade-${index}`} href={`/projects/quran/transmission/#p-${entry.id}`}>
              <i class="pj-dot" aria-hidden="true"></i>{entry.latin} <span lang="ar" class="rd-chip-ar">{entry.ar_full}</span>
            </a>
          ))}
        </div>
      </div>
    </header>

    <div class="pj-about">
      <div class="pj-shell">
        <details class="pj-disc">
          <summary><span class="pj-disc__title">How to read this</span></summary>
          <div class="pj-disc__body">
            <p>An arrow runs from the teacher to the person who read under them. The English entries preserve the distinction between “read under” and “transmitted”; cumulative teacher entries are translated in full.</p>
            <p>The project groups two transmitters under each reader.</p>
            <p>Where two or more links quote the same passage on the same page, they share one row; every note is kept under the name it belongs to.</p>
          </div>
        </details>
      </div>
    </div>

    <div class="pj-shell rd-body">
      {readerResearchNotes.length > 0 && (
        <section class="pj-section" aria-labelledby="research-title">
          <header class="pj-head">
            <h2 id="research-title" class="pj-head__title">Research notes</h2>
            <span class="pj-head__rule" aria-hidden="true"></span>
            <span class="pj-head__count">{readerResearchNotes.length}</span>
          </header>
          <p class="pj-lede">These notes summarize modern scholarship in its own terms. They are separate from the transmission links above and from the project’s verse-level reading data.</p>
          <ol class="rd-research">
            {readerResearchNotes.map((note) => {
              const source = researchNotes.sources[note.sourceId as keyof typeof researchNotes.sources];
              return (
                <li class="pj-card">
                  <p class="rd-research__entity">{note.entity}</p>
                  <p class="rd-research__summary">{note.summary}</p>
                  <p class="rd-research__scope">Scope: {note.scope}</p>
                  <p class="rd-cite">
                    {source.author}, <cite>{source.title}</cite>{source.year ? ` (${source.year})` : ""}, {note.locator}.
                    {"publication" in source && <> {source.publication}.</>}
                    {"doi" in source && <> <a href={source.doi} target="_blank" rel="noopener noreferrer">DOI <span aria-hidden="true">↗</span></a></>}
                  </p>
                  <p class="rd-research__access">{source.access}</p>
                </li>
              );
            })}
          </ol>
        </section>
      )}

      {sections.map((section) => (
        <section class="pj-section" id={section.id} aria-labelledby={`${section.id}-title`}>
          <header class="pj-head">
            <h2 id={`${section.id}-title`} class="pj-head__title">{section.title}</h2>
            <span class="pj-head__rule" aria-hidden="true"></span>
            <span class="pj-head__count">{section.count}</span>
          </header>
          {section.rows.length ? (
            <ol class="rd-list">
              {section.rows.map((row) => (
                <li>
                  <details class="pj-disc pj-disc--row rd-row">
                    <summary>
                      <span class="rd-rel">
                        {section.id === "teachers"
                          ? <><span>{row.names.join(", ")}</span><span class="rd-arrow" aria-hidden="true">→</span><span class="sr-only"> taught </span><b>{reader.display}</b></>
                          : <><b>{reader.display}</b><span class="rd-arrow" aria-hidden="true">→</span><span class="sr-only"> taught </span><span>{row.names.join(", ")}</span></>}
                      </span>
                      {row.names.length > 1 && <span class="pj-disc__meta">{row.names.length} {section.noun}s, one passage</span>}
                      <span class="rd-src">{shortTitle}, {row.locator}</span>
                    </summary>
                    <div class="pj-disc__body rd-row__body">
                      <blockquote>{row.translated ? italics(row.translated.translation).map((part) => part.em ? <em>{part.text}</em> : part.text) : <span lang="ar" dir="rtl">{row.quote}</span>}</blockquote>
                      <p class="rd-cite">{citation}, {row.locator}</p>
                      {row.translationNotes.map((note) => (
                        <p class="rd-note"><b>Translation note{row.names.length > 1 ? ` (${note.names.join(", ")})` : ""}:</b> {italics(note.text).map((part) => part.em ? <em>{part.text}</em> : part.text)}</p>
                      ))}
                      {row.indexNotes.map((note) => (
                        <p class="rd-note"><b>Index note{row.names.length > 1 ? ` (${note.names.join(", ")})` : ""}:</b> {note.text}</p>
                      ))}
                    </div>
                  </details>
                </li>
              ))}
            </ol>
          ) : <p class="pj-lede">{section.empty}</p>}
        </section>
      ))}

      <p class="rd-related">
        <a href="/projects/quran/transmission/">View the transmission index <span aria-hidden="true">→</span></a>
        <a href="/projects/quran/">Compare the readings <span aria-hidden="true">→</span></a>
      </p>

      <nav class="pj-pager" aria-label="Other readers">
        {previous ? <a href={`/projects/quran/readers/${previous.id}/`} rel="prev">{previous.display}</a> : <span></span>}
        <a class="pj-pager__index" href="/projects/quran/#readers">All ten readers</a>
        {next ? <a href={`/projects/quran/readers/${next.id}/`} rel="next">{next.display}</a> : <span></span>}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .rd { --pj-width: 960px; }
  .rd-body { padding-bottom: clamp(4rem, 9vw, 7rem); }
  .rd-label { margin-inline-end: 0.35rem; color: var(--hc-text-tertiary); font: 600 0.78rem/1.3 var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; }
  .rd-chip-ar { color: var(--hc-text-secondary); font: 400 1.05rem/1 var(--font-arabic); }
  .rd .pj-chip .pj-dot { --dot: var(--bg); }

  /* Teachers and students: one ruled row per link, closed until asked for. */
  .rd-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hc-rule-soft); }
  .rd-row > summary { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 1rem; padding-inline-start: 0.35rem; }
  .rd-row > summary:hover { background: color-mix(in srgb, var(--hc-gold) 6%, transparent); color: inherit; }
  .rd-rel { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.55rem; color: var(--hc-text-primary); font: 600 1rem/1.4 var(--font-display); }
  .rd-rel b { color: var(--hc-gold); font-weight: 600; }
  .rd-arrow { color: var(--hc-text-tertiary); font-family: var(--font-ui); }
  .rd-row .pj-disc__meta { grid-column: 1; grid-row: 2; }
  .rd-src { grid-column: 2; grid-row: 1 / span 2; align-self: center; padding: 0.15rem 0.55rem; border: 1px solid var(--hc-rule-soft); border-radius: var(--radius-xs); color: var(--hc-text-secondary); font: 500 0.82rem/1.4 var(--font-ui); font-variant-numeric: lining-nums tabular-nums; white-space: nowrap; }
  .rd-row__body { padding-inline: 0.35rem; }
  .rd-row blockquote { max-width: var(--pj-measure); margin: 0; color: var(--hc-text-primary); font: 400 1.02rem/1.75 var(--font-body); }
  .rd-row blockquote [lang="ar"] { font: 400 1.2rem/2 var(--font-arabic); }
  .rd-cite { margin: 0.6rem 0 0; color: var(--hc-text-secondary); font: 500 0.85rem/1.5 var(--font-ui); }
  .rd-cite a { color: var(--hc-gold); }
  .rd-note { max-width: var(--pj-measure); margin: 0.5rem 0 0; color: var(--hc-text-secondary); font-size: 0.92rem; line-height: 1.6; }
  .rd-note b { color: var(--hc-text-primary); font-weight: 600; }

  .rd-research { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: var(--pj-gap); margin: 0; padding: 0; list-style: none; }
  .rd-research__entity { margin: 0 0 0.6rem; color: var(--hc-gold); font: 600 0.8rem/1.4 var(--font-ui); letter-spacing: 0.06em; text-transform: uppercase; }
  .rd-research__summary { margin: 0; color: var(--hc-text-primary); line-height: 1.7; }
  .rd-research__scope { margin: 0.6rem 0 0; color: var(--hc-text-secondary); font-size: 0.9rem; line-height: 1.6; }
  .rd-research__access { margin: 0.25rem 0 0; color: var(--hc-text-tertiary); font-size: 0.85rem; line-height: 1.5; }

  .rd-related { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 2rem 0 0; }
  .rd-related a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; color: var(--hc-gold); font: 500 0.92rem/1.4 var(--font-ui); text-decoration: none; }
  .rd-related a:hover { color: var(--hc-gold-bright); }

  @media (max-width: 640px) {
    .rd-row > summary { grid-template-columns: minmax(0, 1fr); row-gap: 0.35rem; }
    .rd-src { grid-column: 1; grid-row: auto; justify-self: start; white-space: normal; }
    .rd-row .pj-disc__meta { grid-row: auto; }
  }
</style>
