---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from '../../../lib/seo';
import data from "../../../data/quran-transmission.json";
import translations from "../../../data/qiraat-transmission-translations.json";
import "../../../styles/qiraat.css";
import "../../../styles/qiraat-ui.css";
import QiraatSectionHeader from "../../../components/qiraat/QiraatSectionHeader.astro";
import QiraatDefinitionList from "../../../components/qiraat/QiraatDefinitionList.astro";
import QiraatBadge from "../../../components/qiraat/QiraatBadge.astro";
import MarkedNote from "../../../components/qiraat/MarkedNote.astro";

type Witness = { book_id: string; volume: string | null; page: string; quote: string; exact_raw: boolean; note: string | null; hedged: boolean };
type Person = typeof data.persons[number];
type Link = { id: string; student: string; teacher: string; firm: boolean; d: string; lineages: string[]; q: string | null; witnesses: Witness[] };
type Passage = { translation: string; locator?: string; sourceNote?: string; note?: string };
type LinkTranslation = { passages: Passage[]; untranslated?: string; locator?: string };

const links = data.edges as Link[];
const linkTranslations = translations.links as Record<string, LinkTranslation>;
const people = new Map(data.persons.map((person) => [person.id, person]));
const wear = (person: Person) => (person.q ? `q-${person.q}${person.shade !== null ? ` shade-${person.shade}` : ""}` : "");
const hasTeachers = new Set(links.map((link) => link.student));
const pageOf = (link: Link) => [...new Set(link.witnesses.map((w) => `${w.volume ? `vol. ${w.volume}, ` : ""}p. ${w.page}`))].join("; ");
const linksByStudent = new Map<string, Link[]>();
for (const link of links) linksByStudent.set(link.student, [...(linksByStudent.get(link.student) ?? []), link]);
const steps = Array.from({ length: data.columns }, (_, layer) => ({
  layer,
  persons: data.persons.filter((person) => person.layer === layer),
}));

/* Ledger: one block per person who has teachers, by column then name. */
const blocks = data.persons
  .filter((person) => hasTeachers.has(person.id))
  .sort((a, b) => a.layer - b.layer || a.latin.localeCompare(b.latin))
  .map((person) => ({ person, links: links.filter((link) => link.student === person.id) }));

const defaultReaderId = data.readers[0].id;
const readerRules = data.readers
  .map((q) => `.tx[data-selected-reader="${q.id}"] :is(.board__person, .board__teacher, .lk, .lk__list li):not([data-l~="${q.id}"]) { display: none; }`)
  .join("\n");
/* Notes are English with short Arabic quotations inline; MarkedNote gives
   each Arabic run its own language. */
---

<BaseLayout image={OG.quran}
  title="Transmission of the readings | Quran | HadithCritic Projects"
  description="The chains by which the ten readers and their twenty transmitters are said to have received the Qurʾān, traced to the Prophet, each link cited to Ibn al-Jazarī’s an-Nashr."
>
  <!-- No reader is selected in the HTML: without script every chain is shown,
       and the script applies the default reader and reveals the control. -->
  <div class="tx q-ui">
    <header class="tx-hero" aria-labelledby="tx-title">
      <div class="hc-container tx-hero__inner">
        <div class="tx-hero__main">
          <p class="tx-kicker">Qurʾān · transmission record</p>
          <h1 id="tx-title">Transmission</h1>
          <p class="tx-hero__lead">The chains by which the ten readers and their twenty transmitters are said to have received the Qurʾān, traced upward to the Prophet. Every link is cited to Ibn al-Jazarī’s <i>an-Nashr</i> and translated into English.</p>
          <nav class="tx-nav" aria-label="Transmission page sections">
            <a href="#diagram">Transmission diagram <span>{data.counts.persons} people</span></a>
            <a href="#links">Every link <span>{data.counts.links}</span></a>
            <a href="/projects/quran/">The Qirāʾāt Variants</a>
          </nav>
        </div>
        <aside class="tx-coverage" aria-label="Transmission record at a glance">
          <p class="hc-project-hero__aside-label">Documented links</p>
          <p class="hc-project-hero__figure">{data.counts.links}</p>
          <p class="hc-project-hero__caption">Across 10 readers and 20 transmitters</p>
          <p class="tx-coverage__note">The diagram records what <i>an-Nashr</i> says; it does not judge the chains. Color identifies each reader and the transmitters who carried that reading.</p>
          <div class="glance__palette" aria-label="Color key: one color per reader, with a shade for each transmitter">
            {data.readers.map((q) => <span class={`palette__pair q-${q.id}`} title={q.display}><i class="sw sw--0"></i><i class="sw sw--1"></i></span>)}
          </div>
        </aside>
      </div>
    </header>

    <div class="hc-container dockwrap">
      <div class="dock" id="tx-reader-dock" hidden>
        <label class="dock__label" for="tx-reader-select">Show transmission for</label>
        <select class="dock__select" id="tx-reader-select" aria-describedby="tx-reader-status">
          {data.readers.map((q) => <option value={q.id} selected={q.id === defaultReaderId}>{q.display}</option>)}
        </select>
        <p class="dock__status" id="tx-reader-status" aria-live="polite">Showing the chain for {data.readers[0].display}.</p>
      </div>
    </div>

    <div class="hc-container tx-body">
      <section class="sec" id="diagram" aria-labelledby="diagram-h">
        <QiraatSectionHeader id="diagram-h">
          <Fragment slot="title">From the Prophet downward</Fragment>
          <Fragment slot="count"><span id="tx-visible-person-count">{data.counts.persons}</span> people</Fragment>
        </QiraatSectionHeader>
        <p class="lede">
          Read left to right, from teacher to student. The diagram rearranges the selected chain to keep each generation legible; the source and translated passage for every link appear in “Every link, with its source” below.
        </p>
        <a class="skip" href="#links">Skip the diagram to the list of every link</a>

        <div class="frame">
          <div class="board" id="tx-diagram-board" tabindex="0" role="region" aria-label="Transmission steps. Each person is grouped by generation and names the teachers he read on.">
            {steps.map(({ layer, persons: atStep }) => (
              <section class="board__step" data-step={layer} aria-labelledby={`step-${layer}`}>
                <h3 id={`step-${layer}`} class="board__heading">{layer === 0 ? "The Prophet" : `Step ${layer}`}</h3>
                <ol class="board__people">
                  {atStep.map((person) => (
                    <li class={`board__person ${wear(person)} ${person.kind === "prophet" ? "board__person--prophet" : ""}`} data-person-id={person.id} data-l={person.lineages.join(" ")}>
                      <a class="board__name" href={hasTeachers.has(person.id) ? `#p-${person.id}` : undefined} aria-label={hasTeachers.has(person.id) ? `${person.latin}; jump to sources in the link ledger` : undefined}>
                        <span title={person.latin}>{person.latin}</span>
                        {(person.kind === "qari" || person.kind === "riwaya") && <span class="board__ar" lang="ar">{person.ar}</span>}
                      </a>
                      {linksByStudent.has(person.id) && (
                        <ul class="board__teachers">
                          {linksByStudent.get(person.id)!.map((link) => {
                            const teacher = people.get(link.teacher)!;
                            return (
                              <li class="board__teacher" data-l={link.lineages.join(" ")}>
                                <span class="board__verb">Read on</span>
                                {hasTeachers.has(teacher.id) ? <a href={`#p-${teacher.id}`} title={teacher.latin}>{teacher.latin}</a> : <span title={teacher.latin}>{teacher.latin}</span>}
                                {!link.firm && <span class="board__loose" aria-label="Hedged or not stated as reading">†</span>}
                              </li>
                            );
                          })}
                        </ul>
                      )}
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
          <div class="board__scroll-control" hidden>
            <input class="board__scroll-range" id="tx-diagram-scroll" type="range" min="0" max="100" value="0" step="1" aria-label="Scroll through the transmission steps" aria-controls="tx-diagram-board" />
          </div>
          <p class="board__note">† The source hedges this link or describes hearing, letters only, or companionship. The page and translated passage for each link are listed below.</p>
        </div>
      </section>

      <section class="sec" id="links" aria-labelledby="links-h">
        <QiraatSectionHeader id="links-h">
          <Fragment slot="title">Every link, with its source</Fragment>
          <Fragment slot="count"><span id="tx-visible-link-count">{data.counts.links}</span> links</Fragment>
        </QiraatSectionHeader>
        <p class="lede">Each entry names a person, the teachers the book gives him, and the page. English translations, source locators, and notes are shown with each link.</p>
        <div class="ledger">
          {blocks.map(({ person, links: own }) => (
            <article class={`lk ${wear(person)}`} id={`p-${person.id}`} data-l={person.lineages.join(" ")}>
              <h3 class="lk__name">
                {person.q && <i class={person.shade !== null ? "sw" : "sw sw--0"} aria-hidden="true"></i>}
                <span class="lk__latin">{person.latin}</span> <span class="lk__ar" lang="ar">{person.ar}</span>
              </h3>
              <QiraatBadge class="lk__step">Step {person.layer} · {own.length} {own.length === 1 ? "teacher" : "teachers"}</QiraatBadge>
              <p class="lk__source-label">English translation &amp; source passage</p>
              <ol class="lk__list">
                {own.map((link) => {
                  const teacher = people.get(link.teacher)!;
                  return (
                    <li class={link.firm ? "" : "is-loose"} data-l={link.lineages.join(" ")}>
                      <p class="lk__line">
                        <span class="lk__verb">Read on</span>
                        {hasTeachers.has(teacher.id) ? <a href={`#p-${teacher.id}`}>{teacher.latin}</a> : <span>{teacher.latin}</span>}
                        <span class="lk__pg">an-Nashr, {pageOf(link)}</span>
                        {!link.firm && <QiraatBadge class="lk__flag" tone="hedged">hedged or not a reading</QiraatBadge>}
                      </p>
                      <div class="lk__more">
                        <div class="lk__translations">
                        {linkTranslations[link.id]?.passages.map((passage) => (
                          <div class="lk__quote">
                            <blockquote><MarkedNote text={passage.translation} /></blockquote>
                            {passage.locator && <p><MarkedNote text={passage.locator} /></p>}
                            {passage.sourceNote && <p><MarkedNote text={passage.sourceNote} /></p>}
                            {passage.note && <p><MarkedNote text={passage.note} /></p>}
                          </div>
                        ))}
                        {linkTranslations[link.id]?.untranslated && (
                          <div class="lk__quote">
                            <p><MarkedNote text={linkTranslations[link.id].untranslated ?? ''} /></p>
                            <p><MarkedNote text={linkTranslations[link.id].locator ?? ''} /></p>
                          </div>
                        )}
                        {link.witnesses.filter((w) => w.note && !linkTranslations[link.id]?.passages.some((p) => p.note && p.note.replace(/\*/g, "").trim() === w.note!.trim())).map((w) => (
                          <div class="lk__quote">
                            <p><b>Index note:</b> <MarkedNote text={w.note!} /></p>
                          </div>
                        ))}
                        </div>
                      </div>
                    </li>
                  );
                })}
              </ol>
            </article>
          ))}
        </div>
      </section>

      <section class="sec" id="guide" aria-labelledby="guide-h">
        <QiraatSectionHeader id="guide-h">
          <Fragment slot="title">How to read this</Fragment>
        </QiraatSectionHeader>
        <QiraatDefinitionList>
          <div><dt>One book</dt><dd>Every link comes from an-Nashr. Other books may give other teachers, and where they do this page does not show it yet.</dd></div>
          <div><dt>Read on</dt><dd>The book’s phrase for a student reciting to a teacher. Where it says something else, such as hearing or transmitting letters, the link is dashed and its note says so.</dd></div>
          <div><dt>Joined entries</dt><dd>Some chains are given in another reader’s entry. Where we matched a name in one entry to a person in another, the link’s note says so.</dd></div>
          <div><dt>Two people, two names</dt><dd>Khalaf and al-Dūrī each appear twice, once for each reading they carried, and are kept as separate people because the book presents them that way.</dd></div>
          <div><dt>Review</dt><dd>No link has been reviewed. Each is checked only for one thing: that the quoted words appear on the cited page.</dd></div>
        </QiraatDefinitionList>
        <p class="attribution">Translated passages are from an edition in the Maktaba Shamela, cited by page. Latin spellings of names are ours.</p>
      </section>
    </div>
  </div>

  <script>
    const readerSelect = document.getElementById("tx-reader-select") as HTMLSelectElement | null;
    const transmission = document.querySelector(".tx") as HTMLElement | null;

    if (readerSelect && transmission) {
      const status = document.getElementById("tx-reader-status");
      const personCount = document.getElementById("tx-visible-person-count");
      const linkCount = document.getElementById("tx-visible-link-count");
      const board = transmission.querySelector<HTMLElement>(".board");
      const scrollRange = document.getElementById("tx-diagram-scroll") as HTMLInputElement | null;
      const scrollControl = transmission.querySelector<HTMLElement>(".board__scroll-control");

      const syncScrollControl = () => {
        if (!board || !scrollRange || !scrollControl) return;
        const max = board.scrollWidth - board.clientWidth;
        scrollRange.max = String(max);
        scrollRange.value = String(board.scrollLeft);
        scrollRange.setAttribute("aria-valuetext", `${max ? Math.round(board.scrollLeft / max * 100) : 0}%`);
        scrollControl.hidden = max <= 0;
      };
      scrollRange?.addEventListener("input", () => {
        if (board && scrollRange) board.scrollLeft = Number(scrollRange.value);
      });
      board?.addEventListener("scroll", syncScrollControl, { passive: true });
      if (board) new ResizeObserver(syncScrollControl).observe(board);

      const updateTransmission = () => {
        const readerId = readerSelect.value;
        const readerName = readerSelect.selectedOptions[0]?.textContent?.trim() ?? "the selected reader";
        transmission.dataset.selectedReader = readerId;

        const activePeople = [...transmission.querySelectorAll<HTMLElement>(".board__person")]
          .filter((person) => person.dataset.l?.split(" ").includes(readerId));
        const activeLinks = [...transmission.querySelectorAll<HTMLElement>(".board__teacher")]
          .filter((link) => link.dataset.l?.split(" ").includes(readerId));
        const people = activePeople.length;
        const links = activeLinks.length;
        board?.querySelectorAll<HTMLElement>(".board__step").forEach((step) => {
          step.style.display = [...step.querySelectorAll<HTMLElement>(".board__person")]
            .some((person) => getComputedStyle(person).display !== "none") ? "" : "none";
        });
        if (personCount) personCount.textContent = String(people);
        if (linkCount) linkCount.textContent = String(links);
        if (status) status.textContent = `Showing ${readerName}’s chain: ${people} people and ${links} links.`;
        syncScrollControl();
      };

      readerSelect.addEventListener("change", updateTransmission);
      updateTransmission();
      const dock = document.getElementById("tx-reader-dock");
      if (dock) dock.hidden = false;
    }
  </script>

  <style is:inline set:html={readerRules}></style>
</BaseLayout>

<style>
  .tx-hero { position: relative; border-bottom: 1px solid var(--hc-rule-soft); background: var(--hc-surface-0); }
  .tx-hero::before { position: absolute; inset: 0 auto 0 max(0px, calc((100% - var(--hc-container)) / 2)); width: 1px; background: var(--hc-rule-soft); content: ""; }
  .tx-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, 21rem); gap: clamp(2.5rem, 8vw, 8rem); align-items: end; padding-block: clamp(3rem, 7vw, 6rem) 2rem; }
  .tx-kicker { margin: 0 0 0.45rem; color: var(--hc-gold); font: 600 0.75rem/1.4 var(--font-ui); letter-spacing: 0.14em; text-transform: uppercase; }
  .tx-hero h1 { max-width: 11ch; margin: 0; color: var(--hc-text-primary); font: 500 clamp(3.4rem, 8vw, 6.8rem)/0.98 var(--font-display); letter-spacing: -0.065em; }
  .tx-hero__lead { max-width: 62ch; margin: 1.35rem 0 2rem; color: var(--hc-text-secondary); font-size: 1.02rem; line-height: 1.7; }
  .tx-nav { display: flex; flex-wrap: wrap; gap: 0 1.4rem; border-top: 1px solid var(--hc-rule-soft); }
  .tx-nav a { display: flex; align-items: center; gap: 0.55rem; padding: 0.75rem 0; color: var(--hc-text-primary); font: 500 0.84rem/1.35 var(--font-ui); text-decoration: none; }
  .tx-nav a:hover { color: var(--hc-gold-bright); }
  .tx-nav a span { color: var(--hc-text-tertiary); font-size: 0.75rem; font-variant-numeric: tabular-nums; }
  .tx-coverage { padding: 1.1rem 0 0.35rem; border-top: 1px solid var(--hc-rule-strong); }
  .tx-coverage__note { max-width: 34ch; margin: 0.8rem 0 0; color: var(--hc-text-tertiary); font-size: 0.82rem; line-height: 1.6; }
  .glance__palette { margin-top: 1rem; }
  .palette__pair { display: inline-flex; gap: 2px; margin-inline-end: 4px; vertical-align: middle; }
  .palette__pair .sw { width: 0.55rem; height: 0.8rem; border-radius: 0; box-shadow: none; }
  @media (max-width: 900px) {
    .tx-hero__inner { grid-template-columns: minmax(0, 1fr) minmax(13rem, 17rem); gap: 2rem; }
  }
  @media (max-width: 760px) {
    .tx-hero::before { display: none; }
    .tx-hero__inner { grid-template-columns: 1fr; gap: 2rem; }
    .tx-coverage { max-width: 26rem; }
  }
  @media (max-width: 540px) {
    .tx-hero h1 { font-size: clamp(3rem, 16vw, 4.8rem); }
    .glance__palette { overflow: hidden; max-width: 100%; }
  }
</style>
