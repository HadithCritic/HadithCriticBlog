---
import BaseLayout from "../../../../../../layouts/BaseLayout.astro";
import SuraQiraat from "../../../../../../components/qiraat/SuraQiraat.astro";
import { loadSuras } from "../../../../../../lib/qiraat-suras";
import { sliceSura } from "../../../../../../lib/qiraat-parts";

/* One page per part of a long sura. Suras that fit on one page have no parts. */
export function getStaticPaths() {
  return loadSuras().flatMap((sura) =>
    sura.parts.map((part) => ({ params: { n: String(sura.n), p: String(part.index) }, props: { sura, part } })),
  );
}

const { sura, part } = Astro.props;
const { data, name, prev, next, parts } = sura;
const slice = sliceSura(data, part);
---

<BaseLayout
  title={`${name.latin}, Sura ${name.n}, part ${part.index} of ${part.of} | Quran | HadithCritic Projects`}
  description={`The ten qirāʾāt word by word in ${name.latin}, verses ${part.firstVerse} to ${part.lastVerse}, with the classical books that report each reading.`}
>
  <SuraQiraat data={slice} name={name} prev={prev} next={next} parts={parts} part={part} />
</BaseLayout>
