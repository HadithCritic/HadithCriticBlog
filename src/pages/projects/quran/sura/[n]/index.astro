---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { OG } from '../../../../../lib/seo';
import SuraQiraat from "../../../../../components/qiraat/SuraQiraat.astro";
import { loadSuras } from "../../../../../lib/qiraat-suras";

/* One page per sura. A long sura gets an overview here and its positions on the part pages. */
export function getStaticPaths() {
  return loadSuras().map((sura) => ({ params: { n: String(sura.n) }, props: { sura } }));
}

const { sura } = Astro.props;
const { data, name, prev, next, parts } = sura;
---

<BaseLayout image={OG.quran}
  title={`${name.latin}, Sura ${name.n} | Quran | HadithCritic Projects`}
  description={`The ten qirāʾāt word by word in ${name.latin}, with the classical books that report each reading.`}
>
  <SuraQiraat data={data} name={name} prev={prev} next={next} parts={parts} part={null} />
</BaseLayout>
