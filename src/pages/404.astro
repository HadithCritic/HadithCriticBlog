---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | HadithCritic" description="The page you were looking for does not exist.">
  <section class="nf-section">
    <div class="hc-container nf-wrap">
      <span class="hc-eyebrow">Error 404</span>
      <h1 class="nf-title">This page is not in the record.</h1>
      <p class="hc-copy nf-copy">
        The address may have changed, or it never existed. Try one of the destinations below.
      </p>
      <nav class="nf-links" aria-label="Helpful destinations">
        <a href="/">Front page</a>
        <a href="/blogs">The archive</a>
        <a href="/projects">Projects</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </section>
</BaseLayout>


<style>
  .nf-section {
    display: grid;
    align-items: center;
    min-height: 55vh;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .nf-wrap {
    max-width: 720px;
  }

  .nf-title {
    margin: 0.9rem 0 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .nf-copy {
    margin: 1.1rem 0 1.8rem;
    max-width: 56ch;
  }

  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .nf-links a {
    color: var(--hc-gold-dim);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nf-links a:hover {
    color: var(--hc-gold);
  }

</style>
