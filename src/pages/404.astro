---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | HadithCritic" description="The page you were looking for does not exist.">
  <section class="nf-section">
    <div class="hc-container nf-wrap">
      <span class="hc-eyebrow">Error 404</span>
      <h1 class="nf-title">This page is not in the record.</h1>
      <p class="hc-copy nf-copy">
        The address may have changed, or it never existed. If you were chasing a report, the
        database search below will get you closer than guessing URLs.
      </p>
      <form class="nf-form" action="/silsilah/search/" method="get" role="search">
        <input
          type="text"
          name="q"
          placeholder="Search the hadith database, e.g. intentions or bukhari:2487"
          aria-label="Search the hadith database"
          autocomplete="off"
          spellcheck="false"
        />
        <button type="submit" class="hc-btn">Search</button>
      </form>
      <nav class="nf-links" aria-label="Helpful destinations">
        <a href="/">Front page</a>
        <a href="/blogs">The archive</a>
        <a href="/silsilah/">Silsilah database</a>
        <a href="/projects">Projects</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </section>
</BaseLayout>


<style>
  .nf-section {
    display: grid;
    align-items: center;
    min-height: 55vh;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .nf-wrap {
    max-width: 720px;
  }

  .nf-title {
    margin: 0.9rem 0 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .nf-copy {
    margin: 1.1rem 0 1.8rem;
    max-width: 56ch;
  }

  .nf-form {
    display: flex;
    gap: 0.7rem;
    max-width: 560px;
  }

  .nf-form input {
    flex: 1;
    min-width: 0;
    padding: 0.72rem 1rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: rgba(15, 15, 16, 0.6);
    color: var(--hc-parchment);
    font-family: var(--font-ui);
    font-size: 0.92rem;
  }

  .nf-form input:focus {
    outline: none;
    border-color: var(--hc-rule-strong);
  }

  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .nf-links a {
    color: var(--hc-gold-dim);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nf-links a:hover {
    color: var(--hc-gold);
  }

  @media (max-width: 560px) {
    .nf-form {
      flex-direction: column;
    }
  }
</style>
