---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadRijalMeta, loadRijalChunk, type RijalEntry } from '../../../lib/rijal';

const PER_PAGE = 200;

export async function getStaticPaths() {
  const meta = loadRijalMeta();
  const pages = Math.ceil(meta.count / 200);
  return Array.from({ length: pages }, (_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) }
  }));
}

const { page } = Astro.params;
const pageNum = page ? parseInt(page, 10) : 1;
const meta = loadRijalMeta();
const totalPages = Math.ceil(meta.count / PER_PAGE);

const startId = (pageNum - 1) * PER_PAGE + 1;
const endId = Math.min(pageNum * PER_PAGE, meta.count);

const entries: RijalEntry[] = [];
for (let id = startId; id <= endId; id++) {
  const chunk = loadRijalChunk(Math.floor((id - 1) / meta.chunk));
  const e = chunk[(id - 1) % meta.chunk];
  if (e) entries.push(e);
}

const pageUrl = (p: number) => (p === 1 ? '/rijal/browse/' : `/rijal/browse/${p}/`);
const firstName = entries[0]?.name ?? '';
---

<BaseLayout
  title={`Browse narrators, page ${pageNum} of ${totalPages} | HadithCritic`}
  description={`Alphabetical register of the transmitters of the six books, entries ${startId} to ${endId}, beginning with ${firstName}.`}
>
  <section class="rb-wrap">
    <div class="hc-container rb-inner">
      <nav class="rb-crumbs" aria-label="Breadcrumb">
        <a href="/rijal/">Narrator Biographies</a>
        <span aria-hidden="true">/</span>
        <span>Browse</span>
      </nav>
      <header class="rb-head">
        <h1 class="rb-title">All entries, in the order of al-Kāshif</h1>
        <p class="rb-sub">Entries {startId.toLocaleString('en-US')} to {endId.toLocaleString('en-US')} of {meta.count.toLocaleString('en-US')} · page {pageNum} of {totalPages}</p>
      </header>

      <ol class="rb-list" dir="rtl">
        {entries.map((e) => (
          <li>
            <a href={`/rijal/${e.id}/`} class="rb-row">
              <span class="rb-name">{e.name}</span>
              <span class="rb-meta" dir="ltr">
                {e.death && `d. ${e.death} AH`}
                {e.death && e.symbols.length > 0 && ' · '}
                {e.symbols.join(' ')}
              </span>
            </a>
          </li>
        ))}
      </ol>

      <nav class="rb-pager" aria-label="Pages">
        <a href={pageUrl(Math.max(1, pageNum - 1))} class:list={['rb-pager-btn', { 'is-disabled': pageNum === 1 }]}>← Previous</a>
        <span>Page {pageNum} of {totalPages}</span>
        <a href={pageUrl(Math.min(totalPages, pageNum + 1))} class:list={['rb-pager-btn', { 'is-disabled': pageNum === totalPages }]}>Next →</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .rb-wrap {
    padding-block: clamp(2rem, 4.5vw, 3.2rem);
  }

  .rb-inner {
    max-width: 880px;
  }

  .rb-crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rb-crumbs a {
    color: var(--hc-gold-dim);
    text-decoration: none;
  }

  .rb-crumbs a:hover {
    color: var(--hc-gold);
  }

  .rb-title {
    margin: 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    letter-spacing: -0.02em;
  }

  .rb-sub {
    margin: 0.6rem 0 0;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.82rem;
  }

  .rb-list {
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hc-rule);
  }

  .rb-list li {
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .rb-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1.2rem;
    padding: 0.6rem 0.5rem;
    text-decoration: none;
    transition: background 200ms ease;
  }

  .rb-row:hover {
    background: linear-gradient(270deg, rgba(216, 177, 102, 0.06), transparent 65%);
  }

  .rb-name {
    color: var(--hc-parchment);
    font-family: var(--font-arabic);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .rb-row:hover .rb-name {
    color: var(--hc-gold-soft);
  }

  .rb-meta {
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .rb-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--hc-rule-soft);
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.8rem;
  }

  .rb-pager-btn {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    color: var(--hc-muted);
    text-decoration: none;
    transition: color 200ms ease, border-color 200ms ease;
  }

  .rb-pager-btn:hover {
    color: var(--hc-gold);
    border-color: var(--hc-rule-strong);
  }

  .rb-pager-btn.is-disabled {
    opacity: 0.35;
    pointer-events: none;
  }
</style>
