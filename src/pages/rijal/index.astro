---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadRijalMeta, SYMBOL_MAP } from '../../lib/rijal';

const meta = loadRijalMeta();
const fmt = (n: number) => n.toLocaleString('en-US');
const mainSymbols = ['خ', 'م', 'د', 'ت', 'س', 'ق', 'ع', '4'];
---

<BaseLayout
  title="Narrator Biographies | HadithCritic"
  description="A searchable register of the transmitters of the six canonical hadith collections, built from Dhahabi's al-Kashif. Teachers, students, death dates, and the collections each narrator appears in."
>
  <section class="rj-hero">
    <div class="hc-container">
      <nav class="rj-crumbs" aria-label="Breadcrumb">
        <a href="/projects">Projects</a>
        <span aria-hidden="true">/</span>
        <span>Narrator Biographies</span>
      </nav>
      <div class="rj-hero-grid">
        <div>
          <span class="hc-eyebrow">Rijāl database, version one</span>
          <h1 class="rj-title">The men and women behind the chains.</h1>
          <p class="hc-copy rj-sub">
            Every transmitter cited in the six canonical collections, as registered in Dhahabī's
            <em>al-Kāshif</em>: who they heard from, who transmitted from them, when they died,
            and which collections cite them. Search in Arabic, no diacritics needed.
          </p>
          <form id="rjForm" class="rj-search" role="search">
            <input
              id="rjInput"
              type="text"
              placeholder="مثلا: مالك بن انس او نافع مولي ابن عمر"
              aria-label="Search narrators in Arabic"
              autocomplete="off"
              spellcheck="false"
              dir="rtl"
            />
            <button type="submit" class="hc-btn">Search</button>
          </form>
          <p id="rjStatus" class="rj-status" role="status"></p>
          <ol id="rjResults" class="rj-results" dir="rtl"></ol>
          <div class="rj-more-wrap">
            <button type="button" id="rjMore" class="hc-btn hc-btn--ghost" hidden>Show more</button>
          </div>
        </div>
        <aside class="rj-side">
          <dl class="rj-stats">
            <div><dt>Entries</dt><dd>{fmt(meta.count)}</dd></div>
            <div><dt>With death year</dt><dd>{fmt(meta.withDeath)}</dd></div>
            <div><dt>With collection sigla</dt><dd>{fmt(meta.withSymbols)}</dd></div>
          </dl>
          <div class="rj-legend">
            <h2>Collection sigla</h2>
            <ul>
              {mainSymbols.map((s) => (
                <li><b dir="rtl">{s}</b><span>{SYMBOL_MAP[s]}</span></li>
              ))}
            </ul>
          </div>
          <a class="rj-browse-link" href="/rijal/browse/">Browse all entries alphabetically →</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="hc-section">
    <div class="hc-container rj-about">
      <h2 class="hc-title hc-title--md">About this register</h2>
      <p class="hc-copy">
        Version one is built from a single source: <em>{meta.source}</em> by {meta.author},
        itself a distillation of {meta.basedOn}. Entries are parsed from the OpenITI edition of
        the text; the original Arabic of every entry is shown in full on its page, with the
        structured fields (teachers, students, death year, sigla) extracted automatically and
        therefore imperfect at the margins. Future versions will layer the long-form biographies
        of Mizzī and the criticism record of Ibn Ḥajar onto these same entries, and eventually
        link narrators to their occurrences in <a href="/silsilah/">Silsilah</a> chains.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { normalizeArabic } from '../../lib/silsilah-text';

  type Row = [number, string, string, string | null, string, number];

  const input = document.getElementById('rjInput') as HTMLInputElement;
  const form = document.getElementById('rjForm') as HTMLFormElement;
  const statusEl = document.getElementById('rjStatus') as HTMLElement;
  const resultsEl = document.getElementById('rjResults') as HTMLElement;
  const moreBtn = document.getElementById('rjMore') as HTMLButtonElement;

  let index: Row[] | null = null;
  let matches: Row[] = [];
  let shown = 0;
  const BATCH = 25;

  async function getIndex(): Promise<Row[]> {
    if (index) return index;
    const res = await fetch('/rijal-data/index.json');
    index = (await res.json()) as Row[];
    return index;
  }

  function renderBatch() {
    const slice = matches.slice(shown, shown + BATCH);
    shown += slice.length;
    for (const [id, , name, death, symbols, stub] of slice) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '/rijal/' + id + '/';
      a.className = 'rj-result';
      const nm = document.createElement('span');
      nm.className = 'rj-result-name';
      nm.textContent = name;
      a.appendChild(nm);
      const meta = document.createElement('span');
      meta.className = 'rj-result-meta';
      meta.dir = 'ltr';
      const bits = [];
      if (death) bits.push('d. ' + death + ' AH');
      if (symbols) bits.push(symbols);
      if (stub) bits.push('cross-reference');
      meta.textContent = bits.join(' · ');
      a.appendChild(meta);
      li.appendChild(a);
      resultsEl.appendChild(li);
    }
    moreBtn.hidden = shown >= matches.length;
    if (!moreBtn.hidden) moreBtn.textContent = 'Show more (' + (matches.length - shown) + ' remaining)';
  }

  async function search(raw: string) {
    const q = normalizeArabic(raw.trim()).replace(/\s+/g, ' ');
    resultsEl.innerHTML = '';
    shown = 0;
    matches = [];
    if (q.length < 2) {
      statusEl.textContent = '';
      moreBtn.hidden = true;
      return;
    }
    statusEl.textContent = 'Searching ...';
    const idx = await getIndex();
    const terms = q.split(' ').filter(Boolean);
    matches = idx.filter((row) => terms.every((t) => row[1].includes(t)));
    statusEl.textContent = matches.length
      ? matches.length.toLocaleString('en-US') + ' narrators match.'
      : 'No narrators match. Try fewer words or a different spelling.';
    renderBatch();
  }

  let timer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => search(input.value), 200);
  });
  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    search(input.value);
  });
  moreBtn.addEventListener('click', renderBatch);

  const initial = new URL(location.href).searchParams.get('q');
  if (initial) {
    input.value = initial;
    search(initial);
  }
</script>

<style>
  .rj-hero {
    border-bottom: 1px solid var(--hc-rule);
    background:
      radial-gradient(circle at 82% 12%, rgba(216, 177, 102, 0.07), transparent 36%),
      linear-gradient(180deg, rgba(30, 29, 27, 0.6), rgba(15, 15, 16, 0.2));
    padding-block: clamp(2rem, 4.5vw, 3.4rem);
  }

  .rj-crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rj-crumbs a {
    color: var(--hc-gold-dim);
    text-decoration: none;
  }

  .rj-crumbs a:hover {
    color: var(--hc-gold);
  }

  .rj-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(2rem, 4vw, 3.4rem);
    align-items: start;
  }

  .rj-title {
    margin: 0.8rem 0 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .rj-sub {
    margin: 1.1rem 0 1.6rem;
    max-width: 58ch;
  }

  .rj-search {
    display: flex;
    gap: 0.7rem;
    max-width: 600px;
  }

  .rj-search input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: rgba(15, 15, 16, 0.6);
    color: var(--hc-parchment);
    font-family: var(--font-arabic);
    font-size: 1.05rem;
  }

  .rj-search input::placeholder {
    color: var(--hc-ash);
    font-size: 0.92rem;
  }

  .rj-search input:focus {
    outline: none;
    border-color: var(--hc-rule-strong);
  }

  .rj-status {
    min-height: 1.3rem;
    margin: 0.8rem 0 0;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.84rem;
  }

  .rj-results {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    max-width: 640px;
  }

  .rj-result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.5), rgba(15, 15, 16, 0.8));
    text-decoration: none;
    transition: border-color 200ms ease;
  }

  .rj-result:hover {
    border-color: var(--hc-rule-strong);
  }

  .rj-result-name {
    color: var(--hc-parchment);
    font-family: var(--font-arabic);
    font-size: 1.12rem;
    line-height: 1.6;
  }

  .rj-result:hover .rj-result-name {
    color: var(--hc-gold-soft);
  }

  .rj-result-meta {
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
  }

  .rj-more-wrap {
    margin-top: 1rem;
  }

  .rj-side {
    display: grid;
    gap: 1.2rem;
  }

  .rj-stats {
    margin: 0;
    display: grid;
    gap: 1px;
    border: 1px solid var(--hc-rule);
    background: var(--hc-rule);
  }

  .rj-stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.2rem;
    padding: 0.95rem 1.1rem;
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.92), rgba(15, 15, 16, 0.96));
  }

  .rj-stats dt {
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .rj-stats dd {
    margin: 0;
    color: var(--hc-gold);
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .rj-legend {
    border: 1px solid var(--hc-rule);
    padding: 1rem 1.1rem;
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.6), rgba(15, 15, 16, 0.9));
  }

  .rj-legend h2 {
    margin: 0 0 0.8rem;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .rj-legend ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem 1rem;
  }

  .rj-legend li {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    color: var(--hc-muted);
  }

  .rj-legend b {
    display: grid;
    place-items: center;
    min-width: 26px;
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    color: var(--hc-gold);
    font-family: var(--font-arabic);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .rj-browse-link {
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .rj-browse-link:hover {
    color: var(--hc-gold-soft);
  }

  .rj-about .hc-copy {
    margin-top: 1rem;
    max-width: 76ch;
  }

  .rj-about a {
    color: var(--hc-gold);
  }

  @media (max-width: 980px) {
    .rj-hero-grid {
      grid-template-columns: 1fr;
    }
    .rj-stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .rj-search {
      flex-direction: column;
    }
    .rj-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
