---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CORPUS_META } from "../lib/corpus-config";
import "../styles/project-showcase.css";

const corpusStats = CORPUS_META.counts;

const madhhabs = [
  {
    school: "Ḥanafī",
    authorities: "Abū Ḥanīfa · al-Sarakhsī · Ibn ʿĀbidīn",
    scope: "Classical Fatāwā & Radd al-Muḥtār",
  },
  {
    school: "Mālikī",
    authorities: "Mālik b. Anas · al-Qāḍī ʿIyāḍ · al-Qarāfī",
    scope: "Medinese Consensus & al-Shifā",
  },
  {
    school: "Shāfiʿī",
    authorities: "Al-Shāfiʿī · al-Nawawī · Taqī al-Dīn al-Subkī",
    scope: "Al-Majmūʿ & Shifāʾ al-Siqām",
  },
  {
    school: "Ḥanbalī",
    authorities: "Aḥmad b. Ḥanbal · Ibn Qudāmah · al-Buhūtī",
    scope: "Al-Mughnī & Kashshāf al-Qināʿ",
  },
];
---

<BaseLayout
  title="Projects | HadithCritic"
  description="Ongoing research projects, digital tools, and collaborative initiatives at HadithCritic."
>
  <div class="projects-page">
    <header
      class="projects-hero"
      aria-labelledby="projects-hero-title"
      data-motion="hero"
    >
      <div class="hc-container">
        <div class="projects-hero__inner">
          <div class="projects-hero__content">
            <div class="projects-hero__eyebrow">
              <span class="projects-hero__kicker-dot" aria-hidden="true"></span>
              <span class="projects-hero__kicker">Digital Infrastructure</span>
              <span class="projects-hero__kicker-sep" aria-hidden="true">/</span>
              <span class="projects-hero__kicker-tag">Research Tools &amp; Corpora</span>
            </div>

            <h1 id="projects-hero-title" class="projects-hero__title">
              Tools for Reading <span class="projects-hero__title-accent">Transmission</span>
            </h1>

            <p class="projects-hero__lead">
              Ongoing research initiatives, digital infrastructure, and collaborative analytical tools built to examine hadith transmission, legal theory, and source history.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Distinct Primary Research Modules -->
    <section
      class="projects-modules hc-container"
      aria-labelledby="modules-title"
    >
      <header class="modules-head" data-motion="reveal">
        <div class="modules-head__lead">
          <p class="hc-eyebrow">Research Infrastructure</p>
          <h2 id="modules-title" class="modules-head__title">
            Core Research Editions & Archives
          </h2>
        </div>
        <span class="modules-head__rule" aria-hidden="true"></span>
        <span class="modules-head__count">4 primary initiatives</span>
      </header>

      <div class="modules-stack">
        <div class="disciplines-duo-row">
          <a href="/hadith/" class="project-showcase" id="hadith-corpus">
            <img class="project-showcase__art" src="/images/hadith-corpus-art.webp" alt="" aria-hidden="true" width="1536" height="1024" loading="lazy" decoding="async" />
            <span class="project-showcase__content">
              <span class="project-showcase__eyebrow">Textual corpus</span>
              <span class="project-showcase__heading">
                <span class="project-showcase__title">Hadith Corpus</span>
                <span class="project-showcase__ar" dir="rtl" lang="ar">المكنز الحديثي الشامل</span>
              </span>
              <span class="project-showcase__desc">
                Search {corpusStats.hadith.toLocaleString("en-GB")} narrations across {corpusStats.collections} collections. Read Arabic and English texts alongside their linked transmission chains.
              </span>
              <span class="project-showcase__stats" aria-label="Hadith corpus figures">
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.hadith.toLocaleString("en-GB")}</span><span class="project-showcase__label">Narrations</span></span>
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.collections}</span><span class="project-showcase__label">Collections</span></span>
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.chainLinks.toLocaleString("en-GB")}</span><span class="project-showcase__label">Chain links</span></span>
              </span>
              <span class="project-showcase__footer"><span class="project-showcase__note">Arabic and English search</span><span class="project-showcase__cta">Search the corpus</span></span>
            </span>
          </a>

          <a href="/narrators/" class="project-showcase" id="narrator-biographies">
            <img class="project-showcase__art" src="/images/rijal-register-art.webp" alt="" aria-hidden="true" width="1536" height="1024" loading="lazy" decoding="async" />
            <span class="project-showcase__content">
              <span class="project-showcase__eyebrow">Biographical register</span>
              <span class="project-showcase__heading">
                <span class="project-showcase__title">Rijāl Register</span>
                <span class="project-showcase__ar" dir="rtl" lang="ar">طبقات الرواة والرجال</span>
              </span>
              <span class="project-showcase__desc">
                Trace named transmitters through teacher and student links. Consult biographical records and criticism attributed to classical sources.
              </span>
              <span class="project-showcase__stats" aria-label="Transmitter register figures">
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.narrators.toLocaleString("en-GB")}</span><span class="project-showcase__label">Named transmitters</span></span>
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.narratorsDated.toLocaleString("en-GB")}</span><span class="project-showcase__label">With dates</span></span>
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.criticismStatements.toLocaleString("en-GB")}</span><span class="project-showcase__label">Source statements</span></span>
              </span>
              <span class="project-showcase__footer"><span class="project-showcase__note">No in-house reliability rating</span><span class="project-showcase__cta">Browse transmitters</span></span>
            </span>
          </a>
        </div>
        <!-- MODULE 3: SHIRK DOCUMENTATION -->
        <article
          class="module-section module-section--shirk"
          id="shirk-documentation"
          data-motion="reveal"
        >
          <div class="module-shirk__inner">
            <header class="module-shirk__header">
              <div class="module-shirk__header-main">
                <span class="module-eyebrow">03 / CRITICAL EDITION</span>
                <h3 class="module-title">
                  <a href="/research/shirk-endorsed/" class="module-title-link">
                    Shirk: Endorsed By The Scholars of Islam
                  </a>
                </h3>
                <p class="module-desc">
                  A 10-century evidentiary critical edition documenting classical Sunni consensus on Tawassul, Tashaffuʿ, and Istighāthah across 99 authorities and all four madhhabs, supported by 200+ primary manuscript scans.
                </p>
              </div>

              <!-- Evidentiary stats banner -->
              <div class="shirk-stats-strip" aria-label="Evidence metrics">
                <div class="shirk-stat">
                  <span class="shirk-stat__num">99</span>
                  <span class="shirk-stat__label">Authorities</span>
                </div>
                <div class="shirk-stat">
                  <span class="shirk-stat__num">4</span>
                  <span class="shirk-stat__label">Madhhabs</span>
                </div>
                <div class="shirk-stat">
                  <span class="shirk-stat__num">207</span>
                  <span class="shirk-stat__label">Manuscript Scans</span>
                </div>
                <div class="shirk-stat">
                  <span class="shirk-stat__num">10-Cent.</span>
                  <span class="shirk-stat__label">Historical Span</span>
                </div>
              </div>
            </header>

            <!-- Four Madhhabs Consensus Matrix -->
            <div class="shirk-matrix" aria-label="Consensus across four Sunni madhhabs">
              {madhhabs.map((m) => (
                <div class="shirk-matrix__cell">
                  <span class="shirk-matrix__school">{m.school} Madhhab</span>
                  <p class="shirk-matrix__auth">{m.authorities}</p>
                  <span class="shirk-matrix__scope">{m.scope}</span>
                </div>
              ))}
            </div>

            <div class="module-shirk__footer">
              <div class="shirk-actions">
                <a href="/research/shirk-endorsed/" class="hc-btn">
                  Read Critical Edition <span aria-hidden="true">→</span>
                </a>
                <a
                  href="/research/shirk-endorsed/ledger/"
                  class="hc-btn hc-btn--ghost"
                >
                  Open Scholar Ledger
                </a>
              </div>
            </div>
          </div>
        </article>

        <a href="/projects/academic-studies/" class="project-showcase project-showcase--studies" id="academic-studies">
          <img class="project-showcase__art" src="/images/academic-studies-art.webp" alt="" aria-hidden="true" width="1536" height="1024" loading="lazy" decoding="async" />
          <span class="project-showcase__content">
            <span class="project-showcase__eyebrow">Academic scholarship</span>
            <span class="project-showcase__heading">
              <span class="project-showcase__title">Academic Studies</span>
              <span class="project-showcase__ar" dir="rtl" lang="ar">الدراسات الأكاديمية</span>
            </span>
            <span class="project-showcase__desc">
              Explore isnād-cum-matn monographs and Harald Motzki case studies examining early transmission, textual origins, and the formation of Islamic literature.
            </span>
            <span class="project-showcase__stats" aria-label="Academic studies figures">
              <span class="project-showcase__stat"><span class="project-showcase__number">27</span><span class="project-showcase__label">Monographs</span></span>
              <span class="project-showcase__stat"><span class="project-showcase__number">17</span><span class="project-showcase__label">Motzki studies</span></span>
              <span class="project-showcase__stat"><span class="project-showcase__number">1st–3rd C.</span><span class="project-showcase__label">Termini</span></span>
            </span>
            <span class="project-showcase__footer"><span class="project-showcase__note">Monographs and case studies</span><span class="project-showcase__cta">Explore the studies</span></span>
          </span>
        </a>
      </div>
    </section>

    <!-- Collaboration CTA -->
    <section
      class="projects-cta hc-container"
      aria-labelledby="projects-cta-title"
      data-motion="reveal"
    >
      <div class="cta-panel">
        <div class="cta-panel__content">
          <p class="hc-eyebrow">Collaboration &amp; Open Archive</p>
          <h2 id="projects-cta-title" class="cta-panel__title">
            Contribute to the archive.
          </h2>
          <p class="cta-panel__copy">
            HadithCritic projects are developed for source-level research and digital humanities. If you work in Islamic manuscript studies, hadith criticism, or computational philology, collaboration is welcome.
          </p>
          <div class="cta-panel__actions">
            <a href="/contact/" class="hc-btn">Send a proposal <span aria-hidden="true">→</span></a>
            <a
              href="https://github.com/HadithCritic/HadithCriticBlog"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn hc-btn--ghost"
            >
              View GitHub repository <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector(".projects-page");

  if (page) {
    const items = [...page.querySelectorAll<HTMLElement>("[data-reveal]")];
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!reduced && "IntersectionObserver" in window) {
      items.forEach((el) => el.classList.add("will-reveal"));

      const observer = new IntersectionObserver(
        (observed) => {
          for (const entry of observed) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
      );

      items.forEach((el) => observer.observe(el));
    } else {
      items.forEach((el) => el.classList.add("is-revealed"));
    }
  }
</script>

<style>
  .projects-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 85% 10%,
        rgba(216, 177, 102, 0.06),
        transparent 30%
      ),
      radial-gradient(
        circle at 15% 40%,
        rgba(164, 106, 63, 0.07),
        transparent 28%
      ),
      linear-gradient(
        180deg,
        var(--hc-surface-0) 0%,
        var(--hc-surface-2) 40%,
        var(--hc-surface-0) 100%
      );
  }

  /* Reveal machinery */
  .will-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.75s var(--ease),
      transform 0.75s var(--ease);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .will-reveal.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Elevated Archival Hero */
  .projects-hero {
    position: relative;
    border-bottom: 1px solid var(--hc-rule);
    background:
      radial-gradient(ellipse 850px 420px at 15% 25%, rgba(216, 177, 102, 0.05) 0%, transparent 65%),
      linear-gradient(180deg, var(--hc-surface-1) 0%, var(--hc-surface-0) 100%);
    padding: clamp(3rem, 5.5vw, 4.5rem) 0 clamp(2.25rem, 4vw, 3.25rem);
    overflow: hidden;
  }

  .projects-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 90% 10%, rgba(216, 177, 102, 0.03), transparent 45%);
    pointer-events: none;
  }

  .projects-hero__inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .projects-hero__content {
    flex: 1;
    min-width: min(100%, 480px);
    max-width: 680px;
  }

  .projects-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .projects-hero__kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hc-gold);
    box-shadow: 0 0 8px var(--hc-gold);
    flex-shrink: 0;
  }

  .projects-hero__kicker {
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .projects-hero__kicker-sep {
    color: var(--hc-rule-strong);
    font-size: 0.75rem;
  }

  .projects-hero__kicker-tag {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .projects-hero__title {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 5.2vw, 3.75rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--hc-text-primary);
  }

  .projects-hero__title-accent {
    font-style: normal;
    color: var(--hc-gold);
  }

  .projects-hero__lead {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.02rem, 1.25vw, 1.15rem);
    line-height: 1.65;
    color: var(--hc-text-secondary);
    max-width: 58ch;
  }

  /* Section Header */
  .projects-modules {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .modules-head {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .modules-head__lead {
    min-width: 0;
  }

  .modules-head__title {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 3.5vw, 2.65rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--hc-text-primary);
  }

  .modules-head__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--hc-rule), transparent);
    margin-bottom: 0.5rem;
  }

  .modules-head__count {
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.83rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    margin-bottom: 0.5rem;
  }

  .modules-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  /* Common Module Card Framing */
  .module-section {
    position: relative;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 2px);
    background: linear-gradient(
      180deg,
      var(--hc-surface-1),
      var(--hc-surface-0)
    );
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.14);
    transition:
      border-color 260ms ease,
      box-shadow 260ms ease;
  }

  .module-section::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid var(--hc-rule-soft);
    pointer-events: none;
  }

  .module-section:hover {
    border-color: rgba(200, 167, 85, 0.32);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
  }

  .module-eyebrow {
    display: block;
    margin: 0 0 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-gold-soft);
  }

  .module-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.85rem, 3.8vw, 2.85rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--hc-text-primary);
  }

  .module-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .module-title-link:hover {
    color: var(--hc-gold);
  }

  .module-desc {
    margin: 0.85rem 0 0;
    color: var(--hc-text-secondary);
    font-size: clamp(1.02rem, 0.25vw + 0.98rem, 1.14rem);
    line-height: 1.72;
  }

  .module-action-row {
    margin-top: 1.8rem;
  }

  .disciplines-duo-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.5vw, 1.2rem);
    align-items: stretch;
  }

  /* -------------------------------------------------------------
     MODULE 3: SHIRK DOCUMENTATION
     ------------------------------------------------------------- */
  .module-shirk__inner {
    position: relative;
    z-index: 1;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .module-shirk__header {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .shirk-stats-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
    padding: 1rem 1.15rem;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 4px);
  }

  .shirk-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .shirk-stat__num {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 500;
    color: var(--hc-gold);
    line-height: 1.1;
  }

  .shirk-stat__label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .shirk-matrix {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  .shirk-matrix__cell {
    padding: 1rem 1.1rem;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs, 4px);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    transition: border-color 200ms ease;
  }

  .shirk-matrix__cell:hover {
    border-color: rgba(200, 167, 85, 0.35);
  }

  .shirk-matrix__school {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .shirk-matrix__auth {
    margin: 0;
    color: var(--hc-text-primary);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .shirk-matrix__scope {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
    line-height: 1.4;
    margin-top: auto;
  }

  .module-shirk__footer {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding-top: 0.5rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .shirk-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* -------------------------------------------------------------
     COLLABORATION CTA PANEL
     ------------------------------------------------------------- */
  .projects-cta {
    padding-bottom: clamp(5rem, 10vw, 8rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .cta-panel {
    position: relative;
    padding: clamp(2.25rem, 4.5vw, 3.75rem);
    border: 1px solid var(--hc-rule-strong);
    border-radius: var(--radius-xs, 2px);
    color: var(--hc-text-primary);
    background:
      radial-gradient(ellipse 600px 300px at 90% 10%, rgba(216, 177, 102, 0.08) 0%, transparent 60%),
      linear-gradient(135deg, var(--hc-surface-1), var(--hc-surface-0));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    overflow: hidden;
  }

  .cta-panel::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid var(--hc-rule-soft);
    pointer-events: none;
  }

  .cta-panel__content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .cta-panel .hc-eyebrow {
    color: var(--hc-gold);
    margin-bottom: 0.4rem;
  }

  .cta-panel__title {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.85rem, 3.4vw, 2.6rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--hc-text-primary);
  }

  .cta-panel__copy {
    margin: 0.95rem 0 0;
    color: var(--hc-text-secondary);
    font-size: clamp(0.98rem, 1.1vw, 1.08rem);
    line-height: 1.7;
    max-width: 62ch;
  }

  .cta-panel__actions {
    display: flex;
    flex-wrap: wrap;
