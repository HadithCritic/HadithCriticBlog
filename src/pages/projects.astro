---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsnadBundle from '../components/IsnadBundle.astro';

interface WorkbenchProject {
  status: string;
  statusMod: string;
  title: string;
  href?: string;
  description: string;
  meta: string[];
}

const workbench: WorkbenchProject[] = [
  {
    status: 'Coming soon',
    statusMod: 'soon',
    title: 'Silsilah Research',
    description:
      'Ongoing research notes, formal methodology, and analytical essays documenting the computational architecture and structural analysis of early hadith corpora.',
    meta: ['Methodology', 'Computational Hadith', 'Essays']
  }
];

const canonicalSix = [
  { name: 'Ṣaḥīḥ al-Bukhārī', count: '7,563' },
  { name: 'Ṣaḥīḥ Muslim', count: '7,500' },
  { name: 'Sunan Abī Dāwūd', count: '5,274' },
  { name: 'Jāmiʿ al-Tirmidhī', count: '3,956' },
  { name: 'Sunan al-Nasāʾī', count: '5,758' },
  { name: 'Sunan Ibn Mājah', count: '4,341' }
];

const earlyMusnads = [
  { name: 'Musnad Aḥmad', count: '27,647' },
  { name: 'Muwaṭṭaʾ Mālik', count: '1,858' },
  { name: 'Sunan al-Dārimī', count: '3,503' },
  { name: 'Sunan al-Dāraquṭnī', count: '4,898' },
  { name: 'Musnad al-Shāfiʿī', count: '1,800' },
  { name: 'Al-Kāfī (Early Imāmī)', count: '16,121' }
];

const madhhabs = [
  {
    school: 'Ḥanafī Madhhab',
    authorities: 'Imām Abū Ḥanīfa, al-Sarakhsī, al-Kāsānī, Ibn ʿĀbidīn',
    scope: 'Codified in classical Fatāwā and pilgrimage manuals'
  },
  {
    school: 'Mālikī Madhhab',
    authorities: 'Imām Mālik, al-Qāḍī ʿIyāḍ, al-Qarāfī, al-Zurqānī',
    scope: 'The consensus of Medina & al-Shifā bi-Taʿrīf Ḥuqūq al-Muṣṭafā'
  },
  {
    school: 'Shāfiʿī Madhhab',
    authorities: 'Imām al-Shāfiʿī, al-Nawawī, Taqī al-Dīn al-Subkī, Ibn Ḥajar',
    scope: 'Al-Majmūʿ Sharḥ al-Muhadhdhab & Shifāʾ al-Siqām'
  },
  {
    school: 'Ḥanbalī Madhhab',
    authorities: 'Imām Aḥmad b. Ḥanbal, al-Marrūdhī, Ibn Qudāmah, al-Buhūtī',
    scope: 'Al-Mughnī, Masāʾil Aḥmad, & Kashshāf al-Qināʿ'
  }
];
---

<BaseLayout
  title="Projects | HadithCritic"
  description="Ongoing research projects, digital tools, and collaborative initiatives at HadithCritic."
>
  <div class="projects-page">
    <section class="projects-hero" aria-labelledby="projects-hero-title" data-motion="hero">
      <div class="hc-container">
        <div class="hero-content">
          <h1 id="projects-hero-title" class="projects-hero__title">
            Tools for reading <span class="projects-hero__title-accent">transmission.</span>
          </h1>
          <p class="projects-hero__lead">
            Ongoing research initiatives, digital infrastructure, and collaborative tools built to examine hadith transmission, legal theory, and source history.
          </p>
        </div>
      </div>
    </section>

    <!-- Distinct Primary Research Modules -->
    <section class="projects-modules hc-container" aria-labelledby="modules-title">
      <header class="modules-head" data-motion="reveal">
        <div class="modules-head__lead">
          <p class="hc-eyebrow">Research Infrastructure</p>
          <h2 id="modules-title" class="modules-head__title">Core Research Editions & Archives</h2>
        </div>
        <span class="modules-head__rule" aria-hidden="true"></span>
        <span class="modules-head__count">4 primary initiatives</span>
      </header>

      <div class="modules-stack">
        <!-- MODULE 1: HADITH CORPUS -->
        <article class="module-section module-section--corpus" id="hadith-corpus" data-motion="reveal">
          <div class="module-corpus__grid">
            <div class="module-corpus__content">
              <span class="module-eyebrow">Searchable Corpus Edition</span>
              <h3 class="module-title">
                <a href="/hadith" class="module-title-link">Hadith Corpus</a>
              </h3>
              <p class="module-desc">
                A research edition of 276,347 narrations from 33 collections, searchable in Arabic and English, with every chain of transmission linked to the narrator register. No authenticity gradings are stored or shown: the corpus presents the attested evidence and leaves the verdict to the reader.
              </p>

              <div class="module-features">
                <div class="feature-item">
                  <span class="feature-item__title">Corpus Breadth</span>
                  <span class="feature-item__desc">276,347 narrations indexed across 33 canonical, musnad, and early sectarian collections.</span>
                </div>
                <div class="feature-item">
                  <span class="feature-item__title">Bilingual Retrieval</span>
                  <span class="feature-item__desc">Full-text search in English and normalized Arabic with diacritic and root folding.</span>
                </div>
                <div class="feature-item">
                  <span class="feature-item__title">Linked Forensics</span>
                  <span class="feature-item__desc">Every transmission strand links directly into transmitter biographical dossiers.</span>
                </div>
              </div>

              <div class="module-action-row">
                <a href="/hadith" class="hc-btn">
                  Explore Corpus <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            <!-- Redesigned Scholarly Corpus Catalogue Displayer -->
            <div class="catalogue-displayer" aria-hidden="true">
              <div class="catalogue-head">
                <div class="catalogue-head__meta">
                  <span class="catalogue-head__tag">COLLECTION INDEX</span>
                  <span class="catalogue-head__sep">/</span>
                  <span class="catalogue-head__sub">33 COMPILATIONS</span>
                </div>
                <span class="catalogue-head__stat">276,347 ATTESTED REPORTS</span>
              </div>

              <div class="catalogue-search-field">
                <span class="catalogue-search-field__icon">⌕</span>
                <span class="catalogue-search-field__text">الأعمال بالنيات / deeds are by intentions...</span>
                <span class="catalogue-search-field__badge">FTS5</span>
              </div>

              <div class="catalogue-scopes">
                <span class="scope-item scope-item--active">All Fields</span>
                <span class="scope-item">Matn</span>
                <span class="scope-item">Arabic</span>
                <span class="scope-item">Isnād</span>
              </div>

              <div class="catalogue-ledger-grid">
                <div class="ledger-column">
                  <div class="ledger-column__title">Canonical Compilations</div>
                  <ul class="ledger-list">
                    {canonicalSix.map((col) => (
                      <li class="ledger-item">
                        <span class="ledger-item__name">{col.name}</span>
                        <span class="ledger-item__leader" aria-hidden="true"></span>
                        <span class="ledger-item__val">{col.count}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="ledger-column">
                  <div class="ledger-column__title">Early Musnads & Traditions</div>
                  <ul class="ledger-list">
                    {earlyMusnads.map((col) => (
                      <li class="ledger-item">
                        <span class="ledger-item__name">{col.name}</span>
                        <span class="ledger-item__leader" aria-hidden="true"></span>
                        <span class="ledger-item__val">{col.count}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="catalogue-footer">
                <span>+ 21 additional collections • Evidence preserved without sectarian gradings</span>
              </div>
            </div>
          </div>
        </article>

        <!-- MODULE 2: NARRATOR BIOGRAPHIES -->
        <article class="module-section module-section--narrators" id="narrator-biographies" data-motion="reveal">
          <div class="module-narrators__grid">
            <!-- Left: Interactive Transmission Diagram -->
            <div class="module-narrators__diagram">
              <div class="diagram-chrome">
                <span class="diagram-chrome__tag">ISNĀD NETWORK ARCHITECTURE</span>
              </div>
              <IsnadBundle
                caption='How a "well-attested" report travels: a single strand rises from the Prophet to the common link Yahyā b. Saʿīd al-Anṣārī, then fans out to the collectors. The dashed line marks a later back-projected chain.'
                href="/narrators"
                hrefLabel="Open narrator network register"
              />
            </div>

            <!-- Right: Descriptive Prosopography Content -->
            <div class="module-narrators__content">
              <span class="module-eyebrow">Biographical Register & Rijāl Analysis</span>
              <h3 class="module-title">
                <a href="/narrators" class="module-title-link">Narrator Biographies</a>
              </h3>
              <p class="module-desc">
                A comprehensive register of 24,300+ classical hadith transmitters with biographical dossiers, Arabic calligraphy, generational status, reliability evaluations from classical rijāl critics, and interconnected teacher-student networks.
              </p>

              <!-- Facet counters -->
              <div class="narrators-metrics">
                <div class="narrator-metric">
                  <span class="narrator-metric__val">24,300+</span>
                  <span class="narrator-metric__lbl">Transmitters</span>
                </div>
                <div class="narrator-metric">
                  <span class="narrator-metric__val">14</span>
                  <span class="narrator-metric__lbl">Generations (Ṭabaqāt)</span>
                </div>
                <div class="narrator-metric">
                  <span class="narrator-metric__val">Networked</span>
                  <span class="narrator-metric__lbl">Teacher-Student</span>
                </div>
                <div class="narrator-metric">
                  <span class="narrator-metric__val">Evaluated</span>
                  <span class="narrator-metric__lbl">Rijāl Assessments</span>
                </div>
              </div>

              <div class="module-action-row">
                <a href="/narrators" class="hc-btn">
                  Browse Transmitters <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- MODULE 3: SHIRK DOCUMENTATION -->
        <article class="module-section module-section--shirk" id="shirk-documentation" data-motion="reveal">
          <div class="module-shirk__inner">
            <header class="module-shirk__header">
              <div class="module-shirk__header-main">
                <span class="module-eyebrow">Evidentiary Critical Edition</span>
                <h3 class="module-title">
                  <a href="/research/shirk-endorsed" class="module-title-link">
                    Shirk: Endorsed By The Scholars of Islam
                  </a>
                </h3>
                <p class="module-desc">
                  A 10-century evidentiary critical edition documenting the classical Sunni scholarly consensus on Tawassul, Tashaffuʿ, and Istighāthah across 99 major authorities and all four madhhab founders, supported by 200+ primary manuscript scans.
                </p>
              </div>

              <!-- Evidentiary stats banner -->
              <div class="shirk-stats-strip">
                <div class="shirk-stat">
                  <span class="shirk-stat__num">99</span>
                  <span class="shirk-stat__label">Classical Authorities</span>
                </div>
                <div class="shirk-stat">
                  <span class="shirk-stat__num">4</span>
                  <span class="shirk-stat__label">Sunni Madhhabs</span>
                </div>
                <div class="shirk-stat">
                  <span class="shirk-stat__num">207</span>
                  <span class="shirk-stat__label">Manuscript Scans</span>
                </div>
                <div class="shirk-stat">
                  <span class="shirk-stat__num">10-Cent.</span>
                  <span class="shirk-stat__label">Historical Span</span>
                </div>
              </div>
            </header>

            <!-- Four Madhhabs Consensus Matrix -->
            <div class="shirk-matrix" aria-label="Consensus across four madhhabs">
              {madhhabs.map((m) => (
                <div class="shirk-matrix__cell">
                  <span class="shirk-matrix__school">{m.school}</span>
                  <p class="shirk-matrix__auth">{m.authorities}</p>
                  <span class="shirk-matrix__scope">{m.scope}</span>
                </div>
              ))}
            </div>

            <div class="module-shirk__footer">
              <div class="shirk-actions">
                <a href="/research/shirk-endorsed" class="hc-btn">
                  Read Critical Edition <span aria-hidden="true">→</span>
                </a>
                <a href="/research/shirk-endorsed/ledger" class="hc-btn hc-btn--ghost">
                  Open Scholar Ledger
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- MODULE 4: ACADEMIC STUDIES & ICMA MONOGRAPHS -->
        <article class="module-section module-section--icma" id="academic-studies" data-motion="reveal">
          <div class="module-icma__grid">
            <div class="module-icma__content">
              <span class="module-eyebrow">Archival Monograph Register & Critical Apparatus</span>
              <h3 class="module-title">
                <a href="/projects/academic-studies" class="module-title-link">
                  Academic Studies & ICMA Monographs
                </a>
              </h3>
              <p class="module-desc">
                A specialized research repository of 27 isnād-cum-matn monographs, transmission chronology frameworks, and the complete 17-part Harald Motzki case study corpus—correlating isnād pathways with textual matn variants to reconstruct the historical horizon of early hadith literature.
              </p>

              <div class="module-features">
                <div class="feature-item">
                  <span class="feature-item__title">27 ICMA Monographs</span>
                  <span class="feature-item__desc">Detailed critical registers indexing traditions, common links, and dating termini across the early Islamic centuries.</span>
                </div>
                <div class="feature-item">
                  <span class="feature-item__title">Motzki Case Studies</span>
                  <span class="feature-item__desc">17-part corpus of Harald Motzki’s foundational source-reconstruction studies from Brill and academic research presses.</span>
                </div>
                <div class="feature-item">
                  <span class="feature-item__title">Critical Forensics</span>
                  <span class="feature-item__desc">Systematic isnād-matn analysis separating genuine historical transmission nodes from later back-projected strands.</span>
                </div>
              </div>

              <div class="module-action-row">
                <a href="/projects/academic-studies" class="hc-btn">
                  Explore Academic Studies <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            <!-- Archival Register Preview Displayer -->
            <div class="icma-preview-card" aria-hidden="true">
              <div class="icma-preview-card__header">
                <div class="icma-preview-card__accession">
                  <span class="icma-preview-card__tag">ICMA ARCHIVE</span>
                  <span class="icma-preview-card__sep">/</span>
                  <span class="icma-preview-card__ref">REGISTER DOSSIER</span>
                </div>
                <span class="icma-preview-card__count">27 STUDIES · 17 MOTZKI</span>
              </div>

              <div class="icma-preview-card__study">
                <div class="icma-preview-card__meta">
                  <span class="icma-preview-card__code">ICMA-01 · MONOGRAPH</span>
                  <span class="icma-preview-card__dating">Terminus: c. 86–96 AH</span>
                </div>
                <h4 class="icma-preview-card__title">The White Minaret Hadith & the Damascus Descent</h4>
                <p class="icma-preview-card__abstract">
                  Correlating regional Syrian isnād variants through Nuʿaym b. Ḥammād with the Umayyad architectural chronology of the Damascus Great Mosque's eastern minaret under al-Walīd I.
                </p>
              </div>

              <div class="icma-preview-card__dossier">
                <div class="icma-preview-dossier-item">
                  <span class="icma-preview-dossier-lbl">Tradition</span>
                  <span class="icma-preview-dossier-val">Descent of Jesus at the White Minaret</span>
                </div>
                <div class="icma-preview-dossier-item">
                  <span class="icma-preview-dossier-lbl">Common Link</span>
                  <span class="icma-preview-dossier-val">Nuʿaym b. Ḥammād / Syrian Authorities</span>
                </div>
                <div class="icma-preview-dossier-item">
                  <span class="icma-preview-dossier-lbl">Apparatus</span>
                  <span class="icma-preview-dossier-val">Syrian regional isnād axis · Architectural terminus post quem</span>
                </div>
              </div>

              <div class="icma-preview-card__footer">
                <span class="icma-preview-card__footer-tag">HARALD MOTZKI CORPUS INCLUDED</span>
                <span class="icma-preview-card__footer-stat">17 CASE STUDIES</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- The Workbench (Coming Soon items) -->
    <section class="projects-worklist hc-container" aria-labelledby="worklist-title">
      <header class="worklist-head" data-motion="reveal">
        <div>
          <p class="hc-eyebrow">Forthcoming Initiatives</p>
          <h2 id="worklist-title" class="worklist-head__title">The workbench.</h2>
        </div>
        <span class="worklist-head__rule" aria-hidden="true"></span>
        <span class="worklist-head__count">{workbench.length} in development</span>
      </header>

      <div class="worklist" role="list">
        {workbench.map((project) => (
          <article class="work-row" role="listitem" data-motion-row>
            <div class="work-row__status">
              <span class:list={['project-chip', `project-chip--${project.statusMod}`]}>
                {project.status}
              </span>
            </div>
            <div class="work-row__main">
              <h3 class="work-row__title">
                {project.href ? (
                  <a href={project.href} class="module-title-link">
                    {project.title} <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  project.title
                )}
              </h3>
              <p class="work-row__desc">{project.description}</p>
            </div>
            <div class="work-row__tags" aria-label={`${project.title} keywords`}>
              {project.meta.map((tag) => (
                <span class="work-row__tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Collaboration CTA -->
    <section class="projects-cta hc-container" aria-labelledby="projects-cta-title" data-motion="reveal">
      <div class="cta-panel">
        <div class="cta-panel__content">
          <p class="hc-eyebrow">Collaboration</p>
          <h2 id="projects-cta-title" class="cta-panel__title">Contribute to the archive.</h2>
          <p class="cta-panel__copy">
            HadithCritic projects are developed for source-level research. If you work in Islamic
            manuscript studies, digital humanities, or hadith criticism, collaboration is welcome.
          </p>
          <div class="cta-panel__actions">
            <a href="/contact" class="hc-btn">Send a proposal</a>
            <a href="https://github.com/HadithCritic/HadithCriticBlog" target="_blank" rel="noopener noreferrer" class="hc-btn hc-btn--ghost">
              View the code
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector('.projects-page');

  if (page) {
    const items = [...page.querySelectorAll<HTMLElement>('[data-reveal]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced && 'IntersectionObserver' in window) {
      items.forEach((el) => el.classList.add('will-reveal'));

      const observer = new IntersectionObserver(
        (observed) => {
          for (const entry of observed) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      items.forEach((el) => observer.observe(el));
    } else {
      items.forEach((el) => el.classList.add('is-revealed'));
    }
  }
</script>

<style>
  .projects-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 85% 10%, rgba(216, 177, 102, 0.06), transparent 30%),
      radial-gradient(circle at 15% 40%, rgba(164, 106, 63, 0.07), transparent 28%),
      linear-gradient(180deg, var(--hc-surface-0) 0%, var(--hc-surface-2) 40%, var(--hc-surface-0) 100%);
  }

  /* Reveal machinery */

  .will-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.75s var(--ease),
      transform 0.75s var(--ease);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .will-reveal.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hero */

  .projects-hero {
    border-bottom: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
    background: radial-gradient(ellipse 700px 350px at 20% 30%, rgba(200, 167, 85, 0.04) 0%, transparent 70%);
    padding: clamp(3rem, 6vw, 4.5rem) 0 clamp(2rem, 3.5vw, 2.75rem);
  }

  .hero-content {
    max-width: 680px;
  }

  .projects-hero__title {
    margin: 0 0 0.85rem;
    font-family: var(--font-display, serif);
    font-size: clamp(2.21rem, 5.5vw, 3.82rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--hc-text-primary, #f5f2eb);
  }

  .projects-hero__title-accent {
    font-style: italic;
    color: var(--hc-gold, #c8a755);
  }

  .projects-hero__lead {
    margin: 0;
    font-family: var(--font-body, serif);
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    line-height: 1.65;
    color: var(--hc-text-secondary, #b5b0a5);
    max-width: 56ch;
  }

  /* Section Header */

  .projects-modules {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .modules-head {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .modules-head__lead {
    min-width: 0;
  }

  .modules-head__title {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 3.5vw, 2.65rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--hc-text-primary);
  }

  .modules-head__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--hc-rule), transparent);
    margin-bottom: 0.5rem;
  }

  .modules-head__count {
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.83rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    margin-bottom: 0.5rem;
  }

  .modules-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  /* Common Module Card Framing */

  .module-section {
    position: relative;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 2px);
    background: linear-gradient(180deg, var(--hc-surface-1), var(--hc-surface-0));
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.14);
    transition: border-color 260ms ease, box-shadow 260ms ease;
  }

  .module-section::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid var(--hc-rule-soft);
    pointer-events: none;
  }

  .module-section:hover {
    border-color: rgba(200, 167, 85, 0.32);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
  }

  .module-eyebrow {
    display: block;
    margin: 0 0 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-gold-soft);
  }

  .module-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.85rem, 3.8vw, 2.85rem);
