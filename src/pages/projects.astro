---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { OG } from "../lib/seo";
import { CORPUS_META } from "../lib/corpus-config";
import qiraatIndex from "../data/qiraat/index.json";
import { historySources, openReaders } from "../data/history";
import { formatCount, surahHref, surahs as tafsirSurahs, works as tafsirWorks } from "../data/tafsir";
import "../styles/home.css";
import "../styles/home-platform.css";
import "../styles/projects.css";

/* Every figure on this page is read from the data the project is built from. */
const n = (value: number) => value.toLocaleString("en-US");
const historyWords = openReaders.reduce((sum, item) => sum + item.reader.words, 0);
const corpus = CORPUS_META.counts;
const rulesCount = (qiraatIndex as { rules?: { rules?: number } }).rules?.rules ?? 0;

interface Entry {
  label: string;
  href: string;
}

interface Project {
  id: string;
  href: string;
  art?: string;
  kind: string;
  arabic?: string;
  title: string;
  desc: string;
  figures: string[];
  entries: Entry[];
  action: string;
  status: string;
}

const tafsirCovered = tafsirSurahs.filter((s) => s.works.length > 0);
const tafsirWords = tafsirWorks.reduce((sum, w) => sum + w.words, 0);

const lead: Project = {
  id: "hadith-corpus",
  href: "/hadith/",
  art: "corpus",
  kind: "Textual corpus",
  arabic: "الحديث",
  title: "Hadith Corpus",
  desc: "Narrations in facing Arabic and English, searchable across every compilation by matn, isnād or topic, with each chain linked to its transmitters in the Rijāl Register. No authenticity grade is added.",
  figures: [`${n(corpus.hadith)} narrations`, `${corpus.collections} collections`, `${n(corpus.chainLinks)} chain links`],
  entries: [
    { label: "Search the narrations", href: "/hadith/" },
    { label: "Browse the collections", href: "/hadith/#collections-heading" },
    { label: "Open Ṣaḥīḥ al-Bukhārī", href: "/hadith/collection/sahih-al-bukhari/" },
  ],
  action: "Search the corpus",
  status: "Live",
};

const databases: Project[] = [
  {
    id: "narrator-biographies",
    href: "/narrators/",
    art: "rijal",
    kind: "Biographical register",
    arabic: "الرجال",
    title: "Rijāl Register",
    desc: "Classical transmitters with dates, teachers and students, and every critic’s statement attributed to the critic who made it.",
    figures: [`${n(corpus.narrators)} transmitters`, `${n(corpus.criticismStatements)} statements`],
    entries: [
      { label: "Browse the register", href: "/narrators/" },
      { label: "Compare two transmitters", href: "/narrators/compare/" },
    ],
    action: "Browse the register",
    status: "Live",
  },
  {
    id: "quran-textual-variants",
    href: "/projects/quran/",
    art: "qiraat",
    kind: "Variant readings",
    arabic: "القراءات",
    title: "The Qirāʾāt Variants",
    desc: "The ten readings set side by side, word by word, with the classical books that report each one and the page each quotation comes from.",
    figures: ["10 readers", `${qiraatIndex.suras_with_data} of 114 suras`, `${rulesCount} general rules`],
    entries: [
      { label: "The ten readers", href: "/projects/quran/#readers" },
      { label: "Sura register", href: "/projects/quran/#suras" },
      { label: "General rules", href: "/projects/quran/rules/" },
      { label: "Transmission", href: "/projects/quran/transmission/" },
    ],
    action: "Compare the readings",
    status: "Readings await human review",
  },
  {
    id: "tafsir",
    href: "/projects/tafsir/",
    art: "tafsir",
    kind: "Qur'anic commentary",
    arabic: "التفسير",
    title: "Tafsīr",
    desc: "Read al-Ṭabarī on al-Fātiḥa one verse at a time, with the Qur’anic text, his commentary, transmitted reports and editor’s notes together on the page.",
    figures: [`${tafsirWorks.length} commentary`, `${tafsirCovered.length} approved surah`, `${formatCount(tafsirWords)} words`],
    entries: [
      ...(tafsirCovered[0] ? [{ label: `Read al-Fātiḥa`, href: surahHref(tafsirCovered[0]) }] : []),
    ],
    action: "Open the commentary",
    status: "Available to read",
  },
];

const history: Project = {
  id: "history-library",
  href: "/projects/history/",
  art: "history-archive-v2",
  kind: "Historical source library",
  arabic: "التاريخ",
  title: "History (Tārīkh)",
  desc: "The earliest Arabic histories of Islam in English: chronicles, conquest narratives and genealogies, each in its own reader with the chapters beside the text.",
  figures: [`${openReaders.length} of ${historySources.length} books open`, `${(historyWords / 1e6).toFixed(1)}M words`, "207–310 AH"],
  entries: [
    { label: "The source library", href: "/projects/history/#sources" },
    { label: "Read Khalīfa ibn Khayyāṭ’s chronicle", href: "/projects/history/khalifa/" },
    { label: "Read the Conquests of the Lands", href: "/projects/history/futuh-al-buldan/" },
  ],
  action: "Open the history library",
  status: "Live",
};

const projects = [...databases, history];
const all = [lead, ...projects];
const countWord = ["One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight"][all.length - 1] ?? String(all.length);
---

<BaseLayout
  image={OG.projects}
  title="Projects | HadithCritic"
  description="HadithCritic's research tools: a hadith corpus, a rijāl register, the qirāʾāt variants, al-Ṭabarī's tafsīr and History (Tārīkh)."
>
  <div class="hc-page home pj-page">
    <PageHero
      title="Research tools"
      accent="and registers."
      titleId="pj-title"
      kicker="Projects"
      art="/images/editorial/projects-hero.webp"
      focus="72% center"
      measure="11ch"
    >
      <p class="hc-hero__lede">
        Research tools for the hadith, its transmitters, the Qur’an’s variant readings and commentary, early history and
        modern scholarship. Every figure here is counted from the project's own data.
      </p>
      <Fragment slot="actions">
        <a href="#projects" class="hc-btn">See the projects</a>
        <a href="#contribute" class="hc-btn hc-btn--ghost">Contribute</a>
      </Fragment>
      <Fragment slot="register">
        <span><strong>{all.length}</strong> projects</span>
        <span><strong>{n(corpus.hadith)}</strong> narrations</span>
        <span><strong>{n(corpus.narrators)}</strong> transmitters</span>
      </Fragment>
    </PageHero>

    <!-- One row per project, as the homepage sets its research tools: the
         copy beside the engraving that heads the project's own page. -->
    <section class="home-section home-platform pj-showcase" id="projects" aria-labelledby="projects-title">
      <div class="hc-container">
        <header class="home-head">
          <p class="home-kicker">The projects</p>
          <h2 id="projects-title" class="home-title">{countWord} projects,<br />one archive.</h2>
          <p class="home-head__lede">
            Each runs in your browser from published data files, with no server between you and the sources.
          </p>
        </header>

        <div class="showcase">
          {all.map((project, index) => (
            <article class:list={["showcase__row", "pj-row", index % 2 === 1 && "showcase__row--flip"]} id={project.id}>
              <div class="showcase__copy">
                <p class="showcase__kicker">{String(index + 1).padStart(2, "0")} / {project.kind}</p>
                <h3><a class="pj-row__title" href={project.href}>{project.title}</a></h3>
                {project.arabic && <p class="pj-row__ar" lang="ar" dir="rtl">{project.arabic}</p>}
                <p>{project.desc}</p>
                <ul class="pj-row__figures">{project.figures.map((figure) => <li>{figure}</li>)}</ul>
                <nav class="pj-row__entries" aria-label={`Inside ${project.title}`}>
                  <ul>{project.entries.map((entry) => <li><a href={entry.href}>{entry.label} <span aria-hidden="true">→</span></a></li>)}</ul>
                </nav>
                <a href={project.href} class="showcase__link">{project.action} <span aria-hidden="true">→</span></a>
              </div>
              <a class="showcase__visual pj-plate" href={project.href} tabindex="-1" aria-hidden="true">
                <img
                  src={`/images/platform/${project.art}.webp`}
                  srcset={`/images/platform/${project.art}-1086.webp 1086w, /images/platform/${project.art}.webp 2172w`}
                  sizes="(max-width: 860px) 100vw, 58vw"
                  alt=""
                  width="2172"
                  height="724"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="pj-plate__status">{project.status}</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hc-band pj-closing" id="contribute" aria-labelledby="pj-closing-title">
      <div class="hc-container">
        <div class="hc-closing hc-parchment">
          <figure class="hc-closing__plate" style="--plate-focus: 70% center">
            <img src="/images/editorial/projects-hero-1086.webp" alt="" width="1086" height="362" loading="lazy" decoding="async" />
          </figure>
          <div class="hc-closing__copy">
            <h2 id="pj-closing-title" class="hc-closing__title">Contribute to the projects.</h2>
            <p class="hc-closing__lead">
              The projects are developed for source-level research and digital humanities. If you work in
              Islamic manuscript studies, hadith criticism or computational philology, collaboration is welcome.
            </p>
          </div>
          <div class="hc-closing__actions">
            <a href="/contact/?topic=Collaboration#contact-form" class="hc-ink-btn">Propose a collaboration <span aria-hidden="true">→</span></a>
            <a href="https://github.com/HadithCritic/HadithCriticBlog" target="_blank" rel="noopener noreferrer" class="hc-ink-btn hc-ink-btn--ghost">Source on GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
