---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CORPUS_META } from "../lib/corpus-config";
import "../styles/project-showcase.css";

const corpusStats = CORPUS_META.counts;

/* Titles match the project cards below; each row jumps to its card. */
const index = [
  { title: "Hadith Corpus", kind: "Corpus", href: "#hadith-corpus" },
  { title: "Rijāl Register", kind: "Register", href: "#narrator-biographies" },
  { title: "Quran", kind: "Variants", href: "#quran-textual-variants" },
  { title: "Academic Studies", kind: "Studies", href: "#academic-studies" },
  { title: "Shirk: Endorsed by the Scholars of Islam", kind: "Edition", href: "#shirk-documentation" },
];
---

<BaseLayout
  title="Projects | HadithCritic"
  description="Ongoing research projects, digital tools, and collaborative initiatives at HadithCritic."
>
  <div class="projects-page">
    <header
      class="hc-masthead"
      aria-labelledby="projects-hero-title"
      data-motion="hero"
    >
      <div class="hc-container hc-masthead__inner">
        <div>
          <p class="hc-eyebrow">Digital infrastructure</p>
          <h1 id="projects-hero-title" class="hc-masthead__title">Tools for Reading Transmission</h1>
          <p class="hc-masthead__lead">
            Ongoing research initiatives, digital infrastructure, and collaborative analytical tools built to examine hadith transmission, legal theory, and source history.
          </p>
        </div>

        <aside class="hc-instrument pj-register" aria-label="Projects at a glance">
          <div class="hc-instrument__well">
            <dl class="hc-instrument__plate pj-register__plate">
              <div class="pj-register__figure">
                <dt class="pj-register__label">Narrations</dt>
                <dd class="hc-instrument__figure pj-register__num">{corpusStats.hadith.toLocaleString("en-US")}</dd>
              </div>
              <div class="pj-register__figure">
                <dt class="pj-register__label">Named transmitters</dt>
                <dd class="hc-instrument__figure pj-register__num">{corpusStats.narrators.toLocaleString("en-US")}</dd>
              </div>
            </dl>

            <p class="hc-instrument__cap" id="pj-register-cap">Jump to a project</p>
            <ol class="pj-register__rows" aria-labelledby="pj-register-cap">
              {index.map((entry, position) => (
                <li>
                  <a class="pj-register__row" href={entry.href}>
                    <span class="pj-register__no" aria-hidden="true">{String(position + 1).padStart(2, "0")}</span>
                    <span class="pj-register__title">{entry.title}</span>
                    <span class="pj-register__kind">{entry.kind}</span>
                    <span class="pj-register__go" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      </div>
    </header>

    <!-- Distinct Primary Research Modules -->
    <section
      class="projects-modules hc-container"
      aria-labelledby="modules-title"
    >
      <header class="modules-head" data-motion="reveal">
        <div class="modules-head__lead">
          <p class="hc-eyebrow">Research Infrastructure</p>
          <h2 id="modules-title" class="modules-head__title">
            Core Research Editions & Archives
          </h2>
        </div>
        <span class="modules-head__rule" aria-hidden="true"></span>
        <span class="modules-head__count">5 primary initiatives</span>
      </header>

      <div class="modules-stack">
        <div class="disciplines-duo-row">
          <a href="/hadith/" class="project-showcase" id="hadith-corpus">
            <img class="project-showcase__art" src="/images/hadith-corpus-art.webp" alt="" aria-hidden="true" width="1536" height="1024" loading="lazy" decoding="async" />
            <span class="project-showcase__content">
              <span class="project-showcase__eyebrow">Textual corpus</span>
              <span class="project-showcase__heading">
                <span class="project-showcase__title">Hadith Corpus</span>
                <span class="project-showcase__ar" dir="rtl" lang="ar">المكنز الحديثي الشامل</span>
              </span>
              <span class="project-showcase__desc">
                Search {corpusStats.hadith.toLocaleString("en-GB")} narrations across {corpusStats.collections} collections. Read Arabic and English texts alongside their linked transmission chains.
              </span>
              <span class="project-showcase__stats" aria-label="Hadith corpus figures">
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.hadith.toLocaleString("en-GB")}</span><span class="project-showcase__label">Narrations</span></span>
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.collections}</span><span class="project-showcase__label">Collections</span></span>
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.chainLinks.toLocaleString("en-GB")}</span><span class="project-showcase__label">Chain links</span></span>
              </span>
              <span class="project-showcase__footer"><span class="project-showcase__note">Arabic and English search</span><span class="project-showcase__cta">Search the corpus</span></span>
            </span>
          </a>

          <a href="/narrators/" class="project-showcase project-showcase--rijal" id="narrator-biographies">
            <img class="project-showcase__art" src="/images/rijal-register-art.webp" alt="" aria-hidden="true" width="1672" height="941" loading="lazy" decoding="async" />
            <span class="project-showcase__content">
              <span class="project-showcase__eyebrow">Biographical register</span>
              <span class="project-showcase__heading">
                <span class="project-showcase__title">Rijāl Register</span>
                <span class="project-showcase__ar" dir="rtl" lang="ar">طبقات الرواة والرجال</span>
              </span>
              <span class="project-showcase__desc">
                Trace named transmitters through teacher and student links. Consult biographical records and criticism attributed to classical sources.
              </span>
              <span class="project-showcase__stats" aria-label="Transmitter register figures">
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.narrators.toLocaleString("en-GB")}</span><span class="project-showcase__label">Named transmitters</span></span>
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.narratorsDated.toLocaleString("en-GB")}</span><span class="project-showcase__label">With dates</span></span>
                <span class="project-showcase__stat"><span class="project-showcase__number">{corpusStats.criticismStatements.toLocaleString("en-GB")}</span><span class="project-showcase__label">Source statements</span></span>
              </span>
              <span class="project-showcase__footer"><span class="project-showcase__note">No in-house reliability rating</span><span class="project-showcase__cta">Browse transmitters</span></span>
            </span>
          </a>
        </div>
        <div class="disciplines-duo-row">
        <a href="/projects/quran/" class="project-showcase" id="quran-textual-variants">
          <img class="project-showcase__art" src="/images/quran-variants-art-v2.webp" alt="" aria-hidden="true" width="1672" height="941" loading="lazy" decoding="async" />
          <span class="project-showcase__content">
            <span class="project-showcase__eyebrow">Textual documentation</span>
            <span class="project-showcase__heading">
              <span class="project-showcase__title">Quran</span>
              <span class="project-showcase__ar" dir="rtl" lang="ar">القرآن</span>
            </span>
            <span class="project-showcase__desc">
              Documented cases of variant Quranic wording, readings, and other textual differences, with the sources and context for each case.
            </span>
            <span class="project-showcase__stats" aria-label="Quran project scope">
              <span class="project-showcase__stat"><span class="project-showcase__number">Text</span><span class="project-showcase__label">Word variants</span></span>
              <span class="project-showcase__stat"><span class="project-showcase__number">Readings</span><span class="project-showcase__label">Qirāʾāt</span></span>
              <span class="project-showcase__stat"><span class="project-showcase__number">Sources</span><span class="project-showcase__label">Case records</span></span>
            </span>
            <span class="project-showcase__footer"><span class="project-showcase__note">Source-based textual cases</span><span class="project-showcase__cta">Explore Quran cases</span></span>
          </span>
        </a>
        <a href="/projects/academic-studies/" class="project-showcase" id="academic-studies">
          <img class="project-showcase__art" src="/images/academic-studies-art.webp" alt="" aria-hidden="true" width="1536" height="1024" loading="lazy" decoding="async" />
          <span class="project-showcase__content">
            <span class="project-showcase__eyebrow">Academic scholarship</span>
            <span class="project-showcase__heading">
              <span class="project-showcase__title">Academic Studies</span>
              <span class="project-showcase__ar" dir="rtl" lang="ar">الدراسات الأكاديمية</span>
            </span>
            <span class="project-showcase__desc">
              Explore isnād-cum-matn monographs and Harald Motzki case studies examining early transmission, textual origins, and the formation of Islamic literature.
            </span>
            <span class="project-showcase__stats" aria-label="Academic studies figures">
              <span class="project-showcase__stat"><span class="project-showcase__number">27</span><span class="project-showcase__label">Monographs</span></span>
              <span class="project-showcase__stat"><span class="project-showcase__number">17</span><span class="project-showcase__label">Motzki studies</span></span>
              <span class="project-showcase__stat"><span class="project-showcase__number">1st–3rd C.</span><span class="project-showcase__label">Termini</span></span>
            </span>
            <span class="project-showcase__footer"><span class="project-showcase__note">Monographs and case studies</span><span class="project-showcase__cta">Explore the studies</span></span>
          </span>
        </a>
        </div>
        <a href="/research/shirk-endorsed/" class="project-showcase project-showcase--studies" id="shirk-documentation">
          <img class="project-showcase__art" src="/images/shirk-edition-art.webp" alt="" aria-hidden="true" width="1536" height="1024" loading="lazy" decoding="async" />
          <span class="project-showcase__content">
            <span class="project-showcase__eyebrow">Critical edition</span>
            <span class="project-showcase__heading">
              <span class="project-showcase__title">Shirk: Endorsed by the Scholars of Islam</span>
              <span class="project-showcase__ar" dir="rtl" lang="ar">&#1606;&#1602;&#1608;&#1604; &#1575;&#1604;&#1593;&#1604;&#1605;&#1575;&#1569; &#1601;&#1610; &#1575;&#1604;&#1578;&#1608;&#1587;&#1604; &#1608;&#1575;&#1604;&#1575;&#1587;&#1578;&#1594;&#1575;&#1579;&#1577;</span>
            </span>
            <span class="project-showcase__desc">
              Explore classical Sunni source material on tawassul, intercession, and istigh&#257;thah, gathered across four legal schools and supported by primary manuscript scans.
            </span>
            <span class="project-showcase__stats" aria-label="Critical edition figures">
              <span class="project-showcase__stat"><span class="project-showcase__number">99</span><span class="project-showcase__label">Authorities</span></span>
              <span class="project-showcase__stat"><span class="project-showcase__number">4</span><span class="project-showcase__label">Legal schools</span></span>
              <span class="project-showcase__stat"><span class="project-showcase__number">207</span><span class="project-showcase__label">Manuscript scans</span></span>
            </span>
            <span class="project-showcase__footer"><span class="project-showcase__note">Ten centuries of source material</span><span class="project-showcase__cta">Read the critical edition</span></span>
          </span>
        </a>

      </div>
    </section>

    <!-- Collaboration CTA -->
    <section
      class="projects-cta hc-container"
      aria-labelledby="projects-cta-title"
      data-motion="reveal"
    >
      <div class="cta-panel">
        <div class="cta-panel__content">
          <p class="hc-eyebrow">Collaboration &amp; Open Archive</p>
          <h2 id="projects-cta-title" class="cta-panel__title">
            Contribute to the archive.
          </h2>
          <p class="cta-panel__copy">
            HadithCritic projects are developed for source-level research and digital humanities. If you work in Islamic manuscript studies, hadith criticism, or computational philology, collaboration is welcome.
          </p>
          <div class="cta-panel__actions">
            <a href="/contact/" class="hc-btn">Send a proposal <span aria-hidden="true">→</span></a>
            <a
              href="https://github.com/HadithCritic/HadithCriticBlog"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn hc-btn--ghost"
            >
              View GitHub repository <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector(".projects-page");

  if (page) {
    const items = [...page.querySelectorAll<HTMLElement>("[data-reveal]")];
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!reduced && "IntersectionObserver" in window) {
      items.forEach((el) => el.classList.add("will-reveal"));

      const observer = new IntersectionObserver(
        (observed) => {
          for (const entry of observed) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
      );

      items.forEach((el) => observer.observe(el));
    } else {
      items.forEach((el) => el.classList.add("is-revealed"));
    }
  }
</script>

<style>
  .projects-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 85% 10%,
        rgba(216, 177, 102, 0.06),
        transparent 30%
      ),
      radial-gradient(
        circle at 15% 40%,
        rgba(164, 106, 63, 0.07),
        transparent 28%
      ),
      linear-gradient(
        180deg,
        var(--hc-surface-0) 0%,
        var(--hc-surface-2) 40%,
        var(--hc-surface-0) 100%
      );
  }

  /* Reveal machinery */
  .will-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.75s var(--ease),
      transform 0.75s var(--ease);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .will-reveal.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hero: register of works. Shell (masthead, tray, well, plate) is shared in global.css. */
  .pj-register__plate {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 1.1rem 0;
  }

  .pj-register__figure {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.7rem;
    margin: 0;
    padding: 0 1.25rem;
  }

  .pj-register__figure + .pj-register__figure {
    border-left: 1px dashed rgba(26, 23, 21, 0.4);
  }

  .pj-register__label {
    font: 700 0.81rem/1.35 var(--font-ui);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pj-register__num {
    margin: 0;
    font-size: clamp(1.9rem, 3.2vw, 2.4rem);
  }

  .pj-register__rows {
    margin: 0;
    padding: 0 0.4rem 0.4rem;
    list-style: none;
  }

  .pj-register__rows li + li {
    border-top: 1px solid var(--hc-rule-soft);
  }

  .pj-register__row {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.9rem;
    min-height: 44px;
    padding: 0.75rem 0.6rem;
    margin-inline: -0.6rem;
    color: inherit;
    text-decoration: none;
    transition:
      background var(--motion-base) var(--ease-standard),
      box-shadow var(--motion-base) var(--ease-standard);
  }

  .pj-register__row:hover {
    background: rgba(216, 177, 102, 0.08);
    box-shadow: inset 2px 0 0 var(--hc-gold-dim);
  }

  .pj-register__no {
    color: var(--hc-gold-dim);
    font: 500 0.95rem var(--font-display);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .pj-register__title {
    color: var(--hc-text-primary);
    font: 600 1.02rem/1.35 var(--font-display);
    letter-spacing: -0.015em;
  }

  .pj-register__kind {
    color: var(--hc-text-tertiary);
    font: 700 0.75rem/1 var(--font-ui);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pj-register__go {
    color: var(--hc-gold-dim);
    transition:
      transform var(--motion-base) var(--ease-standard),
      color var(--motion-base) ease;
  }

  .pj-register__row:hover .pj-register__go {
    color: var(--hc-gold);
    transform: translateX(3px);
  }

  @media (max-width: 460px) {
    .pj-register__plate {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1rem;
    }

    .pj-register__figure + .pj-register__figure {
      padding-top: 1rem;
      border-top: 1px dashed rgba(26, 23, 21, 0.4);
      border-left: 0;
    }

    .pj-register__kind {
      display: none;
    }

    .pj-register__row {
      grid-template-columns: 1.8rem minmax(0, 1fr) auto;
    }
  }

  /* Section Header */
  .projects-modules {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .modules-head {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .modules-head__lead {
    min-width: 0;
  }

  .modules-head__title {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 3.5vw, 2.65rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--hc-text-primary);
  }

  .modules-head__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--hc-rule), transparent);
    margin-bottom: 0.5rem;
  }

  .modules-head__count {
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.83rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    margin-bottom: 0.5rem;
  }

  .modules-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  /* Common Module Card Framing */
  .module-section {
    position: relative;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 2px);
    background: linear-gradient(
      180deg,
      var(--hc-surface-1),
      var(--hc-surface-0)
    );
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.14);
    transition:
      border-color 260ms ease,
      box-shadow 260ms ease;
  }

  .module-section::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid var(--hc-rule-soft);
    pointer-events: none;
  }

  .module-section:hover {
    border-color: rgba(200, 167, 85, 0.32);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
  }

  .module-eyebrow {
    display: block;
    margin: 0 0 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-gold-soft);
  }

  .module-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.85rem, 3.8vw, 2.85rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--hc-text-primary);
  }

  .module-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .module-title-link:hover {
    color: var(--hc-gold);
  }

  .module-desc {
    margin: 0.85rem 0 0;
    color: var(--hc-text-secondary);
    font-size: clamp(1.02rem, 0.25vw + 0.98rem, 1.14rem);
    line-height: 1.72;
  }

  .module-action-row {
    margin-top: 1.8rem;
  }

  .disciplines-duo-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.5vw, 1.2rem);
    align-items: stretch;
  }

  /* -------------------------------------------------------------
     COLLABORATION CTA PANEL
     ------------------------------------------------------------- */
  .projects-cta {
    padding-bottom: clamp(5rem, 10vw, 8rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .cta-panel {
    position: relative;
    padding: clamp(2.25rem, 4.5vw, 3.75rem);
    border: 1px solid var(--hc-rule-strong);
    border-radius: var(--radius-xs, 2px);
    color: var(--hc-text-primary);
    background:
      radial-gradient(ellipse 600px 300px at 90% 10%, rgba(216, 177, 102, 0.08) 0%, transparent 60%),
      linear-gradient(135deg, var(--hc-surface-1), var(--hc-surface-0));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    overflow: hidden;
  }

  .cta-panel::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid var(--hc-rule-soft);
    pointer-events: none;
  }

  .cta-panel__content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .cta-panel .hc-eyebrow {
    color: var(--hc-gold);
    margin-bottom: 0.4rem;
  }

  .cta-panel__title {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.85rem, 3.4vw, 2.6rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--hc-text-primary);
  }

  .cta-panel__copy {
    margin: 0.95rem 0 0;
    color: var(--hc-text-secondary);
    font-size: clamp(0.98rem, 1.1vw, 1.08rem);
    line-height: 1.7;
    max-width: 62ch;
  }

  .cta-panel__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .cta-panel .hc-btn--ghost {
    color: var(--hc-gold);
    border-color: var(--hc-rule);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .disciplines-duo-row {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

  }


  @media (max-width: 640px) {
    .modules-head {
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }

    .modules-head__rule {
      display: none;
    }

    .cta-panel__actions .hc-btn {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pj-register__row,
    .pj-register__go {
      transition: none;
    }

    .pj-register__row:hover .pj-register__go {
      transform: none;
    }
  }
</style>
