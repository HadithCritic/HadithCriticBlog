---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Projects | HadithCritic">
  <main class="page-container">
    <section class="index-hero">
      <div class="hc-container">
        <h1 class="hc-title hc-title--xl">Projects</h1>
        <p class="hc-copy" style="max-width: 600px; font-size: 1.2rem; margin-top: 1rem; color: var(--hc-muted);">
          Ongoing research projects, digital tools, and collaborative initiatives.
        </p>
      </div>
    </section>
    <section class="page-content hc-container" style="padding-bottom: 8rem;">
      <div class="projects-grid projects-grid--brand" style="margin-top: 4rem;">
        <article class="project-card project-card--large">
          <span class="hc-chip">Coming Soon</span>
          <h3 class="hc-title">Hadith Database</h3>
          <p class="hc-copy">A searchable database for reports, chains, variants, transmitters, and source comparison.</p>
          <div class="project-lines" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </article>
        <article class="project-card">
          <span class="hc-chip">Research Phase</span>
          <h3 class="hc-title">Corpus Mapping</h3>
          <p class="hc-copy">Digital tools for tracing reports across early Sunni and Shīʿī collections.</p>
        </article>
        <article class="project-card">
          <span class="hc-chip">In Development</span>
          <h3 class="hc-title">Common-Link Studies</h3>
          <p class="hc-copy">Visual studies of transmission clusters, narrator pathways, and textual growth.</p>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-container {
    min-height: 100vh;
    background: radial-gradient(circle at 100% 0%, rgba(216, 177, 102, 0.05), transparent 40%), var(--hc-black);
  }
  .index-hero {
    padding: 8rem 0 4rem;
    border-bottom: 1px solid var(--hc-rule);
    background: linear-gradient(180deg, rgba(15, 15, 16, 0.8), var(--hc-black));
  }
</style>
