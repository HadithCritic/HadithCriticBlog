---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { OG } from "../lib/seo";
import { CORPUS_META } from "../lib/corpus-config";
import qiraatIndex from "../data/qiraat/index.json";
import { historySources } from "../data/history";
import "../styles/projects.css";

/* Every figure on this page is read from the data the project is built from. */
const n = (value: number) => value.toLocaleString("en-US");
const corpus = CORPUS_META.counts;
const rulesCount = (qiraatIndex as { rules?: { rules?: number } }).rules?.rules ?? 0;

interface Entry {
  label: string;
  href: string;
}

interface Project {
  id: string;
  href: string;
  art?: string;
  kind: string;
  arabic?: string;
  title: string;
  desc: string;
  figures: string[];
  entries: Entry[];
  action: string;
  scope: string;
  status: string;
}

const lead: Project = {
  id: "hadith-corpus",
  href: "/hadith/",
  art: "corpus",
  kind: "Textual corpus",
  arabic: "الحديث",
  title: "Hadith Corpus",
  desc: "Narrations in facing Arabic and English, searchable across every compilation by matn, isnād or topic, with each chain linked to its transmitters in the Rijāl Register. No authenticity grade is added.",
  figures: [`${n(corpus.hadith)} narrations`, `${corpus.collections} collections`, `${n(corpus.chainLinks)} chain links`],
  entries: [
    { label: "Search the narrations", href: "/hadith/" },
    { label: "Browse the collections", href: "/hadith/#collections-heading" },
    { label: "Open Ṣaḥīḥ al-Bukhārī", href: "/hadith/collection/sahih-al-bukhari/" },
  ],
  action: "Search the corpus",
  scope: `${n(corpus.hadith)} narrations in ${corpus.collections} collections`,
  status: "Live",
};

const databases: Project[] = [
  {
    id: "narrator-biographies",
    href: "/narrators/",
    art: "rijal",
    kind: "Biographical register",
    arabic: "الرجال",
    title: "Rijāl Register",
    desc: "Classical transmitters with dates, teachers and students, and every critic’s statement attributed to the critic who made it.",
    figures: [`${n(corpus.narrators)} transmitters`, `${n(corpus.criticismStatements)} statements`],
    entries: [
      { label: "Browse the register", href: "/narrators/" },
      { label: "Compare two transmitters", href: "/narrators/compare/" },
    ],
    action: "Browse the register",
    scope: `${n(corpus.narrators)} transmitters, ${n(corpus.criticismStatements)} attributed statements`,
    status: "Live",
  },
  {
    id: "quran-textual-variants",
    href: "/projects/quran/",
    art: "qiraat",
    kind: "Variant readings",
    arabic: "القراءات",
    title: "The Qirāʾāt Variants",
    desc: "The ten readings set side by side, word by word, with the classical books that report each one and the page each quotation comes from.",
    figures: ["10 readers", `${qiraatIndex.suras_with_data} of 114 suras`, `${rulesCount} general rules`],
    entries: [
      { label: "The ten readers", href: "/projects/quran/#readers" },
      { label: "Sura register", href: "/projects/quran/#suras" },
      { label: "General rules", href: "/projects/quran/rules/" },
      { label: "Transmission", href: "/projects/quran/transmission/" },
    ],
    action: "Compare the readings",
    scope: `10 readers, ${qiraatIndex.suras_with_data} of 114 suras`,
    status: "Machine-checked; readings await human review",
  },
];

const history: Project = {
  id: "history-library",
  href: "/projects/history/",
  art: "history-archive-v2",
  kind: "Historical source library",
  arabic: "التاريخ",
  title: "History (Tārīkh)",
  desc: `${historySources.length} early historical works range from annalistic chronicles and conquest accounts to genealogical and social compendia. The archive brings their people, places and parallel accounts into view.`,
  figures: [`${historySources.length} works`, "207–310 AH", "Coming soon"],
  entries: [
    { label: "The source library", href: "/projects/history/#sources" },
  ],
  action: "Explore the history project",
  scope: "Coming soon",
  status: "Coming soon",
};

const projects = [...databases, history];
const all = [lead, ...projects];
---

<BaseLayout
  image={OG.projects}
  title="Projects | HadithCritic"
  description="HadithCritic's research tools: a hadith corpus, a rijāl register, the qirāʾāt variants and History (Tārīkh)."
>
  <div class="hc-page pj-page">
    <PageHero
      title="Research tools"
      accent="and registers"
      titleId="pj-title"
      kicker="Projects"
      art="/images/editorial/projects-hero.webp"
      focus="72% center"
      measure="11ch"
    >
      <p class="hc-hero__lede">
        Research tools for the hadith, its transmitters, the Qur’an’s variant readings, early history and
        modern scholarship. Every figure here is counted from the project's own data.
      </p>
      <Fragment slot="actions">
        <a href="#projects" class="hc-btn">See the projects</a>
        <a href="#glance" class="hc-btn hc-btn--ghost">All projects at a glance</a>
      </Fragment>
      <Fragment slot="register">
        <span><strong>{all.length}</strong> projects</span>
        <span><strong>{n(corpus.hadith)}</strong> narrations</span>
        <span><strong>{n(corpus.narrators)}</strong> transmitters</span>
      </Fragment>
    </PageHero>

    <!-- Projects -->
    <section class="hc-band hc-band--soft pj-projects" id="projects" aria-labelledby="projects-title">
      <div class="hc-container">
        <header class="hc-head">
          <div class="hc-head__main">
            <h2 id="projects-title" class="hc-head__title">The <span>projects</span></h2>
            <p class="hc-head__note">
              Each runs in your browser from published data files, with no server between you and the
              sources.
            </p>
          </div>
        </header>

        <article class="pj-lead" id={lead.id}>
          <img class="pj-lead__art" src={`/images/platform/${lead.art}.webp`} srcset={`/images/platform/${lead.art}-1086.webp 1086w, /images/platform/${lead.art}.webp 2172w`} sizes="(max-width: 860px) 100vw, 60vw" alt="" width="2172" height="724" loading="eager" decoding="async" />
          <div class="pj-lead__copy">
            <p class="pj-kind">{lead.kind} <span lang="ar" dir="rtl">{lead.arabic}</span></p>
            <h3 class="pj-lead__title"><a href={lead.href}>{lead.title}</a></h3>
            <p class="pj-desc">{lead.desc}</p>
            <ul class="hc-figures pj-figures">{lead.figures.map((figure) => <li>{figure}</li>)}</ul>
            <nav class="pj-entries" aria-label={`Inside the ${lead.title}`}>
              <ul>{lead.entries.map((entry) => <li><a href={entry.href}>{entry.label} <span aria-hidden="true">→</span></a></li>)}</ul>
            </nav>
          </div>
        </article>

        <ul class="pj-grid pj-grid--three">
          {projects.map((project) => (
            <li>
              <article class="pj-panel" id={project.id}>
                <img class="pj-panel__art" src={`/images/platform/${project.art}-1086.webp`} alt="" width="1086" height="362" loading="lazy" decoding="async" />
                <p class="pj-kind">{project.kind} <span lang="ar" dir="rtl">{project.arabic}</span></p>
                <h3 class="pj-panel__title"><a href={project.href}>{project.title}</a></h3>
                <p class="pj-desc">{project.desc}</p>
                <ul class="hc-figures pj-figures">{project.figures.map((figure) => <li>{figure}</li>)}</ul>
                <nav class="pj-entries" aria-label={`Inside ${project.title}`}>
                  <ul>{project.entries.map((entry) => <li><a href={entry.href}>{entry.label} <span aria-hidden="true">→</span></a></li>)}</ul>
                </nav>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- At a glance -->
    <section class="hc-band hc-band--warm pj-glance" id="glance" aria-labelledby="glance-title">
      <div class="hc-container">
        <header class="hc-head">
          <div class="hc-head__main">
            <h2 id="glance-title" class="hc-head__title">At a <span>glance</span></h2>
            <p class="hc-head__note">What each project holds, and how far along it is.</p>
          </div>
        </header>
        <div class="pj-table-wrap">
          <table class="pj-table">
            <thead>
              <tr>
                <th scope="col">No.</th>
                <th scope="col">Project</th>
                <th scope="col">Kind</th>
                <th scope="col">Holds</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {all.map((project, index) => (
                <tr>
                  <td class="pj-table__no">{String(index + 1).padStart(2, "0")}</td>
                  <th scope="row"><a class="pj-table__name" href={project.href}>{project.title}</a> <a class="pj-table__jump" href={`#${project.id}`}>Details</a></th>
                  <td>{project.kind}</td>
                  <td>{project.scope}</td>
                  <td class="pj-table__status">{project.status}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="hc-band pj-closing" aria-labelledby="pj-closing-title">
      <div class="hc-container">
        <div class="hc-closing hc-parchment">
          <figure class="hc-closing__plate" style="--plate-focus: 70% center">
            <img src="/images/editorial/projects-hero-1086.webp" alt="" width="1086" height="362" loading="lazy" decoding="async" />
          </figure>
          <div class="hc-closing__copy">
            <h2 id="pj-closing-title" class="hc-closing__title">Contribute to the projects.</h2>
            <p class="hc-closing__lead">
              The projects are developed for source-level research and digital humanities. If you work in
              Islamic manuscript studies, hadith criticism or computational philology, collaboration is welcome.
            </p>
          </div>
          <div class="hc-closing__actions">
            <a href="/contact/?topic=Collaboration#contact-form" class="hc-ink-btn">Propose a collaboration <span aria-hidden="true">→</span></a>
            <a href="https://github.com/HadithCritic/HadithCriticBlog" target="_blank" rel="noopener noreferrer" class="hc-ink-btn hc-ink-btn--ghost">Source on GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
