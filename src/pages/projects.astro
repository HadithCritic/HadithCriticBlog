---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { OG } from "../lib/seo";
import { CORPUS_META } from "../lib/corpus-config";
import { academicStudies } from "../data/academic-studies";
import { studyFamily } from "../data/icma-families";
import researchGraph from "../data/research-graph.json";
import qiraatIndex from "../data/qiraat/index.json";
import { totalEntries, works as tafsirWorkList } from "../lib/tafsir";
import "../styles/projects.css";

/* Every figure on this page is read from the data the project is built from. */
const n = (value: number) => value.toLocaleString("en-US");
const corpus = CORPUS_META.counts;
const icma = academicStudies.filter((study) => study.category === "icma");
const icmaFamilies = new Set(icma.map((study) => studyFamily[study.slug] ?? "network")).size;
const citations = researchGraph.edges.filter((edge) => edge.type === "cites").length;
const tafsirPassages = totalEntries();
const tafsirWorks = tafsirWorkList.length;
const rulesCount = (qiraatIndex as { rules?: { rules?: number } }).rules?.rules ?? 0;

interface Entry {
  label: string;
  href: string;
}

interface Project {
  id: string;
  href: string;
  art?: string;
  kind: string;
  arabic?: string;
  title: string;
  desc: string;
  figures: string[];
  entries: Entry[];
  action: string;
  scope: string;
  status: string;
}

const lead: Project = {
  id: "hadith-corpus",
  href: "/hadith/",
  art: "corpus",
  kind: "Textual corpus",
  arabic: "الحديث",
  title: "Hadith Corpus",
  desc: "Narrations in facing Arabic and English, searchable across every compilation by matn, isnād or topic, with each chain linked to its transmitters in the Rijāl Register. No authenticity grade is added.",
  figures: [`${n(corpus.hadith)} narrations`, `${corpus.collections} collections`, `${n(corpus.chainLinks)} chain links`],
  entries: [
    { label: "Search the narrations", href: "/hadith/" },
    { label: "Browse the collections", href: "/hadith/#collections-heading" },
    { label: "Open Ṣaḥīḥ al-Bukhārī", href: "/hadith/collection/sahih-al-bukhari/" },
  ],
  action: "Search the corpus",
  scope: `${n(corpus.hadith)} narrations in ${corpus.collections} collections`,
  status: "Live",
};

const databases: Project[] = [
  {
    id: "narrator-biographies",
    href: "/narrators/",
    art: "rijal",
    kind: "Biographical register",
    arabic: "الرجال",
    title: "Rijāl Register",
    desc: "Classical transmitters with dates, teachers and students, and every critic’s statement attributed to the critic who made it.",
    figures: [`${n(corpus.narrators)} transmitters`, `${n(corpus.criticismStatements)} statements`],
    entries: [
      { label: "Browse the register", href: "/narrators/" },
      { label: "Compare two transmitters", href: "/narrators/compare/" },
    ],
    action: "Browse the register",
    scope: `${n(corpus.narrators)} transmitters, ${n(corpus.criticismStatements)} attributed statements`,
    status: "Live",
  },
  {
    id: "quran-textual-variants",
    href: "/projects/quran/",
    art: "qiraat",
    kind: "Variant readings",
    arabic: "القراءات",
    title: "The Qirāʾāt Variants",
    desc: "The ten readings set side by side, word by word, with the classical books that report each one and the page each quotation comes from.",
    figures: ["10 readers", `${qiraatIndex.suras_with_data} of 114 suras`, `${rulesCount} general rules`],
    entries: [
      { label: "The ten readers", href: "/projects/quran/#readers" },
      { label: "Sura register", href: "/projects/quran/#suras" },
      { label: "General rules", href: "/projects/quran/rules/" },
      { label: "Transmission", href: "/projects/quran/transmission/" },
    ],
    action: "Compare the readings",
    scope: `10 readers, ${qiraatIndex.suras_with_data} of 114 suras`,
    status: "Machine-checked; readings await human review",
  },
  {
    id: "tafsir-reader",
    href: "/projects/tafsir/",
    art: "tafsir",
    kind: "Verse-first reader",
    arabic: "التفسير",
    title: "Tafsir Reader",
    desc: "The earliest commentaries, from Mujāhid to al-Ṭabarī’s Jāmiʿ al-bayān, set under the verse each passage comments on, with the volume and page of the printed edition.",
    figures: [`${n(tafsirPassages)} passages`, `${tafsirWorks} works`, "114 suras"],
    entries: [
      { label: "Choose a sura", href: "/projects/tafsir/#suras" },
      { label: "Begin at al-Fātiḥa", href: "/projects/tafsir/sura/1/" },
    ],
    action: "Open the reader",
    scope: `${n(tafsirPassages)} passages from ${tafsirWorks} works, 114 suras`,
    status: "Placements proposed; none reviewed",
  },
];

const research: Project[] = [
  {
    id: "hadith-criticism-atlas",
    href: "/projects/islamic-studies-atlas/",
    art: "atlas",
    kind: "Research network",
    arabic: "الدراسات",
    title: "Islamic Studies Atlas",
    desc: "Modern scholarship on ḥadīth criticism, laid out by author and year. Select a work to see what it cites and what cites it.",
    figures: [`${researchGraph.works.length} works`, `${researchGraph.scholars.length} scholars`, `${n(citations)} citations`],
    entries: [
      { label: "Explore the citations", href: "/projects/islamic-studies-atlas/#map" },
      { label: "Bibliography", href: "/projects/islamic-studies-atlas/#works" },
      { label: "Scholars", href: "/projects/islamic-studies-atlas/#scholars" },
    ],
    action: "Explore the atlas",
    scope: `${researchGraph.works.length} works, ${researchGraph.scholars.length} scholars, ${n(citations)} citations`,
    status: "Live",
  },
  {
    id: "academic-studies",
    href: "/projects/academic-studies/",
    art: "icma",
    kind: "Isnād-cum-matn studies",
    arabic: "الإسناد والمتن",
    title: "The ICMA Register",
    desc: "Studies that trace a tradition to its common link and date it, grouped by research family.",
    figures: [`${icma.length} studies`, `${icmaFamilies} research families`],
    entries: [
      { label: "Browse the register", href: "/projects/academic-studies/#register" },
      { label: "The monograph series", href: "/academia/#series" },
    ],
    action: "Browse the register",
    scope: `${icma.length} studies in ${icmaFamilies} families`,
    status: "Live",
  },
];

const prototype: Project = {
  id: "fiqh-compass-quiz",
  href: "/projects/fiqh-compass/",
  kind: "Research prototype",
  arabic: "بوصلة الفقه",
  title: "Fiqh Compass",
  desc: "Twelve dimensions of legal reasoning explored through a guided questionnaire. Results describe your answers to a provisional item set, not a school identity or a religious ruling.",
  figures: ["24 draft questions", "12 dimensions"],
  entries: [
    { label: "Take the quiz", href: "/projects/fiqh-compass/quiz/" },
    { label: "Methodology and safeguards", href: "/projects/fiqh-compass/methodology/" },
  ],
  action: "Explore the prototype",
  scope: "24 draft questions, 12 dimensions",
  status: "Prototype (M1)",
};

const all = [lead, ...databases, ...research, prototype];
const kinds = ["Database", "Database", "Database", "Database", "Research", "Research", "Prototype"];
---

<BaseLayout
  image={OG.projects}
  title="Projects | HadithCritic"
  description="HadithCritic's research tools: a hadith corpus, a rijāl register, the qirāʾāt variants, a tafsir reader, the Islamic Studies Atlas, the ICMA Register and the Fiqh Compass prototype."
>
  <div class="hc-page hc-plate pj-page">
    <PageHero
      title="Research tools"
      accent="and registers"
      titleId="pj-title"
      kicker="Projects"
      art="/images/editorial/projects-hero.webp"
      focus="72% center"
      measure="11ch"
    >
      <p class="hc-hero__lede">
        Four reference databases that run in your browser, two registers of the scholarship, and one
        research prototype. Every figure here is counted from the project's own data.
      </p>
      <Fragment slot="actions">
        <a href="#databases" class="hc-btn">See the databases</a>
        <a href="#glance" class="hc-btn hc-btn--ghost">All projects at a glance</a>
      </Fragment>
      <Fragment slot="register">
        <span><strong>{all.length}</strong> projects</span>
        <span><strong>{n(corpus.hadith)}</strong> narrations</span>
        <span><strong>{n(corpus.narrators)}</strong> transmitters</span>
        <span><strong>{researchGraph.works.length}</strong> works in the atlas</span>
      </Fragment>
    </PageHero>

    <!-- Databases -->
    <section class="hc-band hc-band--soft pj-databases" id="databases" aria-labelledby="databases-title">
      <div class="hc-container">
        <header class="hc-head">
          <div class="hc-head__main">
            <h2 id="databases-title" class="hc-head__title">Reference <span>databases</span></h2>
            <p class="hc-head__note">
              Each runs in your browser from published data files, with no database server between you
              and the sources.
            </p>
          </div>
        </header>

        <article class="pj-lead" id={lead.id}>
          <img class="pj-lead__art" src={`/images/platform/${lead.art}.webp`} srcset={`/images/platform/${lead.art}-1086.webp 1086w, /images/platform/${lead.art}.webp 2172w`} sizes="(max-width: 860px) 100vw, 60vw" alt="" width="2172" height="724" loading="eager" decoding="async" />
          <div class="pj-lead__copy">
            <p class="pj-kind">{lead.kind} <span lang="ar" dir="rtl">{lead.arabic}</span></p>
            <h3 class="pj-lead__title"><a href={lead.href}>{lead.title}</a></h3>
            <p class="pj-desc">{lead.desc}</p>
            <ul class="hc-figures pj-figures">{lead.figures.map((figure) => <li>{figure}</li>)}</ul>
            <nav class="pj-entries" aria-label={`Inside the ${lead.title}`}>
              <ul>{lead.entries.map((entry) => <li><a href={entry.href}>{entry.label} <span aria-hidden="true">→</span></a></li>)}</ul>
            </nav>
          </div>
        </article>

        <ul class="pj-grid pj-grid--three">
          {databases.map((project) => (
            <li>
              <article class="pj-panel" id={project.id}>
                <img class="pj-panel__art" src={`/images/platform/${project.art}-1086.webp`} alt="" width="1086" height="362" loading="lazy" decoding="async" />
                <p class="pj-kind">{project.kind} <span lang="ar" dir="rtl">{project.arabic}</span></p>
                <h3 class="pj-panel__title"><a href={project.href}>{project.title}</a></h3>
                <p class="pj-desc">{project.desc}</p>
                <ul class="hc-figures pj-figures">{project.figures.map((figure) => <li>{figure}</li>)}</ul>
                <nav class="pj-entries" aria-label={`Inside ${project.title}`}>
                  <ul>{project.entries.map((entry) => <li><a href={entry.href}>{entry.label} <span aria-hidden="true">→</span></a></li>)}</ul>
                </nav>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Research registers -->
    <section class="hc-band pj-research" id="research" aria-labelledby="research-title">
      <div class="hc-container">
        <header class="hc-head">
          <div class="hc-head__main">
            <h2 id="research-title" class="hc-head__title">Registers of <span>the scholarship</span></h2>
            <p class="hc-head__note">Maps of modern research on ḥadīth, and of HadithCritic's own isnād-cum-matn studies.</p>
          </div>
        </header>
        <ul class="pj-grid pj-grid--two">
          {research.map((project) => (
            <li>
              <article class="pj-panel pj-panel--wide" id={project.id}>
                <img class="pj-panel__art" src={`/images/platform/${project.art}-1086.webp`} alt="" width="1086" height="362" loading="lazy" decoding="async" />
                <p class="pj-kind">{project.kind} <span lang="ar" dir="rtl">{project.arabic}</span></p>
                <h3 class="pj-panel__title"><a href={project.href}>{project.title}</a></h3>
                <p class="pj-desc">{project.desc}</p>
                <ul class="hc-figures pj-figures">{project.figures.map((figure) => <li>{figure}</li>)}</ul>
                <nav class="pj-entries" aria-label={`Inside ${project.title}`}>
                  <ul>{project.entries.map((entry) => <li><a href={entry.href}>{entry.label} <span aria-hidden="true">→</span></a></li>)}</ul>
                </nav>
              </article>
            </li>
          ))}
        </ul>

        <article class="pj-proto" id={prototype.id}>
          <svg class="pj-proto__motif" viewBox="0 0 240 240" aria-hidden="true" focusable="false">
            <circle cx="120" cy="120" r="96" />
            <circle cx="120" cy="120" r="70" />
            {Array.from({ length: 12 }, (_, index) => {
              const angle = (index * Math.PI) / 6;
              return <line x1={120 + Math.cos(angle) * 73} y1={120 + Math.sin(angle) * 73} x2={120 + Math.cos(angle) * 94} y2={120 + Math.sin(angle) * 94} />;
            })}
            <path d="M120 62 136 120 120 178 104 120Z" />
            <circle class="pj-proto__hub" cx="120" cy="120" r="5" />
          </svg>
          <div class="pj-proto__copy">
            <p class="pj-kind">{prototype.kind} <span lang="ar" dir="rtl">{prototype.arabic}</span></p>
            <h3 class="pj-panel__title"><a href={prototype.href}>{prototype.title}</a></h3>
            <p class="pj-desc">{prototype.desc}</p>
          </div>
          <div class="pj-proto__side">
            <ul class="hc-figures pj-figures">{prototype.figures.map((figure) => <li>{figure}</li>)}</ul>
            <nav class="pj-entries" aria-label={`Inside ${prototype.title}`}>
              <ul>{prototype.entries.map((entry) => <li><a href={entry.href}>{entry.label} <span aria-hidden="true">→</span></a></li>)}</ul>
            </nav>
          </div>
        </article>
      </div>
    </section>

    <!-- At a glance -->
    <section class="hc-band hc-band--warm pj-glance" id="glance" aria-labelledby="glance-title">
      <div class="hc-container">
        <header class="hc-head">
          <div class="hc-head__main">
            <h2 id="glance-title" class="hc-head__title">At a <span>glance</span></h2>
            <p class="hc-head__note">What each project holds, and how far along it is.</p>
          </div>
        </header>
        <div class="pj-table-wrap">
          <table class="pj-table">
            <thead>
              <tr>
                <th scope="col">No.</th>
                <th scope="col">Project</th>
                <th scope="col">Kind</th>
                <th scope="col">Holds</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {all.map((project, index) => (
                <tr>
                  <td class="pj-table__no">{String(index + 1).padStart(2, "0")}</td>
                  <th scope="row"><a class="pj-table__name" href={project.href}>{project.title}</a> <a class="pj-table__jump" href={`#${project.id}`}>Details</a></th>
                  <td>{kinds[index]}</td>
                  <td>{project.scope}</td>
                  <td class="pj-table__status">{project.status}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="hc-band pj-closing" aria-labelledby="pj-closing-title">
      <div class="hc-container">
        <div class="hc-closing hc-parchment">
          <figure class="hc-closing__plate" style="--plate-focus: 70% center">
            <img src="/images/editorial/projects-hero-1086.webp" alt="" width="1086" height="362" loading="lazy" decoding="async" />
          </figure>
          <div class="hc-closing__copy">
            <h2 id="pj-closing-title" class="hc-closing__title">Contribute to the projects.</h2>
            <p class="hc-closing__lead">
              The projects are developed for source-level research and digital humanities. If you work in
              Islamic manuscript studies, hadith criticism or computational philology, collaboration is welcome.
            </p>
          </div>
          <div class="hc-closing__actions">
            <a href="/contact/?topic=Collaboration#contact-form" class="hc-ink-btn">Propose a collaboration <span aria-hidden="true">→</span></a>
            <a href="https://github.com/HadithCritic/HadithCriticBlog" target="_blank" rel="noopener noreferrer" class="hc-ink-btn hc-ink-btn--ghost">Source on GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
