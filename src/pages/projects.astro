---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { OG } from "../lib/seo";
import { LIBRARY_COLLECTIONS } from "../lib/hadith-library";
import { historySources, openReaders } from "../data/history/history";
import { libraryWorks, surahEntries, versePageHref } from "../data/tafsir/tafsir-library";
import { letterIndex, pageHref, totals } from "../lib/rijal-register";
import "../styles/projects.css";

/* The projects index: the hadith corpus as one wide card, then the other
   projects as a row of cards, each with the engraving that heads its own
   page so a reader recognizes it on arrival, a line on its scope, and a few
   places to start reading. The scope lines are read from each project's
   data. */

interface Entry {
  label: string;
  href: string;
}

interface Project {
  id: string;
  href: string;
  /** Name of the plate in /images/platform/ (2172px, with a -1086 copy). */
  art: string;
  kind: string;
  arabic: string;
  title: string;
  desc: string;
  scope: string;
  entries: Entry[];
  action: string;
}

const n = (value: number) => value.toLocaleString("en-US");
const tafsirCovered = new Set(
  libraryWorks.flatMap((work) => surahEntries(work.id).filter((surah) => surah.state === "available").map((surah) => surah.n)),
).size;

const lead: Project = {
  id: "hadith-corpus",
  href: "/hadith/",
  art: "corpus",
  kind: "Textual corpus",
  arabic: "الحديث",
  title: "Hadith Corpus",
  desc: "Early hadith collections in facing Arabic and English, each with its transmission paths and source references. Each narration is given as its source records it, with no authenticity grade added.",
  scope: `${LIBRARY_COLLECTIONS.length} collections in Arabic and English`,
  entries: [
    { label: "Browse the collections", href: "/hadith/#collections-heading" },
    { label: "Read al-Shamāʾil al-Muḥammadiyya", href: "/hadith/collection/al-shama-il-al-muhammadiyah/" },
  ],
  action: "Open the corpus",
};

const projects: Project[] = [
  {
    id: "tafsir",
    href: "/projects/tafsir/",
    art: "tafsir",
    kind: "Qur'anic commentary",
    arabic: "التفسير",
    title: "Tafsīr",
    desc: "Mujāhid, al-Thawrī, al-Zamakhsharī and al-Ṭabarī one verse at a time, with the Qur’anic text, the commentary and its reports together on the page.",
    scope: `${libraryWorks.length} commentaries, ${tafsirCovered} of 114 surahs`,
    entries: [{ label: "Read al-Fātiḥa", href: versePageHref("tabari", 1, 1) }],
    action: "Open the commentaries",
  },
  {
    id: "rijal",
    href: "/projects/rijal/",
    art: "icma",
    kind: "Narrator register",
    arabic: "الرجال",
    title: "Narrators (Rijāl)",
    desc: "Ibn Ḥajar’s Taqrīb al-Tahdhīb as a register: each transmitter’s grade, generation, death date and the books that cite them, in Arabic and English.",
    scope: `${n(totals.biographies)} biographies`,
    entries: [{ label: "Begin at the letter Alif", href: pageHref(letterIndex()[0].pages[0].slug) }],
    action: "Open the register",
  },
  {
    id: "history-library",
    href: "/projects/history/",
    art: "history-archive-v2",
    kind: "Historical sources",
    arabic: "التاريخ",
    title: "History (Tārīkh)",
    desc: "The earliest Arabic histories of Islam in English: chronicles, conquest narratives and genealogies, each in its own reader.",
    scope: `${openReaders.length} of ${historySources.length} books open to read`,
    entries: [
      { label: "Khalīfa ibn Khayyāṭ’s chronicle", href: "/projects/history/khalifa/" },
      { label: "The Conquests of the Lands", href: "/projects/history/futuh-al-buldan/" },
    ],
    action: "Open the library",
  },
];

const plate = (art: string) => ({
  src: `/images/platform/${art}.webp`,
  srcset: `/images/platform/${art}-1086.webp 1086w, /images/platform/${art}.webp 2172w`,
});
const leadPlate = plate(lead.art);
---

<BaseLayout
  image={OG.projects}
  title="Projects | HadithCritic"
  description="HadithCritic's research tools: a hadith corpus, four tafsīr commentaries, a narrator register and a library of early Arabic histories."
>
  <div class="hc-page pj-page">
    <PageHero
      title="Research tools"
      accent="and registers."
      titleId="pj-title"
      kicker="Projects"
      art="/images/editorial/projects-hero.webp"
      focus="72% center"
      measure="11ch"
    >
      <p class="hc-hero__lede">
        Primary sources for the study of hadith, Qur’anic commentary and early Islamic history,
        set out to be read and checked against the original Arabic.
      </p>
      <Fragment slot="actions">
        <a href="#projects" class="hc-btn">See the projects</a>
        <a href="#contribute" class="hc-btn hc-btn--ghost">Contribute</a>
      </Fragment>
    </PageHero>

    <section class="hc-band pj-projects" id="projects" aria-labelledby="pj-projects-title">
      <div class="hc-container">
        <h2 id="pj-projects-title" class="hc-head__title pj-projects__title">The <span>projects</span></h2>

        <!-- The corpus, as one wide card. -->
        <article class="pj-lead" id={lead.id} aria-labelledby={`${lead.id}-title`}>
          <a class="pj-lead__plate" href={lead.href} tabindex="-1" aria-hidden="true">
            <img
              src={leadPlate.src}
              srcset={leadPlate.srcset}
              sizes="(max-width: 860px) 100vw, 55vw"
              alt=""
              width="2172"
              height="724"
              loading="eager"
              decoding="async"
            />
          </a>
          <div class="pj-lead__copy">
            <p class="pj-kind">{lead.kind}</p>
            <h3 class="pj-title pj-title--lead" id={`${lead.id}-title`}>
              <a href={lead.href}>{lead.title}</a>
              <span class="pj-title__ar" lang="ar" dir="rtl">{lead.arabic}</span>
            </h3>
            <p class="pj-desc">{lead.desc}</p>
            <p class="pj-scope">{lead.scope}</p>
            <ul class="pj-entries" aria-label={`Start reading ${lead.title}`}>
              {lead.entries.map((entry) => (
                <li><a href={entry.href}>{entry.label} <span aria-hidden="true">→</span></a></li>
              ))}
            </ul>
            <a class="hc-ink-btn pj-lead__action" href={lead.href}>{lead.action} <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- The other projects, one card each. -->
        <ul class="pj-grid">
          {projects.map((project) => {
            const art = plate(project.art);
            return (
              <li>
                <article class="pj-card" id={project.id} aria-labelledby={`${project.id}-title`}>
                  <a class="pj-card__plate" href={project.href} tabindex="-1" aria-hidden="true">
                    <img
                      src={art.src}
                      srcset={art.srcset}
                      sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 420px"
                      alt=""
                      width="2172"
                      height="724"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <div class="pj-card__body">
                    <p class="pj-kind">{project.kind}</p>
                    <h3 class="pj-title" id={`${project.id}-title`}>
                      <a href={project.href}>{project.title}</a>
                      <span class="pj-title__ar" lang="ar" dir="rtl">{project.arabic}</span>
                    </h3>
                    <p class="pj-desc">{project.desc}</p>
                    <p class="pj-scope">{project.scope}</p>
                    <ul class="pj-entries" aria-label={`Start reading ${project.title}`}>
                      {project.entries.map((entry) => (
                        <li><a href={entry.href}>{entry.label} <span aria-hidden="true">→</span></a></li>
                      ))}
                    </ul>
                    <a class="pj-card__action" href={project.href}>{project.action} <span aria-hidden="true">→</span></a>
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section class="hc-band pj-closing" id="contribute" aria-labelledby="pj-closing-title">
      <div class="hc-container">
        <div class="pj-contribute">
          <div class="pj-contribute__copy">
            <h2 id="pj-closing-title" class="pj-contribute__title">Contribute to the projects</h2>
            <p class="pj-contribute__lead">
              Corrections, editions and translations are welcome from anyone working in manuscript
              studies, hadith criticism or computational philology. The code and the data files are
              on GitHub.
            </p>
          </div>
          <div class="pj-contribute__actions">
            <a href="/contact/?topic=Collaboration#contact-form" class="hc-ink-btn">Propose a collaboration <span aria-hidden="true">→</span></a>
            <a href="https://github.com/HadithCritic/HadithCriticBlog" target="_blank" rel="noopener noreferrer" class="hc-ink-btn hc-ink-btn--ghost">
              Source on GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
