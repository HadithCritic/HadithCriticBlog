---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsnadBundle from '../components/IsnadBundle.astro';

const leadProject = {
  status: 'Coming soon',
  statusMod: 'soon',
  title: 'Silsilah Hadith Database',
  description:
    'An extensive archive of classical collections with hundreds of thousands of reports, browsable by collection, book, and chapter. Every report carries its Arabic text, English translation, transmission chain, gradings, and reference lookup.',
  meta: ['Extensive Archive', 'Chains', 'Gradings', 'Reference Lookup']
};

const workbench: Array<{ status: string; statusMod: string; title: string; description: string; meta: string[]; href?: string }> = [
  {
    status: 'Coming soon',
    statusMod: 'soon',
    title: 'Corpus Mapping',
    description:
      'A geographic visualization of transmission: search any report and watch its journey from the Prophet outward, narrator by narrator, city by city, until it reaches its written compilation.',
    meta: ['Geography', 'Transmission', 'Visualization']
  },
  {
    status: 'Coming soon',
    statusMod: 'soon',
    title: 'Academic Studies',
    description:
      'A compilation of scholarly works on hadith criticism.',
    meta: ['Scholarship', 'Analysis', 'Academic']
  },
  {
    status: 'Coming soon',
    statusMod: 'soon',
    title: 'Narrator Biographies',
    description:
      'A searchable register of 8,000+ transmitters of the six books, built from Dhahabī’s al-Kāshif: teachers, students, death dates, and collection sigla, with Mizzī and Ibn Ḥajar to come.',
    meta: ['Rijāl', 'al-Kāshif', 'Search']
  },
  {
    status: 'Coming soon',
    statusMod: 'soon',
    title: 'Silsilah Research',
    description:
      'Ongoing research notes, methodology, and essays documenting the development of the Silsilah database.',
    meta: ['Methodology', 'Essays', 'Analysis']
  }
];
---

<BaseLayout
  title="Projects | HadithCritic"
  description="Ongoing research projects, digital tools, and collaborative initiatives at HadithCritic."
>
  <div class="projects-page">
    <section class="projects-hero" aria-labelledby="projects-hero-title">
      <div class="hc-container projects-hero__inner">
        <p class="hc-eyebrow projects-hero__label">Research infrastructure</p>
        <h1 id="projects-hero-title" class="projects-hero__title">
          Tools for reading <em>transmission.</em>
        </h1>
        <p class="projects-hero__lead">
          Ongoing research initiatives, digital infrastructure, and collaborative tools built
          to examine hadith transmission, legal theory, and source history.
        </p>
      </div>
    </section>

    <section class="projects-lead hc-container" aria-labelledby="lead-project-title" data-reveal>
      <article class="lead-panel">
        <div class="lead-panel__content">
          <span class:list={['project-chip', `project-chip--${leadProject.statusMod}`]}>
            {leadProject.status}
          </span>
          <h2 id="lead-project-title" class="lead-panel__title">{leadProject.title}</h2>
          <p class="lead-panel__desc">{leadProject.description}</p>
          <div class="lead-panel__meta" aria-label="Hadith Database keywords">
            {leadProject.meta.map((tag) => (
              <span class="lead-panel__tag">{tag}</span>
            ))}
          </div>
        </div>

        <div class="lead-panel__diagram">
          <IsnadBundle
            caption='How a "well-attested" report actually travels: one strand to the common link, then a fan. Silsilah lets you read these chains report by report.'
          />
        </div>
      </article>
    </section>

    <section class="projects-worklist hc-container" aria-labelledby="worklist-title">
      <header class="worklist-head" data-reveal>
        <h2 id="worklist-title" class="worklist-head__title">The workbench.</h2>
        <span class="worklist-head__rule" aria-hidden="true"></span>
        <span class="worklist-head__count">{workbench.length} initiatives</span>
      </header>

      <div class="worklist" role="list">
        {workbench.map((project, index) => (
          <article class="work-row" role="listitem" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <div class="work-row__status">
              <span class:list={['project-chip', `project-chip--${project.statusMod}`]}>
                {project.status}
              </span>
            </div>
            <div class="work-row__main">
              <h3 class="work-row__title">
                {project.href
                  ? <a href={project.href} class="work-row__link">{project.title} <span aria-hidden="true">→</span></a>
                  : project.title}
              </h3>
              <p class="work-row__desc">{project.description}</p>
            </div>
            <div class="work-row__tags" aria-label={`${project.title} keywords`}>
              {project.meta.map((tag) => (
                <span class="work-row__tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="projects-cta hc-container" aria-labelledby="projects-cta-title" data-reveal>
      <div class="cta-panel hc-theme-dark">
        <div class="cta-panel__content">
          <p class="hc-eyebrow">Collaboration</p>
          <h2 id="projects-cta-title" class="cta-panel__title">Contribute to the archive.</h2>
          <p class="cta-panel__copy">
            HadithCritic projects are developed for source-level research. If you work in Islamic
            manuscript studies, digital humanities, or hadith criticism, collaboration is welcome.
          </p>
          <div class="cta-panel__actions">
            <a href="/contact" class="hc-btn">Send a proposal</a>
            <a href="https://github.com/HadithCritic/HadithCriticBlog" target="_blank" rel="noopener noreferrer" class="hc-btn hc-btn--ghost">
              View the code
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector('.projects-page');

  if (page) {
    const items = [...page.querySelectorAll<HTMLElement>('[data-reveal]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced && 'IntersectionObserver' in window) {
      items.forEach((el) => el.classList.add('will-reveal'));

      const observer = new IntersectionObserver(
        (observed) => {
          for (const entry of observed) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      items.forEach((el) => observer.observe(el));
    } else {
      items.forEach((el) => el.classList.add('is-revealed'));
    }
  }
</script>

<style>
  .projects-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 85% 10%, rgba(216, 177, 102, 0.06), transparent 30%),
      radial-gradient(circle at 15% 40%, rgba(164, 106, 63, 0.07), transparent 28%),
      linear-gradient(180deg, var(--hc-charcoal) 0%, var(--hc-black) 60%);
  }

  /* Reveal machinery */

  .will-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.75s var(--ease),
      transform 0.75s var(--ease);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .will-reveal.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hero */

  .projects-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(6rem, 9vw, 8.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--hc-rule);
  }

  .projects-hero::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(216, 177, 102, 0.12);
    pointer-events: none;
  }

  .projects-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .projects-hero__label {
    margin: 0 0 1rem;
    animation: heroRise 0.7s var(--ease) both;
  }

  .projects-hero__title {
    margin: 0;
    max-width: 11em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3rem, 7vw, 6.4rem);
    letter-spacing: -0.04em;
    line-height: 0.94;
    color: var(--hc-parchment);
    animation: heroRise 0.8s var(--ease) 70ms both;
  }

  .projects-hero__title em {
    font-style: italic;
    color: var(--hc-gold);
  }

  .projects-hero__lead {
    max-width: 640px;
    margin: 1.3rem 0 0;
    color: var(--hc-muted);
    font-size: clamp(1.02rem, 0.4vw + 0.98rem, 1.2rem);
    line-height: 1.72;
    animation: heroRise 0.8s var(--ease) 150ms both;
  }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Lead panel with isnad diagram */

  .projects-lead {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .lead-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(1.75rem, 4vw, 3.25rem);
    border: 1px solid var(--hc-rule);
    background:
      radial-gradient(circle at 80% 20%, rgba(216, 177, 102, 0.07), transparent 40%),
      linear-gradient(180deg, rgba(38, 35, 31, 0.88), rgba(15, 15, 16, 0.96));
    box-shadow: var(--shadow);
  }

  .lead-panel::before {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(216, 177, 102, 0.1);
    pointer-events: none;
  }

  .lead-panel__content {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .lead-panel__title {
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 5vw, 4.6rem);
    letter-spacing: -0.04em;
    line-height: 0.94;
    color: var(--hc-parchment);
  }

  .lead-panel__desc {
    max-width: 54ch;
    margin: 1.1rem 0 0;
    color: var(--hc-muted);
    font-size: clamp(1rem, 0.3vw + 0.96rem, 1.1rem);
    line-height: 1.74;
  }

  .lead-panel__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.6rem;
  }

  .lead-panel__cta {
    margin-top: 1.8rem;
    width: fit-content;
  }

  .lead-panel__tag,
  .work-row__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-pill);
    color: var(--hc-muted);
    background: rgba(242, 235, 220, 0.04);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  /* Isnad diagram */

  .lead-panel__diagram {
    position: relative;
    z-index: 1;
  }

  /* Status chips */

  .project-chip {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    padding: 0.22rem 0.7rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-pill);
    color: var(--hc-gold-soft);
    background: rgba(216, 177, 102, 0.08);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    line-height: 1.25;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .project-chip--soon {
    color: #e8c87a;
    border-color: rgba(216, 177, 102, 0.45);
    background: rgba(216, 177, 102, 0.12);
  }

  .project-chip--research {
    color: #c9a96e;
    border-color: rgba(201, 169, 110, 0.4);
    background: rgba(201, 169, 110, 0.1);
  }

  .project-chip--dev {
    color: #9cb892;
    border-color: rgba(88, 116, 81, 0.5);
    background: rgba(88, 116, 81, 0.14);
  }

  .project-chip--plan {
    color: var(--hc-muted);
    border-color: var(--hc-rule);
    background: rgba(242, 235, 220, 0.05);
  }

  .project-chip--proto {
    color: #d4a88a;
    border-color: rgba(212, 168, 138, 0.4);
    background: rgba(212, 168, 138, 0.1);
  }

  /* Worklist */

  .projects-worklist {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .worklist-head {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .worklist-head__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 3.5vw, 3.1rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--hc-parchment);
  }

  .worklist-head__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--hc-rule), transparent);
  }

  .worklist-head__count {
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .worklist {
    border-top: 1px solid var(--hc-rule);
  }

  .work-row {
    position: relative;
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr) 220px;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.1rem) clamp(0.5rem, 1.5vw, 1.25rem);
    border-bottom: 1px solid var(--hc-rule-soft);
    transition: background 250ms ease;
  }

  .work-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--hc-gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 320ms var(--ease);
  }

  .work-row:hover {
    background: linear-gradient(90deg, rgba(216, 177, 102, 0.05), transparent 55%);
  }

  .work-row:hover::before {
    transform: scaleY(1);
  }

  .work-row__main {
    min-width: 0;
  }

  .work-row__link {
    color: inherit;
    text-decoration: none;
  }

  .work-row__link:hover {
    color: var(--hc-gold);
  }

  .work-row__link span {
    color: var(--hc-gold-dim);
  }

  .work-row__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.7rem, 2.6vw, 2.5rem);
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--hc-parchment);
    transition: color 220ms ease;
  }

  .work-row:hover .work-row__title {
    color: var(--hc-gold-soft);
  }

  .work-row__desc {
    max-width: 60ch;
    margin: 0.7rem 0 0;
    color: var(--hc-muted);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  .work-row__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  /* CTA */

  .projects-cta {
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }

  .cta-panel {
    position: relative;
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid rgba(216, 177, 102, 0.4);
    border-radius: var(--radius-xs);
    color: var(--hc-parchment);
    background: linear-gradient(rgba(164, 106, 63, 0.88), rgba(110, 59, 36, 0.94));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.26);
  }

  .cta-panel::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(242, 235, 220, 0.22);
    pointer-events: none;
  }

  .cta-panel__content {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }

  .cta-panel .hc-eyebrow {
    color: var(--hc-parchment-deep);
  }

  .cta-panel__title {
    margin: 0.45rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 3vw, 2.75rem);
    letter-spacing: -0.025em;
    line-height: 1.02;
    color: var(--hc-parchment);
  }

  .cta-panel__copy {
    margin: 0.85rem 0 0;
    color: rgba(242, 235, 220, 0.86);
    line-height: 1.7;
  }

  .cta-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.55rem;
  }

  .cta-panel .hc-btn--ghost {
    color: var(--hc-parchment);
    border-color: rgba(242, 235, 220, 0.4);
  }

  /* Responsive */

  @media (max-width: 1000px) {
    .lead-panel {
      grid-template-columns: 1fr;
    }

    .lead-panel__diagram {
      max-width: 420px;
    }

    .work-row {
      grid-template-columns: 150px minmax(0, 1fr);
    }

    .work-row__tags {
      grid-column: 2;
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .projects-hero {
      padding: 4rem 0 2.4rem;
    }

    .projects-hero::before {
      inset: 10px;
    }

    .projects-hero__title {
      max-width: 100%;
      font-size: clamp(2.65rem, 13vw, 3.55rem);
      line-height: 1.03;
      letter-spacing: -0.02em;
    }

    .projects-hero__lead {
      font-size: 1rem;
      line-height: 1.65;
    }

    .lead-panel {
      padding: 1.15rem;
      gap: 1.4rem;
    }

    .lead-panel::before {
      inset: 8px;
    }

    .lead-panel__title {
      font-size: clamp(2rem, 10vw, 2.8rem);
      line-height: 1.02;
      letter-spacing: -0.02em;
    }

    .lead-panel__desc {
      font-size: 1rem;
      line-height: 1.65;
    }

    .lead-panel__cta {
      width: 100%;
    }

    .lead-panel__cta .hc-btn {
      width: 100%;
    }

    .project-chip {
      white-space: normal;
      text-align: center;
    }

    .work-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      padding-inline: 0;
    }

    .work-row__tags {
      grid-column: 1;
    }

    .worklist-head {
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }

    .worklist-head__rule {
      display: none;
    }

    .cta-panel__actions .hc-btn {
      width: 100%;
    }
  }
</style>
