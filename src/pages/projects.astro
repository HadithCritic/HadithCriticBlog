---
import BaseLayout from '../layouts/BaseLayout.astro';

const leadProject = {
  status: 'Coming Soon',
  statusMod: 'soon',
  title: 'Hadith Database',
  description:
    'A searchable, critical database for reports, chains, variants, transmitters, and source comparison across the major collections. Built for source-level work: every report linked to its witnesses, every chain rendered as a graph.',
  meta: ['Search', 'Chains', 'Variants', 'Transmitters']
};

const workbench = [
  {
    status: 'Research Phase',
    statusMod: 'research',
    title: 'Corpus Mapping',
    description:
      "Digital tools for tracing reports across early Sunni and Shi'i collections, identifying overlaps, gaps, and redaction layers.",
    meta: ['Mapping', 'Collections', 'Redaction']
  },
  {
    status: 'In Development',
    statusMod: 'dev',
    title: 'Common-Link Studies',
    description:
      'Visual studies of transmission clusters, narrator pathways, and textual growth through interactive network graphs.',
    meta: ['Networks', 'Visual', 'Growth']
  },
  {
    status: 'Planning',
    statusMod: 'plan',
    title: 'Narrator Biographies',
    description:
      'Reconstructed biographical profiles with chronological anchors, geographical mapping, and reliability cross-references.',
    meta: ['Biography', 'Chronology', 'Geography']
  },
  {
    status: 'Prototype',
    statusMod: 'proto',
    title: 'Variant Apparatus',
    description:
      'A critical edition tool for displaying textual variants side by side with stemmatic analysis and witness weighting.',
    meta: ['Apparatus', 'Stemmatics', 'Witnesses']
  }
];
---

<BaseLayout
  title="Projects | HadithCritic"
  description="Ongoing research projects, digital tools, and collaborative initiatives at HadithCritic."
>
  <div class="projects-page">
    <section class="projects-hero" aria-labelledby="projects-hero-title">
      <div class="hc-container projects-hero__inner">
        <p class="hc-eyebrow projects-hero__label">Research infrastructure</p>
        <h1 id="projects-hero-title" class="projects-hero__title">
          Tools for reading <em>transmission.</em>
        </h1>
        <p class="projects-hero__lead">
          Ongoing research initiatives, digital infrastructure, and collaborative tools built
          to examine hadith transmission, legal theory, and source history.
        </p>
      </div>
    </section>

    <section class="projects-lead hc-container" aria-labelledby="lead-project-title" data-reveal>
      <article class="lead-panel">
        <div class="lead-panel__content">
          <span class:list={['project-chip', `project-chip--${leadProject.statusMod}`]}>
            {leadProject.status}
          </span>
          <h2 id="lead-project-title" class="lead-panel__title">{leadProject.title}</h2>
          <p class="lead-panel__desc">{leadProject.description}</p>
          <div class="lead-panel__meta" aria-label="Hadith Database keywords">
            {leadProject.meta.map((tag) => (
              <span class="lead-panel__tag">{tag}</span>
            ))}
          </div>
        </div>

        <div class="lead-panel__diagram" aria-hidden="true">
          <svg viewBox="0 0 320 350" fill="none" xmlns="http://www.w3.org/2000/svg" class="isnad-svg">
            <!-- chains: source to first generation -->
            <path pathLength="1" class="chain-line" style="--d: 0ms" d="M160 36 L64 116" />
            <path pathLength="1" class="chain-line" style="--d: 80ms" d="M160 36 L160 124" />
            <path pathLength="1" class="chain-line" style="--d: 160ms" d="M160 36 L256 110" />
            <!-- first to second generation -->
            <path pathLength="1" class="chain-line" style="--d: 360ms" d="M64 116 L34 222" />
            <path pathLength="1" class="chain-line" style="--d: 420ms" d="M64 116 L112 230" />
            <path pathLength="1" class="chain-line" style="--d: 480ms" d="M160 124 L112 230" />
            <path pathLength="1" class="chain-line" style="--d: 540ms" d="M160 124 L192 228" />
            <path pathLength="1" class="chain-line" style="--d: 600ms" d="M256 110 L192 228" />
            <path pathLength="1" class="chain-line" style="--d: 660ms" d="M256 110 L284 218" />
            <!-- second generation to collection -->
            <path pathLength="1" class="chain-line" style="--d: 860ms" d="M34 222 L160 318" />
            <path pathLength="1" class="chain-line" style="--d: 920ms" d="M112 230 L160 318" />
            <path pathLength="1" class="chain-line" style="--d: 980ms" d="M192 228 L160 318" />
            <path pathLength="1" class="chain-line" style="--d: 1040ms" d="M284 218 L160 318" />
            <!-- nodes -->
            <circle class="chain-node chain-node--root" style="--d: 0ms" cx="160" cy="32" r="7" />
            <circle class="chain-node" style="--d: 260ms" cx="64" cy="116" r="5" />
            <circle class="chain-node chain-node--link" style="--d: 320ms" cx="160" cy="124" r="6" />
            <circle class="chain-node" style="--d: 380ms" cx="256" cy="110" r="5" />
            <circle class="chain-node" style="--d: 720ms" cx="34" cy="222" r="5" />
            <circle class="chain-node" style="--d: 780ms" cx="112" cy="230" r="5" />
            <circle class="chain-node" style="--d: 840ms" cx="192" cy="228" r="5" />
            <circle class="chain-node" style="--d: 900ms" cx="284" cy="218" r="5" />
            <circle class="chain-node chain-node--root" style="--d: 1180ms" cx="160" cy="322" r="7" />
          </svg>
          <div class="lead-panel__diagram-caption">
            <span>Report</span>
            <span>Witnesses</span>
            <span>Collection</span>
          </div>
        </div>
      </article>
    </section>

    <section class="projects-worklist hc-container" aria-labelledby="worklist-title">
      <header class="worklist-head" data-reveal>
        <h2 id="worklist-title" class="worklist-head__title">The workbench.</h2>
        <span class="worklist-head__rule" aria-hidden="true"></span>
        <span class="worklist-head__count">{workbench.length} initiatives</span>
      </header>

      <div class="worklist" role="list">
        {workbench.map((project, index) => (
          <article class="work-row" role="listitem" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <div class="work-row__status">
              <span class:list={['project-chip', `project-chip--${project.statusMod}`]}>
                {project.status}
              </span>
            </div>
            <div class="work-row__main">
              <h3 class="work-row__title">{project.title}</h3>
              <p class="work-row__desc">{project.description}</p>
            </div>
            <div class="work-row__tags" aria-label={`${project.title} keywords`}>
              {project.meta.map((tag) => (
                <span class="work-row__tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="projects-cta hc-container" aria-labelledby="projects-cta-title" data-reveal>
      <div class="cta-panel">
        <div class="cta-panel__content">
          <p class="hc-eyebrow">Collaboration</p>
          <h2 id="projects-cta-title" class="cta-panel__title">Contribute to the archive.</h2>
          <p class="cta-panel__copy">
            HadithCritic projects are developed for source-level research. If you work in Islamic
            manuscript studies, digital humanities, or hadith criticism, collaboration is welcome.
          </p>
          <div class="cta-panel__actions">
            <a href="/contact" class="hc-btn">Send a proposal</a>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hc-btn hc-btn--ghost">
              View the code
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector('.projects-page');

  if (page) {
    const items = [...page.querySelectorAll<HTMLElement>('[data-reveal]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced && 'IntersectionObserver' in window) {
      items.forEach((el) => el.classList.add('will-reveal'));

      const observer = new IntersectionObserver(
        (observed) => {
          for (const entry of observed) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      items.forEach((el) => observer.observe(el));
    } else {
      items.forEach((el) => el.classList.add('is-revealed'));
    }
  }
</script>

<style>
  .projects-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 85% 10%, rgba(216, 177, 102, 0.06), transparent 30%),
      radial-gradient(circle at 15% 40%, rgba(164, 106, 63, 0.07), transparent 28%),
      linear-gradient(180deg, var(--hc-charcoal) 0%, var(--hc-black) 60%);
  }

  /* Reveal machinery */

  .will-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.75s var(--ease),
      transform 0.75s var(--ease);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .will-reveal.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hero */

  .projects-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(6rem, 9vw, 8.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--hc-rule);
  }

  .projects-hero::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(216, 177, 102, 0.12);
    pointer-events: none;
  }

  .projects-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .projects-hero__label {
    margin: 0 0 1rem;
    animation: heroRise 0.7s var(--ease) both;
  }

  .projects-hero__title {
    margin: 0;
    max-width: 11em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3rem, 7vw, 6.4rem);
    letter-spacing: -0.04em;
    line-height: 0.94;
    color: var(--hc-parchment);
    animation: heroRise 0.8s var(--ease) 70ms both;
  }

  .projects-hero__title em {
    font-style: italic;
    color: var(--hc-gold);
  }

  .projects-hero__lead {
    max-width: 640px;
    margin: 1.3rem 0 0;
    color: var(--hc-muted);
    font-size: clamp(1.02rem, 0.4vw + 0.98rem, 1.2rem);
    line-height: 1.72;
    animation: heroRise 0.8s var(--ease) 150ms both;
  }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Lead panel with isnad diagram */

  .projects-lead {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .lead-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(1.75rem, 4vw, 3.25rem);
    border: 1px solid var(--hc-rule);
    background:
      radial-gradient(circle at 80% 20%, rgba(216, 177, 102, 0.07), transparent 40%),
      linear-gradient(180deg, rgba(38, 35, 31, 0.88), rgba(15, 15, 16, 0.96));
    box-shadow: var(--shadow);
  }

  .lead-panel::before {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(216, 177, 102, 0.1);
    pointer-events: none;
  }

  .lead-panel__content {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .lead-panel__title {
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 5vw, 4.6rem);
    letter-spacing: -0.04em;
    line-height: 0.94;
    color: var(--hc-parchment);
  }

  .lead-panel__desc {
    max-width: 54ch;
    margin: 1.1rem 0 0;
    color: var(--hc-muted);
    font-size: clamp(1rem, 0.3vw + 0.96rem, 1.1rem);
    line-height: 1.74;
  }

  .lead-panel__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.6rem;
  }

  .lead-panel__tag,
  .work-row__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-pill);
    color: var(--hc-muted);
    background: rgba(242, 235, 220, 0.04);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  /* Isnad diagram */

  .lead-panel__diagram {
    position: relative;
    z-index: 1;
  }

  .isnad-svg {
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
    overflow: visible;
  }

  .chain-line {
    stroke: rgba(216, 177, 102, 0.5);
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .is-revealed .chain-line {
    animation: drawChain 0.9s var(--ease) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes drawChain {
    to {
      stroke-dashoffset: 0;
    }
  }

  .chain-node {
    fill: var(--hc-charcoal-2);
    stroke: var(--hc-gold-dim);
    stroke-width: 1;
    opacity: 0;
    transform: scale(0.3);
    transform-origin: center;
    transform-box: fill-box;
  }

  .is-revealed .chain-node {
    animation: nodeIn 0.45s var(--ease) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes nodeIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .chain-node--root {
    fill: var(--hc-gold);
    stroke: var(--hc-gold-soft);
  }

  .chain-node--link {
    fill: var(--hc-umber);
    stroke: var(--hc-gold);
  }

  .lead-panel__diagram-caption {
    display: flex;
    justify-content: space-between;
    max-width: 360px;
    margin: 1rem auto 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--hc-rule-soft);
    color: var(--hc-gold-dim);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Status chips */

  .project-chip {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    padding: 0.22rem 0.7rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-pill);
    color: var(--hc-gold-soft);
    background: rgba(216, 177, 102, 0.08);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    line-height: 1.25;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .project-chip--soon {
    color: #e8c87a;
    border-color: rgba(216, 177, 102, 0.45);
    background: rgba(216, 177, 102, 0.12);
  }

  .project-chip--research {
    color: #c9a96e;
    border-color: rgba(201, 169, 110, 0.4);
    background: rgba(201, 169, 110, 0.1);
  }

  .project-chip--dev {
    color: #9cb892;
    border-color: rgba(88, 116, 81, 0.5);
    background: rgba(88, 116, 81, 0.14);
  }

  .project-chip--plan {
    color: var(--hc-muted);
    border-color: var(--hc-rule);
    background: rgba(242, 235, 220, 0.05);
  }

  .project-chip--proto {
    color: #d4a88a;
    border-color: rgba(212, 168, 138, 0.4);
    background: rgba(212, 168, 138, 0.1);
  }

  /* Worklist */

  .projects-worklist {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .worklist-head {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .worklist-head__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 3.5vw, 3.1rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--hc-parchment);
  }

  .worklist-head__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--hc-rule), transparent);
  }

  .worklist-head__count {
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .worklist {
    border-top: 1px solid var(--hc-rule);
  }

  .work-row {
    position: relative;
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr) 220px;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.1rem) clamp(0.5rem, 1.5vw, 1.25rem);
    border-bottom: 1px solid var(--hc-rule-soft);
    transition: background 250ms ease;
  }

  .work-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--hc-gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 320ms var(--ease);
  }

  .work-row:hover {
    background: linear-gradient(90deg, rgba(216, 177, 102, 0.05), transparent 55%);
  }

  .work-row:hover::before {
    transform: scaleY(1);
  }

  .work-row__main {
    min-width: 0;
  }

  .work-row__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.7rem, 2.6vw, 2.5rem);
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--hc-parchment);
    transition: color 220ms ease;
  }

  .work-row:hover .work-row__title {
    color: var(--hc-gold-soft);
  }

  .work-row__desc {
    max-width: 60ch;
    margin: 0.7rem 0 0;
    color: var(--hc-muted);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  .work-row__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  /* CTA */

  .projects-cta {
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }

  .cta-panel {
    position: relative;
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid rgba(216, 177, 102, 0.4);
    border-radius: var(--radius-xs);
    color: var(--hc-parchment);
    background: linear-gradient(rgba(164, 106, 63, 0.88), rgba(110, 59, 36, 0.94));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.26);
  }

  .cta-panel::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(242, 235, 220, 0.22);
    pointer-events: none;
  }

  .cta-panel__content {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }

  .cta-panel .hc-eyebrow {
    color: var(--hc-parchment-deep);
  }

  .cta-panel__title {
    margin: 0.45rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 3vw, 2.75rem);
    letter-spacing: -0.025em;
    line-height: 1.02;
    color: var(--hc-parchment);
  }

  .cta-panel__copy {
    margin: 0.85rem 0 0;
    color: rgba(242, 235, 220, 0.86);
    line-height: 1.7;
  }

  .cta-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.55rem;
  }

  .cta-panel .hc-btn--ghost {
    color: var(--hc-parchment);
    border-color: rgba(242, 235, 220, 0.4);
  }

  /* Responsive */

  @media (max-width: 1000px) {
    .lead-panel {
      grid-template-columns: 1fr;
    }

    .lead-panel__diagram {
      max-width: 420px;
    }

    .work-row {
      grid-template-columns: 150px minmax(0, 1fr);
    }

    .work-row__tags {
      grid-column: 2;
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .projects-hero::before {
      inset: 10px;
    }

    .work-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .work-row__tags {
      grid-column: 1;
    }

    .worklist-head {
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }
  }
</style>
