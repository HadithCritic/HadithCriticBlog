  .ledger__rows { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; margin: 0; padding: 0 0.4rem 0.4rem; list-style: none; }
  .ledger__rows li { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0; border-bottom: 1px solid var(--hc-rule-soft); font-size: 0.95rem; }
  .ledger__dot { width: 8px; height: 8px; background: var(--hc-gold); opacity: var(--o); }
  .ledger__name { flex: 1; color: var(--hc-text-secondary); }
  .ledger__count { color: var(--hc-text-primary); font-variant-numeric: tabular-nums; }

  /* Dock: search and format filters */
  .dockwrap { padding-top: 1.5rem; }
  .dock { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; padding: 6px; border: 1px solid var(--hc-rule); border-radius: 4px; background: var(--hc-surface-2); box-shadow: 0 14px 34px rgba(0, 0, 0, 0.35); }
  .dock__field { flex: 1 1 260px; display: flex; align-items: center; gap: 0.6rem; min-height: 44px; padding: 0 0.8rem; border: 1px solid var(--hc-rule-soft); border-radius: 2px; background: var(--hc-surface-0); color: var(--hc-text-tertiary); }
  .dock__field:focus-within { border-color: var(--hc-gold); box-shadow: 0 0 0 1px var(--hc-gold); }
  .dock__input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: var(--hc-text-primary); font: 400 0.95rem var(--font-body); }
  /* The field's own border carries focus, so the input inside gives up its ring instead of doubling it. */
