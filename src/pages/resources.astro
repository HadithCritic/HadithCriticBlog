  .sec__count { min-width: 1.9rem; padding: 0.1rem 0.5rem; border: 1px solid var(--hc-rule-soft); border-radius: var(--radius-pill, 999px); color: var(--hc-text-secondary); font: 500 0.85rem var(--font-ui); text-align: center; font-variant-numeric: tabular-nums; }

  /* Entries */
  .list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .entry__go { grid-area: go; color: var(--hc-gold-dim); transition: color 0.2s ease, transform 0.25s var(--ease); }
  .entry__link:hover .entry__go { color: var(--hc-gold); transform: translate(2px, -2px); }
  .entry__body { grid-area: body; align-self: start; }
  .entry__title { display: block; text-wrap: balance; color: var(--hc-text-primary); font: 600 1.05rem/1.35 var(--font-display); letter-spacing: -0.015em; transition: color 0.2s ease; }
  .entry__link:hover .entry__title { color: var(--hc-gold-bright); }
  .entry__desc { display: block; text-wrap: pretty; margin-top: 0.35rem; color: var(--hc-text-secondary); font-size: 0.95rem; line-height: 1.6; }

  /* GitBooks: a compact numbered index, hairline rows instead of a card each */
  .sec--gitbooks .list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(1.5rem, 4vw, 3rem); border-top: 1px solid var(--hc-rule-soft); counter-reset: index; }
  .sec--gitbooks .entry { counter-increment: index; }
  .sec--gitbooks .entry__link { position: relative; display: grid; grid-template-columns: 1.9rem minmax(0, 1fr) auto; grid-template-areas: 'no body go'; align-items: start; align-content: start; gap: 0 0.6rem; height: 100%; padding: 0.68rem 0.6rem 0.72rem 0; border-bottom: 1px solid var(--hc-rule-soft); color: inherit; text-decoration: none; transition: background 0.2s ease, box-shadow 0.2s ease; }
  .sec--gitbooks .entry__link::before { content: counter(index, decimal-leading-zero); grid-area: no; padding-top: 0.12rem; color: var(--hc-gold-dim); font: 500 0.88rem var(--font-display); font-variant-numeric: lining-nums tabular-nums; }
  .sec--gitbooks .entry__link:hover { background: rgba(216, 177, 102, 0.06); box-shadow: inset 2px 0 0 var(--hc-gold-dim); }
  .sec--gitbooks .entry__go { padding-top: 0.15rem; }
  .sec--gitbooks .entry__title { font-size: 0.98rem; line-height: 1.3; }
  .sec--gitbooks .entry__desc { margin-top: 0.1rem; font-size: 0.875rem; line-height: 1.45; }

  /* Channels and blogs: modules in each channel's own colors */
  .sec--youtube .list, .sec--blogs .list, .sec--pdfs .list, .sec--apps .list, .sec--featured .list { gap: 10px; }
  .sec--youtube .list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .sec--blogs .list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (min-width: 1001px) { .sec--youtube .list, .sec--blogs .list { grid-auto-rows: 1fr; } }
  .entry--tile:first-child { grid-column: span 2; }
  .tile { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: 'mark head go' 'desc desc desc'; align-content: start; align-items: center; gap: 0.85rem 0.9rem; height: 100%; min-height: 9.25rem; padding: 1.05rem 1.1rem 1.15rem; border-radius: 2px; background: var(--tile-bg); color: var(--tile-ink); text-decoration: none; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tile-ink) 16%, transparent); transition: box-shadow 0.2s ease; }
  .tile:hover { box-shadow: inset 0 0 0 2px var(--tile-accent); }
  .tile__mark { grid-area: mark; display: grid; place-items: center; width: 46px; height: 46px; overflow: hidden; border-radius: 50%; box-shadow: 0 0 0 1.5px color-mix(in srgb, var(--tile-accent) 60%, transparent); }
  .tile__mark img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tile__initials { display: grid; place-items: center; width: 100%; height: 100%; background: var(--tile-ink); color: var(--tile-bg); font: 600 0.95rem var(--font-display); letter-spacing: 0.02em; }
  .tile__head { grid-area: head; display: grid; gap: 0.1rem; min-width: 0; }
  .tile__name { overflow-wrap: anywhere; font: 600 1.08rem/1.25 var(--font-display); letter-spacing: -0.015em; text-wrap: balance; }
  .tile__handle { overflow-wrap: break-word; color: var(--tile-accent); font: 500 0.88rem/1.3 var(--font-body); }
  .tile__go { grid-area: go; align-self: start; color: var(--tile-accent); transition: transform 0.25s var(--ease); }
  .tile:hover .tile__go { transform: translate(2px, -2px); }
  .tile__desc { grid-area: desc; text-wrap: pretty; color: color-mix(in srgb, var(--tile-ink) 86%, var(--tile-bg)); font-size: 0.92rem; line-height: 1.55; }
  /* The featured channel shows its own numbers along the foot, ruled like a ledger */
  .tile--stats { grid-template-areas: 'mark head go' 'desc desc desc' 'stats stats stats'; grid-template-rows: auto auto 1fr; }
  .tile__stats { grid-area: stats; align-self: end; display: flex; margin-top: 0.4rem; border-top: 1px solid color-mix(in srgb, var(--tile-ink) 16%, transparent); }
  .tile__stat { display: flex; flex-direction: column-reverse; gap: 0.15rem; padding: 0.75rem clamp(0.75rem, 3vw, 1.4rem) 0 0; }
  .tile__stat + .tile__stat { margin-left: clamp(0.75rem, 3vw, 1.4rem); padding-left: clamp(0.75rem, 3vw, 1.4rem); border-left: 1px solid color-mix(in srgb, var(--tile-ink) 16%, transparent); }
  .tile__stat-value { font: 500 1.35rem/1.1 var(--font-display); letter-spacing: -0.02em; font-variant-numeric: lining-nums tabular-nums; }
  .tile__stat-label { color: color-mix(in srgb, var(--tile-ink) 72%, var(--tile-bg)); font: 700 0.75rem/1.3 var(--font-ui); letter-spacing: 0.08em; text-transform: uppercase; }
  .sec--youtube .entry--tile:not(:first-child) .tile { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'mark go' 'head head' 'desc desc'; align-items: start; gap: 0.7rem 0.9rem; }
  .entry--tile:first-child .tile { min-height: 9.25rem; padding: 1.3rem 1.4rem 1.4rem; gap: 1rem 1.1rem; }
