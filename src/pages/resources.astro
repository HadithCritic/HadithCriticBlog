  @media (min-width: 1001px) { .dock { position: sticky; top: 4.75rem; z-index: 20; } }

  /* Catalogue layout */
  .catalog { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem); }
