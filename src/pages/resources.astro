---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Resources | HadithCritic">
  <main class="page-container">
    <section class="index-hero">
      <div class="hc-container">
        <h1 class="hc-title hc-title--xl">Resources</h1>
        <p class="hc-copy" style="max-width: 600px; font-size: 1.2rem; margin-top: 1rem; color: var(--hc-muted);">
          Curated bibliographies, open-source datasets, and study materials.
        </p>
      </div>
    </section>
    <section class="page-content hc-container" style="padding-bottom: 8rem;">
      <div class="projects-grid projects-grid--brand" style="margin-top: 4rem;">
        <article class="project-card">
          <span class="hc-chip">Bibliography</span>
          <h3 class="hc-title">Early Kufan Sources</h3>
          <p class="hc-copy">A curated reading list of primary texts and secondary literature concerning Kufan transmission.</p>
          <a href="#" class="hc-btn hc-btn--ghost" style="margin-top: 1.5rem;">View Collection <span aria-hidden="true">→</span></a>
        </article>
        <article class="project-card">
          <span class="hc-chip">Database</span>
          <h3 class="hc-title">Rijal Critic Index</h3>
          <p class="hc-copy">An indexed glossary of early rijal critics and their respective methodological tendencies.</p>
          <a href="#" class="hc-btn hc-btn--ghost" style="margin-top: 1.5rem;">Access Database <span aria-hidden="true">→</span></a>
        </article>
        <article class="project-card">
          <span class="hc-chip">PDF Archive</span>
          <h3 class="hc-title">Manuscript Fragments</h3>
          <p class="hc-copy">High-resolution scans and transcriptions of relevant early hadith manuscripts from the archive.</p>
          <a href="#" class="hc-btn hc-btn--ghost" style="margin-top: 1.5rem;">Browse Archive <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-container {
    min-height: 100vh;
    background: radial-gradient(circle at 100% 0%, rgba(216, 177, 102, 0.05), transparent 40%), var(--hc-black);
  }
  .index-hero {
    padding: 8rem 0 4rem;
    border-bottom: 1px solid var(--hc-rule);
    background: linear-gradient(180deg, rgba(15, 15, 16, 0.8), var(--hc-black));
  }
</style>
