---
import BaseLayout from '../layouts/BaseLayout.astro';

const resourceCategories = [
    {
        title: "GitBooks",
        subtitle: "Digital Publications",
        items: [
            { title: "Problematic Sahih Hadith", desc: "Critical analysis of widely accepted hadiths and their contradictions with Quranic principles.", url: "https://qurantalk.gitbook.io/problematic-sahih-hadith/" },
            { title: "Hadith Refutation", desc: "Systematic refutation of hadith authority through textual and theological evidence.", url: "https://qurantalk.gitbook.io/hadith-refutation/" },
            { title: "Quran Initial Count", desc: "Mathematical patterns and numerical structure in the Quran's composition.", url: "https://qurantalk.gitbook.io/quran-initial-count/" },
            { title: "Problems in Christianity", desc: "Comparative analysis of Christian theological inconsistencies from a Quranic perspective.", url: "https://qurantalk.gitbook.io/problems-in-christianity/" },
            { title: "False Verses", desc: "Examination of verses incorrectly attributed to divine revelation.", url: "https://qurantalk.gitbook.io/false-verses/" },
            { title: "Muhammad Was Not Illiterate", desc: "Historical and linguistic evidence challenging traditional narratives of prophetic illiteracy.", url: "https://qurantalk.gitbook.io/muhammad-was-not-illiterate/" },
            { title: "Shahada", desc: "Analysis of the testimony of faith and its evolution in Islamic tradition.", url: "https://qurantalk.gitbook.io/shahada/" },
            { title: "Salat", desc: "Quranic approach to prayer practices and ritual worship.", url: "https://qurantalk.gitbook.io/salat/" },
            { title: "Rashad Khalifa Archive", desc: "Comprehensive collection of lectures and videos by Rashad Khalifa.", url: "https://rashad-khalifa-audios-and-videos.gitbook.io/rashad-khalifa-audios-and-videos" },
            { title: "Dietary Prohibitions", desc: "Quranic guidance on permissible and forbidden foods.", url: "https://qurantalk.gitbook.io/dietary-prohibitions/" },
            { title: "Shirk Endorsed by Scholars", desc: "Critical examination of polytheistic practices in mainstream Islamic scholarship.", url: "https://hadiths-organization.gitbook.io/shirk-endorsed-by-the-scholars-of-islam" },
            { title: "Sunni Idol Worship", desc: "Analysis of veneration practices that contradict Quranic monotheism.", url: "https://qurantalk.gitbook.io/sunni-idol-worship" }
        ]
    },
    {
        title: "YouTube Archives",
        subtitle: "Video Lectures & Debates",
        items: [
            { title: "HadithCritic", desc: "Primary channel for critical analysis of hadith sciences and Islamic methodology.", url: "https://www.youtube.com/@HadithCritic/videos" },
            { title: "QuranTalk", desc: "Discussions and lectures focused on Quranic interpretation and practice.", url: "https://www.youtube.com/@QuranTalk/videos" },
            { title: "Submission Archives", desc: "Historical lectures and archived content on Quranic submission.", url: "https://www.youtube.com/@SubmissionArchives/videos" },
            { title: "Submitters Collective", desc: "Community-driven content exploring Quran-alone perspectives.", url: "https://www.youtube.com/@SubmittersCollective" },
            { title: "God Alone", desc: "Educational videos emphasizing strict Quranic monotheism.", url: "https://www.youtube.com/@godalone7427" },
            { title: "Quran Study Archive", desc: "Systematic Quranic study sessions and verse-by-verse analysis.", url: "https://www.youtube.com/@QuranStudyArchive/videos" },
            { title: "QuranicLabs", desc: "Research-focused content on Quranic numerical patterns and structure.", url: "https://www.youtube.com/@QuranicLabs19" }
        ]
    },
    {
        title: "Blogs & Written Content",
        subtitle: "Articles & Research",
        items: [
            { title: "HadithCritic Blog", desc: "Primary blog for detailed analysis and research articles on hadith methodology.", url: "https://hadithcriticblog.com/" },
            { title: "Submission to God", desc: "Theological essays and practical guidance for Quran-centered living.", url: "https://submissiontogod.wordpress.com/" },
            { title: "QuranTalk Blog", desc: "Regular posts on Quranic interpretation and contemporary issues.", url: "https://qurantalkblog.com/" },
            { title: "EJ The Submitter", desc: "Personal reflections and analysis from a Quran-alone perspective.", url: "https://medium.com/@dutchkickboxing1on1" },
            { title: "Team Asset", desc: "Collaborative research on Quranic numerology and mathematical patterns.", url: "https://medium.com/@team.19.asset" }
        ]
    },
    {
        title: "Rashad Khalifa Publications",
        subtitle: "Foundational Texts",
        items: [
            { title: "Quran: The Final Testament", desc: "Complete Quran translation with appendices on mathematical structure.", url: "https://library.wikisubmission.org/file/books/quran-the-final-testament" },
            { title: "Visual Presentation of the Miracle", desc: "Illustrated guide to the mathematical patterns in the Quran.", url: "https://library.wikisubmission.org/file/books/visual-presentation-of-the-miracle" },
            { title: "The Computer Speaks", desc: "Computer-assisted analysis revealing Quranic mathematical structure.", url: "https://library.wikisubmission.org/file/books/the-computer-speaks" },
            { title: "Quran, Hadith and Islam", desc: "Foundational critique of hadith authority from a Quranic perspective.", url: "https://library.wikisubmission.org/file/books/quran-hadith-and-islam-original" }
        ]
    },
    {
        title: "Apps & Digital Tools",
        subtitle: "Mobile & Web Applications",
        items: [
            { title: "WikiSubmission Quran", desc: "Web-based Quran reader with multiple translations and study tools.", url: "https://reader.wikisubmission.org/" },
            { title: "Quran Study App", desc: "Interactive study application with grid view and analysis features.", url: "https://www.quranstudyapp.com/grid" },
            { title: "Submission: Religion of God", desc: "iOS app for Quranic study and submission-focused practice.", url: "https://apps.apple.com/us/app/submission-religion-of-god/id6444260632" }
        ]
    },
    {
        title: "Code 19 & Mathematical Patterns",
        subtitle: "Video Documentaries",
        items: [
            { title: "Proof of Rashad Khalifa", desc: "Documentary evidence supporting Rashad Khalifa's messengership.", url: "https://www.youtube.com/watch?v=BPDkEZoUyXE" },
            { title: "Code 19: A First Look", desc: "Introduction to the mathematical miracle of the Quran.", url: "https://www.youtube.com/watch?v=4TUYIuxkAmQ" },
            { title: "The Divine Firewall", desc: "Explanation of Code 19 as protection against textual corruption.", url: "https://www.youtube.com/watch?v=nO5ikXuDRV8" },
            { title: "The Ha Mim Pattern", desc: "Analysis of numerical patterns in Ha Mim chapters.", url: "https://www.youtube.com/watch?v=upWxuDwXB3Y&t=1s" },
            { title: "The Basmala Evidence", desc: "Mathematical structure of Bismillah in Quranic composition.", url: "https://www.youtube.com/watch?v=c-DepvPR-CI" }
        ]
    }
];
---

<BaseLayout title="Resources | HadithCritic">
    <div class="container" style="padding-top: 100px; padding-bottom: 80px; min-height: 70vh; max-width: 1000px;">
        
        <!-- Hero Section -->
        <div style="text-align: center; margin-bottom: 4rem;">
            <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); background: linear-gradient(135deg, #fef08a 0%, #ca8a04 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 4px 12px rgba(202, 138, 4, 0.3)); margin-bottom: 1.25rem; line-height: 1.1; letter-spacing: -0.02em;">
                Curated Collection
            </h1>
            <p style="color: var(--text-body); font-size: 1.1rem; line-height: 1.8; max-width: 750px; margin: 0 auto; text-shadow: 0 2px 4px rgba(0,0,0,0.8);">
                Comprehensive collection of Quran-centered research materials, publications, video archives, digital tools, and community platforms dedicated to critical analysis of Hadith methodology and Islamic scholarship.
            </p>
        </div>

        <!-- Resource Categories -->
        <div style="display: flex; flex-direction: column; gap: 4rem; margin-bottom: 5rem;">
            {resourceCategories.map(category => (
                <section>
                    <div style="margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-strong);">
                        <h2 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--text-heading); margin-bottom: 0.25rem;">{category.title}</h2>
                        <div style="font-family: var(--font-sans); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--blue-500);">{category.subtitle}</div>
                    </div>
                    
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem;">
                        {category.items.map(item => (
                            <a href={item.url} target="_blank" class="resource-card" style="display: flex; flex-direction: column; background: rgba(20, 20, 20, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; padding: 1.25rem; text-decoration: none; transition: all 0.3s cubic-bezier(0.165,0.84,0.44,1); position: relative; overflow: hidden;">
                                <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.5rem;">
                                    <h3 style="color: #fef08a; font-size: 1.05rem; line-height: 1.3; margin: 0; font-family: var(--font-display); font-weight: 700;" class="resource-title">{item.title}</h3>
                                    <div class="icon-circle" style="width: 26px; height: 26px; border-radius: 50%; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.3s ease;">
                                        <i class="fas fa-external-link-alt" style="color: var(--text-muted); font-size: 0.7rem; transition: color 0.3s;"></i>
                                    </div>
                                </div>
                                <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin: 0; flex: 1;">{item.desc}</p>
                                
                                <div class="read-more-btn" style="margin-top: 1rem; font-family: var(--font-sans); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--blue-500); display: flex; align-items: center; gap: 6px; transition: all 0.3s ease;">
                                    Explore <i class="fas fa-arrow-right" style="transition: transform 0.3s ease;"></i>
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            ))}
        </div>

        <!-- Join the Community CTA -->
        <div style="background: rgba(88, 101, 242, 0.05); backdrop-filter: blur(12px); border: 1px solid rgba(88, 101, 242, 0.3); border-radius: 16px; padding: 3rem; text-align: center; box-shadow: 0 10px 30px rgba(88, 101, 242, 0.15);">
            <div style="width: 64px; height: 64px; background: #5865F2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; box-shadow: 0 0 20px rgba(88, 101, 242, 0.5);">
                <i class="fab fa-discord" style="color: white; font-size: 2rem;"></i>
            </div>
            <h2 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--text-heading); margin-bottom: 1rem;">Join the Community</h2>
            <p style="color: var(--text-body); font-size: 1.1rem; line-height: 1.6; max-width: 600px; margin: 0 auto 2rem;">
                Connect with fellow students and scholars for real-time discussion, Q&A sessions, and collaborative research. The Submission Server provides a dedicated space for thoughtful dialogue on Quranic interpretation and hadith criticism.
            </p>
            <a href="https://discord.gg/SubmissionServer" target="_blank" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.75rem; padding: 14px 32px; font-size: 1.1rem; background: #5865F2; border: none; font-weight: 600; box-shadow: 0 4px 14px rgba(88, 101, 242, 0.4);">
                Join Discord Server <i class="fas fa-arrow-right"></i>
            </a>
        </div>

    </div>

    <style>
        .resource-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 12px 32px rgba(0,0,0,0.8);
            border-color: rgba(202, 138, 4, 0.4) !important;
            background: rgba(20, 20, 20, 0.8) !important;
        }
        .resource-card:hover .resource-title {
            color: #ca8a04 !important;
        }
        .resource-card:hover .icon-circle {
            background: rgba(202, 138, 4, 0.15) !important;
            transform: rotate(15deg) scale(1.1);
        }
        .resource-card:hover .fa-external-link-alt {
            opacity: 1 !important;
            color: #eab308 !important;
        }
        .resource-card:hover .read-more-btn {
            color: #eab308 !important;
        }
        .resource-card:hover .read-more-btn .fa-arrow-right {
            transform: translateX(6px);
        }
    </style>
</BaseLayout>
