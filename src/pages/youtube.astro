</BaseLayout>

<script is:inline>
  (() => {
    const doc = document.documentElement;
    doc.classList.add("yt-motion-enabled");

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const canHover = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;
    const isMobile = window.matchMedia("(max-width: 760px)").matches;
    const revealSelector =
      "[data-hero-reveal], [data-reveal], [data-reveal-card]";

    /* ── Text splitting for character animation ── */
    const splitText = () => {
      document.querySelectorAll("[data-split]").forEach((el) => {
        if (el.dataset.splitDone) return;
        const text = el.textContent.trim();
        el.setAttribute("aria-label", text);
        el.dataset.splitDone = "true";
        el.innerHTML = text
          .split(" ")
          .map(
            (word) =>
              `<span class="split-word" aria-hidden="true">${[...word].map((char) => `<span class="split-char">${char === " " ? "&nbsp;" : char}</span>`).join("")}</span>`,
          )
          .join(" ");
      });
    };

    /* ── Spotlight hover effect ── */
    const setupSpotlights = () => {
      if (!canHover || prefersReduced) return;
      document.querySelectorAll(".spotlight-card").forEach((card) => {
        let rafId = null;
        let lastX = 50,
          lastY = 0;

        card.addEventListener("pointermove", (event) => {
          if (rafId) return;
          rafId = requestAnimationFrame(() => {
            const rect = card.getBoundingClientRect();
            lastX = ((event.clientX - rect.left) / rect.width) * 100;
            lastY = ((event.clientY - rect.top) / rect.height) * 100;
            card.style.setProperty("--spot-x", `${lastX}%`);
            card.style.setProperty("--spot-y", `${lastY}%`);
            rafId = null;
          });
        });

        card.addEventListener("pointerleave", () => {
          if (rafId) cancelAnimationFrame(rafId);
          card.style.setProperty("--spot-x", "50%");
          card.style.setProperty("--spot-y", "0%");
        });
      });
    };

    /* ── 3D stage tilt on hero device ── */
    const setupStageMotion = () => {
      if (!canHover || prefersReduced || isMobile) return;
      document.querySelectorAll("[data-hero-device]").forEach((stage) => {
        let rafId = null;

        stage.addEventListener("pointermove", (event) => {
          if (rafId) return;
          rafId = requestAnimationFrame(() => {
            const rect = stage.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width - 0.5;
            const y = (event.clientY - rect.top) / rect.height - 0.5;
            stage.style.setProperty("--stage-ry", `${x * 3.5}deg`);
            stage.style.setProperty("--stage-rx", `${y * -2.5}deg`);
            rafId = null;
          });
        });

        stage.addEventListener("pointerleave", () => {
          if (rafId) cancelAnimationFrame(rafId);
          stage.style.setProperty("--stage-ry", "0deg");
          stage.style.setProperty("--stage-rx", "0deg");
        });
      });
    };

    /* ── Scroll reveal system ── */
    const setupReveal = () => {
      const items = [...document.querySelectorAll(revealSelector)];
      if (prefersReduced || !("IntersectionObserver" in window)) {
        items.forEach((item) => item.classList.add("is-visible"));
        doc.classList.add("yt-ready");
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
      );

      items.forEach((item) => observer.observe(item));

      requestAnimationFrame(() => {
        doc.classList.add("yt-ready");
        document
          .querySelectorAll("[data-hero-reveal]")
          .forEach((item, index) => {
            item.style.setProperty("--reveal-delay", `${index * 90}ms`);
            item.classList.add("is-visible");
          });
      });
    };

    /* ── Scroll progress bar ── */
    const setupProgress = () => {
      const progress = document.getElementById("yt-progress");
      if (!progress) return;
      let ticking = false;
      const update = () => {
        const max =
          document.documentElement.scrollHeight - window.innerHeight || 1;
        progress.style.transform = `scaleX(${Math.min(window.scrollY / max, 1)})`;
        ticking = false;
      };
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
      update();
    };

    /* ── Featured video player ── */
    const setupPlayer = () => {
      const player = document.getElementById("yt-player");
      const poster = document.getElementById("yt-poster");
      const posterImg = document.getElementById("yt-poster-img");
      const play = document.getElementById("yt-play");
      const embed = document.getElementById("yt-embed");
      const title = document.getElementById("featured-title");
      const description = document.getElementById("featured-description");
      const chip = document.getElementById("featured-chip");
      const link = document.getElementById("featured-link");
      const duration = document.getElementById("yt-player-duration");
      const views = document.getElementById("featured-views");
      const date = document.getElementById("featured-date");
      const metaPanel = document.querySelector(".yt-theater__meta");

      const stopVideo = () => {
        if (embed) embed.innerHTML = "";
        player?.classList.remove("is-playing");
        if (poster) {
          poster.hidden = false;
          poster.style.opacity = "1";
        }
      };

      const playVideo = () => {
        const id = player?.dataset.videoId;
        if (!id || !embed) return;
        embed.innerHTML = `<iframe src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0&modestbranding=1" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>`;
        player?.classList.add("is-playing");
        if (poster) {
          poster.style.opacity = "0";
          window.setTimeout(
            () => {
              poster.hidden = true;
            },
            prefersReduced ? 0 : 260,
          );
        }
      };

      const loadFeatured = (card, autoplay = false) => {
        if (!card || !player) return;
        const data = card.dataset;
        player.dataset.videoId = data.videoId;
        stopVideo();
        if (posterImg) {
          posterImg.src = data.thumbnail;
          posterImg.alt = `Thumbnail: ${data.title}`;
        }
        if (duration) duration.textContent = data.duration || "";
        if (title) title.textContent = data.title || "";
        if (description) description.textContent = data.description || "";
        if (chip) {
          chip.textContent = data.categoryLabel || "";
          chip.style.setProperty(
            "--chip-color",
            data.categoryColor || "#d8b166",
          );
        }
        if (views) views.textContent = `${data.views || "N/A"} views`;
        if (date) date.textContent = data.date || "";
        if (link) link.href = `https://www.youtube.com/watch?v=${data.videoId}`;

        metaPanel?.classList.add("is-updating");
        window.setTimeout(
          () => {
            metaPanel?.classList.remove("is-updating");
          },
          prefersReduced ? 0 : 260,
        );

        document.getElementById("featured")?.scrollIntoView({
          behavior: prefersReduced ? "auto" : "smooth",
          block: "start",
        });

        if (autoplay) window.setTimeout(playVideo, prefersReduced ? 0 : 360);
      };

      play?.addEventListener("click", playVideo);
      document
        .getElementById("video-grid")
        ?.addEventListener("click", (event) => {
          const card = event.target.closest(".yt-card");
          if (!card) return;
          loadFeatured(card, true);
        });
    };

    /* ── Category filter tabs ── */
    const setupFilter = () => {
      const tabs = [...document.querySelectorAll(".yt-filter__tab")];
      const glider = document.getElementById("filter-glider");
      const cards = [...document.querySelectorAll(".yt-card")];
      const empty = document.getElementById("yt-empty");
      let activeFilter = "all";

      const moveGlider = (tab) => {
        if (!glider || !tab) return;
        glider.style.width = `${tab.offsetWidth}px`;
        glider.style.transform = `translateX(${tab.offsetLeft}px)`;
      };

      const active = document.querySelector(".yt-filter__tab.is-active");
      requestAnimationFrame(() => moveGlider(active));

      let resizeTimer;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          moveGlider(document.querySelector(".yt-filter__tab.is-active"));
        }, 100);
      });

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((item) => {
            const selected = item === tab;
            item.classList.toggle("is-active", selected);
            item.setAttribute("aria-selected", selected ? "true" : "false");
          });
          moveGlider(tab);
          const filter = tab.dataset.filter;
          activeFilter = filter;
          let visible = 0;

          cards.forEach((card, index) => {
            const show = filter === "all" || card.dataset.category === filter;
            if (show) {
              visible += 1;
              card.hidden = false;
              card.style.setProperty(
                "--reveal-delay",
                `${Math.min(index * 24, 180)}ms`,
              );
              requestAnimationFrame(() => {
                card.classList.add("is-visible");
                card.classList.remove("is-filtering-out");
              });
            } else {
              card.classList.remove("is-visible");
              card.classList.add("is-filtering-out");
              window.setTimeout(
                () => {
                  if (
                    activeFilter === "all" ||
                    card.dataset.category === activeFilter
                  )
                    return;
                  card.hidden = true;
                },
                prefersReduced ? 0 : 210,
              );
            }
          });

          if (empty) empty.hidden = visible !== 0;
        });
      });
    };

    /* ── Smooth anchor scrolling ── */
    const setupSmoothScroll = () => {
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", (e) => {
          const href = anchor.getAttribute("href");
          if (!href || href === "#") return;
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({
              behavior: prefersReduced ? "auto" : "smooth",
            });
          }
        });
      });
    };

    /* ── Initialize ── */
    const init = () => {
      splitText();
      setupSpotlights();
      setupStageMotion();
      setupReveal();
      setupProgress();
      setupPlayer();
      setupFilter();
      setupSmoothScroll();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>

