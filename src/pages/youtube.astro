const liveById = new Map(youtubeMeta.videos.map((video) => [video.id, video]));

const formatCount = (value: number, decimals = 1): string => {
  if (value < 1000) return String(value);
  const scaled = value / 1000;
  const text = scaled >= 100 ? scaled.toFixed(0) : scaled.toFixed(decimals);
  return `${text.includes(".") ? text.replace(/\.?0+$/, "") : text}K`;
};

const formatClock = (totalSeconds: number): string => {
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = String(totalSeconds % 60).padStart(2, "0");
  return hours > 0 ? `${hours}:${String(minutes).padStart(2, "0")}:${seconds}` : `${minutes}:${seconds}`;
};

const formatMonth = (iso: string): string =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

const formatRuntime = (minutes: number): string => {
  const rounded = Math.round(minutes);
  const hours = Math.floor(rounded / 60);
  const rest = rounded % 60;
  return hours > 0 ? `${hours}h ${String(rest).padStart(2, "0")}m` : `${rest}m`;
};

const videos: Video[] = catalogue.map((entry) => {
  const live = liveById.get(entry.id);
  return live
    ? {
        ...entry,
        duration: formatClock(live.durationSeconds),
        seconds: live.durationSeconds,
        views: formatCount(live.views),
        date: formatMonth(live.publishedAt),
        dateISO: live.publishedAt.slice(0, 10),
      }
    : entry;
});

const featured = videos.find((video) => video.id === FEATURED_ID) ?? videos[0];
const labelOf = (key: CategoryKey) => categories.find((category) => category.key === key)?.label ?? "";

/* Grid tiles use the 480px frame, which every upload has; the large poster
   asks for the full-resolution frame and falls back to it. */
const frame = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const poster = (id: string) => `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;

const subjects = categories
  .map((category) => {
    const items = videos.filter((video) => video.category === category.key);
    const seconds = items.reduce((total, video) => total + (video.seconds ?? 0), 0);
    return { ...category, count: items.length, runtime: formatRuntime(seconds / 60) };
  })
  .filter((subject) => subject.count > 0);

const totalRuntime = formatRuntime(videos.reduce((total, video) => total + (video.seconds ?? 0), 0) / 60);
const channel = youtubeMeta.channel;
const fetched = new Date(youtubeMeta.fetchedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const n = (value: number) => value.toLocaleString("en-US");
---

<BaseLayout
  image={OG.youtube}
  title="HadithCritic on YouTube | HadithCritic"
  description="The HadithCritic YouTube channel: video investigations of hadith reports and their transmission, lectures on the Quran and Islamic law, and recorded debates."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://i.ytimg.com" />
  </Fragment>

  <div class="hc-page hc-plate yt-page" id="yt-page">
    <!-- Channel masthead -->
    <header class="hc-hero yt-hero" aria-labelledby="yt-title">
      <img
        class="hc-hero__art yt-hero__art"
        src="/images/editorial/youtube-channel.webp"
        srcset="/images/editorial/youtube-channel-520.webp 520w, /images/editorial/youtube-channel.webp 772w"
        sizes="(max-width: 720px) 100vw, 48vw"
        width="772"
        height="720"
        alt=""
        fetchpriority="high"
      />
      <div class="hc-container hc-hero__inner">
        <div class="hc-hero__copy">
          <p class="hc-hero__kicker">YouTube</p>
          <h1 id="yt-title" class="hc-hero__title">HadithCritic <span>on YouTube</span></h1>
          <span class="hc-ornament hc-hero__ornament" aria-hidden="true"></span>
          <p class="hc-hero__lede">
            The HadithCritic channel: video investigations of hadith reports and their transmission,
            lectures on the Quran and Islamic law, and recorded debates.
          </p>
          <p class="yt-channel">
            <img src="/images/brand/geometric-emblem-96.webp" alt="" width="40" height="40" />
            <span class="yt-channel__name">
              <a href={CHANNEL_URL} target="_blank" rel="noopener noreferrer">{channel.handle}<span class="sr-only"> (opens in a new tab)</span></a>
              <span class="hc-meta">
                <span>{n(channel.subscribers)} subscribers</span>
                <span>{n(channel.videos)} videos</span>
                <span>{n(channel.views)} views</span>
              </span>
            </span>
          </p>
          <div class="hc-hero__actions">
            <a href={`${CHANNEL_URL}?sub_confirmation=1`} target="_blank" rel="noopener noreferrer" class="hc-btn">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M23.5 6.19a3 3 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3 3 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3 3 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3 3 0 0 0 2.12-2.14c.5-1.88.5-5.81.5-5.81s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z"></path></svg>
              <span>Subscribe on YouTube</span><span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a href="#archive" class="hc-btn hc-btn--ghost">Browse the videos</a>
          </div>
        </div>
      </div>
      <div class="hc-hero__register">
        <div class="hc-container">
          <span><strong>{videos.length}</strong> videos catalogued here</span>
          <span><strong>{totalRuntime}</strong> of video</span>
          <span><strong>{subjects.length}</strong> subjects</span>
          <span class="yt-hero__asof">Channel figures from YouTube, {fetched}</span>
        </div>
      </div>
    </header>

    <!-- Now showing: one player; any video in the catalogue can be loaded into it. -->
    <section class="hc-band hc-band--soft yt-showing" id="featured" aria-labelledby="featured-title">
      <div class="hc-container yt-theater">
        <div class="yt-player" id="yt-player" data-video-id={featured.id}>
          <a class="yt-player__poster" id="yt-poster" href={`https://www.youtube.com/watch?v=${featured.id}`} target="_blank" rel="noopener noreferrer">
            <img
              id="yt-poster-img"
              src={poster(featured.id)}
              alt=""
              width="1280"
              height="720"
              loading="eager"
              decoding="async"
              onerror={`this.onerror=null;this.src='${frame(featured.id)}'`}
            />
            <span class="yt-play" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
            </span>
            <span class="yt-player__duration" id="yt-player-duration">{featured.duration}</span>
            <span class="sr-only" id="yt-poster-label">Play {featured.title} on YouTube</span>
          </a>
          <div class="yt-player__embed" id="yt-embed"></div>
        </div>

        <div class="yt-dossier">
          <p class="yt-dossier__label">Now showing</p>
          <p class="yt-dossier__subject"><span class="hc-cat" id="featured-subject">{labelOf(featured.category)}</span></p>
          <h2 id="featured-title" class="yt-dossier__title">{featured.title}</h2>
          <p id="featured-description" class="yt-dossier__desc">{featured.description}</p>
          <dl class="yt-dossier__facts">
            <div><dt>Published</dt><dd id="featured-date">{featured.date}</dd></div>
            <div><dt>Length</dt><dd id="featured-duration">{featured.duration}</dd></div>
            <div><dt>Views</dt><dd id="featured-views">{featured.views}</dd></div>
          </dl>
          <div class="yt-dossier__actions">
            <button type="button" class="hc-btn" id="featured-play" data-js-only hidden>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
              <span>Play here</span>
            </button>
            <a id="featured-link" href={`https://www.youtube.com/watch?v=${featured.id}`} target="_blank" rel="noopener noreferrer" class="hc-btn hc-btn--ghost">
              Watch on YouTube <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- The catalogue, by subject -->
    <section class="hc-band yt-archive" id="archive" aria-labelledby="archive-title">
      <div class="hc-container yt-archive__grid">
        <aside class="yt-tools" aria-label="Search and filter the videos">
          <div class="yt-tools__sticky">
            <h2 id="archive-title" class="hc-head__title">All <span>videos</span></h2>
            <p class="hc-head__note">
              {videos.length} videos, newest first, each filed under the subject it spends most of its time on.
            </p>

            <div class="yt-search" role="search" data-js-only hidden>
              <label class="sr-only" for="yt-search-input">Search titles and descriptions</label>
              <div class="hc-field">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input type="search" id="yt-search-input" placeholder="Search titles and descriptions" autocomplete="off" spellcheck="false" />
                <button type="button" id="yt-search-clear" hidden>Clear</button>
              </div>
            </div>

            <div role="group" aria-label="Filter by subject" id="yt-filter-tabs" class="yt-subjects" data-js-only hidden>
              <ul class="hc-filters">
                <li>
                  <button type="button" class="hc-filter yt-filter" data-filter="all" aria-pressed="true">
                    <span>All subjects</span><span class="hc-filter__n">{videos.length}</span>
                  </button>
                </li>
                {subjects.map((subject) => (
                  <li>
                    <button type="button" class="hc-filter yt-filter" data-filter={subject.key} aria-pressed="false">
                      <span>{subject.label}</span>
                      <span class="hc-filter__n">{subject.count}<span class="yt-filter__run"> · {subject.runtime}</span></span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>

            <noscript>
              <ul class="hc-filters yt-subjects-static">
                {subjects.map((subject) => (
                  <li class="hc-filter"><span>{subject.label}</span><span class="hc-filter__n">{subject.count}</span></li>
                ))}
              </ul>
            </noscript>

            <p class="yt-status" role="status" aria-live="polite">
              <span id="yt-status-text"><strong>{videos.length}</strong> videos</span>
              <button type="button" id="yt-reset-btn" class="yt-reset" hidden>Reset</button>
            </p>
          </div>
        </aside>

        <div>
          <ol class="yt-grid" id="video-grid">
            {videos.map((video) => (
              <li
                class="yt-card"
                data-category={video.category}
                data-video-id={video.id}
                data-title={video.title}
                data-description={video.description}
                data-duration={video.duration}
                data-date={video.date}
                data-views={video.views}
                data-category-label={labelOf(video.category)}
                data-search={`${video.title} ${video.description} ${labelOf(video.category)} ${video.date ?? ""}`.toLowerCase()}
              >
                <a class="yt-card__link" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">
                  <span class="yt-card__media">
                    <img src={frame(video.id)} alt="" width="480" height="360" loading="lazy" decoding="async" />
                    {video.duration && <span class="yt-card__duration">{video.duration}</span>}
                  </span>
                  <span class="yt-card__subject"><span class="hc-cat">{labelOf(video.category)}</span></span>
                  <span class="yt-card__title">{video.title}</span>
                  <span class="yt-card__desc">{video.description}</span>
                  <span class="hc-meta yt-card__meta">
                    {video.dateISO && <time datetime={video.dateISO}>{video.date}</time>}
                    {video.views && <span>{video.views} views</span>}
                  </span>
                  <span class="sr-only"> (opens on YouTube)</span>
                </a>
              </li>
            ))}
          </ol>

          <div class="yt-empty" id="yt-empty" hidden>
            <h3>No videos found</h3>
            <p>Nothing in the catalogue matches this search and subject.</p>
            <button type="button" class="hc-btn hc-btn--ghost" id="yt-empty-reset">Clear search and filters</button>
          </div>

          <p class="yt-more">
            This page catalogues {videos.length} of the channel's {n(channel.videos)} uploads.
            <a href={`${CHANNEL_URL}/videos`} target="_blank" rel="noopener noreferrer" class="hc-link">See every upload on YouTube <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          </p>
        </div>
      </div>
    </section>

    <section class="hc-band yt-closing" aria-labelledby="yt-closing-title">
      <div class="hc-container">
        <div class="hc-closing hc-parchment">
          <figure class="hc-closing__plate" style="--plate-focus: 70% 40%">
            <img src="/images/editorial/youtube-channel-520.webp" alt="" width="520" height="485" loading="lazy" decoding="async" />
          </figure>
          <div class="hc-closing__copy">
            <h2 id="yt-closing-title" class="hc-closing__title">Subscribe to the channel.</h2>
            <p class="hc-closing__lead">New investigations, lectures and debates are published on YouTube, where comments and questions on each video are open.</p>
          </div>
          <div class="hc-closing__actions">
            <a href={`${CHANNEL_URL}?sub_confirmation=1`} target="_blank" rel="noopener noreferrer" class="hc-ink-btn">Subscribe on YouTube <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            <a href="https://discord.gg/SubmissionServer" target="_blank" rel="noopener noreferrer" class="hc-ink-btn hc-ink-btn--ghost">Join the Discord <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /* The player and the catalogue filters. Without script every tile and the
     poster are plain links to the video on YouTube, and the whole catalogue
     is listed. */
  function initChannel(): void {
    const page = document.querySelector<HTMLElement>("#yt-page");
    if (!page || page.dataset.ready) return;
    page.dataset.ready = "1";
    page.querySelectorAll<HTMLElement>("[data-js-only]").forEach((element) => (element.hidden = false));

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const player = page.querySelector<HTMLElement>("#yt-player");
    const posterLink = page.querySelector<HTMLAnchorElement>("#yt-poster");
    const posterImg = page.querySelector<HTMLImageElement>("#yt-poster-img");
    const posterLabel = page.querySelector<HTMLElement>("#yt-poster-label");
    const embed = page.querySelector<HTMLElement>("#yt-embed");
    const field = (id: string) => page.querySelector<HTMLElement>(`#${id}`);

    const play = (): void => {
      const id = player?.dataset.videoId;
      if (!id || !embed || !player) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = "YouTube video player";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      iframe.allowFullscreen = true;
      embed.replaceChildren(iframe);
      player.classList.add("is-playing");
      iframe.focus();
    };

    const load = (card: HTMLElement, autoplay: boolean): void => {
      if (!player) return;
      const data = card.dataset;
      const id = data.videoId ?? "";
      player.dataset.videoId = id;
      player.classList.remove("is-playing");
      embed?.replaceChildren();
      if (posterImg) {
        posterImg.onerror = () => {
          posterImg.onerror = null;
          posterImg.src = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
        };
        posterImg.src = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
      }
      const watch = `https://www.youtube.com/watch?v=${id}`;
      posterLink?.setAttribute("href", watch);
      field("featured-link")?.setAttribute("href", watch);
      if (posterLabel) posterLabel.textContent = `Play ${data.title ?? ""} on YouTube`;
      const set = (key: string, value = "") => {
        const element = field(key);
        if (element) element.textContent = value;
      };
      set("featured-title", data.title);
      set("featured-description", data.description);
      set("featured-subject", data.categoryLabel);
      set("featured-date", data.date);
      set("featured-duration", data.duration);
      set("featured-views", data.views);
      set("yt-player-duration", data.duration);
      field("featured")?.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
      if (autoplay) window.setTimeout(play, reduced ? 0 : 320);
    };

    posterLink?.addEventListener("click", (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      play();
    });
    field("featured-play")?.addEventListener("click", play);

    const cards = [...page.querySelectorAll<HTMLElement>(".yt-card")];
    for (const card of cards) {
      card.querySelector<HTMLAnchorElement>(".yt-card__link")?.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        load(card, true);
      });
    }

    /* Subject filter and search. */
    const input = page.querySelector<HTMLInputElement>("#yt-search-input");
    const clear = page.querySelector<HTMLButtonElement>("#yt-search-clear");
    const reset = page.querySelector<HTMLButtonElement>("#yt-reset-btn");
    const empty = page.querySelector<HTMLElement>("#yt-empty");
    const status = page.querySelector<HTMLElement>("#yt-status-text");
    const filters = [...page.querySelectorAll<HTMLButtonElement>(".yt-filter")];
    let subject = "all";
    let query = "";

    const apply = (): void => {
      let shown = 0;
      for (const card of cards) {
        const match =
          (subject === "all" || card.dataset.category === subject) &&
          (!query || (card.dataset.search ?? "").includes(query));
        card.hidden = !match;
        if (match) shown += 1;
      }
      for (const button of filters) button.setAttribute("aria-pressed", String(button.dataset.filter === subject));
      if (empty) empty.hidden = shown > 0;
      if (reset) reset.hidden = subject === "all" && !query;
      if (clear) clear.hidden = !query;
      if (status) {
        const label = filters.find((button) => button.dataset.filter === subject)?.querySelector("span")?.textContent ?? "";
        const noun = shown === 1 ? "video" : "videos";
        status.replaceChildren();
        const strong = document.createElement("strong");
        strong.textContent = String(shown);
        const rest = [
          ` ${noun}`,
          subject !== "all" ? ` in ${label}` : "",
          query ? ` matching “${input?.value.trim() ?? ""}”` : "",
        ].join("");
        status.appendChild(strong);
        status.appendChild(document.createTextNode(rest));
      }
    };

    const resetAll = (): void => {
      subject = "all";
      query = "";
      if (input) input.value = "";
      apply();
    };

    for (const button of filters) {
      button.addEventListener("click", () => {
        subject = button.dataset.filter ?? "all";
        apply();
      });
    }
    input?.addEventListener("input", () => {
      query = input.value.trim().toLowerCase();
      apply();
    });
    clear?.addEventListener("click", () => {
      if (input) {
        input.value = "";
        input.focus();
      }
      query = "";
      apply();
    });
    reset?.addEventListener("click", resetAll);
    page.querySelector("#yt-empty-reset")?.addEventListener("click", resetAll);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initChannel, { once: true });
  } else {
    initChannel();
  }
  document.addEventListener("astro:page-load", initChannel);
</script>
