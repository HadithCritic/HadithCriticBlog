---
import BaseLayout from "../layouts/BaseLayout.astro";
import { OG } from "../lib/seo";
import youtubeMeta from "../data/youtube-meta.json";
import "../styles/house.css";
import "../styles/youtube.css";

/* The HadithCritic channel: what it publishes, the video now showing, and the
   catalogue by subject. Titles and descriptions below are the channel's; the
   counts, dates, durations and views come from the YouTube Data API snapshot
   in src/data/youtube-meta.json (refresh with `npm run sync:youtube`). */

interface Video {
  id: string;
  title: string;
  thumbnail: string;
  category: CategoryKey;
  description: string;
  duration?: string;
  seconds?: number;
  views?: string;
  date?: string;
  dateISO?: string;
}

/* Subjects come from reading the transcripts of all 38 films, not from titles.
   Each film sits under the subject it spends most of its time on. Every
   subject shares the one gold mark: the coloured hues belong to the article
   branches, and seven more would carry no meaning here. */
const categories = [
  { key: "end-times", label: "Prophecy and End Times" },
  { key: "prophet-life", label: "Life of the Prophet" },
  { key: "law-power", label: "Law, Gender and Power" },
  { key: "narrators", label: "Narrators and Grading" },
  { key: "certainty", label: "Certainty and Evidence" },
  { key: "jurists", label: "Jurists and Legal Authority" },
  { key: "quran-creed", label: "Quran and Creed" },
] as const;

type CategoryKey = (typeof categories)[number]["key"];

const FEATURED_ID = "HWHjCfaPn_0";
const CHANNEL_URL = "https://www.youtube.com/@HadithCritic";

const catalogue: Omit<Video, "duration" | "seconds" | "views" | "date" | "dateISO">[] = [
