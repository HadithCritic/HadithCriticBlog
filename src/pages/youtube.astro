    <div class="yt-divider" aria-hidden="true">
      <span class="yt-divider__rule"></span>
      <svg class="yt-divider__emblem" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
