    <section class="yt-cta" id="cta" aria-label="Subscribe call to action">
      <div class="hc-container">
        <div class="yt-cta__panel spotlight-card" data-reveal>
          <div>
            <p class="hc-eyebrow">Join the discourse</p>
            <h2 data-split>Subscribe before the next chain collapses.</h2>
            <p>
              New videos turn source criticism into something visual, memorable,
              and hard to wave away.
            </p>
