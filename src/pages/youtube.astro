---
import BaseLayout from '../layouts/BaseLayout.astro';

const API_KEY = "AIzaSyAqDpPW_jySjz1MXYAVPffj7rdQ7gQRUjA";
const CHANNEL_ID = "UCmHjhB09nmJ9Vz3onswKQfA";
const MAX_RESULTS = 12;

let videos = [];
try {
    const res = await fetch(`https://www.googleapis.com/youtube/v3/search?key=${API_KEY}&channelId=${CHANNEL_ID}&part=snippet,id&order=date&maxResults=${MAX_RESULTS}`);
    if (res.ok) {
        const data = await res.json();
        videos = data.items.filter((item: any) => item.id.kind === 'youtube#video');
    }
} catch (e) {
    console.error("Failed to fetch videos:", e);
}
---

<BaseLayout title="YouTube | HadithCritic">
    <div class="container" style="padding-top: 100px; padding-bottom: 80px; min-height: 70vh;">
        
        <!-- Hero Section -->
        <div style="display: flex; flex-direction: column; align-items: center; text-align: center; max-width: 800px; margin: 0 auto 5rem;">
            <img src="https://hadithcriticblog.com/wp-content/uploads/2026/02/cropped-HCpfp.jpg" alt="HadithCritic Logo" style="width: 120px; height: 120px; border-radius: 50%; border: 2px solid var(--border-strong); margin-bottom: 2rem; box-shadow: var(--shadow-md);">
            
            <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); background: linear-gradient(135deg, #fef08a 0%, #ca8a04 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 4px 12px rgba(202, 138, 4, 0.3)); margin-bottom: 1.25rem; line-height: 1.1; letter-spacing: -0.02em;">
                Beyond Traditional Hadith Studies
            </h1>
            
            <p style="color: var(--text-body); font-size: 1.1rem; line-height: 1.8; max-width: 750px; margin: 0 auto 3rem; text-shadow: 0 2px 4px rgba(0,0,0,0.8);">
                HadithCritic critically examines the "Sciences of Hadith" through interdisciplinary analysis. We use textual criticism, historical research, and philosophical reasoning to question isnād-based methodology, offering a skeptical academic perspective that challenges mainstream assumptions.
            </p>
            
            <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; align-items: center;">
                <a href="https://youtube.com/@HadithCritic" target="_blank" class="btn btn-primary" style="padding: 14px 28px; font-size: 1.1rem; box-shadow: 0 4px 14px rgba(255, 0, 0, 0.2); background: #cc0000; border: none; font-weight: 600;">
                    <i class="fab fa-youtube" style="margin-right: 8px;"></i> Subscribe on YouTube
                </a>
                
                <div style="display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border); padding: 10px 24px; border-radius: 8px;">
                    <span style="font-family: var(--font-sans); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted);">Current Subscribers</span>
                    <span id="subs-count" style="font-family: var(--font-mono); font-size: 1.5rem; font-weight: 700; color: var(--text-heading);">Loading...</span>
                </div>
            </div>
        </div>

        <!-- Featured Videos Section -->
        <div style="margin-bottom: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; border-bottom: 1px solid var(--border-strong); padding-bottom: 1rem;">
                <h2 style="font-family: var(--font-display); font-size: 2rem; color: var(--text-heading); margin: 0;">Latest Videos</h2>
                <a href="https://youtube.com/@HadithCritic" target="_blank" style="color: var(--blue-400); text-decoration: none; font-weight: 500; display: flex; align-items: center; gap: 0.5rem; transition: color 0.2s;" onmouseover="this.style.color='var(--blue-300)'" onmouseout="this.style.color='var(--blue-400)'">
                    View Channel <i class="fas fa-arrow-right"></i>
                </a>
            </div>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2.5rem;">
                {videos.map((video: any) => (
                    <div style="display: flex; flex-direction: column;">
                        <div style="position: relative; padding-top: 56.25%; background: #000; border-radius: 12px; overflow: hidden; margin-bottom: 1rem; border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
                            <iframe src={`https://www.youtube.com/embed/${video.id.videoId}`} style="position: absolute; inset: 0; width: 100%; height: 100%; border: none;" allowfullscreen allow="autoplay; encrypted-media"></iframe>
                        </div>
                        <div>
                            <h3 style="color: var(--text-heading); font-size: 1.1rem; margin-bottom: 0.5rem; line-height: 1.4;" set:html={video.snippet.title}></h3>
                            <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" set:html={video.snippet.description.replace(/(https?:\/\/[^\s]+)/g, '')}></p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <style>
        /* Add any custom styles here if needed */
    </style>

    <script is:inline>
        // Live Subscriber Counter
        const API_KEY = "AIzaSyAqDpPW_jySjz1MXYAVPffj7rdQ7gQRUjA";
        const CHANNEL_ID = "UCmHjhB09nmJ9Vz3onswKQfA";

        async function fetchSubs() {
            try {
                const res = await fetch(`https://www.googleapis.com/youtube/v3/channels?part=statistics&id=${CHANNEL_ID}&key=${API_KEY}`);
                if (!res.ok) throw new Error('API Error');
                const data = await res.json();
                const subs = parseInt(data.items[0].statistics.subscriberCount, 10);
                animateSubs(subs);
            } catch (err) {
                console.error('Failed to fetch subs:', err);
                const el = document.getElementById("subs-count");
                if (el.textContent === "Loading...") {
                    el.textContent = "N/A";
                }
            }
        }

        let lastSubs = 0;
        function animateSubs(newSubs) {
            const el = document.getElementById("subs-count");
            const diff = newSubs - lastSubs;
            const duration = 800;
            const steps = 24;
            let current = lastSubs;
            let step = diff / steps;
            let i = 0;
            
            if (lastSubs === 0) {
                el.textContent = newSubs.toLocaleString();
                lastSubs = newSubs;
                return;
            }

            const interval = setInterval(() => {
                current += step;
                el.textContent = Math.round(current).toLocaleString();
                if (++i >= steps) {
                    clearInterval(interval);
                    el.textContent = newSubs.toLocaleString();
                    lastSubs = newSubs;
                }
            }, duration / steps);
        }

        fetchSubs();
        setInterval(fetchSubs, 30000);
    </script>
</BaseLayout>
