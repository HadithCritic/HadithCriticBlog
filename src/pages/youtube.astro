const categories = [
  {
    key: "epistemology",
    label: "Epistemology",
    color: "#d8b166",
    desc: "How we know what we know",
  },
  {
    key: "prophecy",
    label: "Prophecies",
    color: "#d47565",
    desc: "Debunked ex eventu fabrications",
  },
  {
    key: "history",
    label: "History",
    color: "#b88a64",
    desc: "Critical historiography",
  },
  {
    key: "theology",
    label: "Theology",
    color: "#6a8c74",
    desc: "Quranic theology",
  },
  {
    key: "philosophy",
    label: "Philosophy",
    color: "#6e7e9e",
    desc: "Analytical philosophy",
  },
] as const;

const categoryByKey = Object.fromEntries(
  categories.map((category) => [category.key, category]),
) as Record<Video["category"], (typeof categories)[number]>;

const categoryNarratives: Record<Video["category"], string> = {
  epistemology:
    "An argument about certainty, transmission, and the limits of inherited religious knowledge.",
  prophecy:
    "A source-critical reading of prophecy claims, retrospective fulfillment, and narrative manufacture.",
  history:
    "A historical reconstruction through geography, politics, manuscripts, and transmission layers.",
  theology:
    "A Quranic-theological critique of claims built from later reports and inherited authority.",
  philosophy:
    "A conceptual analysis of authority, language, proof, obligation, and interpretive method.",
};

function getVideoDescription(video: Video) {
  return video.description && video.description.trim().length > 0
    ? video.description
    : categoryNarratives[video.category];
}

function getCategory(category: Video["category"]) {
  return categoryByKey[category] ?? categories[0];
}

const categoryCounts = categories.reduce(
  (acc, cat) => {
    acc[cat.key] = videos.filter((v) => v.category === cat.key).length;
    return acc;
  },
  {} as Record<string, number>,
);
---

<BaseLayout
  title="YouTube Channel & Video Archive | HadithCritic"
  description="Systematic video essays, lectures, and historical debates on hadith transmission, isnad forensics, and early Islamic source criticism."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://img.youtube.com" />
  </Fragment>

  <div class="yt-page" id="yt-page">
    <div class="yt-progress" id="yt-progress" aria-hidden="true"></div>

    <!-- ═══════════════════════════════════════════
         HERO SECTION: Channel Identity & Showcase
         ═══════════════════════════════════════════ -->
    <header class="yt-hero" id="hero" aria-label="HadithCritic YouTube channel introduction" data-motion="hero">
      <div class="hc-container yt-hero__inner">
        <div class="yt-hero__copy">
          <div class="yt-hero__eyebrow">
            <span class="yt-hero__kicker-dot" aria-hidden="true"></span>
            <span class="yt-hero__kicker">Broadcast Channel</span>
            <span class="yt-hero__kicker-sep" aria-hidden="true">/</span>
            <span class="yt-hero__kicker-tag">Video Essays &amp; Debates</span>
          </div>

          <h1 class="yt-hero__title">
            Evidence-Led <span class="yt-hero__title-accent">Forensics</span> for Hadith Literature
          </h1>

          <p class="yt-hero__lead">
            {channelMeta.description}
          </p>

          <div class="yt-hero__actions">
            <a
              href="https://www.youtube.com/@HadithCritic?sub_confirmation=1"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn yt-btn yt-btn--primary"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.19a3 3 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3 3 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3 3 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3 3 0 0 0 2.12-2.14c.5-1.88.5-5.81.5-5.81s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z"></path>
              </svg>
              <span>Subscribe on YouTube</span>
            </a>
            <a href="#featured" class="hc-btn hc-btn--ghost yt-btn">
              <span>Enter Screening Room ↓</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════
         FEATURED THEATER / SCREENING ROOM
         ═══════════════════════════════════════════ -->
    <section class="yt-featured" id="featured" aria-label="Featured video theater">
      <div class="hc-container">
        <div class="yt-section-head">
          <p class="hc-eyebrow">Screening Room</p>
          <h2>Now Playing in the Theater</h2>
          <p>
            Stream the featured monograph directly below, or select any investigation from the archive to load it instantly into the player.
          </p>
        </div>

        <div class="yt-theater">
          <!-- Theater Player -->
          <div
            class="yt-player"
            id="yt-player"
            data-video-id={featuredVideo.id}
          >
            <div class="yt-player__poster" id="yt-poster">
              <img
                id="yt-poster-img"
                src={featuredVideo.thumbnail}
                alt={`Thumbnail: ${featuredVideo.title}`}
                width="1280"
                height="720"
                loading="eager"
              />
              <div class="yt-player__shade" aria-hidden="true"></div>
              <button
                class="yt-player__play"
                id="yt-play"
                type="button"
                aria-label={`Play ${featuredVideo.title}`}
              >
                <span class="yt-player__pulse" aria-hidden="true"></span>
                <span class="yt-player__icon">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28" aria-hidden="true">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                </span>
              </button>
              <span class="yt-player__duration" id="yt-player-duration">{featuredVideo.duration}</span>
            </div>
            <div class="yt-player__embed" id="yt-embed" aria-live="polite"></div>
          </div>

          <!-- Theater Dossier / Metadata Panel -->
          <div class="yt-theater__meta">
            <div class="yt-theater__badge-row">
              <span
                class="yt-cat-badge"
                id="featured-chip"
                style={`--chip-color: ${getCategory(featuredVideo.category).color};`}
              >
                <span class="yt-cat-badge__dot" aria-hidden="true"></span>
                <span id="featured-chip-label">{getCategory(featuredVideo.category).label}</span>
              </span>
              <span class="yt-theater__duration-badge" id="featured-duration-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span id="featured-duration-text">{featuredVideo.duration}</span>
              </span>
            </div>

            <h3 id="featured-title" class="yt-theater__title">{featuredVideo.title}</h3>
            <p id="featured-description" class="yt-theater__desc">
              {getVideoDescription(featuredVideo)}
            </p>

            <div class="yt-theater__footer">
              <div class="yt-theater__meta-items">
                <span class="yt-meta-item">
                  <span class="yt-meta-label">Year</span>
                  <strong id="featured-date">{featuredVideo.date}</strong>
                </span>
                <span class="yt-meta-divider" aria-hidden="true">&bull;</span>
                <span class="yt-meta-item">
                  <span class="yt-meta-label">Format</span>
                  <strong>Video Essay</strong>
                </span>
              </div>

              <div class="yt-theater__actions">
                <button type="button" class="hc-btn yt-theater__play-btn" id="featured-theater-play">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                  <span>Play In Theater</span>
                </button>
                <a
                  id="featured-link"
                  href={`https://www.youtube.com/watch?v=${featuredVideo.id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hc-btn hc-btn--ghost yt-theater__external-link"
                >
                  <span>Open on YouTube</span>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7"></path>
                    <path d="M8 7h9v9"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         ARCHIVE & SEARCH SECTION
         ═══════════════════════════════════════════ -->
    <section class="yt-archive" id="archive" aria-label="Video archive">
      <div class="hc-container">
        <div class="yt-section-head">
          <p class="hc-eyebrow">Catalogue &amp; Forensics</p>
          <h2>The Video Archive</h2>
          <p>Explore all 38 documentary investigations, critical lectures, and debate analyses.</p>
        </div>

        <!-- SEARCH AND FILTER CONTROLS -->
        <div class="yt-controls">
          <!-- Search Bar -->
          <div class="yt-search-wrap">
            <div class="yt-search-box">
              <svg class="yt-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="search"
                id="yt-search-input"
                class="yt-search-input"
                placeholder="Search video titles, debates, topics, or figures (e.g. Baghdad, Bukhari, Crucifixion)..."
                autocomplete="off"
                spellcheck="false"
              />
              <button type="button" id="yt-search-clear" class="yt-search-clear" aria-label="Clear search query" hidden>
                ✕
              </button>
              <kbd class="yt-search-kbd">⌘K</kbd>
            </div>
          </div>

          <!-- Category Filter Tabs -->
          <div class="yt-filter-bar" role="tablist" aria-label="Filter videos by category">
            <div class="yt-filter-tabs" id="yt-filter-tabs">
              <div class="yt-filter-magnet-pill" aria-hidden="true"></div>
              <button
                class="yt-filter-tab is-active"
                type="button"
                role="tab"
                aria-selected="true"
                data-filter="all"
              >
                <span class="yt-filter-tab__dot" aria-hidden="true"></span>
                <span class="yt-filter-tab__label">All Investigations</span>
                <span class="yt-filter-tab__count">{videos.length}</span>
              </button>
              {categories.map((category) => (
                <button
                  class="yt-filter-tab"
                  type="button"
                  role="tab"
                  aria-selected="false"
                  data-filter={category.key}
                  data-category={category.key}
                >
                  <span class="yt-filter-tab__dot" aria-hidden="true"></span>
                  <span class="yt-filter-tab__label">{category.label}</span>
                  <span class="yt-filter-tab__count">{categoryCounts[category.key]}</span>
                </button>
              ))}
            </div>

            <button type="button" id="yt-reset-btn" class="yt-reset-btn" hidden aria-label="Reset all filters">
              <span>Reset Filters</span>
              <span aria-hidden="true">✕</span>
            </button>
          </div>
        </div>

        <!-- Feedback status bar -->
        <div class="yt-status-bar">
          <div class="yt-status-chip" id="yt-status-chip">
            <span class="yt-status-dot" aria-hidden="true"></span>
            <span id="yt-status-text">Showing all <strong>{videos.length}</strong> video monographs</span>
          </div>
        </div>

        <!-- Video Cards Grid -->
        <div class="yt-grid" id="video-grid">
          {videos.map((video, idx) => {
            const category = getCategory(video.category);
            const description = getVideoDescription(video);
            const folio = String(idx + 1).padStart(2, "0");
            return (
              <article
                class="yt-card"
                data-category={video.category}
                data-video-id={video.id}
                data-title={video.title}
                data-description={description}
                data-thumbnail={video.thumbnail}
                data-duration={video.duration}
                data-date={video.date}
                data-category-label={category.label}
                data-category-color={category.color}
                data-search={`${video.title} ${description} ${category.label} ${video.date}`.toLowerCase()}
                style={`--cat-color: ${category.color};`}
              >
                <!-- Thumbnail & Media Layer -->
                <div class="yt-card__media">
                  <img
                    src={video.thumbnail}
                    alt={video.title}
                    width="480"
                    height="270"
                    loading="lazy"
                    class="yt-card__img"
                  />
                  <div class="yt-card__vignette" aria-hidden="true"></div>

                  <div class="yt-card__media-top">
                    <span class="yt-card__folio">DOC · {folio}</span>
                    <span class="yt-card__duration">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span>{video.duration}</span>
                    </span>
                  </div>

                  <div class="yt-card__overlay">
                    <span class="yt-card__play-btn" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </span>
                  </div>
                </div>

                <!-- Card Body -->
                <div class="yt-card__body">
                  <div class="yt-card__header">
                    <span class="yt-card__cat-pill">
                      <span class="yt-card__cat-dot" aria-hidden="true"></span>
                      <span>{category.label}</span>
                    </span>
                    <time class="yt-card__year">{video.date || '2024'}</time>
                  </div>

                  <h3 class="yt-card__title">{video.title}</h3>
                  <p class="yt-card__desc">{description}</p>

                  <div class="yt-card__footer">
                    <span class="yt-card__meta-tag">
                      <span class="yt-card__meta-glyph" aria-hidden="true">◈</span>
                      <span>Monograph</span>
                    </span>
                    <span class="yt-card__action">
                      <span>Stream in Theater</span>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                      </svg>
                    </span>
                  </div>
                </div>

                <button
                  type="button"
                  class="yt-card__hit-button"
                  aria-label={`Stream "${video.title}" in screening room`}
                ></button>
              </article>
            );
          })}
        </div>

        <!-- Empty State -->
        <div class="yt-empty" id="yt-empty" hidden>
          <div class="yt-empty__icon" aria-hidden="true">◈</div>
          <h3>No Investigations Found</h3>
          <p>No video monographs match your current search query or category filter.</p>
          <button type="button" class="hc-btn yt-empty__reset" id="yt-empty-reset">
            Reset Filters &amp; View All
          </button>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         CALL TO ACTION: Discourse & Subscription
         ═══════════════════════════════════════════ -->
    <section class="yt-cta" id="cta" aria-label="Community discourse call to action">
      <div class="hc-container">
        <div class="yt-cta__card">
          <div class="yt-cta__content">
            <p class="hc-eyebrow">Direct Research Stream</p>
            <h2>Subscribe before the next chain collapses.</h2>
            <p>
              Receive new video monographs, debate reviews, and isnad diagrams turning complex manuscript transmission into transparent visual proofs.
            </p>
          </div>
          <div class="yt-cta__buttons">
            <a
              href="https://www.youtube.com/@HadithCritic?sub_confirmation=1"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn yt-btn yt-btn--primary"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.19a3 3 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3 3 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3 3 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3 3 0 0 0 2.12-2.14c.5-1.88.5-5.81.5-5.81s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z"></path>
              </svg>
              <span>Subscribe on YouTube</span>
            </a>
            <a
              href="https://discord.gg/SubmissionServer"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn hc-btn--ghost yt-btn"
            >
              <span>Join Discord Discourse</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ── Scroll progress bar ── */
    const setupProgress = () => {
      const progress = document.getElementById("yt-progress");
      if (!progress) return;
      let ticking = false;
      const update = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight || 1;
        progress.style.transform = `scaleX(${Math.min(window.scrollY / max, 1)})`;
        ticking = false;
      };
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
      update();
    };

    /* ── Featured Video Player & Theater Logic ── */
    const setupPlayer = () => {
      const player = document.getElementById("yt-player");
      const poster = document.getElementById("yt-poster");
      const posterImg = document.getElementById("yt-poster-img");
      const playBtn = document.getElementById("yt-play");
      const theaterPlayBtn = document.getElementById("featured-theater-play");
      const embed = document.getElementById("yt-embed");
      const titleEl = document.getElementById("featured-title");
      const descEl = document.getElementById("featured-description");
      const chipEl = document.getElementById("featured-chip");
      const chipLabelEl = document.getElementById("featured-chip-label");
      const durationText = document.getElementById("featured-duration-text");
      const playerDuration = document.getElementById("yt-player-duration");
      const dateEl = document.getElementById("featured-date");
      const linkEl = document.getElementById("featured-link");

      const stopVideo = () => {
        if (embed) embed.innerHTML = "";
        player?.classList.remove("is-playing");
        if (poster) {
          poster.hidden = false;
          poster.style.opacity = "1";
        }
      };

      const playVideo = () => {
        const id = player?.dataset.videoId;
        if (!id || !embed) return;
        embed.innerHTML = `<iframe src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0&modestbranding=1" title="YouTube video player" style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>`;
        player?.classList.add("is-playing");
        if (poster) {
          poster.style.opacity = "0";
          window.setTimeout(() => {
            poster.hidden = true;
          }, prefersReduced ? 0 : 260);
        }
      };

      const loadFeatured = (card, autoplay = false) => {
        if (!card || !player) return;
        const data = card.dataset;
        player.dataset.videoId = data.videoId;
        stopVideo();

        if (posterImg) {
          posterImg.src = data.thumbnail || "";
          posterImg.alt = `Thumbnail: ${data.title}`;
        }
        if (playerDuration) playerDuration.textContent = data.duration || "";
        if (durationText) durationText.textContent = data.duration || "";
        if (titleEl) titleEl.textContent = data.title || "";
        if (descEl) descEl.textContent = data.description || "";
        if (chipLabelEl) chipLabelEl.textContent = data.categoryLabel || "";
        if (chipEl) {
          chipEl.style.setProperty("--chip-color", data.categoryColor || "var(--hc-gold)");
        }
        if (dateEl) dateEl.textContent = data.date || "2024";
        if (linkEl) linkEl.setAttribute("href", `https://www.youtube.com/watch?v=${data.videoId}`);

        document.getElementById("featured")?.scrollIntoView({
          behavior: prefersReduced ? "auto" : "smooth",
          block: "start",
        });

        if (autoplay) {
          window.setTimeout(playVideo, prefersReduced ? 50 : 350);
        }
      };

      playBtn?.addEventListener("click", playVideo);
      theaterPlayBtn?.addEventListener("click", playVideo);

      document.getElementById("video-grid")?.addEventListener("click", (event) => {
        const card = event.target.closest(".yt-card");
        if (!card) return;
        loadFeatured(card, true);
      });
    };

    /* ── Live Search & Category Filtering with Magnetic Pill ── */
    const setupFilterAndSearch = () => {
      const searchInput = document.getElementById("yt-search-input");
      const searchClear = document.getElementById("yt-search-clear");
      const filterTabsContainer = document.getElementById("yt-filter-tabs");
      const magnetPill = filterTabsContainer?.querySelector(".yt-filter-magnet-pill");
      const resetBtn = document.getElementById("yt-reset-btn");
      const tabs = [...document.querySelectorAll(".yt-filter-tab")];
      const cards = [...document.querySelectorAll(".yt-card")];
      const emptyState = document.getElementById("yt-empty");
      const emptyReset = document.getElementById("yt-empty-reset");
      const statusText = document.getElementById("yt-status-text");

      let activeCategory = "all";
      let activeQuery = "";

      // Dynamic mouse coordinates for card hover spotlight
      cards.forEach((card) => {
        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          card.style.setProperty("--mouse-x", `${x.toFixed(1)}%`);
          card.style.setProperty("--mouse-y", `${y.toFixed(1)}%`);
        });
      });

      // Update magnet sliding pill
      const updateMagnetPill = (tab) => {
        if (!magnetPill || !filterTabsContainer || !tab) return;
        const cRect = filterTabsContainer.getBoundingClientRect();
        const tRect = tab.getBoundingClientRect();
        const left = tRect.left - cRect.left;
        const top = tRect.top - cRect.top;
        magnetPill.style.transform = `translate(${left}px, ${top}px)`;
        magnetPill.style.width = `${tRect.width}px`;
        magnetPill.style.height = `${tRect.height}px`;
        magnetPill.style.opacity = "1";
        const activeBg = getComputedStyle(tab).getPropertyValue("--tab-active-bg").trim() || "var(--hc-gold)";
        magnetPill.style.backgroundColor = activeBg;
        magnetPill.style.boxShadow = `0 2px 14px color-mix(in srgb, ${activeBg} 40%, transparent)`;
      };

      if (filterTabsContainer && magnetPill) {
        filterTabsContainer.setAttribute("data-magnet-ready", "true");
        const initialActive = filterTabsContainer.querySelector(".yt-filter-tab.is-active");
        if (initialActive) updateMagnetPill(initialActive);
        window.addEventListener("resize", () => {
          const active = filterTabsContainer.querySelector(".yt-filter-tab.is-active");
          if (active) updateMagnetPill(active);
        }, { passive: true });
      }

      const applyFilters = () => {
        let visibleCount = 0;
        const total = cards.length;

        cards.forEach((card) => {
          const category = card.dataset.category || "";
          const searchText = card.dataset.search || "";

          const matchesCategory = activeCategory === "all" || category === activeCategory;
          const matchesQuery = !activeQuery || searchText.includes(activeQuery);
          const show = matchesCategory && matchesQuery;

          card.hidden = !show;
          if (show) visibleCount += 1;
        });

        if (emptyState) emptyState.hidden = visibleCount > 0;
        if (searchClear) searchClear.hidden = activeQuery.length === 0;
        if (resetBtn) resetBtn.hidden = activeCategory === "all" && activeQuery.length === 0;

        if (statusText) {
          if (activeQuery) {
            const catStr = activeCategory === "all" ? "" : ` in ${activeCategory}`;
            statusText.innerHTML = `Found <strong>${visibleCount}</strong> ${visibleCount === 1 ? 'investigation' : 'investigations'} matching "${escapeHtml(activeQuery)}"${catStr}`;
          } else if (activeCategory !== "all") {
            statusText.innerHTML = `Showing <strong>${visibleCount}</strong> investigations in ${activeCategory}`;
          } else {
            statusText.innerHTML = `Showing all <strong>${total}</strong> video monographs`;
          }
        }
      };

      function escapeHtml(str) {
        return str
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      const setActiveTab = (tab) => {
        tabs.forEach((t) => {
          const isTarget = t === tab;
          t.classList.toggle("is-active", isTarget);
          t.setAttribute("aria-selected", isTarget ? "true" : "false");
        });
        activeCategory = tab.dataset.filter || "all";
        updateMagnetPill(tab);
        applyFilters();
      };

      // Tab clicks
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          setActiveTab(tab);
        });
      });

      // Search input
      searchInput?.addEventListener("input", (e) => {
        activeQuery = (e.target.value || "").trim().toLowerCase();
        applyFilters();
      });

      // Clear / Reset
      const resetSearchAndFilters = () => {
        if (searchInput) {
          searchInput.value = "";
        }
        activeQuery = "";
        const allTab = tabs.find((t) => t.dataset.filter === "all") || tabs[0];
        if (allTab) {
          setActiveTab(allTab);
        } else {
          activeCategory = "all";
          applyFilters();
        }
      };

      searchClear?.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchInput.focus();
        }
        activeQuery = "";
        applyFilters();
      });

      resetBtn?.addEventListener("click", resetSearchAndFilters);
      emptyReset?.addEventListener("click", resetSearchAndFilters);

      // Check URL query param ?category=
      const urlCategory = new URLSearchParams(window.location.search).get("category");
      if (urlCategory) {
        const matchingTab = tabs.find((t) => t.dataset.filter === urlCategory);
        if (matchingTab) setActiveTab(matchingTab);
      }

      // Keyboard shortcut ⌘K / Ctrl+K
      window.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          searchInput?.focus();
          searchInput?.select();
        } else if (e.key === "Escape" && document.activeElement === searchInput) {
          if (searchInput) {
            searchInput.value = "";
            activeQuery = "";
            applyFilters();
            searchInput.blur();
          }
        }
      });
    };

    const init = () => {
      setupProgress();
      setupPlayer();
      setupFilterAndSearch();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>

<style>
  /* ═══════════════════════════════════════════
     BASE & AMBIENT
     ═══════════════════════════════════════════ */
