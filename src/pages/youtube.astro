<script>
  /* ═══════════════════════════════════════════
     INTERACTIVE LOGIC
     ═══════════════════════════════════════════ */

  document.addEventListener('DOMContentLoaded', () => {
    const stage = document.getElementById('featured-stage');
    const player = document.getElementById('yt-player');
    const poster = document.getElementById('yt-poster');
    const playBtn = document.getElementById('yt-play-btn');
    const embedContainer = document.getElementById('yt-embed');
    const featuredTitle = document.getElementById('featured-title');
    const featuredDesc = document.getElementById('featured-desc');
    const featuredLink = document.getElementById('featured-link');
    const grid = document.getElementById('video-grid');
    const filterTabs = document.querySelectorAll('.yt-filter__tab');
    const emptyState = document.getElementById('grid-empty');

    let isPlaying = false;

    // ── Featured Player ──────────────────────
    function embedVideo(id: string, autoplay = true) {
      if (!embedContainer) return;
      const existing = embedContainer.querySelector('iframe');
      const src = `https://www.youtube.com/embed/${id}?autoplay=${autoplay ? 1 : 0}&rel=0&modestbranding=1`;

      if (existing) {
        existing.src = src;
        return;
      }

      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'YouTube video player';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;z-index:5;';
      embedContainer.appendChild(iframe);

      if (poster) poster.style.opacity = '0';
      if (playBtn) playBtn.style.display = 'none';
      isPlaying = true;
    }

    function setFeatured(videoId: string, title: string, desc: string, thumb: string, views: string, date: string, duration: string) {
      if (player) player.dataset.id = videoId;
      if (featuredTitle) featuredTitle.textContent = title;
      if (featuredDesc) featuredDesc.textContent = desc;
      if (featuredLink) featuredLink.href = `https://www.youtube.com/watch?v=${videoId}`;

      const posterImg = poster?.querySelector('img');
      if (posterImg) {
        posterImg.src = thumb;
        posterImg.alt = `Thumbnail: ${title}`;
      }

      const durBadge = poster?.querySelector('.yt-player__duration');
      if (durBadge) durBadge.textContent = duration;

      // Reset player state
      if (embedContainer) embedContainer.innerHTML = '';
      if (poster) poster.style.opacity = '1';
      if (playBtn) playBtn.style.display = '';
      isPlaying = false;

      // Scroll to featured
      stage?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    playBtn?.addEventListener('click', () => {
      const id = player?.dataset.id;
      if (id) embedVideo(id);
    });

    // ── Card Interactions ────────────────────
    grid?.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest('.yt-card');
      if (!card) return;

      const dataset = (card as HTMLElement).dataset;
      const playBtn = (e.target as HTMLElement).closest('.yt-card__play');

      if (playBtn) {
        // Play button clicked — load into featured and autoplay
        setFeatured(
          dataset.id!,
          dataset.title!,
          dataset.desc!,
          dataset.thumb!,
          dataset.views!,
          dataset.date!,
          dataset.duration!
        );
        setTimeout(() => embedVideo(dataset.id!, true), 400);
      } else {
        // Card body clicked — load into featured (no autoplay)
        setFeatured(
          dataset.id!,
          dataset.title!,
          dataset.desc!,
          dataset.thumb!,
          dataset.views!,
          dataset.date!,
          dataset.duration!
        );
      }
    });

    // ── Category Filter ──────────────────────
    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = (tab as HTMLElement).dataset.filter;

        // Update active tab
        filterTabs.forEach((t) => {
          t.classList.toggle('is-active', t === tab);
          t.setAttribute('aria-selected', String(t === tab));
        });

        // Filter cards
        const cards = grid?.querySelectorAll('.yt-card');
        let visibleCount = 0;

        cards?.forEach((card) => {
          const cat = (card as HTMLElement).dataset.category;
          const show = filter === 'all' || cat === filter;
          (card as HTMLElement).style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
          emptyState.setAttribute('aria-hidden', String(visibleCount > 0));
        }
      });
    });

    // ── Scroll Reveal ──────────────────────────
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );

    document.querySelectorAll('.yt-card, .yt-playlist-card').forEach((el) => {
      observer.observe(el);
    });
  });
</script>

