                </div>

                <div class="yt-card__body">
                  <div class="yt-card__header">
                    <span class="yt-card__cat-pill">
                      <span class="yt-card__cat-dot" aria-hidden="true"></span>
                      <span>{category.label}</span>
                    </span>
                    <div class="yt-card__record-meta">
                      <span class="yt-card__duration">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>{video.duration}</span>
                      </span>
                      <time class="yt-card__year">{video.date}</time>
                    </div>
                  </div>

                  <h3 class="yt-card__title">{video.title}</h3>
                  <p class="yt-card__desc">{description}</p>

                  <div class="yt-card__footer">
                    <span class="yt-card__action">
                      <span>Screen in theater</span>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                      </svg>
                    </span>
                  </div>
                </div>

                <button
                  type="button"
                  class="yt-card__hit-button"
                  aria-label={`Stream "${video.title}" in the screening room`}
                ></button>
              </article>
            );
          })}
        </div>

        <!-- Empty state -->
        <div class="yt-empty" id="yt-empty" hidden>
          <div class="yt-empty__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 6v12M6 12h12"></path>
            </svg>
          </div>
          <h3>No Records Found</h3>
          <p>Nothing in the ledger matches the current query or field filter.</p>
          <button type="button" class="hc-btn yt-empty__reset" id="yt-empty-reset">
            Reset Filters &amp; View Complete Catalogue
          </button>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         CTA — umber apparatus panel
         ═══════════════════════════════════════════ -->
    <section class="yt-cta" id="cta" aria-label="Community discourse call to action">
      <div class="hc-container">
        <div class="yt-cta__card">
          <div class="yt-cta__content">
            <p class="hc-eyebrow">§ III — Direct Research Stream</p>
            <h2>Subscribe before the next chain collapses.</h2>
            <p>
              Receive new video monographs, debate reviews, and isnād diagrams that render complex
              manuscript transmission into transparent visual proofs.
            </p>
          </div>
          <div class="yt-cta__buttons">
            <a
              href="https://www.youtube.com/@HadithCritic?sub_confirmation=1"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn yt-btn yt-btn--primary"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.19a3 3 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3 3 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3 3 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3 3 0 0 0 2.12-2.14c.5-1.88.5-5.81.5-5.81s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z"></path>
              </svg>
              <span>Subscribe on YouTube</span>
            </a>
            <a
              href="https://discord.gg/SubmissionServer"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn hc-btn--ghost yt-btn"
            >
              <span>Join Discord Discourse</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ── Scroll progress hairline ── */
    const setupProgress = () => {
      const progress = document.getElementById("yt-progress");
      if (!progress) return;

      let ticking = false;

      const update = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight || 1;
        progress.style.transform = `scaleX(${Math.min(window.scrollY / max, 1)})`;
        ticking = false;
      };

      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );

      update();
    };

    /* ── Theater player ── */
    const setupPlayer = () => {
      const player = document.getElementById("yt-player");
      const poster = document.getElementById("yt-poster");
      const posterImg = document.getElementById("yt-poster-img");
      const playBtn = document.getElementById("yt-play");
      const theaterPlayBtn = document.getElementById("featured-theater-play");
      const embed = document.getElementById("yt-embed");

      const dossier = {
        title: document.getElementById("featured-title"),
        desc: document.getElementById("featured-description"),
        chip: document.getElementById("featured-chip"),
        chipLabel: document.getElementById("featured-chip-label"),
        durationText: document.getElementById("featured-duration-text"),
        playerDuration: document.getElementById("yt-player-duration"),
        date: document.getElementById("featured-date"),
        views: document.getElementById("featured-views"),
        views: document.getElementById("featured-views"),
        link: document.getElementById("featured-link"),
      };

      const stopVideo = () => {
        if (embed) embed.innerHTML = "";
        player?.classList.remove("is-playing");
        if (poster) {
          poster.hidden = false;
          poster.style.opacity = "1";
        }
      };

      const playVideo = () => {
        const id = player?.dataset.videoId;
        if (!id || !embed) return;

        embed.innerHTML =
          `<iframe src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0&modestbranding=1"` +
          ` title="YouTube video player"` +
          ` style="position:absolute;inset:0;width:100%;height:100%;border:0;display:block;"` +
          ` allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"` +
          ` referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>`;

        player.classList.add("is-playing");
        if (poster) {
          poster.style.opacity = "0";
          window.setTimeout(() => {
            poster.hidden = true;
          }, prefersReduced ? 0 : 260);
        }
      };

      const loadFeatured = (card, autoplay) => {
        if (!card || !player) return;
        const data = card.dataset;

        player.dataset.videoId = data.videoId;
        stopVideo();

        if (posterImg) {
          posterImg.src = data.thumbnail || "";
          posterImg.alt = `Thumbnail: ${data.title}`;
        }
        if (dossier.playerDuration) dossier.playerDuration.textContent = data.duration || "";
        if (dossier.durationText) dossier.durationText.textContent = data.duration || "";
        if (dossier.title) dossier.title.textContent = data.title || "";
        if (dossier.desc) dossier.desc.textContent = data.description || "";
        if (dossier.chipLabel) dossier.chipLabel.textContent = data.categoryLabel || "";
        if (dossier.chip) {
          dossier.chip.style.setProperty("--chip-color", data.categoryColor || "var(--hc-gold)");
        }
        if (dossier.date) dossier.date.textContent = data.date || "";
        if (dossier.views) dossier.views.textContent = data.views || "N/A";
        if (dossier.link) dossier.link.setAttribute("href", `https://www.youtube.com/watch?v=${data.videoId}`);

        document.getElementById("featured")?.scrollIntoView({
          behavior: prefersReduced ? "auto" : "smooth",
          block: "start",
        });

        if (autoplay) {
          window.setTimeout(playVideo, prefersReduced ? 50 : 350);
        }
      };

      playBtn?.addEventListener("click", playVideo);
      theaterPlayBtn?.addEventListener("click", playVideo);

      document.getElementById("video-grid")?.addEventListener("click", (event) => {
        const card = event.target.closest(".yt-card");
        if (!card) return;
        loadFeatured(card, true);
      });
    };

    /* ── Catalogue search & field filtering ── */
    const setupFilterAndSearch = () => {
      const searchInput = document.getElementById("yt-search-input");
      const searchClear = document.getElementById("yt-search-clear");
      const filterTabs = document.getElementById("yt-filter-tabs");
      const magnetPill = filterTabs?.querySelector(".yt-filter-magnet-pill");
      const resetBtn = document.getElementById("yt-reset-btn");
      const tabs = Array.from(document.querySelectorAll(".yt-filter-tab"));
      const cards = Array.from(document.querySelectorAll(".yt-card"));
      const emptyState = document.getElementById("yt-empty");
      const emptyReset = document.getElementById("yt-empty-reset");
      const statusText = document.getElementById("yt-status-text");

      let activeCategory = "all";
      let activeQuery = "";

      const escapeHtml = (str) =>
        str
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");

      /* Pointer spotlight that follows the cursor across each record card. */
      cards.forEach((card) => {
        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          card.style.setProperty("--mouse-x", `${x.toFixed(1)}%`);
          card.style.setProperty("--mouse-y", `${y.toFixed(1)}%`);
        });
      });

      /* Sliding magnet pill tracking the active field tab. */
      const updateMagnetPill = (tab) => {
        if (!magnetPill || !filterTabs || !tab) return;

        const containerRect = filterTabs.getBoundingClientRect();
        const tabRect = tab.getBoundingClientRect();
        const activeBg = getComputedStyle(tab).getPropertyValue("--tab-active-bg").trim() || "var(--hc-gold)";

        magnetPill.style.transform = `translate(${tabRect.left - containerRect.left}px, ${tabRect.top - containerRect.top}px)`;
        magnetPill.style.width = `${tabRect.width}px`;
        magnetPill.style.height = `${tabRect.height}px`;
        magnetPill.style.backgroundColor = activeBg;
        magnetPill.style.boxShadow = `0 2px 14px color-mix(in srgb, ${activeBg} 40%, transparent)`;
        magnetPill.style.opacity = "1";
      };

      if (filterTabs && magnetPill) {
        filterTabs.setAttribute("data-magnet-ready", "true");

        const initialTab = filterTabs.querySelector(".yt-filter-tab.is-active");
        if (initialTab) updateMagnetPill(initialTab);

        window.addEventListener(
          "resize",
          () => {
            const active = filterTabs.querySelector(".yt-filter-tab.is-active");
            if (active) updateMagnetPill(active);
          },
          { passive: true },
        );
      }

      const applyFilters = () => {
        let visibleCount = 0;

        cards.forEach((card) => {
          const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
          const matchesQuery = !activeQuery || (card.dataset.search || "").includes(activeQuery);
          const show = matchesCategory && matchesQuery;

          card.hidden = !show;
          if (show) visibleCount += 1;
        });

        if (emptyState) emptyState.hidden = visibleCount > 0;
        if (searchClear) searchClear.hidden = activeQuery.length === 0;
        if (resetBtn) resetBtn.hidden = activeCategory === "all" && activeQuery.length === 0;

        if (statusText) {
          const noun = visibleCount === 1 ? "record" : "records";

          if (activeQuery) {
            const fieldStr = activeCategory === "all" ? "" : ` under ${activeCategory}`;
            statusText.innerHTML =
              `Filing <strong>${visibleCount}</strong> ${noun} matching "${escapeHtml(activeQuery)}"${fieldStr}`;
          } else if (activeCategory !== "all") {
            statusText.innerHTML = `Filing <strong>${visibleCount}</strong> ${noun} under ${activeCategory}`;
          } else {
            statusText.innerHTML = `Filing <strong>${visibleCount}</strong> records under complete catalogue`;
          }
        }
      };

      const setActiveTab = (tab) => {
        tabs.forEach((t) => {
          const isTarget = t === tab;
          t.classList.toggle("is-active", isTarget);
          t.setAttribute("aria-selected", isTarget ? "true" : "false");
        });

        activeCategory = tab.dataset.filter || "all";
        updateMagnetPill(tab);
        applyFilters();
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => setActiveTab(tab));
      });

      searchInput?.addEventListener("input", (e) => {
        activeQuery = (e.target.value || "").trim().toLowerCase();
        applyFilters();
      });

      const resetSearchAndFilters = () => {
        if (searchInput) searchInput.value = "";
        activeQuery = "";

        const allTab = tabs.find((t) => t.dataset.filter === "all") || tabs[0];
        if (allTab) {
          setActiveTab(allTab);
        } else {
          activeCategory = "all";
          applyFilters();
        }
      };

      searchClear?.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchInput.focus();
        }
        activeQuery = "";
        applyFilters();
      });

      resetBtn?.addEventListener("click", resetSearchAndFilters);
      emptyReset?.addEventListener("click", resetSearchAndFilters);

      /* Deep link: ?category=end-times pre-selects a subject tab. */
      const urlCategory = new URLSearchParams(window.location.search).get("category");
      if (urlCategory) {
        const matchingTab = tabs.find((t) => t.dataset.filter === urlCategory);
        if (matchingTab) setActiveTab(matchingTab);
      }

      /* ⌘K / Ctrl+K focuses search; Escape clears and blurs. */
      window.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          searchInput?.focus();
          searchInput?.select();
          return;
        }

        if (e.key === "Escape" && document.activeElement === searchInput && searchInput) {
          searchInput.value = "";
          activeQuery = "";
          applyFilters();
          searchInput.blur();
        }
      });
    };

    const init = () => {
      setupProgress();
      setupPlayer();
      setupFilterAndSearch();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>

