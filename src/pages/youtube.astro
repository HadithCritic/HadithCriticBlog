  { key: "prophet-life", label: "Life of the Prophet", color: CATEGORY_COLOR },
  { key: "law-power", label: "Law, Gender and Power", color: CATEGORY_COLOR },
  { key: "narrators", label: "Narrators and Grading", color: CATEGORY_COLOR },
  { key: "certainty", label: "Certainty and Evidence", color: CATEGORY_COLOR },
  { key: "jurists", label: "Jurists and Legal Authority", color: CATEGORY_COLOR },
  { key: "quran-creed", label: "Quran and Creed", color: CATEGORY_COLOR },
] as const;

type CategoryKey = (typeof categories)[number]["key"];

const FEATURED_ID = "HWHjCfaPn_0";

const catalogue: Omit<Video, "duration" | "views" | "date">[] = [
