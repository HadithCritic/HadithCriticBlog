    }
    <section class="yt-archive" id="archive" aria-label="Video archive">
      <div class="hc-container">
        <div class="yt-section-head" data-reveal>
          <p class="hc-eyebrow">Browse by theme</p>
          <h2 data-split>Look through the archive</h2>
          <p>Various essays, debates, refutations, and corpus-level studies.</p>
        </div>

        <div
          class="yt-filter spotlight-card"
          data-reveal
          role="tablist"
          aria-label="Filter videos by category"
        >
          <span class="yt-filter__glider" id="filter-glider" aria-hidden="true"
          ></span>
          <button
            class="yt-filter__tab is-active"
            type="button"
            role="tab"
            aria-selected="true"
            data-filter="all"
          >
            <span style="--dot-color: var(--hc-gold);"></span>
            All
            <span class="yt-filter__count">{videos.length}</span>
          </button>
          {
            categories.map((category) => (
              <button
                class="yt-filter__tab"
                type="button"
                role="tab"
