---
import BaseLayout from "../layouts/BaseLayout.astro";
import youtubeMeta from "../data/youtube-meta.json";

/* ───────────────────────────────────────────────
   DATA: Channel metadata + video catalogue
   ──────────────────────────────────────────── */

interface Video {
  id: string;
  title: string;
  thumbnail: string;
  category: CategoryKey;
  description: string;
  duration?: string;
  views?: string;
  date?: string;
}

/* Every subject shares the one gold accent. The site's colored category hues
   belong to the article taxonomy, and seven hues would carry no meaning here. */
const CATEGORY_COLOR = "var(--hc-gold)";

/* Subjects come from reading the transcripts of all 38 films, not from titles.
   Each film sits under the subject it spends most of its time on. */
