---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

/* ───────────────────────────────────────────────
   DATA: Channel metadata + video catalogue
   ─────────────────────────────────────────────── */

interface Video {
  id: string;
  title: string;
  thumbnail: string;
  duration?: string;
  views?: string;
  date?: string;
  category: 'epistemology' | 'prophecy' | 'history' | 'theology' | 'philosophy';
  description?: string;
}

const channelMeta = {
  name: 'HadithCritic',
  tagline: 'Where evidence dismantles dogma.',
  subscribers: '2.95K',
  videos: '47',
  description: 'Rigorous video essays dismantling hadith methodology, exposing fabricated prophecies, and recovering the Quran\'s epistemological framework.',
  avatar: '/images/brand/hc-logo-transparent-512.png',
};

const featuredVideo: Video = {
  id: 'HWHjCfaPn_0',
  title: 'Hadith Can Never Reach Epistemological Certainty.',
  thumbnail: 'https://i.ytimg.com/vi/HWHjCfaPn_0/maxresdefault.jpg',
  duration: '48:32',
  views: '2.6K',
  date: '2024',
  category: 'epistemology',
  description: 'A systematic demolition of the claim that hadith sciences produce certainty. We examine the probabilistic nature of isnād criticism, the problem of common links, and why chains of narration are fundamentally inductive leaps.',
};

const videos: Video[] = [
  {
    id: '6bpJBji3E0M',
    title: "The Truth About 'The Crucifixion of Jesus'",
    thumbnail: 'https://i.ytimg.com/vi/6bpJBji3E0M/maxresdefault.jpg',
    duration: '52:14',
    views: '1.4K',
    date: '2024',
    category: 'theology',
    description: 'Unpacking the Quranic narrative of Jesus and why the crucifixion account in traditional tafsīr contradicts the text itself.',
  },
  {
    id: '3B0rnPGWgKU',
    title: "The Scholars Contradict In Gradings of Hadith (Sahih/Da'if)",
    thumbnail: 'https://i.ytimg.com/vi/3B0rnPGWgKU/maxresdefault.jpg',
    duration: '41:07',
    views: '3.1K',
    date: '2024',
    category: 'epistemology',
    description: 'The same narrator is trustworthy in one book and weak in another. What does this say about the objectivity of hadith criticism?',
  },
  {
    id: 'CG5i14GAZTQ',
    title: 'The Sciences of Hadith are a Joke.',
    thumbnail: 'https://i.ytimg.com/vi/CG5i14GAZTQ/maxresdefault.jpg',
    duration: '38:45',
    views: '6.3K',
    date: '2023',
    category: 'epistemology',
    description: 'A polemical but evidence-based critique of ʿilm al-rijāl, jarḥ wa al-taʿdīl, and the circular logic of hadith authentication.',
  },
  {
    id: 'boG5JTD5yXU',
    title: "Your Sheikh Can't Save You from God",
    thumbnail: 'https://i.ytimg.com/vi/boG5JTD5yXU/maxresdefault.jpg',
    duration: '35:22',
    views: '4.8K',
    date: '2024',
    category: 'theology',
    description: 'On the Quranic mandate for direct accountability and why intermediary authority structures violate the spirit of divine justice.',
  },
  {
    id: 'MLaRB6uGhAk',
    title: 'How One Quranic Story Refutes All Sunni Jurisprudence',
    thumbnail: 'https://i.ytimg.com/vi/MLaRB6uGhAk/maxresdefault.jpg',
    duration: '44:19',
    views: '2.1K',
    date: '2024',
    category: 'history',
    description: 'The story of the Cow (Q. 2:67-73) as a case study in Quranic legal methodology versus madhhab-based derivation.',
  },
  {
    id: 'ETyXzllXFHE',
    title: 'Hadith is Full of Internal Contradictions',
    thumbnail: 'https://i.ytimg.com/vi/ETyXzllXFHE/maxresdefault.jpg',
    duration: '48:09',
    views: '6.4K',
    date: '2025',
    category: 'epistemology',
    description: 'Compiling the most glaring contradictions within the sahih corpus and asking: if these are "authentic," what does authentic even mean?',
  },
  {
    id: '2sgC2CaJxqk',
    title: 'The FAILED Baghdad Hadith Prophecy That Never Was',
    thumbnail: 'https://i.ytimg.com/vi/2sgC2CaJxqk/maxresdefault.jpg',
    duration: '55:33',
    views: '5.2K',
    date: '2025',
    category: 'prophecy',
    description: 'Dissecting the so-called Baghdad prophecy, its Basran fabrication by Saʿīd ibn Jumhān, and how Biblical folklore became "divine foresight."',
  }
];

const categories = [
  { key: 'epistemology', label: 'Epistemology', color: '#d8b166', desc: 'How we know what we know' },
  { key: 'prophecy', label: 'Prophecies', color: '#a84b3e', desc: 'Debunked ex eventu fabrications' },
  { key: 'history', label: 'History', color: '#b88a64', desc: 'Critical historiography' },
  { key: 'theology', label: 'Theology', color: '#6a8c74', desc: 'Quranic theology' },
  { key: 'philosophy', label: 'Philosophy', color: '#6e7e9e', desc: 'Analytical philosophy' },
] as const;

const stats = [
  { value: '47', label: 'Video Essays' },
  { value: '2.95K', label: 'Subscribers' },
  { value: '0', label: 'Hadith Accepted' },
];

const playlists = [
  { title: 'Fabricated Prophecies', count: 12, icon: 'flame' },
  { title: 'Hadith Methodology', count: 18, icon: 'scale' },
  { title: 'Quranic Theology', count: 15, icon: 'book-open' },
  { title: 'Refutations', count: 22, icon: 'sword' },
  { title: 'Philosophy & Logic', count: 8, icon: 'brain' },
  { title: 'Early Islamic History', count: 14, icon: 'scroll' },
];
---

<BaseLayout
  title="YouTube | HadithCritic"
  description="Video essays, lectures, and visual deep-dives into early Islamic history, hadith criticism, and Quranic studies."
>
  {/* ═══════════════════════════════════════════
      HERO: Cinematic channel header
      ═══════════════════════════════════════════ */}
  <section class="yt-hero" aria-label="Channel introduction">
    <div class="yt-hero__bg">
      <div class="yt-hero__grain"></div>
      <div class="yt-hero__orb yt-hero__orb--1"></div>
      <div class="yt-hero__orb yt-hero__orb--2"></div>
      <div class="yt-hero__orb yt-hero__orb--3"></div>
    </div>

    <div class="hc-container yt-hero__content">
      <div class="yt-hero__brand">
        <div class="yt-hero__avatar-ring">
          <div class="yt-hero__avatar">
            <img src={channelMeta.avatar} alt="HadithCritic Avatar" />
          </div>
        </div>
        <div class="yt-hero__meta">
          <p class="hc-eyebrow yt-hero__eyebrow">The Lecture Hall</p>
          <h1 class="yt-hero__title">
            <span class="yt-hero__title-main">{channelMeta.name}</span>
            <span class="yt-hero__title-sub">{channelMeta.tagline}</span>
          </h1>
          <p class="yt-hero__desc">{channelMeta.description}</p>
          <div class="yt-hero__stats">
            {stats.map((s, i) => (
              <div class="yt-hero__stat" style={`--stat-index: ${i}`}>
                <span class="yt-hero__stat-value">{s.value}</span>
                <span class="yt-hero__stat-label">{s.label}</span>
              </div>
            ))}
          </div>
          <div class="yt-hero__actions">
            <a
              href="https://www.youtube.com/@HadithCritic?sub_confirmation=1"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn yt-hero__btn yt-hero__btn--primary"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.19a3 3 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3 3 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3 3 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3 3 0 0 0 2.12-2.14c.5-1.88.5-5.81.5-5.81s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z"/>
              </svg>
              Subscribe
            </a>
            <a
              href="https://www.youtube.com/@HadithCritic/videos"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn hc-btn--ghost yt-hero__btn"
            >
              Browse All Videos
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Decorative manuscript scroll edge */}
    <div class="yt-hero__scroll-edge" aria-hidden="true">
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
        <path d="M0,30 Q360,60 720,30 T1440,30 L1440,60 L0,60 Z" fill="var(--hc-black)"/>
      </svg>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      FEATURED: Immersive theater stage
      ═══════════════════════════════════════════ */}
  <section class="yt-featured" aria-label="Featured lecture">
    <div class="hc-container">
      <div class="yt-featured__header">
        <p class="hc-eyebrow">Featured Essay</p>
        <h2 class="yt-featured__title">Now Playing</h2>
      </div>

      <div class="yt-featured__stage" id="featured-stage">
        {/* Video player container */}
        <div class="yt-player" id="yt-player" data-id={featuredVideo.id}>
          <div class="yt-player__poster" id="yt-poster">
            <img
              src={featuredVideo.thumbnail}
              alt={`Thumbnail: ${featuredVideo.title}`}
              loading="eager"
              width="1280"
              height="720"
            />
            <div class="yt-player__scrim"></div>
            <button
              class="yt-player__play"
              id="yt-play-btn"
              type="button"
              aria-label={`Play ${featuredVideo.title}`}
            >
              <span class="yt-player__play-ring"></span>
              <span class="yt-player__play-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </span>
            </button>
            <span class="yt-player__duration">{featuredVideo.duration}</span>
          </div>
          <div class="yt-player__embed" id="yt-embed"></div>
        </div>

        {/* Featured metadata */}
        <div class="yt-featured__meta">
          <div class="yt-featured__meta-main">
            <span class="yt-chip" style={`background: ${categories.find(c => c.key === featuredVideo.category)?.color}33; color: ${categories.find(c => c.key === featuredVideo.category)?.color}; border-color: ${categories.find(c => c.key === featuredVideo.category)?.color}80;`}>
              {categories.find(c => c.key === featuredVideo.category)?.label}
            </span>
            <h3 class="yt-featured__video-title" id="featured-title">{featuredVideo.title}</h3>
            <p class="yt-featured__video-desc" id="featured-desc">{featuredVideo.description}</p>
            <div class="yt-featured__video-stats">
              <span class="yt-featured__stat">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
                {featuredVideo.views} views
              </span>
              <span class="yt-featured__stat">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                {featuredVideo.date}
              </span>
            </div>
          </div>
          <a
            id="featured-link"
            href={`https://www.youtube.com/watch?v=${featuredVideo.id}`}
            target="_blank"
            rel="noopener noreferrer"
            class="yt-featured__external"
          >
            <span>Watch on YouTube</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7"/><path d="M8 7h9v9"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      CATEGORY FILTER: Horizontal scrollable tabs
      ═══════════════════════════════════════════ */}
  <section class="yt-filter" aria-label="Filter by category">
    <div class="hc-container">
      <div class="yt-filter__track" role="tablist" aria-label="Video categories">
        <button
          class="yt-filter__tab is-active"
          role="tab"
          aria-selected="true"
          data-filter="all"
        >
          <span class="yt-filter__tab-dot" style="--dot-color: #d8b166;"></span>
          All Essays
        </button>
        {categories.map((cat) => (
          <button
            class="yt-filter__tab"
            role="tab"
            aria-selected="false"
            data-filter={cat.key}
          >
            <span class="yt-filter__tab-dot" style={`--dot-color: ${cat.color};`}></span>
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      VIDEO GRID: Masonry-style card layout
      ═══════════════════════════════════════════ */}
  <section class="yt-grid" aria-label="Video catalogue">
    <div class="hc-container">
      <div class="yt-grid__header">
        <h2 class="yt-grid__title">The Archive</h2>
        <p class="yt-grid__subtitle">{videos.length} video essays and counting</p>
      </div>

      <div class="yt-grid__masonry" id="video-grid">
        {videos.map((video, index) => {
          const cat = categories.find(c => c.key === video.category);
          return (
            <article
              class="yt-card"
              data-category={video.category}
              data-id={video.id}
              data-title={video.title}
              data-thumb={video.thumbnail}
              data-desc={video.description}
              data-views={video.views}
              data-date={video.date}
              data-duration={video.duration}
              style={`--card-index: ${index}; --cat-color: ${cat?.color || '#d8b166'};`}
            >
              <div class="yt-card__media">
                <img
                  src={video.thumbnail}
                  alt={video.title}
                  loading="lazy"
                  width="480"
                  height="270"
                />
                <div class="yt-card__scrim"></div>
                <span class="yt-card__duration">{video.duration}</span>
                <button
                  class="yt-card__play"
                  type="button"
                  aria-label={`Play ${video.title}`}
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
                <span class="yt-card__category-badge" style={`background: ${cat?.color};`}>
                  {cat?.label}
                </span>
              </div>
              <div class="yt-card__body">
                <h3 class="yt-card__title">{video.title}</h3>
                <p class="yt-card__desc">{video.description}</p>
                <div class="yt-card__footer">
                  <span class="yt-card__meta">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                    {video.views}
                  </span>
                  <span class="yt-card__meta">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    {video.date}
                  </span>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div class="yt-grid__empty" id="grid-empty" aria-hidden="true">
        <p>No essays found in this category.</p>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      PLAYLISTS: Horizontal scroll showcase
      ═══════════════════════════════════════════ */}
  <section class="yt-playlists" aria-label="Playlists">
    <div class="hc-container">
      <div class="yt-playlists__header">
        <p class="hc-eyebrow">Collections</p>
        <h2 class="yt-playlists__title">Curated Series</h2>
      </div>

      <div class="yt-playlists__scroll">
        {playlists.map((pl, i) => (
          <a
            href={`https://www.youtube.com/@HadithCritic/playlists`}
            target="_blank"
            rel="noopener noreferrer"
            class="yt-playlist-card"
            style={`--pl-index: ${i}`}
          >
            <div class="yt-playlist-card__icon">
              {pl.icon === 'flame' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                </svg>
              )}
              {pl.icon === 'scale' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
                </svg>
              )}
              {pl.icon === 'book-open' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
              )}
              {pl.icon === 'sword' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M14.5 17.5 3 6V3h3l11.5 11.5"/><path d="m13 19 6-6"/><path d="m16 16 4 4"/><path d="m19 21 2-2"/>
                </svg>
              )}
              {pl.icon === 'brain' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.46 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-1.06Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.46 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-1.06Z"/>
                </svg>
              )}
              {pl.icon === 'scroll' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M8 21h12a2 2 0 0 0 2-2v-2H10v2a2 2 0 1 1-4 0V5a2 2 0 1 1 4 0v14"/><path d="M4 15h17"/><path d="M4 11h17"/><path d="M4 7h17"/>
                </svg>
              )}
            </div>
            <h3 class="yt-playlist-card__title">{pl.title}</h3>
            <p class="yt-playlist-card__count">{pl.count} videos</p>
            <div class="yt-playlist-card__arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      CTA: Final conversion panel
      ═══════════════════════════════════════════ */}
  <section class="yt-cta" aria-label="Subscribe call to action">
    <div class="hc-container">
      <div class="yt-cta__panel">
        <div class="yt-cta__panel-border" aria-hidden="true"></div>
        <div class="yt-cta__content">
          <div class="yt-cta__left">
            <p class="hc-eyebrow">Join the discourse</p>
            <h2 class="yt-cta__title">Never miss a dismantling.</h2>
            <p class="yt-cta__copy">
              New video essays drop regularly. Subscribe for notifications on the latest
              refutations, historical deep-dives, and Quranic analyses.
            </p>
          </div>
          <div class="yt-cta__right">
            <a
              href="https://www.youtube.com/@HadithCritic?sub_confirmation=1"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn yt-cta__btn"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.19a3 3 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3 3 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3 3 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3 3 0 0 0 2.12-2.14c.5-1.88.5-5.81.5-5.81s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z"/>
              </svg>
              Subscribe on YouTube
            </a>
            <a
              href="https://discord.gg/hadithcritic"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn hc-btn--ghost yt-cta__btn yt-cta__btn--discord"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
