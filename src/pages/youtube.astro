    <!-- ═══════════════════════════════════════════
         ARCHIVE & SEARCH — the catalogue ledger
         ═══════════════════════════════════════════ -->
    <section class="yt-archive" id="archive" aria-label="Video archive">
      <div class="hc-container">
        <div class="yt-section-head">
          <p class="hc-eyebrow">§ II — Catalogue &amp; Forensics</p>
          <h2>The Video Archive</h2>
          <p>
            Thirty-eight documentary investigations, critical lectures, and debate analyses — indexed,
            searchable, and filed under their field of inquiry.
          </p>
        </div>

        <!-- Search & filter controls -->
        <div class="yt-controls">
          <div class="yt-search-wrap">
            <div class="yt-search-box">
              <svg class="yt-search-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="search"
                id="yt-search-input"
                class="yt-search-input"
                placeholder="Search the catalogue — titles, figures, debates, cities (e.g. Baghdad, Bukhārī, Crucifixion)…"
                autocomplete="off"
