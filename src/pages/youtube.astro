---
import BaseLayout from '../layouts/BaseLayout.astro';

type Video = {
  id: string;
  title: string;
  thumbnail: string;
};

const videos: Video[] = [
  {
    id: 'HWHjCfaPn_0',
    title: 'Hadith Can Never Reach Epistemological Certainty.',
    thumbnail: 'https://i.ytimg.com/vi/HWHjCfaPn_0/hqdefault.jpg'
  },
  {
    id: '6bpJBji3E0M',
    title: "The Truth About 'The Crucifixion of Jesus'",
    thumbnail: 'https://i.ytimg.com/vi/6bpJBji3E0M/hqdefault.jpg'
  },
  {
    id: '3B0rnPGWgKU',
    title: "The Scholars Contradict In Gradings of Hadith (Sahih/Da'if)",
    thumbnail: 'https://i.ytimg.com/vi/3B0rnPGWgKU/hqdefault.jpg'
  },
  {
    id: 'CG5i14GAZTQ',
    title: 'The Sciences of Hadith are a Joke.',
    thumbnail: 'https://i.ytimg.com/vi/CG5i14GAZTQ/hqdefault.jpg'
  },
  {
    id: 'boG5JTD5yXU',
    title: "Your Sheikh Can't Save You from God",
    thumbnail: 'https://i.ytimg.com/vi/boG5JTD5yXU/hqdefault.jpg'
  },
  {
    id: 'MLaRB6uGhAk',
    title: 'How One Quranic Story Refutes All Sunni Jurisprudence',
    thumbnail: 'https://i.ytimg.com/vi/MLaRB6uGhAk/hqdefault.jpg'
  }
];

const featured = videos[0];
---

<BaseLayout
  title="YouTube | HadithCritic"
  description="Video essays, lectures, and visual deep-dives into early Islamic history, hadith criticism, and Quranic studies."
>
  <div class="youtube-page">
    <header class="youtube-hero" aria-labelledby="youtube-hero-title">
      <div class="hc-container youtube-hero__inner">
        <p class="hc-eyebrow youtube-hero__label">The Lecture Hall</p>
        <h1 id="youtube-hero-title" class="youtube-hero__title">
          Watch the <em>argument.</em>
        </h1>
        <p class="youtube-hero__lead">
          Video essays, lectures, and visual deep-dives into early Islamic history,
          hadith criticism, and Quranic studies.
        </p>
        <div class="youtube-hero__actions">
          <a
            href="https://www.youtube.com/@HadithCritic?sub_confirmation=1"
            target="_blank"
            rel="noopener noreferrer"
            class="hc-btn"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.5 6.19a3 3 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3 3 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3 3 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3 3 0 0 0 2.12-2.14c.5-1.88.5-5.81.5-5.81s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z" />
            </svg>
            Subscribe to the channel
          </a>
          <a
            href="https://www.youtube.com/@HadithCritic/videos"
            target="_blank"
            rel="noopener noreferrer"
            class="hc-btn hc-btn--ghost"
          >
            Browse all videos
          </a>
        </div>
      </div>
    </header>

    <section class="theater hc-container" aria-label="Featured lectures">
      <div class="theater__grid">
        <div class="theater__stage">
          <div class="stage-frame" id="stage-frame" data-id={featured.id}>
            <img
              id="stage-poster"
              src={featured.thumbnail}
              alt={`Thumbnail for ${featured.title}`}
              width="480"
              height="360"
            />
            <button class="stage-play" id="stage-play" type="button" aria-label="Play the featured lecture">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </button>
            <div class="stage-frame__scrim" aria-hidden="true"></div>
          </div>

          <div class="stage-meta">
            <h2 class="stage-meta__title" id="stage-title">{featured.title}</h2>
            <a
              id="stage-link"
              href={`https://www.youtube.com/watch?v=${featured.id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="stage-meta__link"
            >
              Watch on YouTube
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7" />
                <path d="M8 7h9v9" />
              </svg>
            </a>
          </div>
        </div>

        <aside class="theater__rail" aria-label="Lecture programme">
          <p class="rail-label">Programme</p>
          <div class="rail-list" role="list">
            {videos.map((video, index) => (
              <button
                type="button"
                role="listitem"
                class:list={['rail-item', index === 0 && 'is-active']}
                data-id={video.id}
                data-title={video.title}
                data-thumb={video.thumbnail}
                style={`--rail-index: ${index}`}
              >
                <span class="rail-item__thumb">
                  <img src={video.thumbnail} alt="" loading="lazy" width="160" height="120" />
                </span>
                <span class="rail-item__title">{video.title}</span>
                <span class="rail-item__marker" aria-hidden="true"></span>
              </button>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section class="youtube-cta hc-container" aria-labelledby="youtube-cta-title">
      <div class="cta-panel">
        <div class="cta-panel__content">
          <p class="hc-eyebrow">Video archive</p>
          <h2 id="youtube-cta-title" class="cta-panel__title">Never miss a lecture.</h2>
          <p class="cta-panel__copy">
            New essays and deep-dives are published regularly on the HadithCritic channel.
          </p>
          <div class="cta-panel__actions">
            <a
              href="https://www.youtube.com/@HadithCritic?sub_confirmation=1"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn"
            >
              Subscribe on YouTube
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector('.youtube-page');

  if (page) {
    const frame = page.querySelector<HTMLDivElement>('#stage-frame');
    const poster = page.querySelector<HTMLImageElement>('#stage-poster');
    const playBtn = page.querySelector<HTMLButtonElement>('#stage-play');
    const stageTitle = page.querySelector<HTMLElement>('#stage-title');
    const stageLink = page.querySelector<HTMLAnchorElement>('#stage-link');
    const railItems = [...page.querySelectorAll<HTMLButtonElement>('.rail-item')];

    let playing = false;

    const embed = (id: string) => {
      if (!frame) return;
      const existing = frame.querySelector('iframe');
      const src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;

      if (existing) {
        existing.src = src;
        return;
      }

      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'YouTube video player';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      iframe.className = 'stage-frame__embed';
      frame.appendChild(iframe);
      frame.classList.add('is-playing');
      playing = true;
    };

    const select = (item: HTMLButtonElement, autoplay: boolean) => {
      const { id, title, thumb } = item.dataset;
      if (!id || !frame) return;

      frame.dataset.id = id;
      railItems.forEach((rail) => rail.classList.toggle('is-active', rail === item));

      if (stageTitle && title) stageTitle.textContent = title;
      if (stageLink) stageLink.href = `https://www.youtube.com/watch?v=${id}`;
      if (poster && thumb) {
        poster.src = thumb;
        poster.alt = `Thumbnail for ${title ?? 'selected lecture'}`;
      }

      if (autoplay || playing) embed(id);
    };

    playBtn?.addEventListener('click', () => {
      if (frame?.dataset.id) embed(frame.dataset.id);
    });

    railItems.forEach((item) => {
      item.addEventListener('click', () => select(item, true));
    });
  }
</script>

<style>
  .youtube-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 75% 8%, rgba(216, 177, 102, 0.06), transparent 28%),
      radial-gradient(circle at 15% 40%, rgba(164, 106, 63, 0.07), transparent 26%),
      linear-gradient(180deg, var(--hc-charcoal) 0%, var(--hc-black) 50%);
  }

  /* Hero */

  .youtube-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(5.5rem, 8vw, 7.5rem) 0 clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--hc-rule);
  }

  .youtube-hero::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(216, 177, 102, 0.12);
    pointer-events: none;
  }

  .youtube-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .youtube-hero__label {
    margin: 0 0 1rem;
    animation: heroRise 0.7s var(--ease) both;
  }

  .youtube-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.2rem, 7vw, 6.4rem);
    letter-spacing: -0.04em;
    line-height: 0.92;
    color: var(--hc-parchment);
    animation: heroRise 0.8s var(--ease) 70ms both;
  }

  .youtube-hero__title em {
    font-style: italic;
    color: var(--hc-gold);
  }

  .youtube-hero__lead {
    max-width: 620px;
    margin: 1.2rem 0 0;
    color: var(--hc-muted);
    font-size: clamp(1.02rem, 0.4vw + 0.98rem, 1.18rem);
    line-height: 1.72;
    animation: heroRise 0.8s var(--ease) 140ms both;
  }

  .youtube-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.9rem;
    animation: heroRise 0.8s var(--ease) 200ms both;
  }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Theater */

  .theater {
    padding-block: clamp(2.75rem, 5vw, 4.25rem);
  }

  .theater__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(300px, 0.9fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: stretch;
  }

  .theater__stage {
    min-width: 0;
    animation: heroRise 0.8s var(--ease) 260ms both;
  }

  .stage-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--hc-rule);
    background: var(--hc-black);
    box-shadow: var(--shadow);
    cursor: pointer;
  }

  .stage-frame::before {
    content: "";
    position: absolute;
    inset: 10px;
    z-index: 3;
    border: 1px solid rgba(216, 177, 102, 0.14);
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .stage-frame.is-playing::before {
    opacity: 0;
  }

  .stage-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
    transition: transform 600ms var(--ease);
  }

  .stage-frame:hover img {
    transform: scale(1.025);
  }

  .stage-frame__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent 45%, rgba(15, 15, 16, 0.72) 100%);
    pointer-events: none;
  }

  .stage-frame.is-playing img,
  .stage-frame.is-playing .stage-frame__scrim,
  .stage-frame.is-playing .stage-play {
    display: none;
  }

  :global(.stage-frame__embed) {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .stage-play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: flex;
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(216, 177, 102, 0.5);
    border-radius: 50%;
    color: var(--hc-black);
    background: rgba(216, 177, 102, 0.94);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
    transform: translate(-50%, -50%);
    transition: transform 250ms var(--ease), background 250ms ease, box-shadow 250ms ease;
  }

  .stage-play svg {
    margin-left: 3px;
  }

  .stage-frame:hover .stage-play {
    background: var(--hc-gold-soft);
    box-shadow: 0 16px 44px rgba(216, 177, 102, 0.3);
    transform: translate(-50%, -50%) scale(1.08);
  }

  .stage-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.15rem;
  }

  .stage-meta__title {
    margin: 0;
    max-width: 24em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.4vw, 2.2rem);
    letter-spacing: -0.02em;
    line-height: 1.04;
    color: var(--hc-parchment);
  }

  .stage-meta__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 200ms ease, gap 200ms ease;
  }

  .stage-meta__link:hover {
    gap: 0.6rem;
    color: var(--hc-gold-soft);
  }

  /* Programme rail */

  .theater__rail {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--hc-rule);
    background: rgba(15, 15, 16, 0.6);
    animation: heroRise 0.8s var(--ease) 340ms both;
  }

  .rail-label {
    margin: 0;
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid var(--hc-rule);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .rail-list {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    flex: 1;
  }

  .rail-item {
    position: relative;
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding: 0.85rem 1.15rem;
    border: 0;
    border-bottom: 1px solid var(--hc-rule-soft);
    background: transparent;
    text-align: left;
    transition: background 250ms ease;
    animation: railEnter 0.6s var(--ease) both;
    animation-delay: calc(380ms + var(--rail-index, 0) * 70ms);
  }

  @keyframes railEnter {
    from {
      opacity: 0;
      transform: translateX(18px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .rail-item:last-child {
    border-bottom: 0;
  }

  .rail-item:hover {
    background: rgba(216, 177, 102, 0.05);
  }

  .rail-item__marker {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--hc-gold);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 300ms var(--ease);
  }

  .rail-item.is-active {
    background: rgba(216, 177, 102, 0.07);
  }

  .rail-item.is-active .rail-item__marker {
    transform: scaleY(1);
  }

  .rail-item__thumb {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--hc-rule-soft);
  }

  .rail-item__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8) contrast(1.04);
    transition: transform 450ms var(--ease);
  }

  .rail-item:hover .rail-item__thumb img {
    transform: scale(1.06);
  }

  .rail-item__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.06rem;
    letter-spacing: -0.01em;
    line-height: 1.14;
    color: var(--hc-parchment);
    transition: color 200ms ease;
  }

  .rail-item:hover .rail-item__title,
  .rail-item.is-active .rail-item__title {
    color: var(--hc-gold-soft);
  }

  /* CTA */

  .youtube-cta {
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }

  .cta-panel {
    position: relative;
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid rgba(216, 177, 102, 0.4);
    border-radius: var(--radius-xs);
    color: var(--hc-parchment);
    background: linear-gradient(rgba(164, 106, 63, 0.88), rgba(110, 59, 36, 0.94));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.26);
  }

  .cta-panel::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(242, 235, 220, 0.22);
    pointer-events: none;
  }

  .cta-panel__content {
    position: relative;
    z-index: 1;
    max-width: 680px;
  }

  .cta-panel .hc-eyebrow {
    color: var(--hc-parchment-deep);
  }

  .cta-panel__title {
    margin: 0.45rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 3vw, 2.75rem);
    letter-spacing: -0.025em;
    line-height: 1.02;
    color: var(--hc-parchment);
  }

  .cta-panel__copy {
    margin: 0.85rem 0 0;
    color: rgba(242, 235, 220, 0.86);
    line-height: 1.7;
  }

  .cta-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.55rem;
  }

  /* Responsive */

  @media (max-width: 1000px) {
    .theater__grid {
      grid-template-columns: 1fr;
    }

    .rail-list {
      flex-direction: row;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
    }

    .rail-item {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      align-items: start;
      min-width: 230px;
      scroll-snap-align: start;
      border-bottom: 0;
      border-right: 1px solid var(--hc-rule-soft);
    }

    .rail-item__marker {
      top: auto;
      right: 0;
      width: auto;
      height: 2px;
      transform: scaleX(0);
    }

    .rail-item.is-active .rail-item__marker {
      transform: scaleX(1);
    }
  }

  @media (max-width: 640px) {
    .youtube-hero::before {
      inset: 10px;
    }

    .stage-play {
      width: 56px;
      height: 56px;
    }

    .rail-item {
      min-width: 200px;
    }
  }
</style>
