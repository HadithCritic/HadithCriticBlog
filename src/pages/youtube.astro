---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { OG } from "../lib/seo";
import { CHANNEL_URL, VIDEO_KINDS, channelLibrary } from "../lib/youtube-library";
import "../styles/yt-lite.css";
import "../styles/youtube.css";

/* The channel page: one featured lecture in a player, then every video as a
   grid of cards that can be narrowed to lectures, debates or shorts and
   sorted. Titles, dates, lengths and views come from the snapshot in
   src/data/site/youtube-meta.json (refresh with `npm run sync:youtube`).

   Every card is a link to the video on YouTube, so the page works without
   script. With script (home-lectures.ts) a card plays in the featured player
   instead, through the youtube-nocookie embed, and the filters and order
   below work in place. */

const { featured, videos, counts } = channelLibrary();
const views = (value: number) => `${value.toLocaleString("en-US")} ${value === 1 ? "view" : "views"}`;
const metaOf = (video: (typeof videos)[number]) => `${video.date} · ${video.duration} · ${views(video.views)}`;
const newTab = '<span class="sr-only"> (opens in a new tab)</span>';
---

<BaseLayout
  image={OG.youtube}
  title="HadithCritic on YouTube | HadithCritic"
  description="The HadithCritic YouTube channel: video investigations of hadith reports and their transmission, lectures on the Quran and Islamic law, and recorded debates."
>
  <div class="hc-page yt-page" data-lectures>
    <PageHero
      title="HadithCritic"
      accent="on YouTube"
      titleId="yt-title"
      kicker="YouTube"
      art="/images/editorial/youtube-hero.webp"
      focus="80% 40%"
      class="yt-hero"
      measure="12ch"
    >
      <p class="hc-hero__lede">
        Video investigations of hadith reports and their transmission, lectures on the Quran and
        Islamic law, and recorded debates.
      </p>
      <Fragment slot="actions">
        <a class="hc-btn" href="#videos">Browse the videos</a>
        <a class="hc-btn hc-btn--ghost" href={`${CHANNEL_URL}?sub_confirmation=1`} target="_blank" rel="noopener noreferrer">
          Subscribe on YouTube<Fragment set:html={newTab} />
        </a>
      </Fragment>
    </PageHero>

    <!-- The player. A card below plays here and the caption follows it. -->
    <section class="hc-band yt-feature" aria-labelledby="yt-feature-title">
      <div class="hc-container yt-feature__grid">
        <div class="yt-feature__stage" data-lecture-stage>
          <a class="yt-lite" href={featured.href} data-video-id={featured.id} aria-label={`Play: ${featured.title}`}>
            <img src={featured.thumbLarge} alt="" width="1280" height="720" loading="eager" decoding="async" />
            <span class="yt-play" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </a>
        </div>

        <div class="yt-feature__copy">
          <p class="yt-feature__label" data-lecture-label>Featured lecture</p>
          <h2 id="yt-feature-title" class="yt-feature__title" data-lecture-title>{featured.title}</h2>
          <p class="yt-feature__meta" data-lecture-meta>{metaOf(featured)}</p>
          <a class="hc-link" href={featured.href} target="_blank" rel="noopener noreferrer" data-lecture-link>
            Watch on YouTube <span aria-hidden="true">↗</span><Fragment set:html={newTab} />
          </a>
          <p class="yt-feature__note">Choose any video below and it plays here.</p>
        </div>
      </div>
    </section>

    <!-- Every video. -->
    <section class="hc-band yt-archive" id="videos" aria-labelledby="yt-archive-title">
      <div class="hc-container">
        <div class="yt-tools">
          <div class="yt-tools__head">
            <h2 id="yt-archive-title" class="hc-head__title">Every <span>video</span></h2>
            <label class="yt-order" data-js-only hidden>
              <span class="sr-only">Order</span>
              <select class="hc-select" data-video-order>
                <option value="newest">Newest first</option>
                <option value="oldest">Oldest first</option>
                <option value="views">Most viewed</option>
              </select>
            </label>
          </div>

          <div class="yt-tools__bar" data-js-only hidden>
            <ul class="hc-chips" aria-label="Show">
              <li>
                <button type="button" class="hc-chip" data-video-filter="all" aria-pressed="true">
                  All <span class="hc-chip__n">{counts.all}</span>
                </button>
              </li>
              {VIDEO_KINDS.filter((kind) => counts[kind.id] > 0).map((kind) => (
                <li>
                  <button type="button" class="hc-chip" data-video-filter={kind.id} aria-pressed="false">
                    {kind.label} <span class="hc-chip__n">{counts[kind.id]}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
          <p class="yt-status" role="status" aria-live="polite" data-video-status>{counts.all} videos</p>
        </div>

        <ol class="yt-grid" data-video-grid>
          {videos.map((video) => (
            <li class="yt-card" data-kind={video.kind} data-timestamp={video.timestamp} data-views={video.views}>
              <a
                class="yt-card__link"
                href={video.href}
                data-play-lecture
                data-video-id={video.id}
                data-title={video.title}
                data-meta={metaOf(video)}
              >
                <span class="yt-card__media">
                  <img
                    src={video.thumb}
                    srcset={`${video.thumbSmall} 320w, ${video.thumb} 480w`}
                    sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 400px"
                    alt=""
                    width="480"
                    height="270"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="yt-card__time">{video.duration}</span>
                  <span class="yt-card__play" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                </span>
                <span class="yt-card__body">
                  <span class="yt-card__meta">
                    <span class="yt-card__kind" data-kind={video.kind}>{video.kindLabel}</span>
                    <time datetime={video.iso}>{video.date}</time>
                  </span>
                  <span class="yt-card__title">{video.title}</span>
                  <span class="yt-card__views">{views(video.views)}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>

        <p class="yt-archive__foot">
          <a class="hc-link" href={`${CHANNEL_URL}/videos`} target="_blank" rel="noopener noreferrer">
            The channel on YouTube <span aria-hidden="true">↗</span><Fragment set:html={newTab} />
          </a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initLectures } from "../lib/home-lectures";
  import { initVideoArchive } from "../lib/youtube-archive";

  function init(): void {
    const page = document.querySelector<HTMLElement>(".yt-page");
    if (!page || page.dataset.ready === "1") return;
    page.dataset.ready = "1";
    initLectures(document);
    initVideoArchive(document);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
</script>
