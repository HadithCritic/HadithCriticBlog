    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.82' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }
  .yt-ambient__grid {
    position: fixed;
    inset: 0;
    opacity: 0.14;
    background-image:
      linear-gradient(rgba(216, 177, 102, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(216, 177, 102, 0.045) 1px, transparent 1px);
    background-size: 76px 76px;
    mask-image: radial-gradient(
      circle at 50% 20%,
      oklch(0% 0 0),
      transparent 74%
    );
  }
  .yt-ambient__orb {
    position: fixed;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    opacity: 0.35;
  }
  .yt-ambient__orb--1 {
    width: 50vw;
    height: 50vw;
    max-width: 600px;
    max-height: 600px;
    top: -10%;
    right: -10%;
    background: oklch(62% 0.235 28 / 0.12);
    animation: yt-orb-drift 20s ease-in-out infinite alternate;
  }
  .yt-ambient__orb--2 {
    width: 40vw;
    height: 40vw;
    max-width: 500px;
    max-height: 500px;
    bottom: 10%;
    left: -5%;
    background: oklch(81% 0.095 76 / 0.08);
    animation: yt-orb-drift 25s ease-in-out infinite alternate-reverse;
  }

  @keyframes yt-orb-drift {
    0% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(30px, -40px) scale(1.1);
    }
  }

  /* ═══════════════════════════════════════════
     SPOTLIGHT CARDS
     ═══════════════════════════════════════════ */
  .spotlight-card {
    position: relative;
    border: 1px solid var(--yt-line);
    background:
      radial-gradient(
        500px circle at var(--spot-x, 50%) var(--spot-y, 0%),
        rgba(216, 177, 102, 0.13),
        transparent 38%
      ),
      linear-gradient(
        145deg,
        rgba(242, 235, 220, 0.075),
        rgba(242, 235, 220, 0.025)
      );
    box-shadow:
      0 30px 90px rgba(0, 0, 0, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.055);
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease;
  }
  .spotlight-card::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(
      420px circle at var(--spot-x, 50%) var(--spot-y, 0%),
      rgba(216, 177, 102, 0.55),
      transparent 45%
    );
    -webkit-mask:
      linear-gradient(oklch(0% 0 0) 0 0) content-box,
      linear-gradient(oklch(0% 0 0) 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .spotlight-card:hover::before {
    opacity: 1;
  }

  /* ═══════════════════════════════════════════
     BUTTONS
     ═══════════════════════════════════════════ */
  .yt-btn {
    border-radius: 999px;
    min-height: 3.15rem;
    padding-inline: 1.35rem;
    transform: translateZ(0);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  .yt-btn:active {
    transform: translateZ(0) scale(0.97);
  }
  .yt-btn__content {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    transition: transform 180ms ease;
  }
  .yt-btn svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .yt-btn--primary {
    box-shadow: 0 18px 45px rgba(216, 177, 102, 0.18);
  }
  .yt-btn--primary:hover {
    box-shadow: 0 22px 55px rgba(216, 177, 102, 0.28);
  }

  /* ═══════════════════════════════════════════
     TEXT SPLITTING
     ═══════════════════════════════════════════ */
  .split-word {
    display: inline-block;
    white-space: nowrap;
    overflow: clip;
    vertical-align: bottom;
  }
  .split-char {
    display: inline-block;
    will-change: transform, opacity;
  }

  /* ═══════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════ */
  .yt-hero {
    min-height: min(64rem, calc(100svh - 2rem));
    display: grid;
    place-items: center;
    position: relative;
    padding: clamp(5rem, 8vw, 7.5rem) 0 clamp(3rem, 6vw, 4.75rem);
  }
  .yt-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: center;
    width: 100%;
  }
  .yt-hero__copy {
    width: min(100%, 64rem);
    margin-inline: auto;
    text-align: center;
    min-width: 0;
  }
  .yt-kicker {
    margin: 0 0 1rem;
    margin-inline: auto;
  }
  .yt-hero__title {
    max-width: none;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.35rem, 10vw, 7.45rem);
    line-height: 0.88;
    letter-spacing: -0.02em;
    color: var(--hc-text-primary);
    text-wrap: balance;
  }
  .yt-hero__lead {
    max-width: 53rem;
    margin: 1.65rem auto 0;
    color: oklch(80% 0.012 76);
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.74;
    overflow-wrap: break-word;
  }
  .yt-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.1rem;
    justify-content: center;
  }
  .yt-hero__visual {
    position: relative;
    width: min(100%, 78rem);
    margin: clamp(2.4rem, 5vw, 3.5rem) auto 0;
    perspective: 1400px;
    max-width: 100%;
    min-width: 0;
  }

  /* ── Channel Stage / 3D Mockup ── */
  .yt-channel-stage {
    --stage-rx: 0deg;
    --stage-ry: 0deg;
    position: relative;
    max-width: 100%;
    transform: rotateX(var(--stage-rx)) rotateY(var(--stage-ry));
    transform-style: preserve-3d;
    transition: transform 620ms var(--yt-ease);
  }
  .yt-channel-stage__aura {
    position: absolute;
    inset: 6% 4% -8%;
    border-radius: 2.25rem;
    background:
      radial-gradient(
        circle at 50% 58%,
        oklch(62% 0.235 28 / 0.22),
        transparent 34rem
      ),
      radial-gradient(
        circle at 20% 20%,
        oklch(81% 0.095 76 / 0.12),
        transparent 24rem
      );
    filter: blur(28px);
    opacity: 0.82;
    transform: translateZ(-70px);
  }
  .yt-channel-frame {
    overflow: hidden;
    max-width: 100%;
    border-radius: 1.45rem;
    border-color: oklch(88% 0.01 265 / 0.18);
    background: linear-gradient(
      180deg,
      oklch(15% 0.012 265),
      oklch(8.5% 0.012 265)
    );
    box-shadow:
      0 34px 100px oklch(4% 0.018 265 / 0.66),
      0 0 0 1px oklch(92% 0.006 265 / 0.04),
      inset 0 1px 0 oklch(100% 0 0 / 0.06);
    transform: translateZ(0);
  }
  .yt-motion-enabled .yt-channel-frame {
    animation: yt-frame-float 7.5s var(--yt-ease) infinite alternate;
  }
  .yt-channel-frame__topbar {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    min-height: 3.1rem;
    gap: 0.85rem;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--tube-line);
    background: linear-gradient(
      180deg,
      oklch(17% 0.011 265),
      oklch(12% 0.011 265)
    );
  }
  .yt-window-dots,
  .yt-channel-frame__address,
  .yt-channel-frame__status {
    display: flex;
    align-items: center;
  }
  .yt-window-dots {
    gap: 0.48rem;
  }
  .yt-window-dots span,
  .yt-youtube-icon,
  .yt-youtube-avatar {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 999px;
    background: oklch(58% 0.015 265);
  }
  .yt-window-dots span:nth-child(1) {
    background: oklch(66% 0.22 28);
  }
  .yt-window-dots span:nth-child(2) {
    background: oklch(79% 0.15 84);
  }
  .yt-window-dots span:nth-child(3) {
    background: oklch(71% 0.18 145);
  }
  .yt-channel-frame__address {
    min-width: 0;
    justify-content: center;
    gap: 0.48rem;
    height: 1.82rem;
    padding: 0 0.9rem;
    border: 1px solid var(--tube-line);
    border-radius: 999px;
    color: var(--tube-muted);
    background: oklch(8.5% 0.011 265 / 0.92);
    font: 700 0.72rem/1 var(--font-ui);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .yt-channel-frame__address span {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--yt-red);
    box-shadow: 0 0 14px oklch(62% 0.235 28 / 0.62);
    flex-shrink: 0;
  }
  .yt-channel-frame__status {
    color: oklch(82% 0.01 265);
    font: 800 0.67rem/1 var(--font-ui);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .yt-youtube-shell {
    position: relative;
    display: grid;
    grid-template-columns: 7.4rem minmax(0, 1fr);
    min-height: 40.5rem;
    background:
      radial-gradient(
        circle at 69% 30%,
        oklch(62% 0.235 28 / 0.08),
        transparent 23rem
      ),
      var(--tube-surface);
  }
  .yt-youtube-shell__rail {
    display: flex;
    flex-direction: column;
    gap: 0.78rem;
    padding: 1rem 0.78rem;
    border-right: 1px solid var(--tube-line);
    background: oklch(9% 0.011 265);
  }
  .yt-youtube-shell__menu {
    width: 1.2rem;
    height: 0.82rem;
    margin: 0.18rem 0 0.4rem 0.2rem;
    background:
      linear-gradient(oklch(88% 0.006 265), oklch(88% 0.006 265)) 0 0 / 100% 2px
        no-repeat,
      linear-gradient(oklch(88% 0.006 265), oklch(88% 0.006 265)) 0 50% / 100%
        2px no-repeat,
      linear-gradient(oklch(88% 0.006 265), oklch(88% 0.006 265)) 0 100% / 100%
        2px no-repeat;
    opacity: 0.78;
  }
  .yt-youtube-shell__logo {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    margin-bottom: 0.8rem;
    color: oklch(96% 0.006 265);
    font: 900 0.86rem/1 var(--font-ui);
  }
  .yt-youtube-shell__logo svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--yt-red);
    flex-shrink: 0;
  }
  .yt-youtube-shell__nav {
    min-height: 2.1rem;
    padding: 0.62rem 0.68rem;
    border-radius: 0.7rem;
    color: oklch(75% 0.008 265);
    font: 750 0.68rem/1 var(--font-ui);
    white-space: nowrap;
  }
  .yt-youtube-shell__nav.is-active {
    color: oklch(96% 0.006 265);
    background: oklch(19% 0.011 265);
  }
  .yt-youtube-shell__main {
    min-width: 0;
  }
  .yt-youtube-topbar {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) auto auto auto;
    align-items: center;
    gap: 0.7rem;
    height: 3.8rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--tube-line);
    background: oklch(10% 0.012 265 / 0.92);
  }
  .yt-youtube-search {
    justify-self: center;
    width: min(100%, 26rem);
    min-height: 2.15rem;
    display: flex;
    align-items: center;
    padding: 0 0.9rem;
    border: 1px solid var(--tube-line);
    border-radius: 999px;
    color: oklch(66% 0.008 265);
    background: oklch(7.8% 0.01 265);
    font: 700 0.76rem/1 var(--font-ui);
  }
  .yt-youtube-icon {
    width: 2rem;
    height: 2rem;
    background:
      radial-gradient(circle, oklch(93% 0.006 265) 0.26rem, transparent 0.3rem),
      var(--tube-panel-2);
  }
  .yt-youtube-create {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
    padding: 0 0.78rem;
    border-radius: 999px;
    color: oklch(95% 0.006 265);
    background: var(--tube-panel-2);
    font: 850 0.72rem/1 var(--font-ui);
    white-space: nowrap;
  }
  .yt-youtube-avatar {
    width: 2rem;
    height: 2rem;
    border: 1px solid oklch(81% 0.095 76 / 0.36);
    background:
      radial-gradient(
        circle at 50% 42%,
        oklch(81% 0.095 76) 0 0.44rem,
        transparent 0.46rem
      ),
      oklch(13% 0.011 265);
  }
  .yt-youtube-shell__content {
    position: relative;
    min-height: 36.7rem;
    padding: 1.05rem 1.18rem 7.2rem;
  }
  .yt-youtube-shell__content::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        circle,
        oklch(86% 0.02 265 / 0.28) 1px,
        transparent 1.4px
      ),
      radial-gradient(circle, oklch(81% 0.095 76 / 0.18) 1px, transparent 1.4px);
    background-position:
      0 0,
      42px 28px;
    background-size:
      86px 86px,
      126px 126px;
    opacity: 0.2;
    mask-image: linear-gradient(
      180deg,
      transparent,
      oklch(0% 0 0) 18%,
      oklch(0% 0 0) 72%,
      transparent
    );
  }
  .yt-channel-frame__banner {
    position: relative;
    z-index: 1;
    aspect-ratio: 6.05 / 1;
    border-radius: 0.95rem;
    border: 1px solid var(--tube-line);
    overflow: hidden;
    background: oklch(10% 0.012 265);
  }
  .yt-channel-frame__banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, oklch(8% 0.012 265 / 0.78), transparent 52%),
      linear-gradient(180deg, transparent 45%, oklch(7.5% 0.012 265 / 0.22));
    pointer-events: none;
  }
  .yt-channel-frame__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .yt-channel-frame__body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.95rem;
    align-items: center;
    padding: 1rem 0.15rem 0.75rem;
  }
  .yt-channel-frame__avatar {
    width: 4.7rem;
    height: 4.7rem;
    border-radius: 999px;
    border: 1px solid oklch(81% 0.095 76 / 0.42);
    background: oklch(11% 0.012 265);
    box-shadow: 0 18px 42px oklch(5% 0.012 265 / 0.52);
    flex-shrink: 0;
  }
  .yt-channel-frame__identity {
    min-width: 0;
  }
  .yt-channel-frame__identity strong {
    color: oklch(96% 0.006 76);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
    line-height: 0.95;
    letter-spacing: 0;
  }
  .yt-channel-frame__identity span,
  .yt-channel-frame__identity p {
    display: block;
    color: oklch(73% 0.008 265);
    font: 720 0.78rem/1.32 var(--font-ui);
  }
  .yt-channel-frame__identity p {
    margin: 0.34rem 0 0;
    color: oklch(82% 0.025 76);
  }
  .yt-channel-frame__visit {
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.85rem;
    border: 1px solid oklch(92% 0.006 265 / 0.14);
    border-radius: 999px;
    color: oklch(97% 0.006 265);
    background: oklch(22% 0.011 265);
    font: 800 0.72rem/1 var(--font-ui);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition:
      background 200ms ease,
      border-color 200ms ease;
  }
  .yt-channel-frame__visit:hover {
    background: oklch(28% 0.011 265);
    border-color: oklch(92% 0.006 265 / 0.25);
  }
  .yt-channel-tabs,
  .yt-channel-chips {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .yt-channel-tabs {
    min-height: 2.45rem;
    border-bottom: 1px solid var(--tube-line);
    color: oklch(76% 0.008 265);
    font: 800 0.78rem/1 var(--font-ui);
  }
  .yt-channel-tabs span {
    position: relative;
    display: inline-flex;
    align-items: center;
    align-self: stretch;
    white-space: nowrap;
  }
  .yt-channel-tabs span.is-active {
    color: oklch(96% 0.006 265);
  }
  .yt-channel-tabs span.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    border-radius: 999px;
    background: oklch(96% 0.006 265);
  }
  .yt-channel-chips {
    gap: 0.45rem;
    padding: 0.9rem 0;
  }
  .yt-channel-chips span {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
    padding: 0 0.8rem;
    border-radius: 0.6rem;
    color: oklch(82% 0.008 265);
    background: oklch(19% 0.011 265);
    font: 850 0.72rem/1 var(--font-ui);
    white-space: nowrap;
  }
  .yt-channel-chips span.is-active {
    color: oklch(11% 0.011 265);
    background: oklch(96% 0.006 265);
  }
  .yt-channel-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.82rem;
  }
  .yt-channel-card {
    min-width: 0;
    color: oklch(94% 0.006 265);
    text-decoration: none;
    transform: translateY(calc(var(--card-index) * 0.03rem));
    transition:
      transform 260ms var(--yt-ease),
      opacity 260ms var(--yt-ease);
  }
  .yt-channel-card:hover {
    transform: translateY(-0.18rem);
  }
  .yt-channel-card__thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-bottom: 0.45rem;
    border-radius: 0.58rem;
    background: oklch(8% 0.011 265);
  }
  .yt-channel-card__thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 42%,
      oklch(4% 0.012 265 / 0.62)
    );
    opacity: 0.82;
  }
  .yt-channel-card.is-selected .yt-channel-card__thumb::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      105deg,
      transparent,
      oklch(96% 0.006 265 / 0.28),
      transparent
    );
    transform: translateX(-120%);
  }
  .yt-motion-enabled
    .yt-channel-card.is-selected
    .yt-channel-card__thumb::before {
    animation: yt-thumbnail-scan 3.4s var(--yt-ease) 1.2s infinite;
  }
  .yt-channel-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 360ms var(--yt-ease);
  }
  .yt-channel-card:hover .yt-channel-card__thumb img {
    transform: scale(1.035);
  }
  .yt-channel-card__thumb em {
    position: absolute;
    right: 0.38rem;
    bottom: 0.36rem;
    z-index: 3;
    padding: 0.2rem 0.34rem;
    border-radius: 0.28rem;
    color: oklch(96% 0.006 265);
    background: oklch(4% 0.012 265 / 0.86);
    font: 850 0.56rem/1 var(--font-ui);
    font-style: normal;
  }
  .yt-channel-card__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    min-height: 2.3em;
    overflow: hidden;
    color: oklch(95% 0.006 265);
    font: 850 0.74rem/1.2 var(--font-ui);
  }
  .yt-channel-card__meta {
    display: block;
    margin-top: 0.22rem;
    color: oklch(68% 0.008 265);
    font: 700 0.62rem/1.2 var(--font-ui);
  }
  .yt-channel-search {
    position: absolute;
    left: 54%;
    top: 11rem;
    z-index: 6;
    width: min(80%, 39rem);
    overflow: hidden;
    border: 1px solid oklch(92% 0.006 265 / 0.16);
    border-radius: 0.92rem;
    background:
      linear-gradient(
        130deg,
        oklch(16% 0.016 28 / 0.97),
        oklch(8.5% 0.012 265 / 0.98) 62%
      ),
      var(--tube-surface);
    box-shadow:
      0 24px 80px oklch(4% 0.018 265 / 0.7),
      0 0 0 1px oklch(100% 0 0 / 0.04) inset;
    transform: translateX(-50%);
  }
  .yt-motion-enabled .yt-channel-search {
    animation:
      yt-search-pop 780ms var(--yt-ease) 260ms both,
      yt-search-drift 8s var(--yt-ease) 1.2s infinite alternate;
  }
  .yt-channel-search__query {
    display: flex;
    align-items: center;
    gap: 0.08rem;
    min-height: 3rem;
    padding: 0 1rem;
    border-bottom: 1px solid oklch(92% 0.006 265 / 0.11);
    color: oklch(96% 0.006 265);
    font: 850 0.9rem/1 var(--font-ui);
  }
  .yt-channel-search__query i {
    width: 1px;
    height: 1rem;
    background: oklch(96% 0.006 265);
    animation: yt-caret 950ms steps(1) infinite;
  }
  .yt-channel-search__result {
    position: relative;
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr) auto;
    gap: 0.72rem;
    align-items: center;
    min-height: 2.8rem;
    padding: 0.65rem 0.78rem;
    color: oklch(76% 0.008 265);
    font: 730 0.72rem/1.2 var(--font-ui);
  }
  .yt-channel-search__result.is-active {
    color: oklch(96% 0.006 265);
    background: oklch(92% 0.006 265 / 0.12);
  }
  .yt-channel-search__result strong {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 850 0.78rem/1.1 var(--font-ui);
  }
  .yt-channel-search__result em {
    font-style: normal;
    color: oklch(81% 0.095 76);
  }
  .yt-channel-dock {
    position: absolute;
    left: 54%;
    bottom: 1.05rem;
    z-index: 6;
    display: flex;
    gap: 0.42rem;
    max-width: min(88%, 37rem);
    padding: 0.42rem;
    border: 1px solid oklch(92% 0.006 265 / 0.14);
    border-radius: 999px;
    background: oklch(10% 0.012 265 / 0.94);
    box-shadow: 0 20px 70px oklch(4% 0.018 265 / 0.58);
    transform: translateX(-50%);
  }
  .yt-channel-dock span {
    display: inline-flex;
    align-items: center;
    min-height: 2.15rem;
    padding: 0 0.8rem;
    border-radius: 999px;
    color: oklch(76% 0.008 265);
    font: 850 0.68rem/1 var(--font-ui);
    white-space: nowrap;
  }
  .yt-channel-dock span.is-active {
    color: oklch(96% 0.006 265);
    background: oklch(92% 0.006 265 / 0.12);
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.08),
      0 0 32px oklch(62% 0.235 28 / 0.2);
  }

  @keyframes yt-frame-float {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-0.42rem);
    }
  }
  @keyframes yt-search-pop {
    0% {
      opacity: 0;
      transform: translateX(-50%) translateY(0.9rem) scale(0.985);
    }
    100% {
      opacity: 1;
      transform: translateX(-50%) translateY(0) scale(1);
    }
  }
  @keyframes yt-search-drift {
    0% {
      translate: 0 0;
    }
    100% {
      translate: 0 -0.35rem;
    }
  }
  @keyframes yt-caret {
    50% {
      opacity: 0;
    }
  }
  @keyframes yt-thumbnail-scan {
    0% {
      transform: translateX(-120%);
    }
    45%,
    100% {
      transform: translateX(120%);
    }
  }

  .yt-scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.7rem;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--yt-faint);
    font: 700 0.68rem/1 var(--font-ui);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .yt-scroll-cue span {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--yt-line-strong);
    position: relative;
  }
  .yt-scroll-cue span::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0.55rem;
    width: 0.22rem;
    height: 0.58rem;
    border-radius: 99px;
    translate: -50% 0;
    background: var(--hc-gold);
    animation: yt-scroll 1.4s ease-in-out infinite;
  }
  @keyframes yt-scroll {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    100% {
      transform: translateY(0.65rem);
      opacity: 0;
    }
  }

  /* ═══════════════════════════════════════════
     SECTIONS COMMON
     ═══════════════════════════════════════════ */
  .yt-featured,
  .yt-archive,
  .yt-cta {
    position: relative;
    padding: clamp(4.5rem, 8vw, 7rem) 0;
  }
  .yt-archive {
    padding-bottom: clamp(2.2rem, 4vw, 3.25rem);
  }
  .yt-section-head {
    max-width: 46rem;
    margin: 0 auto clamp(2rem, 5vw, 4rem);
    text-align: center;
  }
  .yt-section-head--left {
    margin-left: 0;
    text-align: left;
  }
  .yt-section-head p {
    color: var(--yt-muted);
    font-size: clamp(0.95rem, 1.1vw, 1.08rem);
    line-height: 1.65;
    margin: 0.7rem 0 0;
  }
  .yt-section-head h2,
  .yt-cta__panel h2 {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.85rem, 5.5vw, 4.65rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* ═══════════════════════════════════════════
     FEATURED THEATER
     ═══════════════════════════════════════════ */
  .yt-theater {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(19rem, 0.75fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: stretch;
  }
  .yt-player {
    overflow: hidden;
    border-radius: 1.6rem;
    min-height: 0;
    aspect-ratio: 16 / 9;
    background: oklch(8% 0.006 72);
    position: relative;
    cursor: pointer;
  }
  .yt-player__poster,
  .yt-player__embed {
    position: absolute;
    inset: 0;
  }
  .yt-player__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 520ms ease;
  }
  .yt-player:hover .yt-player__poster img {
    transform: scale(1.04);
  }
  .yt-player__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 50% 50%,
        rgba(216, 177, 102, 0.08),
        transparent 32%
      ),
      linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.76));
  }
  .yt-player__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: clamp(4.5rem, 8vw, 6.7rem);
    height: clamp(4.5rem, 8vw, 6.7rem);
    border: 0;
    border-radius: 999px;
    color: var(--hc-gold);
    background: transparent;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: transform 200ms var(--yt-ease-bounce);
  }
  .yt-player__play:hover {
    transform: scale(1.08);
  }
  .yt-player__play:active {
    transform: scale(0.95);
  }
  .yt-player__pulse {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(216, 177, 102, 0.42);
    animation: yt-pulse 1.9s ease-out infinite;
  }
  .yt-player__icon {
    width: clamp(3rem, 5vw, 4.5rem);
    height: clamp(3rem, 5vw, 4.5rem);
    border-radius: inherit;
    display: grid;
    place-items: center;
    background: rgba(15, 15, 16, 0.78);
    border: 1px solid rgba(216, 177, 102, 0.55);
    box-shadow: 0 0 65px rgba(216, 177, 102, 0.26);
  }
  .yt-player__icon svg {
    width: 1.8rem;
    height: 1.8rem;
    margin-left: 0.15rem;
  }
  @keyframes yt-pulse {
    0% {
      transform: scale(0.72);
      opacity: 0.95;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }
  .yt-player__duration {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 3;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    color: var(--hc-text-inverse);
    background: var(--hc-gold);
    font: 800 0.75rem/1 var(--font-ui);
  }
  .yt-player__embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt-theater__meta {
    border: 1px solid oklch(86% 0.018 76 / 0.2);
    border-radius: 1.6rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    background:
      linear-gradient(180deg, oklch(15% 0.013 265), oklch(10% 0.012 265)),
      var(--tube-surface);
    box-shadow:
      0 30px 90px oklch(4% 0.018 265 / 0.72),
      inset 0 1px 0 oklch(100% 0 0 / 0.055);
    transition:
      opacity 220ms var(--yt-ease),
      transform 220ms var(--yt-ease);
  }
  .yt-theater__meta.is-updating {
    opacity: 0.72;
    transform: translateY(0.35rem);
  }
  .yt-chip {
    --chip-color: var(--hc-gold);
    display: inline-flex;
    border: 1px solid color-mix(in srgb, var(--chip-color) 45%, transparent);
    color: var(--chip-color);
    background: color-mix(in srgb, var(--chip-color) 13%, transparent);
    border-radius: 999px;
    padding: 0.35rem 0.68rem;
    font: 800 0.68rem/1 var(--font-ui);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .yt-theater__meta h3 {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.5vw, 2.65rem);
    line-height: 0.98;
    letter-spacing: 0;
  }
  .yt-theater__meta p {
    color: oklch(84% 0.014 76);
    line-height: 1.65;
    margin: 1rem 0 0;
  }
  .yt-theater__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.2rem 0;
    color: var(--yt-faint);
    font: 700 0.75rem/1 var(--font-ui);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .yt-theater__facts span {
    border: 1px solid rgba(216, 177, 102, 0.16);
    background: rgba(242, 235, 220, 0.04);
    border-radius: 999px;
    padding: 0.45rem 0.6rem;
  }
  .yt-theater__link {
    margin-top: auto;
  }

  /* ═══════════════════════════════════════════
     PROCESS SECTION
     ═══════════════════════════════════════════ */
  /* ═══════════════════════════════════════════
     FILTER TABS
     ═══════════════════════════════════════════ */
  .yt-filter {
    position: sticky;
    top: 0.7rem;
    z-index: 30;
    max-width: max-content;
    margin: 0 auto 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    align-items: center;
    padding: 0.35rem;
    border-radius: 999px;
    background: rgba(15, 15, 16, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .yt-filter__glider {
    position: absolute;
    inset: 0 auto 0 0;
    height: calc(100% - 0.7rem);
    margin: 0.35rem 0;
    border-radius: 999px;
    background: rgba(216, 177, 102, 0.14);
    border: 1px solid rgba(216, 177, 102, 0.28);
    transition:
      transform 260ms ease,
      width 260ms ease;
    pointer-events: none;
  }
  .yt-filter__tab {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 2.35rem;
    padding: 0.55rem 0.86rem;
    border: 0;
    background: transparent;
    color: var(--yt-muted);
    font: 800 0.72rem/1 var(--font-ui);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
    cursor: pointer;
    transition: color 200ms ease;
    white-space: nowrap;
  }
  .yt-filter__tab:hover {
    color: var(--hc-gold-soft);
  }
  .yt-filter__tab.is-active {
    color: var(--hc-gold-soft);
  }
  .yt-filter__tab span:first-child {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--dot-color);
    box-shadow: 0 0 18px var(--dot-color);
    flex-shrink: 0;
  }
  .yt-filter__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.4rem;
    height: 1.4rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: oklch(20% 0.01 265);
    color: oklch(70% 0.008 265);
    font: 800 0.6rem/1 var(--font-ui);
    margin-left: 0.15rem;
    transition:
      background 200ms ease,
      color 200ms ease;
  }
  .yt-filter__tab.is-active .yt-filter__count {
    background: oklch(30% 0.02 265);
    color: oklch(90% 0.006 265);
  }

  /* ═══════════════════════════════════════════
     VIDEO GRID & CARDS
     ═══════════════════════════════════════════ */
  .yt-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.9rem, 2vw, 1.25rem);
    perspective: 1200px;
  }
  .yt-card {
    border-radius: 1.25rem;
    overflow: hidden;
    transform-style: preserve-3d;
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
    cursor: pointer;
  }
  .yt-card:hover {
    border-color: color-mix(in srgb, var(--cat-color) 55%, transparent);
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.4);
    transform: translateY(-4px);
  }
  .yt-card[hidden] {
    display: none !important;
  }
  .yt-card__hit {
    position: absolute;
    inset: 0;
    z-index: 8;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }
  .yt-card__hit:focus-visible {
    outline: 2px solid var(--hc-gold);
    outline-offset: -2px;
    border-radius: inherit;
  }
  .yt-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: oklch(8% 0.006 72);
  }
  .yt-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, 0.74));
    opacity: 0.9;
  }
  .yt-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 420ms ease,
      filter 420ms ease;
  }
  .yt-card:hover .yt-card__media img {
    transform: scale(1.06);
    filter: saturate(1.08) contrast(1.05);
  }
  .yt-card__duration {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    z-index: 2;
    padding: 0.28rem 0.48rem;
    color: var(--hc-text-inverse);
    background: var(--hc-gold);
    border-radius: 999px;
    font: 850 0.67rem/1 var(--font-ui);
  }
  .yt-card__play {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    z-index: 2;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--hc-gold);
    background: rgba(15, 15, 16, 0.72);
    border: 1px solid rgba(216, 177, 102, 0.28);
    transform: translateY(0.35rem);
    opacity: 0;
    transition:
      transform 220ms ease,
      opacity 220ms ease;
  }
  .yt-card:hover .yt-card__play {
    transform: translateY(0);
    opacity: 1;
  }
  .yt-card__play svg {
    width: 1rem;
    height: 1rem;
  }
  .yt-card__body {
    padding: 1rem;
  }
  .yt-card__category {
    display: inline-flex;
    margin-bottom: 0.55rem;
    color: var(--cat-color);
    font: 850 0.65rem/1 var(--font-ui);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .yt-card h3 {
    margin: 0;
    color: var(--yt-text);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.4vw, 1.42rem);
    line-height: 1.05;
    letter-spacing: 0;
  }
  .yt-card p {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 4.7em;
    margin: 0.7rem 0 0;
    color: var(--yt-muted);
    line-height: 1.55;
    font-size: clamp(0.85rem, 1vw, 0.92rem);
  }
  .yt-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 0.9rem;
    color: var(--yt-faint);
    font: 800 0.68rem/1 var(--font-ui);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .yt-empty {
    margin-top: 3rem;
    text-align: center;
    color: var(--yt-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .yt-empty svg {
    width: 3rem;
    height: 3rem;
    opacity: 0.4;
  }
  .yt-empty p {
    font: 700 1rem/1.5 var(--font-ui);
  }

  /* ═══════════════════════════════════════════
     CTA SECTION
     ═══════════════════════════════════════════ */
  .yt-cta {
    padding: 0 0 clamp(2.1rem, 4vw, 3.2rem);
  }
  .yt-cta__panel {
    border-radius: 1.8rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    overflow: hidden;
  }
  .yt-cta__panel::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(216, 177, 102, 0.11), transparent 34%),
      linear-gradient(300deg, rgba(123, 45, 36, 0.12), transparent 42%);
    pointer-events: none;
  }
  .yt-cta__panel > * {
    position: relative;
    z-index: 2;
  }
  .yt-cta__panel p:not(.hc-eyebrow) {
    max-width: 46rem;
    color: var(--yt-muted);
    line-height: 1.7;
    margin: 1rem 0 0;
  }
  .yt-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.8rem;
  }

  :global(.hcFooter) {
    margin-top: 0;
  }

  /* ═══════════════════════════════════════════
     REVEAL ANIMATIONS
     ═══════════════════════════════════════════ */
  .yt-motion-enabled [data-hero-reveal],
  .yt-motion-enabled [data-reveal],
  .yt-motion-enabled [data-reveal-card] {
    opacity: 0;
    transform: translateY(1.6rem);
    transition:
      opacity 620ms var(--yt-ease),
      transform 620ms var(--yt-ease);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .yt-ready [data-hero-reveal],
  .yt-ready [data-reveal],
  .yt-ready [data-reveal-card],
  .is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .yt-card.is-filtering-out {
    opacity: 0;
    transform: translateY(-0.7rem) scale(0.985);
    transition-duration: 180ms;
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE: 1024px
     ═══════════════════════════════════════════ */
  @media (max-width: 1024px) {
    .yt-theater,
    .yt-cta__panel {
      grid-template-columns: 1fr;
    }
    .yt-hero__title {
      max-width: none;
    }
    .yt-hero__visual {
      min-height: 0;
    }
    .yt-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .yt-cta__actions {
      justify-content: flex-start;
    }
    .yt-channel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .yt-channel-search {
      left: 56%;
      width: min(82%, 34rem);
    }
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE: 768px
     ═══════════════════════════════════════════ */
  @media (max-width: 768px) {
    .yt-hero {
      min-height: auto;
      padding-top: 5.4rem;
    }
    .yt-hero__copy {
      text-align: left;
    }
    .yt-kicker,
    .yt-hero__lead {
      margin-inline: 0;
    }
    .yt-hero__actions {
      justify-content: flex-start;
    }
    .yt-hero__visual {
      min-height: auto;
    }
    .yt-channel-stage {
      transform: none !important;
    }
    .yt-channel-frame__topbar {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .yt-channel-frame__status {
      display: none;
    }
    .yt-youtube-shell {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .yt-youtube-shell__rail {
      display: none;
    }
    .yt-youtube-topbar {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .yt-youtube-create,
    .yt-youtube-avatar {
      display: none;
    }
    .yt-youtube-search {
      justify-self: stretch;
      width: 100%;
    }
    .yt-youtube-shell__content {
      min-height: 0;
      padding: 0.9rem 0.85rem 1rem;
    }
    .yt-channel-frame__banner {
      aspect-ratio: 4 / 1;
    }
    .yt-channel-frame__body {
      padding-top: 0.9rem;
      grid-template-columns: auto minmax(0, 1fr);
    }
    .yt-channel-frame__visit {
      grid-column: 1 / -1;
      width: 100%;
      justify-content: center;
    }
    .yt-channel-tabs,
    .yt-channel-chips {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .yt-channel-tabs::-webkit-scrollbar,
    .yt-channel-chips::-webkit-scrollbar {
      display: none;
    }
    .yt-channel-grid {
      grid-template-columns: 1fr;
    }
    .yt-channel-search {
      position: relative;
      inset: auto;
      width: auto;
      margin: -0.1rem 0.85rem 0.85rem;
      transform: none;
    }
    .yt-channel-search__result {
      grid-template-columns: 5.3rem minmax(0, 1fr) auto;
    }
    .yt-channel-dock {
      position: relative;
      left: auto;
      bottom: auto;
      transform: none;
      max-width: none;
      margin: 0 0.85rem 0.85rem;
      overflow-x: auto;
      border-radius: 1rem;
    }
    .yt-channel-dock span {
      flex: 0 0 auto;
    }
    .yt-scroll-cue {
      display: none;
    }
    .yt-section-head,
    .yt-section-head--left {
      text-align: left;
      margin-left: 0;
    }
    .yt-filter {
      position: relative;
      top: auto;
      max-width: 100%;
      justify-content: flex-start;
      border-radius: 1.15rem;
      overflow-x: auto;
      flex-wrap: nowrap;
      scrollbar-width: none;
    }
    .yt-filter::-webkit-scrollbar {
      display: none;
    }
