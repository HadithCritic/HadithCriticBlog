              />
              <button type="button" id="yt-search-clear" class="yt-search-clear" aria-label="Clear search query" hidden>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                  <path d="M18 6 6 18M6 6l12 12"></path>
                </svg>
              </button>
              <kbd class="yt-search-kbd">⌘K</kbd>
            </div>
          </div>

          <div class="yt-filter-bar">
            <div class="yt-filter-tabs" id="yt-filter-tabs" role="tablist" aria-label="Filter videos by subject">
              <div class="yt-filter-magnet-pill" aria-hidden="true"></div>
              <button
                class="yt-filter-tab is-active"
                type="button"
                role="tab"
                aria-selected="true"
                data-filter="all"
              >
                <span class="yt-filter-tab__dot" aria-hidden="true"></span>
                <span class="yt-filter-tab__label">Complete Catalogue</span>
                <span class="yt-filter-tab__count">{videos.length}</span>
              </button>
              {categories.map((category) => (
                <button
                  class="yt-filter-tab"
                  type="button"
                  role="tab"
                  aria-selected="false"
                  data-filter={category.key}
