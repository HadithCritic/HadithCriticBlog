---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { OG } from "../lib/seo";
import youtubeMeta from "../data/youtube-meta.json";
import "../styles/youtube.css";

/* The channel page points to YouTube and shows a few recent films. Titles,
   dates and durations come from the YouTube Data API snapshot in
   src/data/youtube-meta.json (refresh with `npm run sync:youtube`); the
   thumbnails are local copies in /images/yt tn/, so the page makes no
   requests to YouTube until a reader follows a link. */

const CHANNEL_URL = "https://www.youtube.com/@HadithCritic";
const SLIDE_COUNT = 12;
const withThumbnail = new Set([
  "2LQS8gUXsO4", "2sgC2CaJxqk", "3B0rnPGWgKU", "5nJCg3j9SG4", "6bpJBji3E0M",
  "boG5JTD5yXU", "CG5i14GAZTQ", "dgm5LIxdLR4", "eNBjCFQ1IV0", "EzyCSdCehXQ",
  "HWHjCfaPn_0", "McqWF6Kzjpk", "MLaRB6uGhAk", "O79Y4X4tcyM", "T73hFVA9ND0",
  "viBQWnMRLfU", "vqaXqm_sRPE", "w0RPjI0mr-E", "xhDQSpYjqQ8", "y-_RBOAF47c",
  "YTMWY2wsmNA",
]);

const formatClock = (totalSeconds: number): string => {
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = String(totalSeconds % 60).padStart(2, "0");
  return hours > 0 ? `${hours}:${String(minutes).padStart(2, "0")}:${seconds}` : `${minutes}:${seconds}`;
};

const formatMonth = (iso: string): string =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

const slides = youtubeMeta.videos
  .filter((video) => withThumbnail.has(video.id))
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))
  .slice(0, SLIDE_COUNT)
  .map((video) => ({
    id: video.id,
    title: video.title,
    href: `https://www.youtube.com/watch?v=${video.id}`,
    thumbnail: `/images/yt tn/yt-${video.id}.webp`,
    date: formatMonth(video.publishedAt),
    dateISO: video.publishedAt.slice(0, 10),
    duration: formatClock(video.durationSeconds),
  }));

const channel = youtubeMeta.channel;
const n = (value: number) => value.toLocaleString("en-US");
const newTab = '<span class="sr-only"> (opens in a new tab)</span>';
---

<BaseLayout
  image={OG.youtube}
  title="HadithCritic on YouTube | HadithCritic"
  description="The HadithCritic YouTube channel: video investigations of hadith reports and their transmission, lectures on the Quran and Islamic law, and recorded debates."
>
  <div class="hc-page yt-page">
    <PageHero
      title="HadithCritic"
      accent="on YouTube"
      titleId="yt-title"
      kicker="YouTube"
      art="/images/editorial/youtube-hero.webp"
      focus="80% 40%"
      class="yt-hero"
      measure="12ch"
    >
      <p class="hc-hero__lede">
        Video investigations of hadith reports and their transmission, lectures on the Quran and
        Islamic law, and recorded debates.
      </p>
      <Fragment slot="actions">
        <a class="hc-btn" href={CHANNEL_URL} target="_blank" rel="noopener noreferrer">
          Visit the channel <span aria-hidden="true">↗</span><Fragment set:html={newTab} />
        </a>
        <a class="hc-btn hc-btn--ghost" href={`${CHANNEL_URL}?sub_confirmation=1`} target="_blank" rel="noopener noreferrer">
          Subscribe<Fragment set:html={newTab} />
        </a>
      </Fragment>
      <Fragment slot="register">
        <span><strong>{n(channel.subscribers)}</strong> subscribers</span>
        <span><strong>{n(channel.videos)}</strong> videos</span>
        <span><strong>{n(channel.views)}</strong> views</span>
      </Fragment>
    </PageHero>

    <section class="hc-band hc-band--soft yt-reel" aria-labelledby="yt-reel-title">
      <div class="hc-container">
        <header class="hc-head">
          <div class="hc-head__main">
            <h2 id="yt-reel-title" class="hc-head__title">Recent <span>videos</span></h2>
          </div>
          <div class="yt-reel__controls" data-reel-controls hidden>
            <button type="button" class="yt-reel__step" data-reel-step="-1" aria-label="Previous videos">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5 8 12l7 7" /></svg>
            </button>
            <button type="button" class="yt-reel__step" data-reel-step="1" aria-label="Next videos">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
            </button>
          </div>
        </header>

        <ol class="yt-reel__track" data-reel-track tabindex="0" aria-label="Recent videos, scroll sideways for more">
          {slides.map((slide) => (
            <li class="yt-slide">
              <a class="yt-slide__link" href={slide.href} target="_blank" rel="noopener noreferrer">
                <span class="yt-slide__media">
                  <img src={slide.thumbnail} alt="" width="1280" height="720" loading="lazy" decoding="async" />
                  <span class="yt-slide__time">{slide.duration}</span>
                </span>
                <span class="yt-slide__title">{slide.title}<Fragment set:html={newTab} /></span>
                <time class="yt-slide__date" datetime={slide.dateISO}>{slide.date}</time>
              </a>
            </li>
          ))}
        </ol>

        <p class="yt-reel__foot">
          <a class="hc-link" href={`${CHANNEL_URL}/videos`} target="_blank" rel="noopener noreferrer">
            Every video on YouTube <span aria-hidden="true">↗</span><Fragment set:html={newTab} />
          </a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /* Without JavaScript the reel is a row that scrolls sideways; the buttons
     page it by one visible width. */
  function initReel(): void {
    document.querySelectorAll<HTMLElement>(".yt-reel").forEach((reel) => {
      if (reel.dataset.ready === "1") return;
      reel.dataset.ready = "1";
      const track = reel.querySelector<HTMLElement>("[data-reel-track]");
      const controls = reel.querySelector<HTMLElement>("[data-reel-controls]");
      const steps = [...reel.querySelectorAll<HTMLButtonElement>("[data-reel-step]")];
      if (!track || !controls) return;
      controls.hidden = false;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const update = (): void => {
        const end = track.scrollWidth - track.clientWidth - 2;
        steps.forEach((step) => {
          step.disabled = step.dataset.reelStep === "-1" ? track.scrollLeft <= 2 : track.scrollLeft >= end;
        });
      };

      steps.forEach((step) => {
        step.addEventListener("click", () => {
          const direction = Number(step.dataset.reelStep);
          track.scrollBy({ left: direction * track.clientWidth, behavior: reducedMotion ? "auto" : "smooth" });
        });
      });
      track.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initReel, { once: true });
  } else {
    initReel();
  }
  document.addEventListener("astro:page-load", initReel);
</script>
