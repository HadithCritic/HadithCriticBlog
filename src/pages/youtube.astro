    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .yt-hero__title {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 5.2vw, 3.75rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--hc-text-primary);
  }

  .yt-hero__title-accent {
    font-style: normal;
    color: var(--hc-gold);
  }

  .yt-hero__lead {
    margin: 0 0 1.85rem;
    font-family: var(--font-body);
    font-size: clamp(1.02rem, 1.25vw, 1.15rem);
    line-height: 1.65;
    color: var(--hc-text-secondary);
    max-width: 58ch;
  }

  .yt-hero__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .yt-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    padding: 0.7rem 1.35rem;
    border-radius: var(--radius-sm);
    transition: all 200ms ease;
  }

  .yt-btn--primary {
    background: var(--hc-gold);
    color: #0b0b0d;
    border: 1px solid var(--hc-gold);
    box-shadow: 0 4px 16px rgba(200, 155, 75, 0.25);
  }

  .yt-btn--primary:hover {
    background: var(--hc-gold-soft);
    border-color: var(--hc-gold-soft);
    color: #0b0b0d;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(200, 155, 75, 0.35);
  }


  .yt-channel-showcase__link:hover {
    background: var(--hc-gold);
    color: #0b0b0d;
    border-color: var(--hc-gold);
  }

  .yt-channel-showcase__banner {
    position: relative;
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }

  .yt-channel-showcase__banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .yt-channel-showcase__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 15, 16, 0.1) 0%, rgba(15, 15, 16, 0.85) 100%);
  }

  .yt-channel-showcase__caption {
    position: absolute;
    bottom: 0.85rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* ═══════════════════════════════════════════
     COMMON SECTION HEADER
     ═══════════════════════════════════════════ */
  .yt-section-head {
    margin-bottom: 2.25rem;
  }

  .yt-section-head h2 {
    margin: 0.35rem 0 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 2.35rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--hc-text-primary);
  }

  .yt-section-head p:not(.hc-eyebrow) {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--hc-text-secondary);
    max-width: 38rem;
  }

  /* ═══════════════════════════════════════════
     FEATURED THEATER
     ═══════════════════════════════════════════ */
  .yt-featured {
    scroll-margin-top: 4.5rem;
    padding-block: 3.25rem;
    border-bottom: 1px solid var(--hc-rule);
    background: var(--hc-surface-0);
  }

  .yt-theater {
    display: grid;
    grid-template-columns: 1.35fr 0.95fr;
    gap: 2.25rem;
    align-items: start;
  }

  @media (max-width: 980px) {
    .yt-theater {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  .yt-player {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    align-self: start;
    border-radius: var(--radius-md);
    background: #000000;
    border: 1px solid var(--hc-rule);
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45);
    transition: border-color 220ms ease;
  }

  .yt-player:hover {
    border-color: rgba(216, 177, 102, 0.4);
  }

  .yt-player__poster {
    position: absolute;
    inset: 0;
    z-index: 2;
    transition: opacity 260ms ease;
  }

  .yt-player__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .yt-player__shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.65) 100%);
  }

  .yt-player__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: rgba(15, 15, 16, 0.85);
    border: 1.5px solid var(--hc-gold);
    color: var(--hc-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.5);
  }

  .yt-player__play svg {
    margin-left: 3px;
  }

  .yt-player:hover .yt-player__play {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--hc-gold);
    color: #0b0b0d;
    box-shadow: 0 10px 32px rgba(216, 177, 102, 0.4);
  }

  .yt-player__duration {
    position: absolute;
    bottom: 0.85rem;
    right: 0.85rem;
    background: rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-xs);
  }

  .yt-player__embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .yt-player__embed :global(iframe),
  .yt-player__embed iframe {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
    border: 0;
  }

  /* Theater Dossier Panel */
  .yt-theater__meta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.75rem;
    border-radius: var(--radius-md);
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-rule);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.2);
  }

  .yt-theater__badge-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.1rem;
    flex-wrap: wrap;
  }

  .yt-cat-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--chip-color, var(--hc-gold));
    color: var(--chip-color, var(--hc-gold));
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .yt-cat-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--chip-color, var(--hc-gold));
  }

  .yt-theater__duration-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .yt-theater__title {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--hc-text-primary);
  }

  .yt-theater__desc {
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
    line-height: 1.62;
    color: var(--hc-text-secondary);
    flex-grow: 1;
  }

  .yt-theater__footer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hc-rule);
  }

  .yt-theater__meta-items {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--hc-text-secondary);
  }

  .yt-meta-label {
    color: var(--hc-text-tertiary);
    margin-right: 0.25rem;
  }

  .yt-meta-divider {
    color: var(--hc-rule-strong);
  }

  .yt-theater__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .yt-theater__play-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--hc-gold);
    color: #0b0b0d;
    border: 1px solid var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.81rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.6rem 1.15rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 180ms ease;
  }

  .yt-theater__play-btn:hover {
    background: var(--hc-gold-soft);
    border-color: var(--hc-gold-soft);
    transform: translateY(-1px);
  }

  .yt-theater__external-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.81rem;
    font-weight: 600;
    color: var(--hc-text-secondary);
    text-decoration: none;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--hc-rule);
    transition: all 180ms ease;
  }

  .yt-theater__external-link:hover {
    color: var(--hc-gold);
    border-color: var(--hc-gold);
    background: rgba(216, 177, 102, 0.08);
  }

  /* ═══════════════════════════════════════════
     ARCHIVE & EXPLORATION
     ═══════════════════════════════════════════ */
  .yt-archive {
    padding-block: 4.5rem 6rem;
    background:
      radial-gradient(ellipse 900px 400px at 50% 0%, rgba(216, 177, 102, 0.04) 0%, transparent 70%),
      var(--hc-surface-0);
  }

  .yt-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  /* Search Box */
  .yt-search-wrap {
    position: relative;
    width: 100%;
  }

  .yt-search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    padding: 0 1rem;
    border-radius: var(--radius-sm, 8px);
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-rule);
    transition: border-color 200ms ease, box-shadow 200ms ease, background 200ms ease;
  }

  .yt-search-box:focus-within {
    border-color: var(--hc-gold);
    box-shadow: 0 0 0 3px rgba(216, 177, 102, 0.18);
    background: var(--hc-surface-2);
  }

  .yt-search-icon {
    color: var(--hc-gold-dim);
    flex-shrink: 0;
  }

  .yt-search-input {
    width: 100%;
    background: transparent;
    border: none;
    color: var(--hc-text-primary);
    font-family: var(--font-body);
    font-size: 1.01rem;
  }

  .yt-search-input::-webkit-search-cancel-button,
  .yt-search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .yt-search-input::placeholder {
    color: var(--hc-text-tertiary);
  }

  .yt-search-clear {
    background: none;
    border: none;
    color: var(--hc-text-tertiary);
    cursor: pointer;
    font-size: 0.95rem;
    padding: 0.25rem 0.5rem;
    transition: color 180ms ease;
  }

  .yt-search-clear:hover {
    color: var(--hc-text-primary);
  }

  .yt-search-kbd {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--hc-rule);
    border-radius: 6px;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--hc-text-tertiary);
    background: var(--hc-surface-1);
    user-select: none;
    flex-shrink: 0;
  }

  /* Filter Tabs Bar with Sliding Magnet Pill */
  .yt-filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
  }

  .yt-filter-bar::-webkit-scrollbar {
    display: none;
  }

  .yt-filter-tabs {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: nowrap;
    width: max-content;
  }

  .yt-filter-magnet-pill {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: var(--radius-pill);
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition:
      transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      width 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      height 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms ease,
      box-shadow 180ms ease,
      opacity 120ms ease;
  }

  /* Category Color Palette for YouTube Filters */
  .yt-filter-tab[data-filter="all"] {
    --tab-color: var(--hc-gold);
    --tab-bg: rgba(200, 155, 75, 0.12);
    --tab-border: rgba(200, 155, 75, 0.35);
    --tab-active-bg: #c89b4b;
    --tab-active-text: #141312;
  }

  .yt-filter-tab[data-category="epistemology"],
  .yt-filter-tab[data-filter="epistemology"] {
    --tab-color: #d8b166;
    --tab-bg: rgba(216, 177, 102, 0.12);
    --tab-border: rgba(216, 177, 102, 0.35);
    --tab-active-bg: #c89b4b;
    --tab-active-text: #141312;
  }

  .yt-filter-tab[data-category="prophecy"],
  .yt-filter-tab[data-filter="prophecy"] {
    --tab-color: var(--cat-prophecies-text, #d47565);
    --tab-bg: rgba(224, 90, 71, 0.12);
    --tab-border: rgba(224, 90, 71, 0.35);
    --tab-active-bg: #c94532;
    --tab-active-text: #ffffff;
  }

  .yt-filter-tab[data-category="history"],
  .yt-filter-tab[data-filter="history"] {
    --tab-color: var(--cat-history-text, #d5b091);
    --tab-bg: rgba(212, 139, 82, 0.12);
    --tab-border: rgba(212, 139, 82, 0.35);
    --tab-active-bg: #c4783d;
    --tab-active-text: #ffffff;
  }

  .yt-filter-tab[data-category="theology"],
  .yt-filter-tab[data-filter="theology"] {
    --tab-color: var(--cat-theology-text, #9cb8a4);
    --tab-bg: rgba(79, 168, 108, 0.12);
    --tab-border: rgba(79, 168, 108, 0.35);
    --tab-active-bg: #3f8e58;
    --tab-active-text: #ffffff;
  }

  .yt-filter-tab[data-category="philosophy"],
  .yt-filter-tab[data-filter="philosophy"] {
    --tab-color: var(--cat-philosophy-text, #a3afc7);
    --tab-bg: rgba(96, 143, 214, 0.12);
    --tab-border: rgba(96, 143, 214, 0.35);
    --tab-active-bg: #4f78b8;
    --tab-active-text: #ffffff;
  }

  .yt-filter-tab {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    padding: 0.42rem 0.95rem;
    border: 1px solid var(--tab-border, var(--hc-rule));
    border-radius: var(--radius-pill);
    background: var(--hc-surface-1);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 200ms ease;
  }

  .yt-filter-tab__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tab-color, var(--hc-gold));
    box-shadow: 0 0 6px var(--tab-color, var(--hc-gold));
    display: inline-block;
    flex-shrink: 0;
    transition: transform 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }

  .yt-filter-tab:hover {
    color: var(--tab-color, var(--hc-text-primary));
    border-color: var(--tab-color, var(--hc-rule-strong));
    background: var(--tab-bg, var(--hc-surface-2));
  }

  .yt-filter-tab:hover .yt-filter-tab__dot {
    transform: scale(1.25);
    box-shadow: 0 0 10px var(--tab-color, var(--hc-gold));
  }

  .yt-filter-tab.is-active {
    color: var(--tab-active-text, #ffffff);
    background: var(--tab-active-bg, var(--hc-gold));
    border-color: var(--tab-active-bg, var(--hc-gold));
    font-weight: 700;
    box-shadow: 0 2px 12px color-mix(in srgb, var(--tab-active-bg) 40%, transparent);
  }

  .yt-filter-tabs[data-magnet-ready="true"] .yt-filter-tab.is-active {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .yt-filter-tab.is-active .yt-filter-tab__dot {
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
  }

  .yt-filter-tab__count {
    font-size: 0.8rem;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.18);
    color: var(--hc-text-primary);
  }

  .yt-filter-tab.is-active .yt-filter-tab__count {
    background: rgba(255, 255, 255, 0.32);
    color: currentColor;
  }

  .yt-reset-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px dashed var(--hc-rule-strong);
    background: transparent;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.81rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    white-space: nowrap;
    transition: all 180ms ease;
  }

  .yt-reset-btn:hover {
    border-color: var(--hc-gold);
    background: rgba(216, 177, 102, 0.1);
  }

  /* Status Bar */
  .yt-status-bar {
    display: flex;
    align-items: center;
    margin-bottom: 1.75rem;
    min-height: 2.2rem;
  }

  .yt-status-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgba(216, 177, 102, 0.08);
    border: 1px solid rgba(216, 177, 102, 0.22);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.84rem;
  }

  .yt-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hc-gold);
    box-shadow: 0 0 8px var(--hc-gold);
    flex-shrink: 0;
  }

  .yt-status-chip strong {
    color: var(--hc-gold);
    font-weight: 700;
  }

  /* Video Grid */
  .yt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.85rem;
  }

  @media (max-width: 640px) {
    .yt-grid {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }
  }

  /* Video Card - Premium Architectural Redesign */
  .yt-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md, 12px);
    background:
      radial-gradient(450px circle at var(--mouse-x, 50%) var(--mouse-y, 0%), rgba(216, 177, 102, 0.07), transparent 70%),
      var(--hc-surface-1);
    border: 1px solid var(--hc-rule);
    overflow: hidden;
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 260ms ease, box-shadow 260ms ease;
  }

  .yt-card[hidden] {
    display: none !important;
  }

  .yt-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--cat-color, var(--hc-gold)) 45%, var(--hc-gold) 55%);
    box-shadow:
      0 18px 42px -10px rgba(0, 0, 0, 0.55),
      0 0 28px -6px color-mix(in srgb, var(--cat-color, var(--hc-gold)) 28%, transparent);
  }

  .yt-card:focus-within {
    border-color: var(--hc-gold);
    box-shadow: 0 0 0 2px var(--hc-gold);
  }

  /* Card Media Poster Layer */
  .yt-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000000;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .yt-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 380ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .yt-card:hover .yt-card__img {
    transform: scale(1.05);
  }

  .yt-card__vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, transparent 40%, rgba(0, 0, 0, 0.85) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .yt-card__media-top {
    position: absolute;
    top: 0.75rem;
    inset-inline: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 2;
    pointer-events: none;
  }

  .yt-card__folio {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-xs, 4px);
    background: rgba(14, 13, 12, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--hc-gold-soft);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .yt-card__duration {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-xs, 4px);
    background: rgba(14, 13, 12, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
