/* Subscribers, views, dates and durations come from the YouTube Data API
   snapshot. Refresh it with `npm run sync:youtube`. */
const liveById = new Map(youtubeMeta.videos.map((video) => [video.id, video]));

const formatCount = (value: number, decimals = 1): string => {
  if (value < 1000) return String(value);
  const scaled = value / 1000;
  const text = scaled >= 100 ? scaled.toFixed(0) : scaled.toFixed(decimals);
  return `${text.includes(".") ? text.replace(/\.?0+$/, "") : text}K`;
};

const formatClock = (totalSeconds: number): string => {
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = String(totalSeconds % 60).padStart(2, "0");
  return hours > 0 ? `${hours}:${String(minutes).padStart(2, "0")}:${seconds}` : `${minutes}:${seconds}`;
};

const formatMonth = (iso: string): string =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

const videos: Video[] = catalogue.map((entry) => {
  const live = liveById.get(entry.id);
  return live
    ? {
        ...entry,
        duration: formatClock(live.durationSeconds),
        views: formatCount(live.views),
        date: formatMonth(live.publishedAt),
      }
    : entry;
});

const featuredVideo = videos.find((video) => video.id === FEATURED_ID) ?? videos[0];

const channelMeta = {
  name: "HadithCritic",
  handle: youtubeMeta.channel.handle,
  tagline: "Where evidence dismantles dogma.",
  subscribers: formatCount(youtubeMeta.channel.subscribers, 2),
  views: formatCount(youtubeMeta.channel.views),
  description:
    "Rigorous video essays dismantling hadith methodology, exposing fabricated prophecies, and recovering the Quran's epistemological framework through historical source criticism.",
  avatar: "/images/brand/hc-logo-transparent-512.png",
  banner: "/images/YTbanner.png",
};

const categoryByKey = Object.fromEntries(
  categories.map((category) => [category.key, category]),
) as Record<CategoryKey, (typeof categories)[number]>;

function getVideoDescription(video: Video) {
  return video.description;
}

function getCategory(category: CategoryKey) {
  return categoryByKey[category] ?? categories[0];
}

const categoryCounts = categories.reduce(
  (acc, cat) => {
    acc[cat.key] = videos.filter((v) => v.category === cat.key).length;
    return acc;
  },
  {} as Record<string, number>,
);

const minutesOf = (video: Video): number =>
  (video.duration ?? "0:0").split(":").reduce((total, part) => total * 60 + Number(part), 0) / 60;

const formatRuntime = (minutes: number): string => {
  const rounded = Math.round(minutes);
  const hours = Math.floor(rounded / 60);
  const rest = rounded % 60;
  return hours > 0 ? `${hours}h ${String(rest).padStart(2, "0")}m` : `${rest}m`;
};

const totalRuntimeMinutes = videos.reduce((acc, video) => acc + minutesOf(video), 0);
const runtimeLabel = formatRuntime(totalRuntimeMinutes);

/* The whole catalogue as one strip: a tick per film, sized by runtime,
   grouped by field of inquiry. Widths stay exactly proportional, so the
   hour ruler beneath it is true to scale. */
let tickIndex = 0;
const reel = categories.map((category, index) => {
  const items = videos.filter((video) => video.category === category.key);
  const minutes = items.reduce((acc, video) => acc + minutesOf(video), 0);
  return {
    key: category.key,
    label: category.label,
    count: items.length,
    minutes,
    runtime: formatRuntime(minutes),
    opacity: Math.max(0.4, 1 - index * 0.1).toFixed(2),
    ticks: items.map((video) => ({ minutes: minutesOf(video), index: tickIndex++ })),
  };
});
const rulerHours = Array.from({ length: Math.floor(totalRuntimeMinutes / 60) + 1 }, (_, hour) => hour).filter(
  (hour) => hour % 3 === 0,
);
const hourStep = (60 / totalRuntimeMinutes) * 100;
---

<BaseLayout
  title="YouTube Channel & Video Archive | HadithCritic"
  description="Systematic video essays, lectures, and historical debates on hadith transmission, isnad forensics, and early Islamic source criticism."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://img.youtube.com" />
  </Fragment>

  <div class="yt-page" id="yt-page">
    <div class="yt-progress" id="yt-progress" aria-hidden="true"></div>

    <header class="hc-masthead" id="hero" aria-labelledby="yt-hero-title">
      <div class="hc-container hc-masthead__inner">
        <div>
          <p class="hc-eyebrow">Broadcast archive</p>
          <h1 id="yt-hero-title" class="hc-masthead__title">Evidence-led forensics for hadith literature</h1>
          <p class="hc-masthead__lead">{channelMeta.description}</p>

          <div class="hc-masthead__actions">
            <a
              href="https://www.youtube.com/@HadithCritic?sub_confirmation=1"
              target="_blank"
              rel="noopener noreferrer"
              class="hc-btn yt-btn yt-btn--primary"
            >
              <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.19a3 3 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3 3 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3 3 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3 3 0 0 0 2.12-2.14c.5-1.88.5-5.81.5-5.81s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z"></path>
              </svg>
              <span>Subscribe on YouTube</span>
            </a>
            <a href="#featured" class="hc-btn hc-btn--ghost yt-btn">Enter the screening room</a>
          </div>
        </div>

        <aside class="hc-instrument yt-reel" aria-label="Video catalogue at a glance">
          <div class="hc-instrument__well">
            <div class="hc-instrument__plate yt-reel__plate">
              <span class="hc-instrument__figure">{runtimeLabel}</span>
              <span class="hc-instrument__note yt-reel__note">of recorded argument<br />across {videos.length} films</span>
            </div>

            <p class="hc-instrument__cap">Runtime by subject</p>
            <div class="yt-reel__strip" aria-hidden="true">
              {reel.map((group) => (
                <span class="yt-reel__group" style={`--n:${group.minutes.toFixed(2)};--o:${group.opacity}`}>
                  {group.ticks.map((tick) => (
                    <i class="yt-reel__tick hc-hatch" style={`--n:${tick.minutes.toFixed(2)};--i:${tick.index}`}></i>
                  ))}
                </span>
              ))}
            </div>
            <div class="yt-reel__ruler" style={`--hour:${hourStep.toFixed(4)}%`} aria-hidden="true">
              {rulerHours.map((hour) => (
                <span class="yt-reel__mark" style={`left:${(hour * hourStep).toFixed(3)}%`}>{hour}h</span>
              ))}
            </div>

            <ul class="yt-reel__rows">
              {reel.map((group) => (
                <li style={`--o:${group.opacity}`}>
                  <span class="yt-reel__dot" aria-hidden="true"></span>
                  <span class="yt-reel__name">{group.label}</span>
                  <span class="yt-reel__count">{group.count} {group.count === 1 ? 'film' : 'films'}</span>
                  <span class="yt-reel__run">{group.count === 0 ? 'none' : group.runtime}</span>
                </li>
              ))}
            </ul>

            <p class="yt-reel__channel">
              <span class="yt-reel__handle">{channelMeta.handle}</span>
              <span class="yt-reel__subs">{channelMeta.subscribers} subscribers, {channelMeta.views} views</span>
            </p>
          </div>
        </aside>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════
         FEATURED THEATER / SCREENING ROOM
         ═══════════════════════════════════════════ -->
    <section class="yt-featured" id="featured" aria-label="Featured video theater">
      <div class="hc-container">
        <div class="yt-section-head">
          <p class="hc-eyebrow">§ I — Screening Room</p>
          <h2>Now Playing in the Theater</h2>
          <p>
            Stream the featured monograph below, or select any record from the archive ledger to load it instantly into the player.
          </p>
        </div>

        <div class="yt-theater">
          <!-- Theater Player -->
          <div class="yt-player" id="yt-player" data-video-id={featuredVideo.id}>
            <div class="yt-player__frame" aria-hidden="true"></div>
            <div class="yt-player__poster" id="yt-poster">
              <img
                id="yt-poster-img"
                src={featuredVideo.thumbnail}
                alt={`Thumbnail: ${featuredVideo.title}`}
