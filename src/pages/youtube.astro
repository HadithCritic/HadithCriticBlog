    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    z-index: 9000;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(
      90deg,
      transparent,
      var(--hc-gold),
      var(--hc-umber),
      var(--hc-gold),
      transparent
    );
