---
import BaseLayout from '../layouts/BaseLayout.astro';
import blogMetadata from '../data/blogMetadata.json';

type Post = typeof blogMetadata[0];

const CATEGORY_SHORT: Record<string, string> = {
  "Hadith Transmission & Rijāl Criticism": "Hadith Transmission",
  "Prophecies, Eschatology & Miracle Claims": "Prophecies & Miracles",
  "Quranic Theology & Tafsir": "Quranic Theology",
  "Legal Theory, Madhhabs & Juristic Authority": "Legal Theory",
  "Ritual Practice & Legal Reform": "Ritual Practice",
  "Comparative Religion & Biblical Studies": "Comparative Religion",
  "Philosophy & Epistemology": "Philosophy",
};

const CATEGORY_ICONS: Record<string, string> = {
  "Hadith Transmission & Rijāl Criticism": "fa-project-diagram",
  "Prophecies, Eschatology & Miracle Claims": "fa-hourglass-half",
  "Quranic Theology & Tafsir": "fa-book-open",
  "Legal Theory, Madhhabs & Juristic Authority": "fa-gavel",
  "Ritual Practice & Legal Reform": "fa-mosque",
  "Comparative Religion & Biblical Studies": "fa-scroll",
  "Philosophy & Epistemology": "fa-brain",
};

const filterCategories = [
  { label: "All",                    value: "All",                                         icon: "fa-layer-group" },
  { label: "Hadith Transmission",    value: "Hadith Transmission & Rijāl Criticism",       icon: "fa-project-diagram" },
  { label: "Prophecies & Miracles",  value: "Prophecies, Eschatology & Miracle Claims",    icon: "fa-hourglass-half" },
  { label: "Quranic Theology",       value: "Quranic Theology & Tafsir",                   icon: "fa-book-open" },
  { label: "Legal Theory",           value: "Legal Theory, Madhhabs & Juristic Authority", icon: "fa-gavel" },
  { label: "Ritual Practice",        value: "Ritual Practice & Legal Reform",              icon: "fa-mosque" },
  { label: "Comparative Religion",   value: "Comparative Religion & Biblical Studies",     icon: "fa-scroll" },
  { label: "Philosophy",             value: "Philosophy & Epistemology",                   icon: "fa-brain" },
];

const posts: Post[] = blogMetadata;
---

<BaseLayout title="Blogs | HadithCritic">
  <div class="blogs-page">
    <div class="container">

      <div class="blogs-header">
        <div>
          <h1>Blogs <span class="amp">&amp;</span> Analysis</h1>
          <p>74 published critiques of Islamic history, theology, and hadith sciences.</p>
        </div>
        <span class="post-count" id="postCount">74 posts</span>
      </div>

      <div class="search-container">
        <div class="search-bar">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" placeholder="Search blogs by title, category, or tag..." autocomplete="off" />
        </div>
      </div>

      <div class="filter-scroll">
        <div class="filter-tabs" id="filterTabs">
          <div class="filter-highlight" id="filterHighlight"></div>
          {filterCategories.map((cat, i) => (
            <button
              class={`filter-tab${i === 0 ? ' active' : ''}`}
              data-filter={cat.value}
            >
              <i class={`fas ${cat.icon}`}></i>
              {cat.label}
            </button>
          ))}
        </div>
      </div>

      <div class="blogs-grid" id="blogsGrid">
        {posts.map((post: any) => {
          const shortCat = CATEGORY_SHORT[post.category] ?? post.category;
          const icon = CATEGORY_ICONS[post.category] ?? 'fa-file-alt';
          const tags = post.micro_labels.split(';').map((t: string) => t.trim()).filter(Boolean);
          return (
            <a
              href={`/blogs/${post.recommended_slug}`}
              class={`blog-card blog-card--${post.thumbnail_template}`}
              data-category={post.category}
            >
              <div class="card-thumb" style={post.thumbnail_image ? "padding: 0;" : ""}>
                {post.thumbnail_image ? (
                  <img src={post.thumbnail_image} alt={post.recommended_title} style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                ) : (
                  <>
                    <div class="thumb-grid-bg"></div>
                    <div class="thumb-glow"></div>
                    <div class="thumb-motif"></div>
                    <div class="thumb-inner">
                      <div class="thumb-brand">
                        <img
                          src="https://hadithcriticblog.com/wp-content/uploads/2026/02/cropped-HCpfp.jpg"
                          alt="HC"
                          width="22"
                          height="22"
                        />
                        <span>HADITHCRITIC</span>
                      </div>
                      <p class="thumb-kicker">{shortCat}</p>
                      <h3 class="thumb-title">{post.recommended_title}</h3>
                    </div>
                  </>
                )}
              </div>
              <div class="card-body">
                {post.thumbnail_image && (
                  <h3 class="thumb-title" style="margin-bottom: 12px;">{post.recommended_title}</h3>
                )}
                <span class="card-cat">
                  <i class={`fas ${icon}`}></i> {shortCat}
                </span>
                <div class="card-tags">
                  {tags.slice(0, 3).map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <div class="no-results hidden" id="noResults">
        <i class="fas fa-search"></i>
        <p>No posts found in this category.</p>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .blogs-page {
    padding-top: 120px;
    padding-bottom: 80px;
    min-height: 80vh;
  }

  .blogs-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .blogs-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    background: linear-gradient(135deg, #fef08a 0%, #ca8a04 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 4px 12px rgba(202,138,4,0.3));
    margin-bottom: 0.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .blogs-header .amp {
    opacity: 0.6;
  }

  .blogs-header p {
    color: var(--text-muted);
    font-size: 1rem;
    margin: 0;
  }

  .post-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    border: 1px solid var(--accent-wash);
    padding: 4px 10px;
    border-radius: 4px;
    white-space: nowrap;
    align-self: flex-start;
    margin-top: 8px;
  }

  /* ── Search bar ── */
  .search-container {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .search-bar {
    position: relative;
    width: 100%;
    max-width: 500px;
  }

  .search-bar i {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted, #888);
    pointer-events: none;
    font-size: 14px;
    opacity: 0.7;
  }

  .search-bar input {
    width: 100%;
    background: rgba(25,25,25,0.6);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 9999px;
    padding: 12px 20px 12px 46px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 15px;
    outline: none;
    backdrop-filter: blur(10px);
    transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
  }

  .search-bar input::placeholder {
    color: var(--text-muted, #888);
    opacity: 0.7;
  }

  .search-bar input:focus {
    border-color: var(--accent, #d4a82a);
    box-shadow: 0 0 0 2px rgba(212,168,42,0.15);
    background: rgba(35,35,35,0.8);
  }

  /* ── Filter bar ── */
  .filter-scroll {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin-bottom: 2rem;
  }
  .filter-scroll::-webkit-scrollbar { display: none; }

  .filter-tabs {
    display: inline-flex;
    width: max-content;
    position: relative;
    background: rgba(25,25,25,0.6);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 9999px;
    padding: 4px;
    gap: 2px;
    backdrop-filter: blur(10px);
  }

  .filter-highlight {
    position: absolute;
    top: 4px;
    left: 0;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 9999px;
    height: calc(100% - 8px);
    transition: transform 0.3s cubic-bezier(0.25,1,0.25,1), width 0.3s cubic-bezier(0.25,1,0.25,1);
    pointer-events: none;
    z-index: 0;
  }

  .filter-tab {
    position: relative;
    z-index: 1;
    background: transparent;
    border: none;
    color: #888;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 9999px;
    cursor: pointer;
    transition: color 0.25s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.01em;
  }

  .filter-tab i { font-size: 11px; opacity: 0.6; transition: opacity 0.25s; }
  .filter-tab:hover,
  .filter-tab.active { color: #fff; }
  .filter-tab.active i { opacity: 1; }

  /* ── Grid ── */
  .blogs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) { .blogs-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px)  { .blogs-grid { grid-template-columns: 1fr; gap: 16px; } }

  /* ── Card ── */
  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-panel);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }

  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.55);
    border-color: rgba(255,255,255,0.13);
  }

  .blog-card.hidden { display: none; }

  /* ── Thumbnail ── */
  .card-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #0a0a0c;
    overflow: hidden;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    display: flex;
    align-items: stretch;
  }

  .thumb-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 22px 22px;
    z-index: 0;
  }

  .thumb-glow {
    position: absolute;
    top: -30%;
    left: -10%;
    width: 65%;
    height: 65%;
    background: var(--tmpl-color, #d4a82a);
    border-radius: 50%;
    filter: blur(48px);
    opacity: 0.2;
    z-index: 1;
  }

  .thumb-motif {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .thumb-inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 18px 20px;
    width: 100%;
    gap: 6px;
  }

  .thumb-brand {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: auto;
    padding-bottom: 8px;
    align-self: flex-start;
  }

  .thumb-brand img {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    object-fit: cover;
  }

  .thumb-brand span {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 2.5px;
    font-weight: 700;
    background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 40%, #64748b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .thumb-kicker {
    font-size: 9px;
    color: var(--tmpl-color, var(--accent));
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    margin: 0;
    opacity: 0.85;
  }

  .thumb-title {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(15px, 1.4vw, 20px);
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
    color: #f8fafc;
    text-align: justify;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Card body ── */
  .card-body {
    padding: 14px 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .card-cat {
    font-size: 11px;
    color: var(--tmpl-color, var(--accent));
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-cat i { margin-right: 4px; font-size: 10px; }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .tag {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--text-dim);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 3px;
    padding: 2px 7px;
    letter-spacing: 0.04em;
  }

  /* ── Empty state ── */
  .no-results {
    text-align: center;
    padding: 80px 20px;
    color: var(--text-muted);
  }

  .no-results i {
    font-size: 2rem;
    display: block;
    margin-bottom: 12px;
    opacity: 0.4;
  }

  .no-results.hidden { display: none; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const cards = document.querySelectorAll<HTMLElement>('.blog-card');
    const highlight = document.getElementById('filterHighlight');
    const tabsContainer = document.getElementById('filterTabs');
    const countEl = document.getElementById('postCount');
    const noResults = document.getElementById('noResults');
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;

    function updateHighlight(tab: HTMLButtonElement) {
      if (!highlight || !tabsContainer) return;
      const cr = tabsContainer.getBoundingClientRect();
      const tr = tab.getBoundingClientRect();
      highlight.style.width = `${tr.width}px`;
      highlight.style.transform = `translateX(${tr.left - cr.left}px)`;
    }

    function applyFilters() {
      const activeTab = document.querySelector<HTMLButtonElement>('.filter-tab.active');
      const filter = activeTab ? activeTab.dataset.filter : 'All';
      const query = searchInput ? searchInput.value.toLowerCase() : '';
      let visible = 0;

      cards.forEach(card => {
        const catMatch = filter === 'All' || card.dataset.category === filter;
        
        const title = card.querySelector('.thumb-title')?.textContent?.toLowerCase() || '';
        const shortCat = card.querySelector('.thumb-kicker')?.textContent?.toLowerCase() || '';
        const tagsText = Array.from(card.querySelectorAll('.tag')).map(t => t.textContent?.toLowerCase()).join(' ');
        
        const searchMatch = !query || title.includes(query) || shortCat.includes(query) || tagsText.includes(query);

        const match = catMatch && searchMatch;
        card.classList.toggle('hidden', !match);
        if (match) visible++;
      });

      if (countEl) countEl.textContent = `${visible} post${visible !== 1 ? 's' : ''}`;
      if (noResults) {
        noResults.classList.toggle('hidden', visible > 0);
        const p = noResults.querySelector('p');
        if (p) p.textContent = query && visible === 0 ? 'No posts found matching your search.' : 'No posts found in this category.';
      }
    }

    const activeTab = document.querySelector<HTMLButtonElement>('.filter-tab.active');
    if (activeTab) setTimeout(() => updateHighlight(activeTab), 50);

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        updateHighlight(tab);
        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', applyFilters);
    }

    window.addEventListener('resize', () => {
      const active = document.querySelector<HTMLButtonElement>('.filter-tab.active');
      if (active) updateHighlight(active);
    });
  });
</script>
