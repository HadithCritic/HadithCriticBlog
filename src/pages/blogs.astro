---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogSlider from '../components/BlogSlider.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Analysis">
    <div class="container" style="padding-top: 120px; padding-bottom: 80px; min-height: 60vh;">
        <!-- Page Header -->
        <div style="text-align: center; margin-bottom: 4rem;">
            <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); background: linear-gradient(135deg, #fef08a 0%, #ca8a04 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 4px 12px rgba(202, 138, 4, 0.3)); margin-bottom: 1.25rem; line-height: 1.1; letter-spacing: -0.02em;">
                Analysis
            </h1>
            <p style="color: var(--text-body); font-size: 1.1rem; line-height: 1.8; max-width: 750px; margin: 0 auto; text-shadow: 0 2px 4px rgba(0,0,0,0.8);">
                In-depth academic analysis of Islamic history, theology, and hadith sciences.
            </p>
        </div>
        
        <BlogSlider articles={sortedArticles} />

    </div>
</BaseLayout>
