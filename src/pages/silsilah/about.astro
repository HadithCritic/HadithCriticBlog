---
export const prerender = false;
import SilsilahLayout from '../../layouts/SilsilahLayout.astro';
import { getCollections, fmtCount } from '../../lib/silsilah-db';

const collections = await getCollections();
const totalHadith = collections.reduce((s, c) => s + (c.hadith_count || 0), 0);
const sortedPrimary = collections.filter((c) => c.is_primary).sort((a, b) => {
  const deathA = a.author_death ?? Number.POSITIVE_INFINITY;
  const deathB = b.author_death ?? Number.POSITIVE_INFINITY;
  return deathA - deathB || a.name_en.localeCompare(b.name_en);
});
---

<SilsilahLayout title="Sources and Coverage | Silsilah">
  <section class="hc-section">
    <div class="hc-container about-wrap">
      <span class="hc-eyebrow">Sources and coverage</span>
      <h1 class="about-title">These Are the Texts Silsilah Carries</h1>
      <div class="about-table-wrap">
        <div class="table-scroll-hint" aria-hidden="true"></div>
        <table class="about-table">
          <thead>
            <tr>
              <th scope="col">Collection</th>
              <th scope="col">Author</th>
              <th scope="col" class="numeric">Death</th>
              <th scope="col" class="numeric">Reports</th>
              <th scope="col" class="numeric">Books</th>
            </tr>
          </thead>
          <tbody>
            {sortedPrimary.map((c) => (
              <tr>
                <td>
                  <a href={`/silsilah/${c.slug}/`} class="table-link">
                    <span class="link-text">{c.name_en}</span>
                    <span class="link-icon" aria-hidden="true">&rarr;</span>
                  </a>
                </td>
                <td>{c.author_en || '–'}</td>
                <td class="numeric">{c.author_death ? `${c.author_death} AH` : '–'}</td>
                <td class="numeric">{fmtCount(c.hadith_count)}</td>
                <td class="numeric">{c.book_count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="about-prose">
        <p>
          Numbering follows the reference scheme of the underlying editions, so citations such as
          <code>bukhari:2487</code> or <code>malik:1-3</code> resolve directly through
          <a href="/silsilah/find/">the reference lookup</a>. Corrections and source reports are
          welcome through the <a href="/contact">HadithCritic contact page</a>.
        </p>
      </div>
    </div>
  </section>
</SilsilahLayout>

<style>
  .about-wrap {
    max-width: 900px;
  }

  .about-title {
    margin: 0.8rem 0 2.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
    background: linear-gradient(110deg, var(--hc-parchment) 30%, var(--hc-gold-soft));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .about-prose {
    margin-top: 1.4rem;
    color: var(--hc-muted);
    line-height: 1.72;
  }

  .about-prose p {
    margin: 0 0 1.1rem;
    max-width: 72ch;
  }

  .about-prose strong {
    color: var(--hc-parchment);
  }

  .about-prose a {
    color: var(--hc-gold-bright, var(--hc-gold-soft));
  }

  .about-prose code {
    padding: 0.08rem 0.4rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: rgba(216, 177, 102, 0.07);
    color: var(--hc-gold-bright, var(--hc-gold-soft));
    font-size: 0.85em;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.45rem;
    padding: 0.08rem 0.45rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: 0.78em;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .tag-ai {
    border: 1px solid rgba(217, 140, 126, 0.24);
    color: #d98c7e;
    background: rgba(217, 140, 126, 0.12);
  }

  .tag-mt {
    border: 1px solid rgba(140, 180, 217, 0.24);
    color: #8cb4d9;
    background: rgba(140, 180, 217, 0.12);
  }

  .about-table-note {
    margin: 1.6rem 0 0.7rem;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .about-table-wrap {
    position: relative;
    margin: 0 0 1.6rem;
    overflow-x: auto;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, rgba(23, 22, 20, 0.7), rgba(15, 15, 16, 0.9));
    backdrop-filter: blur(12px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }

  .table-scroll-hint {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 3.8rem;
    background: linear-gradient(90deg, transparent, rgba(15, 15, 16, 0.96));
    pointer-events: none;
    z-index: 2;
  }

  .table-scroll-hint::after {
    content: "Scroll";
    position: absolute;
    right: 0.65rem;
    top: 0.75rem;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }

  .about-table th {
    text-align: left;
    padding: 0.7rem 0.9rem;
    color: var(--hc-gold-bright, var(--hc-gold-soft));
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--hc-rule);
    background: rgba(216, 177, 102, 0.05);
    white-space: nowrap;
  }

  .about-table td {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    color: var(--hc-muted);
    white-space: nowrap;
  }

  .about-table th.numeric,
  .about-table td.numeric {
    text-align: right;
  }

  .about-table tbody tr {
    transition: background-color 200ms ease;
  }

  .about-table tbody tr:hover td {
    background: rgba(216, 177, 102, 0.06);
  }

  .table-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--hc-parchment);
    text-decoration: none;
  }

  .table-link:hover {
    color: var(--hc-gold-bright, var(--hc-gold-soft));
  }

  .table-link:focus-visible {
    outline: 2px solid var(--hc-gold-bright, var(--hc-gold-soft));
    outline-offset: 3px;
  }

  .link-icon {
    opacity: 0;
    transform: translateX(-2px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .table-link:hover .link-icon,
  .table-link:focus-visible .link-icon {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 640px) {
    .table-scroll-hint {
      display: block;
    }
  }
</style>
