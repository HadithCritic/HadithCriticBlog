---
export const prerender = false;
import SilsilahLayout from '../../layouts/SilsilahLayout.astro';
import { getCollections, fmtCount } from '../../lib/silsilah-db';

const collections = await getCollections();
const totalHadith = collections.reduce((s, c) => s + (c.hadith_count || 0), 0);
---

<SilsilahLayout title="Sources and Coverage | Silsilah">
  <section class="hc-section">
    <div class="hc-container about-wrap">
      <span class="hc-eyebrow">Sources and coverage</span>
      <h1 class="about-title">What Silsilah contains, and how honestly it is labelled</h1>
      <div class="about-prose">
        <p>
          Silsilah carries {fmtCount(totalHadith)} reports across
          {collections.length} classical collections. Every report keeps its Arabic text, its chain of
          transmission, the compiler's arrangement of books and chapters, and the gradings recorded
          against it. Where an English translation exists it is shown alongside the Arabic.
        </p>
        <p>
          Translation provenance matters. Reports whose English text is AI-assisted are marked
          individually with an <strong>AI translation</strong> tag, and machine-translated chapter
          introductions carry an <strong>MT</strong> tag.
        </p>
        <p>
          Gradings are reported, not endorsed. A grade chip reflects the judgement of the named
          grader (Albānī, Arnaʾūṭ, Zubayr ʿAlī Zaʾī, the compiler himself, and others as recorded).
          HadithCritic's own position is that verification runs through evidence, not reputation;
          the gradings are part of the historical record being examined.
        </p>
      </div>

      <div class="about-table-wrap">
        <table class="about-table">
          <thead>
            <tr>
              <th>Collection</th>
              <th>Author</th>
              <th>Death</th>
              <th>Reports</th>
              <th>Books</th>
            </tr>
          </thead>
          <tbody>
            {collections.filter(c => c.is_primary).map((c) => (
              <tr>
                <td><a href={`/silsilah/${c.slug}/`}>{c.name_en}</a></td>
                <td>{c.author_en || '–'}</td>
                <td>{c.author_death ? `${c.author_death} AH` : '–'}</td>
                <td>{fmtCount(c.hadith_count)}</td>
                <td>{c.book_count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="about-prose">
        <p>
          Numbering follows the reference scheme of the underlying editions, so citations such as
          <code>bukhari:2487</code> or <code>malik:1-3</code> resolve directly through
          <a href="/silsilah/find/">the reference lookup</a>. Corrections and source reports are
          welcome through the <a href="/contact">HadithCritic contact page</a>.
        </p>
      </div>
    </div>
  </section>
</SilsilahLayout>

<style>
  .about-wrap {
    max-width: 900px;
  }

  .about-title {
    margin: 0.8rem 0 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .about-prose {
    margin-top: 1.4rem;
    color: var(--hc-muted);
    line-height: 1.72;
  }

  .about-prose p {
    margin: 0 0 1.1rem;
    max-width: 72ch;
  }

  .about-prose strong {
    color: var(--hc-parchment);
  }

  .about-prose a {
    color: var(--hc-gold);
  }

  .about-prose code {
    padding: 0.08rem 0.4rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: rgba(216, 177, 102, 0.07);
    color: var(--hc-gold-soft);
    font-size: 0.85em;
  }

  .about-table-wrap {
    margin: 1.6rem 0;
    overflow-x: auto;
    border: 1px solid var(--hc-rule);
  }

  .about-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }

  .about-table th {
    text-align: left;
    padding: 0.7rem 0.9rem;
    color: var(--hc-gold);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--hc-rule);
    background: rgba(216, 177, 102, 0.05);
    white-space: nowrap;
  }

  .about-table td {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    color: var(--hc-muted);
    white-space: nowrap;
  }

  .about-table td a {
    color: var(--hc-parchment);
    text-decoration: none;
  }

  .about-table td a:hover {
    color: var(--hc-gold);
  }
</style>
