---
export const prerender = false;
import SilsilahLayout from '../../layouts/SilsilahLayout.astro';
import { COLLECTION_ALIASES, getCollections, fmtCount } from '../../lib/silsilah-db';

const collections = await getCollections();

// Minimal lookup data shipped to the client: slug, display name.
const lookup = collections.filter(c => c.is_primary).map((c) => ({
  slug: c.slug,
  name: c.name_en,
  aliases: Object.entries(COLLECTION_ALIASES)
    .filter(([, slug]) => slug === c.slug)
    .map(([alias]) => alias),
  count: c.hadith_count
})).sort((a, b) => (b.count || 0) - (a.count || 0) || a.name.localeCompare(b.name));
---

<SilsilahLayout title="Find by Reference | Silsilah">
  <section class="hc-section">
    <div class="hc-container find-wrap">
      <span class="hc-eyebrow">Reference lookup</span>
      <h1 class="find-title">Find a hadith</h1>
      <p class="hc-copy find-copy">
        Enter a collection and number, like <code>bukhari:2487</code>, <code>muslim 1</code>, or
        <code>malik:1-3</code>. You will be taken to the exact report in its book and chapter.
      </p>

      <form id="findForm" class="find-form" action="/silsilah/find/" method="get">
        <input
          id="findInput"
          type="text"
          name="q"
          placeholder="e.g. bukhari:2487"
          aria-label="Reference"
          autocomplete="off"
          spellcheck="false"
        />
        <button id="findSubmit" type="submit" class="hc-btn">
          <span id="findButtonText">Find</span>
          <span id="findButtonSpinner" class="btn-spinner" hidden aria-hidden="true"></span>
        </button>
      </form>

      <p id="findStatus" class="find-status" role="status"></p>

      <div class="find-collections">
        <h2>Collections and their reference prefixes</h2>
        <div class="collections-grid" role="list">
          {lookup.map((c) => (
            <a href={`/silsilah/${c.slug}/`} class="collection-item" role="listitem">
              <span class="collection-main">
                <span class="collection-name">{c.name}</span>
                <code class="collection-prefix">{c.slug}:</code>
              </span>
              <span class="collection-count">{fmtCount(c.count)} reports</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</SilsilahLayout>

<script is:inline define:vars={{ lookup }}>
  (function () {
    const input = document.getElementById('findInput');
    const status = document.getElementById('findStatus');
    const form = document.getElementById('findForm');
    const submitBtn = document.getElementById('findSubmit');
    const btnText = document.getElementById('findButtonText');
    const btnSpinner = document.getElementById('findButtonSpinner');

    function setStatus(msg, isError) {
      status.textContent = msg;
      status.classList.toggle('is-error', !!isError);
    }

    function setLoading(loading) {
      submitBtn.disabled = loading;
      input.disabled = loading;
      btnText.hidden = loading;
      btnSpinner.hidden = !loading;
    }

    function parseQuery(raw) {
      const q = raw.trim().toLowerCase().replace(/\s+/g, ' ');
      if (!q) return null;
      const m =
        q.match(/^([a-z][a-z0-9-]*)\s*[:;\/]\s*(.+)$/) ||
        q.match(/^([a-z][a-z0-9-]*)\s+(.+)$/) ||
        q.match(/^([a-z][a-z0-9-]*)-([0-9][\w-]*)$/);
      if (!m) return null;
      const name = m[1];
      const num = m[2].trim().replace(/\s+/g, '');
      const key = name.replace(/[^a-z0-9]/g, '');
      const col = lookup.find(
        (c) =>
          c.slug === name ||
          c.name.toLowerCase().startsWith(name) ||
          c.name.toLowerCase().replace(/[^a-z0-9]/g, '').includes(key) ||
          c.aliases.some((alias) => alias.replace(/[^a-z0-9]/g, '') === key)
      );
      if (!col) return null;
      return { col, num };
    }

    async function go(raw) {
      const parsed = parseQuery(raw);
      if (!parsed) {
        setStatus('Could not recognise that collection. Use one of the prefixes listed below.', true);
        return;
      }
      const { col, num } = parsed;
      if (!num) {
        location.href = '/silsilah/' + col.slug + '/';
        return;
      }
      setStatus('Looking up ' + col.slug + ':' + num + ' ...', false);
      setLoading(true);
      try {
        const res = await fetch('/api/search?q=' + encodeURIComponent(col.slug + ':' + num));
        if (!res.ok) throw new Error('search unavailable');
        const data = await res.json();
        if (data.ref && data.results.length > 0) {
          const h = data.results[0];
          location.href = '/silsilah/' + h.collection_slug + '/' + h.book_slug + '?v=' + encodeURIComponent(num) + '#h-' + (h.number || '');
        } else {
          setStatus('No report ' + num + ' found in ' + col.name + '. Check the number or browse the collection.', true);
          setLoading(false);
        }
      } catch (err) {
        setStatus('Lookup failed. Try browsing the collection instead.', true);
        setLoading(false);
      }
    }

    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      go(input.value);
    });

    const q = new URL(location.href).searchParams.get('q');
    if (q) {
      input.value = q;
      go(q);
    }
  })();
</script>

<style>
  .find-wrap {
    max-width: 760px;
  }

  .find-title {
    margin: 0.8rem 0 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    letter-spacing: -0.02em;
  }

  .find-copy {
    margin: 1rem 0 1.8rem;
  }

  .find-copy code,
  .find-collections code {
    padding: 0.08rem 0.4rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: rgba(216, 177, 102, 0.07);
    color: var(--hc-gold-bright, var(--hc-gold-soft));
    font-size: 0.85em;
  }

  .find-form {
    display: flex;
    gap: 0.7rem;
  }

  .find-form input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: rgba(15, 15, 16, 0.6);
    color: var(--hc-parchment);
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  .find-form input:focus {
    outline: none;
    border-color: var(--hc-rule-strong);
  }

  .find-form input:focus-visible,
  .collection-item:focus-visible {
    outline: 2px solid var(--hc-gold-bright, var(--hc-gold-soft));
    outline-offset: 3px;
  }

  .find-form input:disabled {
    opacity: 0.72;
  }

  .find-form .hc-btn:disabled {
    cursor: wait;
    opacity: 0.82;
    transform: none;
  }

  .btn-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(15, 15, 16, 0.32);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spin 0.65s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .find-status {
    min-height: 1.4rem;
    margin: 0.9rem 0 0;
    color: var(--hc-muted);
    font-family: var(--font-ui);
    font-size: 0.86rem;
  }

  .find-status.is-error {
    color: #d98c7e;
  }

  .find-collections {
    margin-top: 2.6rem;
    border-top: 1px solid var(--hc-rule-soft);
    padding-top: 1.6rem;
  }

  .find-collections h2 {
    margin: 0 0 1rem;
    color: var(--hc-gold-bright, var(--hc-gold-soft));
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .collections-grid {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.5rem;
  }

  .collection-item {
    display: flex;
    justify-content: space-between;
    gap: 0.9rem;
    align-items: center;
    min-height: 58px;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: rgba(15, 15, 16, 0.24);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    color: var(--hc-parchment);
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .collection-item:hover {
    border-color: var(--hc-rule);
    background: rgba(216, 177, 102, 0.05);
    color: var(--hc-gold-bright, var(--hc-gold-soft));
  }

  .collection-main {
    display: grid;
    gap: 0.32rem;
    min-width: 0;
  }

  .collection-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .collection-prefix {
    width: fit-content;
  }

  .collection-count {
    flex: 0 0 auto;
    color: var(--hc-ash);
    font-size: 0.78rem;
  }

  @media (max-width: 560px) {
    .find-form {
      flex-direction: column;
    }

    .collection-item {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
