---
export const prerender = false;
import SilsilahLayout from '../../../layouts/SilsilahLayout.astro';
import { getCollection, getBooks, fmtCount, type CollectionRow, type BookRow } from '../../../lib/silsilah-db';

const { collection } = Astro.params;
const col = await getCollection(collection!);
if (!col) return Astro.redirect('/silsilah/');

const books = await getBooks(col.slug);
---

<SilsilahLayout
  title={`${col.name_en} | Silsilah`}
  description={`${col.name_en} by ${col.author_en}: ${fmtCount(col.hadith_count)} reports in ${col.book_count} books, with Arabic text, translation, chains, and gradings.`}
>
  <section class="col-hero">
    <div class="hc-container">
      <nav class="sil-crumbs" aria-label="Breadcrumb">
        <a href="/silsilah/">Collections</a>
        <span aria-hidden="true">/</span>
        <span>{col.name_en}</span>
      </nav>
      <div class="col-hero-grid">
        <div>
          <h1 class="col-title">{col.name_en}</h1>
          <p class="col-author">
            {col.author_en}
            {col.author_death && <span> (d. {col.author_death} AH)</span>}
          </p>
        </div>
        <div class="col-hero-side">
          <dl class="col-stats">
            <div><dt>Books</dt><dd>{fmtCount(col.book_count)}</dd></div>
            <div><dt>Reports</dt><dd>{fmtCount(col.hadith_count)}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="hc-section">
    <div class="hc-container">
      <ol class="book-list">
        {books.map((b) => (
          <li>
            <a href={`/silsilah/${col.slug}/${b.slug}/`} class="book-row">
              <span class="book-no">{b.ordinal || '·'}</span>
              <span class="book-names">
                <span class="book-en">{b.title_en ?? b.title_ar ?? 'Untitled section'}</span>
                {b.title_ar && b.title_en && <span class="book-ar" dir="rtl" lang="ar">{b.title_ar}</span>}
              </span>
              <span class="book-count">
                {fmtCount(b.count)} {b.count === 1 ? 'report' : 'reports'}
              </span>
              <span class="book-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</SilsilahLayout>

<style>
  .col-hero {
    border-bottom: 1px solid var(--hc-rule);
    background:
      radial-gradient(circle at 85% 15%, rgba(216, 177, 102, 0.06), transparent 36%),
      linear-gradient(180deg, rgba(30, 29, 27, 0.55), rgba(15, 15, 16, 0.15));
    padding-block: clamp(2rem, 4.5vw, 3.4rem);
  }

  .sil-crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.6rem;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sil-crumbs a {
    color: var(--hc-gold-dim);
    text-decoration: none;
  }

  .sil-crumbs a:hover {
    color: var(--hc-gold);
  }

  .col-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.55fr);
    gap: 2.5rem;
    align-items: start;
  }

  .col-title {
    margin: 0.8rem 0 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .col-author {
    margin: 0.7rem 0 0;
    color: var(--hc-muted);
    font-family: var(--font-ui);
    font-size: 0.92rem;
  }

  .col-author span {
    color: var(--hc-ash);
  }

  .col-hero-side {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    align-items: stretch;
  }

  .col-stats {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border: 1px solid var(--hc-rule);
    background: var(--hc-rule);
  }

  .col-stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.2rem;
    padding: 0.95rem 1.1rem;
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.92), rgba(15, 15, 16, 0.96));
  }

  .col-stats dt {
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .col-stats dd {
    margin: 0;
    color: var(--hc-gold);
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.15;
  }

  /* Book list */

  .book-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hc-rule);
  }

  .book-list li {
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .book-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto 30px;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2rem);
    padding: 0.95rem clamp(0.4rem, 1.2vw, 1rem);
    text-decoration: none;
    transition: background 220ms ease;
  }

  .book-row:hover {
    background: linear-gradient(90deg, rgba(216, 177, 102, 0.06), transparent 65%);
  }

  .book-no {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--hc-rule);
    border-radius: 50%;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.8rem;
  }

  .book-names {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    align-items: baseline;
    gap: 1.4rem;
    min-width: 0;
  }

  .book-en {
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.7vw, 1.55rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    transition: color 200ms ease;
  }

  .book-row:hover .book-en {
    color: var(--hc-gold-soft);
  }

  .book-ar {
    color: var(--hc-muted);
    font-family: var(--font-arabic);
    font-size: 1.08rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 320px;
  }

  .book-count {
    display: grid;
    gap: 0.15rem;
    justify-items: end;
    color: var(--hc-muted);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .book-arrow {
    color: var(--hc-gold-dim);
    transition: transform 220ms var(--ease), color 220ms ease;
  }

  .book-row:hover .book-arrow {
    color: var(--hc-gold);
    transform: translateX(4px);
  }

  @media (max-width: 980px) {
    .col-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .book-row {
      grid-template-columns: 46px minmax(0, 1fr);
    }
    .book-names {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .book-ar {
      max-width: 100%;
    }
    .book-count {
      grid-column: 2;
      justify-items: start;
      grid-auto-flow: column;
      gap: 0.7rem;
    }
    .book-arrow {
      display: none;
    }
  }
</style>
