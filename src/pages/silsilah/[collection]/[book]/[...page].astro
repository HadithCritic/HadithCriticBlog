<script>
  import { buildHighlightRegex } from '../../../../lib/silsilah-text';

  // Highlight search terms on arrival (?hl=term+term from the search page).
  (function () {
    const hl = new URL(location.href).searchParams.get('hl');
    if (!hl) return;
    const regexes = hl.split(/\s+/).map(buildHighlightRegex).filter(Boolean) as RegExp[];
    if (!regexes.length) return;
    const root = document.querySelector('.bk-entries');
    if (!root) return;
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        const p = node.parentElement;
        if (!p || p.closest('script, style, .sil-vh, .hd-actions, mark')) return NodeFilter.FILTER_REJECT;
        return node.nodeValue && node.nodeValue.trim().length > 1
          ? NodeFilter.FILTER_ACCEPT
          : NodeFilter.FILTER_REJECT;
      }
    });
    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);
    let marks = 0;
    for (const node of nodes) {
      if (marks > 800) break;
      const text = node.nodeValue || '';
      const ranges: [number, number][] = [];
      for (const re of regexes) {
        re.lastIndex = 0;
        let m;
        while ((m = re.exec(text)) !== null) {
          if (m[0].length === 0) { re.lastIndex++; continue; }
          ranges.push([m.index, m.index + m[0].length]);
          if (ranges.length > 50) break;
        }
      }
      if (!ranges.length) continue;
      ranges.sort((a, b) => a[0] - b[0]);
      const merged: [number, number][] = [];
      for (const r of ranges) {
        const last = merged[merged.length - 1];
        if (last && r[0] <= last[1]) last[1] = Math.max(last[1], r[1]);
        else merged.push([r[0], r[1]]);
      }
      const frag = document.createDocumentFragment();
      let pos = 0;
      for (const [a, b] of merged) {
        if (a > pos) frag.appendChild(document.createTextNode(text.slice(pos, a)));
        const mark = document.createElement('mark');
        mark.className = 'sil-hl';
        mark.textContent = text.slice(a, b);
        frag.appendChild(mark);
        pos = b;
        marks++;
      }
      if (pos < text.length) frag.appendChild(document.createTextNode(text.slice(pos)));
      node.parentNode?.replaceChild(frag, node);
    }
    // re-run the anchor scroll after DOM mutation
    if (location.hash) {
      const target = document.getElementById(location.hash.slice(1));
      target?.scrollIntoView({ block: 'start' });
    }
  })();

  // Language toggle, copy links, and the ornate single-hadith display.
  (function () {
    /* ---- language display toggle ---- */
    const langBtns = document.querySelectorAll<HTMLButtonElement>('.bk-lang button');
    function applyLang(mode: string) {
      document.body.classList.remove('sil-lang-en', 'sil-lang-ar');
      if (mode === 'en') document.body.classList.add('sil-lang-en');
      if (mode === 'ar') document.body.classList.add('sil-lang-ar');
      langBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.lang === mode));
      try { localStorage.setItem('sil-lang', mode); } catch {}
    }
    let saved = 'both';
    try { saved = localStorage.getItem('sil-lang') || 'both'; } catch {}
    if (saved !== 'both') applyLang(saved);
    langBtns.forEach((b) => b.addEventListener('click', () => applyLang(b.dataset.lang || 'both')));

    /* ---- chapter jump ---- */
    const chapterJump = document.getElementById('bkChapterJump') as HTMLSelectElement | null;
    chapterJump?.addEventListener('change', () => {
      if (!chapterJump.value) return;
      document.getElementById(chapterJump.value)?.scrollIntoView({ block: 'start', behavior: 'smooth' });
      history.replaceState(null, '', '#' + chapterJump.value);
      chapterJump.selectedIndex = 0;
    });

    /* ---- copy permalink ---- */
    function copyText(text: string, btn: HTMLElement) {
      navigator.clipboard?.writeText(text).then(() => {
        const old = btn.innerHTML;
        btn.innerHTML = 'Copied';
        setTimeout(() => { btn.innerHTML = old; }, 1200);
      });
    }

    document.querySelectorAll<HTMLButtonElement>('.hd-btn-copy').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.hd-card') as HTMLElement;
        const url = location.origin + location.pathname + '#' + card.dataset.anchor;
        copyText(url, btn);
      });
    });

    /* ---- ornate display ---- */
    const overlay = document.getElementById('hvOverlay') as HTMLElement;
    if (!overlay) return;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.hd-card'));
    const el = (id: string) => document.getElementById(id) as HTMLElement;
    let current = -1;

    function fill(card: HTMLElement, index: number) {
      current = index;
      const d = card.dataset;
      el('hvCrumb').textContent = [
        d.num ? 'Hadith ' + d.num : d.ref,
        d.nic ? 'In-book ' + d.nic : ''
      ].filter(Boolean).join(' · ');

      const chEn = d.chEn || '';
      const chAr = d.chAr || '';
      const chapter = el('hvChapter');
      if (chEn || chAr) {
        chapter.hidden = false;
        el('hvChEn').textContent = chEn;
        el('hvChAr').textContent = chAr;
      } else {
        chapter.hidden = true;
      }

      const q = (sel: string) => card.querySelector(sel);
      el('hvChain').innerHTML = (q('.hd-chain') as HTMLElement)?.innerHTML || '';
      const bodyEl = q('.hd-body') as HTMLElement;
      el('hvBody').innerHTML = bodyEl ? '“' + bodyEl.innerHTML + '”' : '<i>No English translation is available for this report.</i>';
      el('hvChainAr').textContent = (q('.hd-chain-ar') as HTMLElement)?.textContent || '';
      el('hvBodyAr').textContent = (q('.hd-body-ar') as HTMLElement)?.textContent || '';

      // transmission overview from the English chain
      const isnad = el('hvIsnad');
      isnad.innerHTML = '';
      const chainText = (q('.hd-chain') as HTMLElement)?.textContent || '';
      const chains = chainText.split(/\[Chain \d+\]/).map((s) => s.trim()).filter(Boolean);
      let counter = 0;
      chains.forEach((chain, ci) => {
        if (chains.length > 1) {
          const lbl = document.createElement('li');
          lbl.className = 'hv-isnad-chainlabel';
          lbl.textContent = 'Chain ' + (ci + 1);
          isnad.appendChild(lbl);
        }
        chain.split('>').map((n) => n.trim()).filter(Boolean).forEach((name) => {
          counter++;
          const li = document.createElement('li');
          const num = document.createElement('span');
          num.className = 'n';
          num.textContent = String(counter);
          li.appendChild(num);
          li.appendChild(document.createTextNode(name));
          isnad.appendChild(li);
        });
      });
      (isnad.closest('.hv-isnad') as HTMLElement).style.display = counter ? '' : 'none';

      // references
      const refs = el('hvRefs');
      refs.innerHTML = '';
      const addRef = (k: string, v: string) => {
        if (!v) return;
        const dt = document.createElement('dt');
        dt.textContent = k;
        const dd = document.createElement('dd');
        dd.textContent = v;
        refs.appendChild(dt);
        refs.appendChild(dd);
      };
      const colName = (document.querySelector('.hv-col-en') as HTMLElement).textContent || '';
      addRef('Reference', colName + ' ' + (d.num || d.ref || ''));
      const bookLabel = document.querySelector('.sil-crumbs span:last-child')?.textContent || '';
      if (d.nic) addRef('In-book reference', bookLabel + ', Hadith ' + d.nic);
      if (d.grade && d.grade !== 'No Grade') {
        addRef('Grading', d.grade + (d.grader && d.grader !== 'N/A' ? ' (' + d.grader + ')' : ''));
      }
      if (d.gradesRaw && d.gradesRaw.includes(':') && d.gradesRaw !== 'N/A:No Grade') {
        addRef('Grading record', d.gradesRaw);
      }
      if (d.mt === '1') addRef('Translation', 'AI-assisted, unreviewed');

      el('hvPos').textContent = (index + 1) + ' of ' + cards.length + ' on this page';
    }

    function openView(index: number, push = true) {
      const card = cards[index];
      if (!card) return;
      fill(card, index);
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      overlay.scrollTop = 0;
      if (push) {
        const url = new URL(location.href);
        url.searchParams.set('v', card.dataset.num || card.dataset.anchor || '');
        url.hash = card.dataset.anchor || '';
        history.replaceState(null, '', url);
      }
      (document.getElementById('hvClose') as HTMLElement).focus();
    }

    function closeView() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      const url = new URL(location.href);
      url.searchParams.delete('v');
      history.replaceState(null, '', url);
    }

    document.querySelectorAll<HTMLButtonElement>('.hd-btn-open').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.hd-card') as HTMLElement;
        openView(cards.indexOf(card));
      });
    });

    document.getElementById('hvClose')?.addEventListener('click', closeView);
    document.getElementById('hvPrev')?.addEventListener('click', () => { if (current > 0) openView(current - 1); });
    document.getElementById('hvNext')?.addEventListener('click', () => { if (current < cards.length - 1) openView(current + 1); });
    document.getElementById('hvCopy')?.addEventListener('click', (ev) => {
      copyText(location.href, ev.currentTarget as HTMLElement);
    });

    overlay.addEventListener('click', (ev) => {
      if (ev.target === overlay) closeView();
    });

    document.addEventListener('keydown', (ev) => {
      if (overlay.hidden) return;
      if (ev.key === 'Escape') closeView();
      if (ev.key === 'ArrowLeft' && current > 0) openView(current - 1);
      if (ev.key === 'ArrowRight' && current < cards.length - 1) openView(current + 1);
    });

    // deep link: ?v=<num> opens the display directly
    const want = new URL(location.href).searchParams.get('v');
    if (want) {
      const idx = cards.findIndex(
        (c) => c.dataset.num === want || c.dataset.anchor === want || c.dataset.anchor === 'h' + want
      );
      if (idx >= 0) openView(idx, false);
    }
  })();
</script>
