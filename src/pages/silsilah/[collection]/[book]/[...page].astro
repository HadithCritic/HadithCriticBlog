---
export const prerender = false;
import SilsilahLayout from '../../../../layouts/SilsilahLayout.astro';
import {
  getCollection,
  getBooks,
  getBookPage,
  fmtCount,
  type HadithRow
} from '../../../../lib/silsilah-db';
import { normalizeArabic } from '../../../../lib/silsilah-text';

const { collection, book, page } = Astro.params;
const pageNum = page ? parseInt(page, 10) : 1;

const col = await getCollection(collection!);
if (!col) return Astro.redirect('/silsilah/');

const allBooks = await getBooks(col.slug);
const bookMeta = allBooks.find((b) => b.slug === book);
if (!bookMeta) return Astro.redirect(`/silsilah/${col.slug}/`);

const PAGE_SIZE = 50;
const { rows, total, totalPages } = await getBookPage(col.slug, book!, pageNum, PAGE_SIZE);
if (!rows.length && pageNum > 1) return Astro.redirect(`/silsilah/${col.slug}/${book}/`);

const bookTitle = bookMeta.title_en ?? bookMeta.title_ar ?? 'Untitled section';
const bookLabel = bookMeta.ordinal ? `Book ${bookMeta.ordinal}` : 'Section';

const baseUrl = `/silsilah/${col.slug}/${bookMeta.slug}/`;
const pageUrl = (p: number) => (p === 1 ? baseUrl : `${baseUrl}${p}/`);

// numbered pagination window
const window: number[] = [];
for (let p = Math.max(1, pageNum - 2); p <= Math.min(totalPages, pageNum + 2); p++) window.push(p);

const firstRef = rows[0]?.number;
const lastRef = rows[rows.length - 1]?.number;

const collectionLabel = col.name_en;
const collectionArabicLabel = col.name_ar ?? '';
const collectionRefLabel = col.name_en.replace(/^The\s+/i, '');

const slugify = (s: string) =>
  s
    .replace(/[^0-9a-zA-Z-]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 60);

const hadithAnchor = (h: HadithRow) => `h-${h.number ?? h.id}`;

/* --- Build chapter-interleaved entries from the flat D1 rows --- */
interface ChapterEntry { t: 'ch'; level: 2 | 3; anchor: string; en: string | null; ar: string | null; }
type Entry = ChapterEntry | (HadithRow & { t: 'h' });

const entries: Entry[] = [];
let lastKitab = '';
let lastBab = '';
let chapterSeq = 0;

for (const h of rows) {
  // Insert kitab (book-level chapter) banner
  const kitabKey = h.kitab || '';
  if (kitabKey && kitabKey !== lastKitab) {
    chapterSeq++;
    const label = h.kitab_en || h.kitab || `chapter-${chapterSeq}`;
    entries.push({ t: 'ch', level: 2, anchor: `ch2-${chapterSeq}-${slugify(label)}`, en: h.kitab_en || null, ar: h.kitab || null });
    lastKitab = kitabKey;
    lastBab = '';
  }
  // Insert bab (sub-chapter) banner
  const babKey = h.bab || '';
  if (babKey && babKey !== lastBab) {
    chapterSeq++;
    const label = h.bab_en || h.bab || `section-${chapterSeq}`;
    entries.push({ t: 'ch', level: 3, anchor: `ch3-${chapterSeq}-${slugify(label)}`, en: h.bab_en || null, ar: h.bab || null });
    lastBab = babKey;
  }
  entries.push({ ...h, t: 'h' as const });
}

const chapterAnchor = (ch: ChapterEntry) => ch.anchor;

const chaptersOnPage = (entries.filter((e) => e.t === 'ch' && (e as ChapterEntry).level === 2) as ChapterEntry[])
  .filter((ch, i, arr) => arr.findIndex((c) => (c.en || c.ar) === (ch.en || ch.ar)) === i)
  .map((ch) => ({
    anchor: chapterAnchor(ch),
    label: ch.en ?? ch.ar ?? 'Untitled chapter'
  }));

const bookIdx = allBooks.findIndex((b) => b.slug === book);
const prevBook = bookIdx > 0 ? allBooks[bookIdx - 1] : null;
const nextBook = bookIdx < allBooks.length - 1 ? allBooks[bookIdx + 1] : null;

// Track the active chapter while rendering so each hadith card knows its chapter
let curChEn = '';
let curChAr = '';

/* Helpers that the old silsilah.ts provided — inlined here */
const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

function renderRich(text: string | null): string {
  if (!text) return '';
  let out = escapeHtml(text);
  out = out.replace(/\*([^*]+)\*/g, '<em>$1</em>');
  return out;
}

const titleSuffix = totalPages > 1 ? `, Page ${pageNum} of ${totalPages}` : '';
---

<SilsilahLayout
  title={`${bookTitle} | ${collectionLabel}${titleSuffix} | Silsilah`}
  description={`${collectionLabel}, ${bookLabel}: ${bookTitle}. Hadith ${firstRef ?? ''}${lastRef && lastRef !== firstRef ? ' to ' + lastRef : ''} with Arabic text, translation, and chains.`}
>
  <section class="bk-head">
    <div class="hc-container">
      <nav class="sil-crumbs" aria-label="Breadcrumb">
        <a href="/silsilah/">Collections</a>
        <span aria-hidden="true">/</span>
        <a href={`/silsilah/${col.slug}/`}>{collectionLabel}</a>
        <span aria-hidden="true">/</span>
        <span>{bookLabel}</span>
      </nav>
      <div class="bk-head-grid">
        <div>
          <span class="hc-eyebrow">{collectionLabel} &middot; {bookLabel}</span>
          <h1 class="bk-title">{bookTitle}</h1>
        </div>
        <div class="bk-head-side">
          {bookMeta.title_ar && <span class="bk-title-ar" dir="rtl" lang="ar">{bookMeta.title_ar}</span>}
          <span class="bk-side-meta">
            {fmtCount(total)} reports{totalPages > 1 ? ` · page ${pageNum} of ${totalPages}` : ''}
          </span>
        </div>
      </div>

      <div class="bk-toolbar">
        <div class="bk-tools">
          <div class="bk-lang" role="group" aria-label="Language display">
            <button type="button" data-lang="both" class="is-active">English and Arabic</button>
            <button type="button" data-lang="en">English</button>
            <button type="button" data-lang="ar">Arabic</button>
          </div>
          {chaptersOnPage.length > 1 && (
            <select class="bk-chapters" id="bkChapterJump" aria-label="Jump to a chapter on this page">
              <option value="">Jump to chapter ({chaptersOnPage.length} on this page)</option>
              {chaptersOnPage.map((c) => (
                <option value={c.anchor}>{c.label.length > 80 ? c.label.slice(0, 77) + '...' : c.label}</option>
              ))}
            </select>
          )}
        </div>
        {totalPages > 1 && (
          <nav class="bk-pager" aria-label="Pages">
            <a href={pageUrl(Math.max(1, pageNum - 1))} class:list={['bk-pager-btn', { 'is-disabled': pageNum === 1 }]} aria-label="Previous page">←</a>
            {window[0] > 1 && <a href={pageUrl(1)} class="bk-pager-btn">1</a>}
            {window[0] > 2 && <span class="bk-pager-gap">…</span>}
            {window.map((p) => (
              <a href={pageUrl(p)} class:list={['bk-pager-btn', { 'is-current': p === pageNum }]} aria-current={p === pageNum ? 'page' : undefined}>{p}</a>
            ))}
            {window[window.length - 1] < totalPages - 1 && <span class="bk-pager-gap">…</span>}
            {window[window.length - 1] < totalPages && <a href={pageUrl(totalPages)} class="bk-pager-btn">{totalPages}</a>}
            <a href={pageUrl(Math.min(totalPages, pageNum + 1))} class:list={['bk-pager-btn', { 'is-disabled': pageNum === totalPages }]} aria-label="Next page">→</a>
          </nav>
        )}
      </div>
    </div>
  </section>

  <section class="bk-body">
    <div class="hc-container">
      <div
        class="bk-entries"
        data-pagefind-body
        data-pagefind-filter={`collection:${collectionLabel}`}
        data-pagefind-meta={`collection:${collectionLabel}`}
      >
      <div data-pagefind-meta={`book:${bookLabel}: ${bookTitle}`}>
      <div data-pagefind-meta={`title:${bookTitle}`}>
      {entries.map((e) => {
        if (e.t === 'ch') {
          const ch = e as ChapterEntry;
          curChEn = ch.en ?? '';
          curChAr = ch.ar ?? '';
          const chAnchor = chapterAnchor(ch);
          return (
            <div class:list={['ch-banner', { 'ch-banner--sub': ch.level === 3 }]}>
              <div class="ch-banner-row">
                <h2 class="ch-en" id={chAnchor}>
                  <span class="ch-label">{ch.level === 3 ? 'Section' : 'Chapter'}:</span>
                  {ch.en ?? (ch.ar ? '' : 'Untitled chapter')}
                </h2>
                {ch.ar && <p class="ch-ar" dir="rtl" lang="ar" data-pagefind-ignore>{ch.ar}</p>}
              </div>
              {ch.ar && <span class="sil-vh">{normalizeArabic(ch.ar)}</span>}
            </div>
          );
        }
        const h = e as any;
        const anchor = hadithAnchor(h);
        const displayNumber = h.number ?? h.ref ?? String(h.id);
        const chainEn = h.chain_en ?? null;
        const bodyEn = h.matn_en ?? h.text_en ?? null;
        const chainAr = h.chain ?? null;
        const bodyAr = h.matn ?? h.text ?? null;
        const tone = 'none';
        return (
          <article
            class="hd-card"
            data-anchor={anchor}
            data-ref={h.ref}
            data-num={displayNumber}
            data-ch-en={curChEn}
            data-ch-ar={curChAr}
          >
            <header class="hd-top">
              <h3 class="hd-ref-h" id={anchor}>
                <a class="hd-ref" href={`#${anchor}`}>{collectionRefLabel} {displayNumber}</a>
              </h3>
              {h.gradeEn && h.gradeEn !== 'No Grade' && (
                <span class={`hd-grade hd-grade--${tone}`} title={h.gradesRaw ?? undefined} data-pagefind-ignore>
                  {h.gradeEn}
                  {h.graderEn && h.graderEn !== 'N/A' && <i> · {h.graderEn}</i>}
                </span>
              )}
              <span class="hd-actions" data-pagefind-ignore>
                {h.mt === 1 && <span class="mt-tag" title="AI-assisted translation">AI translation</span>}
                <button type="button" class="hd-btn hd-btn-open" title="Open full display">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                  Display
                </button>
                <button type="button" class="hd-btn hd-btn-copy" title="Copy link to this hadith">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                  Link
                </button>
              </span>
            </header>

            {h.titleEn && <p class="hd-title">{h.titleEn}</p>}

            <div class="hd-grid">
              <div class="hd-en">
                {chainEn && <p class="hd-chain" set:html={renderRich(chainEn)} />}
                {bodyEn
                  ? <div class="hd-body" set:html={renderRich(bodyEn)} />
                  : <p class="hd-missing">No English translation is available for this report.</p>}
                {h.footEn && (
                  <details class="hd-foot">
                    <summary>Footnote</summary>
                    <div set:html={renderRich(h.footEn)} />
                  </details>
                )}
              </div>
              <div class="hd-ar" dir="rtl" lang="ar" data-pagefind-ignore>
                {chainAr && <p class="hd-chain-ar">{chainAr}</p>}
                {bodyAr && <p class="hd-body-ar">{bodyAr}</p>}
                {h.footAr && (
                  <details class="hd-foot" dir="rtl">
                    <summary>حاشية</summary>
                    <div>{h.footAr}</div>
                  </details>
                )}
              </div>
            </div>

            {(chainAr || bodyAr) && (
              <span class="sil-vh">{normalizeArabic([chainAr, bodyAr].filter(Boolean).join(' '))}</span>
            )}

            <footer class="hd-refs" data-pagefind-ignore>
              <span><b>Reference</b> {collectionLabel} {displayNumber}</span>
              <span><b>Database ref</b> {h.ref}</span>
            </footer>
          </article>
        );
      })}
      </div>
      </div>
      </div>

      {totalPages > 1 && (
        <nav class="bk-pager bk-pager--bottom" aria-label="Pages">
          <a href={pageUrl(Math.max(1, pageNum - 1))} class:list={['bk-pager-btn', { 'is-disabled': pageNum === 1 }]}>← Previous</a>
          <span class="bk-pager-info">Page {pageNum} of {totalPages}</span>
          <a href={pageUrl(Math.min(totalPages, pageNum + 1))} class:list={['bk-pager-btn', { 'is-disabled': pageNum === totalPages }]}>Next →</a>
        </nav>
      )}

      <nav class="bk-booknav" aria-label="Adjacent books">
        {prevBook ? (
          <a href={`/silsilah/${col.slug}/${prevBook.slug}/`} class="bk-booknav-link">
            <span class="bk-booknav-dir">← Previous book</span>
            <span class="bk-booknav-title">{prevBook.title_en ?? prevBook.title_ar ?? 'Untitled section'}</span>
          </a>
        ) : <span></span>}
        <a href={`/silsilah/${col.slug}/`} class="bk-booknav-up">All books</a>
        {nextBook ? (
          <a href={`/silsilah/${col.slug}/${nextBook.slug}/`} class="bk-booknav-link bk-booknav-link--next">
            <span class="bk-booknav-dir">Next book →</span>
            <span class="bk-booknav-title">{nextBook.title_en ?? nextBook.title_ar ?? 'Untitled section'}</span>
          </a>
        ) : <span></span>}
      </nav>
    </div>
  </section>

  <!-- Ornate single-hadith display -->
  <div class="hv-overlay" id="hvOverlay" role="dialog" aria-modal="true" aria-label="Hadith display" hidden>
    <div class="hv-frame">
      <header class="hv-banner">
        <div class="hv-banner-left">
          <p class="hv-col-en">{collectionLabel}</p>
          <p class="hv-crumb" id="hvCrumb"></p>
        </div>
        <div class="hv-banner-right">
          <p class="hv-col-ar" dir="rtl" lang="ar">{collectionArabicLabel}</p>
        </div>
        <div class="hv-banner-actions">
          <button type="button" class="hv-btn" id="hvCopy" title="Copy link">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
          <button type="button" class="hv-btn" id="hvClose" title="Close (Esc)">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </header>

      <div class="hv-chapter" id="hvChapter">
        <p class="hv-ch-en"><span>Chapter:</span> <em id="hvChEn"></em></p>
        <p class="hv-ch-ar" dir="rtl" lang="ar" id="hvChAr"></p>
      </div>

      <div class="hv-parchment">
        <div class="hv-cols">
          <div class="hv-en">
            <p class="hv-chain" id="hvChain"></p>
            <div class="hv-rule" aria-hidden="true">❧</div>
            <blockquote class="hv-body" id="hvBody"></blockquote>
          </div>
          <div class="hv-ar" dir="rtl" lang="ar">
            <p class="hv-chain-ar" id="hvChainAr"></p>
            <p class="hv-body-ar" id="hvBodyAr"></p>
          </div>
        </div>
      </div>

      <div class="hv-lower">
        <section class="hv-isnad">
          <h2>Transmission overview</h2>
          <ol id="hvIsnad"></ol>
        </section>
        <section class="hv-refs">
          <h2>References and grading</h2>
          <dl id="hvRefs"></dl>
        </section>
      </div>

      <footer class="hv-nav">
        <button type="button" class="hv-btn hv-btn--wide" id="hvPrev">← Previous</button>
        <span id="hvPos"></span>
        <button type="button" class="hv-btn hv-btn--wide" id="hvNext">Next →</button>
      </footer>
    </div>
  </div>
</SilsilahLayout>

<style>
  .bk-head {
    border-bottom: 1px solid var(--hc-rule);
    background:
      radial-gradient(circle at 85% 10%, rgba(216, 177, 102, 0.06), transparent 34%),
      linear-gradient(180deg, rgba(30, 29, 27, 0.55), rgba(15, 15, 16, 0.12));
    padding-block: clamp(1.6rem, 3.6vw, 2.6rem) 0;
  }

  .sil-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.3rem;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sil-crumbs a {
    color: var(--hc-gold-dim);
    text-decoration: none;
  }

  .sil-crumbs a:hover {
    color: var(--hc-gold);
  }

  .bk-head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(240px, 0.5fr);
    gap: 2rem;
    align-items: start;
  }

  .bk-title {
    margin: 0.7rem 0 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .bk-intro {
    margin: 1rem 0 0;
    color: var(--hc-muted);
    font-size: 0.96rem;
    line-height: 1.6;
    max-width: 62ch;
  }

  .bk-head-side {
    display: grid;
    gap: 0.7rem;
    justify-items: end;
  }

  .bk-title-ar {
    color: var(--hc-gold);
    font-family: var(--font-arabic);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.5;
    text-align: right;
  }

  .bk-side-meta {
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.78rem;
  }

  .bk-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.6rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .bk-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
  }

  .bk-chapters {
    max-width: 320px;
    padding: 0.42rem 0.6rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: rgba(15, 15, 16, 0.6);
    color: var(--hc-muted);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    cursor: pointer;
  }

  .bk-chapters:focus {
    outline: none;
    border-color: var(--hc-rule-strong);
  }

  .bk-booknav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    margin-top: 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .bk-booknav-link {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
    min-width: 0;
  }

  .bk-booknav-link--next {
    text-align: right;
  }

  .bk-booknav-dir {
    color: var(--hc-gold-dim);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bk-booknav-title {
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.15;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 200ms ease;
  }

  .bk-booknav-link:hover .bk-booknav-title {
    color: var(--hc-gold-soft);
  }

  .bk-booknav-up {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-pill);
    color: var(--hc-muted);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .bk-booknav-up:hover {
    color: var(--hc-gold);
    border-color: var(--hc-rule-strong);
  }

  @media (max-width: 720px) {
    .bk-booknav {
      grid-template-columns: 1fr;
    }
    .bk-booknav-link--next {
      text-align: left;
    }
    .bk-booknav-up {
      width: fit-content;
    }
  }

  .bk-lang {
    display: inline-flex;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }

  .bk-lang button {
    padding: 0.42rem 0.85rem;
    border: 0;
    background: transparent;
    color: var(--hc-muted);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
  }

  .bk-lang button + button {
    border-left: 1px solid var(--hc-rule);
  }

  .bk-lang button.is-active {
    background: rgba(216, 177, 102, 0.12);
    color: var(--hc-gold);
  }

  .bk-pager {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-ui);
  }

  .bk-pager--bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 2.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .bk-pager-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    color: var(--hc-muted);
    font-size: 0.78rem;
    text-decoration: none;
    transition: border-color 200ms ease, color 200ms ease, background 200ms ease;
  }

  .bk-pager-btn:hover {
    color: var(--hc-gold);
    border-color: var(--hc-rule-strong);
  }

  .bk-pager-btn.is-current {
    color: var(--hc-fixed-black);
    background: var(--hc-gold);
    border-color: var(--hc-gold);
  }

  .bk-pager-btn.is-disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  .bk-pager-gap,
  .bk-pager-info {
    color: var(--hc-ash);
    font-size: 0.78rem;
    padding-inline: 0.2rem;
  }

  .bk-body {
