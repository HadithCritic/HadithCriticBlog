---
export const prerender = false;
import SilsilahLayout from '../../layouts/SilsilahLayout.astro';
import { getCollections, fmtCount } from '../../lib/silsilah-db';

const collections = await getCollections();
const totalHadith = collections.reduce((s, c) => s + (c.hadith_count || 0), 0);
const colData = collections.map((c) => ({ slug: c.slug, name: c.name_en }));
---

<SilsilahLayout title="Search | Silsilah" description="Full-text search across 228,000+ hadith in English and Arabic.">
  <section class="hc-section sr-section">
    <div class="hc-container sr-wrap">
      <span class="hc-eyebrow">Full-text search</span>
      <h1 class="sr-title">Search {fmtCount(totalHadith)} reports</h1>
      <p class="hc-copy sr-sub">
        Search in English or Arabic. Arabic queries need no diacritics: typing
        <span dir="rtl" lang="ar">الاعمال بالنيات</span> finds the vocalised text. A reference like
        <code>bukhari:2487</code> jumps straight to the report.
      </p>

      <form id="srForm" class="sr-form" role="search">
        <input
          id="srInput"
          type="text"
          name="q"
          placeholder="Search the corpus, e.g. intentions, black banners, الاعمال بالنيات"
          aria-label="Search query"
          autocomplete="off"
          spellcheck="false"
          autofocus
        />
        <select id="srFilter" aria-label="Limit to collection">
          <option value="">All collections</option>
          {colData.map((c) => <option value={c.slug}>{c.name}</option>)}
        </select>
        <button type="submit" class="hc-btn">Search</button>
      </form>

      <p id="srStatus" class="sr-status" role="status"></p>
      <ol id="srResults" class="sr-results"></ol>
      <div class="sr-more-wrap">
        <button type="button" id="srMore" class="hc-btn hc-btn--ghost" hidden>Load more results</button>
      </div>
    </div>
  </section>
</SilsilahLayout>

<script>
  const input = document.getElementById('srInput') as HTMLInputElement;
  const form = document.getElementById('srForm') as HTMLFormElement;
  const filterSel = document.getElementById('srFilter') as HTMLSelectElement;
  const statusEl = document.getElementById('srStatus') as HTMLElement;
  const resultsEl = document.getElementById('srResults') as HTMLElement;
  const moreBtn = document.getElementById('srMore') as HTMLButtonElement;

  let token = 0;
  let offset = 0;
  let debounceTimer: ReturnType<typeof setTimeout> | null = null;

  interface Hit {
    ref: string; collection_slug: string; collection_en: string | null;
    book_slug: string; number: string | null; kitab_en: string | null;
    bab_en: string | null; excerpt: string;
  }

  function hadithUrl(h: Hit): string {
    const hl = encodeURIComponent(input.value.trim());
    return `/silsilah/${h.collection_slug}/${h.book_slug}?hl=${hl}#h-${h.number ?? ''}`;
  }

  function card(h: Hit): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'sr-card';

    const chips = document.createElement('p');
    chips.className = 'sr-chips';
    for (const v of [h.collection_en, h.kitab_en, h.bab_en]) {
      if (v) { const s = document.createElement('span'); s.textContent = v; chips.appendChild(s); }
    }
    li.appendChild(chips);

    const head = document.createElement('h2');
    head.className = 'sr-card-title';
    const a = document.createElement('a');
    a.href = hadithUrl(h);
    a.textContent = (h.collection_en ? h.collection_en + ' ' : '') + (h.number ? '#' + h.number : h.ref);
    head.appendChild(a);
    li.appendChild(head);

    const ex = document.createElement('p');
    ex.className = 'sr-excerpt';
    ex.dir = 'auto';
    ex.innerHTML = h.excerpt || '';
    li.appendChild(ex);
    return li;
  }

  async function run(reset: boolean) {
    const q = input.value.trim();
    const t = ++token;
    if (q.length < 2) { resultsEl.innerHTML = ''; statusEl.textContent = ''; moreBtn.hidden = true; return; }
    if (reset) { offset = 0; resultsEl.innerHTML = ''; }
    statusEl.textContent = 'Searching …';

    const params = new URLSearchParams({ q, offset: String(offset), limit: '20' });
    if (filterSel.value) params.set('collection', filterSel.value);

    let data: { results: Hit[]; hasMore: boolean; ref?: boolean };
    try {
      const res = await fetch('/api/search?' + params.toString());
      data = await res.json();
    } catch {
      if (t === token) statusEl.textContent = 'Search is unavailable right now. Please try again.';
      return;
    }
    if (t !== token) return;

    for (const h of data.results) resultsEl.appendChild(card(h));
    offset += data.results.length;
    moreBtn.hidden = !data.hasMore;

    if (!resultsEl.children.length) statusEl.textContent = `No matches for “${q}”. Try fewer or different words.`;
    else if (data.ref) statusEl.textContent = 'Direct reference match.';
    else statusEl.textContent = '';

    const u = new URL(location.href);
    u.searchParams.set('q', q);
    history.replaceState(null, '', u);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); run(true); });
  input.addEventListener('input', () => {
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => run(true), 200);
  });
  filterSel.addEventListener('change', () => run(true));
  moreBtn.addEventListener('click', () => run(false));

  const initial = new URL(location.href).searchParams.get('q');
  if (initial) { input.value = initial; run(true); }
</script>

<style>
  .sr-wrap { max-width: 860px; }
  .sr-title {
    margin: 0.8rem 0 0; color: var(--hc-parchment); font-family: var(--font-display);
    font-weight: 500; font-size: clamp(2.1rem, 4.4vw, 3.1rem); letter-spacing: -0.02em;
  }
  .sr-sub { margin: 1rem 0 1.6rem; }
  .sr-sub code {
    padding: 0.08rem 0.4rem; border: 1px solid var(--hc-rule); border-radius: var(--radius-xs);
    background: rgba(216, 177, 102, 0.07); color: var(--hc-gold-soft); font-size: 0.85em;
  }
  .sr-form { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 0.7rem; }
  .sr-form input, .sr-form select {
    padding: 0.75rem 1rem; border: 1px solid var(--hc-rule); border-radius: var(--radius-xs);
    background: rgba(15, 15, 16, 0.6); color: var(--hc-parchment); font-family: var(--font-ui); font-size: 0.95rem;
  }
  .sr-form select { max-width: 220px; cursor: pointer; }
  .sr-form input:focus, .sr-form select:focus { outline: none; border-color: var(--hc-rule-strong); }
  .sr-status { min-height: 1.4rem; margin: 0.9rem 0 0; color: var(--hc-ash); font-family: var(--font-ui); font-size: 0.84rem; }
  .sr-status.is-error { color: #d98c7e; }
  .sr-results { margin: 1.4rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.9rem; }
  .sr-card {
    border: 1px solid var(--hc-rule); border-radius: var(--radius-sm);
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.55), rgba(15, 15, 16, 0.85));
    padding: 1rem 1.2rem; transition: border-color 200ms ease;
  }
  .sr-card:hover { border-color: var(--hc-rule-strong); }
  .sr-chips { margin: 0 0 0.45rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .sr-chips span {
    padding: 0.12rem 0.5rem; border: 1px solid var(--hc-rule); border-radius: var(--radius-pill);
    color: var(--hc-gold-dim); font-family: var(--font-ui); font-size: 0.64rem; font-weight: 600;
    letter-spacing: 0.07em; text-transform: uppercase;
  }
  .sr-card-title { margin: 0 0 0.4rem; font-family: var(--font-display); font-weight: 500; font-size: 1.3rem; line-height: 1.1; }
  .sr-card-title a { color: var(--hc-parchment); text-decoration: none; }
  .sr-card-title a:hover { color: var(--hc-gold); }
  .sr-excerpt { margin: 0; color: var(--hc-muted); font-size: 0.95rem; line-height: 1.7; }
  .sr-excerpt[dir="auto"]:lang(en) { unicode-bidi: plaintext; }
  .sr-excerpt :global(mark) {
    background: rgba(216, 177, 102, 0.45); color: var(--hc-parchment); border-radius: 2px; padding: 0 0.1em;
  }
  .sr-more-wrap { margin-top: 1.6rem; text-align: center; }
  @media (max-width: 720px) {
    .sr-form { grid-template-columns: 1fr; }
    .sr-form select { max-width: none; }
  }
</style>
