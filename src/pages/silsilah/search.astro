---
import SilsilahLayout from '../../layouts/SilsilahLayout.astro';
import { loadIndex, fmtCount } from '../../lib/silsilah';

const { collections } = loadIndex();
const totalHadith = collections.reduce((s, c) => s + c.hadithCount, 0);

// Shipped to the client: filter values and reference prefixes.
const colData = collections.map((c) => ({
  slug: c.slug,
  name: c.nameEn,
  short: c.shortEn
}));
---

<SilsilahLayout title="Search | Silsilah" description="Full-text search across 153,000+ hadith in English and Arabic.">
  <section class="hc-section sr-section">
    <div class="hc-container sr-wrap">
      <span class="hc-eyebrow">Full-text search</span>
      <h1 class="sr-title">Search {fmtCount(totalHadith)} reports</h1>
      <p class="hc-copy sr-sub">
        Search in English or Arabic. Arabic queries need no diacritics: typing
        <span dir="rtl" lang="ar">الاعمال بالنيات</span> finds the vocalised text. A reference like
        <code>bukhari:2487</code> jumps straight to the report.
      </p>

      <form id="srForm" class="sr-form" role="search">
        <input
          id="srInput"
          type="text"
          name="q"
          placeholder="Search the corpus, e.g. intentions, black banners, الاعمال بالنيات"
          aria-label="Search query"
          autocomplete="off"
          spellcheck="false"
          autofocus
        />
        <select id="srFilter" aria-label="Limit to collection">
          <option value="">All collections</option>
          {colData.map((c) => <option value={c.name}>{c.name}</option>)}
        </select>
        <button type="submit" class="hc-btn">Search</button>
      </form>

      <p id="srRefJump" class="sr-refjump" hidden>
        <a href="#" id="srRefJumpLink"></a>
      </p>

      <p id="srStatus" class="sr-status" role="status"></p>

      <ol id="srResults" class="sr-results"></ol>

      <div class="sr-more-wrap">
        <button type="button" id="srMore" class="hc-btn hc-btn--ghost" hidden>Load more results</button>
      </div>
    </div>
  </section>
</SilsilahLayout>

<script>
  import { normalizeArabic, hasArabic } from '../../lib/silsilah-text';

  declare global {
    interface Window { __silCols?: { slug: string; name: string; short: string }[] }
  }

  const colData = window.__silCols || [];

  const input = document.getElementById('srInput') as HTMLInputElement;
  const form = document.getElementById('srForm') as HTMLFormElement;
  const filterSel = document.getElementById('srFilter') as HTMLSelectElement;
  const statusEl = document.getElementById('srStatus') as HTMLElement;
  const resultsEl = document.getElementById('srResults') as HTMLElement;
  const moreBtn = document.getElementById('srMore') as HTMLButtonElement;
  const refJump = document.getElementById('srRefJump') as HTMLElement;
  const refJumpLink = document.getElementById('srRefJumpLink') as HTMLAnchorElement;

  const PAGE_BATCH = 10; // result pages whose sub-results we hydrate per click

  let pagefind: any = null;
  let pagefindError = '';
  let lastQueryToken = 0;
  let pending: { results: any[]; cursor: number; terms: string[] } | null = null;

  async function getPagefind() {
    if (pagefind || pagefindError) return pagefind;
    try {
      // Generated by the pagefind CLI against dist/ at build time.
      const pfUrl = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ pfUrl);
      await pagefind.options({ excerptLength: 40 });
      pagefind.init();
    } catch {
      pagefindError =
        'The search index is generated when the site is built. Run "npm run build" and "npm run preview" to use search locally.';
    }
    return pagefind;
  }

  function setStatus(msg: string, isError = false) {
    statusEl.textContent = msg;
    statusEl.classList.toggle('is-error', isError);
  }

  function refPattern(raw: string) {
    const m = raw.trim().toLowerCase().match(/^([a-z][a-z-]*)[\s:\/]+([0-9][\w-]*)$/);
    if (!m) return null;
    const col = colData.find(
      (c) => c.slug === m[1] || c.short.toLowerCase() === m[1] || c.name.toLowerCase().startsWith(m[1])
    );
    return col ? { col, num: m[2] } : null;
  }

  async function maybeOfferRefJump(raw: string) {
    const parsed = refPattern(raw);
    if (!parsed) {
      refJump.hidden = true;
      return;
    }
    refJump.hidden = false;
    refJumpLink.textContent = 'Open the reference ' + parsed.col.slug + ':' + parsed.num + ' directly';
    refJumpLink.href = '/silsilah/find/?q=' + encodeURIComponent(parsed.col.slug + ':' + parsed.num);
  }

  function resultCard(sub: any, meta: Record<string, string>, terms: string[]) {
    const li = document.createElement('li');
    li.className = 'sr-card';

    const chips = document.createElement('p');
    chips.className = 'sr-chips';
    if (meta.collection) {
      const c = document.createElement('span');
      c.textContent = meta.collection;
      chips.appendChild(c);
    }
    if (meta.book) {
      const b = document.createElement('span');
      b.textContent = meta.book;
      chips.appendChild(b);
    }
    li.appendChild(chips);

    const h = document.createElement('h2');
    h.className = 'sr-card-title';
    const a = document.createElement('a');
    let url = sub.url as string;
    // carry the query terms so the destination page highlights them
    const hashIdx = url.indexOf('#');
    const hl = '?hl=' + encodeURIComponent(terms.join(' '));
    url = hashIdx === -1 ? url + hl : url.slice(0, hashIdx) + hl + url.slice(hashIdx);
    a.href = url;
    a.textContent = sub.title || meta.title || 'Untitled';
    h.appendChild(a);
    li.appendChild(h);

    const ex = document.createElement('p');
    ex.className = 'sr-excerpt';
    ex.dir = 'auto';
    ex.innerHTML = sub.excerpt || '';
    li.appendChild(ex);

    return li;
  }

  async function hydrateMore() {
    if (!pending) return;
    const token = lastQueryToken;
    const slice = pending.results.slice(pending.cursor, pending.cursor + PAGE_BATCH);
    pending.cursor += slice.length;
    let added = 0;
    for (const r of slice) {
      const data = await r.data();
      if (token !== lastQueryToken) return; // superseded by a newer query
      const meta = data.meta || {};
      const subs = (data.sub_results || []).filter((s: any) => s.url && s.url.includes('#h'));
      const list = subs.length ? subs : [data];
      for (const sub of list) {
        resultsEl.appendChild(resultCard(sub, meta, pending.terms));
        added++;
      }
    }
    const left = pending.results.length - pending.cursor;
    moreBtn.hidden = left <= 0;
    if (left > 0) moreBtn.textContent = 'Load more results (' + left + ' more pages match)';
    return added;
  }

  async function runSearch(raw: string) {
    const token = ++lastQueryToken;
    const q = raw.trim();
    maybeOfferRefJump(q);
    if (q.length < 2) {
      resultsEl.innerHTML = '';
      moreBtn.hidden = true;
      setStatus('');
      return;
    }

    const pf = await getPagefind();
    if (!pf) {
      setStatus(pagefindError, true);
      return;
    }

    const query = hasArabic(q) ? normalizeArabic(q) : q;
    setStatus('Searching ...');
    const opts: any = {};
    if (filterSel.value) opts.filters = { collection: [filterSel.value] };
    const res = await pf.debouncedSearch(query, opts, 220);
    if (res === null || token !== lastQueryToken) return; // superseded

    resultsEl.innerHTML = '';
    moreBtn.hidden = true;

    if (!res.results.length) {
      setStatus('No matches for "' + q + '". Try fewer or different words.');
      return;
    }

    pending = {
      results: res.results,
      cursor: 0,
      terms: query.split(/\s+/).filter((t: string) => t.length > 1)
    };
    await hydrateMore();
    if (token !== lastQueryToken) return;
    setStatus(
      res.results.length === 1
        ? 'Matches on 1 page.'
        : 'Matches on ' + res.results.length + ' pages, closest first.'
    );

    const url = new URL(location.href);
    url.searchParams.set('q', q);
    history.replaceState(null, '', url);
  }

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    runSearch(input.value);
  });
  input.addEventListener('input', () => runSearch(input.value));
  filterSel.addEventListener('change', () => runSearch(input.value));
  moreBtn.addEventListener('click', () => hydrateMore());

  const initial = new URL(location.href).searchParams.get('q');
  if (initial) {
    input.value = initial;
    runSearch(initial);
  }
</script>

<script is:inline define:vars={{ colData }}>
  window.__silCols = colData;
</script>

<style>
  .sr-wrap {
    max-width: 860px;
  }

  .sr-title {
    margin: 0.8rem 0 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.1rem, 4.4vw, 3.1rem);
    letter-spacing: -0.02em;
  }

  .sr-sub {
    margin: 1rem 0 1.6rem;
  }

  .sr-sub code {
    padding: 0.08rem 0.4rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: rgba(216, 177, 102, 0.07);
    color: var(--hc-gold-soft);
    font-size: 0.85em;
  }

  .sr-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0.7rem;
  }

  .sr-form input,
  .sr-form select {
    padding: 0.75rem 1rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: rgba(15, 15, 16, 0.6);
    color: var(--hc-parchment);
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  .sr-form select {
    max-width: 220px;
    cursor: pointer;
  }

  .sr-form input:focus,
  .sr-form select:focus {
    outline: none;
    border-color: var(--hc-rule-strong);
  }

  .sr-refjump {
    margin: 0.9rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.86rem;
  }

  .sr-refjump a {
    color: var(--hc-gold);
  }

  .sr-status {
    min-height: 1.4rem;
    margin: 0.9rem 0 0;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.84rem;
  }

  .sr-status.is-error {
    color: #d98c7e;
  }

  .sr-results {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
  }

  .sr-card {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.55), rgba(15, 15, 16, 0.85));
    padding: 1rem 1.2rem;
    transition: border-color 200ms ease;
  }

  .sr-card:hover {
    border-color: var(--hc-rule-strong);
  }

  .sr-chips {
    margin: 0 0 0.45rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .sr-chips span {
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-pill);
    color: var(--hc-gold-dim);
    font-family: var(--font-ui);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .sr-card-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.1;
  }

  .sr-card-title a {
    color: var(--hc-parchment);
    text-decoration: none;
  }

  .sr-card-title a:hover {
    color: var(--hc-gold);
  }

  .sr-excerpt {
    margin: 0;
    color: var(--hc-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .sr-excerpt[dir="auto"]:lang(en) {
    unicode-bidi: plaintext;
  }

  .sr-excerpt :global(mark) {
    background: rgba(216, 177, 102, 0.45);
    color: var(--hc-parchment);
    border-radius: 2px;
    padding: 0 0.1em;
  }

  .sr-more-wrap {
    margin-top: 1.6rem;
    text-align: center;
  }

  @media (max-width: 720px) {
    .sr-form {
      grid-template-columns: 1fr;
    }
    .sr-form select {
      max-width: none;
    }
  }
</style>
