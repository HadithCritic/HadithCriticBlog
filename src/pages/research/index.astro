---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { graph, layoutTimeline, authorLine, venueLine, THEME_ORDER, type Work } from '../../lib/research-graph';

const { data, workById, cites, citedBy, partOf, parts, partPage } = graph;
const timeline = layoutTimeline(graph);
const nodeAt = new Map(timeline.nodes.map((n) => [n.id, n]));

/* Node fills are the jacket colors used on the academic studies register. They mark
   the main theme of a work and carry no judgment of it. */
const THEME_STYLE: Record<string, { bg: string; accent: string }> = {
  'Dating and common links': { bg: '#0b4f6c', accent: '#a6dcf0' },
  'Isnād and transmission': { bg: '#1e3670', accent: '#b4c6f5' },
  'Rijāl and jarḥ wa-taʿdīl': { bg: '#51306b', accent: '#dcc0f2' },
  'Canonization and collections': { bg: '#1f5140', accent: '#b0dcc0' },
  'Authenticity debate': { bg: '#6b1f30', accent: '#f5b8c2' },
  'Legal ḥadīth and sunna': { bg: '#a3401c', accent: '#ffd6bd' },
  'Sīra and maghāzī sources': { bg: '#6a5a1c', accent: '#f0e0a0' },
  'Shiʿi ḥadīth': { bg: '#2d4a4a', accent: '#b8dede' },
  'General studies of ḥadīth': { bg: '#4a4743', accent: '#d9d3c8' }
};
const themeIndex = (work: Work) => THEME_ORDER.findIndex((t) => work.themes.includes(t));
const mainTheme = (work: Work) => THEME_ORDER[Math.max(0, themeIndex(work))];

const themeCounts = THEME_ORDER.map((name) => ({ name, count: data.works.filter((w) => w.themes.includes(name)).length })).filter((t) => t.count > 0);

const listed = [...data.works].sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || a.title.localeCompare(b.title));

const decades = new Map<number, number>();
for (const w of data.works) if (w.year) decades.set(Math.floor(w.year / 10) * 10, (decades.get(Math.floor(w.year / 10) * 10) ?? 0) + 1);
const decadeRows = [...decades.entries()].sort((a, b) => a[0] - b[0]);
const decadeMax = Math.max(...decades.values());

const leadScholars = data.scholars.filter((s) => s.works.length > 0);
const plain = (id: string) => workById.get(id)!.title;

/* Everything the map's detail panel needs, keyed by work id. */
const atlas = Object.fromEntries(
  data.works.map((w) => [
    w.id,
    {
      t: w.title,
      a: authorLine(w),
      y: w.year ?? null,
      v: venueLine(w),
      d: w.doi ?? null,
      c: cites.get(w.id) ?? [],
      b: citedBy.get(w.id) ?? [],
      p: partOf.get(w.id) ?? null,
      k: parts.get(w.id) ?? [],
      s: w.site ?? []
    }
  ])
);
const atlasJson = JSON.stringify(atlas).replace(/</g, '\\u003c');

const shape = (w: Work) => (w.type?.includes('edited') ? 'diamond' : ['book', 'monograph', 'thesis'].includes(w.type ?? '') ? 'square' : 'circle');
---

<BaseLayout
  title="Hadith Criticism Atlas | HadithCritic Research"
  description="A map of modern scholarship on hadith criticism: who wrote what, when, and which works cite which."
>
  <div class="atlas-page">
    <header class="hc-masthead" aria-labelledby="atlas-title" data-motion="hero">
      <div class="hc-container hc-masthead__inner">
        <div>
          <p class="hc-eyebrow">Research atlas</p>
          <h1 id="atlas-title" class="hc-masthead__title">Hadith Criticism Atlas</h1>
          <p class="hc-masthead__lead">
            Modern scholarship on ḥadīth criticism, laid out by author and year, with the citations between works. Select a work to see what it cites and what cites it.
          </p>
          <div class="hc-masthead__actions">
            <a href="#map" class="hc-btn">Open the map</a>
            <a href="#works" class="hc-back-link hc-back-link--ruled">Browse all works <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <aside class="hc-instrument" aria-label="The atlas at a glance">
          <div class="hc-instrument__well">
            <dl class="hc-instrument__plate glance">
              <div class="glance__figure">
                <dt>Works</dt>
                <dd class="hc-instrument__figure">{data.works.length}</dd>
              </div>
              <div class="glance__figure">
                <dt>Scholars</dt>
                <dd class="hc-instrument__figure">{data.scholars.length}</dd>
              </div>
            </dl>

            <p class="hc-instrument__cap" id="decades-cap">Works by decade</p>
            <ol class="decades" aria-labelledby="decades-cap">
              {decadeRows.map(([decade, n]) => (
                <li>
                  <span class="decades__label">{decade}s</span>
                  <span class="decades__bar hc-hatch" style={`--w:${(n / decadeMax) * 100}%`} aria-hidden="true"></span>
                  <span class="decades__n">{n}</span>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      </div>
    </header>

    <div class="hc-container dockwrap">
      <div class="dock" role="search" data-dock hidden>
        <label class="dock__field">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input id="atlas-query" class="dock__input" type="search" placeholder="Search title, author or venue" autocomplete="off" aria-label="Search the atlas" />
          <kbd class="dock__kbd" aria-hidden="true">/</kbd>
        </label>
        <div class="dock__chips" role="group" aria-label="Filter by theme">
          {themeCounts.map((theme) => (
            <button type="button" class="chip" data-theme-filter={theme.name} aria-pressed="false">
              <span class="swatch" style={`--sw:${THEME_STYLE[theme.name].bg};--sw-ring:${THEME_STYLE[theme.name].accent}`} aria-hidden="true"></span>
              {theme.name} <span class="chip__n">{theme.count}</span>
              <svg class="chip__x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          ))}
        </div>
        <span id="atlas-count" class="dock__count" aria-live="polite">{data.works.length} of {data.works.length} works</span>
      </div>
    </div>

    <section id="map" class="map hc-container" aria-labelledby="map-title">
      <header class="sec__head">
        <h2 id="map-title" class="sec__title">Who cites whom</h2>
        <span class="sec__rule" aria-hidden="true"></span>
        <span class="sec__count">{timeline.nodes.length}</span>
      </header>
      <p class="map__lead">
        Each row is a lead author and each mark a work, placed by year. Circles are articles and chapters, squares are books and theses, diamonds are edited volumes. The year scale widens after 1990. A solid line runs to a work the selected one cites, a dashed line from a work that cites it.
      </p>

      <div class="map__grid">
        <div class="map__scroll" tabindex="0" role="region" aria-label="Timeline map, scrolls sideways on small screens">
          <svg class="map__svg" viewBox={`0 0 ${timeline.width} ${timeline.height}`} width={timeline.width} height={timeline.height} style={`min-width:${timeline.width}px`} role="img" aria-label="Timeline of works by lead author and year. The works are also listed below.">
            {timeline.rows.map((row, i) => (
              <g class="map__row">
                {i % 2 === 0 && <rect class="map__band" x="0" y={row.y - 15} width={timeline.width} height="30" />}
                <text class="map__name" x={timeline.left - 14} y={row.y + 4} text-anchor="end">{row.name}</text>
              </g>
            ))}
            {timeline.ticks.map((tick) => (
              <g>
                <line class="map__tick" x1={tick.x} x2={tick.x} y1="26" y2={timeline.height - 4} />
                <text class="map__year" x={tick.x} y="16" text-anchor="middle">{tick.year}</text>
              </g>
            ))}
            <line class="map__tick" x1={timeline.undatedX} x2={timeline.undatedX} y1="26" y2={timeline.height - 4} />
            <text class="map__year" x={timeline.undatedX} y="16" text-anchor="middle">n.d.</text>

            <g data-edges></g>

            {data.works.map((w) => {
              const n = nodeAt.get(w.id)!;
              const style = THEME_STYLE[mainTheme(w)];
              return (
                <g
                  class={`node node--${shape(w)}`}
                  data-node={w.id}
                  data-themes={w.themes.join('|')}
                  transform={`translate(${n.x} ${n.y})`}
                  style={`--nb:${style.bg}`}
                >
                  <title>{w.title}{w.year ? ` (${w.year})` : ''}</title>
                  {shape(w) === 'square' ? <rect x="-6" y="-6" width="12" height="12" /> : shape(w) === 'diamond' ? <path d="M0 -8 8 0 0 8 -8 0Z" /> : <circle r="6.5" />}
                </g>
              );
            })}
          </svg>
        </div>

        <aside class="panel" data-panel aria-live="polite" hidden>
          <p class="panel__empty" data-panel-empty>Select a work on the map to see its citations within this collection.</p>
          <div data-panel-body hidden></div>
        </aside>
      </div>
    </section>

    <section id="works" class="works hc-container" aria-labelledby="works-title">
      <header class="sec__head">
        <h2 id="works-title" class="sec__title">Works</h2>
        <span class="sec__rule" aria-hidden="true"></span>
        <span class="sec__count">{data.works.length}</span>
      </header>
      <ol class="list">
        {listed.map((w) => {
          const out = cites.get(w.id) ?? [];
          const inn = citedBy.get(w.id) ?? [];
          return (
            <li
              class="work"
              id={w.id}
              data-work
              data-themes={w.themes.join('|')}
              data-search={`${w.title} ${w.publishedTitle ?? ''} ${authorLine(w)} ${venueLine(w)} ${w.year ?? ''} ${partOf.has(w.id) ? plain(partOf.get(w.id)!) : ''}`}
            >
              <span class="work__year">{w.year ?? 'n.d.'}</span>
              <div class="work__main">
                <h3 class="work__title">
                  {w.doi ? (
                    <a href={`https://doi.org/${w.doi}`} target="_blank" rel="noopener noreferrer">{w.title}<span class="sr-only"> (opens in a new tab)</span></a>
                  ) : (
                    w.title
                  )}
                </h3>
                <p class="work__by">{authorLine(w)}{venueLine(w) ? ` · ${venueLine(w)}` : ''}</p>
                {partOf.has(w.id) && (
                  <p class="work__in">
                    Printed inside <a href={`#${partOf.get(w.id)}`}>{plain(partOf.get(w.id)!)}</a>
                    {partPage.has(w.id) ? `, beginning on page ${partPage.get(w.id)}` : ''}.
                  </p>
                )}
                <p class="work__meta">
                  {w.themes.join(' · ')}
                  {w.openAccess && <span class="work__oa"> · Open access</span>}
                </p>
                {w.methods && w.methods.length > 0 && <p class="work__meta work__meta--quiet">Method terms in the text: {w.methods.join(', ')}</p>}
                {w.publishedTitle && <p class="work__meta work__meta--quiet">Published title: {w.publishedTitle}</p>}
                {w.originalNote && <p class="work__meta work__meta--quiet">First edition: {w.originalNote}</p>}
                {w.revisedCopy && <p class="work__meta work__meta--quiet">The copy in the library is a later revision of this work.</p>}
                {w.unconfirmed && <p class="work__meta work__meta--quiet">Some bibliographic details are still to be confirmed.</p>}
                {w.site && w.site.length > 0 && (
                  <p class="work__site">
                    {w.site.map((link) => (
                      <a class="hc-back-link" href={link.slug ? `/blogs/${link.slug}/` : link.href}>{link.label} <span aria-hidden="true">→</span></a>
                    ))}
                  </p>
                )}
                {(parts.get(w.id)?.length ?? 0) > 0 && (
                  <details class="work__rel">
                    <summary>Prints {parts.get(w.id)!.length} studies, each listed as its own work</summary>
                    <ul>{parts.get(w.id)!.map((id) => <li><a href={`#${id}`}>{plain(id)}</a>{partPage.has(id) ? `, page ${partPage.get(id)}` : ''}</li>)}</ul>
                  </details>
                )}
                {(out.length > 0 || inn.length > 0) && (
                  <details class="work__rel">
                    <summary>Cites {out.length} · Cited by {inn.length} in this collection</summary>
                    {out.length > 0 && (
                      <>
                        <h4>Cites</h4>
                        <ul>{out.map((id) => <li><a href={`#${id}`}>{plain(id)}</a></li>)}</ul>
                      </>
                    )}
                    {inn.length > 0 && (
                      <>
                        <h4>Cited by</h4>
                        <ul>{inn.map((id) => <li><a href={`#${id}`}>{plain(id)}</a></li>)}</ul>
                      </>
                    )}
                  </details>
                )}
              </div>
              <button type="button" class="work__show" data-show={w.id} hidden>Show on map</button>
            </li>
          );
        })}
      </ol>
      <div id="atlas-empty" class="empty" hidden>
        <p>No works match these filters.</p>
        <button type="button" id="atlas-reset" class="hc-btn hc-btn--ghost">Clear search and filters</button>
      </div>
    </section>

    <section id="scholars" class="scholars hc-container" aria-labelledby="scholars-title">
      <header class="sec__head">
        <h2 id="scholars-title" class="sec__title">Scholars</h2>
        <span class="sec__rule" aria-hidden="true"></span>
        <span class="sec__count">{leadScholars.length}</span>
      </header>
      <ul class="people">
        {leadScholars.map((s) => (
          <li>
            <details class="person">
              <summary>
                <span class="person__name">{s.name}</span>
                <span class="person__meta">{s.works.length} {s.works.length === 1 ? 'work' : 'works'}{s.firstYear ? ` · ${s.firstYear === s.lastYear ? s.firstYear : `${s.firstYear}–${s.lastYear}`}` : ''}</span>
              </summary>
              <ul class="person__works">
                {s.works.map((id) => <li><a href={`#${id}`}>{plain(id)}</a></li>)}
              </ul>
            </details>
          </li>
        ))}
      </ul>
    </section>

    <section class="note hc-container" aria-labelledby="note-title">
      <div class="note__tray">
        <div class="note__well">
          <p class="hc-eyebrow">About this atlas</p>
          <h2 id="note-title" class="note__title">What it covers, and what it does not</h2>
          <ul class="note__list">
            <li><strong>Scope.</strong> It maps the {data.works.length} works in the HadithCritic research library, not the whole field. Coverage grows as works are added.</li>
            <li><strong>Studies inside books.</strong> Where a book prints several studies, each study is a work of its own and is marked as printed inside the book, with the page it begins on, so the original volume is one click away.</li>
            <li><strong>Relations.</strong> One work is linked to another when its text names the other's title beside the author's surname. Each link is traceable to the citing work's pages.</li>
            <li><strong>Bibliography.</strong> Titles, years and DOIs are checked against Crossref and each work's own title page. Anything not yet confirmed is marked.</li>
            <li><strong>No grades.</strong> The atlas does not rate works or scholars. Colors mark a main theme only.</li>
            <li><strong>Pending.</strong> A few scanned books are still awaiting OCR, and a feed of newly published work is planned.</li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <script is:inline type="application/json" id="atlas-data" set:html={atlasJson}></script>
</BaseLayout>

<script>
  type Entry = { t: string; a: string; y: number | null; v: string; d: string | null; c: string[]; b: string[]; p: string | null; k: string[]; s: { href: string; label: string; slug?: string }[] };

  const page = document.querySelector<HTMLElement>('.atlas-page');
  const raw = document.getElementById('atlas-data')?.textContent;

  if (page && raw) {
    const atlas: Record<string, Entry> = JSON.parse(raw);
    const svgNS = 'http://www.w3.org/2000/svg';
    const dock = page.querySelector<HTMLElement>('[data-dock]');
    const input = page.querySelector<HTMLInputElement>('#atlas-query');
    const count = page.querySelector<HTMLElement>('#atlas-count');
    const empty = page.querySelector<HTMLElement>('#atlas-empty');
    const reset = page.querySelector<HTMLButtonElement>('#atlas-reset');
    const chips = [...page.querySelectorAll<HTMLButtonElement>('.chip')];
    const rows = [...page.querySelectorAll<HTMLElement>('[data-work]')];
    const nodes = [...page.querySelectorAll<SVGGElement>('[data-node]')];
    const nodeById = new Map(nodes.map((n) => [n.dataset.node!, n]));
    const edgeLayer = page.querySelector<SVGGElement>('[data-edges]')!;
    const panel = page.querySelector<HTMLElement>('[data-panel]')!;
    const panelEmpty = panel.querySelector<HTMLElement>('[data-panel-empty]')!;
    const panelBody = panel.querySelector<HTMLElement>('[data-panel-body]')!;
    let theme = '';
    let selected = '';

    const pos = (id: string) => {
      const m = /translate\(([-\d.]+)[ ,]([-\d.]+)\)/.exec(nodeById.get(id)?.getAttribute('transform') ?? '');
      return m ? { x: Number(m[1]), y: Number(m[2]) } : null;
    };

    function curve(from: string, to: string, cls: string) {
      const a = pos(from);
      const b = pos(to);
      if (!a || !b) return;
      const path = document.createElementNS(svgNS, 'path');
      const lift = Math.max(24, Math.abs(a.y - b.y) * 0.35);
      path.setAttribute('d', `M${a.x} ${a.y} C${a.x + lift} ${a.y} ${b.x - lift} ${b.y} ${b.x} ${b.y}`);
      path.setAttribute('class', `edge ${cls}`);
      edgeLayer.appendChild(path);
    }

    function link(id: string) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'panel__link';
      btn.textContent = `${atlas[id].t}${atlas[id].y ? ` (${atlas[id].y})` : ''}`;
      btn.addEventListener('click', () => select(id));
      const li = document.createElement('li');
      li.appendChild(btn);
      return li;
    }

    function group(title: string, ids: string[]) {
      const wrap = document.createDocumentFragment();
      const h = document.createElement('h4');
      h.textContent = `${title} (${ids.length})`;
      const ul = document.createElement('ul');
      ul.className = 'panel__list';
      ids.forEach((id) => ul.appendChild(link(id)));
      wrap.appendChild(h);
      wrap.appendChild(ids.length ? ul : Object.assign(document.createElement('p'), { className: 'panel__none', textContent: 'None in this collection.' }));
      return wrap;
    }

    function select(id: string) {
      selected = id;
      const e = atlas[id];
      edgeLayer.replaceChildren();
      e.c.forEach((to) => curve(id, to, 'edge--out'));
      e.b.forEach((from) => curve(from, id, 'edge--in'));
      const related = new Set([id, ...e.c, ...e.b, ...e.k, ...(e.p ? [e.p] : [])]);
      nodes.forEach((n) => {
        const nid = n.dataset.node!;
        n.classList.toggle('is-selected', nid === id);
        n.classList.toggle('is-related', related.has(nid) && nid !== id);
        n.classList.toggle('is-faded', !related.has(nid));
      });

      panelBody.replaceChildren();
      const title = document.createElement('h3');
      title.className = 'panel__title';
      title.textContent = e.t;
      const by = document.createElement('p');
      by.className = 'panel__by';
      by.textContent = [e.a, e.y, e.v].filter(Boolean).join(' · ');
      panelBody.appendChild(title);
      panelBody.appendChild(by);
      if (e.p) {
        const inside = document.createElement('p');
        inside.className = 'panel__in';
        inside.append('Printed inside ');
        const open = document.createElement('button');
        open.type = 'button';
        open.className = 'panel__link panel__link--inline';
        open.textContent = atlas[e.p].t;
        open.addEventListener('click', () => select(e.p!));
        inside.appendChild(open);
        panelBody.appendChild(inside);
      }
      if (e.d) {
        const a = document.createElement('a');
        a.className = 'hc-back-link hc-back-link--ruled';
        a.href = `https://doi.org/${e.d}`;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.textContent = 'Open the work (DOI) ↗';
        panelBody.appendChild(a);
      }
      if (e.k.length) panelBody.appendChild(group('Studies printed inside it', e.k));
      panelBody.appendChild(group('Cites', e.c));
      panelBody.appendChild(group('Cited by', e.b));
      const listed = document.getElementById(id);
      if (listed) {
        const a = document.createElement('a');
        a.className = 'hc-back-link';
        a.href = `#${id}`;
        a.textContent = 'See it in the list →';
        panelBody.appendChild(a);
      }
      panelEmpty.hidden = true;
      panelBody.hidden = false;
    }

    function clearSelection() {
      selected = '';
      edgeLayer.replaceChildren();
      nodes.forEach((n) => n.classList.remove('is-selected', 'is-related', 'is-faded'));
      panelBody.hidden = true;
      panelEmpty.hidden = false;
    }

    function apply() {
      const q = (input?.value ?? '').trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const themes = (row.dataset.themes ?? '').split('|');
        const ok = (q === '' || (row.dataset.search ?? '').toLowerCase().includes(q)) && (theme === '' || themes.includes(theme));
        row.hidden = !ok;
        nodeById.get(row.id)?.classList.toggle('is-filtered', !ok);
        if (ok) visible += 1;
      }
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.themeFilter === theme)));
      if (count) count.textContent = `${visible} of ${rows.length} works`;
      if (empty) {
        empty.hidden = visible > 0;
        const p = empty.querySelector('p');
        if (p) p.textContent = q ? `No works match "${input?.value.trim()}".` : 'No works match these filters.';
      }
      const url = new URL(location.href);
      q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
      theme ? url.searchParams.set('theme', theme) : url.searchParams.delete('theme');
      history.replaceState(null, '', url);
    }

    const params = new URLSearchParams(location.search);
    if (input) input.value = params.get('q') ?? '';
    const asked = params.get('theme') ?? '';
    if (chips.some((c) => c.dataset.themeFilter === asked)) theme = asked;

    input?.addEventListener('input', apply);
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        theme = theme === chip.dataset.themeFilter ? '' : (chip.dataset.themeFilter ?? '');
        apply();
      })
    );
    reset?.addEventListener('click', () => {
      if (input) input.value = '';
      theme = '';
      apply();
      input?.focus();
    });

    nodes.forEach((n) => {
      const id = n.dataset.node!;
      n.setAttribute('tabindex', '0');
      n.setAttribute('role', 'button');
      n.setAttribute('aria-label', `${atlas[id].t}, ${atlas[id].a}${atlas[id].y ? `, ${atlas[id].y}` : ''}`);
      n.addEventListener('click', () => select(id));
      n.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' || ev.key === ' ') {
          ev.preventDefault();
          select(id);
        }
      });
    });
    page.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((btn) => {
      btn.hidden = false;
      btn.addEventListener('click', () => {
        select(btn.dataset.show!);
        document.getElementById('map')?.scrollIntoView({ block: 'start' });
      });
    });
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && selected) clearSelection();
      if (ev.key !== '/' || ev.metaKey || ev.ctrlKey || ev.altKey) return;
      const t = ev.target;
      if (t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement || t instanceof HTMLSelectElement) return;
      ev.preventDefault();
      input?.focus();
    });

    page.querySelector('.map__svg')?.setAttribute('aria-label', 'Timeline of works by lead author and year. Select a work to see its citations.');
    if (dock) dock.hidden = false;
    panel.hidden = false;
    apply();
    const hashTarget = location.hash.slice(1);
    if (hashTarget && atlas[hashTarget]) select(hashTarget);
  }
</script>

<style>
