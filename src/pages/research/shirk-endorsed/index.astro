---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ManuscriptLightbox from '../../../components/treatise/ManuscriptLightbox.astro';
import chaptersData from '../../../data/shirk-endorsed/chapters.json';
import scholarsData from '../../../data/shirk-endorsed/scholars.json';
import '../../../styles/treatise-index.css';

const coreChapters = chaptersData.filter((c) => c.category === 'core');
const imamsChapters = chaptersData.filter((c) => c.category === 'four-imams');
const overviewChapter = chaptersData.find((c) => c.category === 'scholars-overview');

// Summary statistics for the register
const ledgerTotal = scholarsData.length;
const ledgerScans = scholarsData.reduce((n, s) => n + (s.scans?.length ?? 0), 0);
const ledgerYears = scholarsData.map((s) => s.deathYear).filter(Boolean) as number[];
const ledgerSpan = `${Math.min(...ledgerYears)}–${Math.max(...ledgerYears)}`;

const SCHOOLS = ['Shāfiʿī', 'Ḥanbalī', 'Mālikī', 'Ḥanafī'];
const ledgerSchools = SCHOOLS.map((label) => ({
  label,
  count: scholarsData.filter((s) => (s.madhhab || '').startsWith(label)).length
})).filter((s) => s.count > 0);

// Leading scholar preview for each of the four madhhabs
const previewScholars = SCHOOLS.map((school) =>
  scholarsData.find((s) => (s.madhhab || '').startsWith(school))
).filter(Boolean) as typeof scholarsData;
---

<BaseLayout
  title="Shirk: Endorsed By The Scholars of Islam | Critical Research Edition"
  description="Ten centuries of classical Sunni consensus on Tawassul, Tashaffuʿ, and Istighāthah across 99 classical authorities and 207 primary source scans."
>
  <div class="treatise-index-page">
    <!-- Scholarly Editorial Hero -->
    <header class="edition-hero">
      <div class="wrap">
        <div class="hero-main">
          <h1 class="hero-title">
            Shirk: Endorsed By The <span class="hero-title-accent">Scholars of Islam.</span>
          </h1>

          <p class="hero-lead">
            Ten centuries of classical Sunni consensus on <em>Tawassul</em> and <em>Istighāthah</em>—documenting 99 major authorities across all four madhhabs and the historical paradox of modern Salafi anathema.
          </p>

          <div class="hero-actions">
            <a href="/research/shirk-endorsed/introduction" class="hc-btn hero-btn-primary">
              <span>Begin Monograph</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
            <a href="/research/shirk-endorsed/ledger" class="hc-btn hc-btn--ghost hero-btn-secondary">
              <span>Browse 99 Scholars</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
            </a>
          </div>

          <!-- Hero Evidentiary Strip -->
          <div class="hero-stats">
            <div class="hero-stat-card">
              <span class="hero-stat-num">{ledgerTotal}</span>
              <span class="hero-stat-label">Classical Authorities</span>
            </div>
            <div class="hero-stat-card">
              <span class="hero-stat-num">4</span>
              <span class="hero-stat-label">Sunni Madhhabs</span>
            </div>
            <div class="hero-stat-card">
              <span class="hero-stat-num">{ledgerScans}</span>
              <span class="hero-stat-label">Primary Scans</span>
            </div>
            <div class="hero-stat-card">
              <span class="hero-stat-num">{ledgerSpan}</span>
              <span class="hero-stat-label">AH Hijri Span</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Thesis Abstract & The Central Dilemma -->
    <section class="section-dilemma" id="central-dilemma">
      <div class="wrap">
        <div class="editorial-divider">
          <span class="divider-num">00</span>
          <div class="divider-text">
            <h2 class="divider-title">The Central Dilemma</h2>
            <span class="divider-sub">The Inescapable Historical Paradox</span>
          </div>
          <div class="divider-line" aria-hidden="true"></div>
        </div>

        <div class="dilemma-content">
          <div class="thesis-highlight">
            <blockquote class="thesis-quote">
              “If seeking intercession through the Prophet is indeed major shirk, then according to strict Salafi logic, the greatest jurists, muftis, and hadith masters of Sunni history were practitioners of idolatry.”
            </blockquote>
          </div>

          <div class="comparison-grid">
            <div class="comparison-card comparison-card--salafi">
              <div class="comparison-card__header">
                <span class="comparison-card__badge">Modern Salafi-Wahhabi Position</span>
              </div>
              <h3 class="comparison-card__title">Universal Excommunication</h3>
              <p class="comparison-card__text">
                Classifies invoking the Prophet ﷺ for intercession or relief at his grave as <em>Shirk Akbar</em>—an unforgivable nullifier that expels the actor from Islam without excuse of ignorance.
              </p>
              <div class="comparison-card__verdict">
                <span class="verdict-label">RULING:</span>
                <span class="verdict-value">Shirk Akbar (Nullifier of Islam)</span>
              </div>
            </div>

            <div class="comparison-card comparison-card--sunni">
              <div class="comparison-card__header">
                <span class="comparison-card__badge">Classical Sunni Consensus</span>
              </div>
              <h3 class="comparison-card__title">Normative Consensus (4 Madhhabs)</h3>
              <p class="comparison-card__text">
                All four founding Imams and their schools recorded these supplications as sunnah and mustaḥabb in canonical pilgrimage manuals (<em>kutub al-manāsik</em>) for over ten centuries.
              </p>
              <div class="comparison-card__verdict">
                <span class="verdict-label">RULING:</span>
                <span class="verdict-value">Sunnah & Mustaḥabb (Canonically Prescribed)</span>
              </div>
            </div>
          </div>

          <div class="paradox-summary-box">
            <div class="paradox-step">
              <span class="paradox-step__num">1</span>
              <div class="paradox-step__body">
                <span class="paradox-step__title">Salafi Creed</span>
                <span class="paradox-step__desc">Invoking intermediaries at the grave is defined as major shirk (<em>shirk akbar</em>).</span>
              </div>
            </div>
            <div class="paradox-step-arrow" aria-hidden="true">→</div>
            <div class="paradox-step">
              <span class="paradox-step__num">2</span>
              <div class="paradox-step__body">
                <span class="paradox-step__title">Historical Reality</span>
                <span class="paradox-step__desc">Ten centuries of canonical jurists across all 4 madhhabs practiced and endorsed it.</span>
              </div>
            </div>
            <div class="paradox-step-arrow" aria-hidden="true">→</div>
            <div class="paradox-step paradox-step--final">
              <span class="paradox-step__num">3</span>
              <div class="paradox-step__body">
                <span class="paradox-step__title">The Theological Impasse</span>
                <span class="paradox-step__desc">Salafism relies on these very scholars for its hadith and fiqh while anathematizing them.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Reading Track Section -->
    <section class="reading-track-section" id="reading-track">
      <div class="wrap">
        <div class="editorial-divider">
          <span class="divider-num">01</span>
          <div class="divider-text">
            <h2 class="divider-title">Reading Track</h2>
            <span class="divider-sub">The Developed Theological Argument</span>
          </div>
          <div class="divider-line" aria-hidden="true"></div>
        </div>

        <p class="reading-track-desc">
          Follow the structured monograph through primary textual sources, foundational hadith chains, and the legal verdicts of the four Sunni Imams.
        </p>

        <div class="chapters-grid">
          <!-- Part I -->
          <div class="part-column">
            <div class="part-header">
              <span class="part-tag">PART I</span>
              <h3 class="part-title">Foundational Studies & Hadith Analyses</h3>
            </div>
            <div class="chapter-ledger">
              {coreChapters.map((c, i) => (
                <a href={`/research/shirk-endorsed/${c.id}`} class="chapter-row">
                  <span class="chapter-row__num">{String(i + 1).padStart(2, '0')}</span>
                  <div class="chapter-row__body">
                    <h4 class="chapter-row__title">{c.title}</h4>
                    <span class="chapter-row__meta">Critical Analysis & Textual Critique</span>
                  </div>
                  <svg class="chapter-row__arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              ))}
            </div>
          </div>

          <!-- Part II -->
          <div class="part-column">
            <div class="part-header">
              <span class="part-tag part-tag--gold">PART II</span>
              <h3 class="part-title">The Four Sunni Imams</h3>
            </div>
            <div class="chapter-ledger">
              {imamsChapters.map((c, i) => (
                <a href={`/research/shirk-endorsed/${c.id}`} class="chapter-row chapter-row--imams">
                  <span class="chapter-row__num chapter-row__num--gold">{String(i + 1).padStart(2, '0')}</span>
                  <div class="chapter-row__body">
                    <h4 class="chapter-row__title">{c.title}</h4>
                    <span class="chapter-row__meta">Madhhab Canon & Juristic Manuals</span>
                  </div>
                  <svg class="chapter-row__arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              ))}
            </div>

            <!-- Spotlight: Scholars Worth Mentioning -->
            {overviewChapter && (
              <div class="part-spotlight">
                <a href={`/research/shirk-endorsed/${overviewChapter.id}`} class="spotlight-card">
                  <div class="spotlight-badge">PREFATORY MONOGRAPH</div>
                  <h4 class="spotlight-title">{overviewChapter.title}</h4>
                  <p class="spotlight-text">
                    An archival overview contextualizing classical juristic consensus before examining individual scholar dossiers.
                  </p>
                  <span class="spotlight-action">Read overview monograph →</span>
                </a>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Part III: Archival Evidence Ledger Section -->
    <section class="section-ledger" id="archival-ledger">
      <div class="wrap">
        <div class="editorial-divider">
          <span class="divider-num">02</span>
          <div class="divider-text">
            <h2 class="divider-title">Archival Evidence Ledger</h2>
            <span class="divider-sub">Chronological Register of {ledgerTotal} Classical Sunni Authorities</span>
          </div>
          <div class="divider-line" aria-hidden="true"></div>
        </div>

        <div class="ledger-intro-grid">
          <div class="ledger-intro-text">
            <p class="ledger-lead-desc">
              Every authority cited across this edition is indexed chronologically by death year, accompanied by canonical work citations and primary printed manuscript scans.
            </p>
            <div class="ledger-schools-bar">
              <span class="ledger-schools-label">Juristic Traditions:</span>
              <ul class="ledger-schools-list">
                {ledgerSchools.map((s) => (
                  <li class="school-chip">
                    <span class="school-chip__name">{s.label}</span>
                    <span class="school-chip__count">{s.count}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="ledger-gateway-card">
            <div class="gateway-stats">
              <div class="gateway-stat">
                <span class="gateway-stat__num">{ledgerTotal}</span>
                <span class="gateway-stat__label">Authorities</span>
              </div>
              <div class="gateway-stat">
                <span class="gateway-stat__num">{ledgerScans}</span>
                <span class="gateway-stat__label">Primary Scans</span>
              </div>
              <div class="gateway-stat">
                <span class="gateway-stat__num">{ledgerSpan}</span>
                <span class="gateway-stat__label">AH Span</span>
              </div>
            </div>
            <a href="/research/shirk-endorsed/ledger" class="hc-btn gateway-cta">
              <span>Open 99-Scholar Evidence Ledger</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>

        <!-- Four Madhhab Sample Dossiers Preview -->
        <div class="sample-dossiers-section">
          <div class="sample-dossiers-header">
            <h3 class="sample-dossiers-heading">Sample Juristic Dossiers from the Four Madhhabs</h3>
            <a href="/research/shirk-endorsed/ledger" class="view-all-link">
              View all 99 scholars →
            </a>
          </div>
          <div class="dossiers-grid">
            {previewScholars.map((s) => (
              <a href={`/research/shirk-endorsed/${s.id}`} class="dossier-card">
                <div class="dossier-card__meta">
                  <span class="dossier-card__school">{s.madhhab}</span>
                  <span class="dossier-card__era">{s.deathYear ? `d. ${s.deathYear} AH` : 'Classical'}</span>
                </div>
                <h4 class="dossier-card__name">{s.name}</h4>
                <div class="dossier-card__footer">
                  <span class="dossier-card__scans">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    {s.scans?.length ?? 0} {s.scans?.length === 1 ? 'Scan' : 'Scans'} Proof
                  </span>
                  <span class="dossier-card__arrow" aria-hidden="true">→</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>

  <ManuscriptLightbox />
</BaseLayout>
