---
import TreatiseLayout from '../../../layouts/TreatiseLayout.astro';
import ScholarLedger from '../../../components/treatise/ScholarLedger.astro';
import scholarsData from '../../../data/shirk-endorsed/scholars.json';

const total = scholarsData.length;
const scanCount = scholarsData.reduce((n, s) => n + (s.scans?.length ?? 0), 0);
const years = scholarsData.map((s) => s.deathYear).filter(Boolean) as number[];
const firstYear = Math.min(...years);
const lastYear = Math.max(...years);
---

<TreatiseLayout
  title="Archival Evidence Ledger"
  description={`Chronological register of ${total} classical Sunni authorities on Tawassul, Tashaffuʿ and Istighātha, with ${scanCount} primary source scans, spanning ${firstYear}–${lastYear} AH.`}
  currentSlug="ledger"
  variant="wide"
>
  <header class="ledger-head">
    <span class="ledger-eyebrow">Part III · Archival Register</span>
    <h1 class="ledger-title" id="ledger-top" tabindex="-1">Archival Evidence Ledger</h1>
    <p class="ledger-lead">
      Every authority cited in this edition, in order of death year. Filter by school or century, or search by name or book title. Open an entry for its full citation and page scans.
    </p>

    <dl class="ledger-facts">
      <div><dt>Authorities</dt><dd>{total}</dd></div>
      <div><dt>Primary Scans</dt><dd>{scanCount}</dd></div>
      <div><dt>AH Span</dt><dd>{firstYear}–{lastYear}</dd></div>
    </dl>
  </header>

  <ScholarLedger />
</TreatiseLayout>

<style>
  .ledger-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .ledger-eyebrow {
    display: block;
    margin-bottom: 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .ledger-title {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.12rem, 5.2vw, 3.4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--hc-text-primary);
    text-wrap: balance;
  }

  .ledger-title:focus {
    outline: none;
  }

  .ledger-lead {
    max-width: 68ch;
    margin: 1rem 0 0;
    font-family: var(--font-body);
    font-size: 1.12rem;
    line-height: 1.72;
    color: var(--hc-text-secondary);
  }

  .ledger-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2rem 0 0;
    border-top: 1px solid var(--hc-rule);
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .ledger-facts > div {
    position: relative;
    padding: 1rem 1.2rem 1.1rem 0;
  }

  .ledger-facts > div + div {
    padding-left: 1.2rem;
  }

  .ledger-facts > div + div::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 1px;
    background: var(--hc-rule-soft);
  }

  .ledger-facts dt {
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .ledger-facts dd {
    margin: 0.32rem 0 0;
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 2.4vw, 1.83rem);
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: -0.025em;
    color: var(--hc-text-primary);
  }

  @media (max-width: 700px) {
    .ledger-facts {
      grid-template-columns: 1fr;
    }

    .ledger-facts > div + div {
      padding-left: 0;
      border-top: 1px solid var(--hc-rule-soft);
    }

    .ledger-facts > div + div::before {
      display: none;
    }
  }
</style>
