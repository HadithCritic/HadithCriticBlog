---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ScholarLedger from '../../../components/treatise/ScholarLedger.astro';
import ManuscriptLightbox from '../../../components/treatise/ManuscriptLightbox.astro';
import scholarsData from '../../../data/shirk-endorsed/scholars.json';

// The full register lives on its own page. It carries 99 dossiers and 197
// scans, which is the substance of the edition but far too much to unroll
// underneath the entry page.
const total = scholarsData.length;
const scanCount = scholarsData.reduce((n, s) => n + (s.scans?.length ?? 0), 0);
const years = scholarsData.map((s) => s.deathYear).filter(Boolean) as number[];
---

<BaseLayout
  title="Archival Evidence Ledger | Shirk: Endorsed By The Scholars of Islam"
  description={`Chronological register of ${total} classical Sunni authorities on Tawassul, Tashaffuʿ and Istighātha, with ${scanCount} primary source scans, spanning ${Math.min(...years)}–${Math.max(...years)} AH.`}
>
  <div class="ledger-page">
    <nav class="edition-breadcrumb" aria-label="Breadcrumb">
      <div class="wrap">
        <ol class="breadcrumb-list">
          <li><a href="/" class="crumb-link">HadithCritic</a></li>
          <li class="crumb-sep" aria-hidden="true">/</li>
          <li><a href="/research/shirk-endorsed" class="crumb-link">Shirk: Endorsed By The Scholars</a></li>
          <li class="crumb-sep" aria-hidden="true">/</li>
          <li class="crumb-current" aria-current="page">Archival Evidence Ledger</li>
        </ol>
      </div>
    </nav>

    <header class="ledger-head">
      <div class="wrap">
        <span class="ledger-eyebrow">Part III</span>
        <h1 class="ledger-title">Archival Evidence Ledger</h1>
        <p class="ledger-lead">
          Every authority cited in this edition, in order of death year, with the
          citation and the printed page it comes from. Filter by school or century,
          or search by name or book title.
        </p>
        <dl class="ledger-facts">
          <div><dt>Authorities</dt><dd>{total}</dd></div>
          <div><dt>Source scans</dt><dd>{scanCount}</dd></div>
          <div><dt>Span</dt><dd>{Math.min(...years)}–{Math.max(...years)} AH</dd></div>
        </dl>
      </div>
    </header>

    <div class="wrap">
      <ScholarLedger />
    </div>
  </div>

  <ManuscriptLightbox />
</BaseLayout>

<style>
  .ledger-page {
    background: var(--hc-surface-0, #0c0c0d);
    min-height: 100vh;
    padding-bottom: 5rem;
  }

  .wrap {
    max-width: 78rem;
    margin: 0 auto;
    padding-inline: 1.25rem;
  }

  .edition-breadcrumb {
    padding: 1.25rem 0 0;
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-ui);
    font-size: 0.72rem;
  }

  .crumb-link {
    color: var(--hc-text-tertiary);
    text-decoration: none;
  }

  .crumb-link:hover {
    color: var(--hc-gold);
  }

  .crumb-sep {
    color: var(--hc-text-tertiary);
    opacity: 0.5;
  }

  .crumb-current {
    color: var(--hc-text-secondary);
  }

  .ledger-head {
    padding: 2.5rem 0 2rem;
  }

  .ledger-eyebrow {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .ledger-title {
    margin: 0.6rem 0 0;
    font-family: var(--font-display, serif);
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .ledger-lead {
    margin: 0.85rem 0 0;
    max-width: 62ch;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--hc-text-secondary);
  }

  .ledger-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2.25rem;
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .ledger-facts dt {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .ledger-facts dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-display, serif);
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
    color: var(--hc-gold);
  }
</style>
