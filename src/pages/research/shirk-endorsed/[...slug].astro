---
import TreatiseLayout from '../../../layouts/TreatiseLayout.astro';
import chaptersData from '../../../data/shirk-endorsed/chapters.json';
import scholarsData from '../../../data/shirk-endorsed/scholars.json';
import quranData from '../../../data/quran-verses.json';
import { marked } from 'marked';

export async function getStaticPaths() {
  const paths: any[] = [];

  // 1. Core Chapters (13 items)
  for (let i = 0; i < chaptersData.length; i++) {
    const chap = chaptersData[i];
    const prev = i > 0 ? { title: chaptersData[i - 1].title, href: `/research/shirk-endorsed/${chaptersData[i - 1].id}` } : null;
    const next = i < chaptersData.length - 1 ? { title: chaptersData[i + 1].title, href: `/research/shirk-endorsed/${chaptersData[i + 1].id}` } : (
      scholarsData.length > 0 ? { title: scholarsData[0].title, href: `/research/shirk-endorsed/${scholarsData[0].id}` } : null
    );

    paths.push({
      params: { slug: chap.id },
      props: {
        item: chap,
        isScholar: false,
        prevPage: prev,
        nextPage: next
      }
    });
  }

  // 2. Scholar Dossiers (99 items)
  for (let i = 0; i < scholarsData.length; i++) {
    const sch = scholarsData[i];
    const prev = i > 0 ? { title: scholarsData[i - 1].title, href: `/research/shirk-endorsed/${scholarsData[i - 1].id}` } : {
      title: 'Scholars Worth Mentioning',
      href: '/research/shirk-endorsed/scholars-worth-mentioning'
    };
    const next = i < scholarsData.length - 1 ? { title: scholarsData[i + 1].title, href: `/research/shirk-endorsed/${scholarsData[i + 1].id}` } : null;

    paths.push({
      params: { slug: sch.id },
      props: {
        item: sch,
        isScholar: true,
        prevPage: prev,
        nextPage: next
      }
    });
  }

  return paths;
}

const { item, isScholar, prevPage, nextPage } = Astro.props;

const verses = quranData as Record<string, { ar: string; en: string }>;

const ARABIC_INDIC_DIGITS = ["٠", "١", "٢", "٣", "٤", "٥", "٦", "٧", "٨", "٩"];
function toArabicIndicDigits(input: string): string {
  return input.replace(/\d/g, (d) => ARABIC_INDIC_DIGITS[Number(d)]);
}

function expandVerseRef(ref: string): string[] {
  const out: string[] = [];
  for (const part of ref.split(",").map((s) => s.trim()).filter(Boolean)) {
    const m = part.match(/^(\d+):(\d+)-(\d+)$/);
    if (m) {
      const ch = m[1];
      for (let v = Number(m[2]); v <= Number(m[3]); v++) out.push(`${ch}:${v}`);
    } else {
      out.push(part);
    }
  }
  return out;
}

function renderQuranVerseHtml(verseRef: string, label?: string): string {
  const refs = expandVerseRef(verseRef);
  const found = refs.map((r) => ({ ref: r, ...(verses[r] || {}) }));
  const arabicSegments = found.filter((f) => f.ar).map((f) => ({ text: f.ar, num: f.ref.split(":")[1] ?? "" }));
  const arabicPlain = arabicSegments.map((s) => s.text).join(" \u06DD ");
  const verseEntries = found.filter((f) => f.en);
  const ref = label || `Quran ${verseRef}`;
  const hasData = Boolean(arabicSegments.length || verseEntries.length);

  if (!hasData) {
    return `<div class="hc-article-panel quran-verse"><div class="quran-verse__content"><p class="quran-verse__missing">Verse data unavailable for ${ref}.</p></div></div>`;
  }

  const arabicHtml = arabicSegments.length > 0 ? `
    <div class="quran-verse__arabic" dir="rtl" lang="ar" data-arabic-text data-copy-text="${arabicPlain.replace(/"/g, '&quot;')}">
      ${arabicSegments.map((seg) => `
        <span class="qv-ayah">
          ${seg.text}
          ${seg.num ? `<span class="qv-ayah-end" aria-hidden="true">${toArabicIndicDigits(seg.num)}</span>` : ''}
        </span>
      `).join('')}
    </div>
  ` : '';

  const englishHtml = verseEntries.length > 0 ? `
    <div class="quran-verse__english" data-english-text>
      ${verseEntries.map((f) => `
        <p class="qv-verse">
          ${f.ref.includes(":") ? `<span class="qv-verse-num" aria-hidden="true">${f.ref.split(":")[1]}</span>` : ''}
          ${f.en}
        </p>
      `).join('')}
    </div>
  ` : '';

  return `
    <div class="hc-article-panel quran-verse" data-quran-verse>
      <div class="quran-verse__header">
        <div class="quran-verse__badge">
          <span class="quran-verse__badge-icon" aria-hidden="true">✦</span>
          <span class="quran-verse__badge-label">Quran</span>
        </div>
        <button type="button" class="quran-verse__copy" data-quran-copy title="Copy verse" aria-label="Copy verse to clipboard">
          <span class="quran-verse__copy-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
          </span>
          <span class="quran-verse__copy-check" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
          <span class="quran-verse__copy-text">Copy</span>
        </button>
      </div>
      <div class="quran-verse__content">
        ${arabicHtml}
        ${englishHtml}
        <div class="quran-verse__ref" data-ref-text="${ref}">
          <span class="quran-verse__ref-icon" aria-hidden="true">✦</span>
          <span>${ref}</span>
        </div>
      </div>
    </div>
  `;
}

// Helper to sanitize GitBook artifacts & normalize dividers
function cleanContent(raw: string): string {
  if (!raw) return '';
  let content = raw;
  // Strip top GitBook metadata remnants
  content = content.replace(/^For the complete documentation index, see \[llms\.txt\].*?\n\nCopy\n\nOn this page\n\n/is, '');
  content = content.replace(/^.*?\bllms\.txt\b.*?\n\nCopy\n\nOn this page\n\n/is, '');
  // Strip bottom GitBook nav remnants
  content = content.replace(/\n*\[Previous.*?\]\(.*?\)\s*\[Next.*?\]\(.*?\)\s*Last updated.*$/is, '');
  content = content.replace(/\n*Last updated.*$/is, '');
  // Normalize markdown dividers and remove long underscore sequences
  content = content.replace(/(\\_)+/g, '\n\n---\n\n');
  content = content.replace(/_{4,}/g, '\n\n---\n\n');
  // Strip duplicate consecutive horizontal rules
  content = content.replace(/(\n\s*---\s*\n)+/g, '\n\n---\n\n');
  // Strip awkward standalone backslashes before lines
  content = content.replace(/\\\s*\n/g, '\n');
  // Strip raw GitBook mark tags into clean text
  content = content.replace(/<mark[^>]*>(.*?)<\/mark>/gis, '$1');
  return content.trim();
}

// Render markdown content and embed blog-style components
marked.setOptions({
  gfm: true,
  breaks: false
});

function renderTreatiseContent(raw: string): string {
  let content = cleanContent(raw);
  const tokens: Record<string, string> = {};
  let counter = 0;

  // 1. Process <ClaimBox>
  content = content.replace(/<ClaimBox(?:\s+title="([^"]*)")?>([\s\S]*?)<\/ClaimBox>/gi, (_, title, inner) => {
    const key = `%%CLAIMBOX_TOKEN_${counter++}%%`;
    const innerHtml = marked.parse(inner.trim());
    tokens[key] = `<div class="hc-article-panel claim-box"><div class="claim-header"><span class="claim-badge"><span class="claim-badge__icon" aria-hidden="true">✦</span><span class="claim-badge__text">${title || 'Core Thesis'}</span></span></div><div class="claim-content">${innerHtml}</div></div>`;
    return key;
  });

  // 2. Process <ContextNote>
  content = content.replace(/<ContextNote(?:\s+title="([^"]*)")?>([\s\S]*?)<\/ContextNote>/gi, (_, title, inner) => {
    const key = `%%CONTEXTNOTE_TOKEN_${counter++}%%`;
    const innerHtml = marked.parse(inner.trim());
    tokens[key] = `<div class="hc-article-panel hc-article-panel--umber context-note"><div class="note-header"><span class="note-badge"><span class="note-badge__icon" aria-hidden="true">◈</span><span class="note-badge__text">${title || 'Historical Context'}</span></span></div><div class="note-content">${innerHtml}</div></div>`;
    return key;
  });

  // 3. Process <VerdictBox>
  content = content.replace(/<VerdictBox(?:\s+title="([^"]*)")?>([\s\S]*?)<\/VerdictBox>/gi, (_, title, inner) => {
    const key = `%%VERDICTBOX_TOKEN_${counter++}%%`;
    const innerHtml = marked.parse(inner.trim());
    tokens[key] = `<div class="hc-article-panel verdict-box"><div class="verdict-header"><span class="verdict-badge"><span class="verdict-badge__icon" aria-hidden="true">⚖</span><span class="verdict-badge__text">${title || 'Critical Verdict'}</span></span></div><div class="verdict-content">${innerHtml}</div></div>`;
    return key;
  });

  // 4. Process <QuranVerse>
  content = content.replace(/<QuranVerse\s+verse="([^"]+)"(?:\s+label="([^"]+)")?\s*(?:\/>|>\s*<\/QuranVerse>)/gi, (_, verseRef, label) => {
    const key = `%%QURAN_TOKEN_${counter++}%%`;
    tokens[key] = renderQuranVerseHtml(verseRef, label);
    return key;
  });

  // Parse markdown
  let parsedHtml = marked.parse(content) as string;

  // Substitute all tokens back
  for (const [k, val] of Object.entries(tokens)) {
    parsedHtml = parsedHtml.replace(new RegExp(`<p>\\s*${k}\\s*<\\/p>`, 'g'), val);
    parsedHtml = parsedHtml.replace(new RegExp(k, 'g'), val);
  }

  // Run last, so it reaches the Arabic inside ClaimBox, ContextNote and
  // VerdictBox too. Those are parsed separately and only exist in the output
  // once their tokens have been substituted back above.
  return bindArabicPassages(parsedHtml);
}

function arabicRatio(html: string) {
  const text = html.replace(/<[^>]+>/g, '');
  return {
    arabic: (text.match(/[؀-ۿ]/g) || []).length,
    latin: (text.match(/[A-Za-z]/g) || []).length
  };
}

function bindArabicPassages(html: string): string {
  // 1. Mark direction. Nothing upstream does this, so a block that is mostly
  //    Arabic would otherwise render left aligned in the Latin body face.
  let out = html.replace(/<(p|blockquote|li)>([\s\S]*?)<\/\1>/g, (whole, tag, inner) => {
    const { arabic, latin } = arabicRatio(inner);
    if (arabic < 12 || arabic <= latin) return whole;
    return `<${tag} dir="rtl" lang="ar" class="treatise-arabic">${inner}</${tag}>`;
  });

  // 2. Tie each translation to the Arabic it renders. A quoted Arabic passage
  //    is always followed by its English, so the pair is wrapped into one
  //    figure and the translation is labelled, rather than leaving two loose
  //    blocks whose relationship the reader has to infer.
  out = out.replace(
    /<blockquote dir="rtl" lang="ar" class="treatise-arabic">([\s\S]*?)<\/blockquote>\s*<p>((?:(?!<\/p>)[\s\S])*?)<\/p>/g,
    (whole, arabicInner, translation) => {
      const { arabic, latin } = arabicRatio(translation);
      // Only pair when what follows really is the rendering, not more Arabic
      // and not a stray one-word line.
      if (latin < 20 || arabic > latin) return whole;
      return `<figure class="passage">
  <blockquote dir="rtl" lang="ar" class="treatise-arabic passage__source">${arabicInner}</blockquote>
  <figcaption class="passage__translation">
    <span class="passage__label">Translation</span>
    <p>${translation}</p>
  </figcaption>
</figure>`;
    }
  );

  // 3. Give every table its own scroll container. The source registers are
  //    wide, and without this they push the article column sideways on narrow
  //    viewports instead of scrolling inside their own box.
  out = out.replace(/<table>([\s\S]*?)<\/table>/g, (_, inner) =>
    `<div class="table-scroll"><table>${inner}</table></div>`
  );

  return out;
}

const htmlContent = renderTreatiseContent(item.content);

const categoryLabel = item.category === 'core'
  ? 'PART I · FOUNDATIONAL STUDY'
  : (item.category === 'four-imams'
    ? 'PART II · THE FOUR SUNNI IMAMS'
    : (item.category === 'scholars-overview' ? 'ARCHIVAL MONOGRAPH' : ''));
---

<TreatiseLayout
  title={item.title}
  description={isScholar ? `Classical citation and evidence on Tawassul from ${item.name} (${item.deathYear ? `d. ${item.deathYear} AH` : 'Classical Authority'}).` : `Critical analysis: ${item.title}`}
  currentSlug={item.id}
  prevPage={prevPage}
  nextPage={nextPage}
>
  <!-- Unified Header Banner for Both Scholars and Chapters -->
  <header class="article-header-banner">
    {isScholar ? (
      <div class="article-meta-group">
        <span class="era-pill">{item.deathYear ? `Died ${item.deathYear} AH` : 'Classical Period'}</span>
        {item.century && <span class="century-pill">{item.century}th Century Hijri</span>}
        <span class="madhhab-pill">{item.madhhab}</span>
      </div>
    ) : (
      categoryLabel && (
        <div class="article-meta-group">
          <span class="category-pill">{categoryLabel}</span>
        </div>
      )
    )}

    <h1 class="article-heading">{item.title}</h1>
  </header>

  <!-- Rendered Content with Advanced Typography -->
  <div class="treatise-rendered-content" set:html={htmlContent} />

  <!-- Primary Manuscript Evidence Gallery -->
  {item.scans && item.scans.length > 0 && (
    <section class="manuscript-evidence-section" aria-label="Manuscript Evidence">
      <div class="evidence-header">
        <span class="evidence-eyebrow">Primary Source Archival Evidence</span>
        <h3 class="evidence-title">Manuscript & Reference Edition Scans</h3>
        <p class="evidence-desc">
          Click any scan below to open in high resolution and verify the original Arabic text, marginal notes, and printed edition chains.
        </p>
      </div>

      <div class="scans-gallery">
        {item.scans.map((scanUrl: string, idx: number) => (
          <figure class="scan-figure">
            <button
              type="button"
              class="scan-interactive-btn"
              data-lightbox-src={scanUrl}
              data-lightbox-title={`${item.title} — Primary Scan ${idx + 1}`}
              data-lightbox-caption={`Original printed edition citation proof for ${item.title}`}
              aria-label={`Open scan ${idx + 1} for ${item.title}`}
            >
              <img src={scanUrl} alt={`${item.title} scan proof ${idx + 1}`} loading="lazy" class="scan-img" />
              <span class="scan-overlay">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                <span>Inspect Scan {idx + 1}</span>
              </span>
            </button>
            <figcaption class="scan-caption">Proof Page {idx + 1}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}
</TreatiseLayout>

<style>
  /* ── Header Banner ── */
  .article-header-banner {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
  }

  .article-meta-group {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .era-pill, .century-pill, .madhhab-pill, .category-pill {
    font-size: 0.72rem;
    padding: 0.22rem 0.65rem;
    border-radius: 3px;
    font-family: var(--font-ui, sans-serif);
    font-weight: 600;
    line-height: 1.2;
  }

  .era-pill {
    background: rgba(200, 167, 85, 0.14);
    color: var(--hc-gold, #c8a755);
    border: 1px solid rgba(200, 167, 85, 0.35);
  }

  .century-pill {
    background: var(--hc-surface-2, #1b1b1e);
    color: var(--hc-text-secondary, #b5b0a5);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
  }

  .madhhab-pill {
    background: rgba(200, 167, 85, 0.07);
    color: var(--hc-text-primary, #f5f2eb);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.12));
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .category-pill {
    background: rgba(200, 167, 85, 0.1);
    color: var(--hc-gold, #c8a755);
    border: 1px solid rgba(200, 167, 85, 0.25);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .article-heading {
    font-size: clamp(2.1rem, 3.8vw, 2.9rem);
    font-family: var(--font-display, serif);
    color: var(--hc-text-primary, #f5f2eb);
    margin: 0;
    line-height: 1.18;
    font-weight: 600;
  }

  /* ── Rendered Content ── */
  .treatise-rendered-content {
    color: var(--hc-text-secondary, #dcd8cf);
    font-family: var(--font-body, serif);
    font-size: 1.08rem;
    line-height: 1.82;
  }

  /* Hide markdown H1 because the banner already renders it */
  .treatise-rendered-content :global(h1:first-child) {
    display: none;
  }

  .treatise-rendered-content :global(hr) {
    border: 0;
    height: 1px;
    background: var(--hc-rule, rgba(255, 255, 255, 0.08));
    margin: 2.75rem 0;
  }

  /* Video Embeds */
  .treatise-rendered-content :global(.treatise-video-embed) {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    max-width: 100%;
    margin: 2.25rem 0;
    border-radius: 4px;
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.1));
    background: #000;
  }

  .treatise-rendered-content :global(.treatise-video-embed iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── Manuscript Evidence Section ── */
  .manuscript-evidence-section {
    margin-top: 4rem;
    padding: 2rem 1.75rem;
    background: var(--hc-surface-1, #141416);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
    border-top: 2px solid var(--hc-gold, #c8a755);
    border-radius: 4px;
  }

  .evidence-eyebrow {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hc-gold, #c8a755);
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .evidence-title {
    font-size: 1.4rem;
    font-family: var(--font-display, serif);
    color: var(--hc-text-primary, #f5f2eb);
    margin: 0 0 0.45rem;
    font-weight: 600;
  }

  .evidence-desc {
    font-family: var(--font-body, serif);
    font-size: 0.92rem;
    color: var(--hc-text-secondary, #a8a5a0);
    margin: 0 0 1.75rem;
    line-height: 1.5;
  }

  .scans-gallery {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .scan-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scan-interactive-btn {
    position: relative;
    padding: 0;
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.15));
    background: #09090a;
    border-radius: 3px;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .scan-interactive-btn:hover {
    transform: translateY(-3px);
    border-color: var(--hc-gold, #c8a755);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .scan-img {
    width: 220px;
    height: 300px;
    object-fit: cover;
    display: block;
  }

  .scan-overlay {
    position: absolute;
    inset: 0;
    background: rgba(12, 12, 13, 0.75);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--hc-text-primary, #f5f2eb);
    font-size: 0.82rem;
    font-family: var(--font-ui, sans-serif);
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .scan-interactive-btn:hover .scan-overlay {
    opacity: 1;
  }

  .scan-caption {
    font-size: 0.75rem;
    color: var(--hc-text-tertiary, #858077);
    font-family: var(--font-ui, sans-serif);
    margin-top: 0.5rem;
  }

  /* ── Rich Blog Components (Panels, QuranVerse, ClaimBox, TermGrid, ParadoxMap) ── */
  .treatise-rendered-content :global(.hc-article-panel) {
    position: relative;
    margin: 2.75rem 0;
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
    border-top: 3px solid var(--hc-gold, #c8a755);
    border-radius: var(--radius-sm, 4px);
    background:
      radial-gradient(circle at 85% 10%, rgba(216, 177, 102, 0.06), transparent 45%),
      linear-gradient(140deg, color-mix(in srgb, var(--hc-surface-2, #1b1b1e) 88%, transparent), color-mix(in srgb, var(--hc-surface-1, #141416) 96%, transparent));
    box-shadow: 0 1px 0 rgba(216, 177, 102, 0.08) inset, 0 16px 45px rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }

  /* Quran Verse Panel */
  .treatise-rendered-content :global(.quran-verse__header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1.4rem;
    border-bottom: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
    background: rgba(0, 0, 0, 0.15);
  }

  .treatise-rendered-content :global(.quran-verse__badge) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hc-gold, #c8a755);
  }

  .treatise-rendered-content :global(.quran-verse__copy) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--hc-text-tertiary, #858077);
