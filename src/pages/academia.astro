---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Academia | HadithCritic">
  <main class="page-container">
    <section class="index-hero">
      <div class="hc-container">
        <h1 class="hc-title hc-title--xl">Academia</h1>
        <p class="hc-copy" style="max-width: 600px; font-size: 1.2rem; margin-top: 1rem; color: var(--hc-muted);">
          Formal research, peer-reviewed articles, and academic publications.
        </p>
      </div>
    </section>
    <section class="page-content hc-container">
      <p class="hc-copy" style="padding: 4rem 0;">Coming soon...</p>
    </section>
  </main>
</BaseLayout>

<style>
  .page-container {
    min-height: 100vh;
    background: radial-gradient(circle at 100% 0%, rgba(216, 177, 102, 0.05), transparent 40%), var(--hc-black);
  }
  .index-hero {
    padding: 8rem 0 4rem;
    border-bottom: 1px solid var(--hc-rule);
    background: linear-gradient(180deg, rgba(15, 15, 16, 0.8), var(--hc-black));
  }
</style>
