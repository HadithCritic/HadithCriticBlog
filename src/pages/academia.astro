---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Academia | HadithCritic">
  <main class="page-container">
    <section class="index-hero">
      <div class="hc-container">
        <h1 class="hc-title hc-title--xl">Academia</h1>
        <p class="hc-copy" style="max-width: 600px; font-size: 1.2rem; margin-top: 1rem; color: var(--hc-muted);">
          Formal research, peer-reviewed articles, and academic publications.
        </p>
      </div>
    </section>
    <section class="page-content hc-container" style="padding-bottom: 8rem;">
      <div class="projects-grid projects-grid--brand" style="margin-top: 4rem;">
        <article class="project-card">
          <span class="hc-chip">Peer-Reviewed</span>
          <h3 class="hc-title">The Problem of the 'Common Link'</h3>
          <p class="hc-copy">An analysis of Schacht and Juynboll's methodology applied to early Basran isnāds.</p>
          <a href="#" class="hc-btn hc-btn--ghost" style="margin-top: 1.5rem;">Read Paper <span aria-hidden="true">→</span></a>
        </article>
        <article class="project-card">
          <span class="hc-chip">Journal Article</span>
          <h3 class="hc-title">Umayyad Political Memory</h3>
          <p class="hc-copy">Tracing anti-Umayyad sentiments in Kufan historical transmission before the Abbasid revolution.</p>
          <a href="#" class="hc-btn hc-btn--ghost" style="margin-top: 1.5rem;">Read Paper <span aria-hidden="true">→</span></a>
        </article>
        <article class="project-card">
          <span class="hc-chip">Working Paper</span>
          <h3 class="hc-title">Abrogating the Quran</h3>
          <p class="hc-copy">A historical study on the development of naskh theories in the 2nd century AH.</p>
          <a href="#" class="hc-btn hc-btn--ghost" style="margin-top: 1.5rem;">Read Paper <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-container {
    min-height: 100vh;
    background: radial-gradient(circle at 100% 0%, rgba(216, 177, 102, 0.05), transparent 40%), var(--hc-black);
  }
  .index-hero {
    padding: 8rem 0 4rem;
    border-bottom: 1px solid var(--hc-rule);
    background: linear-gradient(180deg, rgba(15, 15, 16, 0.8), var(--hc-black));
  }
</style>
