---
// Formal Academia Publications & Treatises
import BaseLayout from '../layouts/BaseLayout.astro';

const forensicTheses = [
  {
    id: 'thesis-1',
    number: '01',
    title: 'The Solitary Report (Khabar al-Wāḥid) Dilemma',
    summary:
      'Al-Shāfiʿī acknowledges that solitary reports yield probable, non-definitive knowledge (ẓann), yet demands they serve as definitive legal proof. This thesis demonstrates that elevating speculative transmission into categorical divine obligation subverts the Quranic prohibition against acting upon conjecture (ẓann).'
  },
  {
    id: 'thesis-2',
    number: '02',
    title: 'Ḥikmah as Scripture-Internal Discernment',
    summary:
      'A thorough collation of all 20 occurrences of the term al-ḥikmah in the Quran demonstrates that it never denotes an independent oral corpus. In Quranic usage, ḥikmah signifies divine discernment and scriptural comprehension endowed directly by God, invalidating al-Shāfiʿī’s equation of ḥikmah with hadith collections.'
  },
  {
    id: 'thesis-3',
    number: '03',
    title: 'The Subversion of Scripture via Abrogation (Naskh)',
    summary:
      'Al-Shāfiʿī’s framework allows extra-scriptural traditions to qualify, restrict, or effectively abrogate Quranic statutes. The treatise details how this principle reverses the ontological hierarchy of revelation, subordinating immutable divine text to fallible historical transmission.'
  },
  {
    id: 'thesis-4',
    number: '04',
    title: 'Qiyās and Raʾy Under Epistemic Scrutiny',
    summary:
      'Examining al-Shāfiʿī’s construction of juristic analogy (qiyās) as a religious imperative, the study contrasts human deductive interpolation against the Quran’s self-attested status as tibyānan li-kulli shayʾ (an exhaustive clarification of all legal essentials).'
  }
];

const bibtexCitation = `@book{hadithcritic2026decisive,
  author    = {HadithCritic Research},
  title     = {The Decisive Refutation of Imam al-Shāfiʿī's Kitāb Jāmiʿ al-ʿIlm},
  series    = {HadithCritic Academia Editions},
  volume    = {1},
  year      = {2026},
  publisher = {HadithCritic Press},
  address   = {London and New York},
  note      = {First Academic Critical Edition}
}`;

const chicagoCitation = `HadithCritic Research. The Decisive Refutation of Imam al-Shāfiʿī's Kitāb Jāmiʿ al-ʿIlm. HadithCritic Academia Editions, vol. 1. London and New York: HadithCritic Press, 2026.`;

const apaCitation = `HadithCritic Research. (2026). The Decisive Refutation of Imam al-Shāfiʿī's Kitāb Jāmiʿ al-ʿIlm (HadithCritic Academia Editions, Vol. 1). HadithCritic Press.`;
---

<BaseLayout
  title="Academia & Research Treatises | HadithCritic"
  description="Formal HadithCritic research monographs, critical treatises, open academic preprints, and Quran-centered legal forensics."
>
  <div class="acad-page">
    <!-- ═══════════════════════════════════════════
         HERO SECTION
         ═══════════════════════════════════════════ -->
    <section class="acad-hero" aria-labelledby="acad-hero-title">
      <div class="hc-container">
        <div class="acad-hero__inner">
          <h1 id="acad-hero-title" class="acad-hero__title">
            Formal Research Treatises &amp; <span class="acad-hero__title-accent">Critical Monographs</span>
          </h1>

          <p class="acad-hero__lead">
            HadithCritic's academic research wing publishes long-form critical treatises, monograph editions, and apparatus-grade studies on hadith transmission, juristic methodology, and early Islamic source history.
          </p>

          <!-- Core Academic Disciplines Bar -->
          <div class="acad-pillars" aria-label="Key academic research disciplines">
            <div class="acad-pillar">
              <strong>Source Stemmatics</strong>
              <span>Earliest Extant Recensions</span>
            </div>

            <div class="acad-pillar">
              <strong>Isnād-cum-Matn</strong>
              <span>Historical Common Links</span>
            </div>

            <div class="acad-pillar">
              <strong>Legal Epistemology</strong>
              <span>Usūl al-Fiqh &amp; Sufficiency</span>
            </div>

            <div class="acad-pillar">
              <strong>Open Access</strong>
              <span>Citable Preprints &amp; Data</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         FEATURED TREATISE SHOWCASE
         ═══════════════════════════════════════════ -->
    <section class="acad-featured" id="featured-treatise" aria-labelledby="featured-title">
      <div class="hc-container">
        <header class="acad-section-head">
          <span class="hc-eyebrow">FLAGSHIP TREATISE • MONOGRAPH I</span>
          <h2 id="featured-title" class="acad-section-title">A Formal Treatise on Hadith Authority &amp; Legal Epistemology</h2>
        </header>

        <article class="acad-monograph-spotlight">
          <!-- Left: 3D Physical Book Showcase -->
          <div class="acad-book-stage">
            <div class="acad-book-stage__topbar">
              <span class="acad-book-stage__tag">PHYSICAL &amp; DIGITAL EDITION</span>
              <div class="acad-cover-switch" role="tablist" aria-label="Cover view switcher">
                <button
                  type="button"
                  class="acad-cover-btn is-active"
                  id="tab-front"
                  role="tab"
                  aria-selected="true"
                  aria-controls="book-view-front"
                >
                  Front Cover
                </button>
                <button
                  type="button"
                  class="acad-cover-btn"
                  id="tab-back"
                  role="tab"
                  aria-selected="false"
                  aria-controls="book-view-back"
                >
                  Back Cover
                </button>
              </div>
            </div>

            <div class="acad-book-viewport" id="acad-book-viewport" data-view="front">
              <div class="acad-book-scene" id="acad-book-scene">
                <!-- Back Cover View -->
                <div class="acad-cover-card acad-cover-card--back" id="book-view-back">
                  <img
                    src="/images/book_covers/RefutationKJI_BC.webp"
                    alt="Back cover synopsis of The Decisive Refutation"
                    width="480"
                    height="720"
                    loading="eager"
                  />
                </div>
                <!-- Front Cover View -->
                <div class="acad-cover-card acad-cover-card--front" id="book-view-front">
                  <img
                    src="/images/book_covers/RefutationKJI_FC.webp"
                    alt="Front cover of The Decisive Refutation"
                    width="480"
                    height="720"
                    loading="eager"
                  />
                </div>
              </div>
              <div class="acad-book-shadow" aria-hidden="true"></div>
            </div>

            <footer class="acad-book-caption">
              <div>
                <strong>HadithCritic Academia Edition</strong>
                <span>First Academic Printing • Vol. I</span>
              </div>
              <div class="acad-book-caption__meta">
                <span>Print &amp; Open Access PDF</span>
                <span>London &amp; New York</span>
              </div>
            </footer>
          </div>

          <!-- Right: Scholarly Monograph Dossier -->
          <div class="acad-dossier">
            <h3 class="acad-dossier__title">The Decisive Refutation</h3>
            <p class="acad-dossier__subtitle">
              of Imam al-Shāfiʿī's <em>Kitāb Jāmiʿ al-ʿIlm</em>
            </p>

            <div class="acad-dossier__abstract">
              <p>
                In <em>Kitāb Jāmiʿ al-ʿIlm</em>, Imam al-Shāfiʿī (d. 204 AH) articulated one of the earliest systematic defenses of hadith authority in Islamic legal history. His doctrine established that the Quran cannot function as an independent, complete legal canon without being qualified, supplemented, and governed by solitary reports, consensus, and juristic analogy.
              </p>
              <p class="acad-dossier__thesis">
                This treatise subjects al-Shāfiʿī's doctrine to exhaustive scriptural, linguistic, and epistemological critique.
              </p>
              <p>
                Following al-Shāfiʿī's argument line by line in its original sequence, <em>The Decisive Refutation</em> investigates his reliance upon solitary reports (<em>khabar al-wāḥid</em>), the linguistic redefinition of <em>ḥikmah</em>, the doctrine of post-prophetic abrogation (<em>naskh</em>), and juristic analogy (<em>qiyās</em>). Each proposition is held directly against the Quran's self-declared standards of completion, clarity, and non-speculative certitude.
              </p>
            </div>

            <!-- Monograph Apparatus Specs -->
            <dl class="acad-specs-grid">
              <div class="acad-spec-box">
                <dt>Apparatus</dt>
                <dd>Arabic Collation &amp; English Forensics</dd>
              </div>
              <div class="acad-spec-box">
                <dt>Subject Work</dt>
                <dd>Kitāb Jāmiʿ al-ʿIlm (Al-Shāfiʿī)</dd>
              </div>
              <div class="acad-spec-box">
                <dt>Target Release</dt>
                <dd>Q3 2026 • Hardcover &amp; Open PDF</dd>
              </div>
              <div class="acad-spec-box">
                <dt>Identifier</dt>
                <dd>HC-TR-01 • Academia Series</dd>
              </div>
            </dl>

            <!-- Forensic Theses Explorer -->
            <div class="acad-theses-panel">
              <h4 class="acad-theses-title">Core Forensic Theses of the Treatise</h4>
              <div class="acad-theses-list" id="theses-accordion">
                {forensicTheses.map((thesis) => (
                  <details class="acad-thesis-item">
                    <summary class="acad-thesis-summary">
                      <span class="acad-thesis-num">{thesis.number}</span>
                      <span class="acad-thesis-heading">{thesis.title}</span>
                      <span class="acad-thesis-chevron" aria-hidden="true">+</span>
                    </summary>
                    <div class="acad-thesis-body">
                      <p>{thesis.summary}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>

            <!-- Action Suite -->
            <div class="acad-dossier__actions">
              <a href="#citation-suite" class="hc-btn">Cite This Treatise</a>
              <a
                href="https://independent.academia.edu"
                target="_blank"
                rel="noopener noreferrer"
                class="hc-btn hc-btn--ghost"
              >
                Academia.edu Repository ↗
              </a>
            </div>

            <div class="acad-status-notice">
              <span class="acad-pulse-dot" aria-hidden="true"></span>
              <span>Typesetting &amp; critical apparatus review in progress. Pre-order and PDF digital distribution notice will be announced here.</span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         CITATION & REFERENCE CENTER
         ═══════════════════════════════════════════ -->
    <section class="acad-citation" id="citation-suite" aria-labelledby="citation-title">
      <div class="hc-container">
        <header class="acad-section-head">
          <span class="hc-eyebrow">ACADEMIC APPARATUS</span>
          <h2 id="citation-title" class="acad-section-title">Citation &amp; Reference Center</h2>
          <p class="acad-section-intro">
            Standardized citation templates for referencing HadithCritic Academia treatises in peer-reviewed journals, doctoral theses, and monographs.
          </p>
        </header>

        <div class="acad-citation-box">
          <div class="acad-citation-box__header">
            <div class="acad-citation-tabs" role="tablist" aria-label="Citation formats">
              <button
                type="button"
                class="acad-cite-tab is-active"
                id="cite-tab-bibtex"
                role="tab"
                aria-selected="true"
                aria-controls="cite-panel-bibtex"
                data-format="bibtex"
              >
                BibTeX
              </button>
              <button
                type="button"
                class="acad-cite-tab"
                id="cite-tab-chicago"
                role="tab"
                aria-selected="false"
                aria-controls="cite-panel-chicago"
                data-format="chicago"
              >
                Chicago (17th Ed.)
              </button>
              <button
                type="button"
                class="acad-cite-tab"
                id="cite-tab-apa"
                role="tab"
                aria-selected="false"
                aria-controls="cite-panel-apa"
                data-format="apa"
              >
                APA 7th
              </button>
            </div>

            <button type="button" class="acad-copy-btn" id="btn-copy-citation">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copy-btn-label">Copy Citation</span>
            </button>
          </div>

          <div class="acad-citation-display">
            <!-- BibTeX Panel -->
            <pre class="acad-cite-panel is-visible" id="cite-panel-bibtex" role="tabpanel"><code>{bibtexCitation}</code></pre>
            <!-- Chicago Panel -->
            <div class="acad-cite-panel" id="cite-panel-chicago" role="tabpanel">
              <p class="acad-cite-prose">{chicagoCitation}</p>
            </div>
            <!-- APA Panel -->
            <div class="acad-cite-panel" id="cite-panel-apa" role="tabpanel">
              <p class="acad-cite-prose">{apaCitation}</p>
            </div>
          </div>

          <div class="acad-citation-box__footer">
            <span class="acad-citation-box__doi">Permanent Identifier: HC-TR-01 / 2026-DECISIVE-REFUTATION</span>
            <span class="acad-citation-box__license">Open Scholarly Access • CC BY-NC-ND 4.0</span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Client-side Interactive Behaviors -->
  <script is:inline>
    (() => {
      // 1. Cover View Switcher (Front vs Back)
      const viewport = document.getElementById('acad-book-viewport');
      const tabFront = document.getElementById('tab-front');
      const tabBack = document.getElementById('tab-back');

      if (viewport && tabFront && tabBack) {
        tabFront.addEventListener('click', () => {
          viewport.setAttribute('data-view', 'front');
          tabFront.classList.add('is-active');
          tabFront.setAttribute('aria-selected', 'true');
          tabBack.classList.remove('is-active');
          tabBack.setAttribute('aria-selected', 'false');
        });

        tabBack.addEventListener('click', () => {
          viewport.setAttribute('data-view', 'back');
          tabBack.classList.add('is-active');
          tabBack.setAttribute('aria-selected', 'true');
          tabFront.classList.remove('is-active');
          tabFront.setAttribute('aria-selected', 'false');
        });
      }

      // 2. 3D Tilt on Book Viewport (Reduced Motion respected)
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const scene = document.getElementById('acad-book-scene');
      if (viewport && scene && !prefersReduced) {
        viewport.addEventListener('mousemove', (e) => {
          const rect = viewport.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          scene.style.transform = `rotateY(${x * 16}deg) rotateX(${-y * 12}deg)`;
        });

        viewport.addEventListener('mouseleave', () => {
          scene.style.transform = '';
        });
      }

      // 3. Citation Tabs Switcher & Copy
      const citeTabs = document.querySelectorAll('.acad-cite-tab');
      const citePanels = {
        bibtex: document.getElementById('cite-panel-bibtex'),
        chicago: document.getElementById('cite-panel-chicago'),
        apa: document.getElementById('cite-panel-apa')
      };

      const copyBtn = document.getElementById('btn-copy-citation');
      const copyLabel = document.getElementById('copy-btn-label');

      let currentFormat = 'bibtex';

      citeTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const fmt = tab.dataset.format;
          if (!fmt) return;
          currentFormat = fmt;

          citeTabs.forEach((t) => {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');

          Object.entries(citePanels).forEach(([key, panel]) => {
            if (panel) {
              if (key === fmt) {
                panel.classList.add('is-visible');
              } else {
                panel.classList.remove('is-visible');
              }
            }
          });
        });
      });

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const activePanel = citePanels[currentFormat];
          if (!activePanel) return;

          const textToCopy = activePanel.innerText.trim();
          try {
            await navigator.clipboard.writeText(textToCopy);
            if (copyLabel) copyLabel.textContent = 'Copied!';
            copyBtn.classList.add('is-copied');

            window.setTimeout(() => {
              if (copyLabel) copyLabel.textContent = 'Copy Citation';
              copyBtn.classList.remove('is-copied');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy citation:', err);
          }
        });
      }
    })();
  </script>

  <style>
  /* ═══════════════════════════════════════════
     BASE ACADEMIA PAGE STYLING
     ═══════════════════════════════════════════ */
  .acad-page {
    min-height: 100vh;
    background:
      radial-gradient(ellipse 900px 500px at 50% 0%, rgba(216, 177, 102, 0.04) 0%, transparent 70%),
      var(--hc-surface-0);
    color: var(--hc-text-primary);
  }

  /* ═══════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════ */
  .acad-hero {
    position: relative;
    border-bottom: 1px solid var(--hc-rule);
    background:
      linear-gradient(180deg, var(--hc-surface-1) 0%, var(--hc-surface-0) 100%);
    padding-top: clamp(3.5rem, 6.5vw, 5.5rem);
    padding-bottom: clamp(2.5rem, 4.5vw, 3.75rem);
  }

  .acad-hero__inner {
    max-width: 960px;
  }

  .acad-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 1.15rem;
  }

  .acad-hero__badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-xs);
    border: 1px solid rgba(216, 177, 102, 0.3);
    background: rgba(216, 177, 102, 0.08);
  }

  .acad-hero__title {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 5.2vw, 3.85rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--hc-text-primary);
  }

  .acad-hero__title-accent {
    font-style: italic;
    color: var(--hc-gold);
  }

  .acad-hero__lead {
    margin: 0 0 2.5rem;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.25vw, 1.2rem);
    line-height: 1.7;
    color: var(--hc-text-secondary);
    max-width: 72ch;
  }

  /* Academic Pillars Bar */
  .acad-pillars {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--hc-rule);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .acad-pillar {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 1.15rem 1.35rem;
    background: var(--hc-surface-1);
    border-left: 2px solid rgba(216, 177, 102, 0.4);
    transition: background 180ms ease, border-color 180ms ease;
  }

  .acad-pillar:hover {
    background: var(--hc-surface-2);
    border-left-color: var(--hc-gold);
  }

  .acad-pillar strong {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--hc-text-primary);
    line-height: 1.3;
  }

  .acad-pillar span {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-secondary);
    line-height: 1.35;
  }

  /* ═══════════════════════════════════════════
     COMMON SECTION HEADINGS
     ═══════════════════════════════════════════ */
  .acad-section-head {
    margin-bottom: clamp(1.85rem, 3.5vw, 2.75rem);
  }

  .acad-section-head .hc-eyebrow {
    display: block;
    margin-bottom: 0.6rem;
  }

  .acad-section-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.45rem);
    font-weight: 500;
    line-height: 1.15;
    color: var(--hc-text-primary);
  }

  .acad-section-intro {
    margin: 0.75rem 0 0;
    font-family: var(--font-body);
    font-size: clamp(0.98rem, 1.15vw, 1.08rem);
    line-height: 1.65;
    color: var(--hc-text-secondary);
    max-width: 68ch;
  }

  /* ═══════════════════════════════════════════
     FEATURED TREATISE SPOTLIGHT
     ═══════════════════════════════════════════ */
  .acad-featured {
    padding-block: clamp(3.5rem, 6.5vw, 5.5rem);
    border-bottom: 1px solid var(--hc-rule);
  }

  .acad-monograph-spotlight {
    display: grid;
    grid-template-columns: minmax(320px, 0.9fr) minmax(380px, 1.15fr);
    gap: clamp(2.25rem, 4.5vw, 4rem);
    align-items: start;
  }

  /* 3D Book Stage */
  .acad-book-stage {
    position: sticky;
    top: 5rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-md);
    background: var(--hc-surface-1);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .acad-book-stage__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--hc-rule);
    background: var(--hc-surface-2);
  }

  .acad-book-stage__tag {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .acad-cover-switch {
    display: inline-flex;
    gap: 4px;
    padding: 2px;
    border-radius: var(--radius-xs);
    background: var(--hc-surface-0);
    border: 1px solid var(--hc-rule);
  }

  .acad-cover-btn {
    border: none;
    background: transparent;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 160ms ease;
  }

  .acad-cover-btn.is-active {
    background: var(--hc-gold);
    color: #0b0b0d;
  }

  .acad-book-viewport {
    position: relative;
    padding: clamp(2.5rem, 4.5vw, 3.75rem) 1.5rem;
    min-height: clamp(380px, 44vw, 520px);
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1400px;
    background: radial-gradient(circle at center, rgba(216, 177, 102, 0.05) 0%, transparent 70%);
  }

  .acad-book-scene {
    position: relative;
    width: min(72%, 310px);
    aspect-ratio: 2 / 3;
    transform-style: preserve-3d;
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .acad-cover-card {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    overflow: hidden;
    box-shadow:
      0 18px 45px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(216, 177, 102, 0.2);
    transition: all 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .acad-cover-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Default Front View */
  [data-view="front"] .acad-cover-card--front {
    z-index: 2;
    transform: translateX(4%) translateZ(20px) rotateY(-4deg);
    filter: brightness(1);
    opacity: 1;
  }

  [data-view="front"] .acad-cover-card--back {
    z-index: 1;
    transform: translateX(-18%) translateZ(-30px) rotateY(16deg);
    filter: brightness(0.8) contrast(1.05);
    opacity: 0.85;
  }

  /* Back View Active */
  [data-view="back"] .acad-cover-card--back {
    z-index: 2;
    transform: translateX(0) translateZ(25px) rotateY(0deg);
    filter: brightness(1);
    opacity: 1;
  }

  [data-view="back"] .acad-cover-card--front {
    z-index: 1;
    transform: translateX(20%) translateZ(-30px) rotateY(-18deg);
    filter: brightness(0.7) contrast(1.05);
    opacity: 0.65;
  }

  .acad-book-shadow {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 8%;
    height: 10%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.55) 0%, transparent 70%);
    filter: blur(14px);
    pointer-events: none;
    transform: translateZ(-60px);
  }

  .acad-book-caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.25rem;
    border-top: 1px solid var(--hc-rule);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .acad-book-caption strong {
    display: block;
    color: var(--hc-gold);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .acad-book-caption span {
    color: var(--hc-text-tertiary);
  }

  .acad-book-caption__meta {
    text-align: right;
  }

  .acad-book-caption__meta span {
    display: block;
  }

  /* Monograph Dossier Panel */
  .acad-dossier {
    min-width: 0;
  }

  .acad-dossier__badges {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 0.95rem;
  }

  .acad-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-xs);
  }

  .acad-badge--gold {
    background: rgba(216, 177, 102, 0.1);
    border: 1px solid rgba(216, 177, 102, 0.3);
    color: var(--hc-gold);
  }

  .acad-badge--status {
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule);
    color: var(--hc-text-secondary);
    gap: 0.45rem;
  }

  .acad-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hc-gold);
    box-shadow: 0 0 6px var(--hc-gold);
    display: inline-block;
  }

  .acad-dossier__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 3.8vw, 3.25rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--hc-text-primary);
  }

  .acad-dossier__subtitle {
    margin: 0.45rem 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.65vw, 1.45rem);
    line-height: 1.35;
    color: var(--hc-gold);
  }

  .acad-dossier__subtitle em {
    font-style: italic;
  }

  .acad-dossier__abstract p {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: clamp(0.98rem, 1.1vw, 1.06rem);
    line-height: 1.72;
    color: var(--hc-text-secondary);
  }

  .acad-dossier__thesis {
    font-family: var(--font-display) !important;
    font-size: 1.15rem !important;
    font-style: italic;
    color: var(--hc-text-primary) !important;
    border-left: 2px solid var(--hc-gold);
    padding-left: 1.15rem;
    margin-block: 1.35rem !important;
  }

  /* Specifications Grid */
  .acad-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--hc-rule);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-block: 1.75rem;
    padding: 0;
  }

  .acad-spec-box {
    padding: 0.85rem 1.15rem;
    background: var(--hc-surface-1);
  }

  .acad-spec-box dt {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold);
    margin-bottom: 0.25rem;
  }

  .acad-spec-box dd {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--hc-text-primary);
  }

  /* Forensic Theses Panel */
  .acad-theses-panel {
    margin-block: 2rem 1.75rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    background: var(--hc-surface-1);
    overflow: hidden;
  }

  .acad-theses-title {
    margin: 0;
    padding: 0.85rem 1.25rem;
    background: var(--hc-surface-2);
    border-bottom: 1px solid var(--hc-rule);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .acad-thesis-item {
    border-bottom: 1px solid var(--hc-rule);
  }

  .acad-thesis-item:last-child {
    border-bottom: none;
  }

  .acad-thesis-summary {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.25rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background 160ms ease;
  }

  .acad-thesis-summary::-webkit-details-marker {
    display: none;
  }

  .acad-thesis-summary:hover {
    background: var(--hc-surface-2);
  }

  .acad-thesis-num {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--hc-gold);
    flex-shrink: 0;
  }

  .acad-thesis-heading {
    flex-grow: 1;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--hc-text-primary);
    line-height: 1.3;
  }

  .acad-thesis-chevron {
    font-family: inherit;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--hc-text-tertiary);
    transition: transform 200ms ease;
  }

  .acad-thesis-item[open] .acad-thesis-chevron {
    transform: rotate(45deg);
    color: var(--hc-gold);
  }

  .acad-thesis-body {
    padding: 0.25rem 1.25rem 1.15rem 2.85rem;
  }

  .acad-thesis-body p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--hc-text-secondary);
  }

  /* Actions Suite */
  .acad-dossier__actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .acad-status-notice {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.25rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--hc-text-tertiary);
    line-height: 1.5;
  }

  /* ═══════════════════════════════════════════
     CITATION & REFERENCE CENTER
     ═══════════════════════════════════════════ */
  .acad-citation {
    padding-block: clamp(3.5rem, 6.5vw, 5.5rem);
    border-bottom: 1px solid var(--hc-rule);
    background: var(--hc-surface-0);
  }

  .acad-citation-box {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-md);
    background: var(--hc-surface-1);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  .acad-citation-box__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    background: var(--hc-surface-2);
    border-bottom: 1px solid var(--hc-rule);
    flex-wrap: wrap;
  }

  .acad-citation-tabs {
    display: flex;
    gap: 4px;
    padding: 3px;
    border-radius: var(--radius-xs);
    background: var(--hc-surface-0);
    border: 1px solid var(--hc-rule);
  }

  .acad-cite-tab {
    border: none;
    background: transparent;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 160ms ease;
  }

  .acad-cite-tab.is-active {
    background: var(--hc-gold);
    color: #0b0b0d;
  }

  .acad-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--hc-rule);
    background: var(--hc-surface-0);
    color: var(--hc-text-primary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: all 160ms ease;
  }

  .acad-copy-btn:hover {
    border-color: var(--hc-gold);
    color: var(--hc-gold);
  }

  .acad-copy-btn.is-copied {
    background: var(--hc-gold);
    color: #0b0b0d;
    border-color: var(--hc-gold);
  }

  .acad-citation-display {
    padding: 1.5rem;
    min-height: 160px;
    display: flex;
    align-items: center;
  }

  .acad-cite-panel {
    display: none;
    width: 100%;
    margin: 0;
  }

  .acad-cite-panel.is-visible {
    display: block;
  }

  .acad-cite-panel pre,
  .acad-cite-panel code {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--hc-gold);
    background: transparent;
    padding: 0;
    border: none;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .acad-cite-prose {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--hc-text-primary);
  }

  .acad-citation-box__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--hc-rule);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
    flex-wrap: wrap;
  }

  .acad-citation-box__doi {
    font-weight: 700;
    color: var(--hc-gold);
    letter-spacing: 0.04em;
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE ADAPTATIONS
     ═══════════════════════════════════════════ */
  @media (max-width: 1080px) {
    .acad-monograph-spotlight {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .acad-book-stage {
      position: static;
      max-width: 580px;
      margin-inline: auto;
      width: 100%;
    }

    .acad-pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .acad-pillars {
      grid-template-columns: 1fr;
    }

    .acad-specs-grid {
      grid-template-columns: 1fr;
    }

    .acad-book-viewport {
      min-height: 320px;
      padding: 1.75rem 1rem;
    }

    .acad-book-scene {
      width: min(78%, 240px);
    }

    .acad-book-caption {
      flex-direction: column;
      gap: 0.5rem;
    }

    .acad-book-caption__meta {
      text-align: left;
    }

    .acad-dossier__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .acad-dossier__actions .hc-btn {
      justify-content: center;
      width: 100%;
    }
  }

  /* ═══════════════════════════════════════════
     LIGHT THEME ADAPTATION
     ═══════════════════════════════════════════ */
  :global([data-theme="light"]) .acad-hero {
    background:
      radial-gradient(ellipse 700px 350px at 50% -10%, rgba(176, 126, 44, 0.08), transparent 70%),
      var(--hc-surface-0);
  }

  :global([data-theme="light"]) .acad-book-stage,
  :global([data-theme="light"]) .acad-citation-box {
    box-shadow: 0 4px 20px rgba(43, 40, 36, 0.06);
  }

  :global([data-theme="light"]) .acad-cite-panel pre,
  :global([data-theme="light"]) .acad-cite-panel code {
    color: var(--hc-gold);
  }

  /* ═══════════════════════════════════════════
     PREFERS REDUCED MOTION
     ═══════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .acad-book-scene,
    .acad-cover-card,
    .acad-book-shadow {
      transition: none !important;
      transform: none !important;
    }
    .acad-pulse-dot {
      animation: none !important;
    }
  }
  </style>
</BaseLayout>
