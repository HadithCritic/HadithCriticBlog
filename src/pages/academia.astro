---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { OG } from '../lib/seo';
import { academicStudies } from '../data/academic-studies';
import '../styles/academia.css';

/* Academia: HadithCritic's long-form works. The treatise is the one
   book-length publication; the isnād-cum-matn studies being prepared as
   monographs are listed in the ICMA Register, linked below. */

const forensicTheses = [
  {
    number: '01',
    title: 'The Solitary Report (Khabar al-Wāḥid) Dilemma',
    summary:
      'Al-Shāfiʿī acknowledges that solitary reports yield probable, non-definitive knowledge (ẓann), yet demands they serve as definitive legal proof. This thesis demonstrates that elevating speculative transmission into categorical divine obligation subverts the Quranic prohibition against acting upon conjecture (ẓann).'
  },
  {
    number: '02',
    title: 'Ḥikmah as Scripture-Internal Discernment',
    summary:
      'A thorough collation of all 20 occurrences of the term al-ḥikmah in the Quran demonstrates that it never denotes an independent oral corpus. In Quranic usage, ḥikmah signifies divine discernment and scriptural comprehension endowed directly by God, invalidating al-Shāfiʿī’s equation of ḥikmah with hadith collections.'
  },
  {
    number: '03',
    title: 'The Subversion of Scripture via Abrogation (Naskh)',
    summary:
      'Al-Shāfiʿī’s framework allows extra-scriptural traditions to qualify, restrict, or effectively abrogate Quranic statutes. The treatise details how this principle reverses the ontological hierarchy of revelation, subordinating immutable divine text to fallible historical transmission.'
  },
  {
    number: '04',
    title: 'Qiyās and Raʾy Under Epistemic Scrutiny',
    summary:
      'Examining al-Shāfiʿī’s construction of juristic analogy (qiyās) as a religious imperative, the study contrasts human deductive interpolation against the Quran’s self-attested status as tibyānan li-kulli shayʾ (an exhaustive clarification of all legal essentials).'
  }
];

const treatise = academicStudies.find((study) => study.category === 'treatise');
---

<BaseLayout
  image={OG.academia}
  title="Academia: The Treatise | HadithCritic"
  description="HadithCritic's long-form work: The Decisive Refutation, a book-length treatise on al-Shāfiʿī's Kitāb Jāmiʿ al-ʿIlm."
>
  <div class="hc-page ac-page">
    <PageHero
      title="The"
      accent="treatise"
      titleId="ac-title"
      kicker="Academia"
      art="/images/editorial/academia-hero.webp"
      focus="72% center"
      measure="12ch"
    >
      <p class="hc-hero__lede">
        HadithCritic's long-form work: a book-length treatise on al-Shāfiʿī's legal theory.
      </p>
      <Fragment slot="actions">
        <a href="#treatise" class="hc-btn">Read about the treatise</a>
      </Fragment>
    </PageHero>

    <!-- The treatise -->
    <section class="hc-band hc-band--soft ac-treatise" id="treatise" aria-labelledby="treatise-title">
      <div class="hc-container ac-treatise__grid">
        <div class="ac-object">
          <div class="ac-object__view" id="acad-book-viewport" data-view="front">
            <img class="ac-object__cover ac-object__cover--front" id="book-view-front" src="/images/book_covers/RefutationKJI_FC.webp" alt="Front cover of The Decisive Refutation" width="480" height="720" loading="eager" />
            <img class="ac-object__cover ac-object__cover--back" id="book-view-back" src="/images/book_covers/RefutationKJI_BC.webp" alt="Back cover synopsis of The Decisive Refutation" width="480" height="720" loading="lazy" />
          </div>
          <div class="ac-object__switch" role="tablist" aria-label="Cover" data-js-only hidden>
            <button type="button" class="ac-object__tab is-active" id="tab-front" role="tab" aria-selected="true" aria-controls="book-view-front">Front cover</button>
            <button type="button" class="ac-object__tab" id="tab-back" role="tab" aria-selected="false" aria-controls="book-view-back">Back cover</button>
          </div>
          <noscript><a class="hc-link" href="/images/book_covers/RefutationKJI_BC.webp">View the back cover</a></noscript>
          <p class="ac-object__caption">HadithCritic Academia Edition · Volume I · Print and open-access PDF</p>
        </div>

        <article class="ac-record">
          <p class="hc-head__kicker">Treatise · Monograph I</p>
          <h2 id="treatise-title" class="ac-record__title">The Decisive Refutation</h2>
          <p class="ac-record__subtitle">of Imam al-Shāfiʿī's <em>Kitāb Jāmiʿ al-ʿIlm</em></p>
          {treatise?.arabicTitle && <p class="ac-record__ar" lang="ar" dir="rtl">{treatise.arabicTitle}</p>}

          <div class="ac-record__abstract">
            <p>
              In <em>Kitāb Jāmiʿ al-ʿIlm</em>, Imam al-Shāfiʿī (d. 204 AH) articulated one of the earliest systematic defenses of hadith authority in Islamic legal history. His doctrine established that the Quran cannot function as an independent, complete legal canon without being qualified, supplemented, and governed by solitary reports, consensus, and juristic analogy.
            </p>
            <p class="ac-record__thesis">
              This treatise subjects al-Shāfiʿī's doctrine to exhaustive scriptural, linguistic, and epistemological critique.
            </p>
            <p>
              Following al-Shāfiʿī's argument line by line in its original sequence, <em>The Decisive Refutation</em> investigates his reliance upon solitary reports (<em>khabar al-wāḥid</em>), the linguistic redefinition of <em>ḥikmah</em>, the doctrine of post-prophetic abrogation (<em>naskh</em>), and juristic analogy (<em>qiyās</em>). Each proposition is held directly against the Quran's self-declared standards of completion, clarity, and non-speculative certitude.
            </p>
          </div>

          <dl class="ac-record__facts">
            <div><dt>Subject work</dt><dd>Kitāb Jāmiʿ al-ʿIlm (al-Shāfiʿī)</dd></div>
            <div><dt>Apparatus</dt><dd>Arabic collation and English forensics</dd></div>
            <div><dt>Target release</dt><dd>Q3 2026 · Hardcover and open PDF</dd></div>
            <div><dt>Identifier</dt><dd>HC-TR-01 · Academia Series</dd></div>
          </dl>

          <div class="ac-theses">
            <h3 class="hc-rubric">The four theses <span>Open each for its summary</span></h3>
            {forensicTheses.map((thesis) => (
              <details class="acad-thesis-item ac-thesis">
                <summary class="ac-thesis__summary">
                  <span class="ac-thesis__no">{thesis.number}</span>
                  <span class="ac-thesis__title">{thesis.title}</span>
                  <span class="ac-thesis__mark" aria-hidden="true"></span>
                </summary>
                <div class="acad-thesis-body ac-thesis__body">
                  <p>{thesis.summary}</p>
                </div>
              </details>
            ))}
          </div>

          <div class="ac-record__actions">
            <a href="https://independent.academia.edu" target="_blank" rel="noopener noreferrer" class="hc-btn hc-btn--ghost">
              Academia.edu repository <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
          <p class="ac-record__status">
            Typesetting and critical apparatus review in progress. Pre-order and PDF distribution will be announced here.
          </p>
        </article>
      </div>
    </section>

    <section class="hc-band ac-related" aria-labelledby="related-title">
      <div class="hc-container">
        <p class="hc-rubric" id="related-title">Related research <span>Registers of the method and the scholarship</span></p>
        <ul class="ac-related__list">
          <li>
            <a href="/projects/academic-studies/" class="ac-related__item">
              <img src="/images/platform/icma-1086.webp" alt="" width="1086" height="362" loading="lazy" decoding="async" />
              <span class="ac-related__kind">Isnād-cum-matn studies</span>
              <span class="ac-related__title">The ICMA Register</span>
              <span class="ac-related__text">Every study in the series with its common link and dating, filed by research family.</span>
            </a>
          </li>
          <li>
            <a href="/projects/islamic-studies-atlas/" class="ac-related__item">
              <img src="/images/platform/atlas-1086.webp" alt="" width="1086" height="362" loading="lazy" decoding="async" />
              <span class="ac-related__kind">Research network</span>
              <span class="ac-related__title">Islamic Studies Atlas</span>
              <span class="ac-related__text">Modern scholarship on ḥadīth criticism, with the citations between works traced one study at a time.</span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /* Cover switch. Without script both covers are reachable. */
  function initAcademia(): void {
    const page = document.querySelector<HTMLElement>('.ac-page');
    if (!page || page.dataset.ready) return;
    page.dataset.ready = '1';
    page.querySelectorAll<HTMLElement>('[data-js-only]').forEach((element) => (element.hidden = false));
    page.classList.add('is-enhanced');

    const viewport = page.querySelector<HTMLElement>('#acad-book-viewport');
    const coverTabs = [...page.querySelectorAll<HTMLButtonElement>('.ac-object__tab')];
    for (const tab of coverTabs) {
      tab.addEventListener('click', () => {
        const view = tab.id === 'tab-back' ? 'back' : 'front';
        viewport?.setAttribute('data-view', view);
        for (const other of coverTabs) {
          const active = other === tab;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-selected', String(active));
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAcademia, { once: true });
  } else {
    initAcademia();
  }
  document.addEventListener('astro:page-load', initAcademia);
</script>
