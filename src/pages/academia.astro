---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Academia">
    <div class="container" style="padding-top: 120px; padding-bottom: 80px; min-height: 80vh;">
        <!-- Page Header -->
        <div style="text-align: center; margin-bottom: 4rem;">
            <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 3.5rem); background: linear-gradient(135deg, #fef08a 0%, #ca8a04 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 4px 12px rgba(202, 138, 4, 0.3)); margin-bottom: 1.25rem; line-height: 1.1; letter-spacing: -0.02em;">
                Academia
            </h1>
            <p style="color: var(--text-body); font-size: 1.1rem; line-height: 1.8; max-width: 750px; margin: 0 auto; text-shadow: 0 2px 4px rgba(0,0,0,0.8);">
                Academic publications, papers, and critical research methodologies in the field of Islamic studies.
            </p>
        </div>

        <!-- Featured Publication -->
        <div class="publication-showcase">
            <a href="https://www.academia.edu/144226568/The_Decisive_Refutation_of_Im%C4%81m_al_Sh%C4%81fi%CA%BF%C4%ABs_Kit%C4%81b_J%C4%81mi%CA%BF_al_%CA%BFIlm" target="_blank" rel="noopener noreferrer" class="book-container">
                <div class="book-3d">
                    <img src="/images/RefutationKJI_FC.png" alt="Book Front Cover" class="book-cover front">
                    <img src="/images/RefutationKJI_BC.png" alt="Book Back Cover" class="book-cover back">
                    <div class="book-spine"></div>
                </div>
            </a>
            <div class="publication-details">
                <div class="badge">Latest Publication</div>
                <h2>The Decisive Refutation of Imām al-Shāfiʿī's Kitāb Jāmiʿ al-ʿIlm</h2>
                <p>
                    A comprehensive critical examination of Imām al-Shāfiʿī's epistemological framework and foundational arguments in Islamic jurisprudence. This work deconstructs classical assumptions of isnād methodology and the canonization of prophetic reports.
                </p>
                <div class="pub-meta">
                    <span><i class="fas fa-file-pdf"></i> PDF Available</span>
                    <span><i class="fas fa-university"></i> Academia.edu</span>
                </div>
                <a href="https://www.academia.edu/144226568/The_Decisive_Refutation_of_Im%C4%81m_al_Sh%C4%81fi%CA%BF%C4%ABs_Kit%C4%81b_J%C4%81mi%CA%BF_al_%CA%BFIlm" target="_blank" rel="noopener noreferrer" class="btn-read">
                    Read Publication <i class="fas fa-external-link-alt"></i>
                </a>
            </div>
        </div>

        <!-- Coming Soon -->
        <div class="coming-soon">
            <i class="fas fa-hourglass-half"></i>
            <h3>More Publications Coming Soon</h3>
            <p>Additional research papers, datasets, and critical essays are currently undergoing peer review and formatting.</p>
        </div>
    </div>
</BaseLayout>

<style>
    .publication-showcase {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
        background: rgba(25, 25, 25, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 24px;
        padding: 60px;
        box-shadow: inset 0 1px 1px rgba(255,255,255,0.05), 0 20px 40px rgba(0,0,0,0.5);
        margin: 0 auto 60px;
        max-width: 1000px;
    }

    /* 3D Book Hover Effect */
    .book-container {
        perspective: 1200px;
        display: block;
        margin: 0 auto;
        width: 100%;
        max-width: 350px;
    }

    .book-3d {
        position: relative;
        width: 100%;
        aspect-ratio: 0.65; /* Standard book aspect ratio */
        transform-style: preserve-3d;
        transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
        transform: rotateY(-15deg);
    }

    .book-container:hover .book-3d {
        transform: rotateY(-180deg) scale(1.05);
    }

    .book-cover {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 4px 8px 8px 4px;
        backface-visibility: hidden;
        box-shadow: -5px 10px 20px rgba(0,0,0,0.5), inset 2px 0 5px rgba(255,255,255,0.2);
        object-fit: cover;
    }

    .book-cover.front {
        transform: rotateY(0deg) translateZ(15px);
        z-index: 2;
    }

    .book-cover.back {
        transform: rotateY(180deg) translateZ(15px);
        border-radius: 8px 4px 4px 8px;
    }

    .book-spine {
        position: absolute;
        top: 0;
        left: 0;
        width: 30px;
        height: 100%;
        background: #111; /* Fallback */
        transform: rotateY(-90deg) translateZ(15px);
        border-radius: 4px 0 0 4px;
        box-shadow: inset -2px 0 5px rgba(0,0,0,0.5);
    }

    .publication-details {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .badge {
        background: rgba(202, 138, 4, 0.15);
        color: var(--accent);
        border: 1px solid rgba(202, 138, 4, 0.3);
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    .publication-details h2 {
        font-family: var(--font-display);
        font-size: 32px;
        line-height: 1.2;
        color: var(--text-heading);
        margin-bottom: 20px;
    }

    .publication-details p {
        color: var(--text-body);
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    .pub-meta {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
        color: var(--text-muted);
        font-size: 14px;
    }
    .pub-meta i {
        color: var(--accent);
        margin-right: 6px;
    }

    .btn-read {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient(135deg, #ca8a04 0%, #a16207 100%);
        color: #fff;
        padding: 14px 28px;
        border-radius: 12px;
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
        transition: transform 0.3s, box-shadow 0.3s;
        box-shadow: 0 4px 15px rgba(202, 138, 4, 0.3);
    }

    .btn-read:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(202, 138, 4, 0.4);
    }

    .coming-soon {
        text-align: center;
        padding: 60px;
        background: linear-gradient(180deg, rgba(255,255,255,0.02) 0%, transparent 100%);
        border: 1px dashed rgba(255,255,255,0.1);
        border-radius: 20px;
        max-width: 800px;
        margin: 0 auto;
    }

    .coming-soon i {
        font-size: 32px;
        color: var(--text-muted);
        margin-bottom: 16px;
        opacity: 0.5;
    }

    .coming-soon h3 {
        font-size: 20px;
        color: var(--text-heading);
        margin-bottom: 12px;
    }

    .coming-soon p {
        color: var(--text-muted);
        font-size: 15px;
        max-width: 500px;
        margin: 0 auto;
    }

    @media (max-width: 900px) {
        .publication-showcase {
            grid-template-columns: 1fr;
            padding: 40px 20px;
            gap: 40px;
            text-align: center;
        }
        .publication-details {
            align-items: center;
        }
        .pub-meta {
            justify-content: center;
        }
        .book-container:hover .book-3d {
            transform: rotateY(-15deg) scale(1.05); /* Simpler hover for mobile */
        }
    }
</style>
