---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { OG } from '../lib/seo';
import { academicStudies } from '../data/academic-studies';
import { FAMILIES, studyFamily, type IcmaFamily } from '../data/icma-families';
import '../styles/house.css';
import '../styles/academia.css';

/* Academia: HadithCritic's long-form works. The treatise is the one
   book-length publication; the isnād-cum-matn studies are being prepared as
   monographs and each is already published here as an article. */

const forensicTheses = [
  {
    number: '01',
    title: 'The Solitary Report (Khabar al-Wāḥid) Dilemma',
    summary:
      'Al-Shāfiʿī acknowledges that solitary reports yield probable, non-definitive knowledge (ẓann), yet demands they serve as definitive legal proof. This thesis demonstrates that elevating speculative transmission into categorical divine obligation subverts the Quranic prohibition against acting upon conjecture (ẓann).'
  },
  {
    number: '02',
    title: 'Ḥikmah as Scripture-Internal Discernment',
    summary:
      'A thorough collation of all 20 occurrences of the term al-ḥikmah in the Quran demonstrates that it never denotes an independent oral corpus. In Quranic usage, ḥikmah signifies divine discernment and scriptural comprehension endowed directly by God, invalidating al-Shāfiʿī’s equation of ḥikmah with hadith collections.'
  },
  {
    number: '03',
    title: 'The Subversion of Scripture via Abrogation (Naskh)',
    summary:
      'Al-Shāfiʿī’s framework allows extra-scriptural traditions to qualify, restrict, or effectively abrogate Quranic statutes. The treatise details how this principle reverses the ontological hierarchy of revelation, subordinating immutable divine text to fallible historical transmission.'
  },
  {
    number: '04',
    title: 'Qiyās and Raʾy Under Epistemic Scrutiny',
    summary:
      'Examining al-Shāfiʿī’s construction of juristic analogy (qiyās) as a religious imperative, the study contrasts human deductive interpolation against the Quran’s self-attested status as tibyānan li-kulli shayʾ (an exhaustive clarification of all legal essentials).'
  }
];

const bibtexCitation = `@book{hadithcritic2026decisive,
  author    = {HadithCritic Research},
  title     = {The Decisive Refutation of Imam al-Shāfiʿī's Kitāb Jāmiʿ al-ʿIlm},
  series    = {HadithCritic Academia Editions},
  volume    = {1},
  year      = {2026},
  publisher = {HadithCritic Press},
  address   = {London and New York},
  note      = {First Academic Critical Edition}
}`;

const chicagoCitation = `HadithCritic Research. The Decisive Refutation of Imam al-Shāfiʿī's Kitāb Jāmiʿ al-ʿIlm. HadithCritic Academia Editions, vol. 1. London and New York: HadithCritic Press, 2026.`;

const apaCitation = `HadithCritic Research. (2026). The Decisive Refutation of Imam al-Shāfiʿī's Kitāb Jāmiʿ al-ʿIlm (HadithCritic Academia Editions, Vol. 1). HadithCritic Press.`;

const treatise = academicStudies.find((study) => study.category === 'treatise');

/* The monograph series, by research family, largest family first, with each
   study linked to its published article. */
const articles = await getCollection('articles', ({ data }) => (import.meta.env.DEV || !data.draft) && !data.preview);
const articleUrl = new Map(articles.map((entry) => [entry.id.split('/').pop() ?? '', `/blogs/${entry.id}/`]));
const series = academicStudies
  .filter((study) => study.category === 'icma')
  .map((study, index) => ({
    ...study,
    no: String(index + 1).padStart(2, '0'),
    family: studyFamily[study.slug] ?? ('network' as IcmaFamily),
    href: articleUrl.get(study.slug)
  }));
const families = (Object.keys(FAMILIES) as IcmaFamily[])
  .map((id) => ({ id, ...FAMILIES[id], items: series.filter((study) => study.family === id) }))
  .filter((family) => family.items.length > 0)
  .sort((a, b) => b.items.length - a.items.length);
const published = series.filter((study) => study.href).length;
---

<BaseLayout
  image={OG.academia}
  title="Academia: Treatise and Monographs | HadithCritic"
  description="HadithCritic's long-form works: The Decisive Refutation, a treatise on al-Shāfiʿī's Kitāb Jāmiʿ al-ʿIlm, and a series of isnād-cum-matn studies being prepared as monographs."
>
  <div class="hc-page hc-plate ac-page">
    <!-- A title page, set centred over the engraving. -->
    <header class="hc-hero ac-hero" aria-labelledby="ac-title">
      <img
        class="hc-hero__art ac-hero__art"
        src="/images/editorial/academia-hero.webp"
        srcset="/images/editorial/academia-hero-1086.webp 1086w, /images/editorial/academia-hero.webp 2172w"
        sizes="100vw"
        width="2172"
        height="724"
        alt=""
        fetchpriority="high"
      />
      <div class="hc-container hc-hero__inner">
        <div class="hc-hero__copy">
          <p class="hc-hero__kicker">Academia</p>
          <h1 id="ac-title" class="hc-hero__title">Treatise <span>and monographs</span></h1>
          <span class="hc-ornament hc-hero__ornament" aria-hidden="true"></span>
          <p class="hc-hero__lede">
            HadithCritic's long-form work: a book-length treatise on al-Shāfiʿī's legal theory, and a
            series of isnād-cum-matn studies being prepared as monographs.
          </p>
          <div class="hc-hero__actions">
            <a href="#treatise" class="hc-btn">Read about the treatise</a>
            <a href="#series" class="hc-btn hc-btn--ghost">The monograph series</a>
          </div>
        </div>
      </div>
      <div class="hc-hero__register">
        <div class="hc-container">
          <span><strong>1</strong> treatise</span>
          <span><strong>{series.length}</strong> monographs in preparation</span>
          <span><strong>{families.length}</strong> research families</span>
        </div>
      </div>
    </header>

    <!-- The treatise -->
    <section class="hc-band hc-band--soft ac-treatise" id="treatise" aria-labelledby="treatise-title">
      <div class="hc-container ac-treatise__grid">
        <div class="ac-object">
          <div class="ac-object__view" id="acad-book-viewport" data-view="front">
            <img class="ac-object__cover ac-object__cover--front" id="book-view-front" src="/images/book_covers/RefutationKJI_FC.webp" alt="Front cover of The Decisive Refutation" width="480" height="720" loading="eager" />
            <img class="ac-object__cover ac-object__cover--back" id="book-view-back" src="/images/book_covers/RefutationKJI_BC.webp" alt="Back cover synopsis of The Decisive Refutation" width="480" height="720" loading="lazy" />
          </div>
          <div class="ac-object__switch" role="tablist" aria-label="Cover" data-js-only hidden>
            <button type="button" class="ac-object__tab is-active" id="tab-front" role="tab" aria-selected="true" aria-controls="book-view-front">Front cover</button>
            <button type="button" class="ac-object__tab" id="tab-back" role="tab" aria-selected="false" aria-controls="book-view-back">Back cover</button>
          </div>
          <noscript><a class="hc-link" href="/images/book_covers/RefutationKJI_BC.webp">View the back cover</a></noscript>
          <p class="ac-object__caption">HadithCritic Academia Edition · Volume I · Print and open-access PDF</p>
        </div>

        <article class="ac-record">
          <p class="hc-head__kicker">Treatise · Monograph I</p>
          <h2 id="treatise-title" class="ac-record__title">The Decisive Refutation</h2>
          <p class="ac-record__subtitle">of Imam al-Shāfiʿī's <em>Kitāb Jāmiʿ al-ʿIlm</em></p>
          {treatise?.arabicTitle && <p class="ac-record__ar" lang="ar" dir="rtl">{treatise.arabicTitle}</p>}

          <div class="ac-record__abstract">
            <p>
              In <em>Kitāb Jāmiʿ al-ʿIlm</em>, Imam al-Shāfiʿī (d. 204 AH) articulated one of the earliest systematic defenses of hadith authority in Islamic legal history. His doctrine established that the Quran cannot function as an independent, complete legal canon without being qualified, supplemented, and governed by solitary reports, consensus, and juristic analogy.
            </p>
            <p class="ac-record__thesis">
              This treatise subjects al-Shāfiʿī's doctrine to exhaustive scriptural, linguistic, and epistemological critique.
            </p>
            <p>
              Following al-Shāfiʿī's argument line by line in its original sequence, <em>The Decisive Refutation</em> investigates his reliance upon solitary reports (<em>khabar al-wāḥid</em>), the linguistic redefinition of <em>ḥikmah</em>, the doctrine of post-prophetic abrogation (<em>naskh</em>), and juristic analogy (<em>qiyās</em>). Each proposition is held directly against the Quran's self-declared standards of completion, clarity, and non-speculative certitude.
            </p>
          </div>

          <dl class="ac-record__facts">
            <div><dt>Subject work</dt><dd>Kitāb Jāmiʿ al-ʿIlm (al-Shāfiʿī)</dd></div>
            <div><dt>Apparatus</dt><dd>Arabic collation and English forensics</dd></div>
            <div><dt>Target release</dt><dd>Q3 2026 · Hardcover and open PDF</dd></div>
            <div><dt>Identifier</dt><dd>HC-TR-01 · Academia Series</dd></div>
          </dl>

          <div class="ac-theses">
            <h3 class="hc-rubric">The four theses <span>Open each for its summary</span></h3>
            {forensicTheses.map((thesis) => (
              <details class="acad-thesis-item ac-thesis">
                <summary class="ac-thesis__summary">
                  <span class="ac-thesis__no">{thesis.number}</span>
                  <span class="ac-thesis__title">{thesis.title}</span>
                  <span class="ac-thesis__mark" aria-hidden="true"></span>
                </summary>
                <div class="acad-thesis-body ac-thesis__body">
                  <p>{thesis.summary}</p>
                </div>
              </details>
            ))}
          </div>

          <div class="ac-record__actions">
            <a href="#citation-suite" class="hc-btn">Cite this treatise</a>
            <a href="https://independent.academia.edu" target="_blank" rel="noopener noreferrer" class="hc-btn hc-btn--ghost">
              Academia.edu repository <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
          <p class="ac-record__status">
            Typesetting and critical apparatus review in progress. Pre-order and PDF distribution will be announced here.
          </p>
        </article>
      </div>
    </section>

    <!-- Citation -->
    <section class="hc-band ac-cite" id="citation-suite" aria-labelledby="citation-title">
      <div class="hc-container ac-cite__grid">
        <header>
          <h2 id="citation-title" class="hc-head__title">Citing <span>the treatise</span></h2>
          <p class="hc-head__note">The reference in three formats, for journals, theses and monographs.</p>
        </header>

        <div class="ac-card">
          <div class="ac-card__bar">
            <div class="ac-card__tabs" role="tablist" aria-label="Citation format" data-js-only hidden>
              <button type="button" class="ac-card__tab is-active" id="cite-tab-bibtex" role="tab" aria-selected="true" aria-controls="cite-panel-bibtex" data-format="bibtex">BibTeX</button>
              <button type="button" class="ac-card__tab" id="cite-tab-chicago" role="tab" aria-selected="false" aria-controls="cite-panel-chicago" data-format="chicago">Chicago</button>
              <button type="button" class="ac-card__tab" id="cite-tab-apa" role="tab" aria-selected="false" aria-controls="cite-panel-apa" data-format="apa">APA</button>
            </div>
            <button type="button" class="ac-card__copy" id="btn-copy-citation" data-js-only hidden>
              <span id="copy-btn-label">Copy citation</span>
            </button>
          </div>
          <div class="ac-card__panels">
            <section class="ac-card__panel is-visible" id="cite-panel-bibtex" role="tabpanel" aria-labelledby="cite-tab-bibtex">
              <h3 class="ac-card__format">BibTeX</h3>
              <pre><code>{bibtexCitation}</code></pre>
            </section>
            <section class="ac-card__panel is-visible" id="cite-panel-chicago" role="tabpanel" aria-labelledby="cite-tab-chicago">
              <h3 class="ac-card__format">Chicago, 17th edition</h3>
              <p>{chicagoCitation}</p>
            </section>
            <section class="ac-card__panel is-visible" id="cite-panel-apa" role="tabpanel" aria-labelledby="cite-tab-apa">
              <h3 class="ac-card__format">APA, 7th edition</h3>
              <p>{apaCitation}</p>
            </section>
          </div>
          <p class="ac-card__foot">
            <span>Permanent identifier: HC-TR-01 / 2026-DECISIVE-REFUTATION</span>
            <span>Open scholarly access · CC BY-NC-ND 4.0</span>
          </p>
        </div>
      </div>
    </section>

    <!-- The monograph series -->
    <section class="hc-band hc-band--warm ac-series" id="series" aria-labelledby="series-title">
      <div class="hc-container">
        <header class="hc-head">
          <div class="hc-head__main">
            <h2 id="series-title" class="hc-head__title">The monograph <span>series</span></h2>
            <p class="hc-head__note">
              {series.length} isnād-cum-matn studies, each tracing a tradition to its common link and dating it.
              Covers are in production; {published === series.length ? 'every one' : `${published} of them`} can be read now as an article.
            </p>
          </div>
          <a href="/projects/academic-studies/" class="hc-link">Common links and dating in the ICMA Register <span aria-hidden="true">→</span></a>
        </header>

        <div class="ac-families">
          {families.map((family) => (
            <section class="ac-family" aria-labelledby={`family-${family.id}`} style={`--family:${family.bg};--family-ring:${family.accent}`}>
              <h3 id={`family-${family.id}`} class="ac-family__name">
                <span class="ac-family__swatch" aria-hidden="true"></span>
                {family.label}
                <span class="ac-family__n">{family.items.length}</span>
              </h3>
              <ol class="ac-family__list">
                {family.items.map((study) => (
                  <li class="ac-mono">
                    <span class="ac-mono__no">No. {study.no}</span>
                    <span class="ac-mono__body">
                      {study.href ? (
                        <a class="ac-mono__title" href={study.href}>{study.title}</a>
                      ) : (
                        <span class="ac-mono__title">{study.title}</span>
                      )}
                      {study.subtitle && <span class="ac-mono__sub">{study.subtitle}</span>}
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="hc-band ac-related" aria-labelledby="related-title">
      <div class="hc-container">
        <p class="hc-rubric" id="related-title">Related research <span>Registers of the method and the scholarship</span></p>
        <ul class="ac-related__list">
          <li>
            <a href="/projects/academic-studies/" class="ac-related__item">
              <img src="/images/platform/icma-1086.webp" alt="" width="1086" height="362" loading="lazy" decoding="async" />
              <span class="ac-related__kind">Isnād-cum-matn studies</span>
              <span class="ac-related__title">The ICMA Register</span>
              <span class="ac-related__text">Every study in the series with its common link and dating, filed by research family.</span>
            </a>
          </li>
          <li>
            <a href="/projects/islamic-studies-atlas/" class="ac-related__item">
              <img src="/images/platform/atlas-1086.webp" alt="" width="1086" height="362" loading="lazy" decoding="async" />
              <span class="ac-related__kind">Research network</span>
              <span class="ac-related__title">Islamic Studies Atlas</span>
              <span class="ac-related__text">Modern scholarship on ḥadīth criticism, with the citations between works traced one study at a time.</span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /* Cover switch and citation tabs. Without script both covers are reachable
     and all three citation formats are printed in full. */
  function initAcademia(): void {
    const page = document.querySelector<HTMLElement>('.ac-page');
    if (!page || page.dataset.ready) return;
    page.dataset.ready = '1';
    page.querySelectorAll<HTMLElement>('[data-js-only]').forEach((element) => (element.hidden = false));
    page.classList.add('is-enhanced');

    const viewport = page.querySelector<HTMLElement>('#acad-book-viewport');
    const coverTabs = [...page.querySelectorAll<HTMLButtonElement>('.ac-object__tab')];
    for (const tab of coverTabs) {
      tab.addEventListener('click', () => {
        const view = tab.id === 'tab-back' ? 'back' : 'front';
        viewport?.setAttribute('data-view', view);
        for (const other of coverTabs) {
          const active = other === tab;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-selected', String(active));
        }
      });
    }

    const tabs = [...page.querySelectorAll<HTMLButtonElement>('.ac-card__tab')];
    const panels = new Map(tabs.map((tab) => [tab.dataset.format ?? '', page.querySelector<HTMLElement>(`#cite-panel-${tab.dataset.format}`)]));
    let current = 'bibtex';
    const show = (format: string): void => {
      current = format;
      for (const tab of tabs) {
        const active = tab.dataset.format === format;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      }
      for (const [key, panel] of panels) panel?.classList.toggle('is-visible', key === format);
    };
    for (const tab of tabs) tab.addEventListener('click', () => show(tab.dataset.format ?? 'bibtex'));
    show('bibtex');

    const copy = page.querySelector<HTMLButtonElement>('#btn-copy-citation');
    const label = page.querySelector<HTMLElement>('#copy-btn-label');
    copy?.addEventListener('click', async () => {
      const panel = panels.get(current);
      const text = panel?.querySelector('pre, p')?.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(text);
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Select the text to copy it';
      }
      window.setTimeout(() => {
        if (label) label.textContent = 'Copy citation';
      }, 2200);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAcademia, { once: true });
  } else {
    initAcademia();
  }
  document.addEventListener('astro:page-load', initAcademia);
</script>
