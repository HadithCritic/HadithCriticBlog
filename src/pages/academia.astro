---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Academia">
    <div class="academia-page">
        <!-- Page Header -->
        <div class="page-header">
            <div class="container">
                <h1><em>Academia</em></h1>
                <p>Academic publications, papers, and critical research methodologies in Islamic studies.</p>
            </div>
        </div>

        <div class="container page-body">
            <!-- Featured Publication -->
            <div class="publication-showcase">
                <a href="https://www.academia.edu/144226568/The_Decisive_Refutation_of_Im%C4%81m_al_Sh%C4%81fi%CA%BF%C4%ABs_Kit%C4%81b_J%C4%81mi%CA%BF_al_%CA%BFIlm"
                    target="_blank" rel="noopener noreferrer" class="book-container">
                    <div class="book-3d">
                        <img src="/images/RefutationKJI_FC.png" alt="Book front cover" class="book-cover front">
                        <img src="/images/RefutationKJI_BC.png" alt="Book back cover" class="book-cover back">
                        <div class="book-spine"></div>
                    </div>
                </a>
                <div class="publication-details">
                    <span class="pub-label">Latest Publication</span>
                    <h2>The Decisive Refutation of Imām al-Shāfiʿī's Kitāb Jāmiʿ al-ʿIlm</h2>
                    <p>
                        A comprehensive critical examination of Imām al-Shāfiʿī's epistemological framework and
                        foundational arguments in Islamic jurisprudence. This work deconstructs classical assumptions
                        of isnād methodology and the canonization of prophetic reports.
                    </p>
                    <div class="pub-meta">
                        <span><i class="fas fa-file-pdf"></i> PDF Available</span>
                        <span><i class="fas fa-university"></i> Academia.edu</span>
                    </div>
                    <a href="https://www.academia.edu/144226568/The_Decisive_Refutation_of_Im%C4%81m_al_Sh%C4%81fi%CA%BF%C4%ABs_Kit%C4%81b_J%C4%81mi%CA%BF_al_%CA%BFIlm"
                        target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                        Read Publication <i class="fas fa-external-link-alt"></i>
                    </a>
                </div>
            </div>

            <!-- Forthcoming -->
            <div class="upcoming">
                <div class="upcoming-rule"></div>
                <div class="upcoming-content">
                    <h3>More Publications Forthcoming</h3>
                    <p>Additional research papers, datasets, and critical essays are undergoing peer review and formatting.</p>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .academia-page {
        min-height: 80vh;
    }

    /* ── Page Header ──────────────────────────────── */
    .page-header {
        padding: clamp(72px, 10vw, 120px) 0 clamp(48px, 6vw, 72px);
        border-bottom: 1px solid var(--border);
    }

    .page-header h1 {
        font-size: clamp(3rem, 7vw, 5.5rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.03em;
        margin-bottom: 20px;
        text-transform: none;
    }

    .page-header h1 em {
        font-style: italic;
        color: var(--blue-700);
    }

    .page-header p {
        font-size: clamp(1rem, 1.6vw, 1.1rem);
        color: var(--text-muted);
        line-height: 1.75;
        max-width: 56ch;
    }

    /* ── Page Body ────────────────────────────────── */
    .page-body {
        padding-top: clamp(56px, 8vw, 96px);
        padding-bottom: clamp(56px, 8vw, 96px);
    }

    /* ── Publication Showcase ─────────────────────── */
    .publication-showcase {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: clamp(40px, 6vw, 80px);
        align-items: center;
        margin-bottom: clamp(72px, 10vw, 112px);
    }

    .book-container {
        perspective: 1200px;
        display: block;
        margin: 0 auto;
        width: 100%;
        max-width: 300px;
    }

    .book-3d {
        position: relative;
        width: 100%;
        aspect-ratio: 0.65;
        transform-style: preserve-3d;
        transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
        transform: rotateY(-15deg);
    }

    .book-container:hover .book-3d {
        transform: rotateY(-180deg) scale(1.04);
    }

    .book-cover {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        border-radius: 3px 8px 8px 3px;
        backface-visibility: hidden;
        box-shadow: -5px 10px 24px rgba(0, 0, 0, 0.55), inset 2px 0 5px rgba(255, 255, 255, 0.18);
        object-fit: cover;
    }

    .book-cover.front {
        transform: rotateY(0deg) translateZ(15px);
        z-index: 2;
    }

    .book-cover.back {
        transform: rotateY(180deg) translateZ(15px);
        border-radius: 8px 3px 3px 8px;
    }

    .book-spine {
        position: absolute;
        top: 0; left: 0;
        width: 30px; height: 100%;
        background: #111;
        transform: rotateY(-90deg) translateZ(15px);
        border-radius: 3px 0 0 3px;
        box-shadow: inset -2px 0 5px rgba(0, 0, 0, 0.5);
    }

    /* ── Publication Details ──────────────────────── */
    .publication-details {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .pub-label {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--blue-700);
        margin-bottom: 16px;
        display: block;
    }

    .publication-details h2 {
        font-size: clamp(1.4rem, 2.5vw, 2rem);
        font-weight: 700;
        font-style: italic;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: var(--text-heading);
        margin-bottom: 20px;
        text-transform: none;
    }

    .publication-details p {
        color: var(--text-body);
        font-size: 15px;
        line-height: 1.75;
        margin-bottom: 24px;
        max-width: 52ch;
    }

    .pub-meta {
        display: flex;
        gap: 20px;
        margin-bottom: 28px;
        color: var(--text-muted);
        font-family: var(--font-sans);
        font-size: 13px;
    }

    .pub-meta i {
        color: var(--blue-700);
        margin-right: 6px;
    }

    /* ── Forthcoming ──────────────────────────────── */
    .upcoming {
        display: flex;
        align-items: flex-start;
        gap: 28px;
    }

    .upcoming-rule {
        flex-shrink: 0;
        width: 2px;
        height: 72px;
        background: var(--border-strong);
        margin-top: 6px;
        border-radius: 2px;
    }

    .upcoming-content h3 {
        font-size: clamp(1rem, 2vw, 1.25rem);
        font-weight: 600;
        color: var(--text-heading);
        margin-bottom: 10px;
        letter-spacing: -0.01em;
        text-transform: none;
    }

    .upcoming-content p {
        color: var(--text-muted);
        font-family: var(--font-sans);
        font-size: 15px;
        line-height: 1.7;
        max-width: 56ch;
    }

    @media (prefers-reduced-motion: reduce) {
        .book-3d { transition: none; }
    }

    /* ── Responsive ───────────────────────────────── */
    @media (max-width: 860px) {
        .publication-showcase {
            grid-template-columns: 1fr;
            gap: 48px;
        }

        .publication-details {
            align-items: center;
            text-align: center;
        }

        .publication-details p {
            max-width: unset;
        }

        .pub-meta {
            justify-content: center;
        }

        .book-container:hover .book-3d {
            transform: rotateY(-15deg) scale(1.03);
        }
    }
</style>
