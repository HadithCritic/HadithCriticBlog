---
import BaseLayout from '../layouts/BaseLayout.astro';

const publicationShelf = [
  {
    title: 'The Decisive Refutation',
    tag: 'Treatise',
    description:
      "A Quranic analysis of al-Shafi'i's legal theory and a sustained challenge to the foundations of Sunni legal authority.",
    cover: '/images/book_covers/RefutationKJI_FC.png',
    alt: 'Front cover of The Decisive Refutation',
    featured: true
  },
  {
    title: 'Transmission and Authority',
    tag: 'Monograph',
    description:
      'A future study on isnad growth, narrator evaluation, and the historical use of hadith as authority.'
  },
  {
    title: 'Quran and Legal Sufficiency',
    tag: 'Critical Edition',
    description:
      'A focused study on whether post-Quranic legal supplementation can be justified from the Quran itself.'
  }
];
---

<BaseLayout
  title="Academia | HadithCritic"
  description="Formal HadithCritic publications, treatises, editions, and long-form Quran-centered research."
>
  <main class="academia-page">
    <section class="academia-hero" aria-labelledby="academia-title">
      <div class="hc-container academia-hero__inner">
        <span class="academia-eyebrow">Academia</span>
        <h1 id="academia-title" class="academia-title">Research, editions, and formal publications.</h1>
        <p class="academia-intro">
          HadithCritic's academic wing presents long-form treatises, monographs, and formal studies
          on hadith transmission, legal theory, source history, and Quran-centered criticism.
        </p>
      </div>
    </section>

    <section class="academia-featured hc-container" aria-labelledby="featured-publication-title">
      <header class="section-heading">
        <div>
          <span class="section-kicker">Featured publication</span>
          <h2 id="featured-publication-title" class="section-title">A formal treatise, staged as a publication.</h2>
        </div>
      </header>

      <article class="featured-book">
        <div class="featured-book__visual">
          <div class="book-stage">
            <div class="book-display" aria-label="Front and back cover preview for The Decisive Refutation">
              <div class="book-scene">
                <img
                  src="/images/book_covers/RefutationKJI_BC.png"
                  alt="Back cover of The Decisive Refutation"
                  class="book-cover book-cover--back"
                  loading="eager"
                />
                <img
                  src="/images/book_covers/RefutationKJI_FC.png"
                  alt="Front cover of The Decisive Refutation"
                  class="book-cover book-cover--front"
                  loading="eager"
                />
              </div>
              <div class="book-shadow" aria-hidden="true"></div>
            </div>

            <div class="book-stage__caption">
              <span>Academia Edition</span>
              <span>Front and Back Cover Preview</span>
            </div>
          </div>
        </div>

        <div class="featured-book__content">
          <div class="featured-book__meta" aria-label="Publication metadata">
            <span class="meta-chip">New Treatise</span>
            <span class="meta-chip meta-chip--soft">Quran-Centered Criticism</span>
          </div>

          <h3 class="featured-book__title">The Decisive Refutation</h3>
          <p class="featured-book__subtitle">
            of Imam al-Shafi'i's <em>Kitab Jami' al-'Ilm</em>
          </p>

          <div class="featured-book__abstract">
            <p>
              In <em>Kitab Jami' al-'Ilm</em>, Imam al-Shafi'i presents one of the earliest systematic
              defenses of hadith authority. His argument is simple but far-reaching: the Quran must
              be read through the Sunnah, consensus, analogy, and juristic reasoning in order to become
              a complete legal system.
            </p>

            <p class="featured-book__emphasis">
              This treatise challenges that premise.
            </p>

            <p>
              Moving through al-Shafi'i's argument in sequence, <em>The Decisive Refutation</em>
              examines his use of hikmah, obedience verses, abrogation, general and specific rulings,
              ijma', qiyas, solitary reports, and the hadith of ijtihad. Rather than treating these
              doctrines as inherited assumptions, it tests each one against the Quran's own claims
              of clarity, completeness, and sufficiency.
            </p>

            <p>
              The question is not whether al-Shafi'i was historically important. He was. The question
              is whether his legal theory can survive the standard it claims to serve: the Word of God.
            </p>
          </div>

          <dl class="featured-book__highlights">
            <div class="highlight-box">
              <dt class="highlight-box__label">Edition</dt>
              <dd class="highlight-box__value">Academia Edition</dd>
            </div>
            <div class="highlight-box">
              <dt class="highlight-box__label">Format</dt>
              <dd class="highlight-box__value">PDF / Print</dd>
            </div>
            <div class="highlight-box">
              <dt class="highlight-box__label">Scope</dt>
              <dd class="highlight-box__value">Legal Theory / Hadith Authority</dd>
            </div>
          </dl>

          <div class="featured-book__actions">
            <a href="#" class="hc-btn">Download PDF</a>
            <a href="#" class="hc-btn hc-btn--ghost">Order Print Edition</a>
          </div>
        </div>
      </article>
    </section>

    <section class="academia-archive hc-container" aria-labelledby="publication-shelf-title">
      <header class="section-heading">
        <div>
          <span class="section-kicker">Publishing shelf</span>
          <h2 id="publication-shelf-title" class="section-title">Current and forthcoming works.</h2>
        </div>
      </header>

      <div class="publication-grid">
        {publicationShelf.map((publication) => (
          <article class:list={['publication-card', publication.featured && 'publication-card--featured']}>
            {publication.cover ? (
              <div class="publication-card__thumb">
                <img src={publication.cover} alt={publication.alt} />
              </div>
            ) : (
              <div class="publication-card__placeholder">
                <span>Forthcoming</span>
              </div>
            )}

            <div class="publication-card__body">
              <span class="publication-card__tag">{publication.tag}</span>
              <h3 class="publication-card__title">{publication.title}</h3>
              <p class="publication-card__text">{publication.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <style>
  .academia-page {
    --academia-black: var(--hc-black, #0f0f10);
    --academia-black-soft: var(--hc-black-soft, #141312);
    --academia-gold: var(--hc-gold, #d8b166);
    --academia-gold-soft: var(--hc-gold-soft, #e2c783);
    --academia-gold-dim: var(--hc-gold-dim, #9d7a3c);
    --academia-umber: var(--hc-umber, #a46a3f);
    --academia-parchment: var(--hc-parchment, #f2ebdc);
    --academia-muted: var(--hc-muted, #b8ad99);
    --academia-rule: var(--hc-rule, rgba(216, 177, 102, 0.32));
    --academia-rule-soft: var(--hc-rule-soft, rgba(242, 235, 220, 0.14));

    min-height: 100vh;
    background:
      linear-gradient(115deg, rgba(164, 106, 63, 0.12), transparent 34%),
      linear-gradient(180deg, rgba(38, 35, 31, 0.92), var(--academia-black) 36%, var(--academia-black));
  }

  .academia-hero {
    position: relative;
    padding: clamp(6.5rem, 9vw, 9rem) 0 clamp(3.75rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--academia-rule);
    overflow: hidden;
  }

  .academia-hero::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(216, 177, 102, 0.12);
    pointer-events: none;
  }

  .academia-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(216, 177, 102, 0.05), transparent 32%, transparent 68%, rgba(164, 106, 63, 0.08)),
      repeating-linear-gradient(90deg, rgba(242, 235, 220, 0.035) 0 1px, transparent 1px 96px);
    opacity: 0.58;
    pointer-events: none;
  }

  .academia-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .academia-eyebrow,
  .section-kicker,
  .meta-chip,
  .highlight-box__label,
  .book-stage__caption,
  .publication-card__tag,
  .publication-card__placeholder {
    font-family: var(--font-ui);
    text-transform: uppercase;
  }

  .academia-eyebrow {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--academia-gold);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .academia-title {
    max-width: 820px;
    margin: 0;
    color: var(--academia-parchment);
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.9rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.94;
  }

  .academia-intro {
    max-width: 730px;
    margin: 1.4rem 0 0;
    color: var(--academia-muted);
    font-size: clamp(1.05rem, 0.5vw + 1rem, 1.24rem);
    line-height: 1.78;
  }

  .academia-featured,
  .academia-archive {
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .section-kicker {
    display: inline-block;
    margin-bottom: 0.55rem;
    color: var(--academia-gold);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .section-title {
    margin: 0;
    color: var(--academia-parchment);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3vw, 2.85rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.04;
  }

  .featured-book {
    display: grid;
    grid-template-columns: minmax(300px, 0.95fr) minmax(380px, 1.05fr);
    gap: clamp(2rem, 5vw, 4.25rem);
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-top: 1px solid var(--academia-rule);
    border-bottom: 1px solid var(--academia-rule);
  }

  .featured-book__visual,
  .featured-book__content {
    min-width: 0;
  }

  .book-stage {
    position: relative;
    padding: clamp(1.2rem, 2.5vw, 2rem);
    border: 1px solid rgba(216, 177, 102, 0.18);
    background:
      linear-gradient(145deg, rgba(216, 177, 102, 0.06), transparent 40%),
      linear-gradient(180deg, rgba(242, 235, 220, 0.02), rgba(15, 15, 16, 0)),
      var(--academia-black-soft);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.32);
  }

  .book-stage::before {
    content: "";
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(216, 177, 102, 0.09);
    pointer-events: none;
  }

  .book-display {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(420px, 50vw, 640px);
    perspective: 1200px;
  }

  .book-scene {
    position: relative;
    width: min(78%, 380px);
    aspect-ratio: 2 / 3;
    transform-style: preserve-3d;
    transition: transform 600ms var(--ease);
  }

  .book-stage:hover .book-scene {
    transform: rotateY(-8deg) rotateX(2deg);
  }

  .book-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(216, 177, 102, 0.15);
    transition: transform 600ms var(--ease), filter 600ms ease;
  }

  .book-cover--back {
    z-index: 1;
    filter: brightness(0.78) saturate(0.85) contrast(1.05);
    transform: translateX(-18%) translateZ(-40px) rotateY(18deg);
  }

  .book-stage:hover .book-cover--back {
    filter: brightness(0.85) saturate(0.9) contrast(1.05);
    transform: translateX(-26%) translateZ(-50px) rotateY(22deg);
  }

  .book-cover--front {
    z-index: 2;
    transform: translateX(8%) translateZ(20px) rotateY(-6deg);
  }

  .book-stage:hover .book-cover--front {
    transform: translateX(12%) translateZ(30px) rotateY(-10deg);
  }

  .book-shadow {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 6%;
    height: 14%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.55) 0%, transparent 70%);
    filter: blur(18px);
    transform: translateZ(-80px);
    pointer-events: none;
    transition: opacity 600ms ease, transform 600ms var(--ease);
  }

  .book-stage:hover .book-shadow {
    opacity: 0.75;
    transform: translateZ(-80px) scaleX(1.08);
  }

  .book-stage__caption {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(216, 177, 102, 0.18);
    color: var(--academia-gold-dim);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .featured-book__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .meta-chip {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0.38rem 0.76rem;
    border: 1px solid rgba(216, 177, 102, 0.24);
    color: var(--academia-gold-soft);
    background: rgba(216, 177, 102, 0.07);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .meta-chip--soft {
    border-color: rgba(164, 106, 63, 0.34);
    color: #d9bd8a;
    background: rgba(164, 106, 63, 0.1);
  }

  .featured-book__title {
    margin: 0;
    color: var(--academia-parchment);
    font-family: var(--font-display);
    font-size: clamp(2.45rem, 4.5vw, 4.6rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.94;
  }

  .featured-book__subtitle {
    max-width: 680px;
    margin: 0.65rem 0 1.65rem;
    color: var(--academia-gold);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.25;
  }

  .featured-book__abstract {
    max-width: 72ch;
  }

  .featured-book__abstract p {
    margin: 0 0 1rem;
    color: var(--academia-muted);
    font-size: clamp(1rem, 0.3vw + 0.98rem, 1.08rem);
    line-height: 1.78;
  }

  .featured-book__emphasis {
    color: var(--academia-parchment) !important;
    font-weight: 600;
  }

  .featured-book__highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 1.8rem 0 0;
    padding: 0;
    border: 1px solid rgba(216, 177, 102, 0.18);
    background: rgba(216, 177, 102, 0.14);
  }

  .highlight-box {
    min-width: 0;
    padding: 1rem;
    background:
      linear-gradient(180deg, rgba(242, 235, 220, 0.025), rgba(15, 15, 16, 0)),
      rgba(15, 15, 16, 0.54);
  }

  .highlight-box__label,
  .highlight-box__value {
    margin: 0;
  }

  .highlight-box__label {
    margin-bottom: 0.35rem;
    color: var(--academia-gold-dim);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .highlight-box__value {
    color: var(--academia-parchment);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .featured-book__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .academia-archive {
    padding-bottom: clamp(5rem, 9vw, 7rem);
  }

  .publication-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    gap: 1px;
    border: 1px solid var(--academia-rule);
    background: var(--academia-rule);
  }

  .publication-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    background:
      linear-gradient(180deg, rgba(38, 35, 31, 0.8), rgba(15, 15, 16, 0.96)),
      var(--academia-black-soft);
  }

  .publication-card__thumb,
  .publication-card__placeholder {
    display: grid;
    aspect-ratio: 4 / 3;
    place-items: center;
    border-bottom: 1px solid var(--academia-rule-soft);
  }

  .publication-card__thumb {
    padding: 1.2rem;
    background: linear-gradient(180deg, rgba(216, 177, 102, 0.08), rgba(15, 15, 16, 0));
  }

  .publication-card__thumb img {
    width: min(52%, 220px);
    height: auto;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
  }

  .publication-card__placeholder {
    color: var(--academia-gold-dim);
    background:
      linear-gradient(135deg, rgba(164, 106, 63, 0.14), transparent 40%),
      linear-gradient(180deg, rgba(242, 235, 220, 0.025), rgba(15, 15, 16, 0));
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.17em;
  }

  .publication-card__body {
    padding: clamp(1.15rem, 2vw, 1.45rem);
  }

  .publication-card__tag {
    display: inline-block;
    margin-bottom: 0.75rem;
    color: var(--academia-gold);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
  }

  .publication-card__title {
    margin: 0 0 0.7rem;
    color: var(--academia-parchment);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.02;
  }

  .publication-card__text {
    margin: 0;
    color: var(--academia-muted);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  @media (max-width: 1100px) {
    .featured-book,
    .publication-grid {
      grid-template-columns: 1fr;
    }

    .book-stage {
      max-width: 560px;
      margin-inline: auto;
    }

    .featured-book__highlights {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .academia-hero::before {
      inset: 10px;
    }

    .section-heading {
      display: block;
    }

    .book-stage {
      padding: 0.9rem;
    }

    .book-display {
      min-height: clamp(360px, 100vw, 460px);
    }

    .book-scene {
      width: min(72%, 300px);
    }

    .book-stage__caption {
      display: grid;
      gap: 0.25rem;
    }

    .publication-card__thumb img {
      width: min(48%, 190px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-scene,
    .book-cover,
    .book-shadow {
      transition: none !important;
    }

    .book-stage:hover .book-scene {
      transform: none !important;
    }

    .book-stage:hover .book-cover--back {
      filter: brightness(0.78) saturate(0.85) contrast(1.05) !important;
      transform: translateX(-18%) translateZ(-40px) rotateY(18deg) !important;
    }

    .book-stage:hover .book-cover--front {
      transform: translateX(8%) translateZ(20px) rotateY(-6deg) !important;
    }

    .book-stage:hover .book-shadow {
      opacity: 1 !important;
      transform: translateZ(-80px) !important;
    }
  }
  </style>
</BaseLayout>
