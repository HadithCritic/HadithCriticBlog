---
import BaseLayout from '../layouts/BaseLayout.astro';
import BibleVerse from '../components/article/BibleVerse.astro';
import QuranVerse from '../components/article/QuranVerse.astro';
import HadithBlock from '../components/article/HadithBlock.astro';
import ClaimBox from '../components/article/ClaimBox.astro';
import VerdictBox from '../components/article/VerdictBox.astro';
import ContextNote from '../components/article/ContextNote.astro';
import QuoteBlock from '../components/article/QuoteBlock.astro';
import SectionDivider from '../components/article/SectionDivider.astro';
import EditorialToc from '../components/article/EditorialToc.astro';
import fs from 'node:fs';
import path from 'node:path';

let designMdContent = '';
try {
  designMdContent = fs.readFileSync(path.resolve(process.cwd(), 'DESIGN.md'), 'utf-8');
} catch (e) {
  console.warn('Could not read DESIGN.md at build time', e);
}

// ── Colors (21 Core Tokens + Taxonomy/Status) ─────────────────────────────
const colorGroups = [
  {
    category: 'Brand & Accent',
    subtitle: 'Sparing, hierarchy & active-state voltage (<5% viewport footprint).',
    colors: [
      { name: 'Antique Gold', token: '--hc-gold', darkHex: '#d8b166', lightHex: '#6f5019', contrast: '7.8:1 AAA', role: 'Active links, emblems, focus rings, and primary hierarchy.' },
      { name: 'Gold Bright', token: '--hc-gold-bright', darkHex: '#e8c878', lightHex: '#63440f', contrast: '9.2:1 AAA', role: 'Hover states, active focus indicators, and luminous accents.' },
      { name: 'Gold Soft', token: '--hc-gold-soft', darkHex: '#e2c783', lightHex: '#795820', contrast: '8.5:1 AAA', role: 'Selection backgrounds and button gradient stops.' },
      { name: 'Gold Dim', token: '--hc-gold-dim', darkHex: '#9d7a3c', lightHex: '#7a5920', contrast: '4.6:1 AA', role: 'Quiet apparatus borders and subtle ornament lines.' },
      { name: 'Accent Copper', token: '--hc-copper', darkHex: '#c48b68', lightHex: '#8a4c27', contrast: '5.2:1 AA', role: 'Text-safe warm copper for apparatus notes and diagrams.' },
      { name: 'Accent Umber', token: '--hc-umber', darkHex: '#a46a3f', lightHex: '#8a4c27', contrast: '4.5:1 AA', role: 'Historical context notes, caution banners, and chapter cards.' },
      { name: 'Accent Prophecy', token: '--hc-prophecy', darkHex: '#7b2d24', lightHex: '#a84b3e', contrast: '4.5:1 AA', role: 'Sparing rubric red for critical prophecy and warning callouts.' },
    ]
  },
  {
    category: 'Surface',
    subtitle: 'Warm-tinted layered grounds, panels, elevated cards, and manuscript sheets.',
    colors: [
      { name: 'Canvas Ground', token: '--hc-surface-0', darkHex: '#0f0f10', lightHex: '#fbf9f4', contrast: '15.8:1 AAA', role: 'Canonical page canvas; deep tinted-black in dark, ivory in light.' },
      { name: 'Surface Panel', token: '--hc-surface-1', darkHex: '#141312', lightHex: '#f2ece0', contrast: '14.2:1 AAA', role: 'Structural panels, persistent navigation bars, and chrome.' },
      { name: 'Surface Elevated', token: '--hc-surface-2', darkHex: '#1e1d1b', lightHex: '#e8e2d5', contrast: '12.4:1 AAA', role: 'Elevated ledger cards, searchbars, toolbars, and active trays.' },
      { name: 'Surface Card / Well', token: '--hc-surface-3', darkHex: '#26231f', lightHex: '#dfd8cb', contrast: '10.8:1 AAA', role: 'Nested card modules, input wells, and border backdrops.' },
      { name: 'Fixed Parchment', token: '--hc-fixed-parchment', darkHex: '#f2ebdc', lightHex: '#f2ebdc', contrast: '13.5:1 AAA', role: 'Fixed parchment evidence cards, manuscript quotes, and source sheets.' },
      { name: 'Surface Umber Sheet', token: '--hc-surface-umber', darkHex: '#6e3b24', lightHex: '#f4ede6', contrast: '4.8:1 AA', role: 'Deep umber background for historical context notes and apparatus.' },
    ]
  },
  {
    category: 'Text',
    subtitle: 'High-contrast typography tiers calibrated for WCAG 2.2 AA in both modes.',
    colors: [
      { name: 'Text Primary', token: '--hc-text-primary', darkHex: '#f2ebdc', lightHex: '#2b2824', contrast: '14.5:1 AAA', role: 'High-contrast headline and running reading text across all views.' },
      { name: 'Text Secondary', token: '--hc-text-secondary', darkHex: '#b8ad99', lightHex: '#6b635a', contrast: '7.2:1 AAA', role: 'Lede text, apparatus subheadings, metadata timestamps, and descriptions.' },
      { name: 'Text Tertiary / Muted', token: '--hc-text-tertiary', darkHex: '#8c8a86', lightHex: '#635e56', contrast: '4.7:1 AA', role: 'The dimmest legible text token on the site (12px minimum floor).' },
      { name: 'Text Inverse', token: '--hc-text-inverse', darkHex: '#0f0f10', lightHex: '#fbf9f4', contrast: '15.8:1 AAA', role: 'High-contrast text on solid gold buttons and active accents.' },
      { name: 'Parchment Ink', token: '--hc-fixed-parchment-ink', darkHex: '#1a1715', lightHex: '#1a1715', contrast: '14.0:1 AAA', role: 'Deep manuscript ink used on parchment cards across both themes.' },
    ]
  },
  {
    category: 'Borders & Hairlines',
    subtitle: 'Structural dividers, inset card outlines, and apparatus hairlines.',
    colors: [
      { name: 'Hairline Rule', token: '--hc-rule', darkHex: 'rgba(216,177,102,0.32)', lightHex: 'rgba(111,80,25,0.28)', contrast: 'Structural', role: '1px structural border for cards, panels, and ledger divisions.' },
      { name: 'Rule Soft', token: '--hc-rule-soft', darkHex: 'rgba(242,235,220,0.14)', lightHex: 'rgba(43,40,36,0.12)', contrast: 'Structural', role: 'Subtle interior dividers and quiet metadata item separators.' },
      { name: 'Rule Strong', token: '--hc-rule-strong', darkHex: 'rgba(216,177,102,0.55)', lightHex: 'rgba(111,80,25,0.50)', contrast: 'Structural', role: 'Active hover outlines, primary frames, and emphasized boundaries.' },
    ]
  },
  {
    category: 'Taxonomy & Status (Appendix)',
    subtitle: 'Non-evaluative article categories and semantic application states.',
    colors: [
      { name: 'Taxonomy: History', token: '--cat-history-text', darkHex: '#c99a72', lightHex: '#8a4c27', contrast: '5.6:1 AA', role: 'Category hue for Origins & Early History studies.' },
      { name: 'Taxonomy: Prophecies', token: '--cat-prophecies-text', darkHex: '#c8705f', lightHex: '#8f3316', contrast: '5.1:1 AA', role: 'Category hue for Prophecies & Eschatology studies.' },
      { name: 'Taxonomy: Theology', token: '--cat-theology-text', darkHex: '#7fa389', lightHex: '#255e34', contrast: '5.8:1 AA', role: 'Category hue for Theology & Epistemology studies.' },
      { name: 'Taxonomy: Philosophy', token: '--cat-philosophy-text', darkHex: '#8595b5', lightHex: '#324a73', contrast: '5.4:1 AA', role: 'Category hue for Philosophy & Methodology studies.' },
      { name: 'Status: Success', token: '--hc-success', darkHex: '#81c784', lightHex: '#2e6b2e', contrast: '6.2:1 AA', role: 'Form confirmation and positive status notices.' },
      { name: 'Status: Danger', token: '--hc-danger', darkHex: '#e2907a', lightHex: '#8f3316', contrast: '5.6:1 AA', role: 'Critical warnings and negative argument emphasis.' },
      { name: 'Search Highlight', token: '--hc-highlight', darkHex: 'rgba(216,177,102,0.26)', lightHex: 'rgba(176,126,44,0.18)', contrast: 'Wash', role: 'Search hit highlighting and textual illumination.' },
    ]
  }
];

// ── Typography (11 Core Tokens) ───────────────────────────────────────────
const typographyTokens = [
  {
    token: 'display-hero',
    className: 'hc-title--xl',
    font: 'Poppins',
    spec: 'clamp(2.98rem, 7vw, 5.1rem) · 500 Medium · lh 1.1 · -0.035em',
    sample: 'Critical Evidence.',
    role: 'Primary homepage and flagship portal display headlines.'
  },
  {
    token: 'display-section',
    className: 'hc-title--lg',
    font: 'Poppins',
    spec: 'clamp(2.55rem, 6vw, 4.93rem) · 500 Medium · lh 1.15 · -0.035em',
    sample: 'Historical Transmission',
    role: 'Major archive section and dossier display headers.'
  },
  {
    token: 'display-title-md',
    className: 'hc-title--md',
    font: 'Poppins',
    spec: 'clamp(1.91rem, 4vw, 3.4rem) · 500 Medium · lh 1.2 · -0.035em',
    sample: 'Origins & Early History',
    role: 'Standard collection covers and category title headers.'
  },
  {
    token: 'heading-h2',
    className: 'spec-h2',
    font: 'Poppins',
    spec: 'clamp(1.4rem, 3vw, 1.8rem) · 600 SemiBold · lh 1.3 · -0.02em',
    sample: 'Textual Variants in the Canon',
    role: 'In-page article section headers and analytical dividers.'
  },
  {
    token: 'heading-h3',
    className: 'spec-h3',
    font: 'Poppins',
    spec: '1.18rem · 600 SemiBold · lh 1.35 · -0.015em',
    sample: 'The Common Link Hypothesis',
    role: 'Article subsections and apparatus grouping titles.'
  },
  {
    token: 'body-prose',
    className: 'spec-body',
    font: 'Poppins',
    spec: '1rem (16px) · 400 Regular · lh 1.75 · 68–75ch',
    sample: 'Every attribution is treated as an empirical claim to be investigated rather than an article of faith. We reconstruct earliest transmission paths.',
    role: 'Standard monograph reading prose, treatises, and critical analysis.'
  },
  {
    token: 'body-copy-lead',
    className: 'spec-lead',
    font: 'Poppins',
    spec: '1.08rem · 400 Regular · lh 1.68',
    sample: 'An independent scholarly archive presenting evidence-led studies of hadith literature, early Islamic history, and source criticism.',
    role: 'Article standfirsts, introductory summaries, and abstract text.'
  },
  {
    token: 'body-small',
    className: 'spec-small',
    font: 'Poppins',
    spec: '0.95rem · 400 Regular · lh 1.6',
    sample: 'Citations follow the standard Leiden system with references to primary manuscript catalogues.',
    role: 'Table contents, captions, secondary citations, and footnotes.'
  },
  {
    token: 'ui-eyebrow-label',
    className: 'spec-eyebrow',
    font: 'Glacial Indifference',
    spec: '0.81rem (13px) · 700 Bold · UPPERCASE · +0.14em',
    sample: 'CRITICAL APPARATUS · ISNĀD ANALYSIS · 276,347 NARRATIONS',
    role: 'Strictly apparatus UI: category kickers, table headers, breadcrumbs, and tags.'
  },
  {
    token: 'ui-button',
    className: 'spec-btn-label',
    font: 'Glacial Indifference',
    spec: '15px · 500 Medium · Sentence case · +0.04em',
    sample: 'Explore the Corpus →',
    role: 'Interactive button controls, primary callouts, and search actions.'
  },
  {
    token: 'arabic-quran',
    className: 'spec-quran',
    font: 'Amiri Quran',
    spec: 'clamp(1.27rem, 1.2vw + 1.25rem, 1.57rem) · lh 2.05 · RTL',
    sample: 'قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ ۝٤ ٱلنَّارِ ذَاتِ ٱلْوَقُودِ ۝٥',
    role: 'Authentic Qurʾānic script supporting full waqf and vocalisation marks.'
  }
];

// ── Layout (12 Tokens) ───────────────────────────────────────────────────
const radiiTokens = [
  { name: 'none', token: '0px', value: '0px', usage: 'Hard tables, strict manuscript matrices' },
  { name: 'xs', token: '--radius-xs', value: '2px', usage: 'Buttons, cards, panels: the site default' },
  { name: 'sm', token: '--radius-sm', value: '4px', usage: 'Inputs, small chips, dialogs, book plates' },
  { name: 'pill', token: '--radius-pill', value: '999px', usage: 'Actionable filter chips & status tags only' },
];

const spacingTokens = [
  { name: 'xs', token: '--space-xs', px: '4px', barWidth: '8px' },
  { name: 'sm', token: '--space-sm', px: '8px', barWidth: '16px' },
  { name: 'md', token: '--space-md', px: '12px', barWidth: '24px' },
  { name: 'base', token: '--space-base', px: '16px', barWidth: '36px' },
  { name: 'lg', token: '--space-lg', px: '24px', barWidth: '56px' },
  { name: 'xl', token: '--space-xl', px: '32px', barWidth: '80px' },
  { name: '2xl', token: '--space-2xl', px: '48px', barWidth: '120px' },
  { name: '3xl', token: '--space-3xl', px: '72px', barWidth: '160px' },
];

const layoutSpecs = [
  { label: 'Container Max-Width', token: '--wrap', value: '1240px', desc: 'Standard width for grids, catalogues, and site chrome.' },
  { label: 'Reading Measure', token: '--wrap-reading', value: '780px', desc: '68–75ch optimal typographical measure for reading.' },
  { label: 'Wide Reading Measure', token: '--wrap-wide', value: '940px', desc: 'Expanded scholarly measure for complex tables & facing notes.' },
  { label: 'Editorial Desk Grid', token: '--desk-grid', value: '1480px', desc: 'Full 2-column scholarly apparatus workspace.' },
];



const faqs = [
  {
    q: 'How is the HadithCritic design system specified?',
    a: 'The system is defined in DESIGN.md at the workspace root, sourced directly from CSS variables in src/styles/global.css, article.css, and footer.css. Every token is verified by automated contrast and design audits.'
  },
  {
    q: 'Why is there no authenticity grading color system?',
    a: 'Authenticity scoring (traffic-light green/yellow/red badges) is strictly forbidden across the site. HadithCritic operates on historical-critical methodology: classical evaluations are presented purely as attributed historical source data in neutral ink, never as empirical verdicts.'
  },
  {
    q: 'How does the system ensure WCAG 2.2 AA contrast compliance?',
    a: 'Every color is audited not as a raw token, but against the fully composited background stack (including paper noise, category washes, and radial gradients). The test script scripts/check-contrast.mjs validates all 93 routes in both dark and light modes.'
  },
  {
    q: 'Can this design spec be used directly in Cursor, Claude, or Copilot?',
    a: 'Yes. The DESIGN.md file follows the open Agent Design Schema. You can copy the raw markdown using the button above and supply it to coding agents to replicate exact components, spacing, and typography.'
  }
];
---

<BaseLayout
  title="HadithCritic Design System — Colors 21, Typography 11, Layout 12, Components 21"
  description="HadithCritic's scholarly design system spec. Dark manuscript archive (#0f0f10), antique gold (#d8b166), Poppins, Glacial Indifference, Amiri, 21 colors, 21 components."
>
  <main class="brand-spec-page">
    <div class="wrap">
      
      <!-- ── Breadcrumb & Top Bar ──────────────────────────────────────── -->
      <nav class="spec-breadcrumbs" aria-label="Breadcrumb">
        <a href="/" class="spec-breadcrumb-link">HadithCritic</a>
        <span class="spec-breadcrumb-sep" aria-hidden="true">/</span>
        <span class="spec-breadcrumb-current">Design System</span>
      </nav>

      <!-- ── Hero Spec Header ─────────────────────────────────────────── -->
      <section class="spec-hero">
        <div class="spec-hero__left">
          <div class="spec-eyebrow">DESIGN SYSTEM SPECIFICATION · V2.4</div>
          <h1 class="spec-hero__title">HadithCritic Design System</h1>
          <p class="spec-hero__lede">
            A dark manuscript archive visual system: tinted-black ground, antique gold as the single accent, 
            parchment and umber text tiers, and classical Naskh typography calibrated for rigorous historical-critical inquiry.
          </p>

          <div class="spec-hero__actions">
            <button type="button" class="hc-btn" id="copyDesignMdBtn" data-copy-action="design-md">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span>Copy DESIGN.md Spec</span>
            </button>
            <a href="#explore-system" class="hc-btn hc-btn--ghost">
              <span>Explore The System ↓</span>
            </a>
          </div>

          <!-- 01-05 Key Distinctives (as in shadcn anthropic) -->
          <div class="spec-distinctives">
            <h2 class="spec-distinctives__title">WHAT MAKES IT DISTINCT</h2>
            <ol class="spec-distinctives__list">
              <li>
                <span class="num">01</span>
                <div>
                  <strong>Dark Manuscript Archive Surface</strong>
                  <p>Tinted-black canvas (<code>#0f0f10</code>) over two low-opacity radial glows, paired with a paper grain noise field.</p>
                </div>
              </li>
              <li>
                <span class="num">02</span>
                <div>
                  <strong>Sparing Antique Gold Voltage</strong>
                  <p>Antique Gold (<code>#d8b166</code>) carries hierarchy and active state only; stays under ~5% of any viewport.</p>
                </div>
              </li>
              <li>
                <span class="num">03</span>
                <div>
                  <strong>Rigorous WCAG 2.2 AA Contrast Architecture</strong>
                  <p>Audited against composited backgrounds (4.5:1 body, 3:1 large); zero pure white, zero pitch black.</p>
                </div>
              </li>
              <li>
                <span class="num">04</span>
                <div>
                  <strong>Tri-Scriptural Typographic Hierarchy</strong>
                  <p>Geometric Latin (Poppins) for reading, uppercase apparatus (Glacial) for metadata, and classical Naskh (Amiri) for Arabic.</p>
                </div>
              </li>
              <li>
                <span class="num">05</span>
                <div>
                  <strong>Non-Negotiable Neutral Critical Apparatus</strong>
                  <p>No traffic-light authenticity grades or reliability badges anywhere. Attributed evidence in neutral apparatus ink.</p>
                </div>
              </li>
            </ol>
          </div>
        </div>

        <!-- Quick Spec Side Card (Shadcn Anthropic pattern) -->
        <aside class="spec-hero__side">
          <div class="spec-summary-card">
            <div class="spec-summary-card__swatch">
              <div class="swatch-color" style="background-color: var(--hc-gold);"></div>
              <div class="swatch-meta">
                <span class="swatch-label">PRIMARY ACCENT</span>
                <span class="swatch-code">#d8b166</span>
                <span class="swatch-sub">Antique Gold · 7.8:1 AAA</span>
              </div>
            </div>

            <div class="spec-summary-card__rows">
              <div class="summary-row">
                <span class="row-label">TYPEFACES</span>
                <span class="row-val">Poppins · Glacial · Amiri</span>
              </div>
              <div class="summary-row">
                <span class="row-label">COMPONENTS</span>
                <span class="row-val highlight">21</span>
              </div>
              <div class="summary-row">
                <span class="row-label">COLOR TOKENS</span>
                <span class="row-val highlight">21</span>
              </div>
              <div class="summary-row">
                <span class="row-label">TYPE TOKENS</span>
                <span class="row-val">11</span>
              </div>
              <div class="summary-row">
                <span class="row-label">BASE RADIUS</span>
                <span class="row-val">2px (Crisp)</span>
              </div>
              <div class="summary-row">
                <span class="row-label">WCAG COMPLIANCE</span>
                <span class="row-val">2.2 AA (Audited)</span>
              </div>
            </div>

            <div class="spec-summary-card__jump">
              <span class="jump-title">JUMP TO SECTION</span>
              <div class="jump-links">
                <a href="#explore-system" data-tab-target="colors" class="jump-link">Colors (21) →</a>
                <a href="#explore-system" data-tab-target="typography" class="jump-link">Typography (11) →</a>
                <a href="#explore-system" data-tab-target="layout" class="jump-link">Layout (12) →</a>
                <a href="#explore-system" data-tab-target="components" class="jump-link">Components (21) →</a>
                <a href="#explore-system" data-tab-target="preview" class="jump-link">Live Preview →</a>
              </div>
            </div>
          </div>
        </aside>
      </section>

      <!-- ── Explorer Section with Tabs ───────────────────────────────── -->
      <section id="explore-system" class="spec-explorer">
        <div class="spec-explorer__header">
          <h2 class="spec-explorer__title">Explore HadithCritic</h2>
          <p class="spec-explorer__subtitle">
            Inspect the complete visual system: palette swatches, typography scale, responsive layout, isolated component previews, and live composition.
          </p>

          <!-- Tab Navigation Bar -->
          <div class="spec-tab-bar" role="tablist" aria-label="Design System Explorer Tabs">
            <button type="button" class="spec-tab is-active" role="tab" id="tab-colors" aria-controls="panel-colors" aria-selected="true" data-tab="colors">
              <span>Colors</span>
              <span class="tab-count">21</span>
            </button>
            <button type="button" class="spec-tab" role="tab" id="tab-typography" aria-controls="panel-typography" aria-selected="false" data-tab="typography">
              <span>Typography</span>
              <span class="tab-count">11</span>
            </button>
            <button type="button" class="spec-tab" role="tab" id="tab-layout" aria-controls="panel-layout" aria-selected="false" data-tab="layout">
              <span>Layout</span>
              <span class="tab-count">12</span>
            </button>
            <button type="button" class="spec-tab" role="tab" id="tab-components" aria-controls="panel-components" aria-selected="false" data-tab="components">
              <span>Components</span>
              <span class="tab-count">21</span>
            </button>
            <button type="button" class="spec-tab" role="tab" id="tab-preview" aria-controls="panel-preview" aria-selected="false" data-tab="preview">
              <span>Preview</span>
            </button>
          </div>
        </div>

        <!-- ── TAB 1: COLORS (21) ────────────────────────────────────── -->
        <div class="spec-panel" id="panel-colors" role="tabpanel" aria-labelledby="tab-colors">
          {colorGroups.map((group) => (
            <div class="spec-color-group">
              <div class="group-header">
                <h3 class="group-title">{group.category}</h3>
                <p class="group-subtitle">{group.subtitle}</p>
              </div>

              <div class="swatches-grid">
                {group.colors.map((color) => (
                  <div class="swatch-card" data-token={color.token} data-hex={color.darkHex}>
                    <div 
                      class="swatch-card__color" 
                      style={`background-color: ${color.darkHex};`}
                      aria-label={`${color.name} swatch`}
                    >
                      <button 
                        type="button" 
                        class="swatch-copy-overlay" 
                        data-copy-hex={color.darkHex}
                        title={`Copy ${color.darkHex}`}
                        aria-label={`Copy hex code ${color.darkHex}`}
                      >
                        <span class="copy-text">Copy</span>
                      </button>
                    </div>

                    <div class="swatch-card__details">
                      <div class="swatch-card__head">
                        <span class="swatch-name">{color.name}</span>
                        <span class="swatch-badge">{color.contrast}</span>
                      </div>
                      <code class="swatch-token">{color.token}</code>
                      <div class="swatch-hex-row">
                        <span class="hex-val">Dark: {color.darkHex}</span>
                        {color.lightHex && color.lightHex !== color.darkHex && (
                          <span class="hex-val-light">Light: {color.lightHex}</span>
                        )}
                      </div>
                      <p class="swatch-role">{color.role}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- ── TAB 2: TYPOGRAPHY (11) ─────────────────────────────────── -->
        <div class="spec-panel is-hidden" id="panel-typography" role="tabpanel" aria-labelledby="tab-typography">
          <div class="spec-type-list">
            {typographyTokens.map((type) => (
              <div class="spec-type-row">
                <div class="type-row__meta">
                  <div class="type-row__tag">
                    <span class="token-name">{type.token}</span>
                    <span class="token-font">{type.font}</span>
                  </div>
                  <div class="type-row__spec">{type.spec}</div>
                  <div class="type-row__role">{type.role}</div>
                </div>

                <div class="type-row__preview">
                  <div class={`type-specimen ${type.className}`} dir={type.font === 'Amiri Quran' ? 'rtl' : 'ltr'}>
                    {type.sample}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ── TAB 3: LAYOUT (12) ────────────────────────────────────── -->
