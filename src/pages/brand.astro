    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--hc-text-primary);
  }

  .principle-card p {
    margin: 0.75rem 0 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--hc-text-secondary);
  }

  /* ═══════════════════════════════════════════
     SECTION II: PALETTE GRID
     ═══════════════════════════════════════════ */
  .palette-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .swatch-card {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm, 3px);
    background: var(--hc-surface-2);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .swatch-card:hover {
    border-color: var(--hc-gold);
    transform: translateY(-2px);
  }

  .swatch-card__sample {
    position: relative;
    height: 90px;
    border-bottom: 1px solid var(--hc-rule);
    padding: 0.65rem;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .swatch-card__badge {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    background: rgba(15, 15, 16, 0.82);
    border: 1px solid rgba(216, 177, 102, 0.35);
    border-radius: 2px;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .swatch-card__body {
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.65rem;
  }

  .swatch-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .swatch-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--hc-text-primary);
  }

  .swatch-card code {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-gold);
    background: rgba(216, 177, 102, 0.08);
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
  }

  .swatch-card__values {
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--hc-text-tertiary);
  }

  .swatch-card__values strong {
    color: var(--hc-text-primary);
    font-weight: 600;
  }

  .swatch-card p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--hc-text-secondary);
  }

  /* ═══════════════════════════════════════════
     SECTION III: TOKEN PANELS
     ═══════════════════════════════════════════ */
  .token-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .token-panel {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm, 3px);
    background: var(--hc-surface-1);
    padding: 1.4rem;
  }

  .token-panel__head h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--hc-text-primary);
  }

  .token-panel__head p {
    margin: 0.35rem 0 1.15rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--hc-text-secondary);
    line-height: 1.5;
  }

  .token-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .token-row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.45rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .token-row dt code {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--hc-gold);
    font-weight: 700;
  }

  .token-row dd {
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    flex-wrap: wrap;
  }

  .token-val {
    color: var(--hc-text-primary);
    font-weight: 600;
  }

  .token-role {
    color: var(--hc-text-secondary);
  }

  /* ═══════════════════════════════════════════
     SECTION IV: TYPOGRAPHY SPECIMEN
     ═══════════════════════════════════════════ */
  .type-specimen {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm, 3px);
    background: var(--hc-surface-1);
    overflow: hidden;
  }

  .type-row {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 2rem;
    padding: 1.75rem;
    border-bottom: 1px solid var(--hc-rule);
    align-items: center;
  }

  .type-row:last-child {
    border-bottom: none;
  }

  .type-row__info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .type-row__label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .type-row__info h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--hc-text-primary);
  }

  .type-row__meta {
    display: flex;
    flex-direction: column;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-secondary);
    gap: 0.15rem;
  }

  .type-row__meta strong {
    color: var(--hc-text-primary);
  }

  .type-row__info code {
    align-self: flex-start;
    margin-top: 0.25rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-gold);
    background: rgba(216, 177, 102, 0.08);
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
  }

  .type-row__role {
    margin: 0.35rem 0 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--hc-text-secondary);
  }

  .type-row__preview {
    min-width: 0;
    padding: 1rem 1.25rem;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs, 2px);
  }

  .type-row__sample {
    margin: 0;
    color: var(--hc-text-primary);
  }

  .type-display {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .type-body {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.72;
    max-width: 65ch;
  }

  .type-ui {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--hc-gold);
    line-height: 1.5;
  }

  .type-arabic {
    font-family: var(--font-arabic);
    font-size: 1.65rem;
    line-height: 2.05;
    color: var(--hc-text-primary);
  }

  /* ═══════════════════════════════════════════
     SECTION V: DIMENSIONS GRID
     ═══════════════════════════════════════════ */
  .dimensions-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--hc-rule);
    background: var(--hc-rule);
    border-radius: var(--radius-sm, 3px);
    overflow: hidden;
  }

  .dimension-card {
    padding: 1.4rem;
    background: var(--hc-surface-1);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .dimension-card__token code {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-gold);
    font-weight: 700;
  }

  .dimension-card__val {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    color: var(--hc-text-primary);
    line-height: 1.2;
    margin-top: 0.2rem;
  }

  .dimension-card h3 {
    margin: 0.25rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--hc-text-secondary);
  }

  .dimension-card p {
    margin: 0.25rem 0 0;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--hc-text-tertiary);
  }

  /* ═══════════════════════════════════════════
     SECTION VI: EMBLEM GRID
     ═══════════════════════════════════════════ */
  .logo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr minmax(280px, 0.95fr);
    gap: 1.25rem;
  }

  .logo-panel,
  .logo-rules {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm, 3px);
    padding: 1.75rem;
  }

  .logo-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .logo-panel__canvas {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: 1.25rem;
    border-radius: var(--radius-xs, 2px);
  }

  .logo-panel--dark .logo-panel__canvas {
    background: var(--hc-surface-0);
    border: 1px solid var(--hc-rule-soft);
  }

  .logo-panel--light .logo-panel__canvas {
    background: var(--hc-fixed-parchment);
    border: 1px solid rgba(157, 122, 60, 0.35);
  }

  .logo-panel h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--hc-text-primary);
  }

  .logo-panel p {
    margin: 0.45rem 0 0;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--hc-text-secondary);
  }

  .logo-rules {
    background: var(--hc-surface-1);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .logo-rules h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--hc-gold);
    font-weight: 500;
  }

  .logo-rules > p {
    margin: 0.5rem 0 1.25rem;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--hc-text-secondary);
  }

  .logo-prohibitions {
    padding-top: 1rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .logo-prohibitions h4 {
    margin: 0 0 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-primary);
  }

  .logo-prohibitions ul {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--hc-text-secondary);
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  /* ═══════════════════════════════════════════
     SECTION VII: COMPONENT CARDS
     ═══════════════════════════════════════════ */
  .component-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .demo-card {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm, 3px);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 260px;
  }

  .demo-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .demo-card__kicker {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  .demo-card__badge {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
  }

  /* Demo 1: Parchment */
  .demo-card--parchment {
    background: var(--hc-fixed-parchment);
    color: var(--hc-fixed-parchment-ink);
    border-color: rgba(157, 122, 60, 0.4);
  }

  .demo-card--parchment .demo-card__kicker {
    color: #8c6422;
  }

  .demo-card--parchment .demo-card__badge {
    background: rgba(140, 100, 34, 0.15);
    color: #8c6422;
  }

  .demo-card--parchment .demo-card__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--hc-fixed-parchment-ink);
    line-height: 1.25;
  }

  .demo-card--parchment .demo-card__summary {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.55;
    color: #4a4237;
  }

  .demo-card__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(140, 100, 34, 0.25);
  }

  .demo-card__stats dt {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: #7d6b56;
    text-transform: uppercase;
  }

  .demo-card__stats dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--hc-fixed-parchment-ink);
  }

  /* Demo 2: Umber */
  .demo-card--umber {
    background: linear-gradient(135deg, rgba(164, 106, 63, 0.22), rgba(164, 106, 63, 0.08));
    border-color: rgba(164, 106, 63, 0.45);
  }

  .demo-card--umber .demo-card__kicker {
    color: var(--hc-copper, #c48b68);
  }

  .demo-card--umber .demo-card__text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--hc-text-primary);
  }

  .demo-card--umber .demo-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(164, 106, 63, 0.35);
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .demo-card--umber .demo-card__footer span {
    color: var(--hc-text-tertiary);
    text-transform: uppercase;
  }

  .demo-card--umber .demo-card__footer strong {
    color: var(--hc-copper, #c48b68);
  }

  /* Demo 3: Apparatus */
  .demo-card--apparatus {
    background: var(--hc-surface-1);
  }

  .demo-card--apparatus .demo-card__kicker {
    color: var(--hc-gold);
  }

  .apparatus-nodes {
    list-style: none;
    margin: 0.5rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .apparatus-nodes li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: center;
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .node-idx {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--hc-gold);
  }

  .node-name {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--hc-text-primary);
  }

  .node-tag {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
  }

  .demo-card__meta-bar {
    display: flex;
    justify-content: space-between;
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--hc-rule);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
  }

  .demo-card__meta-bar strong {
    color: var(--hc-gold);
  }

  /* Demo 4: Chips */
  .demo-card--chips {
    background: var(--hc-surface-1);
  }

  .demo-card--chips .demo-card__kicker {
    color: var(--hc-gold);
  }

  .chips-desc {
    margin: 0 0 0.85rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--hc-text-secondary);
  }

  .chips-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .hc-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-pill, 9999px);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--hc-text-secondary);
    background: var(--hc-surface-2);
    transition: all 160ms ease;
  }

  .hc-badge:hover {
    color: var(--hc-gold);
    border-color: var(--hc-gold);
  }

  /* ═══════════════════════════════════════════
     SECTION VIII: CONTENT NON-NEGOTIABLES
     ═══════════════════════════════════════════ */
  .rules-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .rule-card {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm, 3px);
    background: var(--hc-surface-2);
    padding: 1.4rem;
  }

  .rule-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--hc-gold);
    line-height: 1.2;
  }

  .rule-card p {
    margin: 0.65rem 0 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--hc-text-secondary);
  }

  /* ═══════════════════════════════════════════
     SECTION IX: VOICE & ADAB
     ═══════════════════════════════════════════ */
  .voice-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--hc-rule);
    background: var(--hc-rule);
    border-radius: var(--radius-sm, 3px);
    overflow: hidden;
  }

  .voice-card {
    padding: 1.4rem;
    background: var(--hc-surface-1);
  }

  .voice-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--hc-gold);
  }

  .voice-card p {
    margin: 0.5rem 0 0;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--hc-text-secondary);
  }

  /* ═══════════════════════════════════════════
     SECTION X: YOUTUBE THUMBNAIL SYSTEM
     ═══════════════════════════════════════════ */
  .youtube-principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-bottom: 1.5rem;
    border: 1px solid var(--hc-rule);
    background: var(--hc-rule);
    border-radius: var(--radius-sm, 3px);
    overflow: hidden;
  }

  .youtube-principle {
    padding: 1.4rem;
    background: var(--hc-surface-0);
  }

  .youtube-principle__num {
    display: inline-block;
    margin-bottom: 0.85rem;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .youtube-principle h3 {
    margin: 0;
    color: var(--hc-text-primary);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .youtube-principle p {
    margin: 0.55rem 0 0;
    color: var(--hc-text-secondary);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .youtube-showcase {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .youtube-thumb-card {
    overflow: hidden;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm, 3px);
    background: var(--hc-surface-1);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .youtube-thumb-card:hover {
    border-color: var(--hc-gold);
    transform: translateY(-2px);
  }

  .youtube-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 75% 25%, rgba(216, 177, 102, 0.08), transparent 45%),
      linear-gradient(135deg, #0e0e0f 0%, #151413 55%, #1e1b17 100%);
  }

  .youtube-thumb::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(216, 177, 102, 0.22);
    pointer-events: none;
    z-index: 2;
  }

