---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeometricEmblem from '../components/GeometricEmblem.astro';

// Canonical Palette derived directly from DESIGN.md and global.css
const palette = [
  {
    name: 'Surface Ground',
    token: '--hc-surface-0',
    dark: '#0F0F10',
    light: '#FBF9F4',
    contrast: '15.8:1 AAA',
    role: 'Canonical page ground in dark mode; warm paper ground in light mode.'
  },
  {
    name: 'Surface Panel',
    token: '--hc-surface-1',
    dark: '#141312',
    light: '#F2ECE0',
    contrast: '14.2:1 AAA',
    role: 'Primary container surface, navigation bar, and structural modules.'
  },
  {
    name: 'Surface Elevated',
    token: '--hc-surface-2',
    dark: '#1E1D1B',
    light: '#E8E2D5',
    contrast: '12.4:1 AAA',
    role: 'Elevated plates, search bars, toolbars, and active card backgrounds.'
  },
  {
    name: 'Surface Card / Well',
    token: '--hc-surface-3',
    dark: '#26231F',
    light: '#DFD8CB',
    contrast: '10.8:1 AAA',
    role: 'Nested cards, input wells, and hairline boundary backgrounds.'
  },
  {
    name: 'Antique Gold',
    token: '--hc-gold',
    dark: '#D8B166',
    light: '#6F5019',
    contrast: '7.8:1 AAA',
    role: 'Primary active accent, kickers, active states, focus ring, and emblems.'
  },
  {
    name: 'Parchment Cream',
    token: '--hc-fixed-parchment',
    dark: '#F2EBDC',
    light: '#F2EBDC',
    contrast: '13.5:1 AAA',
    role: 'Fixed parchment evidence cards, manuscript quotes, and source sheets.'
  },
  {
    name: 'Umber Bronze',
    token: '--hc-umber',
    dark: '#A46A3F',
    light: '#8A4C27',
    contrast: '4.6:1 AA',
    role: 'Historical context notes, caution banners, and secondary chapter accents.'
  },
  {
    name: 'Text Primary',
    token: '--hc-text-primary',
    dark: '#F2EBDC',
    light: '#2B2824',
    contrast: '14.5:1 AAA',
    role: 'High-contrast headline and running reading text across all views.'
  },
  {
    name: 'Text Secondary',
    token: '--hc-text-secondary',
    dark: '#B8AD99',
    light: '#6B635A',
    contrast: '7.2:1 AAA',
    role: 'Lede text, apparatus subheadings, metadata timestamps, and descriptions.'
  },
  {
    name: 'Text Tertiary',
    token: '--hc-text-tertiary',
    dark: '#8C8A86',
    light: '#635E56',
    contrast: '4.7:1 AA',
    role: 'The dimmest legible text token on the site (12px minimum floor).'
  }
];

const tokenGroups = [
  {
    title: 'Surfaces & Grounds',
    description: 'Four warm-tinted tiers. Never pure black, never sterile white.',
    items: [
      ['--hc-surface-0', '#0F0F10', 'Page background field'],
      ['--hc-surface-1', '#141312', 'Panels, headers, chrome'],
      ['--hc-surface-2', '#1E1D1B', 'Elevated ledger cards'],
      ['--hc-surface-3', '#26231F', 'Input wells, nested cards']
    ]
  },
  {
    title: 'Text Tiers',
    description: 'Calibrated for WCAG 2.2 AA (4.5:1 body, 3:1 large) in both modes.',
    items: [
      ['--hc-text-primary', '#F2EBDC', 'Primary prose and headlines'],
      ['--hc-text-secondary', '#B8AD99', 'Metadata, ledes, and captions'],
      ['--hc-text-tertiary', '#8C8A86', 'Dimmest allowed text (floor)'],
      ['--hc-text-inverse', '#0F0F10', 'Text on gold / accent fills']
    ]
  },
  {
    title: 'Gold Accents',
    description: 'Signals hierarchy and division. Never large-area fill (<5% viewport).',
    items: [
      ['--hc-gold', '#D8B166', 'Active links, emblems, focus rings'],
      ['--hc-gold-bright', '#E8C878', 'Hover states and glow accents'],
      ['--hc-gold-soft', '#E2C783', 'Selection and button gradient stops'],
      ['--hc-gold-dim', '#9D7A3C', 'Quiet metadata accent borders']
    ]
  },
  {
    title: 'Rules & Dividers',
    description: 'Hairlines (1px) separating critical apparatus modules.',
    items: [
      ['--hc-rule', 'rgba(216,177,102,.32)', 'Default gold hairline border'],
      ['--hc-rule-soft', 'rgba(242,235,220,.14)', 'Interior card dividers'],
      ['--hc-rule-strong', 'rgba(216,177,102,.55)', 'Active states and hero frames']
    ]
  }
];

const typography = [
  {
    label: 'Display & Headlines',
    family: 'Poppins',
    weight: '500 Medium',
    casing: 'Sentence case · Never letterspaced',
    token: '--font-display',
    sample: 'Better narrations through better questions.',
    className: 'type-display',
    role: 'Used for page titles, article headlines, section titles, and pull-quote lead-ins.'
  },
  {
    label: 'Scholarly Body Text',
    family: 'Poppins',
    weight: '400 Regular',
    casing: 'Sentence case · 1.72 line-height',
    token: '--font-body',
    sample: 'Long-form textual criticism should feel deliberate, source-critical, and calm.',
    className: 'type-body',
    role: 'Standard reading prose, analysis treatises, historical commentary, and tables.'
  },
  {
    label: 'Apparatus & Metadata UI',
    family: 'Glacial Indifference',
    weight: '600–700 Bold',
    casing: 'UPPERCASE · 0.10–0.14em tracking',
    token: '--font-ui',
    sample: 'ISNĀD · RĀWĪ · MATN · WITNESS · RECENSION · APPARATUS',
    className: 'type-ui',
    role: 'Strictly for apparatus UI: navigation, breadcrumbs, buttons, tabs, and data labels.'
  },
  {
    label: 'Classical Arabic',
    family: 'Amiri',
    weight: '400 Regular',
    casing: '2.05 line-height (--leading-arabic)',
    token: '--font-arabic',
    sample: 'حديث صحيح إذا اتصل سنده وعدل رواته وضبطوا ما رووا.',
    className: 'type-arabic',
    role: 'Full Arabic hadith text, narrator names, chain nodes, and variant matn glosses.'
  }
];

const dimensions = [
  {
    label: 'Maximum Container',
    token: '--wrap',
    value: '1240px',
    desc: 'Outer boundary for grids, tables, and page modules.'
  },
  {
    label: 'Reading Measure',
    token: '--wrap-reading',
    value: '780px',
    desc: 'Optimal 68–75ch measure for long-form critical reading.'
  },
  {
    label: 'Container Padding',
    token: '--pad',
    value: 'clamp(1.2rem, 4vw, 2.5rem)',
    desc: 'Responsive inline gutter (1rem on mobile <=640px).'
  },
  {
    label: 'Section Spacing',
    token: '--section-y',
    value: 'clamp(2.5rem, 5vw, 4.5rem)',
    desc: 'Balanced vertical rhythm between major page sections.'
  },
  {
    label: 'Typography Floor',
    token: 'min-size',
    value: '12px / 0.75rem',
    desc: 'Strict non-negotiable floor; no text may fall below 12px.'
  },
  {
    label: 'Arabic Line Height',
    token: '--leading-arabic',
    value: '2.05',
    desc: 'Generous vertical clearance for ḥarakāt and vowel diacritics.'
  },
  {
    label: 'YouTube Thumbnail',
    token: 'fixed-ratio',
    value: '1280 × 720',
    desc: 'Locked 16:9 composition. Keep the title and primary evidence legible at reduced mobile size.'
  }
];

const northStar = [
  {
    num: '01',
    title: 'Evidence before inheritance',
    copy: 'A report earns authority through verifiable manuscript recensions and stemmatic witnesses, never reputation alone.'
  },
  {
    num: '02',
    title: 'Method before verdict',
    copy: 'Visual components make transmission chains, common links, and variant readings visible rather than preaching a theological grade.'
  },
  {
    num: '03',
    title: 'Critique with adab',
    copy: 'The voice is sober, rigorous, and academic. Confidence emerges from cited apparatuses and primary witnesses, not polemic volume.'
  }
];

const contentRules = [
  {
    rule: 'Zero Traffic-Light Grading',
    desc: 'Never display reliability scores, star ratings, or green/red ṣaḥīḥ/ḍaʿīf badges. Classical jarḥ wa-taʿdīl statements are presented as attributed historical source data in neutral ink.'
  },
  {
    rule: 'Prose Measure 68–75ch',
    desc: 'Reading text never spans wider than 75 characters. Excessively wide columns cause reading fatigue in academic literature.'
  },
  {
    rule: 'Roman Headings Only',
    desc: 'No italic display typography. Emphasis is carried through weight, scale, and antique gold rules rather than slanted type.'
  },
  {
    rule: 'Bilingual Ordering',
    desc: 'English precedes Arabic in the DOM. On screens >=780px, English sits left and Arabic right; on mobile, Arabic renders first.'
  }
];

const voice = [
  ['Precise', 'Name the claim, source, chain, and judgment without ornamental hedging.'],
  ['Readable', 'Use scholarly terms when needed, then explain what they do.'],
  ['Accountable', 'Show where a conclusion comes from, especially when the judgment is strong.'],
  ['Restrained', 'Let evidence carry weight. Avoid spectacle where a footnote is stronger.']
];

const youtubePrinciples = [
  {
    num: '01',
    title: 'Evidence is the hook',
    copy: 'Lead with an archival object, manuscript fragment, map, engraving, or transmission diagram rather than a reaction face or decorative spectacle.'
  },
  {
    num: '02',
    title: 'Typography carries the claim',
    copy: 'Use Poppins for the readable headline, with one restrained antique-gold emphasis. Titles stay short enough to survive YouTube-scale reduction.'
  },
  {
    num: '03',
    title: 'Annotation replaces clickbait',
    copy: 'Use thin editorial rules, circles, marginal labels, and provenance marks as the visual language of criticism. No giant arrows, glow outlines, or meme-style emphasis.'
  }
];

const youtubeFamilies = [
  {
    name: 'History',
    kicker: 'HISTORY · SOURCE CRITICISM',
    title: 'The Baghdad Prophecy',
    accent: 'Prophecy',
    meta: 'MAP · CHRONICLE · TRANSMISSION',
    mode: 'history',
    desc: 'Archival Tigris siege stemma, coordinate grid (656 AH), and contemporary chronicle collation.'
  },
  {
    name: 'Prophecy',
    kicker: 'PROPHECIES · TEXTUAL FULFILLMENT',
    title: 'The Crucifixion',
    accent: 'Crucifixion',
    meta: 'NARRATIVE · PROPHECY · RECEPTION',
    mode: 'prophecy',
    desc: 'Intercalated manuscript folios with variant Quranic readings and classical exegetical stemma.'
  },
  {
    name: 'Theology',
    kicker: 'THEOLOGY · AUTHORITY',
    title: 'The Hadith Argument',
    accent: 'Argument',
    meta: 'SOURCE · AUTHORITY · RECENSION',
    mode: 'theology',
    desc: 'Usūl dialectic apparatus measuring solitary transmission against Quranic sufficiency.'
  },
  {
    name: 'Epistemology',
    kicker: 'EPISTEMOLOGY · TRANSMISSION',
    title: 'Can Hadith Reach Certainty?',
    accent: 'Certainty?',
    meta: 'ISNĀD · WITNESS · METHOD',
    mode: 'epistemology',
    desc: 'Isnād-cum-matn analysis plate tracking common links, partial links, and regional divergence.'
  }
];
---

<BaseLayout
  title="Brand Guidelines & Design System | HadithCritic"
  description="HadithCritic brand architecture, design tokens, typography, dimensions, and critical apparatus standards."
>
  <div class="brand-page">
    <!-- ═══════════════════════════════════════════
         HERO SECTION
         ═══════════════════════════════════════════ -->
    <section class="brand-hero" aria-labelledby="brand-title">
      <div class="brand-frame" aria-hidden="true"></div>
      <div class="hc-container brand-hero__inner">
        <div class="brand-hero__copy">
          <p class="hc-eyebrow">HadithCritic · Design Architecture</p>
          <h1 id="brand-title" class="brand-hero__title">The Critical Apparatus.</h1>
          <p class="brand-hero__lead">
            HadithCritic pairs a dark manuscript archive with antique gold rules, parchment evidence
            surfaces, and an Amiri-based classical Arabic layer to make source criticism rigorous, fair,
            and citable.
          </p>
          <div class="brand-hero__actions">
            <a href="#palette" class="hc-btn">Color Palette</a>
            <a href="#typography" class="hc-btn hc-btn--ghost">Typography Stack</a>
            <a href="#dimensions" class="hc-btn hc-btn--ghost">System Dimensions</a>
            <a href="#youtube" class="hc-btn hc-btn--ghost">YouTube Thumbnail System</a>
          </div>
        </div>

        <aside class="brand-hero__spec" aria-label="Brand snapshot">
          <div class="brand-lockup">
            <div class="brand-lockup__emblem">
              <GeometricEmblem size="56px" />
            </div>
            <div>
              <strong>HadithCritic</strong>
              <span>Digital Research Archive &amp; Critical Edition Press</span>
            </div>
          </div>
          <div class="brand-spec-grid">
            <div class="spec-cell">
              <span class="spec-cell__label">Ground</span>
              <strong class="spec-cell__val">#0F0F10</strong>
            </div>
            <div class="spec-cell">
              <span class="spec-cell__label">Accent</span>
              <strong class="spec-cell__val">#D8B166</strong>
            </div>
            <div class="spec-cell">
              <span class="spec-cell__label">Evidence</span>
              <strong class="spec-cell__val">Parchment</strong>
            </div>
            <div class="spec-cell">
              <span class="spec-cell__label">Standard</span>
              <strong class="spec-cell__val">WCAG AA</strong>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SECTION I: NORTH STAR PRINCIPLES
         ═══════════════════════════════════════════ -->
    <section class="brand-section hc-container" aria-labelledby="north-star-title">
      <header class="brand-section__head">
        <span class="hc-eyebrow">Section I · Foundations</span>
        <h2 id="north-star-title">Editorial North Star</h2>
      </header>

      <div class="brand-principles">
        {northStar.map((item) => (
          <article class="principle-card">
            <span class="principle-card__num">{item.num}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SECTION II: CANONICAL PALETTE
         ═══════════════════════════════════════════ -->
    <section class="brand-section brand-section--band" id="palette" aria-labelledby="palette-title">
      <div class="hc-container">
        <header class="brand-section__head brand-section__head--split">
          <div>
            <span class="hc-eyebrow">Section II · Color System</span>
            <h2 id="palette-title">Canonical Palette</h2>
          </div>
          <p>
            Two calibrated themes: dark archive ground is default; warm parchment is light override.
            Accent footprint remains strictly below 5% of any viewport.
          </p>
        </header>

        <div class="palette-grid">
          {palette.map((color) => (
            <article class="swatch-card">
              <div class="swatch-card__sample" style={`background-color: ${color.dark};`}>
                <span class="swatch-card__badge">{color.contrast}</span>
              </div>
              <div class="swatch-card__body">
                <div class="swatch-card__header">
                  <h3>{color.name}</h3>
                  <code>{color.token}</code>
                </div>
                <div class="swatch-card__values">
                  <span>Dark: <strong>{color.dark}</strong></span>
                  <span>Light: <strong>{color.light}</strong></span>
                </div>
                <p>{color.role}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SECTION III: DESIGN TOKENS
         ═══════════════════════════════════════════ -->
    <section class="brand-section hc-container" aria-labelledby="tokens-title">
      <header class="brand-section__head brand-section__head--split">
        <div>
          <span class="hc-eyebrow">Section III · Architecture</span>
          <h2 id="tokens-title">System Tokens</h2>
        </div>
        <p>
          Public pages consume CSS custom properties via <code>--hc-*</code>. Raw hex values are
          strictly confined to token definitions in <code>global.css</code>.
        </p>
      </header>

      <div class="token-grid">
        {tokenGroups.map((group) => (
          <article class="token-panel">
            <header class="token-panel__head">
              <h3>{group.title}</h3>
              <p>{group.description}</p>
            </header>
            <dl class="token-list">
              {group.items.map(([token, val, role]) => (
                <div class="token-row">
                  <dt><code>{token}</code></dt>
                  <dd>
                    <span class="token-val">{val}</span>
                    <span class="token-role">{role}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SECTION IV: TYPOGRAPHY HIERARCHY
         ═══════════════════════════════════════════ -->
    <section class="brand-section brand-section--band" id="typography" aria-labelledby="type-title">
      <div class="hc-container">
        <header class="brand-section__head brand-section__head--split">
          <div>
            <span class="hc-eyebrow">Section IV · Typography</span>
            <h2 id="type-title">Typographic Stack</h2>
          </div>
          <p>
            The system pairs <strong>Poppins</strong> for reading prose with <strong>Glacial Indifference</strong>
            for uppercase apparatus metadata, and <strong>Amiri</strong> for classical Arabic. Contrast
            relies on case, tracking, weight, and size band rather than arbitrary font switching.
          </p>
        </header>

        <div class="type-specimen">
          {typography.map((item) => (
            <article class="type-row">
              <div class="type-row__info">
                <span class="type-row__label">{item.label}</span>
                <h3>{item.family}</h3>
                <div class="type-row__meta">
                  <span>Weight: <strong>{item.weight}</strong></span>
                  <span>Rule: <strong>{item.casing}</strong></span>
                </div>
                <code>{item.token}</code>
                <p class="type-row__role">{item.role}</p>
              </div>
              <div class="type-row__preview">
                <p
                  class:list={['type-row__sample', item.className]}
                  lang={item.className === 'type-arabic' ? 'ar' : 'en'}
                  dir={item.className === 'type-arabic' ? 'rtl' : 'ltr'}
                >
                  {item.sample}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SECTION V: DIMENSIONS & SCALES
         ═══════════════════════════════════════════ -->
    <section class="brand-section hc-container" id="dimensions" aria-labelledby="dimensions-title">
      <header class="brand-section__head brand-section__head--split">
        <div>
          <span class="hc-eyebrow">Section V · Layout Specs</span>
          <h2 id="dimensions-title">Dimensions &amp; Rhythm</h2>
        </div>
        <p>
          Strict layout limits protect reading comfort. Reading measures never exceed 75ch, and no
          content label falls below the 12px accessibility floor.
        </p>
      </header>

      <div class="dimensions-grid">
        {dimensions.map((dim) => (
          <article class="dimension-card">
            <span class="dimension-card__token"><code>{dim.token}</code></span>
            <strong class="dimension-card__val">{dim.value}</strong>
            <h3>{dim.label}</h3>
            <p>{dim.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SECTION VI: EMBLEM & IDENTITY
         ═══════════════════════════════════════════ -->
    <section class="brand-section brand-section--band" aria-labelledby="logo-title">
      <div class="hc-container">
        <header class="brand-section__head brand-section__head--split">
          <div>
            <span class="hc-eyebrow">Section VI · Visual Identity</span>
            <h2 id="logo-title">Emblem &amp; Clear Space</h2>
          </div>
          <p>
            The HadithCritic mark is an interlocking fractured chain of narration. It functions as
            an authoritative manuscript seal, never as arbitrary page decoration.
          </p>
        </header>

        <div class="logo-grid">
          <article class="logo-panel logo-panel--dark">
            <div class="logo-panel__canvas">
              <GeometricEmblem size="96px" />
            </div>
            <h3>Archive Ground</h3>
            <p>Antique gold on <code>--hc-surface-0</code>. Primary brand treatment.</p>
          </article>

          <article class="logo-panel logo-panel--light">
            <div class="logo-panel__canvas">
              <GeometricEmblem size="96px" />
            </div>
            <h3>Parchment Ground</h3>
            <p>Deep gold on <code>--hc-fixed-parchment</code>. Used on citations &amp; sheets.</p>
          </article>

          <article class="logo-rules">
            <h3>Clear Space Rule</h3>
            <p>
              Maintain clear space equal to at least <strong>30% of the mark height</strong> on all
              four sides. No text, rules, or edges may intrude into this boundary.
            </p>
            <div class="logo-prohibitions">
              <h4>Strict Prohibitions</h4>
              <ul>
                <li>Never rotate or skew the chain nodes.</li>
                <li>Never apply drop shadows or neon glows.</li>
                <li>Never use the emblem as an inline bullet.</li>
                <li>Never alter the hexagonal link geometry.</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SECTION VII: COMPONENT LANGUAGE
         ═══════════════════════════════════════════ -->
    <section class="brand-section hc-container" aria-labelledby="components-title">
      <header class="brand-section__head brand-section__head--split">
        <div>
          <span class="hc-eyebrow">Section VII · Component Architecture</span>
          <h2 id="components-title">Research Components</h2>
        </div>
        <p>
          Components resemble physical philological artifacts: parchment sheets, contextual apparatus
          margins, and structured transmission ledgers.
        </p>
      </header>

      <div class="component-grid">
        <!-- DEMO 1: Parchment Evidence Card -->
        <article class="demo-card demo-card--parchment">
          <div class="demo-card__header">
            <span class="demo-card__kicker">CRITICAL EVIDENCE · RECENSION 04</span>
            <span class="demo-card__badge">ARCHIVAL</span>
          </div>
          <h3 class="demo-card__title">The Earliest Extant Witnesses of the Qunūt Reports</h3>
          <p class="demo-card__summary">
            Synthesizing 4 independent recensions of Musannaf Ibn Abī Shaybah across Medina and Kufa.
          </p>
          <dl class="demo-card__stats">
            <div>
              <dt>Terminus</dt>
              <dd>c. 110 AH</dd>
            </div>
            <div>
              <dt>Witnesses</dt>
              <dd>4 Codices</dd>
            </div>
            <div>
              <dt>Variants</dt>
              <dd>3 Stemma</dd>
            </div>
          </dl>
        </article>

        <!-- DEMO 2: Umber Context Note -->
        <article class="demo-card demo-card--umber">
          <div class="demo-card__header">
            <span class="demo-card__kicker">HISTORICAL TRANSMISSION CONTEXT</span>
          </div>
          <p class="demo-card__text">
            This tradition circulated during the Second Civil War (680–692 CE). Early transmitters
            in Damascus and Kufa preserve divergent matn clauses reflecting early regional legal
            divergence.
          </p>
          <div class="demo-card__footer">
            <span>Apparatus Witness</span>
            <strong>Al-Mizzī, Tahdhīb al-Kamāl, 14/220</strong>
          </div>
        </article>

        <!-- DEMO 3: Isnād Apparatus Plate -->
        <article class="demo-card demo-card--apparatus">
          <div class="demo-card__header">
            <span class="demo-card__kicker">ISNĀD TRANSMISSION NEXUS</span>
          </div>
          <ol class="apparatus-nodes">
            <li>
              <span class="node-idx">01</span>
              <span class="node-name">Mālik b. Anas</span>
              <span class="node-tag">Madinan Common Link</span>
            </li>
            <li>
              <span class="node-idx">02</span>
              <span class="node-name">Nāfiʿ Mawlā Ibn ʿUmar</span>
              <span class="node-tag">Informant Nexus</span>
            </li>
            <li>
