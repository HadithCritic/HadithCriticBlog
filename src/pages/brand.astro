---
import BaseLayout from '../layouts/BaseLayout.astro';
import Emblem from '../components/Emblem.astro';
import GeometricEmblem from '../components/GeometricEmblem.astro';

const palette = [
  {
    name: 'Deep Black',
    value: '#0F0F10',
    token: '--hc-black',
    role: 'Canonical page background, header chrome, deep contrast fields'
  },
  {
    name: 'Warm Charcoal',
    value: '#1E1D1B',
    token: '--hc-charcoal',
    role: 'Raised archive surfaces, panels, apparatus backgrounds'
  },
  {
    name: 'Ash Grey',
    value: '#8C8A86',
    token: '--hc-ash',
    role: 'Muted captions, disabled text, low-priority metadata'
  },
  {
    name: 'Parchment Cream',
    value: '#F2EBDC',
    token: '--hc-parchment',
    role: 'Evidence cards, report sheets, reading surfaces'
  },
  {
    name: 'Antique Gold',
    value: '#D8B166',
    token: '--hc-gold',
    role: 'Primary accent, rules, highlights, emblem treatment'
  },
  {
    name: 'Umber Bronze',
    value: '#A46A3F',
    token: '--hc-umber',
    role: 'Warnings, weak-context notes, chapter banners'
  }
];

const tokenGroups = [
  {
    title: 'Background',
    items: [
      ['--hc-black', 'Main dark page field'],
      ['--hc-black-soft', 'Softened dark surface'],
      ['--hc-charcoal', 'Primary raised panel'],
      ['--hc-charcoal-2', 'Secondary raised panel']
    ]
  },
  {
    title: 'Evidence',
    items: [
      ['--hc-parchment', 'Report and source paper'],
      ['--hc-parchment-deep', 'Aged parchment tint'],
      ['--hc-parchment-ink', 'Ink text on parchment']
    ]
  },
  {
    title: 'Accent',
    items: [
      ['--hc-gold', 'Canonical accent'],
      ['--hc-gold-soft', 'Hover and luminous accent'],
      ['--hc-gold-dim', 'Quiet metadata accent'],
      ['--hc-umber', 'Context and caution surfaces']
    ]
  },
  {
    title: 'Rules',
    items: [
      ['--hc-rule', 'Default hairline'],
      ['--hc-rule-soft', 'Interior divider'],
      ['--hc-rule-strong', 'Active border']
    ]
  }
];

const typography = [
  {
    label: 'Display serif',
    family: 'Cormorant Garamond',
    token: '--font-display',
    sample: 'Better narrations through better questions.',
    className: 'type-display'
  },
  {
    label: 'Reading serif',
    family: 'Source Serif 4',
    token: '--font-body',
    sample: 'Long-form criticism should feel deliberate, sourced, and calm.',
    className: 'type-body'
  },
  {
    label: 'Apparatus UI',
    family: 'IBM Plex Sans',
    token: '--font-ui',
    sample: 'ISNAD  RAWI  MATN  GRADE  NOTE  REF',
    className: 'type-ui'
  },
  {
    label: 'Arabic text',
    family: 'Noto Naskh Arabic',
    token: '--font-arabic',
    sample: 'حديث صحيح إذا اتصل سنده وعدل رواته وضبطوا ما رووا.',
    className: 'type-arabic'
  }
];

const northStar = [
  {
    title: 'Evidence before inheritance',
    copy: 'A report earns trust through traceable evidence, not through reputation alone.'
  },
  {
    title: 'Method before opinion',
    copy: 'Every visual pattern should help readers see source, chain, text, and judgment.'
  },
  {
    title: 'Critique with adab',
    copy: 'The voice is firm and plain, but never noisy. Confidence comes from clarity.'
  }
];

const voice = [
  ['Precise', 'Name the claim, source, chain, and judgment without ornamental hedging.'],
  ['Readable', 'Use scholarly terms when needed, then explain what they do.'],
  ['Accountable', 'Show where a conclusion comes from, especially when the judgment is strong.'],
  ['Restrained', 'Let evidence carry weight. Avoid spectacle where a footnote is stronger.']
];
---

<BaseLayout
  title="Brand Guidelines | HadithCritic"
  description="HadithCritic brand guidelines for palette, typography, logo, components, voice, accessibility, and implementation."
>
  <div class="brand-page">
    <section class="brand-hero" aria-labelledby="brand-title">
      <div class="brand-frame" aria-hidden="true"></div>
      <div class="hc-container brand-hero__inner">
        <div class="brand-hero__copy">
          <p class="hc-eyebrow">HadithCritic · Brand Guidelines</p>
          <h1 id="brand-title" class="brand-hero__title">The critical apparatus.</h1>
          <p class="brand-hero__lead">
            HadithCritic uses a dark scholarly archive, antique gold rules, parchment evidence
            surfaces, umber context notes, and manuscript illustration to make source-level
            criticism feel rigorous, fair, and traceable.
          </p>
          <div class="brand-hero__actions">
            <a href="#palette" class="hc-btn">View palette</a>
            <a href="#implementation" class="hc-btn hc-btn--ghost">Implementation notes</a>
          </div>
        </div>

        <aside class="brand-hero__spec" aria-label="Brand snapshot">
          <div class="brand-lockup">
            <img src="/images/brand/hc-logo-transparent-512.png" alt="" />
            <div>
              <strong>HadithCritic</strong>
              <span>Textual criticism, transmission analysis, and source verification</span>
            </div>
          </div>
          <div class="brand-spec-grid">
            <span>Archive dark</span>
            <span>Antique gold</span>
            <span>Parchment reports</span>
            <span>Umber notes</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="brand-section hc-container" aria-labelledby="north-star-title">
      <header class="brand-section__head">
        <p class="hc-eyebrow">Section I</p>
        <h2 id="north-star-title">North star</h2>
      </header>

      <div class="brand-principles">
        {northStar.map((item) => (
          <article>
            <span aria-hidden="true"></span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="brand-section hc-container" id="palette" aria-labelledby="palette-title">
      <header class="brand-section__head brand-section__head--split">
        <div>
          <p class="hc-eyebrow">Section II</p>
          <h2 id="palette-title">Palette</h2>
        </div>
        <p>
          These six colors are the canonical brand set. Use semantic tokens in components, but keep
          this palette stable across public pages.
        </p>
      </header>

      <div class="palette-grid">
        {palette.map((color) => (
          <article class="swatch-card">
            <div class="swatch-card__sample" style={`--swatch: ${color.value}`}></div>
            <div class="swatch-card__body">
              <h3>{color.name}</h3>
              <p>{color.role}</p>
              <code>{color.token}</code>
              <span>{color.value}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="brand-section brand-section--band" aria-labelledby="tokens-title">
      <div class="hc-container">
        <header class="brand-section__head brand-section__head--split">
          <div>
            <p class="hc-eyebrow">Section III</p>
            <h2 id="tokens-title">Tokens</h2>
          </div>
          <p>
            The public site should speak through `hc-*` variables first. Raw hex values belong in
            documentation and rare artwork, not ordinary UI.
          </p>
        </header>

        <div class="token-grid">
          {tokenGroups.map((group) => (
            <article class="token-panel">
              <h3>{group.title}</h3>
              <dl>
                {group.items.map(([token, role]) => (
                  <>
                    <dt><code>{token}</code></dt>
                    <dd>{role}</dd>
                  </>
                ))}
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="brand-section hc-container" aria-labelledby="type-title">
      <header class="brand-section__head brand-section__head--split">
        <div>
          <p class="hc-eyebrow">Section IV</p>
          <h2 id="type-title">Typography</h2>
        </div>
        <p>
          The system pairs a high-contrast display serif with readable scholarly body text and a
          compact UI family for metadata.
        </p>
      </header>

      <div class="type-specimen">
        {typography.map((item) => (
          <article class="type-row">
            <div>
              <span class="type-row__label">{item.label}</span>
              <h3>{item.family}</h3>
              <code>{item.token}</code>
            </div>
            <p class:list={['type-row__sample', item.className]} lang={item.className === 'type-arabic' ? 'ar' : 'en'} dir={item.className === 'type-arabic' ? 'rtl' : 'ltr'}>
              {item.sample}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="brand-section hc-container" aria-labelledby="logo-title">
      <header class="brand-section__head brand-section__head--split">
        <div>
          <p class="hc-eyebrow">Section V</p>
          <h2 id="logo-title">Logo</h2>
        </div>
        <p>
          The mark is a fractured chain of narration. It should feel like a seal, not a decoration
          pasted over unrelated layouts.
        </p>
      </header>

      <div class="logo-grid">
        <article class="logo-panel logo-panel--dark">
          <img src="/images/brand/hc-logo-transparent-512.png" alt="HadithCritic gold chain emblem" />
          <h3>Gold mark</h3>
          <p>Preferred on dark archive surfaces and manuscript imagery.</p>
        </article>
        <article class="logo-panel logo-panel--light">
          <GeometricEmblem animate="intro" size="112px" />
          <h3>SVG version</h3>
          <p>Use when a scalable vector format is needed.</p>
        </article>
        <article class="logo-rules">
          <h3>Clear space</h3>
          <p>Reserve at least 30% of the mark height around every side.</p>
          <h3>Do not</h3>
          <p>Do not rotate, stretch, recolor arbitrarily, add glow, or use the emblem as a bullet.</p>
        </article>
      </div>
    </section>

    <section class="brand-section brand-section--band" aria-labelledby="components-title">
      <div class="hc-container">
        <header class="brand-section__head brand-section__head--split">
          <div>
            <p class="hc-eyebrow">Section VI</p>
            <h2 id="components-title">Component Language</h2>
          </div>
          <p>
            Components should resemble research artifacts: reports, marginal notes, apparatus
            tables, metadata chips, and chapter dividers.
          </p>
        </header>

        <div class="component-grid">
          <article class="report-card-demo">
            <span>Featured report</span>
            <h3>On the fasting of the Day of Arafah</h3>
            <p>Chapter: Fasting</p>
            <div class="report-grade">
              <strong>Good</strong>
              <b>B+</b>
            </div>
            <dl>
              <div>
                <dt>Analyzed</dt>
                <dd>5</dd>
              </div>
              <div>
                <dt>Supporting texts</dt>
                <dd>7</dd>
              </div>
              <div>
                <dt>Conflicts</dt>
                <dd>2</dd>
              </div>
            </dl>
          </article>

          <article class="context-note-demo">
            <span>Context note</span>
            <p>
              This narration is reported within a factional context. Some transmitters were known
              for partisanship, which may affect reliability.
            </p>
            <div>
              <strong>Judgment impact: Moderate</strong>
              <span aria-hidden="true"></span>
            </div>
          </article>

          <article class="apparatus-demo">
            <h3>Transmission overview</h3>
            <ol>
              <li><span>Malik b. Anas</span><em>Thiqah</em></li>
              <li><span>Nafi</span><em>Thiqah</em></li>
              <li><span>Ibn Umar</span><em>Thiqah</em></li>
              <li><span>The Prophet</span><em>Ma'sum</em></li>
            </ol>
            <div class="apparatus-meta">
              <span>Isnad type <strong>Muttasil</strong></span>
              <span>Grade <strong>Good (B+)</strong></span>
            </div>
          </article>

          <article class="chips-demo">
            <h3>Metadata chips</h3>
            <div>
              {['Sahih', 'Hasan', "Da'if", 'Munkar', 'Matn', 'Isnad', 'Ikhtilaf', 'Tarikh'].map((chip) => (
                <span>{chip}</span>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="brand-section hc-container" aria-labelledby="patterns-title">
      <header class="brand-section__head">
        <p class="hc-eyebrow">Section VII</p>
        <h2 id="patterns-title">Content patterns</h2>
      </header>

      <div class="pattern-list">
        <article>
          <h3>Hero blocks</h3>
          <p>Use manuscript imagery as a first-viewport signal. Do not hide the subject behind abstract gradients.</p>
        </article>
        <article>
          <h3>Reports</h3>
          <p>Put title, source metadata, assessment, and evidence count in one stable surface.</p>
        </article>
        <article>
          <h3>Apparatus</h3>
          <p>Use rows, ruled divisions, numbered transmitters, and small badges for reliability notes.</p>
        </article>
        <article>
          <h3>Warnings</h3>
          <p>Use umber for weak context, factional pressure, translation issues, and source uncertainty.</p>
        </article>
      </div>
    </section>

    <section class="brand-section brand-section--band" aria-labelledby="access-title">
      <div class="hc-container">
        <header class="brand-section__head brand-section__head--split">
          <div>
            <p class="hc-eyebrow">Section VIII</p>
            <h2 id="access-title">Responsive, access, motion</h2>
          </div>
          <p>
            The archive look must not make reading harder. Evidence surfaces need strong contrast,
            reliable focus states, and calm motion.
          </p>
        </header>

        <div class="standards-grid">
          <article>
            <h3>Responsive</h3>
            <p>Large grid sections collapse to one column. Report cards keep stable dimensions and readable internal rhythm.</p>
          </article>
          <article>
            <h3>Accessibility</h3>
            <p>Every interactive element needs visible focus. Essential labels must remain readable on dark and parchment surfaces.</p>
          </article>
          <article>
            <h3>Motion</h3>
            <p>Use small fade-up reveals, subtle border changes, and soft transforms. Honor reduced-motion preferences.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="brand-section hc-container" aria-labelledby="voice-title">
      <header class="brand-section__head brand-section__head--split">
        <div>
          <p class="hc-eyebrow">Section IX</p>
          <h2 id="voice-title">Voice</h2>
        </div>
        <p>HadithCritic should sound like a careful researcher, not a tribunal and not a brochure.</p>
      </header>

      <div class="voice-list">
        {voice.map(([name, copy]) => (
          <article>
            <h3>{name}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="brand-section brand-section--final" id="implementation" aria-labelledby="implementation-title">
      <div class="hc-container implementation-grid">
        <div>
          <p class="hc-eyebrow">Section X</p>
          <h2 id="implementation-title">Implementation</h2>
          <p>
            Source of truth lives in `src/styles/global.css`, shared layout components, and the
            article-specific primitives under `src/components/article`. When documentation and
            shipped UI disagree, trust the shipped code first, then update the brand document.
          </p>
        </div>

        <div class="do-dont-grid">
          <article>
            <h3>Do</h3>
            <ul>
              <li>Use `hc-*` classes and variables for public surfaces.</li>
              <li>Pair display type with readable source text.</li>
              <li>Keep hairline rules at 1px.</li>
              <li>Let Arabic and long quotations breathe.</li>
              <li>Show judgment and evidence together.</li>
            </ul>
          </article>
          <article>
            <h3>Do not</h3>
            <ul>
              <li>Use Bootstrap class names for brand primitives.</li>
              <li>Round editorial surfaces heavily by default.</li>
              <li>Let gold become a full-page wash.</li>
              <li>Use color alone for status or validity.</li>
              <li>Decorate empty space without a research purpose.</li>
            </ul>
          </article>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .brand-page {
    overflow-x: clip;
    background:
      radial-gradient(circle at 78% 12%, rgba(216, 177, 102, 0.08), transparent 32%),
      radial-gradient(circle at 8% 42%, rgba(164, 106, 63, 0.09), transparent 28%),
      linear-gradient(180deg, var(--hc-black) 0%, var(--hc-charcoal) 46%, var(--hc-black) 100%);
  }

  .brand-hero {
    position: relative;
    min-height: clamp(620px, 78vh, 880px);
    display: grid;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--hc-rule);
    background:
      linear-gradient(90deg, rgba(15, 15, 16, 0.98) 0%, rgba(15, 15, 16, 0.93) 38%, rgba(15, 15, 16, 0.38) 72%, rgba(15, 15, 16, 0.1) 100%),
      url('/images/asset1.webp') right center / contain no-repeat;
  }

  .brand-frame {
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(216, 177, 102, 0.18);
    pointer-events: none;
    z-index: 2;
  }

  .brand-frame::before,
  .brand-frame::after {
    content: "";
    position: absolute;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(216, 177, 102, 0.38);
  }

  .brand-frame::before {
    top: -1px;
    left: -1px;
    border-right: 0;
    border-bottom: 0;
  }

  .brand-frame::after {
    right: -1px;
    bottom: -1px;
    border-left: 0;
    border-top: 0;
  }

  .brand-hero__inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.55fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 7rem);
    padding-block: clamp(6rem, 10vw, 9rem) clamp(4rem, 7vw, 6rem);
  }

  .brand-hero__copy {
    max-width: 760px;
    min-width: 0;
  }

  .brand-hero__title,
  .brand-section__head h2,
  .implementation-grid h2 {
    margin: 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.95;
  }

  .brand-hero__title {
    margin-top: 1rem;
    font-size: clamp(4.2rem, 9vw, 8.4rem);
    max-width: 8.5ch;
  }

  .brand-hero__lead {
    max-width: 48ch;
    margin: 1.4rem 0 0;
    color: rgba(242, 235, 220, 0.86);
    font-size: clamp(1.08rem, 0.45vw + 1rem, 1.28rem);
    line-height: 1.72;
    overflow-wrap: break-word;
  }

  .brand-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .brand-hero__spec {
    position: relative;
    min-width: 0;
    border: 1px solid var(--hc-rule);
    background:
      linear-gradient(180deg, rgba(38, 35, 31, 0.84), rgba(15, 15, 16, 0.94));
    box-shadow: var(--shadow);
  }

  .brand-hero__spec::before {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(216, 177, 102, 0.12);
    pointer-events: none;
  }

  .brand-lockup {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 1.35rem;
    border-bottom: 1px solid var(--hc-rule);
  }

  .brand-lockup img {
    width: 92px;
    height: 92px;
    object-fit: contain;
  }

  .brand-lockup strong {
    display: block;
    color: var(--hc-gold);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1;
  }

  .brand-lockup span {
    display: block;
    margin-top: 0.45rem;
    color: var(--hc-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    overflow-wrap: break-word;
  }

  .brand-spec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--hc-rule);
  }

  .brand-spec-grid span {
    min-height: 86px;
    display: grid;
    place-items: center;
    padding: 1rem;
    color: var(--hc-parchment-deep);
    background: rgba(15, 15, 16, 0.82);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-align: center;
    text-transform: uppercase;
  }

  .brand-section {
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .brand-section--band {
    border-block: 1px solid var(--hc-rule);
    background:
      radial-gradient(circle at 86% 10%, rgba(216, 177, 102, 0.06), transparent 30%),
      linear-gradient(180deg, rgba(30, 29, 27, 0.72), rgba(15, 15, 16, 0.82));
  }

  .brand-section--final {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    border-top: 1px solid var(--hc-rule);
    background:
      linear-gradient(90deg, rgba(78, 38, 18, 0.95), rgba(78, 38, 18, 0.65) 42%, rgba(15, 15, 16, 0.84) 82%),
      url('/images/asset2.webp') right center / cover no-repeat;
  }

  .brand-section__head {
    max-width: 840px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .brand-section__head--split {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(240px, 0.6fr) minmax(280px, 0.4fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .brand-section__head h2,
  .implementation-grid h2 {
    margin-top: 0.5rem;
    font-size: clamp(2.7rem, 5vw, 5rem);
  }

  .brand-section__head p:not(.hc-eyebrow),
  .implementation-grid > div > p {
    margin: 0;
    max-width: 58ch;
    color: var(--hc-muted);
    font-size: clamp(1rem, 0.3vw + 0.98rem, 1.13rem);
    line-height: 1.7;
    overflow-wrap: break-word;
  }

  .brand-principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--hc-rule);
    background: var(--hc-rule);
    gap: 1px;
  }

  .brand-principles article {
    min-height: 260px;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.9), rgba(15, 15, 16, 0.95));
  }

  .brand-principles span {
    display: block;
    width: 44px;
    height: 44px;
    border: 1px solid var(--hc-rule-strong);
    transform: rotate(45deg);
    margin-bottom: 1.4rem;
  }

  .brand-principles h3,
  .token-panel h3,
  .logo-grid h3,
  .component-grid h3,
  .pattern-list h3,
  .standards-grid h3,
  .voice-list h3,
  .do-dont-grid h3 {
    margin: 0;
    color: var(--hc-gold);
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.3vw, 2.15rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.02;
  }

  .brand-principles p,
  .logo-grid p,
  .component-grid p,
  .pattern-list p,
  .standards-grid p,
  .voice-list p {
    margin: 0.8rem 0 0;
