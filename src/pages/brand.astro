---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import ArchiveEntry from '../components/ArchiveEntry.astro';
import HadithBlock from '../components/article/sources/HadithBlock.astro';
import QuranVerse from '../components/article/sources/QuranVerse.astro';
import ContextNote from '../components/article/text/ContextNote.astro';
import QuoteBlock from '../components/article/text/QuoteBlock.astro';
import { SITE } from '../lib/seo';
import { toEntries } from '../lib/article-index';
import '../styles/house.css';
import '../styles/blog-index.css';
import '../styles/brand.css';

/* The brand, shown rather than described. Every colour value below is the
   token global.css declares, every contrast ratio is computed here from those
   values, every component is the live one, and every article excerpt is
   quoted exactly from the study it links to. */

/* WCAG 2.2 relative luminance and contrast. */
const channel = (value: number) => {
  const c = value / 255;
  return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
};
const luminance = (hex: string) => {
  const [r, g, b] = (hex.replace('#', '').match(/../g) ?? []).map((part) => channel(parseInt(part, 16)));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contrast = (a: string, b: string) => {
  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};

const BLACK = '#0f0f10';
const PARCHMENT = '#f2ebdc';

const palette = [
  {
    group: 'Grounds',
    note: 'Warm blacks, never pure. Pages alternate between them so a long page reads as movements.',
    swatches: [
      { name: 'Black', token: '--hc-fixed-black', hex: '#0f0f10' },
      { name: 'Soft black', token: '--hc-fixed-black-soft', hex: '#141312' },
      { name: 'Charcoal', token: '--hc-fixed-charcoal', hex: '#1e1d1b' },
      { name: 'Warm charcoal', token: '--hc-fixed-charcoal-2', hex: '#26231f' },
    ],
  },
  {
    group: 'Paper and ink',
    note: 'The leaf a section wants read first, and the ink printed on it.',
    swatches: [
      { name: 'Parchment', token: '--hc-fixed-parchment', hex: '#f2ebdc' },
      { name: 'Deep parchment', token: '--hc-fixed-parchment-deep', hex: '#e5d7bd' },
      { name: 'Ink', token: '--hc-fixed-parchment-ink', hex: '#1a1715' },
    ],
  },
  {
    group: 'Metals',
    note: 'Gold is the one accent on black; bronze is the same accent printed on paper.',
    swatches: [
      { name: 'Antique gold', token: '--hc-gold', hex: '#d8b166' },
      { name: 'Bright gold', token: '--hc-gold-bright', hex: '#e8c878' },
      { name: 'Dim gold', token: '--hc-gold-dim', hex: '#bf9957' },
      { name: 'Bronze', token: '--hc-fixed-bronze', hex: '#6a4c18' },
      { name: 'Umber', token: '--hc-umber', hex: '#a46a3f' },
      { name: 'Copper', token: '--hc-copper', hex: '#c58e6b' },
    ],
  },
];

/* The four article branches. Colour identifies a branch and nothing else:
   the name is always printed beside it, and no colour on the site grades a
   report, a narrator or a reading. */
const branches = [
  { name: 'Origins & Early History', dark: '#d5b091', paper: '#713e20' },
  { name: 'Transmission & Narrators', dark: '#a3afc7', paper: '#414c64' },
  { name: 'Theology & Epistemology', dark: '#9cb8a4', paper: '#39533d' },
  { name: 'Prophecies & Eschatology', dark: '#d7988b', paper: '#7e3727' },
];

const pairs = [
  { label: 'Parchment on black', fg: PARCHMENT, bg: BLACK, use: 'Headings, running text' },
  { label: 'Muted on black', fg: '#b8ad99', bg: BLACK, use: 'Ledes, descriptions' },
  { label: 'Ash on black', fg: '#a7a5a2', bg: BLACK, use: 'Metadata, the dimmest text' },
  { label: 'Gold on black', fg: '#d8b166', bg: BLACK, use: 'Links, labels, accents' },
  { label: 'Dim gold on black', fg: '#bf9957', bg: BLACK, use: 'Folio numerals' },
  { label: 'Ink on parchment', fg: '#1a1715', bg: PARCHMENT, use: 'Text on a leaf' },
  { label: 'Secondary ink on parchment', fg: '#4e4842', bg: PARCHMENT, use: 'Descriptions on a leaf' },
  { label: 'Bronze on parchment', fg: '#6a4c18', bg: PARCHMENT, use: 'Labels and links on a leaf' },
].map((pair) => ({ ...pair, ratio: contrast(pair.fg, pair.bg) }));

const scale = [
  { role: 'Hero display', face: 'Cormorant Garamond 600', size: '4.85rem', sample: 'Tracing the origins', cls: 'bd-scale--hero' },
  { role: 'Section head', face: 'Cormorant Garamond 600', size: '3.1rem', sample: 'From the archive', cls: 'bd-scale--section' },
  { role: 'Study title', face: 'Source Serif 4 600', size: '2.45rem', sample: 'The Scroll and the Sword', cls: 'bd-scale--title' },
  { role: 'Entry title', face: 'Source Serif 4 600', size: '1.34rem', sample: 'Faces Like Hammered Shields', cls: 'bd-scale--entry' },
  { role: 'Reading text', face: 'Source Serif 4 400', size: '1.06rem', sample: 'Every attribution is treated as a claim to be tested.', cls: 'bd-scale--body' },
  { role: 'Label', face: 'IBM Plex Sans 500, tracked capitals', size: '0.78rem', sample: 'Latest investigation', cls: 'bd-scale--label' },
];

const nightPlates = [
  { src: '/images/platform/home-1086.webp', name: 'The city', use: 'Homepage' },
  { src: '/images/platform/corpus-1086.webp', name: 'Seals and archive', use: 'Hadith Corpus' },
  { src: '/images/platform/rijal-1086.webp', name: 'Transmitters at the gate', use: 'Rijāl Register' },
  { src: '/images/platform/qiraat-1086.webp', name: 'The colonnade', use: 'Qirāʾāt Variants' },
  { src: '/images/platform/atlas-1086.webp', name: 'The armillary', use: 'Islamic Studies Atlas' },
  { src: '/images/platform/icma-1086.webp', name: 'The loom', use: 'ICMA Register' },
];

const paperPlates = [
  { src: '/images/blog-editorial/81-hinnom-720.webp', id: 'theology-epistemology/81-the-people-of-the-canyon-in-q85-a-case-for-the-valley-of-hinnom-gehenna' },
  { src: '/images/blog-editorial/77-frontier-720.webp', id: 'prophecies-eschatology/77-faces-like-hammered-shields-the-turks-hadith-clusters' },
  { src: '/images/blog-editorial/78-scroll-sword-720.webp', id: 'transmission-narrators/78-the-scroll-and-the-sword-the-polemical-use-of-alis-authority' },
];

const posts = await getCollection('articles', ({ data }) => (import.meta.env.DEV || !data.draft) && !data.preview);
const entries = toEntries(posts);
const sample = entries[1] ?? entries[0];
const titleOf = (id: string) => posts.find((post) => post.id === id)?.data.title ?? '';

/* Source articles for the excerpts below. */
const AHMAD = 'origins-early-history/13-imam-ahmad-supplicates-through-dead-people';
const BEWITCHED = 'origins-early-history/21-hadith-the-prophet-was-bewitched-by-a-jew';

const kb = (file: string) => {
  try {
    const bytes = fs.statSync(path.resolve(process.cwd(), 'public', file)).size;
    return bytes >= 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;
  } catch {
    return '';
  }
};

const assets = [
  { file: 'images/brand/HCsvg.svg', name: 'The mark, vector', format: 'SVG', size: 'Scalable', note: 'Gold; assembles itself on load' },
  { file: 'images/brand/hc-logo-transparent-512.png', name: 'The mark, transparent', format: 'PNG', size: '512 × 512', note: 'Gold on transparent' },
  { file: 'images/brand/hc-logo-transparent-192.png', name: 'The mark, small', format: 'PNG', size: '192 × 192', note: 'Gold on transparent' },
  { file: 'images/HC.webp', name: 'The mark on black', format: 'WebP', size: '1254 × 1254', note: 'For avatars' },
  { file: 'apple-touch-icon.png', name: 'Touch icon', format: 'PNG', size: '180 × 180', note: 'Home-screen icon' },
  { file: 'images/brand/footer-panorama-v1.webp', name: 'The panorama', format: 'WebP', size: '2172 × 724', note: 'The footer engraving' },
  { file: 'images/YTbanner.png', name: 'Channel banner', format: 'PNG', size: '1672 × 941', note: 'YouTube channel art' },
].map((asset) => ({ ...asset, bytes: kb(asset.file) }));
---

<BaseLayout
  title="Brand | HadithCritic"
  description="The HadithCritic identity: the mark, the typefaces, the palette, the engraved plates, the ornament and the parts the site is built from, with downloadable assets."
>
  <div class="hc-page hc-plate bd-page">
    <!-- Hero: the lockup at full size, over the panorama. -->
    <header class="bd-hero" aria-labelledby="bd-title">
      <img class="bd-hero__panorama" src="/images/brand/footer-panorama-v1.webp" srcset="/images/brand/footer-panorama-v1-1440.webp 1440w, /images/brand/footer-panorama-v1.webp 2172w" sizes="100vw" width="2172" height="724" alt="" fetchpriority="high" />
      <div class="hc-container bd-hero__inner">
        <p class="hc-hero__kicker">Brand</p>
        <div class="bd-lockup">
          <BrandMark size="clamp(7rem, 13vw, 11rem)" class="bd-lockup__mark" />
          <div class="bd-lockup__text">
            <h1 id="bd-title" class="bd-lockup__word">HadithCritic</h1>
            <span class="hc-ornament bd-lockup__rule" aria-hidden="true"></span>
            <p class="bd-lockup__tagline">{SITE.tagline}</p>
          </div>
        </div>
        <p class="hc-hero__lede bd-hero__lede">
          The identity of HadithCritic, set out as it is used: the mark, the four typefaces, the palette,
          the engraved plates, the ornament and the parts every page is built from.
        </p>
        <nav class="bd-contents" aria-label="On this page">
          <ol>
            <li><a href="#mark">Mark</a></li>
            <li><a href="#type">Type</a></li>
            <li><a href="#colour">Colour</a></li>
            <li><a href="#plates">Plates</a></li>
            <li><a href="#ornament">Ornament</a></li>
            <li><a href="#parts">Parts</a></li>
            <li><a href="#articles">Articles</a></li>
            <li><a href="#assets">Assets</a></li>
          </ol>
        </nav>
      </div>
    </header>

    <!-- 1. The mark -->
    <section class="hc-band hc-band--soft bd-section" id="mark" aria-labelledby="mark-title">
      <div class="hc-container">
        <header class="bd-head">
          <span class="bd-head__no">01</span>
          <div>
            <h2 id="mark-title" class="hc-head__title">The <span>mark</span></h2>
            <p class="hc-head__note">
              Three interlocking hexagonal rings: a chain of transmission, link by link. It is drawn
              once and only ever recoloured, never redrawn, outlined or given effects.
            </p>
          </div>
        </header>

        <div class="bd-marks">
          <figure class="bd-tile bd-tile--black">
            <div class="bd-tile__stage"><BrandMark size="9rem" label="HadithCritic mark in gold on black" /></div>
            <figcaption><strong>Primary</strong> Gold on black</figcaption>
          </figure>
          <figure class="bd-tile bd-tile--paper">
            <div class="bd-tile__stage"><BrandMark size="9rem" label="HadithCritic mark in ink on parchment" /></div>
            <figcaption><strong>On paper</strong> Ink on parchment</figcaption>
          </figure>
          <figure class="bd-tile bd-tile--mono">
            <div class="bd-tile__stage"><BrandMark size="9rem" label="HadithCritic mark in parchment on black" /></div>
            <figcaption><strong>One colour</strong> Parchment on black</figcaption>
          </figure>
          <figure class="bd-tile bd-tile--bronze">
            <div class="bd-tile__stage"><BrandMark size="9rem" label="HadithCritic mark in bronze on deep parchment" /></div>
            <figcaption><strong>Printed</strong> Bronze on deep parchment</figcaption>
          </figure>
        </div>

        <div class="bd-mark-detail">
          <figure class="bd-lockups">
            <div class="bd-lockups__row">
              <span class="bd-lockup-h"><BrandMark size="2.4rem" /><span>HadithCritic</span></span>
              <span class="bd-lockups__cap">Horizontal, as in the site header</span>
            </div>
            <div class="bd-lockups__row">
              <span class="bd-lockup-v"><BrandMark size="4.5rem" /><span>HadithCritic</span></span>
              <span class="bd-lockups__cap">Stacked, for square spaces</span>
            </div>
          </figure>
          <figure class="bd-sizes">
            <div class="bd-sizes__row">
              {['4rem', '3rem', '2rem', '1.5rem', '1rem'].map((size) => (
                <span class="bd-sizes__item"><BrandMark size={size} /><span>{`${parseFloat(size) * 16}px`}</span></span>
              ))}
            </div>
            <figcaption>
              Holds its form down to 16px, the favicon. Keep clear space of at least the width of one
              ring on every side, and never set the wordmark without room to breathe beside the mark.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Type -->
    <section class="hc-band bd-section" id="type" aria-labelledby="type-title">
      <div class="hc-container">
        <header class="bd-head">
          <span class="bd-head__no">02</span>
          <div>
            <h2 id="type-title" class="hc-head__title">Four <span>typefaces</span></h2>
            <p class="hc-head__note">One for display, one for reading, one for the apparatus, one for Arabic. Each keeps to its role.</p>
          </div>
        </header>

        <div class="bd-faces">
          <article class="bd-face bd-face--display">
            <p class="bd-face__name">Cormorant Garamond <span>Display · 600 and 700</span></p>
            <p class="bd-face__sample">Tracing the origins of <span>early traditions.</span></p>
            <p class="bd-face__note">Page heroes and section heads only. It thins out below about 26px, so it is never used for text.</p>
          </article>
          <article class="bd-face bd-face--serif">
            <p class="bd-face__name">Source Serif 4 <span>Reading · 400, 600 and italic</span></p>
            <p class="bd-face__sample">The Scroll and the Sword</p>
            <p class="bd-face__text">
              Study titles, entry titles and every paragraph of running text. It carries the scholarly Latin
              diacritics in full: ʿAbd Allāh b. ʿAbbās, Ṣaḥīḥ al-Bukhārī, <em>khabar al-wāḥid</em>.
            </p>
          </article>
          <article class="bd-face bd-face--ui">
            <p class="bd-face__name">IBM Plex Sans <span>Apparatus · 400 to 600</span></p>
            <p class="bd-face__labels"><span>Latest investigation</span><span>Transmission &amp; Narrators</span></p>
            <p class="bd-face__figures">276,347 <span>narrations</span> · 17 Aug 2026 · 25 min read</p>
            <p class="bd-face__note">Labels, metadata, controls and figures. Small, often in tracked capitals, with tabular numerals.</p>
          </article>
          <article class="bd-face bd-face--arabic">
            <p class="bd-face__name">Noto Naskh Arabic <span>Arabic · with Amiri Quran for verses</span></p>
            <p class="bd-face__ar" lang="ar" dir="rtl">الحديث · الرجال · القراءات · التفسير</p>
            <p class="bd-face__note">Arabic is never set in a Latin face. Qurʾānic verses use Amiri Quran, which places the pause marks correctly.</p>
          </article>
        </div>

        <div class="bd-scale" aria-label="Type scale">
          {scale.map((step) => (
            <div class={`bd-scale__row ${step.cls}`}>
              <span class="bd-scale__meta"><strong>{step.role}</strong> {step.face} · {step.size}</span>
              <span class="bd-scale__sample">{step.sample}</span>
            </div>
          ))}
          <p class="bd-scale__floor">Nothing on the site is set below 12px.</p>
        </div>
      </div>
    </section>

    <!-- 3. Colour -->
    <section class="hc-band hc-band--warm bd-section" id="colour" aria-labelledby="colour-title">
      <div class="hc-container">
        <header class="bd-head">
          <span class="bd-head__no">03</span>
          <div>
            <h2 id="colour-title" class="hc-head__title">The <span>palette</span></h2>
            <p class="hc-head__note">Black, parchment and gold, with umber and copper in reserve. Values are the tokens in the stylesheet.</p>
          </div>
        </header>

        {palette.map((group) => (
          <div class="bd-palette">
            <p class="hc-rubric">{group.group} <span>{group.note}</span></p>
            <ul class="bd-swatches">
              {group.swatches.map((swatch) => (
                <li class="bd-swatch">
                  <span class="bd-swatch__chip" style={`background:${swatch.hex}`}></span>
                  <span class="bd-swatch__name">{swatch.name}</span>
                  <code class="bd-swatch__hex">{swatch.hex}</code>
                  <code class="bd-swatch__token">{swatch.token}</code>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="bd-palette">
          <p class="hc-rubric">Branch inks <span>They identify an article branch, always beside its name, and never grade anything</span></p>
          <ul class="bd-branches">
            {branches.map((branch) => (
              <li class="bd-branch" style={`--ink:${branch.dark};--ink-paper:${branch.paper}`}>
                <span class="bd-branch__dark"><span class="bd-branch__mark"></span>{branch.name}</span>
                <span class="bd-branch__paper"><span class="bd-branch__mark"></span>{branch.name}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bd-palette">
          <p class="hc-rubric">Contrast <span>Computed from the tokens; WCAG 2.2 AA asks 4.5:1 for text</span></p>
          <ul class="bd-pairs">
            {pairs.map((pair) => (
              <li class="bd-pair" style={`--fg:${pair.fg};--bg:${pair.bg}`}>
                <span class="bd-pair__sample">Aa</span>
                <span class="bd-pair__label">{pair.label}<span>{pair.use}</span></span>
                <span class="bd-pair__ratio">{pair.ratio.toFixed(1)}:1</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 4. Plates -->
    <section class="hc-band bd-section" id="plates" aria-labelledby="plates-title">
      <div class="hc-container">
        <header class="bd-head">
          <span class="bd-head__no">04</span>
          <div>
            <h2 id="plates-title" class="hc-head__title">Engraved <span>plates</span></h2>
            <p class="hc-head__note">
              The site is illustrated in one language: fine-line engraving in sepia and gold, historical
              in subject, drawn for its page rather than taken from stock.
            </p>
          </div>
        </header>

        <p class="hc-rubric">Night plates <span>Drawn on black for heroes and projects</span></p>
        <ul class="bd-night">
          {nightPlates.map((plate) => (
            <li>
              <figure>
                <img src={plate.src} alt="" width="1086" height="362" loading="lazy" decoding="async" />
                <figcaption><strong>{plate.name}</strong> {plate.use}</figcaption>
              </figure>
            </li>
          ))}
        </ul>

        <div class="bd-setting">
          <figure class="bd-setting__raw">
            <img src="/images/platform/corpus-1086.webp" alt="" width="1086" height="362" loading="lazy" decoding="async" />
            <figcaption>As drawn: a rectangle.</figcaption>
          </figure>
          <figure class="bd-setting__set">
            <img src="/images/platform/corpus-1086.webp" alt="" width="1086" height="362" loading="lazy" decoding="async" />
            <figcaption>As set: masked into the ground on its left and lower edges, so it belongs to the page.</figcaption>
          </figure>
        </div>

        <p class="hc-rubric bd-paper-rubric">Parchment plates <span>Drawn for each study, fading to paper on the left where the title sits</span></p>
        <ul class="bd-paper">
          {paperPlates.map((plate) => (
            <li>
              <figure>
                <img src={plate.src} alt="" width="720" height="480" loading="lazy" decoding="async" />
                <figcaption><a href={`/blogs/${plate.id}/`}>{titleOf(plate.id)}</a></figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Ornament -->
    <section class="hc-band hc-band--soft bd-section" id="ornament" aria-labelledby="ornament-title">
      <div class="hc-container">
        <header class="bd-head">
          <span class="bd-head__no">05</span>
          <div>
            <h2 id="ornament-title" class="hc-head__title">Ornament, <span>sparingly</span></h2>
            <p class="hc-head__note">Hairlines and lozenges, taken from the mark's own geometry. Ornament marks structure; it never decorates empty space.</p>
          </div>
        </header>
        <ul class="bd-ornaments">
          <li>
            <span class="bd-ornaments__stage"><span class="hc-ornament" style="--ornament-width: 14rem; --ornament-ground: var(--hc-fixed-black-soft)" aria-hidden="true"></span></span>
            <strong>The rule</strong><span>A hairline with a lozenge at its centre. Under every hero title.</span>
          </li>
          <li>
            <span class="bd-ornaments__stage"><span class="bd-double" aria-hidden="true"></span></span>
            <strong>The double rule</strong><span>Heads a ledger: the archive, a register, a table.</span>
          </li>
          <li>
            <span class="bd-ornaments__stage"><span class="hc-cat" data-category="Transmission & Narrators">Transmission &amp; Narrators</span></span>
            <strong>The lozenge</strong><span>Marks a branch, a filter, a list item. Filled when active.</span>
          </li>
          <li>
            <span class="bd-ornaments__stage"><span class="bd-folio" aria-hidden="true"><span>No.</span>081</span></span>
            <strong>The folio</strong><span>Every study keeps its number in the archive.</span>
          </li>
          <li>
            <span class="bd-ornaments__stage"><ul class="hc-figures"><li>20,915 transmitters</li><li>33 collections</li></ul></span>
            <strong>The register</strong><span>Figures separated by open lozenges.</span>
          </li>
          <li>
            <span class="bd-ornaments__stage"><span class="bd-leaf hc-parchment" aria-hidden="true"></span></span>
            <strong>The leaf</strong><span>Parchment with an inset double rule: the one item a section wants read first.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- 6. Parts -->
    <section class="hc-band bd-section" id="parts" aria-labelledby="parts-title">
      <div class="hc-container">
        <header class="bd-head">
          <span class="bd-head__no">06</span>
          <div>
            <h2 id="parts-title" class="hc-head__title">The <span>parts</span></h2>
            <p class="hc-head__note">Live components, as the pages use them. Shared parts, composed differently on every page.</p>
          </div>
        </header>

        <div class="bd-parts">
          <figure class="bd-part">
            <div class="bd-part__stage bd-part__stage--row">
              <a href="#parts" class="hc-btn">Primary action</a>
              <a href="#parts" class="hc-btn hc-btn--ghost">Secondary</a>
              <a href="#parts" class="hc-link">Ruled link <span aria-hidden="true">→</span></a>
            </div>
            <figcaption><strong>Actions</strong> A flat gold plate, a ruled ghost, a ruled link. No gradients, no lift, no shine.</figcaption>
          </figure>

          <figure class="bd-part">
            <div class="bd-part__stage">
              <p class="hc-head__title bd-part__head">From the <span>archive</span></p>
              <p class="hc-head__note">Essays and research notes on transmission and scriptural history.</p>
            </div>
