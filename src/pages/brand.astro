<script>
  function initBrandExplorer() {
    // ── Tab Switching ───────────────────────────────────────────────────────
    const tabs = document.querySelectorAll<HTMLButtonElement>('.spec-tab');
    const panels = document.querySelectorAll<HTMLElement>('.spec-panel');

    function switchTab(targetTabId: string) {
      tabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-tab') === targetTabId;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
      });

      panels.forEach((panel) => {
        const matches = panel.id === `panel-${targetTabId}`;
        panel.classList.toggle('is-hidden', !matches);
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        if (target) switchTab(target);
      });
    });

    // Handle Quick Jump links in Side Card
    document.querySelectorAll<HTMLAnchorElement>('[data-tab-target]').forEach((link) => {
      link.addEventListener('click', () => {
        const target = link.getAttribute('data-tab-target');
        if (target) {
          switchTab(target);
          const explorer = document.getElementById('explore-system');
          if (explorer) explorer.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // ── 1-Click Clipboard Copying ───────────────────────────────────────────
    async function copyToClipboard(text: string, labelEl?: HTMLElement | null) {
      try {
        await navigator.clipboard.writeText(text);
        if (labelEl) {
          const original = labelEl.textContent;
          labelEl.textContent = 'Copied!';
          setTimeout(() => {
            labelEl.textContent = original;
          }, 1600);
        }
      } catch (err) {
        console.error('Failed to copy text: ', err);
      }
    }

    // Color Swatch Copy
    document.querySelectorAll<HTMLButtonElement>('[data-copy-hex]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const hex = btn.getAttribute('data-copy-hex');
        const textSpan = btn.querySelector('.copy-text') as HTMLElement | null;
        if (hex) copyToClipboard(hex, textSpan);
      });
    });

    // Copy DESIGN.md button
    const copyMdBtn = document.getElementById('copyDesignMdBtn');
    if (copyMdBtn) {
      copyMdBtn.addEventListener('click', async () => {
        const span = copyMdBtn.querySelector('span');
        const originalText = span ? span.textContent : '';
        const rawEl = document.getElementById('rawDesignMd');
        const content = rawEl?.textContent?.trim() || `# HadithCritic Design System\n\n- Ground: #0F0F10\n- Gold: #D8B166\n- Text: #F2EBDC\n- Fonts: Poppins, Glacial Indifference, Amiri\n- Radius: 2px\n- 21 Components, 21 Colors, 11 Type Tokens.`;
        
        await copyToClipboard(content);
        if (span) span.textContent = 'Copied DESIGN.md!';
        setTimeout(() => {
          if (span) span.textContent = originalText;
        }, 2000);
      });
    }

    // ── Preview Canvas Theme Toggle ─────────────────────────────────────────
    const previewCanvas = document.getElementById('previewCanvas');
    const darkBtn = document.getElementById('previewThemeDark');
    const lightBtn = document.getElementById('previewThemeLight');

    if (previewCanvas && darkBtn && lightBtn) {
      darkBtn.addEventListener('click', () => {
        previewCanvas.setAttribute('data-preview-theme', 'dark');
        darkBtn.classList.add('is-active');
        lightBtn.classList.remove('is-active');
      });

      lightBtn.addEventListener('click', () => {
        previewCanvas.setAttribute('data-preview-theme', 'light');
        lightBtn.classList.add('is-active');
        darkBtn.classList.remove('is-active');
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBrandExplorer);
  } else {
    initBrandExplorer();
  }
  document.addEventListener('astro:page-load', initBrandExplorer);
</script>

