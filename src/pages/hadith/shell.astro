---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { OG } from '../../lib/seo';
import '../../styles/hadith-library.css';
import '../../styles/hadith-reader.css';

/**
 * Critical edition record for one narration.
 *
 * One static fallback shell for corpus records. Al-Shama'il narrations are
 * rendered in 56 chapter HTML pages; individual hadith addresses resolve here.
 */
---

<BaseLayout image={OG.corpus}
  title="Hadith | HadithCritic Critical Edition"
  shell
  description="A primary source narration in Arabic and English from the HadithCritic corpus, with its transmission chain and critical apparatus."
>
  <div class="hl hadith-record-page">
    <div class="hl-wrap hadith-container">
      <div class="record-loading" data-record-loading>
        <span class="record-spinner" aria-hidden="true"></span>
        <p>Reading this narration from the corpus...</p>
      </div>
      <noscript>
        <div class="hadith-degraded">
          <span class="hadith-degraded__badge">JavaScript required</span>
          <h1 class="hadith-degraded__title">Narration</h1>
          <p class="hadith-degraded__text">
            Narrations are read from a static SQLite corpus inside your browser,
            which needs JavaScript. The written research on this site does not.
          </p>
          <div class="hadith-degraded__actions">
            <a class="hl-btn hl-btn--gold" href="/hadith/">Return to the corpus index</a>
          </div>
        </div>
      </noscript>
    </div>
  </div>
</BaseLayout>

<script>
  import { initHadithRecord } from '../../lib/hadith-record';
  initHadithRecord();
</script>
