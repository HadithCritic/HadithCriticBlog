---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { buildMatch, type SearchScope } from '../../lib/arabic-normalize';
import { makeSnippet } from '../../lib/snippet';
import { toPlainText } from '../../lib/format-text';
import { OG } from '../../lib/seo';

/**
 * Hadith corpus catalogue + search.
 *
 * The page has two intentional states:
 *   1. Catalogue: discover the 33 collections as archival records.
 *   2. Search: treat the corpus as a research instrument and foreground the query.
 *
 * All content remains server-rendered, URL-addressable, and usable without JS.
 * The existing query semantics are preserved, including Arabic normalization,
 * optional exact-phrase matching, collection/narrator/subject filters, and BM25
 * relevance ordering.
 *
 * Design-upgrade notes (docs/hallmark-audit-before.md): the pager now carries a
 * method="get" page jump so long result sets stay traversable without
 * JS; the search field, stat band, kickers, and back links use the
 * shared global components (.hc-searchbar, .hc-stat-band, .hc-eyebrow,
 * .hc-back-link) — page-local originals deleted in the same pass, since
 * Astro scoping would otherwise keep them winning. The
 * data-search-mode attribute was removed: nothing consumed it.
 */

const p = Astro.url.searchParams;
const q = (p.get('q') || '').trim();
const scopeParam = (p.get('scope') || 'all') as SearchScope;
const scope: SearchScope = ['all', 'matn', 'arabic', 'english'].includes(scopeParam)
  ? scopeParam
  : 'all';
const phrase = p.get('phrase') === '1';
const bookFilter = parseInt(p.get('book') || '', 10);
const narratorFilter = parseInt(p.get('narrator') || '', 10);
const subjectFilter = (p.get('subject') || '').trim();
const page = Math.max(1, parseInt(p.get('page') || '1', 10) || 1);
const size = 25;
const offset = (page - 1) * size;

const BM25 = 'bm25(hadith_fts, 1.0, 2.0, 1.0, 2.0, 0.5)';

const hasFilter =
  Boolean(q) ||
  (Number.isFinite(bookFilter) && bookFilter > 0) ||
  (Number.isFinite(narratorFilter) && narratorFilter > 0) ||
  Boolean(subjectFilter);

const where: string[] = [];
const binds: unknown[] = [];
let joinFts = false;
let queryError = false;

if (q) {
  try {
    where.push('hadith_fts MATCH ?');
    binds.push(buildMatch(q, scope, phrase));
    joinFts = true;
  } catch {
    queryError = true;
  }
}

if (Number.isFinite(bookFilter) && bookFilter > 0) {
  where.push('h.book_id = ?');
  binds.push(bookFilter);
}

if (Number.isFinite(narratorFilter) && narratorFilter > 0) {
  where.push(
    'EXISTS (SELECT 1 FROM hadith_narrator hn WHERE hn.hadith_id = h.id AND hn.narrator_id = ?)'
  );
  binds.push(narratorFilter);
}

if (subjectFilter) {
  where.push(
    'EXISTS (SELECT 1 FROM hadith_subject hs WHERE hs.hadith_id = h.id AND hs.label_en = ?)'
  );
  binds.push(subjectFilter);
}

const from = joinFts
  ? 'FROM hadith_fts JOIN hadith h ON h.id = hadith_fts.rowid JOIN hadith_book b ON b.id = h.book_id'
  : 'FROM hadith h JOIN hadith_book b ON b.id = h.book_id';
const clause = where.length ? `WHERE ${where.join(' AND ')}` : '';
const order = joinFts ? `${BM25} ASC` : 'h.id ASC';

interface Row {
  id: number;
  hadith_num: string;
  chapter_en: string;
  matn_en: string | null;
  text_en: string;
  text_ar: string;
  matn_ar: string | null;
  parallel_count: number;
  narrator_count: number;
  book_id: number;
  book_en: string;
  book_slug: string;
}

interface Book {
  id: number;
  slug: string;
  title_en: string;
  title_ar: string;
  hadith_count: number;
}

let results: Row[] = [];
let total = 0;
let books: Book[] = [];
let activeNarrator: { id: number; name_en: string } | undefined;
let stats = { narrations: 0, collections: 0, transmitters: 0 };
let failed = false;
let searchFailed = false;

try {
  const res = await env.DB.batch([
    env.DB.prepare(
      'SELECT id, slug, title_en, title_ar, hadith_count FROM hadith_book ORDER BY hadith_count DESC'
    ),
    env.DB.prepare(
      `SELECT (SELECT COUNT(*) FROM hadith) AS narrations,
              (SELECT COUNT(*) FROM hadith_book) AS collections,
              (SELECT COUNT(*) FROM narrator WHERE unnamed = 0) AS transmitters`
    ),
    narratorFilter
      ? env.DB.prepare('SELECT id, name_en FROM narrator WHERE id = ?').bind(narratorFilter)
      : env.DB.prepare('SELECT 0 AS id, NULL AS name_en WHERE 0')
  ]);

  books = (res[0].results || []) as unknown as Book[];
  stats = { ...stats, ...((res[1].results?.[0] as typeof stats) || {}) };
  activeNarrator = (res[2].results || [])[0] as typeof activeNarrator;
} catch (error) {
  console.error('Corpus page failed to load', error);
  failed = true;
}

if (!failed && hasFilter && !queryError) {
  try {
    const res = await env.DB.batch([
      env.DB.prepare(
        `SELECT h.id, h.hadith_num, h.chapter_en, h.matn_en, h.text_en,
                h.parallel_count, h.narrator_count, h.text_ar, h.matn_ar,
                b.id AS book_id, b.title_en AS book_en, b.slug AS book_slug
           ${from} ${clause} ORDER BY ${order} LIMIT ? OFFSET ?`
      ).bind(...binds, size, offset),
      env.DB.prepare(`SELECT COUNT(*) AS n ${from} ${clause}`).bind(...binds)
    ]);

    results = (res[0].results || []) as unknown as Row[];
    total = Number((res[1].results?.[0] as { n?: number } | undefined)?.n ?? 0);
  } catch (error) {
    console.error('Corpus search failed', error);
    searchFailed = true;
  }
}

const pages = Math.max(1, Math.ceil(total / size));
const activeBook = books.find((b) => b.id === bookFilter);
const searchMode = hasFilter;
const resultStart = total > 0 ? offset + 1 : 0;
const resultEnd = total > 0 ? Math.min(offset + results.length, total) : 0;

const pageUrl = (n: number) => {
  const u = new URLSearchParams(Astro.url.search);
  u.set('page', String(n));
  return `/hadith?${u}`;
};

const browseUrl = (slug: string) => `/hadith/collection/${slug}`;

const heroStats = [
  { num: stats.narrations.toLocaleString(), label: 'Narrations' },
  { num: String(stats.collections), label: 'Collections' },
  { num: stats.transmitters.toLocaleString(), label: 'Transmitters' }
];
---

<BaseLayout
  title={searchMode && q ? `“${q}” — Hadith corpus search` : 'Hadith Corpus | HadithCritic'}
  description={
    failed
      ? 'A searchable archive of hadith in Arabic and English. The corpus exposes source text, transmission chains, and collection structure without stored authenticity gradings.'
      : `Search ${stats.narrations.toLocaleString()} narrations from ${stats.collections} collections in Arabic and English. Chains link to the narrator register. No authenticity gradings are stored or shown.`
  }
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Hadith', url: '/hadith' }]}
  image={activeBook ? OG.collection(activeBook.slug) : OG.corpus}
  imageAlt={activeBook ? `${activeBook.title_en} in the HadithCritic corpus` : 'The HadithCritic hadith corpus'}
>
  <div class="corpus-page">
    {failed ? (
      <div class="corpus-failure wrap">
        <p class="hc-eyebrow">Hadith · Corpus</p>
        <h1>The corpus is temporarily unavailable.</h1>
        <p>Please try again shortly.</p>
      </div>
    ) : searchMode ? (
      <header class="corpus-search-hero">
        <div class="wrap corpus-search-hero__inner">
          <div>
            <p class="hc-eyebrow"><a href="/hadith">Corpus</a> / Search</p>
            <h1 class="corpus-search-hero__title">
              {q ? <><span class="corpus-search-hero__prefix">Results for</span> “{q}”</> : 'Filtered corpus results'}
            </h1>
            <p class="corpus-search-hero__summary">
              {queryError
                ? 'That query could not be converted into searchable terms.'
                : searchFailed
                  ? 'The search index is temporarily unavailable; the collection catalogue remains available.'
                  : `${total.toLocaleString()} ${total === 1 ? 'narration' : 'narrations'} match the current search.`}
            </p>
          </div>
          <a class="hc-back-link hc-back-link--ruled" href="/hadith"><span aria-hidden="true">←</span> Back to catalogue</a>
        </div>
      </header>
    ) : (
      <header class="corpus-head">
        <div class="wrap corpus-head__grid">
          <div class="corpus-head__copy">
            <p class="hc-eyebrow">Hadith · Primary text archive</p>
            <h1 class="corpus-title">The Corpus of <span class="corpus-title__accent">Narration.</span></h1>
            <p class="corpus-lead">
              {stats.narrations.toLocaleString()} narrations across {stats.collections} collections,
              searchable in Arabic and English. Chains of transmission link to the narrator register.
              No authenticity grading is stored or shown: the evidence is here, the verdict is yours.
            </p>
          </div>
          <div class="corpus-head__aside">
            <p class="corpus-aside__label">Archive principle</p>
            <p class="corpus-aside__text">
              Read the collections in sequence. Search the evidence across the corpus. Follow the chain into the narrator register.
            </p>
          </div>
        </div>

        <div class="wrap">
          <div class="hc-stat-band hc-stat-band--4" aria-label="Corpus statistics">
            {heroStats.map((s) => (
              <div class="hc-stat">
                <span class="hc-stat__num">{s.num}</span>
                <span class="hc-stat__label">{s.label}</span>
              </div>
            ))}
            <div class="hc-stat hc-stat--display">
              <span class="hc-stat__num">Not stored</span>
              <span class="hc-stat__label">Authenticity gradings</span>
            </div>
          </div>
        </div>
      </header>
    )}

    {!failed && (
      <div class="wrap corpus-main" aria-label={searchMode ? 'Corpus search' : 'Corpus catalogue'}>
        <section class="corpus-search-panel" aria-labelledby="search-heading">
          <div class="hc-section-head">
            <div class="hc-section-head__main">
              <h2 class="hc-section-head__title" id="search-heading">Search the corpus</h2>
            </div>
            {searchMode && (
              <a class="hc-back-link" href="/hadith"><span aria-hidden="true">←</span> Clear search</a>
            )}
          </div>

          <form method="get" action="/hadith">
            <div class="hc-searchbar">
              <label class="sr-only" for="corpus-q">Search the corpus</label>
              <input
                id="corpus-q"
                class="hc-searchbar__input"
                type="search"
                name="q"
                value={q}
                placeholder="عائشة · intention · صلاة الفجر…"
                autocomplete="off"
                spellcheck="false"
              />
              <button type="submit" class="hc-searchbar__submit">Search <span aria-hidden="true">→</span></button>
            </div>

            <div class="hc-searchbar__options">
              <label class="corpus-control">
                <span class="corpus-control__label">Search in</span>
                <select name="scope" aria-label="Search scope">
                  <option value="all" selected={scope === 'all'}>Everything</option>
                  <option value="matn" selected={scope === 'matn'}>Matn only</option>
                  <option value="arabic" selected={scope === 'arabic'}>Arabic</option>
                  <option value="english" selected={scope === 'english'}>English</option>
                </select>
              </label>

              <label class="corpus-control">
                <span class="corpus-control__label">Collection</span>
                <select name="book" aria-label="Collection filter">
                  <option value="">All {stats.collections}</option>
                  {books.map((b) => (
                    <option value={b.id} selected={b.id === bookFilter}>
                      {b.title_en} ({b.hadith_count.toLocaleString()})
                    </option>
                  ))}
                </select>
              </label>

              <label class="hc-searchbar__phrase">
                <input type="checkbox" name="phrase" value="1" checked={phrase} />
                <span>Exact phrase</span>
              </label>
            </div>

            {narratorFilter > 0 && <input type="hidden" name="narrator" value={narratorFilter} />}
            {subjectFilter && <input type="hidden" name="subject" value={subjectFilter} />}
          </form>

          {(activeNarrator || subjectFilter || activeBook) && (
            <div class="corpus-active" aria-label="Active filters">
              <span class="corpus-active__label">Active filters</span>
              {activeBook && <a href={browseUrl(activeBook.slug)} class="corpus-active__item">{activeBook.title_en}</a>}
              {activeNarrator && (
                <a class="corpus-active__item" href={`/narrators/${activeNarrator.id}`}>
                  Transmitter: {activeNarrator.name_en}
                </a>
              )}
              {subjectFilter && <a class="corpus-active__item" href={`/hadith?subject=${encodeURIComponent(subjectFilter)}`}>Subject: {subjectFilter}</a>}
              <a class="corpus-active__clear" href="/hadith">Clear all</a>
            </div>
          )}
        </section>

        {searchMode ? (
          <section class="corpus-results-section" aria-labelledby="results-heading">
            {searchFailed ? (
              <div class="corpus-empty-state">
                <p class="hc-eyebrow">Search unavailable</p>
                <h2 id="results-heading">The search index could not be reached.</h2>
                <p>The collection catalogue is still available below. Please try the search again shortly.</p>
                <a class="hc-back-link" href="/hadith">Return to collections <span aria-hidden="true">→</span></a>
              </div>
            ) : (
              <>
                <div class="hc-section-head">
                  <div class="hc-section-head__main">
                    <p class="hc-eyebrow">Search results</p>
                    <h2 class="hc-section-head__title" id="results-heading">
                      {resultStart > 0 ? `${resultStart.toLocaleString()}–${resultEnd.toLocaleString()}` : 'No matches'}
                    </h2>
                  </div>
                  <p class="hc-section-head__aside">
                    {q && phrase ? 'Exact phrase' : 'Relevance'}
                    {total > 0 ? ` · ${total.toLocaleString()} total` : ''}
                  </p>
                </div>

                {queryError ? (
                  <div class="corpus-empty-state corpus-empty-state--inline">
                    <h3>No searchable terms</h3>
                    <p>Try fewer words, or search for an Arabic or English phrase already present in the corpus.</p>
                  </div>
                ) : results.length === 0 ? (
                  <div class="corpus-empty-state corpus-empty-state--inline">
                    <h3>Nothing matched</h3>
                    <p>Arabic is folded for spelling variation, so عائشة and عايشة find the same records. Try fewer words rather than different ones.</p>
                  </div>
                ) : (
                  <ol class="corpus-results-list">
                    {results.map((r) => (
                      <li class="corpus-result">
                        <a class="corpus-result__link" href={`/hadith/${r.id}`}>
                          <div class="corpus-result__topline">
                            <span class="corpus-result__book">{r.book_en}</span>
                            <span class="corpus-result__ref">{r.hadith_num ? `№ ${r.hadith_num}` : `ID ${r.id}`}</span>
                            <span class="corpus-result__open" aria-hidden="true">→</span>
                          </div>

                          {r.chapter_en && <p class="corpus-result__chapter">{toPlainText(r.chapter_en)}</p>}

                          <div class="corpus-result__cols">
                            <div class="corpus-result__col corpus-result__col--en">
                              <p class="corpus-result__col-label">English</p>
                              <p class="corpus-result__text">
                                <Fragment set:html={makeSnippet(toPlainText(r.matn_en || r.text_en), q, { window: 220 })} />
                              </p>
                            </div>
                            {(r.matn_ar || r.text_ar) && (
                              <div class="corpus-result__col corpus-result__col--ar">
                                <p class="corpus-result__col-label">Arabic</p>
                                <p lang="ar" dir="rtl" class="corpus-result__ar">
                                  <Fragment set:html={makeSnippet(r.matn_ar || r.text_ar, q, { window: 180 })} />
                                </p>
                              </div>
                            )}
                          </div>

                          <p class="corpus-result__meta">
                            <span>{r.narrator_count} transmitters</span>
                            {Number(r.parallel_count) > 0 && (
                              <>
                                <span aria-hidden="true">·</span>
                                <span>{Number(r.parallel_count).toLocaleString()} parallels</span>
                              </>
                            )}
                          </p>
                        </a>
                      </li>
                    ))}
                  </ol>
                )}

                {pages > 1 && !queryError && (
                  <nav class="corpus-pager" aria-label="Search result pages">
                    {page > 1
                      ? <a class="corpus-pager__link" href={pageUrl(page - 1)}>← Previous</a>
                      : <span class="corpus-pager__link corpus-pager__link--disabled">← Previous</span>}
                    <div class="corpus-pager__center">
                      <span class="corpus-pager__position">
                        {resultStart.toLocaleString()}–{resultEnd.toLocaleString()} / {total.toLocaleString()}
                      </span>
                      <form class="corpus-pager__jump" method="get" action="/hadith" aria-label="Go to page">
                        {q && <input type="hidden" name="q" value={q} />}
                        {scope !== 'all' && <input type="hidden" name="scope" value={scope} />}
                        {Number.isFinite(bookFilter) && bookFilter > 0 && <input type="hidden" name="book" value={bookFilter} />}
                        {narratorFilter > 0 && <input type="hidden" name="narrator" value={narratorFilter} />}
                        {subjectFilter && <input type="hidden" name="subject" value={subjectFilter} />}
                        {phrase && <input type="hidden" name="phrase" value="1" />}
                        <label class="sr-only" for="corpus-jump">Go to page</label>
                        <input
                          id="corpus-jump"
                          class="corpus-pager__jump-input"
                          type="number"
                          name="page"
                          min="1"
                          max={pages}
                          value={page}
                          inputmode="numeric"
                        />
                        <span class="corpus-pager__jump-of">/ {pages.toLocaleString()}</span>
                        <button type="submit" class="corpus-pager__jump-btn">Go</button>
                      </form>
                    </div>
                    {page < pages
                      ? <a class="corpus-pager__link" href={pageUrl(page + 1)}>Next →</a>
                      : <span class="corpus-pager__link corpus-pager__link--disabled">Next →</span>}
                  </nav>
                )}
              </>
            )}
          </section>
        ) : (
          <section class="corpus-index" aria-labelledby="collections-heading">
            <div class="hc-section-head hc-section-head--index">
              <div class="hc-section-head__main">
                <h2 class="hc-section-head__title" id="collections-heading">Collections</h2>
                <p class="hc-section-head__note">Ordered by size. Every collection is browsable in full, in its own sequence.</p>
              </div>
              <p class="hc-section-head__aside">{stats.collections} source collections · source sequence preserved</p>
            </div>

            <div class="corpus-ledger" role="table" aria-label="Hadith collections">
              <div class="corpus-ledger__head" role="row">
                <span role="columnheader">Collection</span>
                <span role="columnheader">Narrations</span>
              </div>
              <ol class="corpus-books">
                {books.map((b, i) => (
                  <li class="book-row" role="row">
                    <a class="book-row__link" href={browseUrl(b.slug)} role="cell">
                      <span class="book-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                      <span class="book-info">
                        <span class="book-name">{b.title_en}</span>
                        {b.title_ar && (
                          <span class="book-name-ar" lang="ar" dir="rtl">{b.title_ar}</span>
                        )}
                      </span>
                      <span class="book-count" role="cell">{b.hadith_count.toLocaleString()}</span>
                      <span class="book-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  /* ================================================================
     CORPUS CATALOGUE — Editorial archive / research instrument
     ================================================================ */

  .corpus-page {
    min-height: 100vh;
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background:
      radial-gradient(circle at 75% 0%, rgba(216, 177, 102, 0.075), transparent 34%),
      linear-gradient(180deg, var(--hc-surface-0) 0%, var(--hc-surface-0) 72%, var(--hc-surface-1) 100%);
  }

  .corpus-failure {
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .corpus-failure h1 {
    max-width: 18ch;
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .corpus-failure p:last-child {
    max-width: 52ch;
    margin: 1.25rem 0 0;
    color: var(--hc-text-secondary);
    line-height: 1.75;
  }

  /* ---------- browse hero ---------- */

  .corpus-head {
    padding: clamp(2.75rem, 5vw, 4.25rem) 0 0;
    border-bottom: 1px solid var(--hc-rule);
  }

  .corpus-head__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
    padding-bottom: clamp(3.5rem, 7vw, 5.75rem);
  }

  .corpus-title {
    max-width: 18ch;
    margin: 0.8rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6.4vw, 5rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: var(--hc-text-primary);
    text-wrap: balance;
  }

  .corpus-title__accent {
    color: var(--hc-gold);
  }

  .corpus-lead {
    max-width: 68ch;
    margin: 1.6rem 0 0;
    font-family: var(--font-body);
    font-size: clamp(1.04rem, 0.35vw + 0.98rem, 1.16rem);
    line-height: 1.78;
    color: var(--hc-text-secondary);
  }

  .corpus-head__aside {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hc-rule-strong);
  }

  .corpus-aside__label {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .corpus-aside__text {
    max-width: 34ch;
    margin: 0.7rem 0 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--hc-text-secondary);
  }

  /* ---------- search hero ---------- */

  .corpus-search-hero {
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(2.3rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--hc-rule);
  }

  .corpus-search-hero__inner {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .corpus-search-hero__title {
    max-width: 22ch;
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4.7vw, 4.15rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .corpus-search-hero__prefix {
    color: var(--hc-text-tertiary);
    font-style: normal;
  }

  .corpus-search-hero__summary {
    max-width: 68ch;
    margin: 1rem 0 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--hc-text-secondary);
  }

  /* The back link is now the shared .hc-back-link; only its flex-row
     context is page-specific. The border below it comes from the
