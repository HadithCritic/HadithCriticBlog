---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { OG } from '../../lib/seo';
import EditionIcon from '../../components/EditionIcon.astro';
import { CORPUS_META } from '../../lib/corpus-config';
import { chronologicalCollections, COMPILER_DATES, collectionType } from '../../lib/collection-catalogue';
import '../../styles/corpus-catalogue.css';

/**
 * Hadith corpus discovery and search console.
 *
 * Prerendered. Everything on this page that does not depend on a reader's
 * query is a property of the corpus version (the totals, the thirty-three
 * compilations and their extents) and comes from src/data/corpus-meta.json,
 * generated by scripts/build-corpus-meta.mjs. Nothing here counts anything at
 * request time, and there is no database behind the page at all.
 *
 * Search is answered in the browser against the static corpus by
 * src/lib/hadith-search.ts. The form is a real `method="get"` form, so
 * submitting it produces a shareable URL; the module reads that URL on load,
 * which is what makes a deep link like /hadith?q=عائشة&book=27 work on a
 * refresh and through back and forward.
 */

const books = chronologicalCollections(CORPUS_META.collections);
const coreSlugs = ['sahih-al-bukhari', 'sahih-muslim', 'sunan-ibn-majah', 'sunan-abi-dawud', 'jami-al-tirmidhi', 'sunan-al-nasa-i'];
const coreBooks = books.filter(book => coreSlugs.includes(book.slug));
const featuredBook = coreBooks[0];
const remainingCoreBooks = coreBooks.slice(1);
const coreArtworkDimensions: Record<string, { width: number; height: number }> = {
  'sahih-al-bukhari': { width: 1536, height: 1024 },
  'sahih-muslim': { width: 1600, height: 671 },
  'sunan-ibn-majah': { width: 1600, height: 603 },
  'sunan-abi-dawud': { width: 1600, height: 600 },
  'jami-al-tirmidhi': { width: 1600, height: 600 },
  'sunan-al-nasa-i': { width: 1600, height: 667 },
};
const stats = {
  narrations: CORPUS_META.counts.hadith,
  collections: CORPUS_META.counts.collections,
  transmitters: CORPUS_META.counts.narrators
};

---

<BaseLayout image={OG.corpus}
  title="Hadith Corpus & Textual Archive | HadithCritic"
  description={`Search ${stats.narrations.toLocaleString()} textual records across ${stats.collections} compilations in facing Arabic and English. Transmitters linked to biographical registers with descriptive apparatus.`}
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Hadith Corpus', url: '/hadith/' }]}
>
  <div class="corpus-page">
    <header class="corpus-masthead hc-plate" aria-labelledby="corpus-title">
      <div class="corpus-masthead__art" aria-hidden="true"><img src="/images/hadith/compilation-library-1086.webp" srcset="/images/hadith/compilation-library-1086.webp 1086w, /images/hadith/compilation-library.webp 2172w" sizes="100vw" width="2172" height="724" alt="" fetchpriority="high" /></div>
      <div class="corpus-masthead__inner">
        <p class="hc-eyebrow">Corpus Attestation Archive</p>
        <h1 id="corpus-title">The Hadith<br />Research Corpus</h1>
        <p class="corpus-masthead__arabic" lang="ar" dir="rtl">الحديث</p>
        <p class="corpus-masthead__lead">A searchable critical archive of {stats.narrations.toLocaleString()} narrations across {stats.collections} early and canonical compilations. Transmission chains link directly to the transmitter register with no theological grading apparatus.</p>
      <div class="corpus-masthead__actions">
        <a class="hc-btn" href="#corpus-q">Search the archive</a>
        <a class="hc-btn hc-btn--ghost" href="#collections-heading">Browse the collections</a>
      </div>
      </div>
    </header>

    <div class="wrap corpus-body">
      <section class="corpus-console" aria-label="Textual Search Console">
        <form class="corpus-controls" method="get" action="/hadith/">
          <div class="console-box hc-parchment">
            <div class="console-box__input-row">
              <div class="console-box__search-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </div>
              <input
                id="corpus-q"
                class="hc-searchbar__input console-box__input"
                type="search"
                name="q"
                value=""
                placeholder="Search textual matn, chains, or topics (e.g. عائشة, intention, صلاة الفجر)…"
                autocomplete="off"
                spellcheck="false"
              />
              <label class="sr-only" for="corpus-q">Search the hadith corpus</label>
              <button type="submit" class="hc-searchbar__submit console-box__submit">
                <span>Search Archive</span>
              </button>
            </div>

            <div class="console-box__options">
              <div class="console-param-group">
                <label class="console-param" for="scope-select">
                  <span class="console-param__label">Target Scope:</span>
                  <select id="scope-select" name="scope" class="console-select">
                    <option value="all">Entire Formulation (Matn + Isnād)</option>
                    <option value="matn">Substantive Matn Only</option>
                    <option value="arabic">Arabic Text Only</option>
                    <option value="english">English Translation Only</option>
                  </select>
                </label>

                <label class="console-param" for="book-select">
                  <span class="console-param__label">Source Corpus:</span>
                  <select id="book-select" name="book" class="console-select">
                    <option value="">All {stats.collections} Compilations</option>
                    {books.map((b) => (
                      <option value={b.id}>
                        {b.title_en} ({b.hadith_count.toLocaleString()})
                      </option>
                    ))}
                  </select>
                </label>
              </div>

              <label class="console-checkbox">
                <input type="checkbox" name="phrase" value="1" />
                <span>Exact Phrase</span>
              </label>
            </div>
          </div>

          <!--
            Carried through a submit so a narrator or subject filter survives a
            new query. The search module sets them from the URL on load; they
            start empty because the shell is prerendered and knows no query.
          -->
          <input type="hidden" name="narrator" value="" disabled />
          <input type="hidden" name="subject" value="" disabled />
        </form>

        <!-- Filled by the search module once a query is in play. -->
        <div class="corpus-active-filters" hidden></div>
      </section>

      <!-- Results mount. Empty until the reader asks for something. -->
      <div class="corpus-results-wrap"></div>

      <dl class="corpus-totals" aria-label="Corpus totals">
        <div><EditionIcon name="book" /><dt>Narrations</dt><dd class="hc-project-hero__figure">{stats.narrations.toLocaleString()}</dd></div>
        <div><EditionIcon name="books" /><dt>Compilations</dt><dd>{stats.collections}</dd></div>
        <div><EditionIcon name="record" /><dt>Named transmitters</dt><dd>{stats.transmitters.toLocaleString()}</dd></div>
        <div><EditionIcon name="pages" /><dt>Chain links</dt><dd>{CORPUS_META.counts.chainLinks.toLocaleString()}</dd></div>
      </dl>

      <section class="corpus-core" aria-labelledby="core-heading">
        <div class="corpus-section-head">
          <div><p class="hc-eyebrow">Core collections</p><h2 id="core-heading">Six Foundational Hadith Collections</h2></div>
          <a href="#collections-heading">View all {stats.collections} compilations →</a>
        </div>
        <div class="corpus-core__composition">
          {featuredBook && <a class="corpus-core__feature" href={`/hadith/collection/${featuredBook.slug}/`}>
            <img class="corpus-core__feature-art" src={`/images/hadith/collections/${featuredBook.slug}-800.webp`} srcset={`/images/hadith/collections/${featuredBook.slug}-800.webp 800w, /images/hadith/collections/${featuredBook.slug}.webp ${coreArtworkDimensions[featuredBook.slug].width}w`} sizes="(max-width: 780px) 100vw, 42vw" width={coreArtworkDimensions[featuredBook.slug].width} height={coreArtworkDimensions[featuredBook.slug].height} alt="" loading="lazy" decoding="async" />
            <span class="corpus-core__feature-wash" aria-hidden="true"></span>
            <span class="corpus-core__feature-copy">
              <span class="corpus-core__feature-kicker"><span>01</span> Foundational collection</span>
              <span class="corpus-core__feature-title">{featuredBook.title_en}</span>
              <span class="corpus-core__feature-arabic" lang="ar" dir="rtl">{featuredBook.title_ar}</span>
              <span class="corpus-core__feature-facts"><span><small>Narrations</small>{featuredBook.hadith_count.toLocaleString()}</span></span>
              <span class="corpus-core__feature-link">Explore collection <span aria-hidden="true">→</span></span>
            </span>
          </a>}
          <ol class="corpus-core__secondary">
            {remainingCoreBooks.map((book, i) => <li class:list={[`corpus-core__item`, `corpus-core__item--${book.slug}`, i < 3 && 'corpus-core__item--wide']}>
              <a href={`/hadith/collection/${book.slug}/`}>
                <img src={`/images/hadith/collections/${book.slug}-800.webp`} srcset={`/images/hadith/collections/${book.slug}-800.webp 800w, /images/hadith/collections/${book.slug}.webp ${coreArtworkDimensions[book.slug].width}w`} sizes="(max-width: 780px) 100vw, (max-width: 1200px) 65vw, 46vw" width={coreArtworkDimensions[book.slug].width} height={coreArtworkDimensions[book.slug].height} alt="" loading="lazy" decoding="async" />
                <span class="corpus-core__item-wash" aria-hidden="true"></span>
                <span class="corpus-core__item-number">{String(i + 2).padStart(2, '0')}</span>
                <span class="corpus-core__item-copy"><span class="corpus-core__item-title">{book.title_en}</span><span class="corpus-core__item-arabic" lang="ar" dir="rtl">{book.title_ar}</span><span class="corpus-core__item-facts"><span>Compiler d. {COMPILER_DATES[book.slug]} AH</span><span>{book.hadith_count.toLocaleString()} narrations</span></span></span>
                <span class="corpus-core__item-arrow" aria-hidden="true">→</span>
              </a>
            </li>)}
          </ol>
        </div>
      </section>

      <section class="corpus-index" aria-labelledby="collections-heading" data-corpus-catalogue data-view="grid">
        <div class="corpus-index__header">
          <div>
            <span class="hc-eyebrow">The complete archive</span>
            <h2 class="corpus-index__heading" id="collections-heading">All {stats.collections} Hadith Compilations</h2>
          </div>
          <p class="corpus-index__note">
            Earliest to latest by compiler’s death year (AH), with works by the same compiler grouped together. These dates indicate compiler chronology, not exact dates of composition.
          </p>
        </div>
        <div class="corpus-catalogue__views" data-catalogue-controls hidden>
          <span data-catalogue-status aria-live="polite">{stats.collections} compilations</span>
          <button type="button" data-catalogue-view="grid" aria-pressed="true"><EditionIcon name="grid" />Grid view</button>
          <button type="button" data-catalogue-view="list" aria-pressed="false"><EditionIcon name="list" />List view</button>
        </div>
        <div class="corpus-catalogue__layout">
          <aside class="corpus-catalogue__filters hc-parchment" aria-label="Filter compilations" data-catalogue-controls hidden>
            <h3>Filter collections</h3>
            <label for="catalogue-query">Find a collection<input id="catalogue-query" type="search" data-catalogue-query placeholder="English or Arabic title" /></label>
            <label for="catalogue-period">Compiler period<select id="catalogue-period" data-catalogue-period><option value="">All periods</option><option value="early">Before 300 AH</option><option value="middle">300–499 AH</option><option value="later">500 AH onward</option></select></label>
            <label for="catalogue-type">Collection type<select id="catalogue-type" data-catalogue-type><option value="">All types</option>{['Sahih', 'Sunan', 'Musnad', 'Musannaf', 'Muʿjam', 'Other'].map(type => <option value={type}>{type}</option>)}</select></label>
            <label for="catalogue-sort">Sort by<select id="catalogue-sort" data-catalogue-sort><option value="earliest">Earliest first (default)</option><option value="latest">Latest first</option><option value="size">Most narrations</option><option value="title">Title A–Z</option></select></label>
            <button type="button" data-catalogue-reset>Reset filters</button>
          </aside>
          <div class="corpus-catalogue__results">
        <ol class="catalog-ledger">
          {books.map((b, i) => (
            <li class="catalog-row" data-year={COMPILER_DATES[b.slug]} data-type={collectionType(b.slug)} data-title={`${b.title_en} ${b.title_ar}`} data-count={b.hadith_count} data-order={i}>
              <a class="catalog-row__link" href={`/hadith/collection/${b.slug}/`}>
                <span class="catalog-row__no">{String(i + 1).padStart(2, '0')}</span>
                <span class="catalog-row__titles">
                  <span class="catalog-row__en">{b.title_en}</span>
                  {b.title_ar && <span class="catalog-row__ar" lang="ar" dir="rtl">{b.title_ar}</span>}
                  <span class="catalog-row__date">Compiler d. {COMPILER_DATES[b.slug]} AH</span>
                </span>
                <span class="catalog-row__count">{b.hadith_count.toLocaleString()} <span>narrations</span></span>
                <span class="catalog-row__arrow" aria-hidden="true">›</span>
              </a>
            </li>
          ))}
        </ol>
          <p class="corpus-catalogue__empty" data-catalogue-empty hidden>No compilations match these filters. Try another title or reset the filters.</p>
          </div>
        </div>
      </section>

      <!--
        Provenance. The corpus is a versioned, immutable artifact rather than
        a live database, so a citation of a record is a citation of a build;
        saying which one is the difference between a reproducible reference
        and one that quietly stops matching.
      -->
      <p class="corpus-provenance">
        <span class="corpus-provenance__label">Corpus build</span>
        <span class="corpus-provenance__version">{CORPUS_META.corpusVersion}</span>
        <span class="corpus-provenance__figures">
          {stats.narrations.toLocaleString()} narrations · {stats.transmitters.toLocaleString()} transmitters
          · {stats.collections} collections
        </span>
      </p>

      <noscript>
        <p class="corpus-notice corpus-notice--warn">
          Full-text search runs against a static SQLite corpus inside your
          browser, so it needs JavaScript. The catalogue above, and every
          article on this site, work without it.
        </p>
      </noscript>
    </div>
  </div>

  <script>
    import { initHadithSearch } from '../../lib/hadith-search';
    import { initCorpusCatalogue } from '../../lib/corpus-catalogue';
    initCorpusCatalogue();
    initHadithSearch();
  </script>
</BaseLayout>



<!-- Global styles for client-side search hydration -->
<style is:global>
  /* Rendered by src/lib/hadith-search.ts after the corpus answers, so these
     cannot be scoped: a node created by script never carries the page's
     data-astro-cid attribute and a scoped rule would not reach it. */
  .corpus-active-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0.5rem 0;
  }

  .corpus-active-filters__label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .corpus-active-filters__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-secondary);
  }

  .filter-chip__key {
    color: var(--hc-text-tertiary);
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .filter-chip__val {
    color: var(--hc-gold);
  }

  .filter-chip__link {
    color: var(--hc-gold);
    text-decoration: none;
  }

  .filter-chip-clear {
    margin-left: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--hc-gold);
    text-decoration: none;
  }

  .filter-chip-clear:hover {
    text-decoration: underline;
  }

  /* ── Notices ───────────────────────────────────────────────── */
  .corpus-notice {
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
    border-radius: var(--radius-xs);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .corpus-notice--error {
    border: 1px solid rgba(220, 38, 38, 0.4);
    background: color-mix(in srgb, red 8%, var(--hc-surface-1));
    color: var(--hc-text-secondary);
  }

  .corpus-notice--warn {
    border: 1px solid var(--hc-rule-strong);
    background: var(--hc-surface-1);
    color: var(--hc-text-secondary);
  }

  .corpus-toolbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .corpus-status {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  .corpus-status__count {
    font-weight: 600;
    color: var(--hc-text-primary);
  }

  .corpus-status__context {
    margin-left: 0.45rem;
    color: var(--hc-text-tertiary);
  }

  .corpus-ranking-note {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .corpus-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .corpus-record-card {
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    transition: background var(--motion-fast) ease, border-color var(--motion-fast) ease, box-shadow var(--motion-fast) ease;
  }

  .corpus-record-card:hover {
    background: var(--hc-surface-2);
    border-color: var(--hc-gold-dim);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .corpus-record-card__hitarea {
    display: block;
    padding: 1.5rem 1.75rem;
    text-decoration: none;
    color: inherit;
  }

  .corpus-record-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .corpus-record-card__breadcrumbs {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .corpus-record-card__book {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .corpus-record-card__num {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-tertiary);
  }

  .corpus-record-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--hc-gold-dim);
    transition: color var(--motion-fast) ease, gap var(--motion-fast) ease;
  }

  .corpus-record-card:hover .corpus-record-card__action {
    color: var(--hc-gold);
    gap: 0.55rem;
  }

  .corpus-record-card__chapter {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--hc-text-primary);
  }

  .corpus-record-card__spread {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.2rem);
  }

  .corpus-record-card__col {
    min-width: 0;
  }

  .corpus-record-card__snippet-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .corpus-badge-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .corpus-badge-indicator--en {
    background: var(--hc-text-tertiary);
  }

  .corpus-badge-indicator--ar {
    background: var(--hc-gold);
  }

  .corpus-record-card__text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--hc-text-secondary);
  }

  .corpus-record-card__ar {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: 1.25rem;
    line-height: 2.1;
    color: var(--hc-text-primary);
    direction: rtl;
    text-align: right;
  }

  .corpus-record-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.2rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .corpus-record-card__pills {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .corpus-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.22rem 0.55rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 2px;
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .corpus-pill__label {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--hc-text-tertiary);
  }

  .corpus-pill__num {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-secondary);
  }

  .corpus-record-card__id-meta {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-tertiary);
  }

  .corpus-empty-card {
    padding: 4.5rem 2rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    text-align: center;
  }

  .corpus-empty-card__icon {
    font-size: 2.5rem;
    color: var(--hc-gold-dim);
    margin-bottom: 0.75rem;
  }

  .corpus-empty-card__title {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--hc-text-primary);
  }

