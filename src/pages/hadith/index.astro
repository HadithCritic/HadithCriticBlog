---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { OG } from '../../lib/seo';
import ResearchHero from "../../components/ResearchHero.astro";
import { CORPUS_META } from '../../lib/corpus-config';

/**
 * Hadith corpus discovery and search console.
 *
 * Prerendered. Everything on this page that does not depend on a reader's
 * query is a property of the corpus version (the totals, the thirty-three
 * compilations and their extents) and comes from src/data/corpus-meta.json,
 * generated by scripts/build-corpus-meta.mjs. Nothing here counts anything at
 * request time, and there is no database behind the page at all.
 *
 * Search is answered in the browser against the static corpus by
 * src/lib/hadith-search.ts. The form is a real `method="get"` form, so
 * submitting it produces a shareable URL; the module reads that URL on load,
 * which is what makes a deep link like /hadith?q=عائشة&book=27 work on a
 * refresh and through back and forward.
 */

const books = CORPUS_META.collections;
/* The largest collection sets the scale of every bar in the catalogue. */
const largest = Math.max(...books.map((b) => b.hadith_count));
const stats = {
  narrations: CORPUS_META.counts.hadith,
  collections: CORPUS_META.counts.collections,
  transmitters: CORPUS_META.counts.narrators
};

---

<BaseLayout image={OG.corpus}
  title="Hadith Corpus & Textual Archive | HadithCritic"
  description={`Search ${stats.narrations.toLocaleString()} textual records across ${stats.collections} compilations in facing Arabic and English. Transmitters linked to biographical registers with descriptive apparatus.`}
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Hadith Corpus', url: '/hadith/' }]}
>
  <div class="corpus-page rp-page rp-corpus">
    <ResearchHero artwork="corpus" variant="corpus" title="The Hadith Research Corpus" titleId="corpus-title" kicker="Corpus Attestation Archive" arabic="الحديث">
      <p>A searchable critical archive of {stats.narrations.toLocaleString()} narrations across {stats.collections} early and canonical compilations. Transmission chains link directly to the transmitter register with no theological grading apparatus.</p>
      <div slot="actions">
        <a class="hc-btn" href="#corpus-q">Search the archive</a>
        <a class="hc-btn hc-btn--ghost" href="#collections-heading">Browse the collections</a>
      </div>
      <dl slot="signature" class="rp-card hc-parchment" aria-label="Corpus catalogue card">
        <div class="rp-card__head"><dt>Catalogue card</dt><dd>Build {CORPUS_META.corpusVersion}</dd></div>
        <div class="rp-card__lead"><dt>Narrations</dt><dd class="hc-project-hero__figure">{stats.narrations.toLocaleString()}</dd></div>
        <div><dt>Compilations</dt><dd>{stats.collections}</dd></div>
        <div><dt>Named transmitters</dt><dd>{stats.transmitters.toLocaleString()}</dd></div>
        <div><dt>Chain links</dt><dd>{CORPUS_META.counts.chainLinks.toLocaleString()}</dd></div>
      </dl>
    </ResearchHero>

    <div class="wrap corpus-body">
      <section class="corpus-console" aria-label="Textual Search Console">
        <form class="corpus-controls" method="get" action="/hadith/">
          <div class="console-box">
            <div class="console-box__input-row">
              <div class="console-box__search-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </div>
              <input
                id="corpus-q"
                class="hc-searchbar__input console-box__input"
                type="search"
                name="q"
                value=""
                placeholder="Search textual matn, chains, or topics (e.g. عائشة, intention, صلاة الفجر)…"
                autocomplete="off"
                spellcheck="false"
              />
              <label class="sr-only" for="corpus-q">Search the hadith corpus</label>
              <button type="submit" class="hc-searchbar__submit console-box__submit">
                <span>Search Archive</span>
              </button>
            </div>

            <div class="console-box__options">
              <div class="console-param-group">
                <label class="console-param" for="scope-select">
                  <span class="console-param__label">Target Scope:</span>
                  <select id="scope-select" name="scope" class="console-select">
                    <option value="all">Entire Formulation (Matn + Isnād)</option>
                    <option value="matn">Substantive Matn Only</option>
                    <option value="arabic">Arabic Text Only</option>
                    <option value="english">English Translation Only</option>
                  </select>
                </label>

                <label class="console-param" for="book-select">
                  <span class="console-param__label">Source Corpus:</span>
                  <select id="book-select" name="book" class="console-select">
                    <option value="">All {stats.collections} Compilations</option>
                    {books.map((b) => (
                      <option value={b.id}>
                        {b.title_en} ({b.hadith_count.toLocaleString()})
                      </option>
                    ))}
                  </select>
                </label>
              </div>

              <label class="console-checkbox">
                <input type="checkbox" name="phrase" value="1" />
                <span>Exact Phrase</span>
              </label>
            </div>
          </div>

          <!--
            Carried through a submit so a narrator or subject filter survives a
            new query. The search module sets them from the URL on load; they
            start empty because the shell is prerendered and knows no query.
          -->
          <input type="hidden" name="narrator" value="" disabled />
          <input type="hidden" name="subject" value="" disabled />
        </form>

        <!-- Filled by the search module once a query is in play. -->
        <div class="corpus-active-filters" hidden></div>
      </section>

      <!-- Results mount. Empty until the reader asks for something. -->
      <div class="corpus-results-wrap"></div>

      <section class="corpus-index" aria-labelledby="collections-heading">
        <div class="corpus-index__header">
          <div>
            <span class="hc-eyebrow">Archival Catalog</span>
            <h2 class="corpus-index__heading" id="collections-heading">Primary Hadith Collections</h2>
          </div>
          <p class="corpus-index__note">
            Organized by extant record volume. Every compilation is presented in full chronological sequence with facing critical apparatus.
          </p>
        </div>

        <ol class="catalog-ledger">
          {books.map((b, i) => (
            <li class="catalog-row" style={`--share:${(b.hadith_count / largest).toFixed(4)}`}>
              <a class="catalog-row__link" href={`/hadith/collection/${b.slug}/`}>
                <span class="catalog-row__no">{String(i + 1).padStart(2, '0')}</span>
                <span class="catalog-row__titles">
                  <span class="catalog-row__en">{b.title_en}</span>
                  {b.title_ar && <span class="catalog-row__ar" lang="ar" dir="rtl">{b.title_ar}</span>}
                </span>
                <span class="catalog-row__count">{b.hadith_count.toLocaleString()} <span>narrations</span></span>
                <span class="catalog-row__bar" aria-hidden="true"><span></span></span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <!--
        Provenance. The corpus is a versioned, immutable artifact rather than
        a live database, so a citation of a record is a citation of a build;
        saying which one is the difference between a reproducible reference
        and one that quietly stops matching.
      -->
      <p class="corpus-provenance">
        <span class="corpus-provenance__label">Corpus build</span>
        <span class="corpus-provenance__version">{CORPUS_META.corpusVersion}</span>
        <span class="corpus-provenance__figures">
          {stats.narrations.toLocaleString()} narrations · {stats.transmitters.toLocaleString()} transmitters
          · {stats.collections} collections
        </span>
      </p>

      <noscript>
        <p class="corpus-notice corpus-notice--warn">
          Full-text search runs against a static SQLite corpus inside your
          browser, so it needs JavaScript. The catalogue above, and every
          article on this site, work without it.
        </p>
      </noscript>
    </div>
  </div>

  <script>
    import { initHadithSearch } from '../../lib/hadith-search';
    initHadithSearch();
  </script>
</BaseLayout>

<style>
  .corpus-page {
    background: var(--hc-surface-0);
    min-height: 100vh;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* ── Search Console ────────────────────────────────────────── */
  .corpus-body {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .corpus-console {
    max-width: 72rem;
    margin: 0 auto 2.5rem;
  }

  .console-box {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transition: border-color var(--motion-fast) ease;
  }

  .console-box:focus-within {
    border-color: var(--hc-gold);
  }

  .console-box__input-row {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--hc-rule-soft);
    background: var(--hc-surface-1);
  }

  .console-box__search-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 1.25rem;
    color: var(--hc-gold);
  }

  .console-box__input {
    flex: 1;
    min-width: 0;
    padding: 1.1rem 1.25rem;
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--hc-text-primary);
  }

  .console-box__submit {
    padding: 0 1.75rem;
    height: 100%;
    align-self: stretch;
    border: none;
    border-left: 1px solid var(--hc-rule-soft);
    background: color-mix(in srgb, var(--hc-gold) 12%, var(--hc-surface-2));
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
  }

  .console-box__submit:hover {
    background: var(--hc-gold);
    color: var(--hc-surface-0);
  }

  .console-box__options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    padding: 0.85rem 1.25rem;
    background: var(--hc-surface-2);
  }

  .console-param-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
  }

  .console-param {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .console-param__label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .console-select {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    color: var(--hc-text-primary);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .console-select:focus {
    border-color: var(--hc-gold);
  }

  .console-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--hc-text-secondary);
    cursor: pointer;
  }

  /* Provenance line under the catalogue. Apparatus ink, never editorial. */
  .corpus-provenance {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    max-width: 72rem;
    margin: 2.5rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hc-rule-soft);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--hc-text-tertiary);
  }

  .corpus-provenance__label {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .corpus-provenance__version {
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-secondary);
  }

  .corpus-provenance__figures {
    font-variant-numeric: tabular-nums;
  }

  /* ── Index Mode: Compilations ──────────────────────────────── */
  .corpus-index {
    max-width: 72rem;
    margin: 0 auto;
  }

  .corpus-index__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hc-rule);
  }

  .corpus-index__heading {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 500;
    color: var(--hc-text-primary);
  }

  .corpus-index__note {
    max-width: 52ch;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--hc-text-secondary);
  }

  @media (max-width: 780px) {
    .console-box__options {
      flex-direction: column;
      align-items: stretch;
    }
    .console-param {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
    .console-select {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .console-box__submit {
      transition: none;
      transform: none;
    }
  }
</style>

<!-- Global styles for client-side search hydration -->
<style is:global>
  /* Rendered by src/lib/hadith-search.ts after the corpus answers, so these
     cannot be scoped: a node created by script never carries the page's
     data-astro-cid attribute and a scoped rule would not reach it. */
  .corpus-active-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0.5rem 0;
  }

  .corpus-active-filters__label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .corpus-active-filters__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-secondary);
  }

  .filter-chip__key {
    color: var(--hc-text-tertiary);
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .filter-chip__val {
    color: var(--hc-gold);
  }

  .filter-chip__link {
    color: var(--hc-gold);
    text-decoration: none;
  }

  .filter-chip-clear {
    margin-left: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--hc-gold);
    text-decoration: none;
  }

  .filter-chip-clear:hover {
    text-decoration: underline;
  }

  /* ── Notices ───────────────────────────────────────────────── */
  .corpus-notice {
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
    border-radius: var(--radius-xs);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .corpus-notice--error {
    border: 1px solid rgba(220, 38, 38, 0.4);
    background: color-mix(in srgb, red 8%, var(--hc-surface-1));
    color: var(--hc-text-secondary);
  }

  .corpus-notice--warn {
    border-left: 3px solid var(--hc-gold);
    background: var(--hc-surface-1);
    color: var(--hc-text-secondary);
  }

  .corpus-toolbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .corpus-status {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  .corpus-status__count {
    font-weight: 600;
    color: var(--hc-text-primary);
  }

  .corpus-status__context {
    margin-left: 0.45rem;
    color: var(--hc-text-tertiary);
  }

  .corpus-ranking-note {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .corpus-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .corpus-record-card {
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    transition: background var(--motion-fast) ease, border-color var(--motion-fast) ease, box-shadow var(--motion-fast) ease;
  }

  .corpus-record-card:hover {
    background: var(--hc-surface-2);
    border-color: var(--hc-gold-dim);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .corpus-record-card__hitarea {
    display: block;
    padding: 1.5rem 1.75rem;
    text-decoration: none;
    color: inherit;
  }

  .corpus-record-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .corpus-record-card__breadcrumbs {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .corpus-record-card__book {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .corpus-record-card__num {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-tertiary);
  }

  .corpus-record-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--hc-gold-dim);
    transition: color var(--motion-fast) ease, gap var(--motion-fast) ease;
  }

  .corpus-record-card:hover .corpus-record-card__action {
    color: var(--hc-gold);
    gap: 0.55rem;
  }

  .corpus-record-card__chapter {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--hc-text-primary);
  }

  .corpus-record-card__spread {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.2rem);
  }

  .corpus-record-card__col {
    min-width: 0;
  }

  .corpus-record-card__snippet-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .corpus-badge-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .corpus-badge-indicator--en {
    background: var(--hc-text-tertiary);
  }

  .corpus-badge-indicator--ar {
    background: var(--hc-gold);
  }

  .corpus-record-card__text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--hc-text-secondary);
  }

  .corpus-record-card__ar {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: 1.25rem;
    line-height: 2.1;
    color: var(--hc-text-primary);
    direction: rtl;
    text-align: right;
  }

  .corpus-record-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.2rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .corpus-record-card__pills {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .corpus-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.22rem 0.55rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 2px;
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .corpus-pill__label {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--hc-text-tertiary);
  }

  .corpus-pill__num {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-secondary);
  }

  .corpus-record-card__id-meta {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-tertiary);
  }

  .corpus-empty-card {
    padding: 4.5rem 2rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    text-align: center;
  }

  .corpus-empty-card__icon {
    font-size: 2.5rem;
    color: var(--hc-gold-dim);
    margin-bottom: 0.75rem;
  }

  .corpus-empty-card__title {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--hc-text-primary);
  }

  .corpus-empty-card__text {
    max-width: 52ch;
    margin: 0 auto 1.5rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--hc-text-secondary);
  }

  /* Pager */
  .corpus-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .corpus-pager__btn {
