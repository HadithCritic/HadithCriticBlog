---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../lib/db';
import { buildMatch, type SearchScope } from '../../lib/arabic-normalize';
import { makeSnippet } from '../../lib/snippet';
import { toPlainText } from '../../lib/format-text';
import {
  boundedCountSql,
  exactCount,
  ftsCountSql,
  ftsPageSql,
  narratorCountSql,
  formatCount,
  pageCount,
  readCount,
  type CountResult
} from '../../lib/corpus-count';
import { CORPUS_CACHE_CONTROL } from '../../lib/edge-cache';
import { CANONICAL_BOOKS } from '../../data/canonical-books';

/**
 * Hadith Corpus Discovery & Academic Search Console.
 * Dual-function architecture: serves as an archival compilation directory
 * when idle and transforms into a full-text critical search engine when queried.
 */

const p = Astro.url.searchParams;
const q = (p.get('q') || '').trim();
const scopeParam = (p.get('scope') || 'all') as SearchScope;
const scope: SearchScope = ['all', 'matn', 'arabic', 'english'].includes(scopeParam)
  ? scopeParam
  : 'all';
const bookFilter = parseInt(p.get('book') || '', 10);
const narratorFilter = parseInt(p.get('narrator') || '', 10);
const subjectFilter = (p.get('subject') || '').trim();
const isPhrase = p.get('phrase') === '1';
const page = Math.max(1, parseInt(p.get('page') || '1', 10) || 1);
const size = 25;
const offset = (page - 1) * size;

// Field weights: substantive matn prioritized over transmitter chains
const BM25 = 'bm25(hadith_fts, 1.0, 2.0, 1.0, 2.0, 0.5)';

const hasFilter =
  Boolean(q) ||
  (Number.isFinite(bookFilter) && bookFilter > 0) ||
  (Number.isFinite(narratorFilter) && narratorFilter > 0) ||
  Boolean(subjectFilter);

const where: string[] = [];
const binds: unknown[] = [];
let joinFts = false;
let queryError = false;

if (q) {
  try {
    where.push('hadith_fts MATCH ?');
    binds.push(buildMatch(q, scope, isPhrase));
    joinFts = true;
  } catch {
    queryError = true;
    where.pop();
  }
}
if (Number.isFinite(bookFilter) && bookFilter > 0) {
  where.push('h.book_id = ?');
  binds.push(bookFilter);
}
if (Number.isFinite(narratorFilter) && narratorFilter > 0) {
  where.push(
    'EXISTS (SELECT 1 FROM hadith_narrator hn WHERE hn.hadith_id = h.id AND hn.narrator_id = ?)'
  );
  binds.push(narratorFilter);
}
if (subjectFilter) {
  where.push(
    'EXISTS (SELECT 1 FROM hadith_subject hs WHERE hs.hadith_id = h.id AND hs.label_en = ?)'
  );
  binds.push(subjectFilter);
}

const from = joinFts
  ? 'FROM hadith_fts JOIN hadith h ON h.id = hadith_fts.rowid JOIN hadith_book b ON b.id = h.book_id'
  : 'FROM hadith h JOIN hadith_book b ON b.id = h.book_id';
const clause = where.length ? `WHERE ${where.join(' AND ')}` : '';
const order = joinFts ? `${BM25} ASC` : 'h.id ASC';

interface Row {
  id: number;
  hadith_num: string;
  chapter_en: string;
  matn_en: string | null;
  text_en: string;
  text_ar: string;
  matn_ar: string | null;
  parallel_count: number;
  narrator_count: number;
  book_id: number;
  book_en: string;
  book_slug: string;
}

interface Book {
  id: number;
  slug: string;
  title_en: string;
  title_ar: string;
  hadith_count: number;
}

let results: Row[] = [];
let count: CountResult = exactCount(0);
let books: Book[] = [];
let activeNarrator: { id: number; name_en: string } | undefined;
let stats = { narrations: 0, collections: 0, transmitters: 0 };
let failed = false;
let searchFailed = false;

try {
  const res = await db.batch([
    db.prepare(
      'SELECT id, slug, title_en, title_ar, hadith_count FROM hadith_book ORDER BY hadith_count DESC'
    ),
    db.prepare(
      `SELECT key, value FROM corpus_stat
        WHERE key IN ('hadith_narrations', 'hadith_collections', 'narrator_named')`
    ),
    narratorFilter
      ? db.prepare('SELECT id, name_en FROM narrator WHERE id = ?').bind(narratorFilter)
      : db.prepare('SELECT 0 AS id, NULL AS name_en WHERE 0')
  ]);
  books = (res[0].results || []) as unknown as Book[];
  const stored = new Map(
    (res[1].results as { key: string; value: number }[] | undefined)?.map((r) => [
      r.key,
      Number(r.value)
    ]) || []
  );
  stats = {
    narrations: stored.get('hadith_narrations') ?? 0,
    collections: stored.get('hadith_collections') ?? 0,
    transmitters: stored.get('narrator_named') ?? 0
  };
  activeNarrator = (res[2].results || [])[0] as typeof activeNarrator;
} catch {
  books = CANONICAL_BOOKS;
  stats = { narrations: 276347, collections: 33, transmitters: 20915 };
  failed = false;
}

const activeFilters = [
  q ? 'query' : null,
  Number.isFinite(bookFilter) && bookFilter > 0 ? 'book' : null,
  Number.isFinite(narratorFilter) && narratorFilter > 0 ? 'narrator' : null,
  subjectFilter ? 'subject' : null
].filter(Boolean);
const soleFilter = activeFilters.length === 1 ? activeFilters[0] : null;

const bookOnly = soleFilter === 'book' ? books.find((b) => b.id === bookFilter) : undefined;
const queryOnly = soleFilter === 'query' && !queryError;
const narratorOnly = soleFilter === 'narrator';

if (!failed && hasFilter && !queryError) {
  try {
    const COLUMNS = `h.id, h.hadith_num, h.chapter_en, h.matn_en, h.text_en,
                h.parallel_count, h.narrator_count, h.text_ar, h.matn_ar,
                b.id AS book_id, b.title_en AS book_en, b.slug AS book_slug`;

    const res = await db.batch([
      queryOnly
        ? db.prepare(ftsPageSql(COLUMNS, BM25)).bind(binds[0], size, offset)
        : db
            .prepare(`SELECT ${COLUMNS} ${from} ${clause} ORDER BY ${order} LIMIT ? OFFSET ?`)
            .bind(...binds, size, offset),
      bookOnly
        ? db.prepare('SELECT 0 AS n WHERE 0')
        : queryOnly
          ? db.prepare(ftsCountSql()).bind(binds[0])
          : narratorOnly
            ? db.prepare(narratorCountSql()).bind(narratorFilter)
            : db.prepare(boundedCountSql(from, clause)).bind(...binds)
    ]);
    results = (res[0].results || []) as unknown as Row[];
    count = bookOnly
      ? exactCount(bookOnly.hadith_count)
      : readCount((res[1].results?.[0] as { n?: number } | undefined)?.n);
  } catch (error) {
    console.error('Corpus search failed', error);
    searchFailed = true;
  }
}

const pages = pageCount(count, size);

if (!failed && !searchFailed) {
  Astro.response.headers.set('Cache-Control', CORPUS_CACHE_CONTROL);
}
const activeBook = books.find((b) => b.id === bookFilter);

const pageUrl = (n: number) => {
  const u = new URLSearchParams(Astro.url.search);
  u.set('page', String(n));
  return `/hadith?${u}`;
};

const REVEAL_CAP = 8;
---

<BaseLayout
  title={q ? `“${q}” — Hadith Corpus Research Query` : 'Hadith Corpus & Textual Archive | HadithCritic'}
  description={`Search ${stats.narrations.toLocaleString()} textual records across ${stats.collections} compilations in facing Arabic and English. Transmitters linked to biographical registers with descriptive apparatus.`}
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Hadith Corpus', url: '/hadith' }]}
>
  <div class="corpus-page">
    <!-- Academic Hero & Archival Plate -->
    <header class="corpus-hero">
      <div class="wrap">
        <div class="corpus-hero__plate">
          <div class="corpus-hero__eyebrow-row">
            <span class="corpus-docket-badge">Corpus Attestation Archive</span>
            <span class="corpus-docket-status">Descriptive Critical Edition</span>
          </div>

          <h1 class="corpus-title">
            The Hadith Research <span class="corpus-title__accent">Corpus</span>
          </h1>

          <p class="corpus-lead">
            A searchable critical archive of {stats.narrations.toLocaleString()} narrations across {stats.collections} early and canonical compilations. Transmission chains link directly to the transmitter register with no theological grading apparatus.
          </p>

          <div class="corpus-stat-grid" aria-label="Corpus Metadata Overview">
            <div class="corpus-stat-card">
              <span class="corpus-stat-card__val">{stats.narrations.toLocaleString()}</span>
              <span class="corpus-stat-card__label">Archived Reports</span>
              <span class="corpus-stat-card__desc">Bilingual Primary Texts</span>
            </div>
            <div class="corpus-stat-card">
              <span class="corpus-stat-card__val">{stats.collections}</span>
              <span class="corpus-stat-card__label">Compilations</span>
              <span class="corpus-stat-card__desc">Canonical & Early Sources</span>
            </div>
            <div class="corpus-stat-card">
              <span class="corpus-stat-card__val">{stats.transmitters.toLocaleString()}</span>
              <span class="corpus-stat-card__label">Transmitters</span>
              <span class="corpus-stat-card__desc">Biographical Index Links</span>
            </div>
            <div class="corpus-stat-card corpus-stat-card--accent">
              <span class="corpus-stat-card__val">Empirical</span>
              <span class="corpus-stat-card__label">Evaluation Model</span>
              <span class="corpus-stat-card__desc">Unbiased Historical Data</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="wrap corpus-body">
      {failed ? (
        <div class="corpus-notice corpus-notice--error">
          <p>The corpus database is temporarily unavailable. Please retry in a few moments.</p>
        </div>
      ) : (
        <>
          <!-- Research Search Console -->
          <section class="corpus-console" aria-label="Textual Search Console">
            <form class="corpus-controls" method="get" action="/hadith">
              <div class="console-box">
                <div class="console-box__input-row">
                  <div class="console-box__search-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                  </div>
                  <input
                    id="corpus-q"
                    class="hc-searchbar__input console-box__input"
                    type="search"
                    name="q"
                    value={q}
                    placeholder="Search textual matn, chains, or topics (e.g. عائشة, intention, صلاة الفجر)…"
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <button type="submit" class="hc-searchbar__submit console-box__submit">
                    <span>Search Archive</span>
                  </button>
                </div>

                <div class="console-box__options">
                  <div class="console-param-group">
                    <label class="console-param" for="scope-select">
                      <span class="console-param__label">Target Scope:</span>
                      <select id="scope-select" name="scope" class="console-select">
                        <option value="all" selected={scope === 'all'}>Entire Formulation (Matn + Isnād)</option>
                        <option value="matn" selected={scope === 'matn'}>Substantive Matn Only</option>
                        <option value="arabic" selected={scope === 'arabic'}>Arabic Text Only</option>
                        <option value="english" selected={scope === 'english'}>English Translation Only</option>
                      </select>
                    </label>

                    <label class="console-param" for="book-select">
                      <span class="console-param__label">Source Corpus:</span>
                      <select id="book-select" name="book" class="console-select">
                        <option value="">All {stats.collections} Compilations</option>
                        {books.map((b) => (
                          <option value={b.id} selected={b.id === bookFilter}>
                            {b.title_en} ({b.hadith_count.toLocaleString()})
                          </option>
                        ))}
                      </select>
                    </label>
                  </div>

                  <label class="console-checkbox">
                    <input type="checkbox" name="phrase" value="1" checked={isPhrase} />
                    <span>Exact Phrase</span>
                  </label>
                </div>
              </div>

              {narratorFilter > 0 && <input type="hidden" name="narrator" value={narratorFilter} />}
              {subjectFilter && <input type="hidden" name="subject" value={subjectFilter} />}
            </form>

            {(activeNarrator || subjectFilter || activeBook || q) && (
              <div class="corpus-active-filters">
                <span class="corpus-active-filters__label">Active Constraints:</span>
                <div class="corpus-active-filters__list">
                  {q && (
                    <span class="filter-chip">
                      <span class="filter-chip__key">Query:</span>
                      <strong class="filter-chip__val">“{q}”</strong>
                    </span>
                  )}
                  {activeBook && (
                    <span class="filter-chip">
                      <span class="filter-chip__key">Collection:</span>
                      <strong class="filter-chip__val">{activeBook.title_en}</strong>
                    </span>
                  )}
                  {activeNarrator && (
                    <span class="filter-chip">
                      <span class="filter-chip__key">Transmitter:</span>
                      <a class="filter-chip__link" href={`/narrators/${activeNarrator.id}`}>{activeNarrator.name_en}</a>
                    </span>
                  )}
                  {subjectFilter && (
                    <span class="filter-chip">
                      <span class="filter-chip__key">Subject:</span>
                      <strong class="filter-chip__val">{subjectFilter}</strong>
                    </span>
                  )}
                  <a class="filter-chip-clear" href="/hadith">Clear All Filters</a>
                </div>
              </div>
            )}
          </section>

          {searchFailed && (
            <div class="corpus-notice corpus-notice--warn">
              <p>Textual search is currently operating in fallback mode. The archival collection registers below remain fully browsable.</p>
            </div>
          )}

          {/* Results Mode */}
          {hasFilter && !searchFailed ? (
            <section class="corpus-results-section" aria-label="Search Results">
              <div class="corpus-toolbar">
                <div class="corpus-status" aria-live="polite">
                  <span class="corpus-status__count">
                    {queryError
                      ? 'No searchable tokens detected'
                      : `${formatCount(count)} ${count.total === 1 ? 'archival record' : 'archival records'} found`}
                  </span>
                  {q && !queryError && <span class="corpus-status__context">for query <em>“{q}”</em></span>}
                </div>
                <div class="corpus-ranking-note">Ranked by BM25 Textual Relevance</div>
              </div>

              <ol class="corpus-results">
                {results.map((r, i) => (
                  <li class="corpus-result hc-reveal" style={`--reveal-delay:${Math.min(i, REVEAL_CAP)}`}>
                    <article class="corpus-record-card">
                      <a class="corpus-record-card__hitarea" href={`/hadith/${r.id}`}>
                        <div class="corpus-record-card__top">
                          <div class="corpus-record-card__breadcrumbs">
                            <span class="corpus-record-card__book">{r.book_en}</span>
                            {r.hadith_num ? (
                              <span class="corpus-record-card__num">Report № {r.hadith_num}</span>
                            ) : (
                              <span class="corpus-record-card__num">ID #{r.id}</span>
                            )}
                          </div>
                          <span class="corpus-record-card__action">
                            <span>Open Record</span>
                            <span class="corpus-record-card__arrow">→</span>
                          </span>
                        </div>

                        {r.chapter_en && (
                          <h2 class="corpus-record-card__chapter">{toPlainText(r.chapter_en)}</h2>
                        )}

                        <div class="corpus-record-card__spread">
                          <div class="corpus-record-card__col corpus-record-card__col--en">
                            <div class="corpus-record-card__snippet-meta">
                              <span class="corpus-badge-indicator corpus-badge-indicator--en"></span>
                              <span>English Translation</span>
                            </div>
                            <p class="corpus-record-card__text">
                              <Fragment set:html={makeSnippet(toPlainText(r.matn_en || r.text_en), q, { window: 260 })} />
                            </p>
                          </div>

                          <div class="corpus-record-card__col corpus-record-card__col--ar">
                            <div class="corpus-record-card__snippet-meta corpus-record-card__snippet-meta--ar">
                              <span class="corpus-badge-indicator corpus-badge-indicator--ar"></span>
                              <span lang="ar" dir="rtl">النص الأصلي</span>
                            </div>
                            <p lang="ar" dir="rtl" class="corpus-record-card__ar">
                              <Fragment set:html={makeSnippet(r.matn_ar || r.text_ar, q, { window: 200 })} />
                            </p>
                          </div>
                        </div>

                        <div class="corpus-record-card__footer">
                          <div class="corpus-record-card__pills">
                            <span class="corpus-pill">
                              <span class="corpus-pill__label">Transmitters:</span>
                              <strong class="corpus-pill__num">{r.narrator_count}</strong>
                            </span>
                            {Number(r.parallel_count) > 0 && (
                              <span class="corpus-pill">
                                <span class="corpus-pill__label">Parallels:</span>
                                <strong class="corpus-pill__num">{Number(r.parallel_count).toLocaleString()}</strong>
                              </span>
                            )}
                          </div>
                          <span class="corpus-record-card__id-meta">Corpus ID: #{r.id}</span>
                        </div>
                      </a>
                    </article>
                  </li>
                ))}
              </ol>

              {results.length === 0 && !queryError && (
                <div class="corpus-empty-card">
                  <div class="corpus-empty-card__icon" aria-hidden="true">∅</div>
                  <h3 class="corpus-empty-card__title">No Textual Matches Discovered</h3>
                  <p class="corpus-empty-card__text">
                    No narrations met the search parameters. Arabic diacritics and alternate spellings (e.g. عائشة and عايشة) are normalized automatically. Consider broadening your scope or querying specific root keywords.
                  </p>
                  <a class="filter-chip-clear" href="/hadith">Reset Search Filters</a>
                </div>
              )}

              {pages > 1 && (
                <nav class="corpus-pager" aria-label="Query pagination">
                  {page > 1 ? (
                    <a class="corpus-pager__btn" href={pageUrl(page - 1)}>← Previous Page</a>
                  ) : (
                    <span class="corpus-pager__btn is-disabled" aria-disabled="true">← Previous Page</span>
                  )}
                  <span class="corpus-pager__info">
                    Page <strong>{page.toLocaleString()}</strong> of <strong>{pages.toLocaleString()}</strong>
                  </span>
                  {page < pages ? (
                    <a class="corpus-pager__btn" href={pageUrl(page + 1)}>Next Page →</a>
                  ) : (
                    <span class="corpus-pager__btn is-disabled" aria-disabled="true">Next Page →</span>
                  )}
                </nav>
              )}
            </section>
          ) : (
            /* Idle Mode: Canonical Collection Register */
            <section class="corpus-index" aria-labelledby="collections-heading">
              <div class="corpus-index__header">
                <div>
                  <span class="hc-eyebrow">Archival Catalog</span>
                  <h2 class="corpus-index__heading" id="collections-heading">Primary Hadith Collections</h2>
                </div>
                <p class="corpus-index__note">
                  Organized by extant record volume. Every compilation is presented in full chronological sequence with facing critical apparatus.
                </p>
              </div>

              <div class="corpus-books-grid">
                {books.map((b, i) => (
                  <article class="book-card hc-reveal" style={`--reveal-delay:${Math.min(i, REVEAL_CAP)}`}>
                    <a class="book-card__link" href={`/hadith/collection/${b.slug}`}>
                      <div class="book-card__header">
                        <span class="book-card__index">Vol. {String(i + 1).padStart(2, '0')}</span>
                        <span class="book-card__count">{b.hadith_count.toLocaleString()} Narrations</span>
                      </div>
                      <div class="book-card__body">
                        <h3 class="book-card__title-en">{b.title_en}</h3>
                        {b.title_ar && (
                          <p class="book-card__title-ar" lang="ar" dir="rtl">{b.title_ar}</p>
                        )}
                      </div>
                      <div class="book-card__footer">
                        <span class="book-card__browse">Browse Edition</span>
                        <span class="book-card__arrow">→</span>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            </section>
          )}
        </>
      )}
    </div>
  </div>

  <script>
    import { initHadithSearch } from '../../lib/hadith-search';
    initHadithSearch();
  </script>
</BaseLayout>

<style>
  .corpus-page {
    background: var(--hc-surface-0);
    min-height: 100vh;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* ── Hero & Archival Plate ─────────────────────────────────── */
  .corpus-hero {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--hc-rule);
    background: radial-gradient(circle at 85% 15%, color-mix(in srgb, var(--hc-gold) 4%, transparent) 0%, transparent 60%);
  }

  .corpus-hero__plate {
    position: relative;
    max-width: 72rem;
    margin: 0 auto;
  }

  .corpus-hero__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .corpus-docket-badge {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .corpus-docket-status {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--hc-text-tertiary);
  }

  .corpus-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--hc-text-primary);
  }

  .corpus-title__accent {
    color: var(--hc-gold);
    font-style: italic;
  }

  .corpus-lead {
    max-width: 68ch;
    margin: 1.25rem 0 2rem;
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--hc-text-secondary);
  }

  /* ── Metric Grid ───────────────────────────────────────────── */
  .corpus-stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .corpus-stat-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
  }

  .corpus-stat-card--accent {
    border-color: color-mix(in srgb, var(--hc-gold) 35%, var(--hc-rule-soft));
  }

  .corpus-stat-card__val {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 600;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-primary);
  }

  .corpus-stat-card--accent .corpus-stat-card__val {
    color: var(--hc-gold);
  }

  .corpus-stat-card__label {
    margin-top: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-secondary);
  }

  .corpus-stat-card__desc {
    margin-top: 0.2rem;
    font-family: var(--font-ui);
