---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { OG } from '../../lib/seo';
import { CORPUS_CACHE_CONTROL } from '../../lib/edge-cache';
import { corpusHas } from '../../lib/corpus-ids';
import '../../styles/hadith-edition.css';

/**
 * Critical edition record for one narration.
 *
 * A shell, and deliberately so. There are 276,347 narrations, which is far past
 * what can be prerendered, and there is no longer a database behind the site to
 * ask at request time. So the Worker renders the frame and the identity of the
 * record it is going to show, and src/lib/hadith-record.ts fills it from the
 * static corpus in the browser: the narration, its facing texts, its isnad
 * branches and its apparatus.
 *
 * This route stays on-demand rather than prerendered only because the id is
 * unbounded. It performs no I/O of any kind -- no database, no fetch, nothing
 * to fail -- so it costs a Worker invocation and nothing else.
 *
 * The consequence to be aware of: a crawler that does not run JavaScript sees
 * the shell rather than the narration. That is the price of serving a 1.6 GB
 * corpus from static files, and it is paid knowingly.
 */

const raw = Astro.params.id ?? '';
const id = Number(raw);
const valid = /^\d+$/.test(raw) && Number.isFinite(id) && id > 0;

if (!valid) {
  return new Response('Not found', { status: 404 });
}

const pageTitle = `Hadith ${id} | HadithCritic Critical Edition`;

// An id the corpus does not hold answers 404 and is kept out of the index.
// The shell still renders, so the reader gets the same "no such record"
// explanation the client module writes. `undefined` means the id list was
// cut from another corpus version and cannot be trusted; see corpus-ids.ts.
const missing = corpusHas('hadith', id) === false;
if (missing) Astro.response.status = 404;

// The shell depends on the id and the deployment, and on nothing that can
// fail, so it is unconditionally storable at the edge.
Astro.response.headers.set('Cache-Control', CORPUS_CACHE_CONTROL);
---

<BaseLayout image={OG.corpus}
  title={pageTitle}
  noindex={missing}
  description="A primary source narration in Arabic and English from the HadithCritic corpus, with its transmission chain and critical apparatus."
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Corpus', url: '/hadith/' },
    { name: `Hadith ${id}`, url: `/hadith/${id}/` }
  ]}
>
  <div class="hadith-container hc-edition" data-hadith-id={id}>
    <div class="record-loading" data-record-loading>
      <span class="record-spinner" aria-hidden="true"></span>
      <p>Reading narration #{id} from the corpus...</p>
    </div>
    <noscript>
      <div class="hadith-degraded">
        <span class="hadith-degraded__badge">JavaScript required</span>
        <h1 class="hadith-degraded__title">Narration #{id}</h1>
        <p class="hadith-degraded__text">
          Narrations are read from a static SQLite corpus inside your browser,
          which needs JavaScript. The written research on this site does not.
        </p>
        <div class="hadith-degraded__actions">
          <a class="hc-btn" href="/hadith/">Return to the corpus index</a>
        </div>
      </div>
    </noscript>
  </div>
</BaseLayout>

<script>
  import { initHadithRecord } from '../../lib/hadith-record';
  initHadithRecord();
</script>

<style is:global>
  /*
   * The narration record's shell and its apparatus. Every rule is global
   * because src/lib/hadith-record.ts builds the markup in the browser, where
   * Astro's scope hash never reaches. The masthead, band, leaf and panels are
   * shared with the kitab pages and live in src/styles/hadith-edition.css.
   */
  html { scroll-behavior: smooth; }

  .hadith-container {
    width: min(100% - 2rem, 76rem);
    margin: 0 auto;
    padding: clamp(1rem, 2.5vw, 1.75rem) 0 6rem;
  }

  /* ── Shell states, before the record arrives ── */
  .record-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: clamp(3rem, 12vh, 7rem) 1rem;
    color: var(--hc-text-secondary);
    font: 400 0.9rem/1.5 var(--font-ui);
    text-align: center;
  }
  .record-spinner {
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--hc-rule-soft);
    border-top-color: var(--hc-gold);
    border-radius: 50%;
    animation: record-spin 900ms linear infinite;
  }
  @keyframes record-spin { to { transform: rotate(360deg); } }

  .hadith-degraded {
    max-width: 48rem;
    margin: 4rem auto;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    text-align: center;
  }
  .hadith-degraded__badge {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.28rem 0.7rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 999px;
    color: var(--hc-gold);
    font: 700 0.75rem/1.4 var(--font-ui);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .hadith-degraded__title {
    margin: 0 0 0.85rem;
    color: var(--hc-text-primary);
    font: 500 clamp(1.7rem, 4vw, 2.3rem)/1.2 var(--font-display);
  }
  .hadith-degraded__text {
    max-width: 54ch;
    margin: 0 auto 1.5rem;
    color: var(--hc-text-secondary);
    font: 400 1rem/1.75 var(--font-body);
  }
  .hadith-degraded__actions { display: flex; justify-content: center; }

  /* ── More on this report ── */
  .hr-more { margin-top: clamp(1.75rem, 4vw, 2.5rem); }
  .hr-more__title {
    margin: 0 0 0.5rem;
    color: var(--hc-text-primary);
    font: 500 1.25rem/1.3 var(--font-display);
    scroll-margin-top: calc(var(--site-header-height, 72px) + 1.5rem);
  }
  .hr-more__item { border-top: 1px solid var(--hc-rule-soft); }
  .hr-more__item:last-child { border-bottom: 1px solid var(--hc-rule-soft); }
  .hr-more__item > summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0.8rem 0;
    color: var(--hc-text-primary);
    font: 500 0.98rem/1.4 var(--font-body);
    cursor: pointer;
  }
  .hr-more__item > summary span { color: var(--hc-text-tertiary); font: 500 0.8rem/1.4 var(--font-ui); }
  .hr-more__note { margin: 0.6rem 0 1rem; color: var(--hc-text-tertiary); font: 400 0.82rem/1.6 var(--font-body); }
  .hr-more__ar { margin: 0 0 0.5rem; color: var(--hc-text-primary); font: 400 1.25rem/2 var(--font-arabic); text-align: right; }
  .hr-counts { margin: 0; padding: 0; list-style: none; }
  .hr-counts li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-top: 1px dashed var(--hc-rule-soft);
    color: var(--hc-text-secondary);
    font: 400 0.9rem/1.5 var(--font-body);
  }
  .hr-counts strong { color: var(--hc-text-primary); font-weight: 600; }
  .hr-counts__n { color: var(--hc-text-primary); font: 600 0.95rem/1.5 var(--font-ui); font-variant-numeric: tabular-nums; }
  .hr-glosses { display: grid; gap: 0; margin: 0 0 1rem; }
  .hr-glosses > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 0.45rem 0;
    border-top: 1px dashed var(--hc-rule-soft);
  }
  .hr-glosses dd { margin: 0; color: var(--hc-text-primary); font: 400 0.95rem/1.5 var(--font-body); }
  .hr-glosses dt { color: var(--hc-text-secondary); font: 400 1.1rem/1.6 var(--font-arabic); }
  .hr-subjects { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
  .hr-subjects a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    color: var(--hc-text-secondary);
    font: 400 0.85rem/1.4 var(--font-body);
    text-decoration: none;
  }
  .hr-subjects a:hover { border-color: var(--hc-gold-dim); color: var(--hc-text-primary); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .record-spinner { animation: none; }
  }
</style>
