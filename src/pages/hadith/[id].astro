---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { entityPage, OG } from '../../lib/seo';
import { db } from '../../lib/db';
import { renderRich, renderArabic, toPlainText } from '../../lib/format-text';
import { CORPUS_CACHE_CONTROL } from '../../lib/edge-cache';

/**
 * A single narration, rendered on demand from the database.
 * Laid out as an authentic critical edition with facing translation,
 * unbroken isnad transmission lineage, and scholarly apparatus.
 */

const id = Number(Astro.params.id);
if (!Number.isFinite(id) || id <= 0) {
  return new Response('Not found', { status: 404 });
}

let hadithRow, chainRows, subjectRows, glossRows;
let dbError = false;

try {
  [hadithRow, chainRows, subjectRows, glossRows] = await db.batch([
    db.prepare(
      `SELECT h.*, b.title_ar AS book_ar, b.title_en AS book_en,
              b.id AS book_id, b.slug AS book_slug
         FROM hadith h JOIN hadith_book b ON b.id = h.book_id WHERE h.id = ?`
    ).bind(id),
    db.prepare(
      `SELECT c.path_idx, c.pos, c.narrator_id, c.name,
              n.name_en, n.death_hijri
         FROM hadith_chain c
         LEFT JOIN narrator n ON n.id = c.narrator_id
        WHERE c.hadith_id = ? ORDER BY c.path_idx, c.pos`
    ).bind(id),
    db.prepare('SELECT label_ar, label_en FROM hadith_subject WHERE hadith_id = ?').bind(id),
    db.prepare('SELECT word_ar, word_en FROM hadith_gloss WHERE hadith_id = ?').bind(id)
  ]);
} catch (error) {
  console.error(`Hadith ${id} failed to load`, error);
  dbError = true;
}

const hadith = hadithRow?.results?.[0] as Record<string, any> | undefined;

if (!dbError && !hadith) {
  return new Response('Hadith not found', { status: 404 });
}

if (!dbError) {
  Astro.response.headers.set('Cache-Control', CORPUS_CACHE_CONTROL);
}

interface ChainNode {
  path_idx: number;
  pos: number;
  narrator_id: number | null;
  name: string;
  name_en: string | null;
  death_hijri: number | null;
}

const chain = (chainRows?.results || []) as unknown as ChainNode[];
const rawSubjects = (subjectRows?.results || []) as unknown as { label_ar: string; label_en: string }[];
const glosses = (glossRows?.results || []) as unknown as { word_ar: string; word_en: string }[];

// Deduplicate subject tags by English label
const subjects = [...new Map(rawSubjects.map((s) => [s.label_en.trim(), s])).values()];

// Group parallel isnads
const paths = new Map<number, ChainNode[]>();
for (const node of chain) {
  if (!paths.has(node.path_idx)) paths.set(node.path_idx, []);
  paths.get(node.path_idx)!.push(node);
}

const chapter = hadith ? toPlainText(hadith.chapter_en) : '';
const ref = hadith ? `${hadith.book_en}${hadith.hadith_num ? ` № ${hadith.hadith_num}` : ''}` : `Hadith #${id}`;
const pageTitle = hadith ? `${ref} · Hadith ${id} | HadithCritic` : `Hadith #${id} | HadithCritic`;
const summary = hadith ? toPlainText(hadith.matn_en || hadith.text_en).slice(0, 180) : '';

const matnIsDistinct = hadith
  ? Boolean(hadith.matn_ar) && String(hadith.matn_ar).trim() !== String(hadith.text_ar).trim()
  : false;

const stats = hadith
  ? [
      { label: 'Transmitters', value: Number(hadith.narrator_count || 0).toLocaleString() },
      { label: 'Isnād Paths', value: Number(hadith.path_count || 0).toLocaleString() },
      { label: 'Parallels', value: Number(hadith.parallel_count || 0).toLocaleString() },
      { label: 'Witnesses', value: Number(hadith.witness_count || 0).toLocaleString() },
      { label: 'Variants', value: Number(hadith.variant_count || 0).toLocaleString() }
    ]
  : [];

const totalParallels = hadith
  ? Number(hadith.parallel_count || 0) +
    Number(hadith.witness_count || 0) +
    Number(hadith.variant_count || 0)
  : 0;
---

<BaseLayout
  title={pageTitle}
  description={summary || 'A searchable narration in Arabic and English from the Hadith Corpus.'}
  image={hadith ? OG.collection(hadith.book_slug) : undefined}
  imageAlt={hadith ? `${hadith.book_en}${hadith.hadith_num ? ` ${hadith.hadith_num}` : ''} · Hadith ${id}` : undefined}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Hadith', url: '/hadith' },
    ...(hadith ? [{ name: hadith.book_en, url: `/hadith/collection/${hadith.book_slug}` }] : []),
    { name: ref, url: `/hadith/${id}` }
  ]}
  schema={hadith ? [
    entityPage({
      url: `${Astro.site}hadith/${id}`,
      title: pageTitle,
      description: summary,
      entityId: `${Astro.site}hadith/${id}#hadith`
    })
  ] : []}
>
  <div class="hadith-container">
    {dbError || !hadith ? (
      <div class="hadith-degraded">
        <span class="hadith-degraded__badge">Database Rate-Limited</span>
        <h1 class="hadith-degraded__title">Narration #{id} Temporarily Unavailable</h1>
        <p class="hadith-degraded__text">
          The corpus database is currently experiencing high query volume. You can browse the
          collection directly or search through the client archive.
        </p>
        <div class="hadith-degraded__actions">
          <a class="hc-btn" href="/hadith">← Return to Hadith Corpus</a>
        </div>
      </div>
    ) : (
      <>
        <!-- Critical Edition Masthead Plate -->
        <header class="edition-hero">
          <div class="edition-hero__frame-corner edition-hero__frame-corner--tl" aria-hidden="true"></div>
          <div class="edition-hero__frame-corner edition-hero__frame-corner--tr" aria-hidden="true"></div>
          <div class="edition-hero__frame-corner edition-hero__frame-corner--bl" aria-hidden="true"></div>
          <div class="edition-hero__frame-corner edition-hero__frame-corner--br" aria-hidden="true"></div>

          <div class="edition-hero__nav">
            <a class="hc-back-link" href={`/hadith/collection/${hadith.book_slug}`}>
              <span>←</span>
              <span>{hadith.book_en}</span>
            </a>

            <div class="edition-hero__ref-tags">
              {hadith.hadith_num && (
                <span class="edition-ref-tag edition-ref-tag--gold">№ {hadith.hadith_num}</span>
              )}
              <span class="edition-ref-tag">Corpus ID #{id}</span>
            </div>
          </div>

          <div class="edition-hero__titles">
            {hadith.book_ar && (
              <p class="edition-hero__title-ar" lang="ar" dir="rtl">{hadith.book_ar}</p>
            )}
            <h1 class="edition-hero__title-en">{chapter || hadith.book_en}</h1>
          </div>

          <!-- Archival Ledger Strip -->
          <div class="edition-ledger-strip">
            <div class="edition-ledger-item">
              <span class="edition-ledger-label">Collection</span>
              <a href={`/hadith/collection/${hadith.book_slug}`} class="edition-ledger-val edition-ledger-val--link">
                {hadith.book_en}
              </a>
            </div>

            {hadith.hadith_num && (
              <div class="edition-ledger-item">
                <span class="edition-ledger-label">Citation</span>
                <span class="edition-ledger-val">Report № {hadith.hadith_num}</span>
              </div>
            )}

            <div class="edition-ledger-item">
              <span class="edition-ledger-label">Archive Status</span>
              <span class="edition-ledger-val edition-ledger-val--status">
                Raw Attestation · Descriptive Apparatus Only
              </span>
            </div>
          </div>

          <!-- Metrics Band -->
          <div class="hc-stat-band hc-stat-band--5">
            {stats.map((s) => (
              <div class="hc-stat">
                <span class="hc-stat__num">{s.value}</span>
                <span class="hc-stat__label">{s.label}</span>
              </div>
            ))}
          </div>

          <!-- Section Jump Bar -->
          <nav class="edition-jump-bar" aria-label="Edition Navigation">
            <span class="edition-jump-bar__label">Contents:</span>
            <div class="edition-jump-bar__links">
              {matnIsDistinct && (
                <a href="#matn-heading" class="edition-jump-link">
                  <span>Prophetic Matn</span>
                  <span class="edition-jump-link__tag" lang="ar">المتن</span>
                </a>
              )}
              <a href="#report-heading" class="edition-jump-link">
                <span>Full Formulation</span>
                <span class="edition-jump-link__tag" lang="ar">الرواية</span>
              </a>
              {paths.size > 0 && (
                <a href="#isnad-heading" class="edition-jump-link">
                  <span>Isnād Lineage</span>
                  <span class="edition-jump-link__badge">{paths.size}</span>
                </a>
              )}
              {(totalParallels > 0 || glosses.length > 0 || subjects.length > 0) && (
                <a href="#apparatus-heading" class="edition-jump-link">
                  <span>Critical Apparatus</span>
                </a>
              )}
            </div>
          </nav>
        </header>

        <!-- Prophetic Matn (if distinct from full transmission) -->
        {matnIsDistinct && (
          <section class="edition-section" aria-labelledby="matn-heading">
            <div class="edition-section__head">
              <div class="edition-section__kicker">
                <span class="hc-eyebrow">Core Text</span>
              </div>
              <h2 class="edition-section__title" id="matn-heading">Prophetic Matn (المتن)</h2>
              <p class="edition-section__desc">
                The substantive speech or operative verdict of the report, isolated from the transmission chain for critical textual analysis.
              </p>
            </div>

            <div class="facing-spread facing-spread--matn">
              <!-- English Translation (Left in DOM, Visual Left on desktop) -->
              <div class="facing-col facing-col--en">
                <div class="facing-col__meta">
                  <div class="facing-col__label-group">
                    <span class="facing-col__dot facing-col__dot--en" aria-hidden="true"></span>
                    <span class="facing-col__lang-label">English Translation</span>
                  </div>
                  <span class="facing-col__caveat">Machine translation · Unreviewed</span>
                </div>
                <div class="facing-col__content is-matn-content">
                  {hadith.matn_en ? (
                    <div class="facing-prose facing-prose--en">
                      <Fragment set:html={renderRich(hadith.matn_en)} />
                    </div>
                  ) : (
                    <p class="facing-prose--empty">No English translation recorded for this matn.</p>
                  )}
                </div>
              </div>

              <!-- Arabic Text (Visual Right on desktop, Stacks on top on mobile) -->
              <div class="facing-col facing-col--ar">
                <div class="facing-col__meta">
                  <div class="facing-col__label-group">
                    <span class="facing-col__dot facing-col__dot--ar" aria-hidden="true"></span>
                    <span class="facing-col__lang-label facing-col__lang-label--ar" lang="ar" dir="rtl">النص العربي المعتمد</span>
                  </div>
                  <span class="facing-col__folio-note">نص المتن المجرد</span>
                </div>
                <div class="facing-col__content is-matn-content">
                  <div class="facing-prose facing-prose--ar" lang="ar" dir="rtl">
                    <Fragment set:html={renderArabic(hadith.matn_ar)} />
                  </div>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Full Report & Isnād Context -->
        <section class="edition-section" aria-labelledby="report-heading">
          <div class="edition-section__head">
            <div class="edition-section__kicker">
              <span class="hc-eyebrow">Manuscript Formulation</span>
            </div>
            <h2 class="edition-section__title" id="report-heading">Full Report &amp; Isnād Context</h2>
            <p class="edition-section__desc">
              The narration in its original manuscript formulation, containing opening isnād formulas, transmission verbs, and operative body text.
            </p>
          </div>

          <div class="facing-spread">
            <!-- English Column -->
            <div class="facing-col facing-col--en">
              <div class="facing-col__meta">
                <div class="facing-col__label-group">
                  <span class="facing-col__dot facing-col__dot--en" aria-hidden="true"></span>
                  <span class="facing-col__lang-label">English Translation</span>
                </div>
                <span class="facing-col__caveat">Machine translation · Unreviewed</span>
              </div>
              <div class="facing-col__content">
                {hadith.text_en ? (
                  <div class="facing-prose facing-prose--en">
                    <Fragment set:html={renderRich(hadith.text_en)} />
                  </div>
                ) : (
                  <p class="facing-prose--empty">No English translation recorded for this narration.</p>
                )}
              </div>
            </div>

            <!-- Arabic Column -->
            <div class="facing-col facing-col--ar">
              <div class="facing-col__meta">
                <div class="facing-col__label-group">
                  <span class="facing-col__dot facing-col__dot--ar" aria-hidden="true"></span>
                  <span class="facing-col__lang-label facing-col__lang-label--ar" lang="ar" dir="rtl">الرواية الكاملة مع الإسناد</span>
                </div>
                <span class="facing-col__folio-note">نص المصنف الأصلي</span>
              </div>
              <div class="facing-col__content">
                <div class="facing-prose facing-prose--ar" lang="ar" dir="rtl">
                  <Fragment set:html={renderArabic(hadith.text_ar)} />
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Isnād Lineage (Chain of Transmission) -->
        {paths.size > 0 && (
          <section class="edition-section" aria-labelledby="isnad-heading">
            <div class="edition-section__head">
              <div class="edition-section__kicker">
                <span class="hc-eyebrow">Chain of Transmission</span>
              </div>
              <h2 class="edition-section__title" id="isnad-heading">Transmission Lineage (الإسناد)</h2>
              <p class="edition-section__desc">
                Ordered from the source outward: Tier 1 represents the earliest authority (Companion / Successor), descending through transmitters to the compiler. Click any transmitter to inspect their biographical dossier and jarḥ wa taʿdīl records.
              </p>
            </div>

            <div class="isnad-lineages-stack">
              {[...paths.entries()].map(([idx, nodes]) => (
                <div class="isnad-flow-card">
                  <div class="isnad-flow-card__head">
                    <div class="isnad-flow-card__title-row">
                      <span class="isnad-flow-card__title">Isnād Path {idx + 1}</span>
                      <span class="isnad-flow-card__count">{nodes.length} Transmitters in Sequence</span>
                    </div>
                    <div class="isnad-flow-card__guide">
                      <span class="isnad-guide-node isnad-guide-node--source">Source (Earliest)</span>
                      <span class="isnad-guide-arrow">↓</span>
                      <span class="isnad-guide-node">Intermediaries</span>
                      <span class="isnad-guide-arrow">↓</span>
                      <span class="isnad-guide-node isnad-guide-node--compiler">Collector</span>
                    </div>
                  </div>

                  <ol class="isnad-ladder">
                    {nodes.map((node, i) => {
                      const isFirst = i === 0;
                      const isLast = i === nodes.length - 1;

                      return (
                        <li class:list={['isnad-step', { 'is-source': isFirst, 'is-compiler': isLast }]}>
                          <div class="isnad-stem-track">
                            <span class="isnad-node-badge">{i + 1}</span>
                            {!isLast && (
                              <div class="isnad-stem-line" aria-hidden="true">
                                <span class="isnad-stem-connector"></span>
                                <span class="isnad-verb-pill" lang="ar" title="Transmission connection">عن</span>
                              </div>
                            )}
                          </div>

                          <div class="isnad-step-body">
                            <div class="isnad-step-main">
                              <div class="isnad-step-role-wrap">
                                {isFirst ? (
                                  <span class="isnad-role-badge isnad-role-badge--source">Earliest Authority · Source</span>
                                ) : isLast ? (
                                  <span class="isnad-role-badge isnad-role-badge--compiler">Collector · Compiler</span>
                                ) : (
                                  <span class="isnad-role-badge">Transmission Link {i + 1}</span>
                                )}
                              </div>
                              {node.narrator_id ? (
                                <a class="isnad-step-name" href={`/narrators/${node.narrator_id}`}>
                                  {node.name_en || node.name}
                                </a>
                              ) : (
                                <div class="isnad-step-unresolved">
                                  <span class="isnad-step-name is-unlinked">{node.name || 'Unidentified'}</span>
                                  <span class="isnad-unresolved-tag">Unresolved in Biographical Register</span>
                                </div>
                              )}
                            </div>

                            <div class="isnad-step-meta">
                              {node.death_hijri && (
                                <span class="isnad-death-badge">d. {node.death_hijri} AH</span>
                              )}
                              {node.narrator_id && (
                                <a class="isnad-dossier-link" href={`/narrators/${node.narrator_id}`}>
                                  <span>Dossier</span>
                                  <span class="isnad-dossier-arrow">→</span>
                                </a>
                              )}
                            </div>
                          </div>
                        </li>
                      );
                    })}
                  </ol>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Critical Apparatus & Classification -->
        {(totalParallels > 0 || glosses.length > 0 || subjects.length > 0) && (
          <section class="edition-section" aria-labelledby="apparatus-heading">
            <div class="edition-section__head">
              <div class="edition-section__kicker">
                <span class="hc-eyebrow">Editorial Apparatus</span>
              </div>
              <h2 class="edition-section__title" id="apparatus-heading">Critical Apparatus &amp; Classification</h2>
              <p class="edition-section__desc">
                Corroborating witness indices, editorial vocabulary glosses, and subject classification tags. Attestation counts measure circulation in the corpus, not theological authenticity.
              </p>
            </div>

            <div class="apparatus-grid">
              {totalParallels > 0 && (
                <div class="apparatus-panel">
                  <div class="apparatus-panel__header">
                    <h3 class="apparatus-panel__title">Cross-Attestation Network</h3>
                    <span class="apparatus-panel__badge">{totalParallels.toLocaleString()} occurrences</span>
                  </div>
                  <p class="apparatus-panel__note">
                    Cross-referenced across parallel lines and corroborating witness narrations in the corpus:
                  </p>

                  <div class="apparatus-stats-stack">
                    <div class="apparatus-stat-row">
                      <div class="apparatus-stat-info">
                        <span class="apparatus-stat-name">Parallels (متابعات)</span>
                        <span class="apparatus-stat-desc">Same companion report through alternative transmission lines</span>
                      </div>
                      <span class="apparatus-stat-count">{Number(hadith.parallel_count || 0).toLocaleString()}</span>
                    </div>

                    <div class="apparatus-stat-row">
                      <div class="apparatus-stat-info">
                        <span class="apparatus-stat-name">Witnesses (شواهد)</span>
                        <span class="apparatus-stat-desc">Corroborating testimonies transmitted through distinct companions</span>
                      </div>
                      <span class="apparatus-stat-count">{Number(hadith.witness_count || 0).toLocaleString()}</span>
                    </div>

                    <div class="apparatus-stat-row">
                      <div class="apparatus-stat-info">
                        <span class="apparatus-stat-name">Variants (روايات وألفاظ)</span>
                        <span class="apparatus-stat-desc">Documented manuscript wording, expansion, and phrasing variations</span>
                      </div>
                      <span class="apparatus-stat-count">{Number(hadith.variant_count || 0).toLocaleString()}</span>
                    </div>
                  </div>
                </div>
              )}

              {glosses.length > 0 && (
                <div class="apparatus-panel">
                  <div class="apparatus-panel__header">
                    <h3 class="apparatus-panel__title">Gharīb Vocabulary (غريب الحديث)</h3>
                    <span class="apparatus-panel__badge">{glosses.length} terms</span>
                  </div>
                  <p class="apparatus-panel__note">Lexicographical explanations for archaic Arabic expressions:</p>

                  <dl class="gloss-ledger">
                    {glosses.map((g) => (
                      <div class="gloss-entry">
                        <dt lang="ar" dir="rtl" class="gloss-entry__term">{g.word_ar}</dt>
                        <dd class="gloss-entry__def">{g.word_en}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}

              {subjects.length > 0 && (
                <div class="apparatus-panel">
                  <div class="apparatus-panel__header">
                    <h3 class="apparatus-panel__title">Subject Classifications</h3>
                    <span class="apparatus-panel__badge">{subjects.length} topics</span>
                  </div>
                  <p class="apparatus-panel__note">Thematic categories assigned in traditional indexing:</p>

                  <div class="subjects-cloud">
                    {subjects.map((s) => (
                      <a class="subject-chip" href={`/hadith?subject=${encodeURIComponent(s.label_en)}`}>
                        <span class="subject-chip__text">{s.label_en}</span>
                        <span class="subject-chip__arrow">→</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </section>
        )}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .hadith-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5.5rem;
  }

  /* ── Critical Edition Masthead Plate ───────────────────────── */
  .edition-hero {
    position: relative;
    padding: 2.25rem 2.5rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    background-image: radial-gradient(circle at 95% 5%, color-mix(in srgb, var(--hc-gold) 6%, transparent) 0%, transparent 60%);
  }

  .edition-hero::before {
    content: "";
    position: absolute;
    inset: 6px;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 1px;
    pointer-events: none;
    opacity: 0.6;
  }

  /* Illuminated Corner Ornaments */
  .edition-hero__frame-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    pointer-events: none;
    z-index: 2;
  }

  .edition-hero__frame-corner--tl {
    top: 6px;
    left: 6px;
    border-top: 2px solid var(--hc-gold);
    border-left: 2px solid var(--hc-gold);
  }

  .edition-hero__frame-corner--tr {
    top: 6px;
    right: 6px;
    border-top: 2px solid var(--hc-gold);
    border-right: 2px solid var(--hc-gold);
  }

  .edition-hero__frame-corner--bl {
    bottom: 6px;
    left: 6px;
    border-bottom: 2px solid var(--hc-gold);
    border-left: 2px solid var(--hc-gold);
  }

  .edition-hero__frame-corner--br {
    bottom: 6px;
    right: 6px;
    border-bottom: 2px solid var(--hc-gold);
    border-right: 2px solid var(--hc-gold);
  }

  .edition-hero__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .edition-hero__ref-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .edition-ref-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--hc-text-secondary);
  }

  .edition-ref-tag--gold {
    border-color: color-mix(in srgb, var(--hc-gold) 45%, transparent);
    color: var(--hc-gold);
    background: color-mix(in srgb, var(--hc-gold) 10%, var(--hc-surface-2));
  }

  .edition-hero__titles {
    margin-bottom: 1.6rem;
    position: relative;
    z-index: 1;
  }

  .edition-hero__title-ar {
    margin: 0 0 0.5rem;
    font-family: var(--font-arabic);
    font-size: clamp(1.45rem, 3.2vw, 1.95rem);
    line-height: 2.1;
    color: var(--hc-gold);
    direction: rtl;
  }

  .edition-hero__title-en {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 4.2vw, 2.75rem);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: -0.015em;
    color: var(--hc-text-primary);
  }

  /* ── Archival Ledger Strip ─────────────────────────────────── */
  .edition-ledger-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.25rem;
    padding: 1.1rem 0;
    margin-bottom: 1.5rem;
    border-top: 1px solid var(--hc-rule-soft);
    border-bottom: 1px solid var(--hc-rule-soft);
    position: relative;
    z-index: 1;
  }

  .edition-ledger-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
  }

  .edition-ledger-label {
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .edition-ledger-val {
    color: var(--hc-text-secondary);
    font-weight: 500;
  }

  .edition-ledger-val--link {
    color: var(--hc-gold);
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  .edition-ledger-val--link:hover {
    color: var(--hc-gold-bright);
    text-decoration: underline;
  }

  .edition-ledger-val--status {
    color: var(--hc-gold-dim);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* ── Section Jump Bar ──────────────────────────────────────── */
  .edition-jump-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-top: 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--hc-rule-soft);
    position: relative;
    z-index: 1;
  }

  .edition-jump-bar__label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .edition-jump-bar__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .edition-jump-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--hc-text-secondary);
    text-decoration: none;
    transition: border-color var(--motion-fast) ease, color var(--motion-fast) ease, background var(--motion-fast) ease;
  }

  .edition-jump-link:hover {
    border-color: var(--hc-gold);
    color: var(--hc-gold);
    background: var(--hc-surface-3);
  }

  .edition-jump-link__tag {
    font-family: var(--font-arabic);
    font-size: 0.82rem;
    color: var(--hc-gold-dim);
  }

  .edition-jump-link__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.35rem;
    border-radius: 9999px;
    background: var(--hc-surface-3);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--hc-gold);
  }

  /* ── Section Commons ───────────────────────────────────────── */
  .edition-section {
    margin-top: 3.75rem;
  }

  .edition-section__head {
    margin-bottom: 1.75rem;
  }

  .edition-section__kicker {
    margin-bottom: 0.45rem;
  }

  .edition-section__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.8vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--hc-text-primary);
  }

  .edition-section__desc {
    margin: 0;
    max-width: 74ch;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--hc-text-secondary);
  }

  /* ── Facing Spread (Critical Edition Layout) ───────────────── */
  .facing-spread {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    position: relative;
    align-items: stretch;
  }

  .facing-col {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    overflow: hidden;
  }

  .facing-col--en {
    grid-column: 1;
    grid-row: 1;
  }

  .facing-col--ar {
    grid-column: 2;
    grid-row: 1;
    border-color: color-mix(in srgb, var(--hc-rule) 65%, var(--hc-rule-soft));
  }

  .facing-col__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1.35rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    background: var(--hc-surface-2);
  }

  .facing-col__label-group {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .facing-col__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .facing-col__dot--en {
    background: var(--hc-text-tertiary);
  }

  .facing-col__dot--ar {
    background: var(--hc-gold);
  }

  .facing-col__lang-label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .facing-col__lang-label--ar {
    font-family: var(--font-arabic);
    font-size: 0.95rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--hc-gold);
    direction: rtl;
  }

  .facing-col__caveat,
  .facing-col__folio-note {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--hc-text-tertiary);
  }

  .facing-col__content {
    padding: 1.75rem 1.85rem;
    flex: 1 1 auto;
  }

  /* Distinct visual emphasis for the prophetic matn spread */
  .facing-spread--matn .facing-col--en .facing-col__content {
    border-inline-start: 3px solid var(--hc-gold);
  }

  .facing-spread--matn .facing-col--ar .facing-col__content {
    border-inline-end: 3px solid var(--hc-gold);
  }

  .facing-prose {
    margin: 0;
  }

  .facing-prose--en {
    font-family: var(--font-body);
    font-size: 1.06rem;
    line-height: 1.9;
    color: var(--hc-text-primary);
  }

  .facing-prose--ar {
    font-family: var(--font-arabic);
    font-size: 1.4rem;
    line-height: 2.24;
    color: var(--hc-text-primary);
    direction: rtl;
  }

  .facing-prose--empty {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--hc-text-tertiary);
  }

  .facing-prose :global(em) {
    font-style: italic;
    color: var(--hc-text-secondary);
  }

  .facing-prose :global(strong) {
    font-weight: 600;
    color: var(--hc-gold);
  }

  .facing-prose :global(.folio) {
    display: inline-block;
    margin: 0 0.35em;
    padding: 0.1em 0.45em;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1.45;
    color: var(--hc-gold-dim);
    vertical-align: 0.08em;
    cursor: help;
  }

  /* ── Isnād Transmission Lineage ────────────────────────────── */
  .isnad-lineages-stack {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .isnad-flow-card {
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    overflow: hidden;
  }

  .isnad-flow-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    background: var(--hc-surface-2);
  }

  .isnad-flow-card__title-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .isnad-flow-card__title {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .isnad-flow-card__count {
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--hc-text-tertiary);
  }

  .isnad-flow-card__guide {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
  }

  .isnad-guide-node {
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
    background: var(--hc-surface-3);
  }

  .isnad-guide-node--source {
    color: var(--hc-gold);
  }

  .isnad-guide-node--compiler {
    color: var(--hc-text-primary);
  }

  .isnad-guide-arrow {
    color: var(--hc-rule);
    font-size: 0.8rem;
  }

  .isnad-ladder {
    list-style: none;
    margin: 0;
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .isnad-step {
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
    position: relative;
    padding: 0.65rem 0;
  }

  .isnad-stem-track {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 28px;
    flex-shrink: 0;
    position: relative;
  }

  .isnad-node-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--hc-text-secondary);
    z-index: 1;
    transition: border-color var(--motion-fast) ease, color var(--motion-fast) ease;
  }

  .isnad-step.is-source .isnad-node-badge {
    border-color: var(--hc-gold);
    color: var(--hc-gold);
    background: color-mix(in srgb, var(--hc-gold) 12%, var(--hc-surface-2));
  }

  .isnad-step.is-compiler .isnad-node-badge {
    border-color: color-mix(in srgb, var(--hc-text-primary) 40%, var(--hc-rule-soft));
    color: var(--hc-text-primary);
    background: var(--hc-surface-3);
  }

  .isnad-stem-line {
    position: absolute;
    top: 28px;
    bottom: -14px;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 0;
  }

  .isnad-stem-connector {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--hc-rule-soft);
  }

  .isnad-verb-pill {
    position: relative;
    z-index: 1;
    margin-top: auto;
    margin-bottom: auto;
    padding: 0.05rem 0.32rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 2px;
    background: var(--hc-surface-1);
    font-family: var(--font-arabic);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--hc-gold-dim);
  }

  .isnad-step-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    min-width: 0;
    gap: 1rem;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-xs);
    transition: background var(--motion-fast) ease;
  }

  .isnad-step:hover .isnad-step-body {
    background: var(--hc-surface-2);
  }

  .isnad-step-main {
    min-width: 0;
  }

  .isnad-step-role-wrap {
    margin-bottom: 0.25rem;
  }

  .isnad-role-badge {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 2px;
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .isnad-role-badge--source {
    border-color: color-mix(in srgb, var(--hc-gold) 40%, transparent);
    color: var(--hc-gold);
    background: color-mix(in srgb, var(--hc-gold) 8%, var(--hc-surface-2));
  }

  .isnad-role-badge--compiler {
    border-color: color-mix(in srgb, var(--hc-text-primary) 30%, transparent);
    color: var(--hc-text-primary);
    background: var(--hc-surface-3);
  }

  .isnad-step-name {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--hc-text-primary);
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  .isnad-step-name:hover {
    color: var(--hc-gold);
  }

  .isnad-step-name.is-unlinked {
    color: var(--hc-text-secondary);
  }

  .isnad-step-unresolved {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .isnad-unresolved-tag {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-style: italic;
    color: var(--hc-text-tertiary);
  }

  .isnad-step-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .isnad-death-badge {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--hc-text-tertiary);
  }

  .isnad-dossier-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--hc-gold);
    text-decoration: none;
    transition: border-color var(--motion-fast) ease, background var(--motion-fast) ease, gap var(--motion-fast) var(--ease-standard);
  }

  .isnad-dossier-link:hover {
    border-color: var(--hc-gold);
    background: var(--hc-surface-2);
    gap: 0.55rem;
  }

  .isnad-dossier-arrow {
    font-size: 0.85rem;
  }

  /* ── Critical Apparatus Grid ───────────────────────────────── */
  .apparatus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.5rem;
  }

  .apparatus-panel {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.75rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
  }

  .apparatus-panel__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .apparatus-panel__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--hc-text-primary);
  }

  .apparatus-panel__badge {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--hc-text-tertiary);
  }

  .apparatus-panel__note {
    margin: 0 0 1.25rem;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--hc-text-tertiary);
  }

  /* Apparatus Stats Stack */
  .apparatus-stats-stack {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .apparatus-stat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    transition: border-color var(--motion-fast) ease, background var(--motion-fast) ease;
  }

  .apparatus-stat-row:hover {
    border-color: color-mix(in srgb, var(--hc-gold) 40%, var(--hc-rule-soft));
    background: var(--hc-surface-3);
  }

  .apparatus-stat-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .apparatus-stat-name {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--hc-text-primary);
  }

  .apparatus-stat-desc {
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--hc-text-tertiary);
  }

  .apparatus-stat-count {
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--hc-gold);
    flex-shrink: 0;
  }

  /* Gloss Ledger */
  .gloss-ledger {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .gloss-entry {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .gloss-entry:last-child {
    border-bottom: none;
  }

  .gloss-entry__term {
    font-family: var(--font-arabic);
    font-size: 1.25rem;
    line-height: 2.1;
    color: var(--hc-gold);
    direction: rtl;
    flex-shrink: 0;
  }

  .gloss-entry__def {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--hc-text-secondary);
    text-align: right;
  }

  /* Subjects Cloud */
  .subjects-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .subject-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--hc-text-secondary);
    text-decoration: none;
    transition: border-color var(--motion-fast) ease, color var(--motion-fast) ease, background var(--motion-fast) ease, gap var(--motion-fast) var(--ease-standard);
  }

  .subject-chip:hover {
    border-color: var(--hc-gold);
    color: var(--hc-gold);
    background: var(--hc-surface-3);
    gap: 0.65rem;
  }

  .subject-chip__arrow {
    font-size: 0.8rem;
    color: var(--hc-gold-dim);
  }

  /* ── Degraded State Notice ─────────────────────────────────── */
  .hadith-degraded {
    padding: 3.5rem 2rem;
    margin: 2.5rem auto;
    max-width: 44rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    text-align: center;
  }

  .hadith-degraded__badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold);
    background: var(--hc-surface-2);
  }

  .hadith-degraded__title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 500;
    color: var(--hc-text-primary);
  }

  .hadith-degraded__text {
