---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { entityPage, OG } from '../../lib/seo';
import { db } from '../../lib/db';
import { renderRich, renderArabic, toPlainText } from '../../lib/format-text';
import { CORPUS_CACHE_CONTROL } from '../../lib/edge-cache';

/**
 * Flagship Critical Edition Record for a Single Narration.
 * Features an authentic archival plate, sticky section navigation with active scrollspy,
 * facing primary text, a connected isnād transmission graph with biographical dossier
 * integration, and a tripartite critical apparatus.
 */

const id = Number(Astro.params.id);
if (!Number.isFinite(id) || id <= 0) {
  return new Response('Not found', { status: 404 });
}

let hadithRow, chainRows, subjectRows, glossRows;
let dbError = false;

try {
  [hadithRow, chainRows, subjectRows, glossRows] = await db.batch([
    db.prepare(
      `SELECT h.*, b.title_ar AS book_ar, b.title_en AS book_en,
              b.id AS book_id, b.slug AS book_slug
         FROM hadith h JOIN hadith_book b ON b.id = h.book_id WHERE h.id = ?`
    ).bind(id),
    db.prepare(
      `SELECT c.path_idx, c.pos, c.narrator_id, c.name,
              n.name_en, n.death_hijri
         FROM hadith_chain c
         LEFT JOIN narrator n ON n.id = c.narrator_id
        WHERE c.hadith_id = ? ORDER BY c.path_idx, c.pos`
    ).bind(id),
    db.prepare('SELECT label_ar, label_en FROM hadith_subject WHERE hadith_id = ?').bind(id),
    db.prepare('SELECT word_ar, word_en FROM hadith_gloss WHERE hadith_id = ?').bind(id)
  ]);
} catch (error) {
  console.error(`Hadith ${id} failed to load`, error);
  dbError = true;
}

const hadith = hadithRow?.results?.[0] as Record<string, any> | undefined;

if (!dbError && !hadith) {
  return new Response('Hadith not found', { status: 404 });
}

if (!dbError) {
  Astro.response.headers.set('Cache-Control', CORPUS_CACHE_CONTROL);
}

interface ChainNode {
  path_idx: number;
  pos: number;
  narrator_id: number | null;
  name: string;
  name_en: string | null;
  death_hijri: number | null;
}

const chain = (chainRows?.results || []) as unknown as ChainNode[];
const rawSubjects = (subjectRows?.results || []) as unknown as { label_ar: string; label_en: string }[];
const glosses = (glossRows?.results || []) as unknown as { word_ar: string; word_en: string }[];

// Deduplicate subject taxonomy
const subjects = [...new Map(rawSubjects.map((s) => [s.label_en.trim(), s])).values()];

// Group transmission branches
const paths = new Map<number, ChainNode[]>();
for (const node of chain) {
  if (!paths.has(node.path_idx)) paths.set(node.path_idx, []);
  paths.get(node.path_idx)!.push(node);
}

const chapter = hadith ? toPlainText(hadith.chapter_en) : '';
const ref = hadith ? `${hadith.book_en}${hadith.hadith_num ? ` № ${hadith.hadith_num}` : ''}` : `Hadith #${id}`;
const pageTitle = hadith ? `${ref} · Hadith ${id} | HadithCritic Critical Edition` : `Hadith #${id} | HadithCritic`;
const summary = hadith ? toPlainText(hadith.matn_en || hadith.text_en).slice(0, 180) : '';

const matnIsDistinct = hadith
  ? Boolean(hadith.matn_ar) && String(hadith.matn_ar).trim() !== String(hadith.text_ar).trim()
  : false;

const totalParallels = hadith
  ? Number(hadith.parallel_count || 0) +
    Number(hadith.witness_count || 0) +
    Number(hadith.variant_count || 0)
  : 0;
---

<BaseLayout
  title={pageTitle}
  description={summary || 'A primary source narration in Arabic and English from the Hadith Critical Archive.'}
  image={hadith ? OG.collection(hadith.book_slug) : undefined}
  imageAlt={hadith ? `${hadith.book_en}${hadith.hadith_num ? ` ${hadith.hadith_num}` : ''} · Hadith ${id}` : undefined}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Corpus', url: '/hadith' },
    ...(hadith ? [{ name: hadith.book_en, url: `/hadith/collection/${hadith.book_slug}` }] : []),
    { name: ref, url: `/hadith/${id}` }
  ]}
  schema={hadith ? [
    entityPage({
      url: `${Astro.site}hadith/${id}`,
      title: pageTitle,
      description: summary,
      entityId: `${Astro.site}hadith/${id}#hadith`
    })
  ] : []}
>
  <div class="hadith-container">
    {dbError || !hadith ? (
      <div class="hadith-degraded">
        <span class="hadith-degraded__badge">Database Unavailable</span>
        <h1 class="hadith-degraded__title">Narration #{id} Temporarily Unreachable</h1>
        <p class="hadith-degraded__text">
          The corpus database is handling elevated load. The report can still be accessed directly via collection registers or the offline worker index.
        </p>
        <div class="hadith-degraded__actions">
          <a class="hc-btn" href="/hadith">← Return to Corpus Index</a>
        </div>
      </div>
    ) : (
      <>
        <!-- Archival Critical Edition Plate -->
        <header class="edition-hero">
          <div class="edition-hero__topbar">
            <a class="hc-back-link" href={`/hadith/collection/${hadith.book_slug}`}>
              <span>←</span>
              <span>{hadith.book_en}</span>
            </a>

            <div class="edition-hero__badges">
              {hadith.hadith_num && (
                <span class="edition-ref-tag edition-ref-tag--gold">№ {hadith.hadith_num}</span>
              )}
              <span class="edition-ref-tag">Record ID #{id}</span>
              <span class="edition-ref-tag edition-ref-tag--status">Critical Edition</span>
            </div>
          </div>

          <div class="edition-hero__titles">
            {hadith.book_ar && (
              <p class="edition-hero__title-ar" lang="ar" dir="rtl">{hadith.book_ar}</p>
            )}
            <h1 class="edition-hero__title-en">{chapter || hadith.book_en}</h1>
          </div>

          <!-- Structured Research Ledger -->
          <div class="edition-ledger-grid">
            <div class="ledger-block">
              <span class="ledger-block__label">Bibliographic Citation</span>
              <div class="ledger-block__value">
                <a href={`/hadith/collection/${hadith.book_slug}`} class="ledger-link">
                  {hadith.book_en}
                </a>
                {hadith.hadith_num && <span class="ledger-meta">· Report № {hadith.hadith_num}</span>}
              </div>
            </div>

            <div class="ledger-block">
              <span class="ledger-block__label">Transmission Topology</span>
              <div class="ledger-block__value">
                <span>{paths.size} Lineage {paths.size === 1 ? 'Path' : 'Paths'}</span>
                <span class="ledger-meta">· {hadith.narrator_count} Transmitters</span>
              </div>
            </div>

            <div class="ledger-block">
              <span class="ledger-block__label">Apparatus Circulation</span>
              <div class="ledger-block__value">
                <span>{totalParallels.toLocaleString()} Cross-Attestations</span>
                <span class="ledger-meta">· {hadith.parallel_count || 0} Parallels</span>
              </div>
            </div>

            <div class="ledger-block ledger-block--action">
              <span class="ledger-block__label">Permanent Reference</span>
              <button
                type="button"
                class="edition-cite-btn"
                id="edition-cite-btn"
                data-citation={`${ref} — HadithCritic Corpus Record #${id}`}
                hidden
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span data-cite-label>Copy Citation</span>
              </button>
            </div>
          </div>
        </header>

        <!-- Sticky Interactive Section Navigation -->
        <nav class="edition-nav-dock" aria-label="Record Sections" id="edition-jump-bar">
          <div class="edition-nav-dock__inner">
            <span class="edition-nav-dock__label">Sections:</span>
            <div class="edition-nav-dock__links">
              {matnIsDistinct && (
                <a href="#matn-heading" class="dock-link">
                  <span>Substantive Matn</span>
                  <span class="dock-link__ar" lang="ar">المتن</span>
                </a>
              )}
              <a href="#report-heading" class="dock-link">
                <span>Full Transmission</span>
                <span class="dock-link__ar" lang="ar">الرواية الكاملة</span>
              </a>
              {paths.size > 0 && (
                <a href="#isnad-heading" class="dock-link">
                  <span>Isnād Transmission Graph</span>
                  <span class="dock-link__count">{paths.size}</span>
                </a>
              )}
              {(totalParallels > 0 || glosses.length > 0 || subjects.length > 0) && (
                <a href="#apparatus-heading" class="dock-link">
                  <span>Critical Apparatus</span>
                </a>
              )}
            </div>
          </div>
        </nav>

        <!-- Prophetic Matn (Substantive Speech) -->
        {matnIsDistinct && (
          <section class="record-section" aria-labelledby="matn-heading">
            <div class="record-section__header">
              <div class="record-section__kicker">
                <span class="hc-eyebrow">Textual Artifact · Primary Speech</span>
              </div>
              <h2 class="record-section__title" id="matn-heading">Substantive Matn (المتن)</h2>
              <p class="record-section__desc">
                The operative verdict or substantive prophetic utterance, isolated from introductory transmission formulas for comparative text-critical analysis.
              </p>
            </div>

            <div class="critical-spread critical-spread--matn">
              <div class="critical-col critical-col--en">
                <div class="critical-col__header">
                  <div class="critical-col__tag">
                    <span class="critical-col__dot critical-col__dot--en" aria-hidden="true"></span>
                    <span>English Translation</span>
                  </div>
                  <span class="critical-col__caveat">Descriptive machine rendering · Unreviewed</span>
                </div>
                <div class="critical-col__prose">
                  {hadith.matn_en ? (
                    <div class="facing-prose facing-prose--en">
                      <Fragment set:html={renderRich(hadith.matn_en)} />
                    </div>
                  ) : (
                    <p class="facing-prose--empty">No distinct translation recorded for this matn isolation.</p>
                  )}
                </div>
              </div>

              <div class="critical-col critical-col--ar">
                <div class="critical-col__header">
                  <div class="critical-col__tag">
                    <span class="critical-col__dot critical-col__dot--ar" aria-hidden="true"></span>
                    <span lang="ar" dir="rtl">نص المتن المجرد</span>
                  </div>
                  <span class="critical-col__folio">النص المعتمد</span>
                </div>
                <div class="critical-col__prose">
                  <div class="facing-prose facing-prose--ar" lang="ar" dir="rtl">
                    <Fragment set:html={renderArabic(hadith.matn_ar)} />
                  </div>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Full Formulation & Transmission Context -->
        <section class="record-section" aria-labelledby="report-heading">
          <div class="record-section__header">
            <div class="record-section__kicker">
              <span class="hc-eyebrow">Manuscript Formulation</span>
            </div>
            <h2 class="record-section__title" id="report-heading">Full Formulation &amp; Opening Formulas</h2>
            <p class="record-section__desc">
              The narration as committed to manuscript: includes compiler opening verbs, transmission preambles (حدثنا / أخبرنا), transmitter chains, and substantive text.
            </p>
          </div>

          <div class="critical-spread">
            <div class="critical-col critical-col--en">
              <div class="critical-col__header">
                <div class="critical-col__tag">
                  <span class="critical-col__dot critical-col__dot--en" aria-hidden="true"></span>
                  <span>English Translation</span>
                </div>
                <span class="critical-col__caveat">Complete manuscript text</span>
              </div>
              <div class="critical-col__prose">
                {hadith.text_en ? (
                  <div class="facing-prose facing-prose--en">
                    <Fragment set:html={renderRich(hadith.text_en)} />
                  </div>
                ) : (
                  <p class="facing-prose--empty">Translation not registered for this manuscript formulation.</p>
                )}
              </div>
            </div>

            <div class="critical-col critical-col--ar">
              <div class="critical-col__header">
                <div class="critical-col__tag">
                  <span class="critical-col__dot critical-col__dot--ar" aria-hidden="true"></span>
                  <span lang="ar" dir="rtl">الرواية المسندة في المصنف</span>
                </div>
                <span class="critical-col__folio">الأصل العربي</span>
              </div>
              <div class="critical-col__prose">
                <div class="facing-prose facing-prose--ar" lang="ar" dir="rtl">
                  <Fragment set:html={renderArabic(hadith.text_ar)} />
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Isnād Lineage (Transmission Graph) -->
        {paths.size > 0 && (
          <section class="record-section" aria-labelledby="isnad-heading">
            <div class="record-section__header">
              <div class="record-section__kicker">
                <span class="hc-eyebrow">Transmitter Lineage</span>
              </div>
              <h2 class="record-section__title" id="isnad-heading">Transmission Graph &amp; Rijal Register (الإسناد)</h2>
              <p class="record-section__desc">
                Ordered chronologically from earliest authority outward to compiler. Click any transmitter to examine their biographical dossier, teacher/student associations, and historical evaluations.
              </p>
            </div>

            <div class="isnad-graph-stack">
              {[...paths.entries()].map(([idx, nodes]) => (
                <div class="isnad-path-card">
                  <div class="isnad-path-card__header">
                    <div class="isnad-path-card__title-wrap">
                      <span class="isnad-path-badge">Lineage Branch {idx + 1}</span>
                      <span class="isnad-path-count">{nodes.length} Transmitters in Direct Succession</span>
                    </div>

                    <div class="isnad-flow-legend">
                      <span class="legend-step legend-step--source">Earliest Authority</span>
                      <span class="legend-sep">↓</span>
                      <span class="legend-step">Intermediate Links</span>
                      <span class="legend-sep">↓</span>
                      <span class="legend-step legend-step--compiler">Final Collector</span>
                    </div>
                  </div>

                  <ol class="isnad-chain-ladder">
                    {nodes.map((node, i) => {
                      const isFirst = i === 0;
                      const isLast = i === nodes.length - 1;

                      return (
                        <li
                          class:list={['ladder-node hc-reveal', { 'is-source': isFirst, 'is-compiler': isLast }]}
                          style={`--reveal-delay:${Math.min(i, 8)}`}
                        >
                          <div class="ladder-spine">
                            <span class="ladder-spine__circle">{i + 1}</span>
                            {!isLast && (
                              <div class="ladder-spine__connector" aria-hidden="true">
                                <span class="ladder-spine__line"></span>
                                <span class="ladder-verb" lang="ar" title="Transmission connection formula">عن</span>
                              </div>
                            )}
                          </div>

                          <div class="ladder-card">
                            <div class="ladder-card__content">
                              <div class="ladder-card__role">
                                {isFirst ? (
                                  <span class="role-pill role-pill--source">Earliest Authority · Source</span>
                                ) : isLast ? (
                                  <span class="role-pill role-pill--compiler">Compiler · Collector</span>
                                ) : (
                                  <span class="role-pill">Intermediate Transmitter #{i + 1}</span>
                                )}
                              </div>

                              {node.narrator_id ? (
                                <a class="ladder-card__name" href={`/narrators/${node.narrator_id}`}>
                                  {node.name_en || node.name}
                                </a>
                              ) : (
                                <div class="ladder-card__unresolved">
                                  <span class="ladder-card__name is-unlinked">{node.name || 'Unidentified Transmitter'}</span>
                                  <span class="unresolved-badge">Unresolved in Register</span>
                                </div>
                              )}
                            </div>

                            <div class="ladder-card__meta">
                              {node.death_hijri && (
                                <span class="death-tag">d. {node.death_hijri} AH</span>
                              )}
                              {node.narrator_id && (
                                <a class="dossier-button" href={`/narrators/${node.narrator_id}`}>
                                  <span>Dossier</span>
                                  <span class="dossier-arrow">→</span>
                                </a>
                              )}
                            </div>
                          </div>
                        </li>
                      );
                    })}
                  </ol>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Critical Apparatus & Indexing -->
        {(totalParallels > 0 || glosses.length > 0 || subjects.length > 0) && (
          <section class="record-section" aria-labelledby="apparatus-heading">
            <div class="record-section__header">
              <div class="record-section__kicker">
                <span class="hc-eyebrow">Text-Critical Apparatus</span>
              </div>
              <h2 class="record-section__title" id="apparatus-heading">Apparatus, Lexicon &amp; Taxonomy</h2>
              <p class="record-section__desc">
                Cross-attestation statistics indicate circulation across canonical compilations. Vocabulary notes isolate archaic terminology.
              </p>
            </div>

            <div class="apparatus-grid">
              {totalParallels > 0 && (
                <div class="apparatus-card hc-reveal" style="--reveal-delay:0">
                  <div class="apparatus-card__header">
                    <h3 class="apparatus-card__title">Cross-Attestation Network</h3>
                    <span class="apparatus-card__count">{totalParallels.toLocaleString()} Occurrences</span>
                  </div>
                  <p class="apparatus-card__note">
                    Documented circulation of this narration across parallel paths and corroborating witnesses:
                  </p>

                  <div class="circulation-list">
                    <div class="circulation-item">
                      <div class="circulation-item__meta">
                        <span class="circulation-item__title">Parallels (متابعات)</span>
                        <span class="circulation-item__desc">Identical companion report transmitted through alternate transmission branches</span>
                      </div>
                      <span class="circulation-item__num">{Number(hadith.parallel_count || 0).toLocaleString()}</span>
                    </div>

                    <div class="circulation-item">
                      <div class="circulation-item__meta">
                        <span class="circulation-item__title">Witnesses (شواهد)</span>
                        <span class="circulation-item__desc">Corroborating reports transmitted through distinct companion witnesses</span>
                      </div>
                      <span class="circulation-item__num">{Number(hadith.witness_count || 0).toLocaleString()}</span>
                    </div>

                    <div class="circulation-item">
                      <div class="circulation-item__meta">
                        <span class="circulation-item__title">Manuscript Variants (روايات وألفاظ)</span>
                        <span class="circulation-item__desc">Recorded wording, expansion, and phrasing variants across codices</span>
                      </div>
                      <span class="circulation-item__num">{Number(hadith.variant_count || 0).toLocaleString()}</span>
                    </div>
                  </div>
                </div>
              )}

              {glosses.length > 0 && (
                <div class="apparatus-card hc-reveal" style="--reveal-delay:1">
                  <div class="apparatus-card__header">
                    <h3 class="apparatus-card__title">Gharīb Vocabulary (غريب الحديث)</h3>
                    <span class="apparatus-card__count">{glosses.length} Terms</span>
                  </div>
                  <p class="apparatus-card__note">Lexicographical commentary on archaic or specialized terms:</p>

                  <dl class="lexicon-ledger">
                    {glosses.map((g) => (
                      <div class="lexicon-entry">
                        <dt lang="ar" dir="rtl" class="lexicon-entry__ar">{g.word_ar}</dt>
                        <dd class="lexicon-entry__en">{g.word_en}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}

              {subjects.length > 0 && (
                <div class="apparatus-card hc-reveal" style="--reveal-delay:2">
                  <div class="apparatus-card__header">
                    <h3 class="apparatus-card__title">Controlled Subject Taxonomy</h3>
                    <span class="apparatus-card__count">{subjects.length} Categories</span>
                  </div>
                  <p class="apparatus-card__note">Thematic categories indexed for textual cross-referencing:</p>

                  <div class="subject-tags-grid">
                    {subjects.map((s) => (
                      <a class="subject-pill" href={`/hadith?subject=${encodeURIComponent(s.label_en)}`}>
                        <span>{s.label_en}</span>
                        <span class="subject-pill__arrow">→</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </section>
        )}
      </>
    )}
  </div>
</BaseLayout>

<script>
  // Progressive enhancement: In-page navigation scrollspy and citation clipboard
  const jumpBar = document.getElementById('edition-jump-bar');
  if (jumpBar) {
    const links = Array.from(jumpBar.querySelectorAll<HTMLAnchorElement>('.dock-link'));
    const targets = links
      .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href') || ''))
      .filter((el): el is HTMLElement => Boolean(el));

    if (targets.length) {
      const setActive = (targetId: string) => {
        for (const link of links) {
          link.classList.toggle('is-active', link.getAttribute('href') === `#${targetId}`);
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) setActive(visible[0].target.id);
        },
        { rootMargin: '-35% 0px -45% 0px', threshold: 0 }
      );
      targets.forEach((el) => observer.observe(el));
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const link of links) {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('href')?.slice(1);
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        history.pushState(null, '', `#${targetId}`);
      });
    }
  }

  const citeBtn = document.getElementById('edition-cite-btn') as HTMLButtonElement | null;
  if (citeBtn && navigator.clipboard) {
    citeBtn.hidden = false;
    const label = citeBtn.querySelector('[data-cite-label]');
    const originalLabel = label?.textContent || 'Copy Citation';
    citeBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(citeBtn.dataset.citation || '');
        citeBtn.dataset.copied = 'true';
        if (label) label.textContent = 'Copied to Clipboard ✓';
        setTimeout(() => {
          citeBtn.dataset.copied = 'false';
          if (label) label.textContent = originalLabel;
        }, 2200);
      } catch {
        // Fallback gracefully
      }
    });
  }
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .hadith-container {
    width: min(100% - 2rem, 88rem);
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.25rem) 0 7rem;
  }

  /* ─────────────── Hero / record identity ─────────────── */
  .edition-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--hc-rule);
    border-radius: 10px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--hc-surface-2) 54%, var(--hc-surface-1)), var(--hc-surface-1));
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.16);
  }

  .edition-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 92% 0%, color-mix(in srgb, var(--hc-gold) 8%, transparent), transparent 34rem);
    pointer-events: none;
  }

  .edition-hero__topbar,
  .edition-hero__titles,
  .edition-ledger-grid,
  .edition-nav-dock__inner,
  .record-section,
  .edition-hero .hc-stat-band {
    position: relative;
    z-index: 1;
  }

  .edition-hero__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem clamp(1rem, 2.7vw, 2rem);
    border-bottom: 1px solid var(--hc-rule-soft);
    background: color-mix(in srgb, var(--hc-surface-0) 38%, transparent);
  }

  .hc-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 40px;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--motion-fast) ease, gap var(--motion-fast) ease;
  }

  .hc-back-link:hover {
    color: var(--hc-gold);
    gap: 0.75rem;
  }

  .edition-hero__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .edition-ref-tag {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 999px;
    background: var(--hc-surface-2);
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .edition-ref-tag--gold {
    border-color: color-mix(in srgb, var(--hc-gold) 45%, transparent);
    background: color-mix(in srgb, var(--hc-gold) 9%, var(--hc-surface-2));
    color: var(--hc-gold);
  }

  .edition-ref-tag--status {
    color: var(--hc-gold-dim);
  }

  .edition-hero__titles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
    padding: clamp(2rem, 5vw, 3.4rem) clamp(1rem, 5vw, 4rem) clamp(1.75rem, 4vw, 2.75rem);
  }

  .edition-hero__title-ar {
    margin: 0;
    max-width: 60ch;
    font-family: var(--font-arabic);
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.9;
    color: var(--hc-gold);
    text-align: right;
    direction: rtl;
  }

  .edition-hero__title-en {
    max-width: 27ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.45rem);
    font-weight: 520;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--hc-text-primary);
  }

  .edition-ledger-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--hc-rule-soft);
  }

  .ledger-block {
    min-width: 0;
    padding: 1rem clamp(0.9rem, 2vw, 1.4rem) 1.1rem;
    border-right: 1px solid var(--hc-rule-soft);
  }

  .ledger-block:last-child {
    border-right: 0;
  }

  .ledger-block__label {
    display: block;
    margin-bottom: 0.38rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .ledger-block__value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.83rem;
    line-height: 1.45;
    color: var(--hc-text-secondary);
  }

  .ledger-link {
    color: var(--hc-gold);
    font-weight: 700;
    text-decoration: none;
  }

  .ledger-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .ledger-meta {
    color: var(--hc-text-tertiary);
  }

  .ledger-block--action {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .edition-cite-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: fit-content;
    min-height: 34px;
    padding: 0.42rem 0.75rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 6px;
    background: var(--hc-surface-2);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: border-color var(--motion-fast) ease, background var(--motion-fast) ease, color var(--motion-fast) ease;
  }

  .edition-cite-btn:hover {
    border-color: var(--hc-gold);
    background: var(--hc-surface-3);
  }

  .edition-cite-btn[data-copied="true"] {
    color: var(--hc-text-primary);
    border-color: var(--hc-gold-dim);
  }

  /* Shared stat band: deliberately separated from the ledger. */
  .edition-hero .hc-stat-band {
    margin: 0 clamp(1rem, 5vw, 4rem) 1.25rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 7px;
    overflow: hidden;
    background: color-mix(in srgb, var(--hc-surface-0) 34%, transparent);
  }

  .edition-hero .hc-stat {
    padding: 0.9rem 0.75rem;
  }

  .edition-hero .hc-stat__num {
    font-variant-numeric: tabular-nums;
  }

  /* ─────────────── Reader navigation ─────────────── */
  .edition-nav-dock {
    margin-top: 1rem;
    border-block: 1px solid var(--hc-rule-soft);
    background: color-mix(in srgb, var(--hc-surface-0) 92%, transparent);
  }

  @media (min-width: 781px) {
    .edition-nav-dock {
      position: sticky;
      top: calc(var(--site-header-height, 72px) + var(--sat, 0px));
      z-index: 40;
      backdrop-filter: blur(12px);
    }
  }

  .edition-nav-dock__inner {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 54px;
    overflow: hidden;
  }

  .edition-nav-dock__label {
    flex: 0 0 auto;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .edition-nav-dock__links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .edition-nav-dock__links::-webkit-scrollbar {
    display: none;
  }

  .dock-link {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.42rem;
    min-height: 34px;
    padding: 0.35rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 650;
    text-decoration: none;
    transition: border-color var(--motion-fast) ease, color var(--motion-fast) ease, background var(--motion-fast) ease;
  }

  .dock-link:hover {
    border-color: var(--hc-rule-soft);
    background: var(--hc-surface-2);
    color: var(--hc-text-primary);
  }

  .dock-link.is-active {
    border-color: color-mix(in srgb, var(--hc-gold) 50%, var(--hc-rule-soft));
    background: color-mix(in srgb, var(--hc-gold) 8%, var(--hc-surface-2));
    color: var(--hc-gold);
    box-shadow: inset 0 -2px 0 var(--hc-gold);
  }

  .dock-link__ar {
    font-family: var(--font-arabic);
    font-size: 0.8rem;
    color: var(--hc-gold-dim);
  }

  .dock-link__count {
    display: inline-flex;
    min-width: 1.25rem;
    justify-content: center;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--hc-surface-3);
    color: var(--hc-gold);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  /* ─────────────── Content sections ─────────────── */
  .record-section {
    margin-top: clamp(3.25rem, 7vw, 6rem);
    scroll-margin-top: calc(var(--site-header-height, 72px) + 5.5rem);
  }

  .record-section__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: 1.75rem;
  }

  .record-section__kicker {
    margin-bottom: 0.42rem;
  }

  .record-section__title {
    max-width: 28ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    font-weight: 520;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--hc-text-primary);
  }

  .record-section__desc {
    max-width: 76ch;
    margin: 0.65rem 0 0;
    font-family: var(--font-body);
    font-size: 0.96rem;
    line-height: 1.75;
    color: var(--hc-text-secondary);
  }

  .record-section__header::after {
    content: "";
    display: block;
    width: min(10rem, 34vw);
    margin-top: 1rem;
    border-top: 1px solid var(--hc-gold-dim);
  }

  /* ─────────────── Bilingual text edition ─────────────── */
  .critical-spread {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border: 1px solid var(--hc-rule-soft);
    border-radius: 10px;
    overflow: hidden;
    background: var(--hc-surface-1);
  }

  .critical-col {
    min-width: 0;
    background: var(--hc-surface-1);
  }

  .critical-col--en {
    border-right: 1px solid var(--hc-rule-soft);
  }

  .critical-col--ar {
    background: color-mix(in srgb, var(--hc-surface-2) 34%, var(--hc-surface-1));
  }

  .critical-col__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0.65rem 1.1rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    background: var(--hc-surface-2);
  }

  .critical-col__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .critical-col__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .critical-col__dot--en { background: var(--hc-text-tertiary); }
  .critical-col__dot--ar { background: var(--hc-gold); }

  .critical-col__caveat,
  .critical-col__folio {
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.35;
    text-align: right;
  }

  .critical-col__prose {
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.15rem, 3vw, 2.4rem);
  }

  .critical-spread--matn .critical-col--en .critical-col__prose {
    border-left: 3px solid var(--hc-gold);
  }

  .critical-spread--matn .critical-col--ar .critical-col__prose {
    border-right: 3px solid var(--hc-gold);
  }

  .facing-prose--en {
    max-width: 70ch;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.15vw, 1.1rem);
    line-height: 1.95;
    color: var(--hc-text-primary);
  }

  .facing-prose--ar {
    max-width: 42ch;
    margin-left: auto;
    font-family: var(--font-arabic);
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    line-height: 2.25;
    color: var(--hc-text-primary);
    direction: rtl;
    text-align: right;
  }

  .facing-prose--empty {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    font-style: italic;
    color: var(--hc-text-tertiary);
  }

  .facing-prose :global(em) {
    color: var(--hc-text-secondary);
  }

  .facing-prose :global(strong) {
    color: var(--hc-gold);
  }

  .facing-prose :global(.folio) {
    display: inline-block;
    margin: 0 0.28em;
    padding: 0.08em 0.42em;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 4px;
    background: var(--hc-surface-2);
    color: var(--hc-gold-dim);
    font-family: var(--font-ui);
    font-size: 0.72em;
    line-height: 1.4;
    vertical-align: 0.08em;
  }

  /* ─────────────── Isnād ─────────────── */
  .isnad-graph-stack {
    display: grid;
    gap: 1.5rem;
  }

  .isnad-path-card {
    overflow: hidden;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 10px;
    background: var(--hc-surface-1);
  }

  .isnad-path-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    padding: 0.95rem 1.2rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    background: var(--hc-surface-2);
  }

  .isnad-path-card__title-wrap {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .isnad-path-badge {
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .isnad-path-count {
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .isnad-flow-legend {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .legend-step {
    padding: 0.14rem 0.42rem;
    border-radius: 3px;
    background: var(--hc-surface-3);
  }

  .legend-step--source { color: var(--hc-gold); }
  .legend-step--compiler { color: var(--hc-text-primary); }
  .legend-sep { color: var(--hc-rule); }

  .isnad-chain-ladder {
    list-style: none;
    margin: 0;
    padding: 1.15rem 1.2rem 1.35rem;
  }

  .ladder-node {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0.9rem;
    position: relative;
    padding: 0.42rem 0;
  }

  .ladder-spine {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    position: relative;
  }

  .ladder-spine__circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 6px;
    background: var(--hc-surface-2);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    z-index: 2;
  }

  .ladder-node.is-source .ladder-spine__circle {
    border-color: var(--hc-gold);
    background: color-mix(in srgb, var(--hc-gold) 12%, var(--hc-surface-2));
    color: var(--hc-gold);
  }

  .ladder-node.is-compiler .ladder-spine__circle {
    border-color: var(--hc-text-primary);
    color: var(--hc-text-primary);
    background: var(--hc-surface-3);
  }

  .ladder-spine__connector {
    position: absolute;
    inset: 2rem auto -0.9rem 50%;
    width: 1px;
    transform: translateX(-50%);
  }

  .ladder-spine__line {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--hc-rule), var(--hc-rule-soft));
  }

  .ladder-verb {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 0.04rem 0.35rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 3px;
    background: var(--hc-surface-1);
    color: var(--hc-gold-dim);
    font-family: var(--font-arabic);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .ladder-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 7px;
    transition: background var(--motion-fast) ease, border-color var(--motion-fast) ease;
  }

  .ladder-node:hover .ladder-card,
  .ladder-node:focus-within .ladder-card {
    border-color: var(--hc-rule-soft);
    background: var(--hc-surface-2);
  }

  .ladder-card__content { min-width: 0; }
  .ladder-card__role { margin-bottom: 0.3rem; }

  .role-pill {
    display: inline-flex;
    padding: 0.16rem 0.46rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 4px;
    background: var(--hc-surface-2);
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .role-pill--source {
    border-color: color-mix(in srgb, var(--hc-gold) 38%, transparent);
    color: var(--hc-gold);
  }

  .role-pill--compiler {
    color: var(--hc-text-primary);
  }

  .ladder-card__name {
    display: inline-block;
    color: var(--hc-text-primary);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    font-weight: 520;
    line-height: 1.35;
    text-decoration: none;
  }

  .ladder-card__name:hover {
    color: var(--hc-gold);
  }

  .ladder-card__name.is-unlinked {
    color: var(--hc-text-secondary);
  }

  .ladder-card__unresolved {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .unresolved-badge {
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-style: italic;
  }

  .ladder-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.55rem;
    flex: 0 0 auto;
  }

  .death-tag,
  .dossier-button {
    min-height: 30px;
  }

  .death-tag {
    display: inline-flex;
    align-items: center;
    padding: 0 0.52rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 5px;
    background: var(--hc-surface-2);
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .dossier-button {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.58rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 5px;
    background: transparent;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: border-color var(--motion-fast) ease, background var(--motion-fast) ease, gap var(--motion-fast) ease;
  }

  .dossier-button:hover {
    border-color: var(--hc-gold);
    background: var(--hc-surface-2);
    gap: 0.5rem;
  }

  /* ─────────────── Apparatus ─────────────── */
  .apparatus-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .apparatus-card {
    grid-column: span 6;
    min-width: 0;
    padding: 1.35rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 10px;
    background: var(--hc-surface-1);
  }

  .apparatus-card:first-child {
    grid-column: span 8;
  }

  .apparatus-card:last-child {
    grid-column: span 4;
  }

  .apparatus-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.45rem;
  }

  .apparatus-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 520;
    line-height: 1.3;
    color: var(--hc-text-primary);
  }

  .apparatus-card__count {
    flex: 0 0 auto;
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .apparatus-card__note {
    margin: 0 0 1rem;
    color: var(--hc-text-tertiary);
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .circulation-list {
    display: grid;
    gap: 0.45rem;
  }

  .circulation-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem 0.85rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .circulation-item:first-child {
    border-top: 0;
  }

  .circulation-item__meta {
    display: grid;
    gap: 0.12rem;
  }

  .circulation-item__title {
    color: var(--hc-text-primary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
