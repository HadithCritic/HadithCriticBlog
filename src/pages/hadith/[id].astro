---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { CORPUS_CACHE_CONTROL } from '../../lib/edge-cache';

/**
 * Critical edition record for one narration.
 *
 * A shell, and deliberately so. There are 276,347 narrations, which is far past
 * what can be prerendered, and there is no longer a database behind the site to
 * ask at request time. So the Worker renders the frame and the identity of the
 * record it is going to show, and src/lib/hadith-record.ts fills it from the
 * static corpus in the browser: the narration, its facing texts, its isnad
 * branches and its apparatus.
 *
 * This route stays on-demand rather than prerendered only because the id is
 * unbounded. It performs no I/O of any kind -- no database, no fetch, nothing
 * to fail -- so it costs a Worker invocation and nothing else.
 *
 * The consequence to be aware of: a crawler that does not run JavaScript sees
 * the shell rather than the narration. That is the price of serving a 1.6 GB
 * corpus from static files, and it is paid knowingly.
 */

const raw = Astro.params.id ?? '';
const id = Number(raw);
const valid = /^\d+$/.test(raw) && Number.isFinite(id) && id > 0;

if (!valid) {
  return new Response('Not found', { status: 404 });
}

const pageTitle = `Hadith ${id} | HadithCritic Critical Edition`;

// The shell depends on the id and the deployment, and on nothing that can
// fail, so it is unconditionally storable at the edge.
Astro.response.headers.set('Cache-Control', CORPUS_CACHE_CONTROL);
---

<BaseLayout
  title={pageTitle}
  description="A primary source narration in Arabic and English from the HadithCritic corpus, with its transmission chain and critical apparatus."
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Corpus', url: '/hadith' },
    { name: `Hadith ${id}`, url: `/hadith/${id}` }
  ]}
>
  <div class="hadith-container" data-hadith-id={id}>
    <div class="record-loading" data-record-loading>
      <span class="record-spinner" aria-hidden="true"></span>
      <p>Reading narration #{id} from the corpus...</p>
    </div>
    <noscript>
      <div class="hadith-degraded">
        <span class="hadith-degraded__badge">JavaScript required</span>
        <h1 class="hadith-degraded__title">Narration #{id}</h1>
        <p class="hadith-degraded__text">
          Narrations are read from a static SQLite corpus inside your browser,
          which needs JavaScript. The written research on this site does not.
        </p>
        <div class="hadith-degraded__actions">
          <a class="hc-btn" href="/hadith">Return to the corpus index</a>
        </div>
      </div>
    </noscript>
  </div>
</BaseLayout>

<script>
  import { initHadithRecord } from '../../lib/hadith-record';
  initHadithRecord();
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  /* The shell's own state, before src/lib/hadith-record.ts has anything to show. */
  .record-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: clamp(3rem, 12vh, 7rem) 1rem;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--hc-text-secondary);
    text-align: center;
  }

  .record-spinner {
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--hc-rule-soft);
    border-top-color: var(--hc-gold);
    border-radius: 50%;
    animation: record-spin 900ms linear infinite;
  }

  @keyframes record-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .record-spinner {
      animation: none;
    }
  }

  .hadith-container {
    width: min(100% - 2rem, 88rem);
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.25rem) 0 7rem;
  }

  /* ─────────────── Hero / record identity ─────────────── */
  .edition-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--hc-rule);
    border-radius: 10px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--hc-surface-2) 54%, var(--hc-surface-1)), var(--hc-surface-1));
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.16);
  }

  .edition-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 92% 0%, color-mix(in srgb, var(--hc-gold) 8%, transparent), transparent 34rem);
    pointer-events: none;
  }

  .edition-hero__topbar,
  .edition-hero__titles,
  .edition-ledger-grid,
  .edition-nav-dock__inner,
  .record-section,
  .edition-hero .hc-stat-band {
    position: relative;
    z-index: 1;
  }

  .edition-hero__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem clamp(1rem, 2.7vw, 2rem);
    border-bottom: 1px solid var(--hc-rule-soft);
    background: color-mix(in srgb, var(--hc-surface-0) 38%, transparent);
  }

  .hc-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 40px;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--motion-fast) ease, gap var(--motion-fast) ease;
  }

  .hc-back-link:hover {
    color: var(--hc-gold);
    gap: 0.75rem;
  }

  .edition-hero__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .edition-ref-tag {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 999px;
    background: var(--hc-surface-2);
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .edition-ref-tag--gold {
    border-color: color-mix(in srgb, var(--hc-gold) 45%, transparent);
    background: color-mix(in srgb, var(--hc-gold) 9%, var(--hc-surface-2));
    color: var(--hc-gold);
  }

  .edition-ref-tag--status {
    color: var(--hc-gold-dim);
  }

  .edition-hero__titles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
    padding: clamp(2rem, 5vw, 3.4rem) clamp(1rem, 5vw, 4rem) clamp(1.75rem, 4vw, 2.75rem);
  }

  .edition-hero__title-ar {
    margin: 0;
    max-width: 60ch;
    font-family: var(--font-arabic);
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.9;
    color: var(--hc-gold);
    text-align: right;
    direction: rtl;
  }

  .edition-hero__title-en {
    max-width: 27ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.45rem);
    font-weight: 520;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--hc-text-primary);
  }

  .edition-ledger-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--hc-rule-soft);
  }

  .ledger-block {
    min-width: 0;
    padding: 1rem clamp(0.9rem, 2vw, 1.4rem) 1.1rem;
    border-right: 1px solid var(--hc-rule-soft);
  }

  .ledger-block:last-child {
    border-right: 0;
  }

  .ledger-block__label {
    display: block;
    margin-bottom: 0.38rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .ledger-block__value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.83rem;
    line-height: 1.45;
    color: var(--hc-text-secondary);
  }

  .ledger-link {
    color: var(--hc-gold);
    font-weight: 700;
    text-decoration: none;
  }

  .ledger-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .ledger-meta {
    color: var(--hc-text-tertiary);
  }

  .ledger-block--action {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .edition-cite-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: fit-content;
    min-height: 34px;
    padding: 0.42rem 0.75rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 6px;
    background: var(--hc-surface-2);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: border-color var(--motion-fast) ease, background var(--motion-fast) ease, color var(--motion-fast) ease;
  }

  .edition-cite-btn:hover {
    border-color: var(--hc-gold);
    background: var(--hc-surface-3);
  }

  .edition-cite-btn[data-copied="true"] {
    color: var(--hc-text-primary);
    border-color: var(--hc-gold-dim);
  }

  /* Shared stat band: deliberately separated from the ledger. */
  .edition-hero .hc-stat-band {
    margin: 0 clamp(1rem, 5vw, 4rem) 1.25rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 7px;
    overflow: hidden;
    background: color-mix(in srgb, var(--hc-surface-0) 34%, transparent);
  }

  .edition-hero .hc-stat {
    padding: 0.9rem 0.75rem;
  }

  .edition-hero .hc-stat__num {
    font-variant-numeric: tabular-nums;
  }

  /* ─────────────── Reader navigation ─────────────── */
  .edition-nav-dock {
    margin-top: 1rem;
    border-block: 1px solid var(--hc-rule-soft);
    background: color-mix(in srgb, var(--hc-surface-0) 92%, transparent);
  }

  @media (min-width: 781px) {
    .edition-nav-dock {
      position: sticky;
      top: calc(var(--site-header-height, 72px) + var(--sat, 0px));
      z-index: 40;
      backdrop-filter: blur(12px);
    }
  }

  .edition-nav-dock__inner {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 54px;
    overflow: hidden;
  }

  .edition-nav-dock__label {
    flex: 0 0 auto;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .edition-nav-dock__links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .edition-nav-dock__links::-webkit-scrollbar {
    display: none;
  }

  .dock-link {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.42rem;
    min-height: 34px;
    padding: 0.35rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 650;
    text-decoration: none;
    transition: border-color var(--motion-fast) ease, color var(--motion-fast) ease, background var(--motion-fast) ease;
  }

  .dock-link:hover {
    border-color: var(--hc-rule-soft);
    background: var(--hc-surface-2);
    color: var(--hc-text-primary);
  }

  .dock-link.is-active {
    border-color: color-mix(in srgb, var(--hc-gold) 50%, var(--hc-rule-soft));
    background: color-mix(in srgb, var(--hc-gold) 8%, var(--hc-surface-2));
    color: var(--hc-gold);
    box-shadow: inset 0 -2px 0 var(--hc-gold);
  }

  .dock-link__ar {
    font-family: var(--font-arabic);
    font-size: 0.8rem;
    color: var(--hc-gold-dim);
  }

  .dock-link__count {
    display: inline-flex;
    min-width: 1.25rem;
    justify-content: center;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--hc-surface-3);
    color: var(--hc-gold);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  /* ─────────────── Content sections ─────────────── */
  .record-section {
    margin-top: clamp(3.25rem, 7vw, 6rem);
    scroll-margin-top: calc(var(--site-header-height, 72px) + 5.5rem);
  }

  .record-section__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: 1.75rem;
  }

  .record-section__kicker {
    margin-bottom: 0.42rem;
  }

  .record-section__title {
    max-width: 28ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    font-weight: 520;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--hc-text-primary);
  }

  .record-section__desc {
    max-width: 76ch;
    margin: 0.65rem 0 0;
    font-family: var(--font-body);
    font-size: 0.96rem;
    line-height: 1.75;
    color: var(--hc-text-secondary);
  }

  .record-section__header::after {
    content: "";
    display: block;
    width: min(10rem, 34vw);
    margin-top: 1rem;
    border-top: 1px solid var(--hc-gold-dim);
  }

  /* ─────────────── Bilingual text edition ─────────────── */
  .critical-spread {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border: 1px solid var(--hc-rule-soft);
    border-radius: 10px;
    overflow: hidden;
    background: var(--hc-surface-1);
  }

  .critical-col {
    min-width: 0;
    background: var(--hc-surface-1);
  }

  .critical-col--en {
    border-right: 1px solid var(--hc-rule-soft);
  }

  .critical-col--ar {
    background: color-mix(in srgb, var(--hc-surface-2) 34%, var(--hc-surface-1));
  }

  .critical-col__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0.65rem 1.1rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    background: var(--hc-surface-2);
  }

  .critical-col__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .critical-col__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .critical-col__dot--en { background: var(--hc-text-tertiary); }
  .critical-col__dot--ar { background: var(--hc-gold); }

  .critical-col__caveat,
  .critical-col__folio {
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.35;
    text-align: right;
  }

  .critical-col__prose {
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.15rem, 3vw, 2.4rem);
  }

  .critical-spread--matn .critical-col--en .critical-col__prose {
    border-left: 3px solid var(--hc-gold);
  }

  .critical-spread--matn .critical-col--ar .critical-col__prose {
    border-right: 3px solid var(--hc-gold);
  }

  .facing-prose--en {
    max-width: 70ch;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.15vw, 1.1rem);
    line-height: 1.95;
    color: var(--hc-text-primary);
  }

  .facing-prose--ar {
    max-width: 42ch;
    margin-left: auto;
    font-family: var(--font-arabic);
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    line-height: 2.25;
    color: var(--hc-text-primary);
    direction: rtl;
    text-align: right;
  }

  .facing-prose--empty {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    font-style: italic;
    color: var(--hc-text-tertiary);
  }

  .facing-prose :global(em) {
    color: var(--hc-text-secondary);
  }

  .facing-prose :global(strong) {
    color: var(--hc-gold);
  }

  .facing-prose :global(.folio) {
    display: inline-block;
    margin: 0 0.28em;
    padding: 0.08em 0.42em;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 4px;
    background: var(--hc-surface-2);
    color: var(--hc-gold-dim);
    font-family: var(--font-ui);
    font-size: 0.72em;
    line-height: 1.4;
    vertical-align: 0.08em;
  }

  /* ─────────────── Isnād ─────────────── */
  .isnad-graph-stack {
    display: grid;
    gap: 1.5rem;
  }

  .isnad-path-card {
    overflow: hidden;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 10px;
    background: var(--hc-surface-1);
  }

  .isnad-path-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    padding: 0.95rem 1.2rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    background: var(--hc-surface-2);
  }

  .isnad-path-card__title-wrap {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .isnad-path-badge {
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .isnad-path-count {
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .isnad-flow-legend {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .legend-step {
    padding: 0.14rem 0.42rem;
    border-radius: 3px;
    background: var(--hc-surface-3);
  }

  .legend-step--source { color: var(--hc-gold); }
  .legend-step--compiler { color: var(--hc-text-primary); }
  .legend-sep { color: var(--hc-rule); }

  .isnad-chain-ladder {
    list-style: none;
    margin: 0;
    padding: 1.15rem 1.2rem 1.35rem;
  }

  .ladder-node {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0.9rem;
    position: relative;
    padding: 0.42rem 0;
  }

  .ladder-spine {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    position: relative;
  }

  .ladder-spine__circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 6px;
    background: var(--hc-surface-2);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    z-index: 2;
  }

  .ladder-node.is-source .ladder-spine__circle {
    border-color: var(--hc-gold);
    background: color-mix(in srgb, var(--hc-gold) 12%, var(--hc-surface-2));
    color: var(--hc-gold);
  }

  .ladder-node.is-compiler .ladder-spine__circle {
    border-color: var(--hc-text-primary);
    color: var(--hc-text-primary);
    background: var(--hc-surface-3);
  }

  .ladder-spine__connector {
    position: absolute;
    inset: 2rem auto -0.9rem 50%;
    width: 1px;
    transform: translateX(-50%);
  }

  .ladder-spine__line {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--hc-rule), var(--hc-rule-soft));
  }

  .ladder-verb {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 0.04rem 0.35rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 3px;
    background: var(--hc-surface-1);
    color: var(--hc-gold-dim);
    font-family: var(--font-arabic);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .ladder-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 7px;
    transition: background var(--motion-fast) ease, border-color var(--motion-fast) ease;
  }

  .ladder-node:hover .ladder-card,
  .ladder-node:focus-within .ladder-card {
    border-color: var(--hc-rule-soft);
    background: var(--hc-surface-2);
  }

  .ladder-card__content { min-width: 0; }
  .ladder-card__role { margin-bottom: 0.3rem; }

  .role-pill {
    display: inline-flex;
    padding: 0.16rem 0.46rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 4px;
    background: var(--hc-surface-2);
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .role-pill--source {
    border-color: color-mix(in srgb, var(--hc-gold) 38%, transparent);
    color: var(--hc-gold);
  }

  .role-pill--compiler {
    color: var(--hc-text-primary);
  }

