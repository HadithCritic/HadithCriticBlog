---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/musnad-al-humaydi/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("musnad-al-humaydi", "Musnad al-Ḥumaydī");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("musnad-al-humaydi")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/musnad-al-humaydi/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
