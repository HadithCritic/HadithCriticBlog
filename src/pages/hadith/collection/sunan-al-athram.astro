---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/sunan-al-athram/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("sunan-al-athram", "Sunan al-Athram");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("sunan-al-athram")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/sunan-al-athram/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
