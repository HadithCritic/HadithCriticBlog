---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/sunan-al-athram/collection.html?raw";
import chapters from "../../../data/hadith/pages/sunan-al-athram/chapter-index.json";
import PaintedCollection from "../../../components/hadith/PaintedCollection.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("sunan-al-athram", "Sunan al-Athram");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("sunan-al-athram")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/sunan-al-athram/" },
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hadith/covers/sunan-al-athram.webp" fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <PaintedCollection slug="sunan-al-athram" front={parseCollectionHtml("sunan-al-athram", collectionHtml)} chapters={chapters} />
</BaseLayout>
