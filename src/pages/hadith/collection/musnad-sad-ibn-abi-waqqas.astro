---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/musnad-sad-ibn-abi-waqqas/collection.html?raw";
import chapters from "../../../data/hadith/pages/musnad-sad-ibn-abi-waqqas/chapter-index.json";
import PaintedCollection from "../../../components/hadith/PaintedCollection.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";
const title = "Musnad Saʿd ibn Abī Waqqāṣ";
const { description } = collectionFrontMatter("musnad-sad-ibn-abi-waqqas", title);
---
<BaseLayout title={`${title} | HadithCritic`} description={description} image={OG.collection("musnad-sad-ibn-abi-waqqas")} imageAlt={title} crumbs={[{ name: "Home", url: "/" }, { name: "Corpus", url: "/hadith/" }, { name: title, url: "/hadith/collection/musnad-sad-ibn-abi-waqqas/" }]}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hadith/covers/musnad-sad-ibn-abi-waqqas.webp" fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <PaintedCollection slug="musnad-sad-ibn-abi-waqqas" front={parseCollectionHtml("musnad-sad-ibn-abi-waqqas", collectionHtml)} chapters={chapters} />
</BaseLayout>
