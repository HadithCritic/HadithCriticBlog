---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/musnad-sad-ibn-abi-waqqas/collection.html?raw";
const title = "Musnad Saʿd ibn Abī Waqqāṣ";
const { description } = collectionFrontMatter("musnad-sad-ibn-abi-waqqas", title);
---
<BaseLayout title={`${title} | HadithCritic`} description={description} image={OG.collection("musnad-sad-ibn-abi-waqqas")} imageAlt={title} crumbs={[{ name: "Home", url: "/" }, { name: "Corpus", url: "/hadith/" }, { name: title, url: "/hadith/collection/musnad-sad-ibn-abi-waqqas/" }]}>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
