---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import collectionHtml from "../../../data/hadith-pages/musnad-sad-ibn-abi-waqqas/collection.html?raw";
const title = "Musnad Saʿd ibn Abī Waqqāṣ";
---
<BaseLayout title={`${title} | HadithCritic`} description="Read 134 narrations across nine chapters, with Arabic and English text and transmission paths." image={OG.collection("musnad-sad-ibn-abi-waqqas")} imageAlt={title} crumbs={[{ name: "Home", url: "/" }, { name: "Corpus", url: "/hadith/" }, { name: title, url: "/hadith/collection/musnad-sad-ibn-abi-waqqas/" }]}>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
