---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/hadith-sufyan-al-thawri/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("hadith-sufyan-al-thawri", "Ḥadīth Sufyān al-Thawrī (printed edition)");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("hadith-sufyan-al-thawri")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/hadith-sufyan-al-thawri/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
