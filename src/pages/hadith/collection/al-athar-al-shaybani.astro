---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/al-athar-al-shaybani/collection.html?raw";
import chapters from "../../../data/hadith/pages/al-athar-al-shaybani/chapter-index.json";
import PaintedFront from "../../../components/hadith/PaintedFront.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("al-athar-al-shaybani", "Kitāb al-Āthār of al-Shaybānī");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("al-athar-al-shaybani")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/al-athar-al-shaybani/" },
  ]}
>
  <PaintedFront
    slug="al-athar-al-shaybani"
    front={parseCollectionHtml("al-athar-al-shaybani", collectionHtml)}
    chapters={chapters}
    heroAlt="An illustrative scene for al-Shaybānī’s legal reports."
    placeAr="الكوفة"
    groups={[]}
    itemSingular="chapter"
    itemPlural="chapters"
    arrangement="79 chapters in source order"
    span="Chapters 1–79"
  />
</BaseLayout>
