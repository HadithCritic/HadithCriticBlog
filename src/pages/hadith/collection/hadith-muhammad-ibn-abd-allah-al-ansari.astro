---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/hadith-muhammad-ibn-abd-allah-al-ansari/collection.html?raw";
import chapters from "../../../data/hadith/pages/hadith-muhammad-ibn-abd-allah-al-ansari/chapter-index.json";
import PaintedCollection from "../../../components/hadith/PaintedCollection.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("hadith-muhammad-ibn-abd-allah-al-ansari", "Ḥadīth of Muḥammad ibn ʿAbd Allāh al-Anṣārī");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("hadith-muhammad-ibn-abd-allah-al-ansari")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/hadith-muhammad-ibn-abd-allah-al-ansari/" },
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hadith/covers/hadith-muhammad-ibn-abd-allah-al-ansari.webp" fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <PaintedCollection slug="hadith-muhammad-ibn-abd-allah-al-ansari" front={parseCollectionHtml("hadith-muhammad-ibn-abd-allah-al-ansari", collectionHtml)} chapters={chapters} />
</BaseLayout>
