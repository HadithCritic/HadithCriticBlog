---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/hadith-muhammad-ibn-abd-allah-al-ansari/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("hadith-muhammad-ibn-abd-allah-al-ansari", "Ḥadīth of Muḥammad ibn ʿAbd Allāh al-Anṣārī");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("hadith-muhammad-ibn-abd-allah-al-ansari")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/hadith-muhammad-ibn-abd-allah-al-ansari/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
