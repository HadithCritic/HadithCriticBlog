---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/musnad-khalifa-ibn-khayyat/collection.html?raw";
import chapters from "../../../data/hadith/pages/musnad-khalifa-ibn-khayyat/chapter-index.json";
import PaintedCollection from "../../../components/hadith/PaintedCollection.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const title = "Musnad Khalīfa ibn Khayyāṭ";
const { description } = collectionFrontMatter("musnad-khalifa-ibn-khayyat", title);
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("musnad-khalifa-ibn-khayyat")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/musnad-khalifa-ibn-khayyat/" },
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hadith/covers/musnad-khalifa-ibn-khayyat.webp" fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <PaintedCollection slug="musnad-khalifa-ibn-khayyat" front={parseCollectionHtml("musnad-khalifa-ibn-khayyat", collectionHtml)} chapters={chapters} />
</BaseLayout>
