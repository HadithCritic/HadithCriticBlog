---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/musnad-khalifa-ibn-khayyat/collection.html?raw";

const title = "Musnad Khalīfa ibn Khayyāṭ";
const { description } = collectionFrontMatter("musnad-khalifa-ibn-khayyat", title);
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("musnad-khalifa-ibn-khayyat")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/musnad-khalifa-ibn-khayyat/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
