---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/ahadith-muntakhaba-maghazi-musa-ibn-uqba/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("ahadith-muntakhaba-maghazi-musa-ibn-uqba", "Selected Traditions from the Maghāzī of Mūsā ibn ʿUqba");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("ahadith-muntakhaba-maghazi-musa-ibn-uqba")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/ahadith-muntakhaba-maghazi-musa-ibn-uqba/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
