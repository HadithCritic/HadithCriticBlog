---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { CORPUS_META } from "../../../lib/corpus-config";
import collectionHtml from "../../../data/hadith-pages/al-shama-il-al-muhammadiyah/collection.html?raw";

const book = CORPUS_META.collections.find((collection) => collection.slug === "al-shama-il-al-muhammadiyah");
if (!book) throw new Error("Al-Shama'il al-Muhammadiyah is missing from corpus metadata");

const description = `Browse the chapters of ${book.title_en} in order, with 415 narrations in the HadithCritic corpus.`;
---

<BaseLayout
  title={`${book.title_en} | HadithCritic`}
  description={description}
  image={OG.collection(book.slug)}
  imageAlt={`${book.title_en} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: book.title_en, url: `/hadith/collection/${book.slug}/` },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
