---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { SHAMAIL_COLLECTION as book } from "../../../lib/hadith-library";
import collectionHtml from "../../../data/hadith-pages/al-shama-il-al-muhammadiyah/collection.html?raw";

const description = `Browse the chapters of ${book.title_en} in order: ${book.hadith_count.toLocaleString()} narrations in Arabic and English.`;
---

<BaseLayout
  title={`${book.title_en} | HadithCritic`}
  description={description}
  image={OG.collection(book.slug)}
  imageAlt={`${book.title_en} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Hadith library", url: "/hadith/" },
    { name: book.title_en, url: `/hadith/collection/${book.slug}/` },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
