---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PaintedFront from "../../../components/hadith/PaintedFront.astro";
import SahifatTransmissionMap from "../../../components/hadith/SahifatTransmissionMap.astro";
import { OG } from "../../../lib/seo";
import type { CollectionFrontData } from "../../../lib/collection-front";
import compilation from "../../../data/hadith/json/sahifat-hammam-ibn-munabbih.json";
import type { BookGroup } from "../../../data/hadith/musnad-abu-hanifa-groups";

/* The Ṣaḥīfa has no chapter divisions in its source. Its 138 numbered
   narrations use the standard compilation index and open in the continuous
   reader at the matching report. */
const slug = "sahifat-hammam-ibn-munabbih";
const title = "Ṣaḥīfat Hammām ibn Munabbih";
const reader = `/hadith/collection/${slug}/read/`;

const narrations = compilation.sections.find((section) => section.kind === "Text")?.entries.filter((entry) => entry.number) ?? [];
if (narrations.length !== 137) throw new Error(`${slug}: expected 137 source entries after the opening report, found ${narrations.length}`);

const chapters = Array.from({ length: 138 }, (_, index) => ({
  n: index + 1,
  title_en: `Narrator ${index + 1}`,
  title_ar: "",
  count: 1
}));
const groups: readonly BookGroup[] = [{
  id: "narrations",
  label: "Narrations",
  books: chapters.map((chapter) => chapter.n)
}];
const chapterHref = (n: number) => {
  if (n === 1) return `${reader}#entry-3`;
  const entry = narrations[n - 2];
  if (!entry || n < 1 || n > chapters.length) throw new Error(`${slug}: no narration ${n}`);
  return `${reader}#${entry.id}`;
};

const front: CollectionFrontData = {
  titleHtml: title,
  authorLabel: "Written by",
  compiler: "Hammām ibn Munabbih (d. 131 AH)",
  date: "",
  lede: "A collection of reports transmitted by Hammām ibn Munabbih from Abū Hurayra, presented in Arabic and English.",
  beginHref: chapterHref(1),
  beginLabel: "Begin reading",
  exploreHref: "#pf-index",
  exploreLabel: "Explore 138 narrations",
  indexHtml: "",
  notes: [
    { label: "Published edition", html: "Edited by ʿAlī Ḥasan ʿAlī ʿAbd al-Ḥamīd and published by al-Maktab al-Islāmī and Dār ʿAmmār, first edition, 1407 AH / 1987 CE." },
    { label: "Text and translation", html: "The supplied Arabic text is presented alongside its English translation." },
    { label: "Order and numbering", html: "The narrations follow the supplied edition’s source order and numbering." },
    { label: "Opening transmission", html: "The opening chain is presented before the index. Its accompanying introductory report is retained as Narration 1." }
  ],
  scripts: []
};
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description="Ṣaḥīfat Hammām ibn Munabbih: 138 narrations, presented in Arabic and English with source references."
  image={OG.collection(slug)}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Hadith corpus", url: "/hadith/" },
    { name: title, url: `/hadith/collection/${slug}/` }
  ]}
>
  <PaintedFront
    slug={slug}
    front={front}
    chapters={chapters}
    heroAlt="Hammām ibn Munabbih recording reports in Sanaa."
    placeAr="صنعاء"
    groups={groups}
    itemSingular="narration"
    itemPlural="narrations"
    arrangement="138 numbered narrations"
    span="Narrations 1–138"
    chapterHref={chapterHref}
    compilerLabel=""
  >
    <SahifatTransmissionMap slot="after-work" />
  </PaintedFront>
</BaseLayout>
