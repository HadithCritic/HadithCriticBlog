---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/ahadith-al-sari-an-al-thawri/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("ahadith-al-sari-an-al-thawri", "Aḥādīth al-Sarī ibn Yaḥyā through al-Thawrī (manuscript text)");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("ahadith-al-sari-an-al-thawri")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/ahadith-al-sari-an-al-thawri/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
