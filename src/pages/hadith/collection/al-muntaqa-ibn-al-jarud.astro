---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/al-muntaqa-ibn-al-jarud/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("al-muntaqa-ibn-al-jarud", "Al-Muntaqā min al-Sunan al-Musnada");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("al-muntaqa-ibn-al-jarud")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/al-muntaqa-ibn-al-jarud/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
