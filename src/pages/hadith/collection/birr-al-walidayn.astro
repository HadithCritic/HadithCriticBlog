---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/birr-al-walidayn/collection.html?raw";
import chapters from "../../../data/hadith/pages/birr-al-walidayn/chapter-index.json";
import PaintedCollection from "../../../components/hadith/PaintedCollection.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const title = "Birr al-Wālidayn of al-Bukhārī";
const { description } = collectionFrontMatter("birr-al-walidayn", title);
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("birr-al-walidayn")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/birr-al-walidayn/" },
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hadith/covers/birr-al-walidayn.webp" fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <PaintedCollection slug="birr-al-walidayn" front={parseCollectionHtml("birr-al-walidayn", collectionHtml)} chapters={chapters} />
</BaseLayout>
