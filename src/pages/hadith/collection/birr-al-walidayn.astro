---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import collectionHtml from "../../../data/hadith-pages/birr-al-walidayn/collection.html?raw";

const title = "Birr al-Wālidayn of al-Bukhārī";
const description = "Read 78 narrations across 45 chapters of al-Bukhari's compilation on kindness to parents, with Arabic and English text and linked transmission paths.";
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("birr-al-walidayn")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/birr-al-walidayn/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
