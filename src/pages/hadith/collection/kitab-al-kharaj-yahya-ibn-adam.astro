---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/kitab-al-kharaj-yahya-ibn-adam/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("kitab-al-kharaj-yahya-ibn-adam", "Kitāb al-Kharāj of Yaḥyā ibn Ādam");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("kitab-al-kharaj-yahya-ibn-adam")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/kitab-al-kharaj-yahya-ibn-adam/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
