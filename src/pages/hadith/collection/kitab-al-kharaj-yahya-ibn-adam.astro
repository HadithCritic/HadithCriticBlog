---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/kitab-al-kharaj-yahya-ibn-adam/collection.html?raw";
import chapters from "../../../data/hadith/pages/kitab-al-kharaj-yahya-ibn-adam/chapter-index.json";
import PaintedCollection from "../../../components/hadith/PaintedCollection.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("kitab-al-kharaj-yahya-ibn-adam", "Kitāb al-Kharāj of Yaḥyā ibn Ādam");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("kitab-al-kharaj-yahya-ibn-adam")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/kitab-al-kharaj-yahya-ibn-adam/" },
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hadith/covers/kitab-al-kharaj-yahya-ibn-adam.webp" fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <PaintedCollection slug="kitab-al-kharaj-yahya-ibn-adam" front={parseCollectionHtml("kitab-al-kharaj-yahya-ibn-adam", collectionHtml)} chapters={chapters} />
</BaseLayout>
