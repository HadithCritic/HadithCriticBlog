---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/juz-sufyan-ibn-uyayna/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("juz-sufyan-ibn-uyayna", "Ḥadīth Fascicle of Sufyān ibn ʿUyayna");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("juz-sufyan-ibn-uyayna")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/juz-sufyan-ibn-uyayna/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
