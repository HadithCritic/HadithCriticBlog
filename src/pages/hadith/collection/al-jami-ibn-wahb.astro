---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/al-jami-ibn-wahb/collection.html?raw";
import chapters from "../../../data/hadith/pages/al-jami-ibn-wahb/chapter-index.json";
import PaintedFront from "../../../components/hadith/PaintedFront.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("al-jami-ibn-wahb", "Al-Jāmiʿ fī al-Ḥadīth of Ibn Wahb");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("al-jami-ibn-wahb")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/al-jami-ibn-wahb/" },
  ]}
>
  <PaintedFront
    slug="al-jami-ibn-wahb"
    front={parseCollectionHtml("al-jami-ibn-wahb", collectionHtml)}
    chapters={chapters}
    heroAlt="An illustrative scene accompanying Ibn Wahb’s collection."
    placeAr="مصر"
    groups={[]}
    itemSingular="chapter"
    itemPlural="chapters"
    arrangement="16 chapters in source order"
    span="Chapters 1–16"
  />
</BaseLayout>
