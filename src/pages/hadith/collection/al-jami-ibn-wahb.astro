---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/al-jami-ibn-wahb/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("al-jami-ibn-wahb", "Al-Jāmiʿ fī al-Ḥadīth of Ibn Wahb");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("al-jami-ibn-wahb")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/al-jami-ibn-wahb/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
