---
import EditionIcon from "../../../components/EditionIcon.astro";
import { collectionArtwork } from "../../../lib/collection-presentation";
import "../../../styles/collection-page.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { CORPUS_META } from "../../../lib/corpus-config";
import { divisionNoun, kitabTitle, structureFor } from "../../../lib/collection-structure";
import { renderArabic, renderRich } from "../../../lib/format-text";

/**
 * Digital source edition for a single hadith compilation.
 *
 * The shell is prerendered, one page per collection, from the generated corpus
 * metadata: there are thirty-three of them and their titles and extents are
 * fixed for a corpus version, so a crawler and a reader with JavaScript off
 * both get the real thing. The narrations are read from the static corpus in
 * the browser by src/lib/collection-edition.ts, because 276,347 records across
 * 11,054 pages is not a set to prerender.
 */
export function getStaticPaths() {
  return CORPUS_META.collections.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { slug } = Astro.params;
const { book } = Astro.props;

const SIZE = 25;
const total = book.hadith_count;
const pages = Math.max(1, Math.ceil(total / SIZE));
// Its books, from the Ifta' Sunnah table of contents, where the collection has them.
const structure = structureFor(slug);
const noun = structure ? divisionNoun(structure.shape) : null;
const chapterCount = structure?.kitabs.reduce((sum, kitab) => sum + kitab.chapters.length, 0) ?? 0;
---

<BaseLayout
  title={book.title_en + ' · Source Edition | HadithCritic'}
  description={'Explore all ' + total.toLocaleString() + ' narrations of ' + book.title_en + ' in bilingual facing critical format with complete transmission apparatus.'}
  image={OG.collection(slug)}
  imageAlt={book.title_en + ' | HadithCritic'}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Corpus', url: '/hadith/' },
    { name: book.title_en, url: '/hadith/collection/' + slug + '/' },
  ]}
>
  <div class="edition-view hc-plate">
    <header class="edition-head">
      <picture class="edition-head__art" aria-hidden="true">
        <source srcset="/images/hadith/compilation-library-1086.webp 1086w, /images/hadith/compilation-library.webp 2172w" sizes="100vw" />
        <img src="/images/hadith/compilation-library.webp" alt="" width="2172" height="724" fetchpriority="high" />
      </picture>
      <div class="wrap edition-head__inner">
        <a class="hc-back-link" href="/hadith/"><span aria-hidden="true">←</span> Hadith Corpus</a>
        <div class="edition-head__titles">
          <p class="edition-kicker">Hadith compilation</p>
          <h1 class="edition-title">{book.title_en}</h1>
          {book.title_ar && <p class="edition-title-ar" lang="ar" dir="rtl">{book.title_ar}</p>}
          <p class="edition-head__description">
            A bilingual source edition of {total.toLocaleString()} narrations
            {structure && structure.shape !== 'flat' && <>{' '}across {structure.kitabs.length.toLocaleString()} {noun?.many.toLowerCase()}</>}.
            {' '}Browse the printed sequence, explore its chapters, and follow each report to its transmission and source notes.
          </p>
          <a class="edition-head__browse" href={structure ? '#edition-books-title' : '#edition-narrations-title'}>Explore this collection <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </header>

    <div class="wrap">
      <dl class="edition-stats-ledger hc-parchment" aria-label="Collection at a glance">
        <div class="edition-stat-entry">
          <EditionIcon name="book" />
          <div><dt>Total hadith</dt><dd>{total.toLocaleString()}<span>narrations</span></dd></div>
        </div>
        <div class="edition-stat-entry">
          <EditionIcon name="books" />
          <div><dt>{structure?.shape === 'flat' ? 'Reading sequence' : noun?.many || 'Reading sequence'}</dt><dd>{structure && structure.shape !== 'flat' ? structure.kitabs.length.toLocaleString() : pages.toLocaleString()}<span>{structure && structure.shape !== 'flat' ? noun?.many.toLowerCase() : 'pages'}</span></dd></div>
        </div>
        <div class="edition-stat-entry">
          <EditionIcon name="pages" />
          <div><dt>{structure ? 'Chapters' : 'Edition'}</dt><dd>{structure ? chapterCount.toLocaleString() : 'Bilingual'}<span>{structure ? 'source headings' : 'Arabic & English'}</span></dd></div>
        </div>
        <div class="edition-stat-entry">
          <EditionIcon name="record" />
          <div><dt>Collection ID</dt><dd>{book.id}<span>HadithCritic corpus</span></dd></div>
        </div>
      </dl>

      <section class="edition-search-plate" aria-label="Search this collection">
        <form class="edition-search-form" method="get" action="/hadith/">
          <input type="hidden" name="book" value={book.id} />
          <label class="sr-only" for="edition-q">Search within {book.title_en}</label>
          <div class="edition-search-row">
            <div class="edition-search-bar"><EditionIcon name="search" /><input id="edition-q" class="edition-search-input" type="search" name="q" placeholder={'Search within ' + book.title_en + '…'} autocomplete="off" /></div>
            <button type="submit" class="edition-search-btn">Search collection <span aria-hidden="true">→</span></button>
          </div>
        </form>
        {structure && structure.shape !== 'flat' ? (
          <div class="edition-book-controls" data-book-controls hidden>
            <label>Sort by<select data-book-sort><option value="order">{noun?.one} order</option><option value="title">Title A–Z</option><option value="extent">Most narrations</option></select></label>
            <label>{noun?.one} title<input type="search" data-book-query placeholder="Find a title…" /></label>
            <label>{noun?.one} length<select data-book-length><option value="all">All lengths</option><option value="short">Under 100 narrations</option><option value="medium">100–499 narrations</option><option value="long">500+ narrations</option></select></label>
            <button type="button" class="edition-reset" data-book-reset><span aria-hidden="true">↻</span> Reset filters</button>
          </div>
        ) : <p class="edition-search-context">Search is limited to this collection. <a href="/hadith/">Search the full corpus</a></p>}
      </section>

      {structure && noun && (
        <section class="edition-books" data-collection-browser data-divisions={noun.many.toLowerCase()} data-view="grid" aria-labelledby="edition-books-title">
          <div class="edition-books__heading">
            <div><p class="edition-kicker">The {noun.many.toLowerCase()}</p><h2 class="edition-books__title" id="edition-books-title">{structure.shape === 'flat' ? 'Explore the chapters' : 'Browse the ' + structure.kitabs.length.toLocaleString() + ' ' + noun.many}</h2></div>
            <p class="edition-books__intro">{structure.shape === 'flat' ? 'Read the chapters in the order of the printed edition.' : 'Open a ' + noun.one.toLowerCase() + ' to explore its chapters and narrations in the order of the printed edition.'}</p>
            {structure.shape !== 'flat' && <div class="edition-books__views" data-book-controls hidden aria-label="Book catalogue view"><button type="button" data-book-view="grid" aria-pressed="true"><EditionIcon name="grid" />Grid</button><button type="button" data-book-view="list" aria-pressed="false"><EditionIcon name="list" />List</button></div>}
          </div>
          <div class="edition-books__rule" aria-hidden="true"><span>◇</span></div>
          {structure.shape === 'flat' ? (
            <a class="edition-books__flat" href={'/hadith/collection/' + slug + '/kitab/1/'}>Browse all {structure.kitabs[0].chapters.length.toLocaleString()} chapters <span aria-hidden="true">→</span></a>
          ) : (
            <>
              <ol class="edition-books__list" id="edition-book-list">
                {structure.kitabs.map((kitab) => (
                  <li data-book-card data-number={kitab.n} data-count={kitab.count} data-title={kitabTitle(structure, kitab) + ' ' + kitab.title_ar}>
                    <a class="edition-book" href={'/hadith/collection/' + slug + '/kitab/' + kitab.n + '/'}>
                      <img class="edition-book__art" src={'/images/hadith/books/' + collectionArtwork(kitabTitle(structure, kitab)) + '.webp'} alt="" loading="lazy" width="512" height="512" />
                      <div class="edition-book__head"><span class="edition-books__n">{String(kitab.n).padStart(2, '0')}</span><div class="edition-books__names"><span class="edition-books__en" set:html={renderRich(kitabTitle(structure, kitab))} /><span class="edition-books__ar" lang="ar" dir="rtl" set:html={renderArabic(kitab.title_ar)} /></div></div>
                      <div class="edition-book__foot"><span><EditionIcon name="pages" />{kitab.chapters.length.toLocaleString()} {kitab.chapters.length === 1 ? 'chapter' : 'chapters'}</span><span class="edition-books__extent"><EditionIcon name="book" />{kitab.count.toLocaleString()} {kitab.count === 1 ? 'narration' : 'narrations'}</span><span class="edition-book__arrow" aria-hidden="true">→</span></div>
                    </a>
                  </li>
                ))}
              </ol>
              <p class="edition-books__empty" data-book-empty hidden>No {noun.many.toLowerCase()} match these filters. Try another title or reset the filters.</p>
              <div class="edition-books__bottom"><p data-book-status role="status" aria-live="polite" data-book-controls hidden></p><button type="button" class="edition-books__more" data-book-more aria-controls="edition-book-list" aria-expanded="false" hidden>View all books →</button><a href="#edition-narrations-title">Read the narration sequence <span aria-hidden="true">↓</span></a></div>
            </>
          )}
        </section>
      )}

      <section class="edition-body" aria-labelledby="edition-narrations-title">
        <div class="edition-sequence-head"><div><p class="edition-kicker">The source edition</p><h2 id="edition-narrations-title">Narration sequence</h2></div><p>Arabic and English, with links to each report’s full apparatus.</p></div>
        <div id="coll-client-container" data-book-id={book.id} data-slug={slug} data-book-title={book.title_en} data-size={SIZE} data-total={total}>
          <div class="coll-loading"><span class="coll-spinner" aria-hidden="true"></span><p>Reading {book.title_en} from the static corpus…</p></div>
          <noscript><p class="coll-error">This edition is read from a static SQLite corpus in your browser, so it needs JavaScript. The {pages.toLocaleString()} pages of {book.title_en} are otherwise unavailable here; the written research on this site does not require it.</p></noscript>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { initCollectionEdition } from '../../../lib/collection-edition';
  import { initCollectionBrowser } from '../../../lib/collection-browser';
  initCollectionBrowser();
  initCollectionEdition();
</script>

<!-- Global styles for client worker and dynamic chapters injection -->
<style is:global>
  .coll-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6rem 0;
    gap: 1.25rem;
    color: var(--hc-text-tertiary);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .coll-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--hc-rule);
    border-top-color: var(--hc-gold);
    border-radius: 50%;
    animation: coll-spin 0.8s linear infinite;
  }

  @keyframes coll-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .coll-empty,
  .coll-error {
    padding: 4rem 0;
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--hc-text-secondary);
    text-align: center;
  }

  .edition-records-stream {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ── Chapter Landmark Banner ───────────────────────────────── */
  .chapter-landmark {
    position: relative;
    margin: 3.5rem 0 1.5rem;
    scroll-margin-top: calc(var(--site-header-height, 72px) + 2rem);
  }

  .edition-records-stream > .chapter-landmark:first-child {
    margin-top: 1rem;
  }

  .chapter-landmark__rule {
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--hc-gold-dim),
      var(--hc-rule-soft) 40%,
      transparent
    );
    margin-bottom: 1.25rem;
  }

  .chapter-landmark__content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .chapter-landmark__ar {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: 1.45rem;
    line-height: 1.9;
    color: var(--hc-gold);
    direction: rtl;
  }

  .chapter-landmark__en {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--hc-text-primary);
  }

  .chapter-landmark__anchor {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .chapter-landmark__symbol {
    color: var(--hc-gold-dim);
    font-family: var(--font-ui);
    font-size: 1.1rem;
  }

  /* ── Narration Scholarly Record ────────────────────────────── */
  .narration-record {
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    transition:
      background var(--motion-fast) ease,
      border-color var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease;
  }

  .narration-record:hover {
    background: var(--hc-surface-2);
    border-color: var(--hc-gold-dim);
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.2);
  }

  .narration-record__hitlink {
    display: block;
    padding: 1.35rem 1.6rem;
    text-decoration: none;
    color: inherit;
  }

  .narration-record__meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.95rem;
  }

  .narration-record__docket {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .narration-record__num {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--hc-gold);
    text-transform: uppercase;
  }

  .narration-record__source {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--hc-text-tertiary);
  }

  .narration-record__detail-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
    transition:
      color var(--motion-fast) ease,
      gap var(--motion-fast) ease;
  }

  .narration-record:hover .narration-record__detail-cta {
    color: var(--hc-gold);
    gap: 0.55rem;
  }

  .narration-record__spread {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.2rem);
  }

  .narration-record__col {
    min-width: 0;
  }

  .narration-record__prose-en {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.76;
    color: var(--hc-text-secondary);
  }

  .narration-record__prose-ar {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: 1.25rem;
    line-height: 2.15;
    color: var(--hc-text-primary);
    direction: rtl;
    text-align: right;
  }

  .narration-record__missing {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-style: italic;
    color: var(--hc-text-tertiary);
  }

  .narration-record__apparatus-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.15rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .narration-record__tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .apparatus-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.22rem 0.55rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 2px;
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-secondary);
  }

  .apparatus-tag__label {
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
  }

  .apparatus-tag--gold strong {
    color: var(--hc-gold);
  }

  .narration-record__corpus-ref {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--hc-text-tertiary);
  }

  /* ── Pager ─────────────────────────────────────────────────── */
  .edition-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .edition-pager__link {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition:
      background var(--motion-fast) ease,
      border-color var(--motion-fast) ease;
  }

  .edition-pager__link:hover:not(.is-disabled) {
    border-color: var(--hc-gold);
    background: var(--hc-surface-2);
  }

  .edition-pager__link.is-disabled {
    color: var(--hc-text-tertiary);
    border-color: transparent;
    background: transparent;
    pointer-events: none;
  }

  .edition-pager__counter {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-tertiary);
  }

  .edition-pager__counter strong {
    color: var(--hc-text-secondary);
  }

  @media (max-width: 780px) {
    .narration-record__spread {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .narration-record__col--ar {
      grid-column: 1;
      grid-row: 1;
    }
    .narration-record__col--en {
      grid-column: 1;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .narration-record,
    .edition-pager__link {
      transition: none;
    }
  }
</style>
