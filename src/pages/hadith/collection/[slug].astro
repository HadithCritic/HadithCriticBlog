---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { db } from "../../../lib/db";
import { toPlainText, renderArabic } from "../../../lib/format-text";
import { CORPUS_CACHE_CONTROL } from "../../../lib/edge-cache";
import { CANONICAL_BOOKS } from "../../../data/canonical-books";

/**
 * Digital Source Edition for a Single Hadith Compilation.
 * Renders reports in strict manuscript order with bilingual facing columns,
 * bab/chapter landmark divisions, and cursor-seeking pagination.
 */

const { slug } = Astro.params;
const p = Astro.url.searchParams;
const page = Math.max(1, parseInt(p.get("page") || "1", 10) || 1);
const size = 25;
const offset = (page - 1) * size;

const after = parseInt(p.get("after") || "", 10);
const before = parseInt(p.get("before") || "", 10);
const seekAfter = Number.isFinite(after) && after > 0 ? after : null;
const seekBefore = Number.isFinite(before) && before > 0 ? before : null;

const PREVIEW_AR = 420;
const PREVIEW_EN = 380;
const REVEAL_CAP = 8;

interface Book {
  id: number;
  slug: string;
  title_en: string;
  title_ar: string;
  hadith_count: number;
}

interface Row {
  id: number;
  hadith_num: string;
  chapter_en: string;
  chapter_ar: string;
  matn_en: string | null;
  text_en: string;
  matn_ar: string | null;
  text_ar: string;
  narrator_count: number;
  parallel_count: number;
}

let book: Book | undefined;
let rows: Row[] = [];
let failed = false;

function withTimeout<T>(promise: Promise<T>, ms = 1000): Promise<T> {
  return Promise.race([
    promise,
    new Promise<T>((_, reject) =>
      setTimeout(() => reject(new Error("timeout")), ms),
    ),
  ]);
}

try {
  const found = (await withTimeout(
    db
      .prepare(
        "SELECT id, slug, title_en, title_ar, hadith_count FROM hadith_book WHERE slug = ?",
      )
      .bind(slug)
      .first(),
    1000,
  )) as Book | null;
  book = found ?? undefined;

  if (book) {
    const COLUMNS = `id, hadith_num, chapter_en, chapter_ar, matn_en, text_en,
              matn_ar, text_ar, narrator_count, parallel_count`;
    const queryPromise = seekAfter
      ? db
          .prepare(
            `SELECT ${COLUMNS} FROM hadith
              WHERE book_id = ? AND id > ? ORDER BY id LIMIT ?`,
          )
          .bind(book.id, seekAfter, size)
          .all()
      : seekBefore
        ? db
            .prepare(
              `SELECT ${COLUMNS} FROM hadith
                WHERE book_id = ? AND id < ? ORDER BY id DESC LIMIT ?`,
            )
            .bind(book.id, seekBefore, size)
            .all()
        : db
            .prepare(
              `SELECT ${COLUMNS} FROM hadith WHERE book_id = ? ORDER BY id LIMIT ? OFFSET ?`,
            )
            .bind(book.id, size, offset)
            .all();
    const res = await withTimeout(queryPromise, 1500);
    rows = (res.results || []) as unknown as Row[];
    if (seekBefore) rows.reverse();
  }
} catch {
  failed = true;
}

if (!book) {
  const canonical = CANONICAL_BOOKS.find((b) => b.slug === slug);
  if (canonical) {
    book = canonical;
  }
}

if (!book) {
  return new Response("Collection not found", { status: 404 });
}

const total = book?.hadith_count ?? 0;
const pages = Math.max(1, Math.ceil(total / size));

if (!failed && book) {
  Astro.response.headers.set("Cache-Control", CORPUS_CACHE_CONTROL);
}

const pageUrl = (n: number) => `/hadith/collection/${slug}?page=${n}`;

const first = rows[0]?.id;
const last = rows[rows.length - 1]?.id;
const nextUrl = last ? `${pageUrl(page + 1)}&after=${last}` : pageUrl(page + 1);
const prevUrl = first
  ? `${pageUrl(page - 1)}&before=${first}`
  : pageUrl(page - 1);

const preview = (text: string, limit: number) => {
  const clean = (text || "").trim();
  if (clean.length <= limit) return { text: clean, cut: false };
  const space = clean.lastIndexOf(" ", limit);
  return {
    text: clean.slice(0, space > limit * 0.6 ? space : limit),
    cut: true,
  };
};

let lastChapter = "";
let chapterOrdinal = 0;
const slugifyChapter = (text: string) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 48);

const withHeadings = rows.map((r) => {
  const chapter = toPlainText(r.chapter_en) || "";
  const isNew = chapter !== "" && chapter !== lastChapter;
  if (isNew) {
    lastChapter = chapter;
    chapterOrdinal += 1;
  }
  const base = isNew ? slugifyChapter(chapter) : "";
  return {
    row: r,
    heading: isNew
      ? {
          en: chapter,
          ar: (r.chapter_ar || "").trim(),
          id: `ch-${chapterOrdinal}-${base}`,
        }
      : null,
  };
});
---

<BaseLayout
  title={book
    ? `${book.title_en} · Source Edition | HadithCritic`
    : "Collection | HadithCritic"}
  description={book
    ? `Explore all ${book.hadith_count.toLocaleString()} narrations of ${book.title_en} in bilingual facing critical format with complete transmission apparatus.`
    : "Hadith collection edition"}
  image={OG.collection(slug)}
  imageAlt={book ? `${book.title_en} | HadithCritic` : "Hadith collection"}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith" },
    { name: book?.title_en || "Collection", url: `/hadith/collection/${slug}` },
  ]}
>
  <div class="edition-view">
    <!-- Academic Source Masthead -->
    <header class="edition-head">
      <div class="wrap">
        <div class="edition-head__nav">
          <a class="hc-back-link" href="/hadith">
            <span>←</span>
            <span>Return to Full Corpus</span>
          </a>
          <span class="edition-badge">Archival Volume Edition</span>
        </div>

        <div class="edition-head__mast">
          <div class="edition-head__titles">
            <h1 class="edition-title">{book.title_en}</h1>
            {
              book.title_ar && (
                <p class="edition-title-ar" lang="ar" dir="rtl">
                  {book.title_ar}
                </p>
              )
            }
          </div>

          <div class="edition-stats-ledger">
            <div class="edition-stat-entry">
              <span class="edition-stat-entry__label">Volume Extent</span>
              <strong class="edition-stat-entry__val"
                >{book.hadith_count.toLocaleString()} Narrations</strong
              >
            </div>
            <div class="edition-stat-entry">
              <span class="edition-stat-entry__label">Sequence Mode</span>
              <span class="edition-stat-entry__val"
                >Printed Canonical Order</span
              >
            </div>
            <div class="edition-stat-entry">
              <span class="edition-stat-entry__label">Critical Text</span>
              <span class="edition-stat-entry__val"
                >Bilingual Facing Edition</span
              >
            </div>
          </div>
        </div>

        <!-- Scoped In-Collection Search Console -->
        <div class="edition-search-plate">
          <form class="edition-search-form" method="get" action="/hadith">
            <input type="hidden" name="book" value={book.id} />
            <label class="sr-only" for="edition-q"
              >Search within {book.title_en}</label
            >
            <div class="edition-search-bar">
              <span class="edition-search-icon" aria-hidden="true">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </span>
              <input
                id="edition-q"
                class="edition-search-input"
                type="search"
                name="q"
                placeholder={`Search phrases or transmitters within ${book.title_en}…`}
                autocomplete="off"
              />
              <button type="submit" class="edition-search-btn"
                >Search Source</button
              >
            </div>
            <div class="edition-search-context">
              <span class="edition-search-dot" aria-hidden="true"></span>
              <span
                >Query scope restricted to <strong>{book.title_en}</strong
                >.</span
              >
              <a class="edition-search-reset" href="/hadith"
                >Search full corpus instead</a
              >
            </div>
          </form>
        </div>
      </div>
    </header>

    <!-- Source Body / Narrations Sequence -->
    <div class="wrap edition-body">
      {
        rows.length > 0 ? (
          <>
            <div class="edition-records-stream">
              {withHeadings.map(({ row: r, heading }, i) => {
                const ar = preview(r.matn_ar || r.text_ar, PREVIEW_AR);
                const en = preview(
                  toPlainText(r.matn_en || r.text_en),
                  PREVIEW_EN,
                );
                return (
                  <>
                    {heading && (
                      <header class="chapter-landmark" id={heading.id}>
                        <div
                          class="chapter-landmark__rule"
                          aria-hidden="true"
                        />
                        <div class="chapter-landmark__content">
                          {heading.ar && (
                            <p class="chapter-landmark__ar" lang="ar" dir="rtl">
                              {heading.ar}
                            </p>
                          )}
                          <h2 class="chapter-landmark__en">
                            <a
                              class="chapter-landmark__anchor"
                              href={`#${heading.id}`}
                            >
                              <span class="chapter-landmark__symbol">§</span>
                              <span>{heading.en}</span>
                            </a>
                          </h2>
                        </div>
                      </header>
                    )}

                    <article
                      class="narration-record hc-reveal"
                      style={`--reveal-delay:${Math.min(i, REVEAL_CAP)}`}
                    >
                      <a
                        class="narration-record__hitlink"
                        href={`/hadith/${r.id}`}
                      >
                        <div class="narration-record__meta-header">
                          <div class="narration-record__docket">
                            <span class="narration-record__num">
                              {r.hadith_num
                                ? `№ ${r.hadith_num}`
                                : `ID #${r.id}`}
                            </span>
                            <span class="narration-record__source">
                              {book?.title_en}
                            </span>
                          </div>
                          <span class="narration-record__detail-cta">
                            <span>Inspect Apparatus</span>
                            <span class="narration-record__arrow">→</span>
                          </span>
                        </div>

                        <div class="narration-record__spread">
                          <div class="narration-record__col narration-record__col--en">
                            {en.text ? (
                              <p class="narration-record__prose-en">
                                {en.text}
                                {en.cut ? " …" : ""}
                              </p>
                            ) : (
                              <p class="narration-record__missing">
                                Translation not yet registered for this entry.
                              </p>
                            )}
                          </div>

                          <div class="narration-record__col narration-record__col--ar">
                            <p
                              class="narration-record__prose-ar"
                              lang="ar"
                              dir="rtl"
                            >
                              <Fragment set:html={renderArabic(ar.text)} />
                              {ar.cut ? " …" : ""}
                            </p>
                          </div>
                        </div>

                        <div class="narration-record__apparatus-strip">
                          <div class="narration-record__tags">
                            <span class="apparatus-tag">
                              <span class="apparatus-tag__label">Chains:</span>
                              <strong>{r.narrator_count} Transmitters</strong>
                            </span>
                            {Number(r.parallel_count) > 0 && (
                              <span class="apparatus-tag apparatus-tag--gold">
                                <span class="apparatus-tag__label">
                                  Witnesses:
                                </span>
                                <strong>
                                  {Number(r.parallel_count).toLocaleString()}{" "}
                                  Parallels
                                </strong>
                              </span>
                            )}
                          </div>
                          <span class="narration-record__corpus-ref">
                            Corpus Record #{r.id}
                          </span>
                        </div>
                      </a>
                    </article>
                  </>
                );
              })}
            </div>

            <nav
              class="edition-pager"
              aria-label="Collection sequential navigation"
            >
              {page > 1 ? (
                <a class="edition-pager__link" href={prevUrl}>
                  ← Previous Page
                </a>
              ) : (
                <span
                  class="edition-pager__link is-disabled"
                  aria-disabled="true"
                >
                  ← Previous Page
                </span>
              )}
              <span class="edition-pager__counter">
                Page <strong>{page.toLocaleString()}</strong> of{" "}
                <strong>{pages.toLocaleString()}</strong>
              </span>
              {page < pages ? (
                <a class="edition-pager__link" href={nextUrl}>
                  Next Page →
                </a>
              ) : (
                <span
                  class="edition-pager__link is-disabled"
                  aria-disabled="true"
                >
                  Next Page →
                </span>
              )}
            </nav>
          </>
        ) : (
          <div
            id="coll-client-container"
            data-book-id={book.id}
            data-slug={slug}
            data-page={page}
            data-size={size}
            data-seek-after={seekAfter || ""}
            data-seek-before={seekBefore || ""}
            data-total={total}
          >
            <div class="coll-loading">
              <span class="coll-spinner" aria-hidden="true" />
              <p>Querying client archive for {book.title_en} narrations…</p>
            </div>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  import { getCorpusWorker } from "../../../lib/corpus-client";
  import { toPlainText } from "../../../lib/format-text";

  const container = document.getElementById("coll-client-container");
  if (container) {
    const bookId = Number(container.dataset.bookId);
    const slug = container.dataset.slug || "";
    const page = Math.max(1, Number(container.dataset.page) || 1);
    const size = Number(container.dataset.size) || 25;
    const seekAfter = container.dataset.seekAfter
      ? Number(container.dataset.seekAfter)
      : null;
    const seekBefore = container.dataset.seekBefore
      ? Number(container.dataset.seekBefore)
      : null;
    const total = Number(container.dataset.total) || 0;
    const pages = Math.max(1, Math.ceil(total / size));
    const offset = (page - 1) * size;

    const preview = (text: string, limit: number) => {
      const clean = (text || "").trim();
      if (clean.length <= limit) return { text: clean, cut: false };
      const space = clean.lastIndexOf(" ", limit);
      return {
        text: clean.slice(0, space > limit * 0.6 ? space : limit),
        cut: true,
      };
    };

    const escapeHtml = (str: string) =>
      (str || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    async function loadCollection() {
      const el = container;
      if (!el) return;

      try {
        const worker = await getCorpusWorker();
        if (!worker) {
          el.innerHTML =
            '<p class="coll-error">Unable to initialize client archive worker.</p>';
          return;
        }

        const COLUMNS = `id, hadith_num, chapter_en, chapter_ar, matn_en, text_en,
                        matn_ar, text_ar, narrator_count, parallel_count`;
        let query: string;
        let params: unknown[];

        if (seekAfter) {
          query = `SELECT ${COLUMNS} FROM hadith WHERE book_id = ? AND id > ? ORDER BY id LIMIT ?`;
          params = [bookId, seekAfter, size];
        } else if (seekBefore) {
          query = `SELECT ${COLUMNS} FROM hadith WHERE book_id = ? AND id < ? ORDER BY id DESC LIMIT ?`;
          params = [bookId, seekBefore, size];
        } else {
          query = `SELECT ${COLUMNS} FROM hadith WHERE book_id = ? ORDER BY id LIMIT ? OFFSET ?`;
          params = [bookId, size, offset];
        }

        let rows = await worker.db.query(query, params);
        if (seekBefore && rows) rows.reverse();

        if (!rows || rows.length === 0) {
          el.innerHTML =
            '<p class="coll-empty">No narrations recorded for this collection.</p>';
          return;
        }

        let lastChapter = "";
        let chapterOrdinal = 0;
        let listHtml = '<div class="edition-records-stream">';
        const slugifyChapter = (text: string) =>
          text
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/^-+|-+$/g, "")
            .slice(0, 48);

        for (const r of rows) {
          const chapter = toPlainText(r.chapter_en || "");
          const isNew = chapter !== "" && chapter !== lastChapter;
          if (isNew) {
            lastChapter = chapter;
            chapterOrdinal += 1;
            const chId = `ch-${chapterOrdinal}-${slugifyChapter(chapter)}`;
            listHtml += `
              <header class="chapter-landmark" id="${chId}">
                <div class="chapter-landmark__rule" aria-hidden="true"></div>
                <div class="chapter-landmark__content">
                  ${r.chapter_ar ? `<p class="chapter-landmark__ar" lang="ar" dir="rtl">${escapeHtml(r.chapter_ar.trim())}</p>` : ""}
                  <h2 class="chapter-landmark__en">
                    <a class="chapter-landmark__anchor" href="#${chId}">
                      <span class="chapter-landmark__symbol">§</span>
                      <span>${escapeHtml(chapter)}</span>
                    </a>
                  </h2>
                </div>
              </header>
            `;
          }

          const ar = preview(r.matn_ar || r.text_ar || "", 420);
          const en = preview(toPlainText(r.matn_en || r.text_en || ""), 380);
          const numLabel = r.hadith_num
            ? `№ ${escapeHtml(r.hadith_num)}`
            : `ID #${r.id}`;

          listHtml += `
            <article class="narration-record">
              <a class="narration-record__hitlink" href="/hadith/${r.id}">
                <div class="narration-record__meta-header">
                  <div class="narration-record__docket">
                    <span class="narration-record__num">${numLabel}</span>
                  </div>
                  <span class="narration-record__detail-cta">
                    <span>Inspect Apparatus</span>
                    <span class="narration-record__arrow">→</span>
                  </span>
                </div>
                <div class="narration-record__spread">
                  <div class="narration-record__col narration-record__col--en">
                    ${en.text ? `<p class="narration-record__prose-en">${escapeHtml(en.text)}${en.cut ? " …" : ""}</p>` : `<p class="narration-record__missing">Translation not recorded.</p>`}
                  </div>
                  <div class="narration-record__col narration-record__col--ar">
                    <p class="narration-record__prose-ar" lang="ar" dir="rtl">${ar.text}${ar.cut ? " …" : ""}</p>
                  </div>
                </div>
                <div class="narration-record__apparatus-strip">
                  <div class="narration-record__tags">
                    <span class="apparatus-tag">
                      <span class="apparatus-tag__label">Chains:</span>
                      <strong>${r.narrator_count} Transmitters</strong>
                    </span>
                    ${
                      Number(r.parallel_count) > 0
                        ? `
                      <span class="apparatus-tag apparatus-tag--gold">
                        <span class="apparatus-tag__label">Witnesses:</span>
                        <strong>${Number(r.parallel_count).toLocaleString()} Parallels</strong>
                      </span>`
                        : ""
                    }
                  </div>
                  <span class="narration-record__corpus-ref">Corpus Record #${r.id}</span>
                </div>
              </a>
            </article>
          `;
        }
        listHtml += "</div>";

        const pageUrl = (n: number) => `/hadith/collection/${slug}?page=${n}`;
        const first = rows[0]?.id;
        const last = rows[rows.length - 1]?.id;
        const nextUrl = last
          ? `${pageUrl(page + 1)}&after=${last}`
          : pageUrl(page + 1);
        const prevUrl = first
          ? `${pageUrl(page - 1)}&before=${first}`
          : pageUrl(page - 1);

        listHtml += `
          <nav class="edition-pager" aria-label="Collection sequential navigation">
            ${page > 1 ? `<a class="edition-pager__link" href="${prevUrl}">← Previous Page</a>` : `<span class="edition-pager__link is-disabled" aria-disabled="true">← Previous Page</span>`}
            <span class="edition-pager__counter">Page <strong>${page.toLocaleString()}</strong> of <strong>${pages.toLocaleString()}</strong></span>
            ${page < pages ? `<a class="edition-pager__link" href="${nextUrl}">Next Page →</a>` : `<span class="edition-pager__link is-disabled" aria-disabled="true">Next Page →</span>`}
          </nav>
        `;

        el.innerHTML = listHtml;
      } catch (err) {
        console.error("Failed to load collection from worker:", err);
        el.innerHTML =
          '<p class="coll-error">Unable to render source archive records.</p>';
      }
    }

    loadCollection();
  }
</script>

<style>
  .edition-view {
    background: var(--hc-surface-0);
    min-height: 100vh;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* ── Collection Masthead ───────────────────────────────────── */
  .edition-head {
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--hc-rule);
    background: radial-gradient(
      circle at 90% 10%,
      color-mix(in srgb, var(--hc-gold) 5%, transparent) 0%,
      transparent 65%
    );
  }

  .edition-head__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .edition-badge {
    padding: 0.22rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .edition-head__mast {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .edition-head__titles {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .edition-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--hc-text-primary);
  }

  .edition-title-ar {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    line-height: 1.6;
    color: var(--hc-gold);
    direction: rtl;
  }

  .edition-stats-ledger {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
    padding: 0.95rem 1.25rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
  }

  .edition-stat-entry {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
  }

  .edition-stat-entry__label {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .edition-stat-entry__val {
    color: var(--hc-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  /* ── Scoped Search ─────────────────────────────────────────── */
  .edition-search-plate {
    max-width: 46rem;
    margin-top: 1.85rem;
  }

  .edition-search-bar {
