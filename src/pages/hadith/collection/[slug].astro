---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { OG } from '../../../lib/seo';
import { db } from '../../../lib/db';
import { toPlainText, renderArabic } from '../../../lib/format-text';
import { CORPUS_CACHE_CONTROL } from '../../../lib/edge-cache';
import { CANONICAL_BOOKS } from '../../../data/canonical-books';

/**
 * One collection, read in its own order.
 *
 * The counterpart to searching. A reader who wants Sahih Muslim from the
 * beginning should get it in sequence, with the chapter headings that structure
 * it, rather than having to invent a query that happens to surface it.
 *
 * Laid out like the narration page: a chapter banner carrying both scripts,
 * then each report with the Arabic and the translation in facing columns. The
 * point of the corpus is reading one against the other, and a stacked list put
 * a screen height between them.
 *
 * Sequence is `hadith.id`, not `hadith_num`. The numbers are stored as text and
 * 33,794 narrations carry none at all, so sorting by them would interleave
 * "10" before "9" and strand every unnumbered report. The ids were assigned in
 * source order, so ordering by id reproduces the printed sequence and rides the
 * (book_id, id) index instead of sorting.
 *
 * Chapter headings are emitted when the chapter changes between adjacent rows.
 * They are bab level, not kitab level: the corpus records 56,896 of them across
 * 33 collections, which is a heading per few narrations rather than a table of
 * contents. That makes them a reading aid here and a poor navigation tree, so
 * no chapter index is offered.
 */

const { slug } = Astro.params;
const p = Astro.url.searchParams;
const page = Math.max(1, parseInt(p.get('page') || '1', 10) || 1);
const size = 25;
const offset = (page - 1) * size;

/**
 * Where to resume from, when the reader arrived by following the pager.
 *
 * `LIMIT 25 OFFSET n` walks and discards every row it skips, so reading a
 * large collection got steadily more expensive the further in you were: page 1
 * of Musannaf Ibn Abi Shaybah costs 58 rows and page 1,564 costs 39,097. On a
 * backend that bills rows read, the cost of reading a collection through was
 * quadratic in its length.
 *
 * Seeking on the primary key instead is 25 rows at any depth. `ORDER BY id`
 * already rides `(book_id, id)`, so the cursor is just the last id on the page
 * you came from — the Next link carries it, and Previous carries the first id
 * to seek backwards.
 *
 * The page number is still in the URL and still shown, and `?page=N` on its
 * own still works: without a cursor this falls back to OFFSET, so an old link,
 * a shared link, or a crawler jumping straight to page 900 all behave exactly
 * as before. Only sequential reading — the thing this page exists for — gets
 * the cheap path.
 */
const after = parseInt(p.get('after') || '', 10);
const before = parseInt(p.get('before') || '', 10);
const seekAfter = Number.isFinite(after) && after > 0 ? after : null;
const seekBefore = Number.isFinite(before) && before > 0 ? before : null;

/** Characters of each narration shown in the list before it is cut. */
const PREVIEW_AR = 420;
const PREVIEW_EN = 380;

interface Book {
  id: number;
  slug: string;
  title_en: string;
  title_ar: string;
  hadith_count: number;
}

interface Row {
  id: number;
  hadith_num: string;
  chapter_en: string;
  chapter_ar: string;
  matn_en: string | null;
  text_en: string;
  matn_ar: string | null;
  text_ar: string;
  narrator_count: number;
  parallel_count: number;
}

let book: Book | undefined;
let rows: Row[] = [];
let failed = false;

function withTimeout<T>(p: Promise<T>, ms = 1000): Promise<T> {
  return Promise.race([
    p,
    new Promise<T>((_, reject) => setTimeout(() => reject(new Error('timeout')), ms))
  ]);
}

try {
  const found = (await withTimeout(
    db.prepare(
      'SELECT id, slug, title_en, title_ar, hadith_count FROM hadith_book WHERE slug = ?'
    )
      .bind(slug)
      .first(),
    1000
  )) as Book | null;
  book = found ?? undefined;

  if (book) {
    const COLUMNS = `id, hadith_num, chapter_en, chapter_ar, matn_en, text_en,
              matn_ar, text_ar, narrator_count, parallel_count`;
    const queryPromise = seekAfter
      ? db
          .prepare(
            `SELECT ${COLUMNS} FROM hadith
              WHERE book_id = ? AND id > ? ORDER BY id LIMIT ?`
          )
          .bind(book.id, seekAfter, size)
          .all()
      : seekBefore
        ? db
            .prepare(
              `SELECT ${COLUMNS} FROM hadith
                WHERE book_id = ? AND id < ? ORDER BY id DESC LIMIT ?`
            )
            .bind(book.id, seekBefore, size)
            .all()
        : db
            .prepare(`SELECT ${COLUMNS} FROM hadith WHERE book_id = ? ORDER BY id LIMIT ? OFFSET ?`)
            .bind(book.id, size, offset)
            .all();
    const res = await withTimeout(queryPromise, 1500);
    rows = (res.results || []) as unknown as Row[];
    if (seekBefore) rows.reverse();
  }
} catch {
  // Remote database quota exhausted or timeout; graceful degrade to client-side
  failed = true;
}

if (!book) {
  const canonical = CANONICAL_BOOKS.find((b) => b.slug === slug);
  if (canonical) {
    book = canonical;
  }
}

if (!book) {
  return new Response('Collection not found', { status: 404 });
}

// Already stored per collection, so sequence never costs a count. Pages are
// not capped here as they are on search — reading a collection through is the
// point of the page — which is exactly why the pager seeks on a cursor rather
// than paying OFFSET at depth. See the note on `seekAfter` above.
const total = book?.hadith_count ?? 0;
const pages = Math.max(1, Math.ceil(total / size));

// Only a page that actually read the collection is cacheable, never the
// "temporarily unavailable" fallback. See src/lib/edge-cache.ts.
if (!failed && book) {
  Astro.response.headers.set('Cache-Control', CORPUS_CACHE_CONTROL);
}

const pageUrl = (n: number) => `/hadith/collection/${slug}?page=${n}`;

// The pager carries a cursor so the next or previous page can seek instead of
// counting past everything before it. The page number rides along so the label
// and any shared link keep working.
const first = rows[0]?.id;
const last = rows[rows.length - 1]?.id;
const nextUrl = last ? `${pageUrl(page + 1)}&after=${last}` : pageUrl(page + 1);
const prevUrl = first ? `${pageUrl(page - 1)}&before=${first}` : pageUrl(page - 1);

/** Cut on a word boundary so a preview never ends mid-word. */
const preview = (text: string, limit: number) => {
  const clean = (text || '').trim();
  if (clean.length <= limit) return { text: clean, cut: false };
  const space = clean.lastIndexOf(' ', limit);
  return { text: clean.slice(0, space > limit * 0.6 ? space : limit), cut: true };
};

// Chapter headings repeat across consecutive narrations; show one per run.
let lastChapter = '';
const withHeadings = rows.map((r) => {
  const chapter = toPlainText(r.chapter_en) || '';
  const isNew = chapter !== '' && chapter !== lastChapter;
  if (isNew) lastChapter = chapter;
  return {
    row: r,
    heading: isNew ? { en: chapter, ar: (r.chapter_ar || '').trim() } : null
  };
});
---

<BaseLayout
  title={book ? `${book.title_en} | HadithCritic` : 'Collection | HadithCritic'}
  description={book
    ? `Browse all ${book.hadith_count.toLocaleString()} narrations of ${book.title_en} in Arabic and English, in sequence, with no authenticity gradings.`
    : 'Hadith collection'}
  image={OG.collection(slug)}
  imageAlt={book ? `${book.title_en} | HadithCritic` : 'Hadith collection'}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Hadith', url: '/hadith' },
    { name: book?.title_en || 'Collection', url: `/hadith/collection/${slug}` }
  ]}
>
  <div class="coll-page">
    <header class="coll-head">
      <div class="wrap">
        <p class="coll-eyebrow"><a href="/hadith">Corpus</a> — Collection</p>
        <div class="coll-header-titles">
          <h1 class="coll-title">{book.title_en}</h1>
          {book.title_ar && (
            <p class="coll-title-ar" lang="ar" dir="rtl">{book.title_ar}</p>
          )}
        </div>
        <p class="coll-count">
          <span class="coll-count-number">{book.hadith_count.toLocaleString()}</span> narrations, in the order they appear in the source edition.
        </p>

        <form class="coll-search" method="get" action="/hadith">
          <input type="hidden" name="book" value={book.id} />
          <label class="sr-only" for="coll-q">Search within {book.title_en}</label>
          <input
            id="coll-q"
            class="coll-search__input"
            type="search"
            name="q"
            placeholder={`Search within ${book.title_en}…`}
            autocomplete="off"
          />
          <button type="submit" class="coll-search__go">Search Collection</button>
        </form>
      </div>
    </header>

    <div class="wrap coll-body">
      {rows.length > 0 ? (
        <>
          <div class="coll-list">
            {withHeadings.map(({ row: r, heading }) => {
              const ar = preview(r.matn_ar || r.text_ar, PREVIEW_AR);
              const en = preview(toPlainText(r.matn_en || r.text_en), PREVIEW_EN);
              return (
                <>
                  {heading && (
                    <div class="coll-chapter">
                      {heading.ar && (
                        <p class="coll-chapter__ar" lang="ar" dir="rtl">{heading.ar}</p>
                      )}
                      <h2 class="coll-chapter__en">{heading.en}</h2>
                    </div>
                  )}
                  <article class="coll-item">
                    <a class="coll-item__link" href={`/hadith/${r.id}`}>
                      <div class="coll-item__top">
                        <span class="coll-item__num">
                          {r.hadith_num ? `№ ${r.hadith_num}` : `ID ${r.id}`}
                        </span>
                      </div>

                      <div class="coll-item__cols">
                        <div class="coll-item__col coll-item__col--en">
                          {en.text ? (
                            <p class="coll-item__en">{en.text}{en.cut ? ' …' : ''}</p>
                          ) : (
                            <p class="coll-item__missing">No translation recorded.</p>
                          )}
                        </div>
                        <div class="coll-item__col coll-item__col--ar">
                          <p class="coll-item__ar" lang="ar" dir="rtl">
                            <Fragment set:html={renderArabic(ar.text)} />{ar.cut ? ' …' : ''}
                          </p>
                        </div>
                      </div>

                      <div class="coll-item__meta">
                        <span class="coll-meta-tag">{r.narrator_count} transmitters</span>
                        {Number(r.parallel_count) > 0 && (
                          <span class="coll-meta-tag">{Number(r.parallel_count).toLocaleString()} parallels</span>
                        )}
                      </div>
                    </a>
                  </article>
                </>
              );
            })}
          </div>

          <nav class="coll-pager" aria-label="Collection pages">
            {page > 1 ? (
              <a class="coll-page" href={prevUrl}>← Previous</a>
            ) : (
              <span class="coll-page" aria-disabled="true">← Previous</span>
            )}
            <span class="coll-page-of">
              Page {page.toLocaleString()} of {pages.toLocaleString()}
            </span>
            {page < pages ? (
              <a class="coll-page" href={nextUrl}>Next →</a>
            ) : (
              <span class="coll-page" aria-disabled="true">Next →</span>
            )}
          </nav>
        </>
      ) : (
        <div
          id="coll-client-container"
          data-book-id={book.id}
          data-slug={slug}
          data-page={page}
          data-size={size}
          data-seek-after={seekAfter || ''}
          data-seek-before={seekBefore || ''}
          data-total={total}
        >
          <div class="coll-loading">
            <span class="coll-spinner" aria-hidden="true"></span>
            <p>Loading {book.title_en} narrations from corpus archive…</p>
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { getCorpusWorker } from '../../../lib/corpus-client';
  import { toPlainText } from '../../../lib/format-text';

  const container = document.getElementById('coll-client-container');
  if (container) {
    const bookId = Number(container.dataset.bookId);
    const slug = container.dataset.slug || '';
    const page = Math.max(1, Number(container.dataset.page) || 1);
    const size = Number(container.dataset.size) || 25;
    const seekAfter = container.dataset.seekAfter ? Number(container.dataset.seekAfter) : null;
    const seekBefore = container.dataset.seekBefore ? Number(container.dataset.seekBefore) : null;
    const total = Number(container.dataset.total) || 0;
    const pages = Math.max(1, Math.ceil(total / size));
    const offset = (page - 1) * size;

    const preview = (text: string, limit: number) => {
      const clean = (text || '').trim();
      if (clean.length <= limit) return { text: clean, cut: false };
      const space = clean.lastIndexOf(' ', limit);
      return { text: clean.slice(0, space > limit * 0.6 ? space : limit), cut: true };
    };

    const escapeHtml = (str: string) =>
      (str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');

    async function loadCollection() {
      const el = container;
      if (!el) return;

      try {
        const worker = await getCorpusWorker();
        if (!worker) {
          el.innerHTML = '<p class="coll-error">Unable to load collection from database archive.</p>';
          return;
        }

        const COLUMNS = `id, hadith_num, chapter_en, chapter_ar, matn_en, text_en,
                        matn_ar, text_ar, narrator_count, parallel_count`;
        let query: string;
        let params: unknown[];

        if (seekAfter) {
          query = `SELECT ${COLUMNS} FROM hadith WHERE book_id = ? AND id > ? ORDER BY id LIMIT ?`;
          params = [bookId, seekAfter, size];
        } else if (seekBefore) {
          query = `SELECT ${COLUMNS} FROM hadith WHERE book_id = ? AND id < ? ORDER BY id DESC LIMIT ?`;
          params = [bookId, seekBefore, size];
        } else {
          query = `SELECT ${COLUMNS} FROM hadith WHERE book_id = ? ORDER BY id LIMIT ? OFFSET ?`;
          params = [bookId, size, offset];
        }

        let rows = await worker.db.query(query, params);
        if (seekBefore && rows) rows.reverse();

        if (!rows || rows.length === 0) {
          el.innerHTML = '<p class="coll-empty">No narrations found in this collection.</p>';
          return;
        }

        let lastChapter = '';
        let listHtml = '<div class="coll-list">';

        for (const r of rows) {
          const chapter = toPlainText(r.chapter_en || '');
          const isNew = chapter !== '' && chapter !== lastChapter;
          if (isNew) {
            lastChapter = chapter;
            listHtml += `
              <div class="coll-chapter">
                ${r.chapter_ar ? `<p class="coll-chapter__ar" lang="ar" dir="rtl">${escapeHtml(r.chapter_ar.trim())}</p>` : ''}
                <h2 class="coll-chapter__en">${escapeHtml(chapter)}</h2>
              </div>
            `;
          }

          const ar = preview(r.matn_ar || r.text_ar || '', 420);
          const en = preview(toPlainText(r.matn_en || r.text_en || ''), 380);
          const numLabel = r.hadith_num ? `№ ${escapeHtml(r.hadith_num)}` : `ID ${r.id}`;

          listHtml += `
            <article class="coll-item">
              <a class="coll-item__link" href="/hadith/${r.id}">
                <div class="coll-item__top">
                  <span class="coll-item__num">${numLabel}</span>
                </div>
                <div class="coll-item__cols">
                  <div class="coll-item__col coll-item__col--en">
                    ${en.text ? `<p class="coll-item__en">${escapeHtml(en.text)}${en.cut ? ' …' : ''}</p>` : `<p class="coll-item__missing">No translation recorded.</p>`}
                  </div>
                  <div class="coll-item__col coll-item__col--ar">
                    <p class="coll-item__ar" lang="ar" dir="rtl">${ar.text}${ar.cut ? ' …' : ''}</p>
                  </div>
                </div>
                <div class="coll-item__meta">
                  <span class="coll-meta-tag">${r.narrator_count} transmitters</span>
                  ${Number(r.parallel_count) > 0 ? `<span class="coll-meta-tag">${Number(r.parallel_count).toLocaleString()} parallels</span>` : ''}
                </div>
              </a>
            </article>
          `;
        }
        listHtml += '</div>';

        const pageUrl = (n: number) => `/hadith/collection/${slug}?page=${n}`;
        const first = rows[0]?.id;
        const last = rows[rows.length - 1]?.id;
        const nextUrl = last ? `${pageUrl(page + 1)}&after=${last}` : pageUrl(page + 1);
        const prevUrl = first ? `${pageUrl(page - 1)}&before=${first}` : pageUrl(page - 1);

        listHtml += `
          <nav class="coll-pager" aria-label="Collection pages">
            ${page > 1 ? `<a class="coll-page" href="${prevUrl}">← Previous</a>` : `<span class="coll-page" aria-disabled="true">← Previous</span>`}
            <span class="coll-page-of">Page ${page.toLocaleString()} of ${pages.toLocaleString()}</span>
            ${page < pages ? `<a class="coll-page" href="${nextUrl}">Next →</a>` : `<span class="coll-page" aria-disabled="true">Next →</span>`}
          </nav>
        `;

        el.innerHTML = listHtml;
      } catch (err) {
        console.error('Failed to load collection client-side:', err);
        el.innerHTML = '<p class="coll-error">Unable to load collection narrations. Please try refreshing.</p>';
      }
    }

    loadCollection();
  }
</script>

<style>
  .coll-page {
    background: var(--hc-surface-0);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .coll-head {
    padding: clamp(3rem, 6vw, 4.5rem) 0 clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--hc-rule);
  }

  .coll-eyebrow {
    margin: 0 0 0.85rem;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .coll-eyebrow a {
    color: var(--hc-gold);
    text-decoration: none;
  }
  .coll-eyebrow a:hover {
    text-decoration: underline;
  }

  .coll-header-titles {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .coll-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--hc-text-primary);
  }

  .coll-title-ar {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.4;
    color: var(--hc-gold);
    direction: rtl;
  }

  .coll-count {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: 1rem 0 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--hc-text-secondary);
  }

  .coll-count-number {
    font-weight: 600;
    color: var(--hc-text-primary);
    font-variant-numeric: tabular-nums;
  }

  .coll-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 44rem;
    margin-top: 1.75rem;
    padding: 0.25rem 0.5rem 0.25rem 1rem;
    border: 1px solid var(--hc-rule);
    border-radius: 4px;
    background: var(--hc-surface-1);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .coll-search:focus-within {
    border-color: var(--hc-gold);
    box-shadow: 0 0 0 1px var(--hc-gold);
  }

  .coll-search__input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: var(--hc-text-primary);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .coll-search__input::placeholder { color: var(--hc-text-tertiary); }
  .coll-search__input:focus { outline: none; }

  .coll-search__go {
    flex: none;
    padding: 0.45rem 1rem;
    border: 1px solid var(--hc-rule);
    border-radius: 3px;
    background: var(--hc-surface-2);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }

  .coll-search__go:hover {
    background: color-mix(in srgb, var(--hc-gold) 15%, var(--hc-surface-2));
    border-color: var(--hc-gold);
  }

  .coll-body { padding-top: clamp(1.5rem, 3vw, 2.25rem); }

  @media (max-width: 700px) {
    .coll-header-titles {
      flex-direction: column;
      gap: 0.35rem;
    }
    .coll-search {
      flex-direction: column;
      align-items: stretch;
      padding: 0.5rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coll-search, .coll-search__go { transition: none; }
  }
</style>

<!-- Styles for the collection narrations and chapters must be global because
     the client-side web worker injects them via innerHTML on quota exhaustion. -->
<style is:global>
  .coll-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 0;
    gap: 1.25rem;
    color: var(--hc-text-tertiary);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .coll-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--hc-rule);
    border-top-color: var(--hc-gold);
    border-radius: 50%;
    animation: coll-spin 0.8s linear infinite;
  }

  @keyframes coll-spin {
    to { transform: rotate(360deg); }
  }

  .coll-empty,
  .coll-error {
    padding: 4rem 0;
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--hc-text-secondary);
  }

  .coll-list {
    margin: 0;
    padding: 0;
  }

  /* ---- chapter banner ---- */
  .coll-chapter {
    margin: 2.75rem 0 1.25rem;
    padding: 1.25rem 1.75rem;
    border: 1px solid var(--hc-rule-strong);
    border-radius: 4px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--hc-gold) 6%, var(--hc-surface-1)), var(--hc-surface-1));
    text-align: center;
  }

  .coll-list > .coll-chapter:first-child { margin-top: 1rem; }

  .coll-chapter__ar {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: 1.35rem;
    line-height: 2;
    color: var(--hc-gold);
    direction: rtl;
  }

  .coll-chapter__en {
    max-width: 60ch;
    margin: 0.35rem auto 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--hc-text-primary);
  }

  /* ---- narration card ---- */
  .coll-item {
    margin-bottom: 0.85rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 4px;
    background: var(--hc-surface-1);
    transition: background 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .coll-item:hover {
    background: var(--hc-surface-2);
    border-color: var(--hc-gold-dim);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .coll-item__link {
    display: block;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
