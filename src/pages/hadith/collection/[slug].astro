---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { CORPUS_META } from "../../../lib/corpus-config";

/**
 * Digital source edition for a single hadith compilation.
 *
 * The shell is prerendered, one page per collection, from the generated corpus
 * metadata: there are thirty-three of them and their titles and extents are
 * fixed for a corpus version, so a crawler and a reader with JavaScript off
 * both get the real thing. The narrations are read from the static corpus in
 * the browser by src/lib/collection-edition.ts, because 276,347 records across
 * 11,054 pages is not a set to prerender.
 */
export function getStaticPaths() {
  return CORPUS_META.collections.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { slug } = Astro.params;
const { book } = Astro.props;

const SIZE = 25;
const total = book.hadith_count;
const pages = Math.max(1, Math.ceil(total / SIZE));
---

<BaseLayout
  title={`${book.title_en} · Source Edition | HadithCritic`}
  description={`Explore all ${book.hadith_count.toLocaleString()} narrations of ${book.title_en} in bilingual facing critical format with complete transmission apparatus.`}
  image={OG.collection(slug)}
  imageAlt={`${book.title_en} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: book.title_en, url: `/hadith/collection/${slug}/` },
  ]}
>
  <div class="edition-view">
    <!-- Academic Source Masthead -->
    <header class="edition-head">
      <div class="wrap">
        <div class="edition-head__nav">
          <a class="hc-back-link" href="/hadith/">
            <span>←</span>
            <span>Return to Full Corpus</span>
          </a>
          <span class="edition-badge">Archival Volume Edition</span>
        </div>

        <div class="edition-head__mast">
          <div class="edition-head__titles">
            <h1 class="edition-title">{book.title_en}</h1>
            {
              book.title_ar && (
                <p class="edition-title-ar" lang="ar" dir="rtl">
                  {book.title_ar}
                </p>
              )
            }
          </div>

          <div class="edition-stats-ledger">
            <div class="edition-stat-entry">
              <span class="edition-stat-entry__label">Volume Extent</span>
              <strong class="edition-stat-entry__val"
                >{book.hadith_count.toLocaleString()} Narrations</strong
              >
            </div>
            <div class="edition-stat-entry">
              <span class="edition-stat-entry__label">Sequence Mode</span>
              <span class="edition-stat-entry__val"
                >Printed Canonical Order</span
              >
            </div>
            <div class="edition-stat-entry">
              <span class="edition-stat-entry__label">Critical Text</span>
              <span class="edition-stat-entry__val"
                >Bilingual Facing Edition</span
              >
            </div>
          </div>
        </div>

        <!-- Scoped In-Collection Search Console -->
        <div class="edition-search-plate">
          <form class="edition-search-form" method="get" action="/hadith/">
            <input type="hidden" name="book" value={book.id} />
            <label class="sr-only" for="edition-q"
              >Search within {book.title_en}</label
            >
            <div class="edition-search-bar">
              <span class="edition-search-icon" aria-hidden="true">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </span>
              <input
                id="edition-q"
                class="edition-search-input"
                type="search"
                name="q"
                placeholder={`Search phrases or transmitters within ${book.title_en}…`}
                autocomplete="off"
              />
              <button type="submit" class="edition-search-btn"
                >Search Source</button
              >
            </div>
            <div class="edition-search-context">
              <span class="edition-search-dot" aria-hidden="true"></span>
              <span
                >Query scope restricted to <strong>{book.title_en}</strong
                >.</span
              >
              <a class="edition-search-reset" href="/hadith/"
                >Search full corpus instead</a
              >
            </div>
          </form>
        </div>
      </div>
    </header>

    <!-- Source Body / Narrations Sequence -->
    <div class="wrap edition-body">
      <div
        id="coll-client-container"
        data-book-id={book.id}
        data-slug={slug}
        data-book-title={book.title_en}
        data-size={SIZE}
        data-total={total}
      >
        <div class="coll-loading">
          <span class="coll-spinner" aria-hidden="true"></span>
          <p>Reading {book.title_en} from the static corpus…</p>
        </div>
        <noscript>
          <p class="coll-error">
            This edition is read from a static SQLite corpus in your browser, so
            it needs JavaScript. The {pages.toLocaleString()} pages of {book.title_en}
            are otherwise unavailable here; the written research on this site does
            not require it.
          </p>
        </noscript>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initCollectionEdition } from "../../../lib/collection-edition";
  initCollectionEdition();
</script>

<style>
  .edition-view {
    background: var(--hc-surface-0);
    min-height: 100vh;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* ── Collection Masthead ───────────────────────────────────── */
  .edition-head {
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--hc-rule);
    background: radial-gradient(
      circle at 90% 10%,
      color-mix(in srgb, var(--hc-gold) 5%, transparent) 0%,
      transparent 65%
    );
  }

  .edition-head__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .edition-badge {
    padding: 0.22rem 0.65rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .edition-head__mast {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .edition-head__titles {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .edition-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--hc-text-primary);
  }

  .edition-title-ar {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    line-height: 1.6;
    color: var(--hc-gold);
    direction: rtl;
  }

  .edition-stats-ledger {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
    padding: 0.95rem 1.25rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
  }

  .edition-stat-entry {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
  }

  .edition-stat-entry__label {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .edition-stat-entry__val {
    color: var(--hc-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  /* ── Scoped Search ─────────────────────────────────────────── */
  .edition-search-plate {
    max-width: 46rem;
    margin-top: 1.85rem;
  }

  .edition-search-bar {
    display: flex;
    align-items: center;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    overflow: hidden;
    transition: border-color var(--motion-fast) ease;
  }

  .edition-search-bar:focus-within {
    border-color: var(--hc-gold);
  }

  .edition-search-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 1rem;
    color: var(--hc-gold);
  }

  .edition-search-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--hc-text-primary);
  }

  .edition-search-btn {
    padding: 0 1.25rem;
    height: 100%;
    align-self: stretch;
    border: none;
    border-left: 1px solid var(--hc-rule-soft);
    background: var(--hc-surface-2);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }

  .edition-search-btn:hover {
    background: var(--hc-gold);
    color: var(--hc-surface-0);
  }

  .edition-search-context {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.65rem;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    color: var(--hc-text-tertiary);
  }

  .edition-search-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hc-gold);
  }

  .edition-search-reset {
    color: var(--hc-gold);
    text-decoration: none;
    margin-left: 0.35rem;
  }

  .edition-search-reset:hover {
    text-decoration: underline;
  }

  .edition-body {
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  @media (max-width: 700px) {
    .edition-head__titles {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

<!-- Global styles for client worker and dynamic chapters injection -->
<style is:global>
  .coll-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6rem 0;
    gap: 1.25rem;
    color: var(--hc-text-tertiary);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .coll-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--hc-rule);
    border-top-color: var(--hc-gold);
    border-radius: 50%;
    animation: coll-spin 0.8s linear infinite;
  }

  @keyframes coll-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .coll-empty,
  .coll-error {
    padding: 4rem 0;
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--hc-text-secondary);
    text-align: center;
  }

  .edition-records-stream {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ── Chapter Landmark Banner ───────────────────────────────── */
  .chapter-landmark {
    position: relative;
    margin: 3.5rem 0 1.5rem;
    scroll-margin-top: calc(var(--site-header-height, 72px) + 2rem);
  }

  .edition-records-stream > .chapter-landmark:first-child {
    margin-top: 1rem;
  }

  .chapter-landmark__rule {
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--hc-gold-dim),
      var(--hc-rule-soft) 40%,
      transparent
    );
    margin-bottom: 1.25rem;
  }

  .chapter-landmark__content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .chapter-landmark__ar {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: 1.45rem;
    line-height: 1.9;
    color: var(--hc-gold);
    direction: rtl;
  }

  .chapter-landmark__en {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--hc-text-primary);
  }

  .chapter-landmark__anchor {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .chapter-landmark__symbol {
    color: var(--hc-gold-dim);
    font-family: var(--font-ui);
    font-size: 1.1rem;
  }

  /* ── Narration Scholarly Record ────────────────────────────── */
  .narration-record {
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    transition:
      background var(--motion-fast) ease,
      border-color var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease;
  }

  .narration-record:hover {
    background: var(--hc-surface-2);
    border-color: var(--hc-gold-dim);
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.2);
  }

  .narration-record__hitlink {
    display: block;
    padding: 1.35rem 1.6rem;
    text-decoration: none;
    color: inherit;
  }

  .narration-record__meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.95rem;
  }

  .narration-record__docket {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .narration-record__num {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--hc-gold);
    text-transform: uppercase;
  }

  .narration-record__source {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--hc-text-tertiary);
  }

  .narration-record__detail-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
    transition:
      color var(--motion-fast) ease,
      gap var(--motion-fast) ease;
  }

  .narration-record:hover .narration-record__detail-cta {
    color: var(--hc-gold);
    gap: 0.55rem;
  }

  .narration-record__spread {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.2rem);
  }

  .narration-record__col {
    min-width: 0;
  }

  .narration-record__prose-en {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.76;
    color: var(--hc-text-secondary);
  }

  .narration-record__prose-ar {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: 1.25rem;
    line-height: 2.15;
    color: var(--hc-text-primary);
    direction: rtl;
    text-align: right;
  }

  .narration-record__missing {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-style: italic;
    color: var(--hc-text-tertiary);
  }

  .narration-record__apparatus-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.15rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .narration-record__tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .apparatus-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.22rem 0.55rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 2px;
    background: var(--hc-surface-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-secondary);
  }

  .apparatus-tag__label {
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
  }

  .apparatus-tag--gold strong {
    color: var(--hc-gold);
  }

  .narration-record__corpus-ref {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--hc-text-tertiary);
  }

  /* ── Pager ─────────────────────────────────────────────────── */
  .edition-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .edition-pager__link {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    background: var(--hc-surface-1);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition:
      background var(--motion-fast) ease,
      border-color var(--motion-fast) ease;
  }

  .edition-pager__link:hover:not(.is-disabled) {
    border-color: var(--hc-gold);
    background: var(--hc-surface-2);
  }

  .edition-pager__link.is-disabled {
    color: var(--hc-text-tertiary);
    border-color: transparent;
    background: transparent;
    pointer-events: none;
  }

  .edition-pager__counter {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-tertiary);
  }

  .edition-pager__counter strong {
    color: var(--hc-text-secondary);
  }

  @media (max-width: 780px) {
    .narration-record__spread {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .narration-record__col--ar {
      grid-column: 1;
      grid-row: 1;
    }
    .narration-record__col--en {
      grid-column: 1;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .narration-record,
    .edition-pager__link {
      transition: none;
    }
  }
</style>
