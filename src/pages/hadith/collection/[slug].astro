---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { CORPUS_META } from "../../../lib/corpus-config";
import { COMPILER_DATES } from "../../../lib/collection-catalogue";
import { compilerFor } from "../../../lib/hadith-compilers";
import { divisionNoun, kitabTitle, structureFor } from "../../../lib/collection-structure";
import { renderArabic, renderRich } from "../../../lib/format-text";
import "../../../styles/hadith-library.css";

/**
 * Digital source edition for a single hadith compilation.
 *
 * The shell is prerendered, one page per collection, from the generated corpus
 * metadata: there are thirty-three of them and their titles and extents are
 * fixed for a corpus version, so a crawler and a reader with JavaScript off
 * both get the real thing. It lists the collection's books; the narrations are
 * read from the static corpus on each book page (src/lib/kitab-page.ts).
 */
export function getStaticPaths() {
  return CORPUS_META.collections.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { slug } = Astro.params;
const { book } = Astro.props;
const compiler = compilerFor(slug);
const year = COMPILER_DATES[slug];
const total = book.hadith_count;
// Its books, from the Ifta' Sunnah table of contents, where the collection has them.
const structure = structureFor(slug);
const noun = structure ? divisionNoun(structure.shape) : null;
const isFlat = structure?.shape === "flat";
const chapterCount = structure?.kitabs.reduce((sum, kitab) => sum + kitab.chapters.length, 0) ?? 0;
const divisions = structure && !isFlat ? structure.kitabs.length : 0;
const largest = Math.max(1, ...(structure?.kitabs.map((kitab) => kitab.count) ?? [1]));
const plural = (n: number, one: string, many = `${one}s`) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
const pad = (n: number) => String(n).padStart(2, "0");
const kitabUrl = (n: number) => `/hadith/collection/${slug}/kitab/${n}/`;
---

<BaseLayout
  title={book.title_en + ' · Source Edition | HadithCritic'}
  description={'Explore all ' + total.toLocaleString() + ' narrations of ' + book.title_en + ' in bilingual facing critical format with complete transmission apparatus.'}
  image={OG.collection(slug)}
  imageAlt={book.title_en + ' | HadithCritic'}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Corpus', url: '/hadith/' },
    { name: book.title_en, url: '/hadith/collection/' + slug + '/' },
  ]}
>
  <div class="hl hl-collection" data-region={compiler?.region}>
    <section class="hl-khero" aria-labelledby="collection-title">
      <img class="hl-khero__art" src="/images/hadith/library-room.webp" width="1200" height="675" alt="" fetchpriority="high" />
      <div class="hl-wrap hl-khero__inner">
        <div class="hl-khero__copy">
          <a class="hl-back" href="/hadith/"><span aria-hidden="true">←</span> Hadith library</a>
          <p class="hl-eyebrow hl-khero__eyebrow">{compiler ? `${compiler.name} · d. ${year} AH · ${compiler.origin}` : `Compiler d. ${year} AH`}</p>
          <h1 class="hl-khero__title edition-title" id="collection-title">{book.title_en}</h1>
          {book.title_ar && <p class="hl-khero__ar" lang="ar" dir="rtl">{book.title_ar}</p>}
          <p class="hl-khero__lede">
            {book.title_en} in Arabic and English: {total.toLocaleString()} narrations
            {divisions > 0 && <> across {plural(divisions, noun!.one.toLowerCase(), noun!.many.toLowerCase())}</>}.
            {' '}Open a {isFlat ? 'chapter' : noun?.one.toLowerCase() ?? 'book'} to read its narrations in the order of the printed edition.
          </p>
          <dl class="hl-khero__meta" aria-label="Collection at a glance">
            <div class="edition-stat-entry"><dt>narrations</dt><dd>{total.toLocaleString()}</dd></div>
            {divisions > 0 && <div class="edition-stat-entry"><dt>{noun!.many.toLowerCase()}</dt><dd>{divisions.toLocaleString()}</dd></div>}
            {chapterCount > 0 && <div class="edition-stat-entry"><dt>chapters</dt><dd>{chapterCount.toLocaleString()}</dd></div>}
            <div class="edition-stat-entry"><dt>Collection ID</dt><dd>{book.id}</dd></div>
          </dl>
          <div class="hl-khero__actions">
            {structure && <a class="hl-browse" href="#books">Browse the {isFlat ? 'chapters' : noun!.many.toLowerCase()} <span aria-hidden="true">↓</span></a>}
            <form class="hl-khero__search" method="get" action="/hadith/">
              <input type="hidden" name="book" value={book.id} />
              <label class="sr-only" for="edition-q">Search within {book.title_en}</label>
              <div class="hl-search__bar">
                <span class="hl-search__icon" aria-hidden="true">⌕</span>
                <input id="edition-q" type="search" name="q" placeholder={`Search ${book.title_en}`} autocomplete="off" />
                <button type="submit">Search</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <div class="hl-wrap">
      {structure && noun && isFlat && (
        <section class="hl-index" id="books" aria-labelledby="edition-books-title">
          <div class="hl-index__head">
            <div><p class="hl-eyebrow">One preserved sequence</p><h2 id="edition-books-title">Chapters</h2></div>
            <p>{plural(chapterCount, 'chapter')} · {total.toLocaleString()} narrations</p>
          </div>
          <ol class="hl-books edition-books__list">
            <li>
              <a class="hl-book" href={kitabUrl(1)}>
                <span class="hl-book__top"><span class="hl-book__n">01</span><span class="hl-book__tag">No books above its chapters</span></span>
                <span class="hl-book__copy"><span class="hl-book__en">All {chapterCount.toLocaleString()} chapters</span><span class="hl-book__ar" lang="ar" dir="rtl">{book.title_ar}</span></span>
                <span class="hl-book__stub"><small>{plural(total, 'narration')}</small><span class="hl-book__arrow" aria-hidden="true">→</span></span>
              </a>
            </li>
          </ol>
        </section>
      )}

      {structure && noun && !isFlat && (
        <section class="hl-index edition-books" id="books" data-collection-browser data-divisions={noun.many.toLowerCase()} data-view="grid" aria-labelledby="edition-books-title">
          <div class="hl-index__head">
            <div>
              <p class="hl-eyebrow">One preserved sequence · {plural(divisions, noun.one.toLowerCase(), noun.many.toLowerCase())}</p>
              <h2 id="edition-books-title">{noun.many}</h2>
            </div>
            <p>{plural(divisions, noun.one.toLowerCase(), noun.many.toLowerCase())} · {plural(chapterCount, 'chapter')} · {total.toLocaleString()} narrations</p>
          </div>

          <div class="hl-toolbar" role="search" aria-label={`Find a ${noun.one.toLowerCase()}`} data-book-controls hidden>
            <label class="hl-search__bar" for="book-query">
              <span class="hl-search__icon" aria-hidden="true">⌕</span>
              <span class="sr-only">Find a {noun.one.toLowerCase()} by title</span>
              <input id="book-query" type="search" data-book-query placeholder={`Find a ${noun.one.toLowerCase()} by English or Arabic title`} autocomplete="off" />
            </label>
            <label class="hl-inline" for="book-sort"><span>Sort</span>
              <select id="book-sort" data-book-sort>
                <option value="order">{noun.one} order</option>
                <option value="extent">Most narrations</option>
                <option value="title">Title A–Z</option>
              </select>
            </label>
            <div class="hl-toggle" role="group" aria-label={`${noun.one} display`}>
              <button type="button" data-book-view="grid" aria-pressed="true">Grid</button>
              <button type="button" data-book-view="list" aria-pressed="false">List</button>
            </div>
            <span class="hl-count" data-book-status aria-live="polite">{divisions} of {divisions} {noun.many.toLowerCase()}</span>
          </div>

          <div class="hl-dist">
            <div class="hl-dist__head">
              <h3>Narrations by {noun.one.toLowerCase()}</h3>
              <span>In {noun.one.toLowerCase()} order · tallest {largest.toLocaleString()}</span>
            </div>
            <div class="hl-dist__bars" role="img" aria-label={`Narrations in each ${noun.one.toLowerCase()}, in ${noun.one.toLowerCase()} order`}>
              {structure.kitabs.map((kitab) => (
                <span data-bar={kitab.n} style={`--bar:${Math.max(4, Math.round((kitab.count / largest) * 100))}%`} title={`${pad(kitab.n)} · ${kitab.title_en || kitab.title_ar} · ${kitab.count.toLocaleString()} narrations`}></span>
              ))}
            </div>
          </div>

          <div class="hl-chips" role="group" aria-label="Filter by number of narrations" data-book-controls hidden>
            <span class="hl-chips__label">Narrations</span>
            <button type="button" class="hl-filter" data-book-length="all" aria-pressed="true">Any</button>
            <button type="button" class="hl-filter" data-book-length="short" aria-pressed="false">Under 100</button>
            <button type="button" class="hl-filter" data-book-length="medium" aria-pressed="false">100–499</button>
            <button type="button" class="hl-filter" data-book-length="long" aria-pressed="false">500+</button>
          </div>

          <ol class="hl-books edition-books__list" id="edition-book-list">
            {structure.kitabs.map((kitab) => (
              <li data-book-card data-number={kitab.n} data-count={kitab.count} data-title={kitabTitle(structure, kitab) + ' ' + kitab.title_ar}>
                <a class="hl-book edition-book" id={`book-${kitab.n}`} href={kitabUrl(kitab.n)}>
                  <span class="hl-book__top">
                    <span class="hl-book__n">{pad(kitab.n)}</span>
                    <span class="hl-book__tag">{plural(kitab.chapters.length, 'chapter')}</span>
                  </span>
                  <span class="hl-book__copy">
                    <span class="hl-book__en" set:html={renderRich(kitabTitle(structure, kitab))} />
                    <span class="hl-book__ar" lang="ar" dir="rtl" set:html={renderArabic(kitab.title_ar)} />
                  </span>
                  <span class="hl-book__stub">
                    <small>{plural(kitab.count, 'narration')}</small>
                    <span class="hl-book__arrow" aria-hidden="true">→</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
          <p class="hl-empty" data-book-empty hidden>No {noun.many.toLowerCase()} match. Try another title or clear the filters.</p>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { initCollectionBrowser } from '../../../lib/collection-browser';
  initCollectionBrowser();
</script>
