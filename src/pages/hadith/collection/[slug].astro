---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { toPlainText, renderArabic } from '../../../lib/format-text';

/**
 * Collection edition / sequential reader.
 *
 * This page deliberately behaves like the middle layer of the corpus:
 * /hadith is the catalogue, this route is the source sequence, and /hadith/:id
 * is the critical record. The query semantics and source ordering of the
 * existing implementation are retained; the presentation is rebuilt around
 * edition identity, reading position, chapter divisions, and report records.
 */

const { slug } = Astro.params;
const p = Astro.url.searchParams;
const page = Math.max(1, parseInt(p.get('page') || '1', 10) || 1);
const size = 25;
const offset = (page - 1) * size;

const PREVIEW_AR = 330;
const PREVIEW_EN = 300;

interface Book {
  id: number;
  slug: string;
  title_en: string;
  title_ar: string;
  hadith_count: number;
}

interface Row {
  id: number;
  hadith_num: string;
  chapter_en: string;
  chapter_ar: string;
  matn_en: string | null;
  text_en: string;
  matn_ar: string | null;
  text_ar: string;
  narrator_count: number;
  parallel_count: number;
}

interface ChapterMark {
  id: number;
  chapter_en: string;
  chapter_ar: string;
  pos: number;
}

let book: Book | undefined;
let rows: Row[] = [];
let previousChapter = '';
let failed = false;

try {
  const found = await env.DB.prepare(
    'SELECT id, slug, title_en, title_ar, hadith_count FROM hadith_book WHERE slug = ?'
  )
    .bind(slug)
    .first<Book>();

  book = found ?? undefined;

  if (book) {
    const rowQuery = env.DB.prepare(
      `SELECT id, hadith_num, chapter_en, chapter_ar, matn_en, text_en,
              matn_ar, text_ar, narrator_count, parallel_count
         FROM hadith WHERE book_id = ? ORDER BY id LIMIT ? OFFSET ?`
    ).bind(book.id, size, offset);

    if (offset > 0) {
      const previousQuery = env.DB.prepare(
        `SELECT chapter_en FROM hadith
          WHERE book_id = ? AND id < (
            SELECT id FROM hadith WHERE book_id = ? ORDER BY id LIMIT 1 OFFSET ?
          )
          ORDER BY id DESC LIMIT 1`
      ).bind(book.id, book.id, offset);

      const [rowRes, previousRes] = await env.DB.batch([rowQuery, previousQuery]);
      rows = (rowRes.results || []) as unknown as Row[];
      previousChapter = toPlainText((previousRes.results?.[0] as { chapter_en?: string } | undefined)?.chapter_en || '');
    } else {
      const res = await rowQuery.all();
      rows = (res.results || []) as unknown as Row[];
    }
  }
} catch (error) {
  console.error('Collection page failed to load', error);
  failed = true;
}

if (!book && !failed) {
  return new Response('Collection not found', { status: 404 });
}

const total = book?.hadith_count ?? 0;
const pages = Math.max(1, Math.ceil(total / size));
const resultStart = total > 0 ? offset + 1 : 0;
const resultEnd = total > 0 ? Math.min(offset + rows.length, total) : 0;
const progress = total > 0 ? Math.min(100, (resultEnd / total) * 100) : 0;

const pageUrl = (n: number) => {
  const u = new URLSearchParams();
  u.set('page', String(n));
  return `/hadith/collection/${slug}?${u}`;
};

// Chapter table of contents. This is a nice-to-have on top of the reading
// stream, not the content itself, so a failure here degrades to "no TOC"
// rather than the 404/503 the book/rows fetch above would produce — a
// reader can still read the collection with Previous/Next even if this
// query never runs.
//
// One window-function pass over (id, chapter_en) returns only the rows
// where the chapter changes, tagged with their zero-based position in the
// book's id order. That position is what turns a bāb into a page number:
// pos 0 is always page 1, and the query never has to touch the running
// text of the report, only the chapter label and the id ordering.
let chapterMarks: ChapterMark[] = [];
if (book) {
  try {
    const res = await env.DB.prepare(
      `SELECT id, chapter_en, chapter_ar, pos FROM (
         SELECT id, chapter_en, chapter_ar,
                ROW_NUMBER() OVER (ORDER BY id) - 1 AS pos,
                LAG(chapter_en, 1, '') OVER (ORDER BY id) AS prev_chapter_en
           FROM hadith WHERE book_id = ?
       )
       WHERE TRIM(COALESCE(chapter_en, '')) != ''
         AND TRIM(COALESCE(chapter_en, '')) != TRIM(COALESCE(prev_chapter_en, ''))
       ORDER BY pos`
    )
      .bind(book.id)
      .all<ChapterMark>();
    chapterMarks = (res.results || []) as unknown as ChapterMark[];
  } catch (error) {
    console.error(`Chapter TOC failed to load for book ${book.id}`, error);
  }
}

// Each mark becomes a TOC row carrying the page it starts on and the page
// range it spans, so "is this the chapter I'm currently reading" can be
// answered without a second query.
const chapters = chapterMarks.map((c, i) => {
  const startPage = Math.floor(c.pos / size) + 1;
  const nextPos = chapterMarks[i + 1]?.pos ?? total;
  const endPage = Math.max(startPage, Math.ceil(nextPos / size));
  return {
    id: c.id,
    en: toPlainText(c.chapter_en),
    ar: (c.chapter_ar || '').trim(),
    startPage,
    isCurrent: page >= startPage && page <= endPage
  };
});

const preview = (text: string, limit: number) => {
  const clean = (text || '').trim();
  if (!clean || clean.length <= limit) return { text: clean, cut: false };
  const space = clean.lastIndexOf(' ', limit);
  return { text: clean.slice(0, space > limit * 0.6 ? space : limit), cut: true };
};

let lastChapter = '';
const withHeadings = rows.map((r, i) => {
  const chapter = toPlainText(r.chapter_en) || '';
  const isNew = chapter !== '' && chapter !== lastChapter;
  const isContinuation = i === 0 && page > 1 && chapter !== '' && chapter === previousChapter;
  if (isNew) lastChapter = chapter;

  return {
    row: r,
    heading: isNew
      ? {
          en: chapter,
          ar: (r.chapter_ar || '').trim(),
          continuation: isContinuation
        }
      : null
  };
});
---

<BaseLayout
  title={book ? `${book.title_en} | HadithCritic` : 'Collection | HadithCritic'}
  description={book
    ? `Browse all ${book.hadith_count.toLocaleString()} narrations of ${book.title_en} in Arabic and English, in sequence, with no authenticity gradings.`
    : 'Hadith collection'}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Hadith', url: '/hadith' },
    { name: book?.title_en || 'Collection', url: `/hadith/collection/${slug}` }
  ]}
>
  <div class="edition-page">
    {failed || !book ? (
      <div class="edition-error wrap">
        <p class="hc-eyebrow">Hadith · Collection</p>
        <h1>This collection is temporarily unavailable.</h1>
        <p>Please try again shortly.</p>
      </div>
    ) : (
      <>
        <header class="edition-head">
          <div class="wrap edition-head__grid">
            <div class="edition-head__main">
              <p class="hc-eyebrow"><a href="/hadith">Corpus</a> / Collection</p>
              <div class="edition-titleblock">
                <h1 class="edition-title">{book.title_en}</h1>
                {book.title_ar && (
                  <p class="edition-title-ar" lang="ar" dir="rtl">{book.title_ar}</p>
                )}
              </div>
              <p class="edition-description">
                {book.hadith_count.toLocaleString()} narrations in source sequence. Read the reports as they occur in the collection, with Arabic and English side by side.
              </p>
            </div>

            <aside class="edition-head__aside" aria-label="Collection navigation">
              <p class="edition-aside__label">Edition position</p>
              <p class="edition-aside__range">
                {resultStart.toLocaleString()}–{resultEnd.toLocaleString()}{' '}
                <span>of {total.toLocaleString()}</span>
              </p>
              <div class="hc-progress edition-aside__track" aria-hidden="true">
                <span class="hc-progress__fill" style={`width:${progress}%`}></span>
              </div>
              <p class="edition-aside__note">Source order preserved. No authenticity grading is stored or inferred.</p>
              <a class="hc-back-link" href="/hadith"><span aria-hidden="true">←</span> Back to corpus</a>
            </aside>
          </div>

          <div class="wrap">
            <div class="hc-stat-band hc-stat-band--4" aria-label="Collection status">
              <div class="hc-stat">
                <span class="hc-stat__num">{total.toLocaleString()}</span>
                <span class="hc-stat__label">Narrations</span>
              </div>
              <div class="hc-stat">
                <span class="hc-stat__num">{page.toLocaleString()} / {pages.toLocaleString()}</span>
                <span class="hc-stat__label">Reading pages</span>
              </div>
              <div class="hc-stat">
                <span class="hc-stat__num">25</span>
                <span class="hc-stat__label">Reports per page</span>
              </div>
              <div class="hc-stat hc-stat--display hc-stat--quiet">
                <span class="hc-stat__num">Not stored</span>
                <span class="hc-stat__label">Authenticity grading</span>
              </div>
            </div>
          </div>
        </header>

        <div class="wrap edition-body">
          <section class="edition-tools" aria-labelledby="tools-heading">
            <div class="hc-section-head">
              <div class="hc-section-head__main">
                <h2 class="hc-section-head__title" id="tools-heading">Search this collection</h2>
              </div>
              <p class="hc-section-head__aside">Scoped to this collection via the corpus index</p>
            </div>

            <form method="get" action="/hadith">
              <input type="hidden" name="book" value={book.id} />
              <div class="hc-searchbar">
                <label class="sr-only" for="edition-q">Search within this collection</label>
                <input id="edition-q" class="hc-searchbar__input" type="search" name="q"
                       placeholder={`Search ${book.title_en}…`} autocomplete="off" spellcheck="false" />
                <button class="hc-searchbar__submit" type="submit">Search <span aria-hidden="true">→</span></button>
              </div>

              <div class="hc-searchbar__options">
                <label class="hc-searchbar__phrase">
                  <input type="checkbox" name="phrase" value="1" />
                  <span>Exact phrase</span>
                </label>
              </div>
            </form>

            <div class="edition-position" aria-label="Reading position">
              <div class="edition-position__topline">
                <span>Reports {resultStart.toLocaleString()}–{resultEnd.toLocaleString()} of {total.toLocaleString()}</span>

                <form class="edition-position__jump" method="get" action={`/hadith/collection/${slug}`}>
                  <label class="sr-only" for="edition-jump">Go to page</label>
                  <input
                    id="edition-jump"
                    class="edition-position__jump-input"
                    type="number"
                    name="page"
                    min="1"
                    max={pages}
                    value={page}
                    inputmode="numeric"
                  />
                  <span class="edition-position__jump-of">/ {pages.toLocaleString()}</span>
                  <button type="submit" class="edition-position__jump-btn">Go</button>
                </form>

                <span>{progress.toFixed(1)}%</span>
              </div>
              <div class="edition-position__track" aria-hidden="true">
                <span style={`width:${progress}%`}></span>
              </div>
            </div>
          </section>

          {chapters.length > 0 && (
            <section class="edition-toc" aria-labelledby="toc-heading">
              <details class="edition-toc__details" open={chapters.length <= 12}>
                <summary class="edition-toc__summary">
                  <span class="edition-toc__summary-text">
                    <span class="edition-toc__chevron" aria-hidden="true"></span>
                    <span id="toc-heading">Table of contents</span>
                  </span>
                  <span class="edition-toc__count">{chapters.length.toLocaleString()} {chapters.length === 1 ? 'chapter' : 'chapters'}</span>
                </summary>

                <ol class="edition-toc__list">
                  {chapters.map((c, i) => (
                    <li class={`edition-toc__item${c.isCurrent ? ' is-current' : ''}`}>
                      <a
                        class="edition-toc__link"
                        href={`${pageUrl(c.startPage)}#ch-${c.id}`}
                        aria-current={c.isCurrent ? 'location' : undefined}
                      >
                        <span class="edition-toc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                        <span class="edition-toc__text">
                          <span class="edition-toc__en">{c.en}</span>
                          {c.ar && <span class="edition-toc__ar" lang="ar" dir="rtl">{c.ar}</span>}
                        </span>
                        <span class="edition-toc__page">p. {c.startPage}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            </section>
          )}

          <section class="edition-reading" aria-labelledby="reading-heading">
            <div class="hc-section-head edition-reading__head">
              <div class="hc-section-head__main">
                <p class="hc-eyebrow">Source sequence</p>
                <h2 class="hc-section-head__title" id="reading-heading">Reading the collection</h2>
              </div>
              <div class="edition-reading__legend" aria-hidden="true">
                <span class="edition-reading__legend-col">English translation</span>
                <span class="edition-reading__legend-sep">·</span>
                <span class="edition-reading__legend-col">Arabic source</span>
              </div>
            </div>

            <div class="edition-ledger">
              {withHeadings.length === 0 ? (
                <div class="edition-empty">
                  <h3>No reports on this page.</h3>
                  <p>The requested position is outside the collection.</p>
                </div>
              ) : (
                withHeadings.map(({ row: r, heading }) => {
                  const ar = preview(r.matn_ar || r.text_ar, PREVIEW_AR);
                  const en = preview(toPlainText(r.matn_en || r.text_en), PREVIEW_EN);
                  return (
                    <>
                      {heading && (
                        <div
                          id={`ch-${r.id}`}
                          class={`edition-chapter${heading.continuation ? ' edition-chapter--continuation' : ''}`}
                        >
                          <div class="edition-chapter__rule" aria-hidden="true"></div>
                          <div class="edition-chapter__identity">
                            <p class="edition-chapter__kicker">
                              {heading.continuation ? 'Chapter continues' : 'Bāb'}
                            </p>
                            <h3 class="edition-chapter__en">{heading.en}</h3>
                            {heading.ar && (
                              <p class="edition-chapter__ar" lang="ar" dir="rtl">{heading.ar}</p>
                            )}
                          </div>
                          <div class="edition-chapter__rule edition-chapter__rule--after" aria-hidden="true"></div>
                        </div>
                      )}

                      <article class="edition-report">
                        <a class="edition-report__link" href={`/hadith/${r.id}`}>
                          <div class="edition-report__citation">
                            <span class="edition-report__num">{r.hadith_num ? `№ ${r.hadith_num}` : `ID ${r.id}`}</span>
                            <span class="edition-report__open">Open record <span aria-hidden="true">→</span></span>
                          </div>

                          <div class="edition-report__cols">
                            <div class="edition-report__col edition-report__col--en">
                              {en.text ? (
                                <p class="edition-report__en">{en.text}{en.cut ? ' …' : ''}</p>
                              ) : (
                                <p class="edition-report__missing">No translation recorded.</p>
                              )}
                            </div>

                            <div class="edition-report__col edition-report__col--ar">
                              <p class="edition-report__ar" lang="ar" dir="rtl">
                                <Fragment set:html={renderArabic(ar.text)} />{ar.cut ? ' …' : ''}
                              </p>
                            </div>
                          </div>

                          <p class="edition-report__meta">
                            <span>{r.narrator_count} transmitters</span>
                            {Number(r.parallel_count) > 0 && (
                              <>
                                <span aria-hidden="true">·</span>
                                <span>{Number(r.parallel_count).toLocaleString()} parallels</span>
                              </>
                            )}
                          </p>
                        </a>
                      </article>
                    </>
                  );
                })
              )}
            </div>
          </section>

          <nav class="edition-pager" aria-label="Collection pages">
            <div class="edition-pager__side">
              {page > 1
                ? <a class="edition-pager__link" href={pageUrl(page - 1)}>← Previous reports</a>
                : <span class="edition-pager__link edition-pager__link--disabled">← Previous reports</span>}
            </div>
            <div class="edition-pager__center">
              <span>{resultStart.toLocaleString()}–{resultEnd.toLocaleString()}</span>
              <span>/ {total.toLocaleString()}</span>
            </div>
            <div class="edition-pager__side edition-pager__side--next">
              {page < pages
                ? <a class="edition-pager__link" href={pageUrl(page + 1)}>Next reports →</a>
                : <span class="edition-pager__link edition-pager__link--disabled">Next reports →</span>}
            </div>
          </nav>
        </div>
      </>
    )}
  </div>
</BaseLayout>

<style>
  /* ================================================================
     COLLECTION EDITION — digital reading sequence / archival ledger
     ================================================================ */

  .edition-page {
    min-height: 100vh;
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background:
      radial-gradient(circle at 72% 0%, rgba(216, 177, 102, 0.065), transparent 32%),
      linear-gradient(180deg, var(--hc-surface-0) 0%, var(--hc-surface-0) 72%, var(--hc-surface-1) 100%);
  }

  .edition-error {
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .edition-error h1 {
    max-width: 18ch;
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .edition-error p:last-child {
    margin: 1.1rem 0 0;
    color: var(--hc-text-secondary);
    line-height: 1.7;
  }

  /* ---------- masthead ---------- */

  .edition-head {
    padding-top: clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--hc-rule);
  }

  .edition-head__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.55fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  /* The English and Arabic names are one masthead. Sizing the block to its
     content gives the Arabic the end of the English title as an anchor;
     without it the RTL block right-aligned to the grid column edge and read
     as an accident. */
  .edition-titleblock {
    width: fit-content;
    max-width: 100%;
  }

  .edition-title {
    max-width: 15ch;
    margin: 0.8rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.9rem, 6vw, 4.85rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--hc-text-primary);
    text-wrap: balance;
  }

  .edition-title-ar {
    margin: 0.5rem 0 0;
    font-family: var(--font-arabic);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    line-height: 1.8;
    color: var(--hc-gold);
  }

  .edition-description {
    max-width: 65ch;
    margin: 1.2rem 0 0;
    font-family: var(--font-body);
    font-size: 1.04rem;
    line-height: 1.76;
    color: var(--hc-text-secondary);
  }

  /* Ruled block, not a container. The old bordered card ran ~40% empty and
     was the only box on the page: DESIGN.md puts fine rules above large
     containers. */
  .edition-head__aside {
    padding-top: 0.9rem;
    border-top: 1px solid var(--hc-rule-strong);
  }

  .edition-aside__label {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .edition-aside__range {
    margin: 0.55rem 0 0;
    font-family: var(--font-body);
    font-size: clamp(1.6rem, 2.7vw, 2.15rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--hc-text-primary);
  }

  .edition-aside__range span {
    color: var(--hc-text-tertiary);
  }

  .edition-aside__track {
    margin-top: 0.75rem;
  }

  .edition-aside__note {
    max-width: 31ch;
    margin: 0.75rem 0 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--hc-text-secondary);
  }

  /* ---------- tools ---------- */

  .edition-body { padding-top: clamp(2.5rem, 5vw, 4rem); }

  .edition-tools {
    padding-bottom: clamp(2rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid var(--hc-rule);
  }

  .edition-position {
    margin-top: 1.2rem;
  }

  .edition-position__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--hc-text-tertiary);
  }

  /* Quick jump, for collections long enough that Previous/Next alone would
     take hundreds of clicks to cross. Sits inline in the position row
     rather than as its own control, since it answers the same question
     ("where am I / where do I want to be") as the text either side of it. */
  .edition-position__jump {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
  }

  .edition-position__jump-input {
    width: 3.6rem;
    min-height: 30px;
    padding: 0 0.4rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 2px);
    background: transparent;
    color: var(--hc-text-primary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
    transition: border-color 160ms ease;
    /* Hide native number-input spinners; the field is small and the Go
       button is the intended way to submit, not the stepper arrows. */
    -moz-appearance: textfield;
  }

  .edition-position__jump-input::-webkit-outer-spin-button,
  .edition-position__jump-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .edition-position__jump-input:focus-visible {
    border-color: var(--hc-gold);
  }

  .edition-position__jump-of {
    color: var(--hc-text-tertiary);
  }

  .edition-position__jump-btn {
    min-height: 30px;
    padding: 0 0.6rem;
    border: 1px solid var(--hc-rule-strong);
    border-radius: var(--radius-xs, 2px);
    background: transparent;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .edition-position__jump-btn:hover {
    color: var(--hc-gold-bright);
    border-color: var(--hc-gold);
  }

  .edition-position__track {
    height: 3px;
    margin-top: 0.55rem;
    background: var(--hc-rule-soft);
    overflow: hidden;
  }

  .edition-position__track span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--hc-gold-dim), var(--hc-gold));
    transition: width 300ms var(--ease-standard);
  }

  /* ---------- table of contents ---------- */
  /* A native <details> disclosure rather than a JS-driven dropdown: the
