---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/qiraat-al-nabi-al-duri/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("qiraat-al-nabi-al-duri", "Qirāʾāt al-Nabī of al-Dūrī");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("qiraat-al-nabi-al-duri")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/qiraat-al-nabi-al-duri/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
