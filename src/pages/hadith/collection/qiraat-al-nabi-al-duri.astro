---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/qiraat-al-nabi-al-duri/collection.html?raw";
import chapters from "../../../data/hadith/pages/qiraat-al-nabi-al-duri/chapter-index.json";
import PaintedCollection from "../../../components/hadith/PaintedCollection.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("qiraat-al-nabi-al-duri", "Qirāʾāt al-Nabī of al-Dūrī");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("qiraat-al-nabi-al-duri")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/qiraat-al-nabi-al-duri/" },
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hadith/covers/qiraat-al-nabi-al-duri.webp" fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <PaintedCollection slug="qiraat-al-nabi-al-duri" front={parseCollectionHtml("qiraat-al-nabi-al-duri", collectionHtml)} chapters={chapters} />
</BaseLayout>
