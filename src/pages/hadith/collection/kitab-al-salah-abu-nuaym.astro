---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/kitab-al-salah-abu-nuaym/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("kitab-al-salah-abu-nuaym", "Kitāb al-Ṣalāh of Abū Nuʿaym al-Faḍl ibn Dukayn");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("kitab-al-salah-abu-nuaym")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/kitab-al-salah-abu-nuaym/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
