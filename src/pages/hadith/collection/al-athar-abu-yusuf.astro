---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/al-athar-abu-yusuf/collection.html?raw";
import chapters from "../../../data/hadith/pages/al-athar-abu-yusuf/chapter-index.json";
import PaintedFront from "../../../components/hadith/PaintedFront.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("al-athar-abu-yusuf", "Kitāb al-Āthār of Abū Yūsuf");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("al-athar-abu-yusuf")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/al-athar-abu-yusuf/" },
  ]}
>
  <PaintedFront
    slug="al-athar-abu-yusuf"
    front={parseCollectionHtml("al-athar-abu-yusuf", collectionHtml)}
    chapters={chapters}
    heroAlt="An illustrative scene for Abū Yūsuf’s legal reports."
    placeAr="الكوفة"
    groups={[]}
    itemSingular="chapter"
    itemPlural="chapters"
    arrangement="39 chapters in source order"
    span="Chapters 1–39"
  />
</BaseLayout>
