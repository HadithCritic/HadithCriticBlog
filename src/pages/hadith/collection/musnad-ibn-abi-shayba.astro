---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/musnad-ibn-abi-shayba/collection.html?raw";
import CollectionFront from "../../../components/hadith/CollectionFront.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("musnad-ibn-abi-shayba", "Musnad Ibn Abī Shayba");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("musnad-ibn-abi-shayba")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/musnad-ibn-abi-shayba/" },
  ]}
>
  <CollectionFront slug="musnad-ibn-abi-shayba" front={parseCollectionHtml("musnad-ibn-abi-shayba", collectionHtml)} />
</BaseLayout>
