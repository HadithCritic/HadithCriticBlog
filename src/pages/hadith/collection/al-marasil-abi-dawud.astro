---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/al-marasil-abi-dawud/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("al-marasil-abi-dawud", "Al-Marāsīl of Abū Dāwūd");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("al-marasil-abi-dawud")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/al-marasil-abi-dawud/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
