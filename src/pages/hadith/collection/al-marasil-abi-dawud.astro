---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/al-marasil-abi-dawud/collection.html?raw";
import chapters from "../../../data/hadith/pages/al-marasil-abi-dawud/chapter-index.json";
import PaintedCollection from "../../../components/hadith/PaintedCollection.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("al-marasil-abi-dawud", "Al-Marāsīl of Abū Dāwūd");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("al-marasil-abi-dawud")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/al-marasil-abi-dawud/" },
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hadith/covers/al-marasil-abi-dawud.webp" fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <PaintedCollection slug="al-marasil-abi-dawud" front={parseCollectionHtml("al-marasil-abi-dawud", collectionHtml)} chapters={chapters} />
</BaseLayout>
