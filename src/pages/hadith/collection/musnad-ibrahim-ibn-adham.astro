---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/musnad-ibrahim-ibn-adham/collection.html?raw";
import chapters from "../../../data/hadith/pages/musnad-ibrahim-ibn-adham/chapter-index.json";
import PaintedFront from "../../../components/hadith/PaintedFront.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";
import { MUSNAD_IBRAHIM_REGIONS } from "../../../data/hadith/musnad-ibrahim-chapter-groups";

const { title, description } = collectionFrontMatter("musnad-ibrahim-ibn-adham", "Musnad Ibrāhīm ibn Adham");
const heroSrc = "/images/hadith/covers/musnad-ibrahim-ibn-adham.webp";
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("musnad-ibrahim-ibn-adham")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/musnad-ibrahim-ibn-adham/" },
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroSrc} fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <PaintedFront
    slug="musnad-ibrahim-ibn-adham"
    front={parseCollectionHtml("musnad-ibrahim-ibn-adham", collectionHtml)}
    chapters={chapters}
    heroSrc={heroSrc}
    heroSmall={heroSrc}
    heroAlt="An open manuscript and writing desk beneath a tiled arch, overlooking a garden and the mountains of Balkh at dawn."
    placeAr="أصفهان"
    viaAr="جمع حديث إبراهيم بن أدهم"
    groups={MUSNAD_IBRAHIM_REGIONS}
    itemSingular="section"
    itemPlural="sections"
    arrangement="23 sections arranged by teacher"
  />
</BaseLayout>
