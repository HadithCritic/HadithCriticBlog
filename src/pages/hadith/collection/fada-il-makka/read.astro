---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import readerDocument from '../../../../data/hadith-pages/fada-il-makka/reader.html?raw';

const title = 'Faḍāʾil Makka';
const description = 'Read Faḍāʾil Makka in English and Arabic, organized around the letter, Qurʾānic passages, and reports concerning the Sacred Precinct.';
const styleMatch = readerDocument.match(/<style\b[^>]*>([\s\S]*?)<\/style>/i);
const bodyMatch = readerDocument.match(/<body\b[^>]*>([\s\S]*?)<\/body>/i);
if (!styleMatch || !bodyMatch) throw new Error('Faḍāʾil Makka reader source must include a style block and body.');
const readerContent = bodyMatch[1]
  .replace('<main class="reader" id="reading">', '<div class="reader" id="reading">')
  .replace('</main>', '</div>');
---
<BaseLayout title={`${title} · Reader | HadithCritic`} description={description} crumbs={[{name:'Home',url:'/'},{name:'Hadith corpus',url:'/hadith/'},{name:title,url:'/hadith/collection/fada-il-makka/'},{name:'Read',url:'/hadith/collection/fada-il-makka/read/'}]}>
  <Fragment slot="head" set:html={`<style>${styleMatch[1]}</style>`} />
  <Fragment set:html={readerContent} />
</BaseLayout>
