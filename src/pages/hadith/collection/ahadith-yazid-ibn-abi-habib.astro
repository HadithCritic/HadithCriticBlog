---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/ahadith-yazid-ibn-abi-habib/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("ahadith-yazid-ibn-abi-habib", "Ḥadīths of Yazīd ibn Abī Ḥabīb");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("ahadith-yazid-ibn-abi-habib")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/ahadith-yazid-ibn-abi-habib/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
