---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/nuskhat-ibrahim-ibn-sad/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("nuskhat-ibrahim-ibn-sad", "Copy of Ibrāhīm ibn Saʿd");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("nuskhat-ibrahim-ibn-sad")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/nuskhat-ibrahim-ibn-sad/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
