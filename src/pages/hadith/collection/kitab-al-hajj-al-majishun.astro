---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/kitab-al-hajj-al-majishun/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("kitab-al-hajj-al-majishun", "Book of Pilgrimage of al-Mājishūn");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("kitab-al-hajj-al-majishun")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/kitab-al-hajj-al-majishun/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
