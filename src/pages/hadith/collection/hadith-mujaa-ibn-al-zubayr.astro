---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/hadith-mujaa-ibn-al-zubayr/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("hadith-mujaa-ibn-al-zubayr", "Ḥadīth of Mujāʿa ibn al-Zubayr");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("hadith-mujaa-ibn-al-zubayr")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/hadith-mujaa-ibn-al-zubayr/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
