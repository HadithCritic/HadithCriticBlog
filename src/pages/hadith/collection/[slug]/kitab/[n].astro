---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { OG } from "../../../../../lib/seo";
import { CORPUS_META } from "../../../../../lib/corpus-config";
import { STRUCTURES, divisionNoun, kitabTitle } from "../../../../../lib/collection-structure";
import { compilerFor } from "../../../../../lib/hadith-compilers";
import { renderArabic, renderRich, toPlainText } from "../../../../../lib/format-text";
import "../../../../../styles/hadith-library.css";
import "../../../../../styles/hadith-reader.css";

/**
 * One book of a collection: Collection, then Book, then its chapters, then
 * the narrations. Prerendered for every book of every collection from the
 * structure files (src/data/collection-structure), so the book list, the
 * chapter list and every fallback link work with JavaScript off. A chapter
 * is a native disclosure; src/lib/kitab-page.ts reads its narrations from
 * the static corpus when it is opened, 25 at a time.
 */
export function getStaticPaths() {
  return STRUCTURES.flatMap((structure) => {
    const book = CORPUS_META.collections.find((item) => item.slug === structure.slug);
    if (!book) return [];
    return structure.kitabs.map((kitab) => ({
      params: { slug: structure.slug, n: String(kitab.n) },
      props: { structure, kitab, book },
    }));
  });
}

const { structure, kitab, book } = Astro.props;
const { slug } = structure;
const noun = divisionNoun(structure.shape);
const title = kitabTitle(structure, kitab);
const collectionUrl = `/hadith/collection/${slug}/`;
const kitabUrl = (n: number) => `${collectionUrl}kitab/${n}/`;
const index = structure.kitabs.findIndex((item) => item.n === kitab.n);
const previous = structure.kitabs[index - 1];
const next = structure.kitabs[index + 1];
const isFlat = structure.shape === "flat";
const heading = isFlat ? `${book.title_en}: chapters` : `${toPlainText(title)} · ${book.title_en}`;
const position = isFlat ? "" : `${noun.one} ${kitab.n} of ${structure.kitabs.length}`;
const pad = (n: number, width = 3) => String(n).padStart(width, "0");
const plural = (n: number, one: string) => `${n.toLocaleString()} ${n === 1 ? one : `${one}s`}`;
const compiler = compilerFor(slug);
---

<BaseLayout
  title={`${heading} | HadithCritic`}
  description={`${isFlat ? `The ${kitab.chapters.length.toLocaleString()} chapters of ${book.title_en}` : `${toPlainText(title)}, ${position.toLowerCase()} in ${book.title_en}`}: ${kitab.count.toLocaleString()} narrations in the order of the printed edition, English with the Arabic beside it.`}
  image={OG.collection(slug)}
  imageAlt={`${book.title_en} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: book.title_en, url: collectionUrl },
    { name: isFlat ? "Chapters" : toPlainText(title), url: kitabUrl(kitab.n) },
  ]}
>
  <div class="hl hr-reader kb" data-book-id={book.id} data-region={compiler?.region}>
    <div class="hl-wrap">
      <nav class="hr-trail" aria-label="Breadcrumb">
        <a href={`${collectionUrl}#book-${kitab.n}`} class="hr-trail__back">← {isFlat ? book.title_en : `${noun.one} index`}</a>
        <span aria-hidden="true">/</span>
        <a href="/hadith/">Hadith library</a>
        <span aria-hidden="true">/</span>
        {!isFlat && <><a href={collectionUrl}>{book.title_en}</a><span aria-hidden="true">/</span></>}
        <span aria-current="page">{isFlat ? "Chapters" : `${noun.one} ${pad(kitab.n)}`}</span>
      </nav>

      <header class="hr-rhead">
        <p class="hr-rhead__overline">
          <span>{book.title_en}</span>
          {position && <><i aria-hidden="true">·</i><span>{noun.one} {pad(kitab.n)} of {structure.kitabs.length}</span></>}
        </p>
        <div class="hr-rhead__row">
          <span class="hr-rhead__num" aria-hidden="true">{pad(kitab.n, 2)}</span>
          <div>
            <h1 class="hr-rhead__title" set:html={isFlat ? renderRich(book.title_en) : renderRich(title)} />
            <p class="hr-rhead__ar" lang="ar" dir="rtl" set:html={renderArabic(isFlat ? book.title_ar : kitab.title_ar)} />
          </div>
        </div>
        <p class="hr-rhead__facts">
          <span>{plural(kitab.count, "narration")}</span>
          <i aria-hidden="true">·</i>
          <span>{plural(kitab.chapters.length, "chapter")}</span>
          {kitab.companion && (
            <>
              <i aria-hidden="true">·</i>
              <span>Companion in the Rijāl register: <a href={`/narrators/${kitab.companion.narrator_id}/`}>{kitab.companion.name_en}</a></span>
            </>
          )}
        </p>
        {kitab.english_basis === "corpus" && <p class="hr-rhead__note">The English heading is the corpus’s own rendering.</p>}
      </header>

      {!isFlat && (previous || next) && (
        <nav class="hr-pager kb-pager" aria-label={`Previous and next ${noun.many.toLowerCase()}`}>
          {previous ? (
            <a class="hr-pager__link" href={kitabUrl(previous.n)} rel="prev">
              <small>← Previous {noun.one.toLowerCase()} · {pad(previous.n)}</small>
              <strong set:html={renderRich(kitabTitle(structure, previous))} />
            </a>
          ) : <span aria-hidden="true"></span>}
          {next ? (
            <a class="hr-pager__link hr-pager__link--next" href={kitabUrl(next.n)} rel="next">
              <small>Next {noun.one.toLowerCase()} · {pad(next.n)} →</small>
              <strong set:html={renderRich(kitabTitle(structure, next))} />
            </a>
          ) : <span aria-hidden="true"></span>}
        </nav>
      )}

      <section class="hr-reports" aria-labelledby="kb-chapters-title">
        <div class="hr-reports__head">
          <h2 id="kb-chapters-title">{isFlat ? "Chapters" : `Chapters in this ${noun.one.toLowerCase()}`}</h2>
          <span>{kitab.chapters.length.toLocaleString()} in preserved order</span>
          <button type="button" class="hr-expand kb-expand" data-expand-all hidden>Open all chapters</button>
        </div>
        <ol class="kb-chapter-list">
          {kitab.chapters.map((chapter) => (
            <li>
              <details class="kb-chapter" id={`chapter-${chapter.n}`} data-first={chapter.first} data-last={chapter.last} data-count={chapter.count}>
                <summary class="kb-chapter__row">
                  <span class="kb-chapter__n">{chapter.n}</span>
                  <span class="kb-chapter__en" set:html={renderRich(chapter.title_en || "")} />
                  <span class="kb-chapter__ar" lang="ar" dir="rtl" set:html={renderArabic(chapter.title_ar)} />
                  <span class="kb-chapter__count">{plural(chapter.count, "narration")}</span>
                </summary>
                <div class="kb-chapter__body" data-records>
                  <p class="kb-chapter__fallback"><a href={`/hadith/${chapter.first}/`}>Open the first narration in this chapter</a></p>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </section>

      {!isFlat && (previous || next) && (
        <nav class="hr-pager hr-pager--bottom" aria-label={`Previous and next ${noun.many.toLowerCase()}, end of page`}>
          {previous ? (
            <a class="hr-pager__link" href={kitabUrl(previous.n)} rel="prev">
              <small>← Previous {noun.one.toLowerCase()} · {pad(previous.n)}</small>
              <strong set:html={renderRich(kitabTitle(structure, previous))} />
            </a>
          ) : <span aria-hidden="true"></span>}
          {next ? (
            <a class="hr-pager__link hr-pager__link--next" href={kitabUrl(next.n)} rel="next">
              <small>Next {noun.one.toLowerCase()} · {pad(next.n)} →</small>
              <strong set:html={renderRich(kitabTitle(structure, next))} />
            </a>
          ) : <span aria-hidden="true"></span>}
        </nav>
      )}

      {!isFlat && (
        <nav class="hr-booknav kb-nav" aria-labelledby="kb-nav-title">
          <div class="hr-reports__head">
            <h2 id="kb-nav-title">All {noun.many.toLowerCase()} in {book.title_en}</h2>
            <span>{structure.kitabs.length.toLocaleString()} in the edition</span>
          </div>
          <ol class="hr-booknav__list">
            {structure.kitabs.map((item) => (
              <li>
                <a href={kitabUrl(item.n)} aria-current={item.n === kitab.n ? "page" : undefined}>
                  <span class="hr-booknav__n">{pad(item.n, 2)}</span>
                  <span class="hr-booknav__en" set:html={renderRich(kitabTitle(structure, item))} />
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { initKitabPage } from "../../../../../lib/kitab-page";
  initKitabPage();
</script>
