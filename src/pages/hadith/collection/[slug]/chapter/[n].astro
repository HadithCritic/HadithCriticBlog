---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { OG } from "../../../../../lib/seo";

export function getStaticPaths() {
  const editions = [
    { slug: "musnad-sad-ibn-abi-waqqas", title: "Musnad Saʿd ibn Abī Waqqāṣ", noun: "Chapter" },
    { slug: "birr-al-walidayn", title: "Birr al-Wālidayn of al-Bukhārī", noun: "Chapter" },
    { slug: "musnad-khalifa-ibn-khayyat", title: "Musnad Khalīfa ibn Khayyāṭ", noun: "Section" },
    { slug: "musnad-abu-hanifa", title: "Musnad Abū Ḥanīfa", noun: "Book" },
    { slug: "musnad-abd-allah-ibn-al-mubarak", title: "Musnad ʿAbd Allāh ibn al-Mubārak", noun: "Chapter" },
    { slug: "jami-mamar-ibn-rashid", title: "Jāmiʿ Maʿmar ibn Rāshid", noun: "Chapter" },
    { slug: "al-marasil-abi-dawud", title: "Al-Marāsīl of Abū Dāwūd", noun: "Chapter" },
    { slug: "al-jami-ibn-wahb", title: "Al-Jāmiʿ fī al-Ḥadīth of Ibn Wahb", noun: "Chapter" },
    { slug: "al-muntaqa-ibn-al-jarud", title: "Al-Muntaqā min al-Sunan al-Musnada", noun: "Chapter" },
    { slug: "al-athar-abu-yusuf", title: "Kitāb al-Āthār of Abū Yūsuf", noun: "Chapter" },
    { slug: "al-athar-al-shaybani", title: "Kitāb al-Āthār of al-Shaybānī", noun: "Chapter" },
    { slug: "hadith-sufyan-al-thawri", title: "Ḥadīth Sufyān al-Thawrī (printed edition)", noun: "Section" },
    { slug: "ahadith-al-sari-an-al-thawri", title: "Aḥādīth al-Sarī ibn Yaḥyā through al-Thawrī (manuscript text)", noun: "Section" },
    { slug: "muwatta-ibn-wahb-muharaba", title: "Muwaṭṭaʾ Ibn Wahb: Book of Armed Robbery", noun: "Chapter" },
    { slug: "muwatta-ibn-wahb-qada-buyu", title: "Muwaṭṭaʾ Ibn Wahb: Judicial Decisions on Sales", noun: "Chapter" },
    { slug: "musnad-al-humaydi", title: "Musnad al-Ḥumaydī", noun: "Section" },
    { slug: "musnad-ibn-abi-shayba", title: "Musnad Ibn Abī Shayba", noun: "Section" },
    { slug: "hadith-muhammad-ibn-abd-allah-al-ansari", title: "Ḥadīth of Muḥammad ibn ʿAbd Allāh al-Anṣārī", noun: "Section" },
    { slug: "kitab-al-iman-al-adani", title: "Kitāb al-Īmān of al-ʿAdanī", noun: "Chapter" },
    { slug: "qiraat-al-nabi-al-duri", title: "Qirāʾāt al-Nabī of al-Dūrī", noun: "Section" },
    { slug: "musnad-ibrahim-ibn-adham", title: "Musnad Ibrāhīm ibn Adham", noun: "Section" },
    { slug: "kitab-al-kharaj-yahya-ibn-adam", title: "Kitāb al-Kharāj of Yaḥyā ibn Ādam", noun: "Chapter" },
    { slug: "kitab-al-salah-abu-nuaym", title: "Kitāb al-Ṣalāh of Abū Nuʿaym al-Faḍl ibn Dukayn", noun: "Chapter" },
    { slug: "sunan-al-athram", title: "Sunan al-Athram", noun: "Chapter" },
  ];
  return editions.flatMap((edition) => {
    const root = path.resolve(process.cwd(), "src/data/hadith/pages", edition.slug);
    const index: Array<{ n: number; title_en: string; count: number; file: string; noun?: string; unit?: string }> =
      JSON.parse(fs.readFileSync(path.join(root, "chapter-index.json"), "utf8"));
    return index.map((chapter) => ({
      params: { slug: edition.slug, n: String(chapter.n) },
      props: { edition, chapter },
    }));
  });
}

const { edition, chapter } = Astro.props;
const unitNoun: string = chapter.noun ?? edition.noun;
const root = path.resolve(process.cwd(), "src/data/hadith/pages", edition.slug);
const sourceHtml = fs.readFileSync(path.join(root, chapter.file), "utf8");
// Move the complete font import to the outer head, preserving the semicolons
// within the Google Fonts URL and the chapter's own CSS variables.
const sourceStyles = sourceHtml.match(/<style\b[^>]*>([\s\S]*?)<\/style>/i)?.[1] ?? "";
const fontImport = /@import\s+url\((['"])(https:\/\/fonts\.googleapis\.com\/[^'"]+)\1\)\s*;/i;
const fontUrl = sourceStyles.match(fontImport)?.[2];
const chapterStyles = sourceStyles.replace(fontImport, "");
const pageHtml = sourceHtml
  .replace(/<!doctype\s+html[^>]*>/i, "")
  .replace(/<head\b[^>]*>[\s\S]*?<\/head>/i, "")
  .replace(/<\/?html\b[^>]*>/gi, "")
  .replace(/<\/?body\b[^>]*>/gi, "")
  .replace(/<header\b[^>]*>[\s\S]*?<\/header>/gi, "")
  .replace(/<button\b[^>]*(?:id=["']print["']|data-print)[^>]*>[\s\S]*?<\/button>/gi, "");
const pageUrl = `/hadith/collection/${edition.slug}/chapter/${chapter.n}/`;
---

<BaseLayout
  title={`${edition.title}: ${unitNoun} ${chapter.n} | HadithCritic`}
  description={`${chapter.title_en}: ${chapter.count} ${chapter.unit === "sections" ? (chapter.count === 1 ? "section" : "sections") : chapter.count === 1 ? "source entry" : "source entries"} in ${unitNoun.toLowerCase()} ${chapter.n} of ${edition.title}.`}
  image={OG.collection(edition.slug)}
  imageAlt={`${edition.title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: edition.title, url: `/hadith/collection/${edition.slug}/` },
    { name: `${unitNoun} ${chapter.n}`, url: pageUrl },
  ]}
>
  {fontUrl && <link slot="head" rel="stylesheet" href={fontUrl} />}
  {/* Apply chapter rules after the shared site stylesheet, before chapter markup is parsed. */}
  <style is:inline set:html={chapterStyles}></style>
  <Fragment set:html={pageHtml} />
</BaseLayout>
