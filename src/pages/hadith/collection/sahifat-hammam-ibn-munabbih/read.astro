---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import reader from '../../../../data/hadith-pages/sahifat-hammam-ibn-munabbih/reader.html?raw';

const title = 'Ṣaḥīfat Hammām ibn Munabbih';
---
<BaseLayout
  title={`${title} · Reader | HadithCritic`}
  description="Read Ṣaḥīfat Hammām ibn Munabbih in Arabic and English, with a searchable narration index and source notes."
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Hadith corpus', url: '/hadith/' },
    { name: title, url: '/hadith/collection/sahifat-hammam-ibn-munabbih/' },
    { name: 'Read', url: '/hadith/collection/sahifat-hammam-ibn-munabbih/read/' },
  ]}
>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&amp;family=DM+Sans:wght@400;500;600;700&amp;family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&amp;display=swap" />
  <Fragment set:html={reader} />
</BaseLayout>
