---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import SunanRefinedFront from "../../../components/hadith/SunanRefinedFront.astro";

const slug = "sunan-ibn-majah";
const title = "Sunan Ibn Mājah";
const { description } = collectionFrontMatter(slug, title);
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection(slug)}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: `/hadith/collection/${slug}/` },
  ]}
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Public+Sans:wght@400;500;600;700&family=Amiri:wght@400;700&display=swap" />
  <SunanRefinedFront />
</BaseLayout>
