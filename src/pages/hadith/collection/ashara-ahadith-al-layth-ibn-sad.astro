---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/ashara-ahadith-al-layth-ibn-sad/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("ashara-ahadith-al-layth-ibn-sad", "Ten Selected Ḥadīths of al-Layth ibn Saʿd");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("ashara-ahadith-al-layth-ibn-sad")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/ashara-ahadith-al-layth-ibn-sad/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
