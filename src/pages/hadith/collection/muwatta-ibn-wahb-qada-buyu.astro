---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/muwatta-ibn-wahb-qada-buyu/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("muwatta-ibn-wahb-qada-buyu", "Muwaṭṭaʾ Ibn Wahb: Judicial Decisions on Sales");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("muwatta-ibn-wahb-qada-buyu")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/muwatta-ibn-wahb-qada-buyu/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
