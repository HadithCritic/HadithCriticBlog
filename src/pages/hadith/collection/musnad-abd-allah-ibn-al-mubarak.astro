---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith-pages/musnad-abd-allah-ibn-al-mubarak/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("musnad-abd-allah-ibn-al-mubarak", "Musnad ʿAbd Allāh ibn al-Mubārak");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("musnad-abd-allah-ibn-al-mubarak")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/musnad-abd-allah-ibn-al-mubarak/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
