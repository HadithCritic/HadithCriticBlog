---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/musnad-abd-allah-ibn-al-mubarak/collection.html?raw";
import chapters from "../../../data/hadith/pages/musnad-abd-allah-ibn-al-mubarak/chapter-index.json";
import PaintedFront from "../../../components/hadith/PaintedFront.astro";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("musnad-abd-allah-ibn-al-mubarak", "Musnad ʿAbd Allāh ibn al-Mubārak");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("musnad-abd-allah-ibn-al-mubarak")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/musnad-abd-allah-ibn-al-mubarak/" },
  ]}
>
  <PaintedFront
    slug="musnad-abd-allah-ibn-al-mubarak"
    front={parseCollectionHtml("musnad-abd-allah-ibn-al-mubarak", collectionHtml)}
    chapters={chapters}
    heroAlt="An illustrative scene accompanying Ibn al-Mubārak’s musnad."
    placeAr="مرو"
    groups={[]}
    itemSingular="chapter"
    itemPlural="chapters"
    arrangement="13 topical chapters in source order"
    span="Chapters 1–13"
  />
</BaseLayout>
