---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/jami-mamar-ibn-rashid/collection.html?raw";
import "../../../styles/hadith-library.css";
import "../../../styles/hadith-collection-aligned.css";

const { title, description } = collectionFrontMatter("jami-mamar-ibn-rashid", "Jāmiʿ Maʿmar ibn Rāshid");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("jami-mamar-ibn-rashid")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/jami-mamar-ibn-rashid/" },
  ]}
>
  <Fragment set:html={collectionHtml} />
</BaseLayout>
