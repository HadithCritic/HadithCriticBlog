---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/jami-mamar-ibn-rashid/collection.html?raw";
import PaintedFront from "../../../components/hadith/PaintedFront.astro";
import JamiTransmissionMap from "../../../components/hadith/JamiTransmissionMap.astro";
import chapters from "../../../data/hadith/pages/jami-mamar-ibn-rashid/chapter-index.json";
import { parseCollectionHtml } from "../../../lib/collection-front";

const { title, description } = collectionFrontMatter("jami-mamar-ibn-rashid", "Jāmiʿ Maʿmar ibn Rāshid");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("jami-mamar-ibn-rashid")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/jami-mamar-ibn-rashid/" },
  ]}
>
  <PaintedFront
    slug="jami-mamar-ibn-rashid"
    front={parseCollectionHtml("jami-mamar-ibn-rashid", collectionHtml)}
    chapters={chapters}
    heroAlt="Scholars discussing reports while a copyist records their words."
    placeAr="صنعاء"
    groups={[]}
    itemSingular="chapter"
    itemPlural="chapters"
    arrangement="283 topical chapters"
    span="From Seeking Permission to Kindness to Parents"
  >
    <JamiTransmissionMap slot="after-work" />
  </PaintedFront>
</BaseLayout>
