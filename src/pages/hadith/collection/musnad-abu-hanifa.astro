---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { OG } from "../../../lib/seo";
import { collectionFrontMatter } from "../../../lib/collection-units";
import collectionHtml from "../../../data/hadith/pages/musnad-abu-hanifa/collection.html?raw";
import chapters from "../../../data/hadith/pages/musnad-abu-hanifa/chapter-index.json";
import PaintedFront from "../../../components/hadith/PaintedFront.astro";
import MusnadTransmissionMap from "../../../components/hadith/MusnadTransmissionMap.astro";
import { MUSNAD_ABU_HANIFA_GROUPS } from "../../../data/hadith/musnad-abu-hanifa-groups";
import { parseCollectionHtml } from "../../../lib/collection-front";
import { COVER_ROOT, HERO_ALT } from "../../../data/hadith/musnad-abu-hanifa-covers";

const { title, description } = collectionFrontMatter("musnad-abu-hanifa", "Musnad Abū Ḥanīfa");
---

<BaseLayout
  title={`${title} | HadithCritic`}
  description={description}
  image={OG.collection("musnad-abu-hanifa")}
  imageAlt={`${title} | HadithCritic`}
  crumbs={[
    { name: "Home", url: "/" },
    { name: "Corpus", url: "/hadith/" },
    { name: title, url: "/hadith/collection/musnad-abu-hanifa/" },
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={`${COVER_ROOT}/hero.jpg`} imagesrcset={`${COVER_ROOT}/hero-1200.jpg 1200w, ${COVER_ROOT}/hero.jpg 2400w`} imagesizes="(min-width: 1500px) 1452px, calc(100vw - 32px)" fetchpriority="high" />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <PaintedFront
    slug="musnad-abu-hanifa"
    front={parseCollectionHtml("musnad-abu-hanifa", collectionHtml)}
    chapters={chapters}
    heroSrc={`${COVER_ROOT}/hero.jpg`}
    heroSmall={`${COVER_ROOT}/hero-1200.jpg`}
    heroAlt={HERO_ALT}
    placeAr="الكوفة"
    viaAr="رواية الحصكفي"
    groups={MUSNAD_ABU_HANIFA_GROUPS}
  >
    <MusnadTransmissionMap slot="after-work" />
  </PaintedFront>
</BaseLayout>
