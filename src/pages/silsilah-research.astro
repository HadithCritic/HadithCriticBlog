---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeometricEmblem from '../components/GeometricEmblem.astro';
---

<BaseLayout
  title="SilsilahResearch | Your library. Your isnāds. Your hard drive."
  description="A free, local-first research and writing environment for Islamic Studies and hadith criticism. Everything lives as plain Markdown files in a folder you own."
>
  <div class="sr-page">

    <!-- ═══ Hero ═══ -->
    <section class="sr-hero">
      <div class="hc-container sr-hero__inner">
        <h1 class="sr-hero__title">
          <span>Your library. Your isnāds.</span><br>
          <em>Your hard drive.</em>
        </h1>
        <p class="sr-hero__lead">
          A free, local-first research and writing environment for Islamic Studies
          and hadith criticism. Everything lives as plain Markdown files in a folder
          you own. No cloud. No database server. No lock-in.
        </p>
        <div class="sr-hero__actions">
          <a href="#get-started" class="hc-btn">
            Get SilsilahResearch
          </a>
          <span class="sr-hero__or">or</span>
          <div class="sr-terminal">
            <span class="sr-terminal__prompt">$</span>
            <span class="sr-terminal__cmd">git clone silsilah-research</span>
          </div>
        </div>
        <p class="sr-hero__note">
          Free and open-source. No subscription. No paywall.
        </p>
      </div>
    </section>

    <!-- ═══ Centered logo + tagline (Cabinet-style) ═══ -->
    <section class="sr-brand">
      <div class="sr-brand__inner">
        <h2 class="sr-brand__heading">
          <span>Your research vault.</span><br>
          <em>Your instruments.</em>
        </h2>
        <div class="sr-brand__logo" id="sr-brand-logo">
          <div class="sr-brand__card sr-card-shimmer" id="sr-brand-card">
            <GeometricEmblem size="85%" animate="none" className="sr-brand__emblem" />
          </div>
        </div>
        <p class="sr-brand__desc">
          The only research vault you actually own. Write in Markdown. The app
          understands <code>((Bukhari 5134))</code> as a citation,
          <code>[[al-Zuhrī]]</code> as a narrator link, and
          <code>(d. 204 AH)</code> as a date it can reason about.
        </p>
        <p class="sr-brand__sub">
          📚 Texts on disk · 🕸️ Isnād graphs · 🔤 Arabic root search · 🗓️ Hijrī-aware citations
        </p>
      </div>
    </section>

    <!-- ═══ Why SilsilahResearch (3-card grid) ═══ -->
    <section class="sr-why">
      <div class="hc-container">
        <div class="sr-section-head">
          <p class="sr-section-label">Why SilsilahResearch</p>
          <h2 class="sr-section-title">The only research vault you actually own</h2>
          <p class="sr-section-desc">
            Mainstream apps were not designed for Islamic scholarship. SilsilahResearch
            makes the core instruments of the field first-class objects in the editor.
          </p>
        </div>
        <div class="sr-card-grid">
          <div class="sr-card-item">
            <div class="sr-card-icon" aria-hidden="true">📄</div>
            <h3 class="sr-card-item__title">Your work lives on disk</h3>
            <p class="sr-card-item__desc">
              Notes are <code>.md</code> with YAML frontmatter. Reference books are
              <code>.json</code>. Nothing is trapped in a proprietary format. Grep it,
              git it, back it up.
            </p>
          </div>
          <div class="sr-card-item">
            <div class="sr-card-icon" aria-hidden="true">🔤</div>
            <h3 class="sr-card-item__title">Arabic is native, not bolted on</h3>
            <p class="sr-card-item__desc">
              Bidirectional text is correct out of the box. Search a three-letter Arabic
              root and find every morphological variation across your vault and reference
              library.
            </p>
          </div>
          <div class="sr-card-item">
            <div class="sr-card-icon" aria-hidden="true">🕸️</div>
            <h3 class="sr-card-item__title">Isnāds are first-class objects</h3>
            <p class="sr-card-item__desc">
              Draw chains on a canvas. The app validates temporal and geographic overlap
              between narrators and flags possible irsāl automatically.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Comparison table ═══ -->
    <section class="sr-compare">
      <div class="hc-container">
        <div class="sr-section-head">
          <p class="sr-section-label">Comparison</p>
          <h2 class="sr-section-title">How it does what Obsidian and Notion cannot</h2>
        </div>
        <div class="sr-table-wrap">
          <table class="sr-table">
            <thead>
              <tr>
                <th>Capability</th>
                <th>SilsilahResearch</th>
                <th>Obsidian</th>
                <th>Notion</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Bidirectional Arabic/English editing</td>
                <td><span class="sr-check">✅ native</span></td>
                <td><span class="sr-partial">➖ partial</span></td>
                <td><span class="sr-no">❌</span></td>
              </tr>
              <tr>
                <td>Arabic root and morphology search</td>
                <td><span class="sr-check">✅</span></td>
                <td><span class="sr-no">❌</span></td>
                <td><span class="sr-no">❌</span></td>
              </tr>
              <tr>
                <td>Hijrī / Gregorian temporal reasoning</td>
                <td><span class="sr-check">✅</span></td>
                <td><span class="sr-no">❌</span></td>
                <td><span class="sr-no">❌</span></td>
              </tr>
              <tr>
                <td>Dual-layer PDF citation (page-accurate)</td>
                <td><span class="sr-check">✅</span></td>
                <td><span class="sr-no">❌</span></td>
                <td><span class="sr-no">❌</span></td>
              </tr>
              <tr>
                <td>Isnād graphing and chain validation</td>
                <td><span class="sr-check">✅</span></td>
                <td><span class="sr-partial">➖ plugin</span></td>
                <td><span class="sr-no">❌</span></td>
              </tr>
              <tr>
                <td>Manuscript transcription workbench</td>
                <td><span class="sr-check">✅</span></td>
                <td><span class="sr-no">❌</span></td>
                <td><span class="sr-no">❌</span></td>
              </tr>
              <tr>
                <td>Local-first, offline, plain files</td>
                <td><span class="sr-check">✅</span></td>
                <td><span class="sr-check">✅</span></td>
                <td><span class="sr-no">❌</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ═══ Feature modules (Cabinet-style card grid) ═══ -->
    <section class="sr-features-deep">
      <div class="hc-container">
        <div class="sr-section-head">
          <p class="sr-section-label">Feature modules</p>
          <h2 class="sr-section-title">Built for the discipline</h2>
        </div>
        <div class="sr-features-grid">
          <div class="sr-feat-card">
            <div class="sr-feat-card__icon">✍️</div>
            <h3 class="sr-feat-card__title">CodeMirror bidi editor</h3>
            <p class="sr-feat-card__desc">
              Renders plain-text Markdown with live visual styling. <code>((Bukhari 5134))</code>
              becomes a clickable citation pill. <code>[[al-Zuhrī]]</code> links to the narrator's
              rijāl note. <code>(d. 204 AH)</code> triggers the dual-calendar engine.
            </p>
          </div>
          <div class="sr-feat-card">
            <div class="sr-feat-card__icon">🔤</div>
            <h3 class="sr-feat-card__title">Morphological root search</h3>
            <p class="sr-feat-card__desc">
              Type a three-letter Arabic root. The Rust backend generates all valid surface
              forms and searches your vault and reference library. Results return grouped
              by morphological form.
            </p>
          </div>
          <div class="sr-feat-card">
            <div class="sr-feat-card__icon">🕸️</div>
            <h3 class="sr-feat-card__title">Isnād validator</h3>
            <p class="sr-feat-card__desc">
              Draw an isnād tree. The backend checks chronological and geographic overlap
              between narrators. No overlap? The line turns red with a tooltip:
              <em>"Possible irsāl."</em>
            </p>
          </div>
          <div class="sr-feat-card">
            <div class="sr-feat-card__icon">📜</div>
            <h3 class="sr-feat-card__title">Manuscript workbench</h3>
            <p class="sr-feat-card__desc">
              Split-pane: deep-zoom manuscript image on the left, RTL editor on the right.
              Drop pins on the image that bind to text line numbers. Transcription
              permanently linked to the folio.
            </p>
          </div>
          <div class="sr-feat-card">
            <div class="sr-feat-card__icon">📄</div>
            <h3 class="sr-feat-card__title">Dual-layer PDF</h3>
            <p class="sr-feat-card__desc">
              Classical texts are ingested as structured JSON. The search engine sees
              continuous text. Citations stay accurate to the page even when a passage
              runs across a page break.
            </p>
          </div>
          <div class="sr-feat-card">
            <div class="sr-feat-card__icon">📦</div>
            <h3 class="sr-feat-card__title">Academic export</h3>
            <p class="sr-feat-card__desc">
              Click <strong>Compile Manuscript</strong>. Pandoc produces submission-ready
              LaTeX or <code>.docx</code> with a correctly formatted Chicago or MLA
              bibliography from your local Zotero export.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Philosophy / principles ═══ -->
    <section class="sr-philosophy">
      <div class="hc-container">
        <div class="sr-section-head">
          <p class="sr-section-label">Philosophy</p>
          <h2 class="sr-section-title">The only research vault you actually own</h2>
        </div>
        <div class="sr-principles">
          <div class="sr-principle">
            <strong>Local-first.</strong> Your vault is a folder on your drive. Grep it,
            git it, sync it with whatever you like, or never sync it at all.
          </div>
          <div class="sr-principle">
            <strong>Plain text forever.</strong> Notes are <code>.md</code> with YAML
            frontmatter. Reference books are <code>.json</code>. Nothing is trapped in a
            proprietary format.
          </div>
          <div class="sr-principle">
            <strong>Offline by default.</strong> No data leaves your machine unless you
            explicitly hand it to a third-party sync tool.
          </div>
          <div class="sr-principle">
            <strong>RTL is not an afterthought.</strong> Bidirectional text is correct out
            of the box, including Arabic and English on one line.
          </div>
          <div class="sr-principle">
            <strong>Fast and light.</strong> A Rust core, no bundled Chromium, low RAM,
            instant search over large corpora.
          </div>
          <div class="sr-principle">
            <strong>The discipline comes first.</strong> Isnād, rijāl, and Hijrī dates
            are native features, not community add-ons.
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Get started CTA ═══ -->
    <section class="sr-cta" id="get-started">
      <div class="hc-container">
        <div class="sr-cta__panel">
          <div class="sr-cta__content">
            <span class="hc-eyebrow">Get started</span>
            <h2 class="sr-cta__title">Clone it, run it, make it your own.</h2>
            <div class="sr-terminal sr-terminal--light">
              <span class="sr-terminal__prompt">$</span>
              <span class="sr-terminal__cmd">git clone silsilah-research && cd silsilah-research && pnpm tauri dev</span>
            </div>
            <p class="sr-cta__copy">
              Requires Rust (stable), Tauri prerequisites, Node 20+, and pnpm.
            </p>
            <div class="sr-cta__actions">
              <a href="/contact" class="hc-btn">Send a proposal</a>
              <a href="/projects" class="hc-btn hc-btn--ghost">View all projects</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /* Mouse-tracking shimmer */
  const cards = document.querySelectorAll<HTMLElement>('.sr-card-shimmer');
  cards.forEach((card) => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
    }, { passive: true });
  });
</script>

<style>
  /* ═══ Page ═══ */

  .sr-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 80% 8%, rgba(216, 177, 102, 0.06), transparent 32%),
      radial-gradient(circle at 12% 45%, rgba(164, 106, 63, 0.07), transparent 30%),
      linear-gradient(180deg, var(--hc-charcoal) 0%, var(--hc-black) 55%);
  }

  /* ═══ Hero ═══ */

  .sr-hero {
    padding: clamp(7rem, 12vw, 10rem) 0 clamp(3rem, 6vw, 5rem);
    text-align: center;
  }

  .sr-hero__inner {
    max-width: 52rem;
    margin-inline: auto;
  }

  .sr-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.8rem, 6.5vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--hc-parchment);
    animation: srRise 0.8s var(--ease) both;
  }

  .sr-hero__title em {
    font-style: italic;
    color: var(--hc-gold);
  }

  .sr-hero__lead {
    max-width: 42rem;
    margin: 1.5rem auto 0;
    color: var(--hc-muted);
    font-size: clamp(1.06rem, 0.5vw + 0.98rem, 1.22rem);
    line-height: 1.72;
    animation: srRise 0.8s var(--ease) 100ms both;
  }

  .sr-hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
    animation: srRise 0.8s var(--ease) 200ms both;
  }

  .sr-hero__or {
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }

  .sr-terminal {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.2rem;
    border-radius: 10px;
    background: rgba(15, 15, 16, 0.8);
    border: 1px solid var(--hc-rule-soft);
    font-family: 'Source Code Pro', 'IBM Plex Mono', monospace;
    font-size: 0.88rem;
  }

  .sr-terminal__prompt {
    color: #6ec76e;
  }

  .sr-terminal__cmd {
    color: var(--hc-parchment);
    white-space: nowrap;
  }

  .sr-hero__note {
    margin-top: 1.2rem;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    animation: srRise 0.8s var(--ease) 300ms both;
  }

  @keyframes srRise {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ═══ Centered brand / logo section ═══ */

  .sr-brand {
    padding-block: clamp(3rem, 6vw, 5rem);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .sr-brand__inner {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  .sr-brand__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--hc-parchment);
    margin: 0 0 2.5rem;
  }

  .sr-brand__heading em {
    font-style: italic;
    color: var(--hc-gold);
  }

  .sr-brand__logo {
    width: clamp(12rem, 18vw, 16rem);
    height: clamp(12rem, 18vw, 16rem);
    margin: 0 auto 2rem;
    cursor: pointer;
  }

  .sr-brand__card {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20%;
    background: linear-gradient(145deg, #26231f, #141210);
    box-shadow:
      inset 0 1px 0 1px rgba(255, 255, 255, 0.025),
      0 5px 10px 5px rgba(0, 0, 0, 0.08);
    transition: transform 1s var(--ease), box-shadow 2s ease-in-out;
  }

  .sr-card-shimmer::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 2;
    opacity: 0.075;
    background: radial-gradient(
      200px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(255, 255, 255, 0.06),
      rgba(0, 0, 0, 0.12)
    );
    transition: opacity 500ms;
  }

  .sr-card-shimmer:hover::before {
    opacity: 1;
  }

  .sr-brand__card:hover {
    transform: scale(1.1);
    box-shadow:
      inset 0 1px 1px 1px rgba(255, 255, 255, 0.05),
      0 20px 30px 10px rgba(0, 0, 0, 0.25);
    transition: transform 1s var(--ease), box-shadow 750ms ease-in-out 150ms;
  }

  .sr-brand__card :global(.sr-brand__emblem) {
    position: relative;
    z-index: 5;
    width: 85%;
    height: 85%;
  }

  .sr-brand__desc {
    max-width: 40rem;
    margin: 0 auto 1rem;
    color: var(--hc-muted);
    font-size: clamp(1.04rem, 0.4vw + 0.98rem, 1.18rem);
    line-height: 1.72;
  }

  .sr-brand__desc code {
    color: var(--hc-gold);
    font-family: 'Source Code Pro', monospace;
    font-size: 0.92em;
    background: rgba(216, 177, 102, 0.08);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }

  .sr-brand__sub {
    margin: 0;
    color: var(--hc-ash);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  /* ═══ Shared section head ═══ */

  .sr-section-head {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .sr-section-label {
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--hc-gold);
    margin: 0 0 0.5rem;
  }

  .sr-section-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--hc-parchment);
  }

  .sr-section-desc {
    max-width: 40rem;
    margin: 0.8rem auto 0;
    color: var(--hc-muted);
    line-height: 1.68;
  }

  /* ═══ Why section (3-card grid) ═══ */

  .sr-why {
    padding-block: clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--hc-rule-soft);
  }

  .sr-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 64rem;
    margin-inline: auto;
  }

  .sr-card-item {
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border: 1px solid var(--hc-rule-soft);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.5), rgba(15, 15, 16, 0.7));
    transition: border-color 300ms ease, transform 300ms var(--ease);
  }

  .sr-card-item:hover {
    border-color: var(--hc-rule);
    transform: translateY(-3px);
  }

  .sr-card-icon {
    font-size: 1.6rem;
    margin-bottom: 1rem;
  }

  .sr-card-item__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--hc-parchment);
    letter-spacing: -0.01em;
  }

  .sr-card-item__desc {
    margin: 0;
    color: var(--hc-muted);
    font-size: 0.92rem;
    line-height: 1.62;
  }

  .sr-card-item__desc code {
    color: var(--hc-gold-dim);
    font-family: 'Source Code Pro', monospace;
    font-size: 0.88em;
  }

  /* ═══ Comparison table ═══ */

  .sr-compare {
    padding-block: clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--hc-rule-soft);
  }

  .sr-table-wrap {
    max-width: 56rem;
    margin-inline: auto;
    overflow-x: auto;
  }

  .sr-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .sr-table th {
    text-align: left;
    padding: 0.8rem 1rem;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hc-gold);
    border-bottom: 2px solid var(--hc-rule);
    white-space: nowrap;
  }

  .sr-table th:not(:first-child) {
    text-align: center;
  }

  .sr-table td {
    padding: 0.75rem 1rem;
    color: var(--hc-parchment);
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .sr-table td:not(:first-child) {
    text-align: center;
  }

  .sr-table tr:hover td {
    background: rgba(216, 177, 102, 0.04);
  }

  .sr-check { color: #6ec76e; }
  .sr-partial { color: #e8c87a; }
  .sr-no { opacity: 0.5; }

  /* ═══ Feature modules (deep) ═══ */

  .sr-features-deep {
    padding-block: clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--hc-rule-soft);
    position: relative;
    overflow: hidden;
  }

  .sr-features-deep::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 55% at 50% 0%, rgba(164, 106, 63, 0.05), transparent 70%);
    pointer-events: none;
  }

  .sr-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 64rem;
    margin-inline: auto;
    position: relative;
    z-index: 1;
  }

  .sr-feat-card {
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border: 1px solid var(--hc-rule-soft);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.5), rgba(15, 15, 16, 0.7));
    transition: border-color 300ms ease, transform 300ms var(--ease);
  }

  .sr-feat-card:hover {
    border-color: var(--hc-rule);
    transform: translateY(-3px);
  }

  .sr-feat-card__icon {
    font-size: 1.6rem;
    margin-bottom: 1rem;
  }

  .sr-feat-card__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--hc-parchment);
