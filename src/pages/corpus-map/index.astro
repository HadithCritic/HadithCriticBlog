---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';
import path from 'node:path';

const DATA = path.join(process.cwd(), 'public', 'corpus-data');

/* Display names for the corpus-data slugs. Kept inline so this build-time page
   has no dependency on the (D1-migrated) Silsilah index. Unknown slugs fall back
   to the manifest's compilerName, then the slug itself. */
const names: Record<string, string> = {
  abudawud: 'Sunan Abī Dāwūd',
  adab: 'al-Adab al-Mufrad',
  ahmad: 'Musnad Aḥmad',
  'ahmad-zuhd': 'Kitāb al-Zuhd',
  bayhaqi: 'al-Sunan al-Kubrā (al-Bayhaqī)',
  bazzar: 'Musnad al-Bazzār',
  bukhari: 'Ṣaḥīḥ al-Bukhārī',
  darimi: 'Sunan al-Dārimī',
  hakim: 'al-Mustadrak (al-Ḥākim)',
  ibnhibban: 'Ṣaḥīḥ Ibn Ḥibbān',
  ibnkhuzaymah: 'Ṣaḥīḥ Ibn Khuzayma',
  ibnmajah: 'Sunan Ibn Mājah',
  'lulu-marjan': 'al-Luʾluʾ wa-l-Marjān',
  malik: 'Muwaṭṭaʾ Mālik',
  muslim: 'Ṣaḥīḥ Muslim',
  nasai: 'Sunan al-Nasāʾī',
  'nasai-kubra': 'al-Sunan al-Kubrā (al-Nasāʾī)',
  tabarani: 'al-Muʿjam (al-Ṭabarānī)',
  tirmidhi: 'Jāmiʿ al-Tirmidhī'
};

interface Manifest {
  slug: string;
  shards: number;
  count: number;
  compilerCity: number;
  compilerName: string;
  narrators: number;
  located: number;
  cities: [string, string, number, number][];
}

const manifests: Manifest[] = readdirSync(DATA)
  .filter((d) => existsSync(path.join(DATA, d, 'manifest.json')))
  .map((d) => JSON.parse(readFileSync(path.join(DATA, d, 'manifest.json'), 'utf8')));

const collections = manifests
  .filter((m) => m.count >= 200)
  .sort((a, b) => (names[a.slug] ?? a.slug).localeCompare(names[b.slug] ?? b.slug));

const CITIES = manifests[0].cities;

/* equirectangular-ish projection shared with the client script */
const PX = (lon: number) => (lon - 28.2) * 25.8 + 14;
const PY = (lat: number) => (41.8 - lat) * 26.5 + 6;
const VIEW_W = 1050;
const VIEW_H = 730;

const LABELED = new Set([
  'medina', 'mecca', 'sanaa', 'fustat', 'damascus', 'homs', 'kufa', 'basra',
  'baghdad', 'wasit', 'rayy', 'isfahan', 'nishapur', 'merv', 'balkh', 'bukhara',
  'samarqand', 'jerusalem', 'mosul', 'qazwin'
]);

/* faint orientation lines: red sea, gulf, mediterranean coast, caspian south shore */
const COASTS: [number, number][][] = [
  [[32.6, 29.9], [34.6, 28.0], [38.0, 22.0], [43.3, 12.6]],
  [[48.0, 30.2], [49.6, 28.6], [50.7, 26.8], [54.2, 26.5], [56.4, 27.0]],
  [[29.5, 31.2], [32.0, 31.3], [34.5, 31.6], [35.5, 33.5], [35.9, 35.5], [36.1, 36.6]],
  [[49.2, 37.4], [51.3, 36.7], [53.9, 36.8], [56.5, 38.1], [59.0, 38.0]]
];

const coastPaths = COASTS.map(
  (line) => 'M ' + line.map(([lon, lat]) => `${PX(lon).toFixed(1)} ${PY(lat).toFixed(1)}`).join(' L ')
);

const stats = manifests.reduce(
  (a, m) => ({ chains: a.chains + m.count, narrators: a.narrators + m.narrators, located: a.located + m.located }),
  { chains: 0, narrators: 0, located: 0 }
);
const pct = Math.round((stats.located / stats.narrators) * 100);
---

<BaseLayout
  title="Corpus Mapping | HadithCritic"
  description="Trace the geographic journey of any hadith: from the Prophet in Medina, narrator by narrator, city by city, to the compiler who wrote it down."
>
  <section class="cm-hero">
    <div class="hc-container">
      <nav class="cm-crumbs" aria-label="Breadcrumb">
        <a href="/projects">Projects</a>
        <span aria-hidden="true">/</span>
        <span>Corpus Mapping</span>
      </nav>
      <div class="cm-head">
        <div>
          <span class="hc-eyebrow">Corpus Mapping, version one</span>
          <h1 class="cm-title">Watch a report travel.</h1>
          <p class="hc-copy cm-sub">
            Enter any reference and trace its chain across the early Islamic world: from the
            Prophet in Madīna, through each transmitter whose city the record preserves, to the
            compiler who fixed it in writing. Locations come from the narrators' own names and
            a register of the best-known transmitters; {pct}% of the corpus's
            {stats.narrators.toLocaleString('en-US')} narrator positions can currently be placed.
          </p>
        </div>
        <form id="cmForm" class="cm-form" role="search">
          <select id="cmCollection" aria-label="Collection">
            {collections.map((m) => (
              <option value={m.slug} selected={m.slug === 'bukhari'}>{names[m.slug] ?? m.slug}</option>
            ))}
          </select>
          <input id="cmNum" type="text" placeholder="Number, e.g. 5134" aria-label="Hadith number" autocomplete="off" spellcheck="false" />
          <button type="submit" class="hc-btn">Trace</button>
          <button type="button" id="cmRandom" class="hc-btn hc-btn--ghost" title="Trace a random report">Random</button>
        </form>
      </div>
    </div>
  </section>

  <section class="cm-body">
    <div class="hc-container cm-grid">
      <div class="cm-map-wrap">
        <svg id="cmMap" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} role="img" aria-label="Map of the early Islamic world from Egypt to Transoxiana, on which the transmission journey of the chosen hadith is drawn city by city.">
          <!-- graticule -->
          {Array.from({ length: 9 }, (_, i) => 30 + i * 5).map((lon) => (
            <line class="cm-grat" x1={PX(lon)} y1="0" x2={PX(lon)} y2={VIEW_H} />
          ))}
          {Array.from({ length: 6 }, (_, i) => 15 + i * 5).map((lat) => (
            <line class="cm-grat" x1="0" y1={PY(lat)} x2={VIEW_W} y2={PY(lat)} />
          ))}
          <!-- coast hints -->
          {coastPaths.map((d) => <path class="cm-coast" d={d} />)}
          <!-- cities -->
          {CITIES.map(([id, label, lon, lat]) => (
            <g class="cm-city" data-city={id} transform={`translate(${PX(lon).toFixed(1)} ${PY(lat).toFixed(1)})`}>
              <circle class="cm-city-dot" r="3" />
              {LABELED.has(id) && <text class="cm-city-lbl" x="7" y="3.5">{label}</text>}
            </g>
          ))}
          <g id="cmJourney"></g>
        </svg>
        <p class="cm-mapnote" id="cmMapNote"></p>
      </div>

      <aside class="cm-panel">
        <header class="cm-panel-head">
          <h2 id="cmPanelTitle">The journey</h2>
          <button type="button" id="cmReplay" class="cm-replay" title="Replay" aria-label="Replay journey" hidden>
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 4 3 9 8 9"/></svg>
          </button>
        </header>
        <p class="cm-status" id="cmStatus">Pick a collection and a number, or press Random.</p>
        <ol class="cm-steps" id="cmSteps"></ol>
        <a class="cm-silsilah" id="cmSilsilah" href="#" hidden>Read this report in Silsilah →</a>
        <div class="cm-method">
          <h3>How locations are assigned</h3>
          <p>
            A transmitter is placed by four cascading methods: a geographic nisba in his own name
            (al-Kūfī, al-Madanī ...); a register of the best-known transmitters; a skeleton match
            against the geocoded entries of Dhahabī's <em>al-Kāshif</em> in the
            <a href="/rijal/">narrator biographies</a> data; and, for bare names, the city implied
            by the company he keeps elsewhere in the corpus (a statistical form of recovering an
            identity from fuller spellings in parallel chains). Genuinely ambiguous bare names,
            an unqualified "Sufyān" or "Yaḥyā", are left as "location unrecorded" rather than
            guessed. Cities mark a narrator's principal base, not every journey he made, and the
            Prophet and compiler anchor the two ends.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ collections: collections.map((m) => m.slug) }}>
  window.__cmCollections = collections;
</script>

<script>
  const PXc = (lon: number) => (lon - 28.2) * 25.8 + 14;
  const PYc = (lat: number) => (41.8 - lat) * 26.5 + 6;

  type Manifest = {
    slug: string; shards: number; count: number; compilerCity: number;
    compilerName: string; cities: [string, string, number, number][];
  };
  type Step = { name: string; city: number; kind: 'origin' | 'narrator' | 'compiler' };

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const form = $('cmForm') as HTMLFormElement;
  const colSel = $('cmCollection') as HTMLSelectElement;
  const numInput = $('cmNum') as HTMLInputElement;
  const statusEl = $('cmStatus');
  const stepsEl = $('cmSteps') as HTMLOListElement;
  const journeyG = $('cmJourney');
  const mapNote = $('cmMapNote');
  const replayBtn = $('cmReplay') as HTMLButtonElement;
  const silLink = $('cmSilsilah') as HTMLAnchorElement;

  const manifests = new Map<string, Manifest>();
  const shards = new Map<string, Record<string, [string, number][]>>();
  let token = 0;
  let lastQuery: { slug: string; ref: string } | null = null;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));

  function djb2(s: string) {
    let h = 5381;
    for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0;
    return h;
  }

  async function getManifest(slug: string): Promise<Manifest> {
    let m = manifests.get(slug);
    if (!m) {
      m = await (await fetch(`/corpus-data/${slug}/manifest.json`)).json();
      manifests.set(slug, m!);
    }
    return m!;
  }

  async function getSeq(slug: string, ref: string): Promise<[string, number][] | null> {
    const m = await getManifest(slug);
    const si = djb2(ref) % m.shards;
    const key = slug + '/' + si;
    let shard = shards.get(key);
    if (!shard) {
      shard = await (await fetch(`/corpus-data/${slug}/shard-${si}.json`)).json();
      if (shards.size > 6) shards.clear();
      shards.set(key, shard!);
    }
    return shard![ref] ?? null;
  }

  function clearJourney() {
    journeyG.innerHTML = '';
    stepsEl.innerHTML = '';
    mapNote.textContent = '';
    document.querySelectorAll('.cm-city.is-lit').forEach((c) => c.classList.remove('is-lit'));
  }

  function lightCity(m: Manifest, ci: number) {
    const id = m.cities[ci][0];
    document.querySelector(`.cm-city[data-city="${id}"]`)?.classList.add('is-lit');
  }

  function svgEl<K extends keyof SVGElementTagNameMap>(tag: K) {
    return document.createElementNS('http://www.w3.org/2000/svg', tag);
  }

  function pulseAt(x: number, y: number, big = false) {
    const c = svgEl('circle');
    c.setAttribute('cx', String(x));
    c.setAttribute('cy', String(y));
    c.setAttribute('r', big ? '7' : '5');
    c.setAttribute('class', 'cm-pulse');
    journeyG.appendChild(c);
    setTimeout(() => c.remove(), 1600);
  }

  function drawArc(x1: number, y1: number, x2: number, y2: number, instant: boolean) {
    const dx = x2 - x1;
    const dy = y2 - y1;
    const dist = Math.hypot(dx, dy);
    const bow = Math.min(dist * 0.22, 60);
    const mx = (x1 + x2) / 2 - (dy / (dist || 1)) * bow;
    const my = (y1 + y2) / 2 + (dx / (dist || 1)) * bow;
    const p = svgEl('path');
    p.setAttribute('d', `M ${x1} ${y1} Q ${mx} ${my} ${x2} ${y2}`);
    p.setAttribute('class', 'cm-arc');
    journeyG.appendChild(p);
    const len = p.getTotalLength();
    if (instant) return Promise.resolve();
    p.style.strokeDasharray = String(len);
    p.style.strokeDashoffset = String(len);
    p.getBoundingClientRect();
    const dur = Math.max(450, Math.min(1100, dist * 4));
    p.style.transition = `stroke-dashoffset ${dur}ms cubic-bezier(0.4, 0, 0.4, 1)`;
    p.style.strokeDashoffset = '0';
    return sleep(dur + 80);
  }

  function stepRow(step: Step, m: Manifest): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'cm-step cm-step--' + step.kind + (step.city < 0 ? ' cm-step--lost' : '');
    const nm = document.createElement('span');
    nm.className = 'cm-step-name';
    nm.textContent = step.name;
    const city = document.createElement('span');
    city.className = 'cm-step-city';
    city.textContent = step.city >= 0 ? m.cities[step.city][1] : 'location unrecorded';
    li.appendChild(nm);
    li.appendChild(city);
    return li;
  }

  async function trace(slug: string, num: string) {
    const my = ++token;
    const ref = slug + ':' + num.trim();
    lastQuery = { slug, ref };
    clearJourney();
    replayBtn.hidden = true;
    silLink.hidden = true;
    statusEl.textContent = 'Looking up ' + ref + ' ...';

    let m: Manifest;
    let seq: [string, number][] | null;
    try {
      m = await getManifest(slug);
      seq = await getSeq(slug, ref);
    } catch {
      statusEl.textContent = 'Could not load the map data for this collection.';
      return;
    }
    if (my !== token) return;
    if (!seq) {
      statusEl.textContent = 'No traceable chain found for ' + ref + '. Check the number, or the report may have no recorded English chain.';
      return;
    }

    const steps: Step[] = [
      { name: 'The Prophet ﷺ', city: m.cities.findIndex((c) => c[0] === 'medina'), kind: 'origin' },
      ...seq.map(([name, city]) => ({ name, city, kind: 'narrator' as const })),
      { name: m.compilerName + ', the compiler', city: m.compilerCity, kind: 'compiler' as const }
    ];

    const locatedCount = seq.filter(([, c]) => c >= 0).length;
    statusEl.textContent = `${ref}: ${seq.length} transmitters in the chain, ${locatedCount} of them placeable.`;
    silLink.href = '/silsilah/find/?q=' + encodeURIComponent(ref);
    silLink.hidden = false;

    const url = new URL(location.href);
    url.searchParams.set('q', ref);
    history.replaceState(null, '', url);

    // timeline rows
    const rows = steps.map((s) => {
      const r = stepRow(s, m);
      stepsEl.appendChild(r);
      return r;
    });

    // animate
    const distinct = new Set(steps.filter((s) => s.city >= 0).map((s) => s.city));
    let px: number | null = null;
    let py: number | null = null;
    let lastCity = -1;
    for (let i = 0; i < steps.length; i++) {
      if (my !== token) return;
      const s = steps[i];
      rows.forEach((r) => r.classList.remove('is-now'));
      rows[i].classList.add('is-now');
      rows[i].classList.add('is-done');
      if (s.city >= 0) {
        const [, , lon, lat] = m.cities[s.city];
        const x = PXc(lon);
        const y = PYc(lat);
        lightCity(m, s.city);
        if (px === null) {
          pulseAt(x, y, true);
          await sleep(620);
        } else if (s.city === lastCity) {
          pulseAt(x, y);
          await sleep(480);
        } else {
          await drawArc(px, py!, x, y, reduced);
          pulseAt(x, y);
          await sleep(160);
        }
        px = x;
        py = y;
        lastCity = s.city;
      } else {
        await sleep(330);
      }
    }
    if (my !== token) return;
    rows.forEach((r) => r.classList.remove('is-now'));
    replayBtn.hidden = false;

    if (distinct.size <= 1) {
      mapNote.textContent = 'As far as its recorded names tell us, this transmission never left ' +
        (distinct.size ? m.cities[[...distinct][0]][1] : 'its starting point') +
        ' until the compiler received it.';
    } else {
      mapNote.textContent = 'The journey touches ' + distinct.size + ' identifiable cities. Unplaced narrators are listed in the chain but drawn as pauses.';
    }
  }

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    if (numInput.value.trim()) trace(colSel.value, numInput.value);
  });

  replayBtn.addEventListener('click', () => {
    if (lastQuery) trace(lastQuery.slug, lastQuery.ref.split(':').slice(1).join(':'));
  });

  ($('cmRandom') as HTMLButtonElement).addEventListener('click', async () => {
    const slug = colSel.value;
    const m = await getManifest(slug);
    const si = Math.floor(Math.random() * m.shards);
    const shard = await (await fetch(`/corpus-data/${slug}/shard-${si}.json`)).json();
    const keys = Object.keys(shard);
    const ref = keys[Math.floor(Math.random() * keys.length)];
    const num = ref.split(':').slice(1).join(':');
    numInput.value = num;
    trace(slug, num);
  });

  // deep link or default demo
  const q = new URL(location.href).searchParams.get('q');
  if (q && q.includes(':')) {
    const [slug, ...rest] = q.split(':');
    if ((window as any).__cmCollections.includes(slug)) {
      colSel.value = slug;
      numInput.value = rest.join(':');
      trace(slug, rest.join(':'));
    }
  } else {
    numInput.value = '5134';
    trace('bukhari', '5134');
  }
</script>

<style>
  .cm-hero {
    border-bottom: 1px solid var(--hc-rule);
    background:
      radial-gradient(circle at 82% 12%, rgba(216, 177, 102, 0.07), transparent 36%),
      linear-gradient(180deg, rgba(30, 29, 27, 0.6), rgba(15, 15, 16, 0.2));
    padding-block: clamp(1.8rem, 4vw, 3rem);
  }

  .cm-crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cm-crumbs a {
    color: var(--hc-gold-dim);
    text-decoration: none;
  }

  .cm-crumbs a:hover {
    color: var(--hc-gold);
  }

  .cm-head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.6fr);
    gap: clamp(1.6rem, 4vw, 3rem);
    align-items: end;
  }

  .cm-title {
    margin: 0.8rem 0 0;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .cm-sub {
    margin: 1rem 0 0;
    max-width: 60ch;
  }

  .cm-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
    gap: 0.6rem;
  }

  .cm-form select,
  .cm-form input {
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    background: rgba(15, 15, 16, 0.6);
    color: var(--hc-parchment);
    font-family: var(--font-ui);
    font-size: 0.88rem;
  }

  .cm-form select { grid-column: 1 / -1; cursor: pointer; }
  .cm-form select:focus, .cm-form input:focus { outline: none; border-color: var(--hc-rule-strong); }

  .cm-body {
    padding-block: clamp(1.6rem, 3.5vw, 2.8rem) clamp(2.5rem, 5vw, 4rem);
  }

  .cm-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.45fr);
    gap: clamp(1.2rem, 2.6vw, 2.2rem);
    align-items: start;
  }

  .cm-map-wrap {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    background:
      radial-gradient(circle at 30% 80%, rgba(164, 106, 63, 0.07), transparent 40%),
      radial-gradient(circle at 80% 10%, rgba(216, 177, 102, 0.05), transparent 36%),
      linear-gradient(180deg, #181612, #100f0d);
    padding: clamp(0.5rem, 1.4vw, 1rem);
  }

  .cm-map-wrap svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .cm-grat {
    stroke: rgba(242, 235, 220, 0.045);
    stroke-width: 1;
  }

  .cm-coast {
    fill: none;
    stroke: rgba(216, 177, 102, 0.16);
    stroke-width: 1.2;
    stroke-dasharray: 3 5;
    stroke-linecap: round;
  }

  .cm-city-dot {
    fill: rgba(216, 177, 102, 0.28);
    stroke: rgba(216, 177, 102, 0.45);
    stroke-width: 0.8;
    transition: fill 400ms ease, r 400ms ease;
  }

  :global(.cm-city.is-lit) .cm-city-dot {
    fill: var(--hc-gold);
    stroke: var(--hc-gold-soft);
  }

  .cm-city-lbl {
    fill: rgba(184, 173, 153, 0.6);
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  :global(.cm-city.is-lit) .cm-city-lbl {
    fill: var(--hc-parchment);
  }

  :global(.cm-arc) {
    fill: none;
    stroke: var(--hc-gold);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.85;
    filter: drop-shadow(0 0 4px rgba(216, 177, 102, 0.45));
  }

  :global(.cm-pulse) {
    fill: none;
    stroke: var(--hc-gold);
    stroke-width: 1.4;
    animation: cm-pulse 1.5s ease-out forwards;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes cm-pulse {
    0% { opacity: 0.95; transform: scale(0.4); }
    100% { opacity: 0; transform: scale(2.6); }
  }

  .cm-mapnote {
    min-height: 1.2rem;
    margin: 0.7rem 0.4rem 0.2rem;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  /* panel */

  .cm-panel {
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.6), rgba(15, 15, 16, 0.9));
    padding: clamp(1rem, 2.2vw, 1.5rem);
  }

  .cm-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .cm-panel-head h2 {
    margin: 0;
