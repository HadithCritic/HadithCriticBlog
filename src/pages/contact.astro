---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { OG } from "../lib/seo";
import "../styles/contact.css";

/* What people write about. `value` is what the form sends as its topic, and
   a topic link (?topic=…) preselects it. */
const topics = [
  {
    value: "Correction",
    title: "A correction",
    text: "Something in a published study, translation, citation or database record is wrong.",
    help: "Link the page and quote the passage exactly as printed.",
  },
  {
    value: "Source or research material",
    title: "A source or research material",
    text: "An edition, manuscript, page reference or study that bears on the research.",
    help: "Name the edition, volume and page, or link the study.",
  },
  {
    value: "Question",
    title: "A question",
    text: "About an article, one of the databases, or the method behind them.",
    help: "Say which page the question is about.",
  },
  {
    value: "Collaboration",
    title: "Collaboration",
    text: "Research, translation, data or technical work on the projects.",
    help: "A few lines on your background and what you have in mind.",
  },
  {
    value: "Other",
    title: "Something else",
    text: "Anything that does not fit above.",
    help: "",
  },
];

const elsewhere = [
  { name: "YouTube", handle: "@HadithCritic", href: "https://www.youtube.com/@HadithCritic", note: "Video investigations, lectures and debates." },
  { name: "X", handle: "@HadithCritic", href: "https://x.com/HadithCritic", note: "Posts and updates from HadithCritic." },
  { name: "Discord", handle: "Submission server", href: "https://discord.gg/SubmissionServer", note: "Community discussion." },
  { name: "GitHub", handle: "HadithCritic/HadithCriticBlog", href: "https://github.com/HadithCritic/HadithCriticBlog", note: "The source code of this site." },
];
---

<BaseLayout
  image={OG.contact}
  title="Contact | HadithCritic"
  description="Contact HadithCritic: send a correction, share a source or research material, ask a question, or propose a collaboration."
>
  <div class="hc-page hc-plate ct-page">
    <PageHero
      title="Contact"
      accent="HadithCritic"
      titleId="ct-title"
      kicker="Contact"
      art="/images/editorial/contact-hero.webp"
      focus="82% 40%"
      class="ct-hero"
      measure="12ch"
    >
      <p class="hc-hero__lede">
        Send a correction, share a source, ask a question or propose a collaboration. The form
        below reaches HadithCritic directly.
      </p>
    </PageHero>

    <section class="hc-band hc-band--soft ct-main" aria-labelledby="ct-form-title">
      <div class="hc-container ct-grid">
        <div class="ct-topics">
          <h2 class="hc-head__title ct-topics__title">What are you <span>writing about?</span></h2>
          <p class="hc-head__note">Choose one and the form will be set to it.</p>
          <ol class="ct-topic-list">
            {topics.map((topic, index) => (
              <li>
                <a class="ct-topic" href={`?topic=${encodeURIComponent(topic.value)}#contact-form`} data-topic={topic.value} data-help={topic.help}>
                  <span class="ct-topic__no" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <span class="ct-topic__body">
                    <span class="ct-topic__title">{topic.title}</span>
                    <span class="ct-topic__text">{topic.text}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>

        <form id="contact-form" class="ct-form hc-parchment" action="https://api.web3forms.com/submit" method="POST" aria-labelledby="ct-form-title">
          <input type="hidden" name="access_key" value="bc77362d-17bc-4833-a036-cf11648e0053" />
          <input type="hidden" name="subject" value="New HadithCritic contact message" />
          <input type="hidden" name="from_name" value="HadithCritic Contact Form" />

          <h2 id="ct-form-title" class="ct-form__title">Send a message</h2>

          <div class="ct-form__pair">
            <label class="ct-field">
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>
            <label class="ct-field">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
          </div>

          <label class="ct-field">
            <span>Topic</span>
            <select name="topic" required>
              <option value="">Choose a topic</option>
              {topics.map((topic) => <option value={topic.value}>{topic.title}</option>)}
            </select>
          </label>

          <label class="ct-field">
            <span>Message</span>
            <textarea name="message" rows="9" autocomplete="off" required aria-describedby="ct-help"></textarea>
          </label>
          <p class="ct-help" id="ct-help" aria-live="polite">Links to the page concerned make a message easier to answer.</p>

          <label class="ct-trap" aria-hidden="true">
            <span>Leave this field empty</span>
            <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
          </label>

          <div class="ct-form__foot">
            <button type="submit" class="hc-ink-btn ct-submit">Send message <span aria-hidden="true">→</span></button>
            <p class="ct-form__privacy">Sent through Web3Forms, so no email address is published in this page.</p>
          </div>
          <p id="contact-form-status" class="ct-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section class="hc-band ct-elsewhere" aria-labelledby="ct-elsewhere-title">
      <div class="hc-container">
        <p class="hc-rubric" id="ct-elsewhere-title">HadithCritic elsewhere <span>For public discussion and announcements</span></p>
        <ul class="ct-elsewhere__list">
          {elsewhere.map((place) => (
            <li>
              <a href={place.href} target="_blank" rel="noopener noreferrer" class="ct-place">
                <span class="ct-place__name">{place.name} <span aria-hidden="true">↗</span></span>
                <span class="ct-place__handle">{place.handle}</span>
                <span class="ct-place__note">{place.note}</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /* Without script the form posts straight to Web3Forms, and each topic is a
     plain link back to this page with ?topic= set. */
  interface Web3FormsResult {
    success?: boolean;
    message?: string;
  }

  function initContact(): void {
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const status = document.querySelector<HTMLParagraphElement>("#contact-form-status");
    const field = form?.elements.namedItem("topic");
    const select = field instanceof HTMLSelectElement ? field : null;
    const help = document.querySelector<HTMLElement>("#ct-help");
    if (!form || !status || !select || form.dataset.ready) return;
    form.dataset.ready = "1";

    const links = new Map(
      [...document.querySelectorAll<HTMLElement>("[data-topic]")].map((link) => [link.dataset.topic ?? "", link]),
    );
    const defaultHelp = help?.textContent ?? "";

    const choose = (topic: string | null | undefined): boolean => {
      const match = [...select.options].find((option) => option.value !== "" && option.value === topic);
      if (!match) return false;
      select.value = match.value;
      sync();
      return true;
    };

    const sync = (): void => {
      if (help) help.textContent = links.get(select.value)?.dataset.help || defaultHelp;
      for (const [topic, link] of links) link.classList.toggle("is-chosen", topic === select.value);
    };

    select.addEventListener("change", sync);
    choose(new URLSearchParams(location.search).get("topic"));

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const link of links.values()) {
      link.addEventListener("click", (event) => {
        if (!choose(link.dataset.topic)) return;
        event.preventDefault();
        history.replaceState(null, "", link.getAttribute("href"));
        form.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
        select.focus({ preventScroll: true });
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      status.className = "ct-status";
      status.textContent = "Sending your message…";
      if (submit) submit.disabled = true;
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const result = (await response.json().catch(() => ({}))) as Web3FormsResult;
        if (!response.ok || result.success === false) {
          throw new Error(result.message ?? "The message could not be sent. Please try again.");
        }
        form.reset();
        sync();
        status.classList.add("is-success");
        status.textContent = "Message sent. Thank you for writing.";
      } catch (error) {
        status.classList.add("is-error");
        status.textContent = error instanceof Error ? error.message : "The message could not be sent. Please try again.";
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContact, { once: true });
  } else {
    initContact();
  }
  document.addEventListener("astro:page-load", initContact);
</script>
