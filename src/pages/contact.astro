---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | HadithCritic">
  <main class="page-container">
    <section class="index-hero">
      <div class="hc-container">
        <h1 class="hc-title hc-title--xl">Contact</h1>
        <p class="hc-copy" style="max-width: 600px; font-size: 1.2rem; margin-top: 1rem; color: var(--hc-muted);">
          Get in touch for inquiries, collaborations, or feedback.
        </p>
      </div>
    </section>
    <section class="page-content hc-container" style="padding-bottom: 8rem;">
      <div style="margin-top: 4rem; max-width: 600px;">
        <h2 class="hc-title hc-title--md">Get in Touch</h2>
        <p class="hc-copy" style="margin-bottom: 2rem;">For questions, corrections, collaboration, or source submissions, please reach out via email or connect on social media.</p>
        <a href="mailto:contact@hadithcritic.com" class="hc-btn hc-btn--ghost" style="margin-bottom: 3rem;">Email Us <span aria-hidden="true">→</span></a>
        
        <h3 class="hc-title" style="font-size: 1.5rem; margin-bottom: 1rem;">Social & Platforms</h3>
        <ul style="list-style: none; padding: 0; display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <li><a href="https://twitter.com/hadithcritic" style="color: var(--hc-gold); text-decoration: none;">Twitter / X</a></li>
          <li><a href="https://youtube.com/hadithcritic" style="color: var(--hc-gold); text-decoration: none;">YouTube</a></li>
          <li><a href="https://discord.gg/hadithcritic" style="color: var(--hc-gold); text-decoration: none;">Discord</a></li>
          <li><a href="https://github.com/hadithcritic" style="color: var(--hc-gold); text-decoration: none;">GitHub</a></li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-container {
    min-height: 100vh;
    background: radial-gradient(circle at 100% 0%, rgba(216, 177, 102, 0.05), transparent 40%), var(--hc-black);
  }
  .index-hero {
    padding: 8rem 0 4rem;
    border-bottom: 1px solid var(--hc-rule);
    background: linear-gradient(180deg, rgba(15, 15, 16, 0.8), var(--hc-black));
  }
</style>
