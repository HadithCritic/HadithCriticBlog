---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
    <div class="container" style="padding-top: 100px; padding-bottom: 80px; min-height: 70vh;">
        <!-- Page Header -->
        <div style="text-align: center; margin-bottom: 4rem;">
            <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); background: linear-gradient(135deg, #fef08a 0%, #ca8a04 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 4px 12px rgba(202, 138, 4, 0.3)); margin-bottom: 1.25rem; line-height: 1.1; letter-spacing: -0.02em;">
                Contact & Community
            </h1>
            <p style="color: var(--text-body); font-size: 1.1rem; line-height: 1.8; max-width: 750px; margin: 0 auto; text-shadow: 0 2px 4px rgba(0,0,0,0.8);">
                For scholarly inquiries, collaborations, or discussion — fill out the form below or join our Discord community for real-time dialog and research exchange.
            </p>
        </div>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
            
            <!-- Contact Form Card -->
            <div style="background: var(--bg-panel); border: 1px solid var(--border); padding: 2.5rem; border-radius: var(--radius); box-shadow: var(--shadow-sm);">
                <h3 style="color: var(--blue-700); margin-bottom: 1.5rem; font-family: var(--font-display); font-size: 1.5rem; letter-spacing: 1px;">Send a Message</h3>
                <form action="https://formspree.io/f/mvgwwzky" method="POST" style="display: flex; flex-direction: column; gap: 1.2rem;">
                    <div>
                        <label for="name" style="display: block; margin-bottom: 0.5rem; color: var(--text-body); font-weight: 500; font-size: 0.9rem;">Name</label>
                        <input id="name" name="name" type="text" placeholder="Your full name" required style="width: 100%; padding: 12px; background: rgba(0,0,0,0.2); border: 1px solid var(--border); border-radius: 6px; color: var(--text-body); font-family: var(--font-sans); transition: all 0.2s;" onfocus="this.style.borderColor='var(--blue-500)'" onblur="this.style.borderColor='var(--border)'">
                    </div>
                    <div>
                        <label for="email" style="display: block; margin-bottom: 0.5rem; color: var(--text-body); font-weight: 500; font-size: 0.9rem;">Email</label>
                        <input id="email" name="_replyto" type="email" placeholder="name@example.com" required style="width: 100%; padding: 12px; background: rgba(0,0,0,0.2); border: 1px solid var(--border); border-radius: 6px; color: var(--text-body); font-family: var(--font-sans); transition: all 0.2s;" onfocus="this.style.borderColor='var(--blue-500)'" onblur="this.style.borderColor='var(--border)'">
                    </div>
                    <div>
                        <label for="message" style="display: block; margin-bottom: 0.5rem; color: var(--text-body); font-weight: 500; font-size: 0.9rem;">Message</label>
                        <textarea id="message" name="message" rows="5" placeholder="Your message or question" required style="width: 100%; padding: 12px; background: rgba(0,0,0,0.2); border: 1px solid var(--border); border-radius: 6px; color: var(--text-body); font-family: var(--font-sans); transition: all 0.2s; resize: vertical;" onfocus="this.style.borderColor='var(--blue-500)'" onblur="this.style.borderColor='var(--border)'"></textarea>
                    </div>
                    <button class="btn btn-primary" type="submit" style="margin-top: 0.5rem; width: 100%;">
                        <i class="fas fa-paper-plane"></i> Send Message
                    </button>
                </form>
            </div>

            <!-- Right Side Column (Connect & Socials) -->
            <div style="display: flex; flex-direction: column; gap: 2rem;">
                <!-- Connect Card -->
                <div style="background: var(--bg-panel); border: 1px solid var(--border); padding: 2.5rem; border-radius: var(--radius); box-shadow: var(--shadow-sm);">
                    <h3 style="color: var(--blue-700); margin-bottom: 1.5rem; font-family: var(--font-display); font-size: 1.5rem; letter-spacing: 1px;">Connect</h3>
                    <div style="display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 8px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-strong); color: var(--text-muted); font-weight: 500;">
                        <i class="fas fa-envelope" style="font-size: 1.2rem; color: var(--blue-500);"></i>
                        <span style="font-family: var(--font-mono); font-size: 0.9rem; letter-spacing: 0.5px;">HadithCritic [at] gmail [dot] com</span>
                    </div>
                </div>

                <!-- Socials & More Card -->
                <div style="background: var(--bg-panel); border: 1px solid var(--border); padding: 2.5rem; border-radius: var(--radius); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; flex: 1;">
                    <h3 style="color: var(--blue-700); margin-bottom: 1.5rem; font-family: var(--font-display); font-size: 1.5rem; letter-spacing: 1px;">Socials & More</h3>
                    <div style="display: flex; flex-direction: column; gap: 1rem; height: 100%;">
                        <a href="https://www.youtube.com/@HadithCritic" target="_blank" style="display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 8px; text-decoration: none; background: rgba(255,0,0,0.05); border: 1px solid rgba(255,0,0,0.2); color: var(--text-body); font-weight: 500; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(255,0,0,0.1)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
                            <i class="fab fa-youtube" style="font-size: 1.2rem; color: #ff0000;"></i>
                            YouTube — HadithCritic
                        </a>
                        
                        <a href="https://x.com/HadithCritic" target="_blank" style="display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 8px; text-decoration: none; background: rgba(255,255,255,0.03); border: 1px solid var(--border-strong); color: var(--text-body); font-weight: 500; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='var(--shadow-sm)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
                            <i class="fab fa-x-twitter" style="font-size: 1.2rem; color: var(--text-heading);"></i>
                            𝕏 / Twitter — @HadithCritic
                        </a>

                        <a href="https://github.com/HadithCritic" target="_blank" style="display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 8px; text-decoration: none; background: rgba(255,255,255,0.03); border: 1px solid var(--border-strong); color: var(--text-body); font-weight: 500; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='var(--shadow-sm)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
                            <i class="fab fa-github" style="font-size: 1.2rem; color: var(--text-heading);"></i>
                            GitHub — HadithCritic
                        </a>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</BaseLayout>
