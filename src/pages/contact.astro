---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | HadithCritic">
  <main class="contact-page">
    <section class="contact-hero">
      <div class="hc-container contact-hero__inner">
        <h1 class="hc-title hc-title--xl">Contact</h1>
        <p class="hc-copy contact-hero__lead">
          Send questions, corrections, collaboration notes, or source submissions without
          exposing a public inbox address to scraping bots.
        </p>
      </div>
    </section>

    <section class="contact-body hc-container" aria-labelledby="contact-form-title">
      <div class="contact-grid">
        <div class="contact-copy">
          <h2 id="contact-form-title" class="hc-title hc-title--md">Send an inquiry</h2>
          <p class="hc-copy">
            Use the form for source notes, article corrections, research collaboration, or
            questions about published material.
          </p>

          <div class="contact-note" aria-label="Contact privacy note">
            <strong>Private by design</strong>
            <p>
              Messages are sent through a form backend, so the receiving address is not printed
              into the page source.
            </p>
          </div>

          <div class="contact-platforms">
            <h3>Social &amp; Platforms</h3>
            <div class="contact-social">
              <a href="https://x.com/HadithCritic" aria-label="X (Twitter)">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
              </a>
              <a href="https://www.youtube.com/@HadithCritic" aria-label="YouTube">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.015 3.015 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93-.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
              <a href="https://discord.gg/SubmissionServer" aria-label="Discord">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
              </a>
              <a href="https://github.com/HadithCritic/HadithCriticBlog" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <form
          id="contact-form"
          class="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value="bc77362d-17bc-4833-a036-cf11648e0053" />
          <input type="hidden" name="subject" value="New HadithCritic contact inquiry" />
          <input type="hidden" name="from_name" value="HadithCritic Contact Form" />

          <label class="contact-field">
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>

          <label class="contact-field">
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <label class="contact-field">
            <span>Topic</span>
            <select name="topic" required>
              <option value="">Choose a topic</option>
              <option value="Article correction">Article correction</option>
              <option value="Source submission">Source submission</option>
              <option value="Research collaboration">Research collaboration</option>
              <option value="General inquiry">General inquiry</option>
            </select>
          </label>

          <label class="contact-field">
            <span>Message</span>
            <textarea name="message" rows="8" required></textarea>
          </label>

          <label class="contact-trap" aria-hidden="true">
            <span>Leave this field empty</span>
            <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
          </label>

          <button type="submit" class="hc-btn contact-submit">
            Send inquiry <span aria-hidden="true">&rarr;</span>
          </button>

          <p id="contact-form-status" class="contact-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#contact-form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const formData = new FormData(form);

    status.className = 'contact-status';
    status.textContent = 'Sending inquiry...';
    if (submit) submit.disabled = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' },
      });
      const result: any = await response.json().catch(() => ({}));

      if (!response.ok || result.success === false) {
        throw new Error(result.message || 'The message could not be sent.');
      }

      form.reset();
      status.classList.add('is-success');
      status.textContent = 'Inquiry sent. Thank you.';
    } catch (error) {
      status.classList.add('is-error');
      status.textContent =
        error instanceof Error ? error.message : 'The message could not be sent.';
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>

<style>
  .contact-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 100% 0%, rgba(216, 177, 102, 0.06), transparent 38%),
      linear-gradient(180deg, rgba(15, 15, 16, 0.96), var(--hc-black));
  }

  .contact-hero {
    padding: clamp(6rem, 9vw, 8rem) 0 clamp(3rem, 5vw, 4.25rem);
    border-bottom: 1px solid var(--hc-rule);
    background: linear-gradient(180deg, rgba(15, 15, 16, 0.8), var(--hc-black));
  }

  .contact-hero__lead {
    max-width: 680px;
    margin: 1rem 0 0;
    color: var(--hc-muted);
    font-size: clamp(1.08rem, 0.55vw + 1rem, 1.25rem);
  }

  .contact-body {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(5rem, 9vw, 8rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(360px, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .contact-copy {
    max-width: 600px;
  }

  .contact-copy .hc-copy {
    margin: 1rem 0 0;
  }

  .contact-note {
    margin-top: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    background: rgba(216, 177, 102, 0.06);
  }

  .contact-note strong {
    display: block;
    color: var(--hc-gold-soft);
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }

  .contact-note p {
    margin: 0.45rem 0 0;
    color: var(--hc-muted);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .contact-platforms {
    margin-top: 2.5rem;
  }

  .contact-platforms h3 {
    margin: 0 0 1rem;
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
  }

  .contact-social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .contact-social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(216, 177, 102, 0.28);
    border-radius: var(--radius-sm);
    color: var(--hc-gold-dim);
    background: rgba(15, 15, 16, 0.4);
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms var(--ease, ease);
  }

  .contact-social a:hover {
    border-color: rgba(216, 177, 102, 0.58);
    color: var(--hc-gold);
    background: rgba(216, 177, 102, 0.1);
    transform: translateY(-2px);
  }

  .contact-form {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.78), rgba(20, 19, 18, 0.94));
    box-shadow: var(--shadow);
  }

  .contact-field {
    display: grid;
    gap: 0.45rem;
  }

  .contact-field span {
    color: var(--hc-gold-soft);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .contact-field input,
  .contact-field select,
  .contact-field textarea {
    width: 100%;
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-sm);
    color: var(--hc-parchment);
    background: rgba(15, 15, 16, 0.72);
    padding: 0.82rem 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.94rem;
  }

  .contact-field textarea {
    resize: vertical;
    min-height: 190px;
    line-height: 1.6;
  }

  .contact-field input:focus,
  .contact-field select:focus,
  .contact-field textarea:focus {
    border-color: var(--hc-gold-dim);
    outline: none;
  }

  .contact-field select {
    color-scheme: dark;
  }

  .contact-trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-submit {
    width: fit-content;
    margin-top: 0.25rem;
  }

  .contact-submit:disabled {
    cursor: wait;
    opacity: 0.62;
    transform: none;
  }

  .contact-status {
    min-height: 1.4rem;
    margin: 0;
    color: var(--hc-muted);
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }

  .contact-status.is-success {
    color: var(--hc-gold-soft);
  }

  .contact-status.is-error {
    color: #e8a092;
  }

  @media (max-width: 920px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .contact-hero {
      padding: 4rem 0 2.5rem;
    }

    .contact-hero .hc-title--xl {
      font-size: clamp(2.7rem, 14vw, 3.6rem);
      line-height: 1.03;
    }

    .contact-hero__lead {
      font-size: 1rem;
      line-height: 1.65;
    }

    .contact-body {
      padding-block: 2.75rem 4.5rem;
    }

    .contact-note {
      padding: 1rem;
    }

    .contact-form {
      padding: 1rem;
    }

    .contact-field input,
    .contact-field select {
      min-height: 46px;
    }

    .contact-submit {
      width: 100%;
    }
  }
</style>
