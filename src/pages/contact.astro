---
import BaseLayout from "../layouts/BaseLayout.astro";

const stages = ["Inquiry logged", "Editorial review", "Response dispatched"];

/* Values match the form's <select> options exactly, so a row can preselect it. */
const topics = [
  { value: "Article correction", note: "Against a published study" },
  { value: "Source submission", note: "A source for the desk" },
  { value: "Research collaboration", note: "Joint work on source history" },
  { value: "General inquiry", note: "Anything else" },
];
---

<BaseLayout
  title="Contact | HadithCritic"
  description="Send research inquiries, source submissions, manuscript corrections, and editorial correspondence to the HadithCritic analysis desk."
>
  <div class="ct-page">
    <div class="ct-progress" id="ct-progress" aria-hidden="true"></div>

    <header class="hc-masthead" id="hero" aria-labelledby="ct-hero-title">
      <div class="hc-container hc-masthead__inner">
        <div>
          <p class="hc-eyebrow">Editorial correspondence</p>
          <h1 id="ct-hero-title" class="hc-masthead__title">Write to the Editorial Desk</h1>
          <p class="hc-masthead__lead">
            Send research inquiries, source submissions, manuscript corrections, or
            correspondence directly to our editorial and analysis team.
          </p>
        </div>

        <aside class="hc-instrument ct-docket" aria-label="How an inquiry is handled">
          <div class="hc-instrument__well">
            <ol class="hc-instrument__plate ct-docket__plate" aria-label="Review procedure">
              {stages.map((stage, index) => (
                <li class="ct-docket__stage">
                  <span class="ct-docket__no" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <span class="ct-docket__label">{stage}</span>
                </li>
              ))}
            </ol>

            <p class="hc-instrument__cap" id="ct-docket-cap">File under</p>
            <ul class="ct-docket__topics" aria-labelledby="ct-docket-cap">
              {topics.map((topic) => (
                <li>
                  <a
                    class="ct-docket__topic"
                    href={`?topic=${encodeURIComponent(topic.value)}#contact-form`}
                    data-topic={topic.value}
                  >
                    <span class="ct-docket__topic-name">{topic.value}</span>
                    <span class="ct-docket__topic-note">{topic.note}</span>
                    <span class="ct-docket__go" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════
         CORRESPONDENCE BODY — guidance + submission dossier
         ═══════════════════════════════════════════ -->
    <section class="ct-body" aria-labelledby="ct-form-title">
      <div class="hc-container">
        <div class="ct-section-head">
          <p class="hc-eyebrow">§ I — Submit an Inquiry</p>
          <h2 id="ct-form-title">The Correspondence Ledger</h2>
          <p>
            Use the form for source notes, article corrections, research collaboration, or
            questions about published material. Every inquiry enters the review protocol above.
          </p>
        </div>

        <div class="ct-grid">
          <!-- Guidance column -->
          <div class="ct-copy">
            <div class="ct-note" aria-label="Contact privacy note">
              <p class="ct-note__label">Apparatus Note</p>
              <strong>Private by design</strong>
              <p>
                Messages are sent through a form backend, so the receiving address is not
                printed into the page source.
              </p>
            </div>

            <div class="ct-guidance">
              <h3>What strengthens an inquiry</h3>
              <ul class="ct-guidance__list">
                <li>
                  <span class="ct-guidance__no" aria-hidden="true">§</span>
                  <div>
                    <strong>Cite the article URL</strong>
                    <p>Anchor the discussion to the exact published study under review.</p>
                  </div>
                </li>
                <li>
                  <span class="ct-guidance__no" aria-hidden="true">§</span>
                  <div>
                    <strong>Quote the passage precisely</strong>
                    <p>Reproduce the report, isnād, or argument as printed — corrections are filed against the text, not a paraphrase.</p>
                  </div>
                </li>
                <li>
                  <span class="ct-guidance__no" aria-hidden="true">§</span>
                  <div>
                    <strong>Name the source edition</strong>
                    <p>Manuscript shelfmarks, print editions, and page numbers let the desk verify claims against the same evidence.</p>
                  </div>
                </li>
              </ul>
            </div>

            <div class="ct-platforms">
              <h3>Social &amp; Platforms</h3>
              <div class="ct-social">
                <a href="https://x.com/HadithCritic" aria-label="X (Twitter)">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
                </a>
                <a href="https://www.youtube.com/@HadithCritic" aria-label="YouTube">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.015 3.015 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93-.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                </a>
                <a href="https://discord.gg/SubmissionServer" aria-label="Discord">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                </a>
                <a href="https://github.com/HadithCritic/HadithCriticBlog" aria-label="GitHub">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Submission dossier form -->
          <form
            id="contact-form"
            class="ct-form"
            action="https://api.web3forms.com/submit"
            method="POST"
          >
            <input type="hidden" name="access_key" value="bc77362d-17bc-4833-a036-cf11648e0053" />
            <input type="hidden" name="subject" value="New HadithCritic contact inquiry" />
            <input type="hidden" name="from_name" value="HadithCritic Contact Form" />

            <p class="ct-form__label">Submission Dossier</p>

            <label class="ct-field">
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>

            <label class="ct-field">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>

            <label class="ct-field">
              <span>Topic</span>
              <select name="topic" required>
                <option value="">Choose a topic</option>
                <option value="Article correction">Article correction</option>
                <option value="Source submission">Source submission</option>
                <option value="Research collaboration">Research collaboration</option>
                <option value="General inquiry">General inquiry</option>
              </select>
            </label>

            <label class="ct-field">
              <span>Message</span>
              <textarea name="message" rows="8" autocomplete="off" required></textarea>
            </label>

            <label class="ct-trap" aria-hidden="true">
              <span>Leave this field empty</span>
              <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
            </label>

            <button type="submit" class="hc-btn ct-submit">
              <span>Send inquiry</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </button>

            <p id="contact-form-status" class="ct-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SECTION DIVIDER
         ═══════════════════════════════════════════ -->
    <div class="ct-divider" aria-hidden="true">
      <span class="ct-divider__rule"></span>
      <svg class="ct-divider__emblem" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 6v12M6 12h12"></path>
      </svg>
      <span class="ct-divider__rule"></span>
    </div>
  </div>
</BaseLayout>

<script>
  /* ── Scroll progress hairline ── */
  const setupProgress = () => {
    const progress = document.querySelector<HTMLElement>("#ct-progress");
    if (!progress) return;

    let ticking = false;

    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight || 1;
      progress.style.transform = `scaleX(${Math.min(window.scrollY / max, 1)})`;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );

    update();
  };

  /* ── Submission dossier — async form handling via Web3Forms ── */
  const setupContactForm = () => {
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const status = document.querySelector<HTMLParagraphElement>("#contact-form-status");
    if (!form || !status) return;

    interface Web3FormsResult {
      success?: boolean;
      message?: string;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const formData = new FormData(form);

      status.className = "ct-status";
      status.textContent = "Sending inquiry...";
      if (submit) submit.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        const result = (await response.json().catch(() => ({}))) as Web3FormsResult;

        if (!response.ok || result.success === false) {
          throw new Error(result.message ?? "The message could not be sent.");
        }

        form.reset();
        status.classList.add("is-success");
        status.textContent = "Inquiry sent. Thank you — the desk will respond in due course.";
      } catch (error) {
        status.classList.add("is-error");
        status.textContent =
          error instanceof Error ? error.message : "The message could not be sent.";
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  };

  /* ── Topic index: a row preselects the form's topic. Without script the
        row is a plain link that jumps to the form. ── */
  const setupTopics = () => {
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const field = form?.elements.namedItem("topic");
    const select = field instanceof HTMLSelectElement ? field : null;
    if (!form || !select) return;

    const choose = (topic: string | null | undefined): boolean => {
      const match = [...select.options].find((option) => option.value !== "" && option.value === topic);
      if (!match) return false;
      select.value = match.value;
      return true;
    };

    choose(new URLSearchParams(location.search).get("topic"));

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-topic]")) {
      link.addEventListener("click", (event) => {
        if (!choose(link.dataset.topic)) return;
        event.preventDefault();
        history.replaceState(null, "", link.getAttribute("href"));
        form.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
        select.focus({ preventScroll: true });
      });
    }
  };

  const init = () => {
    setupProgress();
    setupContactForm();
    setupTopics();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
</script>

<style>
  /* ─────────────────────────────────────────────
     CONTACT · Design System V2.4
     Dark manuscript ground · antique-gold voltage
     Correspondence ledger · apparatus notes · dossier form
     ───────────────────────────────────────────── */

  .ct-page {
    position: relative;
    min-height: 100vh;
    color: var(--hc-text-primary);
    background-color: var(--hc-surface-0);
  }

  .ct-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--hc-gold);
    transform-origin: 0 50%;
    transform: scaleX(0);
    z-index: 100;
    pointer-events: none;
    transition: transform 120ms ease-out;
  }

  /* ═══════════════════════════════════════════
     SECTION DIVIDER WITH EMBLEM
     ═══════════════════════════════════════════ */
  .ct-divider {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: var(--wrap, 1240px);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
    color: var(--hc-gold-dim);
  }

  .ct-divider__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hc-rule) 20%, var(--hc-rule) 80%, transparent);
  }

  .ct-divider__emblem {
    flex-shrink: 0;
    opacity: 0.8;
  }

  /* ═══════════════════════════════════════════
     HERO: the review docket and topic index.
     Shell (masthead, tray, well, plate) is shared in global.css.
     ═══════════════════════════════════════════ */
  .ct-docket__plate {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 1.1rem 0;
    list-style: none;
  }

  .ct-docket__stage {
    display: grid;
    align-content: space-between;
    gap: 0.7rem;
    padding: 0 1.1rem;
  }

  .ct-docket__stage + .ct-docket__stage {
    border-left: 1px dashed rgba(26, 23, 21, 0.4);
  }

  .ct-docket__no {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 2.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .ct-docket__label {
    font: 700 0.81rem/1.35 var(--font-ui);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ct-docket__topics {
    margin: 0;
    padding: 0 0.4rem 0.4rem;
    list-style: none;
  }

  .ct-docket__topics li + li {
    border-top: 1px solid var(--hc-rule-soft);
  }

  .ct-docket__topic {
    display: grid;
    grid-template-columns: minmax(0, 12.5rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 1rem;
    min-height: 44px;
    padding: 0.8rem 0.6rem;
    margin-inline: -0.6rem;
    color: inherit;
    text-decoration: none;
    transition: background var(--motion-base) var(--ease-standard), box-shadow var(--motion-base) var(--ease-standard);
  }

  .ct-docket__topic:hover {
    background: rgba(216, 177, 102, 0.08);
    box-shadow: inset 2px 0 0 var(--hc-gold-dim);
  }

  .ct-docket__topic-name {
    color: var(--hc-text-primary);
    font: 600 1.02rem/1.35 var(--font-display);
    letter-spacing: -0.015em;
  }

  .ct-docket__topic-note {
    color: var(--hc-text-secondary);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    .ct-docket__topic {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .ct-docket__topic-note {
      grid-column: 1;
      grid-row: 2;
    }

    .ct-docket__go {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  .ct-docket__go {
    color: var(--hc-gold-dim);
    transition: transform var(--motion-base) var(--ease-standard), color var(--motion-base) ease;
  }

  .ct-docket__topic:hover .ct-docket__go {
    color: var(--hc-gold);
    transform: translateX(3px);
  }

  .ct-form {
    scroll-margin-top: 5.5rem;
  }

  @media (max-width: 520px) {
    .ct-docket__plate {
      grid-template-columns: minmax(0, 1fr);
      padding: 0.35rem 0;
    }

    .ct-docket__stage {
      grid-template-columns: 2.6rem minmax(0, 1fr);
      align-items: baseline;
      gap: 1rem;
      padding: 0.7rem 1.1rem;
    }

    .ct-docket__stage + .ct-docket__stage {
      border-top: 1px dashed rgba(26, 23, 21, 0.4);
      border-left: 0;
    }

    .ct-docket__no {
      font-size: 1.7rem;
    }
  }

  /* ═══════════════════════════════════════════
     SECTION HEADER
     ═══════════════════════════════════════════ */
  .ct-section-head {
    margin-bottom: 2.25rem;
  }

  .ct-section-head h2 {
    margin: 0.4rem 0 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.2vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--hc-text-primary);
  }

  .ct-section-head p:not(.hc-eyebrow) {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.62;
    color: var(--hc-text-secondary);
    max-width: 40rem;
  }

  /* ═══════════════════════════════════════════
     CORRESPONDENCE BODY
     ═══════════════════════════════════════════ */
  .ct-body {
    padding-block: 3.5rem 5rem;
    background:
      radial-gradient(ellipse 900px 380px at 50% 0%, rgba(216, 177, 102, 0.04) 0%, transparent 70%),
      var(--hc-surface-0);
  }

  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (max-width: 920px) {
    .ct-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Apparatus note — privacy */
  .ct-note {
    position: relative;
    margin-bottom: 2.5rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs, 2px);
    background: rgba(216, 177, 102, 0.06);
  }

  .ct-note::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    outline: 1px solid var(--hc-rule-soft);
    outline-offset: -5px;
    pointer-events: none;
  }

  .ct-note__label {
    margin: 0 0 0.6rem;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--hc-gold-dim);
  }

  .ct-note strong {
    display: block;
    color: var(--hc-gold-soft);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .ct-note p {
    margin: 0.5rem 0 0;
    color: var(--hc-text-secondary);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  /* Guidance list */
  .ct-guidance {
    margin-bottom: 2.5rem;
  }

  .ct-guidance h3,
  .ct-platforms h3 {
    margin: 0 0 1.1rem;
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .ct-guidance__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .ct-guidance__list li {
    display: flex;
    gap: 0.9rem;
    padding: 1.05rem 0.15rem;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .ct-guidance__no {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--hc-gold-dim);
    padding-top: 0.1rem;
  }

