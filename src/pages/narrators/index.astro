    position: relative;
    z-index: 1;
    max-width: 960px;
  }

  .narrators-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.28rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgba(216, 177, 102, 0.1);
    border: 1px solid var(--hc-rule);
