  }

  .preset-btn.is-active {
    background: var(--hc-gold);
    color: var(--hc-fixed-black);
    border-color: var(--hc-gold);
    font-weight: 600;
  }

  /* Explorer Section */
  .narrators-explorer {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  /* Toolbar */
  .explorer-toolbar {
    background: linear-gradient(135deg, var(--hc-surface-1), var(--hc-surface-0));
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    padding: 1.5rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);
    margin-bottom: 2rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    margin-bottom: 1.25rem;
  }

  .search-box__icon {
    position: absolute;
    left: 1rem;
    color: var(--hc-gold);
    pointer-events: none;
    display: flex;
  }

  .search-box__input {
    width: 100%;
    height: 52px;
    padding: 0 3.2rem 0 3rem;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    color: var(--hc-text-primary);
    font-family: var(--font-ui);
    font-size: 1rem;
    outline: none;
    transition: all 200ms ease;
  }

  .search-box__input:focus {
    border-color: var(--hc-gold);
    box-shadow: 0 0 0 3px rgba(216, 177, 102, 0.2);
  }

  .search-box__clear {
    position: absolute;
    right: 3.2rem;
    background: none;
    border: none;
    color: var(--hc-text-tertiary);
    font-size: 1.4rem;
    cursor: pointer;
    padding: 0 0.5rem;
    line-height: 1;
  }

  .search-box__clear:hover {
    color: var(--hc-text-primary);
  }

  .search-box__kbd {
    position: absolute;
    right: 1rem;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--hc-surface-3);
    border: 1px solid var(--hc-rule-soft);
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    pointer-events: none;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem;
  }

  .filter-group {
    flex: 1;
    min-width: 160px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .filter-label {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .filter-select {
    height: 40px;
    padding: 0 0.85rem;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    color: var(--hc-text-primary);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    outline: none;
    cursor: pointer;
    transition: border-color 200ms ease;
  }

  .filter-select:focus {
    border-color: var(--hc-gold);
  }

  .filter-select--sm {
    height: 32px;
    font-size: 0.8rem;
    padding: 0 0.5rem;
  }

  .view-toggle {
    display: flex;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    overflow: hidden;
    height: 40px;
  }

  .view-toggle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    background: none;
    border: none;
    color: var(--hc-text-tertiary);
    cursor: pointer;
    transition: all 200ms ease;
  }

  .view-toggle__btn:hover {
    color: var(--hc-text-primary);
  }

  .view-toggle__btn.is-active {
    background: var(--hc-gold);
    color: var(--hc-fixed-black);
  }

  /* Active Filter Bar */
  .active-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .active-bar__label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
  }

  .active-bar__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .active-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: rgba(216, 177, 102, 0.12);
    border: 1px solid var(--hc-rule);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    cursor: pointer;
    transition: all 150ms ease;
  }

  .active-chip:hover {
    background: rgba(216, 177, 102, 0.22);
  }

  .active-chip__remove {
    font-size: 1rem;
    line-height: 1;
  }

  .active-bar__reset {
    margin-left: auto;
    background: none;
    border: none;
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    text-decoration: underline;
    cursor: pointer;
  }

  .active-bar__reset:hover {
    color: var(--hc-gold);
  }

  /* Results Header */
  .results-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
  }

  .results-head__count {
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 500;
  }

  .results-head__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .compare-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-xs);
    background: rgba(216, 177, 102, 0.15);
    border: 1px solid var(--hc-gold);
    color: var(--hc-gold-bright);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .compare-trigger-btn:hover {
    background: var(--hc-gold);
    color: var(--hc-fixed-black);
  }

  .results-head__per-page {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.8rem;
  }

  /* Loading State */
  .explorer-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 1rem;
    gap: 1rem;
    color: var(--hc-text-secondary);
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid var(--hc-rule-soft);
    border-top-color: var(--hc-gold);
    border-radius: 50%;
    animation: spin 800ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Table View */
  .table-container {
    overflow-x: auto;
    background: linear-gradient(180deg, var(--hc-surface-1), var(--hc-surface-0));
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.15);
  }

  .narrators-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    text-align: left;
  }

  .narrators-table th {
    padding: 0.95rem 1.1rem;
    color: var(--hc-text-tertiary);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--hc-rule);
    background: var(--hc-surface-2);
    white-space: nowrap;
  }

  .narrators-table td {
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    vertical-align: middle;
  }

  .table-row {
    transition: background 180ms ease;
    cursor: pointer;
  }

  .table-row:hover {
    background: rgba(216, 177, 102, 0.05);
  }

  .table-row.is-in-compare {
    background: rgba(216, 177, 102, 0.09);
  }

  .col-check { width: 50px; text-align: center; }
  .col-id { width: 70px; }
  .col-name { min-width: 240px; }
  .col-gen { width: 170px; }
  .col-grade { width: 160px; }
  .col-death { width: 140px; }
  .col-stay { max-width: 180px; }
  .col-network { width: 110px; }
  .col-action { width: 90px; text-align: right; }

  .compare-toggle-btn {
    width: 26px;
    height: 26px;
    border-radius: 4px;
    border: 1px solid var(--hc-rule);
    background: var(--hc-surface-2);
    color: var(--hc-text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 150ms ease;
  }

  .compare-toggle-btn:hover {
    border-color: var(--hc-gold);
    color: var(--hc-gold);
  }

  .compare-toggle-btn.is-selected {
    background: var(--hc-gold);
    color: var(--hc-fixed-black);
    border-color: var(--hc-gold);
  }

  .id-tag {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--hc-surface-3);
    color: var(--hc-gold-dim);
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .name-box {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .name-en {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--hc-text-primary);
    line-height: 1.25;
  }

  .name-ar {
    font-family: var(--font-arabic);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--hc-parchment-deep);
    line-height: 1.75;
    direction: rtl;
    font-feature-settings: "cv01" on, "calt" on;
    text-rendering: optimizeLegibility;
  }

  .gen-tag {
    color: var(--hc-text-secondary);
    font-size: 0.82rem;
  }

  .meta-val {
    color: var(--hc-text-secondary);
    font-size: 0.82rem;
  }

  .meta-val--truncate {
    display: inline-block;
    max-width: 170px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .network-counts {
    display: flex;
    gap: 0.4rem;
  }

  .count-pill {
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule-soft);
    color: var(--hc-text-secondary);
    font-size: 0.72rem;
  }

  .row-inspect-btn {
    background: none;
    border: 1px solid var(--hc-rule-soft);
    border-radius: 4px;
    color: var(--hc-gold);
    padding: 0.3rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 180ms ease;
    white-space: nowrap;
  }

  .row-inspect-btn:hover {
    background: var(--hc-gold);
    color: var(--hc-fixed-black);
    border-color: var(--hc-gold);
  }

  /* Reliability Badges */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .badge-thiqah {
    background: rgba(59, 130, 84, 0.15);
    color: #48bb78;
    border: 1px solid rgba(72, 187, 120, 0.3);
  }

  .badge-sadooq {
    background: rgba(66, 153, 225, 0.15);
    color: #63b3ed;
    border: 1px solid rgba(99, 179, 237, 0.3);
  }

  .badge-maqbool {
    background: rgba(214, 158, 46, 0.15);
    color: #ecc94b;
    border: 1px solid rgba(236, 201, 75, 0.3);
  }

  .badge-daif {
    background: rgba(229, 62, 62, 0.15);
    color: #fc8181;
    border: 1px solid rgba(252, 129, 129, 0.3);
  }

  .badge-matrook {
    background: rgba(155, 44, 44, 0.2);
    color: #feb2b2;
    border: 1px solid rgba(254, 178, 178, 0.3);
  }

  .badge-sahabi {
    background: rgba(216, 177, 102, 0.15);
    color: var(--hc-gold-bright);
    border: 1px solid rgba(216, 177, 102, 0.35);
  }

  .badge-default {
    background: var(--hc-surface-2);
    color: var(--hc-text-secondary);
    border: 1px solid var(--hc-rule-soft);
  }

  /* Grid View */
  .narrators-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .rawi-card {
    background: linear-gradient(180deg, var(--hc-surface-1), var(--hc-surface-0));
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: transform 200ms ease, border-color 200ms ease;
  }

  .rawi-card:hover {
    transform: translateY(-3px);
    border-color: var(--hc-gold);
  }

  .rawi-card.is-in-compare {
    border-color: var(--hc-gold-bright);
    background: linear-gradient(180deg, rgba(216, 177, 102, 0.1), var(--hc-surface-0));
  }

  .rawi-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-name-en {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--hc-text-primary);
    line-height: 1.22;
  }

  .card-name-ar {
    margin: 0.35rem 0 0;
    font-family: var(--font-arabic);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--hc-gold-soft);
    line-height: 1.7;
    direction: rtl;
    font-feature-settings: "cv01" on, "calt" on;
    text-rendering: optimizeLegibility;
  }

  .rawi-card__meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--hc-rule-soft);
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .meta-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
  }

  .meta-label {
    color: var(--hc-text-tertiary);
  }

  .meta-text {
    color: var(--hc-text-secondary);
    font-weight: 500;
  }

  .rawi-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .card-link {
    color: var(--hc-gold);
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 4.5rem 1rem;
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
  }

  .empty-state__icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .empty-state__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--hc-text-primary);
  }

  .empty-state__desc {
    max-width: 440px;
    margin: 0.6rem auto 1.5rem;
    font-family: var(--font-body);
    color: var(--hc-text-secondary);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  /* Pagination Bar */
  .pagination-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2rem;
    padding: 1rem 0;
  }

  .pagination-btn {
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    color: var(--hc-text-primary);
    padding: 0.55rem 1.1rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .pagination-btn:hover:not(:disabled) {
    background: var(--hc-gold);
    color: var(--hc-fixed-black);
    border-color: var(--hc-gold);
  }

  .pagination-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pagination-info {
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.88rem;
  }

  /* Persistent Bottom Comparison Dock */
  .comparison-dock {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 900;
    width: min(920px, calc(100% - 2rem));
    background: rgba(20, 20, 22, 0.94);
    backdrop-filter: blur(10px);
    border: 1px solid var(--hc-gold);
    border-radius: var(--radius-xs);
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.55);
    animation: dockRise 250ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes dockRise {
    from { opacity: 0; transform: translate(-50%, 20px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  .comparison-dock__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    gap: 1rem;
  }

  .comparison-dock__info {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .comparison-dock__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--hc-gold);
  }

  .comparison-dock__slots {
    font-family: var(--font-ui);
    font-size: 0.76rem;
    color: var(--hc-text-tertiary);
  }

  .comparison-dock__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  .dock-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule-soft);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--hc-text-primary);
  }

  .dock-chip__id {
    color: var(--hc-gold);
    font-family: monospace;
    font-size: 0.72rem;
  }

  .dock-chip__remove {
    background: none;
    border: none;
    color: var(--hc-text-tertiary);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
  }

  .dock-chip__remove:hover {
    color: #fc8181;
  }

  .comparison-dock__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dock-btn {
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-xs);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .dock-btn--primary {
    background: var(--hc-gold);
    color: var(--hc-fixed-black);
    border: 1px solid var(--hc-gold);
  }

  .dock-btn--primary:hover {
    background: var(--hc-gold-bright);
  }

  .dock-btn--ghost {
    background: none;
    border: 1px solid var(--hc-rule-soft);
    color: var(--hc-text-tertiary);
  }

  .dock-btn--ghost:hover {
    color: var(--hc-text-primary);
    border-color: var(--hc-rule);
  }

  /* Side-by-Side Comparison Workspace Modal */
  .compare-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
  }

  .compare-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .compare-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(6px);
  }

  .compare-panel {
    position: relative;
    z-index: 1;
    width: min(1380px, calc(100% - 2.5rem));
    height: calc(100% - 3rem);
    background: var(--hc-surface-0);
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .compare-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.4rem 1.8rem;
    background: linear-gradient(180deg, var(--hc-surface-1), var(--hc-surface-0));
    border-bottom: 1px solid var(--hc-rule);
  }

  .compare-header__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--hc-gold);
  }

  .compare-header__subtitle {
    margin: 0.25rem 0 0;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.82rem;
  }

  .compare-header__actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  /* Overlap Analytics Banner */
  .overlap-banner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 1rem 1.8rem;
    background: var(--hc-surface-1);
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .overlap-card {
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-xs);
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .overlap-card__title {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .overlap-card__body {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    max-height: 80px;
    overflow-y: auto;
  }

  .overlap-empty {
    color: var(--hc-text-tertiary);
    font-size: 0.78rem;
    font-style: italic;
  }

  .overlap-text {
    color: var(--hc-text-secondary);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  /* Multi-Column Comparison Grid */
  .compare-grid {
    flex: 1;
    display: grid;
