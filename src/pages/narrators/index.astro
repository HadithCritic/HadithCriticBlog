    border-radius: var(--radius-xs);
    overflow-x: auto;
  }

  .presets-bar__label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--hc-gold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .presets-bar__scroll {
    display: flex;
    gap: 0.5rem;
    flex-wrap: nowrap;
  }

  .preset-btn {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-rule-soft);
