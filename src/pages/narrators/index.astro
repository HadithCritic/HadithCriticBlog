    line-height: 1.76;
  }

  .narrators-hero__lead strong {
    color: var(--hc-parchment);
    font-weight: 600;
  }

  /* Stats Grid */
  .narrators-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .stat-card {
    padding: 1.2rem 1.4rem;
    background: linear-gradient(180deg, var(--hc-surface-1), var(--hc-surface-0));
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-xs);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .stat-card__number {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-weight: 600;
    color: var(--hc-gold);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-card__label {
    display: block;
    margin-top: 0.4rem;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Research Presets Bar */
  .presets-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
    padding: 0.75rem 1rem;
    background: var(--hc-surface-1);
