  }

  .narrators-hero__title em {
    font-style: italic;
    color: var(--hc-gold);
  }

  .narrators-hero__lead {
    max-width: 740px;
    margin: 1.25rem 0 0;
    font-family: var(--font-body);
    color: var(--hc-text-secondary);
