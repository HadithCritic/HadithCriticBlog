---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CORPUS_META } from '../../lib/corpus-config';

/**
 * The narrator register.
 *
 * Prerendered. The stat band and the filter chips are properties of a corpus
 * version rather than of a request -- the same four aggregates over the same
 * 20,915 named transmitters on every visit -- so they come from
 * src/data/corpus-meta.json, generated by scripts/build-corpus-meta.mjs. They
 * used to be counted per request against a hosted database, about 105,000 rows
 * read to render a 50-row listing.
 *
 * The rows themselves are read from the static corpus in the browser by
 * src/lib/narrator-register.ts. They used to be rendered here as well, so the
 * same row markup existed twice and a change to one reverted on the reader's
 * first filter click. There is one renderer now.
 *
 * Each row is still a link to /narrators/{id}, which exists for every narrator
 * rather than the 8,000 the old file cap allowed.
 */

const facets = CORPUS_META.facets;
const generations = facets.generations;
const grades = facets.gradesForChips;
const centuries = facets.centuries;

const stats = {
  all_narrators: CORPUS_META.counts.narrators,
  graded: CORPUS_META.counts.narratorsGraded,
  dated: CORPUS_META.counts.narratorsDated
};

const heroStats = [
  { num: stats.all_narrators.toLocaleString(), label: 'Transmitters' },
  { num: stats.graded.toLocaleString(), label: 'With Verdicts' },
  { num: stats.dated.toLocaleString(), label: 'Dated' },
  { num: String(CORPUS_META.counts.collections), label: 'Collections' }
];
---

<BaseLayout
  title="Narrator Biographies & Rijāl Archive | HadithCritic"
  description={`A critical register of ${stats.all_narrators.toLocaleString()} classical hadith transmitters drawn from 33 collections. Every reliability grade is an attributed verdict from a named authority.`}
>
  <div class="register-page" data-register>
    <header class="register-head">
      <div class="wrap">
        <h1 class="register-title">The Transmitters of <span class="register-title-accent">Hadith.</span></h1>
        <p class="register-lead">
          A critical register of {stats.all_narrators.toLocaleString()} classical hadith transmitters drawn
          from 33 collections, including all six canonical books. Every reliability grade is an
          attributed verdict from a named authority, not an editorial summary.
        </p>

        <div class="register-stat-band">
          {heroStats.map((s) => (
            <div class="register-stat">
              <span class="register-stat__num">{s.num}</span>
              <span class="register-stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </header>

    <div class="wrap register-body">
      <form class="register-controls" method="get" action="/narrators">
        <div class="register-search">
          <label class="sr-only" for="register-q">Search transmitters</label>
          <input
            id="register-q"
            class="register-search__input"
            type="search"
            name="q"
            value=""
            placeholder="Search name, Arabic script, kunya, or place…"
            data-register-search
            autocomplete="off"
          />
          <button type="button" class="register-search__clear" data-register-clear aria-label="Clear search">×</button>
        </div>

        <div class="register-filters">
          <div class="register-filter">
            <span class="register-filter__label">Generation</span>
            <div class="register-tabs" data-filter-group="generation">
              <button type="button" class="register-tab is-active" data-value="all">All</button>
              {generations.map((g) => (
                <button type="button" class="register-tab" data-value={g.value}>
                  {g.value.replace(/\s*\(.*\)$/, '')} <span class="register-tab__n">{g.n.toLocaleString()}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="register-filter">
            <span class="register-filter__label">Verdict</span>
            <div class="register-tabs" data-filter-group="grade">
              <button type="button" class="register-tab is-active" data-value="all">All</button>
              {grades.map((g) => (
                <button type="button" class="register-tab" data-value={g.value}>
                  {g.value.replace(/\s*\(.*\)$/, '')} <span class="register-tab__n">{g.n.toLocaleString()}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="register-filter">
            <span class="register-filter__label">Century</span>
            <div class="register-tabs" data-filter-group="century">
              <button type="button" class="register-tab is-active" data-value="">All</button>
              {centuries.map((c) => (
                <button type="button" class="register-tab" data-value={String(c.value)}>
                  {c.value} AH <span class="register-tab__n">{c.n.toLocaleString()}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="register-toolbar">
          <span class="register-status" data-register-status aria-live="polite">
            {stats.all_narrators.toLocaleString()} transmitters
          </span>
          <label class="register-sort">
            <span>Sort</span>
            <select data-register-sort name="sort">
              <option value="id">Narrator ID</option>
              <option value="name">Name (A–Z)</option>
              <option value="death">Death year (earliest)</option>
              <option value="death-desc">Death year (latest)</option>
              <option value="hadith">Hadith transmitted</option>
              <option value="criticism">Most discussed</option>
            </select>
          </label>
        </div>
      </form>

      <!--
        Filled by src/lib/narrator-register.ts from the static corpus. `start`
        is rewritten with each page so the ordinals continue rather than
        restarting at one.
      -->
      <ol class="register-list" data-register-list start="1"></ol>

      <nav class="register-pager" data-register-pager aria-label="Register pages"></nav>

      <noscript>
        <p class="register-error">
          The register reads a static SQLite corpus in your browser, so browsing
          and filtering the {stats.all_narrators.toLocaleString()} transmitters
          needs JavaScript. Individual dossiers and the written research on this
          site are linked from articles and do not depend on this page.
        </p>
      </noscript>
    </div>

    <div class="compare-dock" data-compare-dock hidden>
      <div class="wrap compare-dock__inner">
        <span class="compare-dock__count"><strong data-compare-count>0</strong> selected</span>
        <div class="compare-dock__chips" data-compare-chips></div>
        <div class="compare-dock__actions">
          <button type="button" class="compare-dock__clear" data-compare-clear>Clear</button>
          <button type="button" class="hc-btn compare-dock__open" data-compare-open>Compare</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { initNarratorRegister } from '../../lib/narrator-register';
    initNarratorRegister();
  </script>

  <style>
    /* The register follows the same editorial rules-and-whitespace pattern as
       the treatise ledger: numbered rows separated by hairlines, no card per
       entry, one accent colour carrying state. */
    .register-page {
      background: var(--hc-surface-0);
      padding-bottom: clamp(4rem, 8vw, 7rem);
    }

    .register-head {
      padding: clamp(3rem, 6vw, 5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
      border-bottom: 1px solid var(--hc-rule);
    }

    .register-title {
      max-width: 20ch;
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 5vw, 3.8rem);
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.035em;
      color: var(--hc-text-primary);
    }

    .register-title-accent {
      color: var(--hc-gold);
      font-style: italic;
    }

    .register-lead {
      max-width: 68ch;
      margin: 1.25rem 0 0;
      font-family: var(--font-body);
      font-size: 1.05rem;
      line-height: 1.72;
      color: var(--hc-text-secondary);
    }

    .register-stat-band {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: clamp(2rem, 4vw, 3rem);
      border-top: 1px solid var(--hc-rule);
      border-bottom: 1px solid var(--hc-rule);
    }

    .register-stat {
      position: relative;
      min-width: 0;
      padding: 1rem 1.2rem 1.05rem 0;
    }

    .register-stat + .register-stat { padding-left: 1.2rem; }

    .register-stat + .register-stat::before {
      content: "";
      position: absolute;
      inset-block: 0;
      left: 0;
      width: 1px;
      background: var(--hc-rule-soft);
    }

    .register-stat__num {
      display: block;
      font-family: var(--font-body);
      font-size: clamp(1.5rem, 2.2vw, 2.1rem);
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.025em;
      font-variant-numeric: lining-nums tabular-nums;
      color: var(--hc-text-primary);
    }

    .register-stat__label {
      display: block;
      margin-top: 0.4rem;
      font-family: var(--font-ui);
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      color: var(--hc-text-tertiary);
    }

    .register-body { padding-top: clamp(1.75rem, 3vw, 2.5rem); }

    .register-error {
      padding: 3rem 0;
      font-family: var(--font-body);
      font-size: 1.05rem;
      color: var(--hc-text-secondary);
    }

    /* ---- controls ---- */
    .register-controls {
      padding-bottom: 1.1rem;
      border-bottom: 1px solid var(--hc-rule);
    }

    .register-search { position: relative; }

    .register-search__input {
      width: 100%;
      padding: 0.7rem 2rem 0.75rem 0;
      border: 0;
      border-bottom: 1px solid var(--hc-rule-strong);
      background: transparent;
      color: var(--hc-text-primary);
      font-family: var(--font-body);
      font-size: 1.05rem;
      transition: border-color 160ms ease;
    }

    .register-search__input::placeholder { color: var(--hc-text-tertiary); }
    .register-search__input:focus { border-bottom-color: var(--hc-gold); }

    .register-search__clear {
      position: absolute;
      right: 0;
      bottom: 0.45rem;
      min-width: 24px;
      min-height: 24px;
      border: 0;
      background: transparent;
      color: var(--hc-text-tertiary);
      font-size: 1.1rem;
      cursor: pointer;
    }

    .register-search__clear:hover { color: var(--hc-text-primary); }

    .register-filters {
      display: grid;
      gap: 0.55rem;
      margin-top: 1.35rem;
    }

    .register-filter {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 0.9rem;
      align-items: start;
    }

    .register-filter__label {
      padding-top: 0.42rem;
      font-family: var(--font-ui);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--hc-text-tertiary);
    }

    /* Filters wrap instead of scrolling sideways; the old preset bar put a raw
       horizontal scrollbar under the controls. */
    .register-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 0.5rem;
    }

    .register-tab {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.28rem 0.65rem;
      border: 1px solid var(--hc-rule-soft);
      border-radius: 3px;
      background: var(--hc-surface-1);
      color: var(--hc-text-secondary);
      font-family: var(--font-ui);
      font-size: 0.78rem;
      font-weight: 500;
      line-height: 1.3;
      cursor: pointer;
      transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .register-tab:hover {
      color: var(--hc-text-primary);
      border-color: var(--hc-rule-strong);
      background: var(--hc-surface-2);
    }

    .register-tab.is-active {
      color: var(--hc-gold);
      border-color: var(--hc-gold);
      background: color-mix(in srgb, var(--hc-gold) 10%, var(--hc-surface-1));
    }

    .register-tab__n {
      font-size: 0.75rem;
      font-variant-numeric: tabular-nums;
      color: var(--hc-text-tertiary);
    }

    .register-toolbar {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1.5rem;
      margin-top: 1.35rem;
    }

    .register-status {
      font-family: var(--font-ui);
      font-size: 0.8rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      color: var(--hc-text-tertiary);
    }

    .register-sort {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-ui);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--hc-text-tertiary);
    }

    .register-sort select {
      padding: 0.3rem 0.2rem;
      border: 0;
      border-bottom: 1px solid var(--hc-rule-strong);
      background: transparent;
      color: var(--hc-text-primary);
      font-family: var(--font-ui);
      font-size: 0.82rem;
      text-transform: none;
      letter-spacing: 0;
    }

    /* ---- comparison dock ---- */
    .compare-dock {
      position: sticky;
      bottom: 0;
      z-index: 40;
      border-top: 1px solid var(--hc-rule-strong);
      background: var(--hc-surface-1);
    }

    .compare-dock__inner {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
    }

    .compare-dock__count {
      font-family: var(--font-ui);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--hc-text-tertiary);
      white-space: nowrap;
    }

    .compare-dock__count strong { color: var(--hc-gold); }

    .compare-dock__chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      flex: 1;
      min-width: 0;
    }

    .compare-dock__actions {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      white-space: nowrap;
    }

    .compare-dock__clear {
      border: 0;
      background: transparent;
      color: var(--hc-text-tertiary);
      font-family: var(--font-ui);
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
    }

    .compare-dock__clear:hover { color: var(--hc-text-primary); }

    @media (max-width: 700px) {
      .register-stat-band { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .register-stat:nth-child(n + 3) { border-top: 1px solid var(--hc-rule-soft); }
      .register-filter { grid-template-columns: 1fr; gap: 0.3rem; }
      .register-filter__label { padding-top: 0; }
      .register-toolbar { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
      .compare-dock__chips { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .register-tab, .register-search__input { transition: none; }
    }
  </style>

  <!-- Rows are re-rendered client side after every filter change, so they can
       never carry Astro's scoping attribute. These rules are global by
       necessity; the class names are prefixed to keep them contained. -->
  <style is:global>
    /* ---- register rows ---- */
    .register-list {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--hc-rule-soft);
    }

    .register-list[aria-busy='true'] { opacity: 0.45; }

    .reg-row {
      display: grid;
      grid-template-columns: 2rem 3.4rem minmax(0, 1fr) 11rem auto;
      align-items: center;
      gap: 1.1rem;
      padding: 0.95rem 1.15rem;
      margin-bottom: 0.45rem;
      border: 1px solid var(--hc-rule-soft);
      border-radius: 4px;
      background: var(--hc-surface-1);
      transition: background 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    }

    .reg-row:hover {
      background: var(--hc-surface-2);
      border-color: var(--hc-gold-dim);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }

    .reg-pick {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border: 1px solid var(--hc-rule);
      border-radius: 3px;
      background: var(--hc-surface-2);
      color: var(--hc-text-tertiary);
      font-family: var(--font-body);
      font-size: 0.95rem;
      line-height: 1;
      cursor: pointer;
      transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .reg-pick:hover {
      color: var(--hc-gold);
      border-color: var(--hc-gold);
      background: color-mix(in srgb, var(--hc-gold) 12%, transparent);
    }

    .reg-pick.is-picked {
      color: var(--hc-text-inverse);
      background: var(--hc-gold);
      border-color: var(--hc-gold);
    }

    .reg-index {
      font-family: var(--font-ui);
      font-size: 0.8rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      color: var(--hc-text-tertiary);
    }

    .reg-main {
      min-width: 0;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .reg-names {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .reg-name {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 500;
      line-height: 1.3;
      color: var(--hc-text-primary);
      transition: color 140ms ease;
    }

    .reg-main:hover .reg-name { color: var(--hc-gold); }

    .reg-name-ar {
      font-family: var(--font-arabic);
      font-size: 1.15rem;
      line-height: 1.5;
      color: var(--hc-gold-dim);
    }

    .reg-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.45rem;
      font-family: var(--font-ui);
      font-size: 0.78rem;
      color: var(--hc-text-secondary);
    }

    .reg-counts {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.2rem;
      font-family: var(--font-ui);
      font-size: 0.78rem;
      color: var(--hc-text-tertiary);
      text-align: right;
    }

    .reg-sep { color: var(--hc-rule-strong); opacity: 0.7; }

    .reg-grade {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.3rem 0.7rem;
      border: 1px solid var(--hc-rule);
      border-radius: 3px;
      background: var(--hc-surface-2);
      font-family: var(--font-ui);
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-align: center;
      color: var(--hc-text-secondary);
      white-space: nowrap;
    }

    /* Verdict tone is the one place a second colour earns its place. */
    .reg-grade.is-trusted {
      color: var(--cat-theology-text);
      border-color: color-mix(in srgb, var(--cat-theology-text) 30%, transparent);
      background: color-mix(in srgb, var(--cat-theology-text) 8%, var(--hc-surface-2));
    }
    .reg-grade.is-weak {
      color: var(--cat-prophecies-text);
      border-color: color-mix(in srgb, var(--cat-prophecies-text) 30%, transparent);
      background: color-mix(in srgb, var(--cat-prophecies-text) 8%, var(--hc-surface-2));
    }
    .reg-grade.is-unknown {
      color: var(--hc-text-tertiary);
      border-color: var(--hc-rule);
    }

    /* ---- pagination ---- */
    .register-pager {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      margin-top: 1.75rem;
    }

    .reg-page {
      min-height: 24px;
      padding: 0.35rem 0;
      border: 0;
      border-bottom: 1px solid transparent;
      background: transparent;
      color: var(--hc-gold);
      font-family: var(--font-ui);
      font-size: 0.82rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
    }

    .reg-page:hover:not([disabled]):not([aria-disabled='true']) { border-bottom-color: var(--hc-gold); }

    .reg-page[disabled],
    .reg-page[aria-disabled='true'] {
      color: var(--hc-text-tertiary);
      pointer-events: none;
    }

    .reg-page-of {
      font-family: var(--font-ui);
      font-size: 0.78rem;
      font-variant-numeric: tabular-nums;
      color: var(--hc-text-tertiary);
    }

    .reg-chip {
      min-height: 24px;
      padding: 0.2rem 0.5rem;
      border: 1px solid var(--hc-rule);
      background: transparent;
      color: var(--hc-text-secondary);
      font-family: var(--font-ui);
      font-size: 0.76rem;
      cursor: pointer;
    }

    .reg-chip:hover { color: var(--hc-gold); border-color: var(--hc-gold-dim); }

    /* The row grid collapses in stages. These live in the global block because
       they target rows the client re-renders, which carry no scoping id. */
    @media (max-width: 1024px) {
      .reg-row { grid-template-columns: 1.9rem 2.6rem minmax(0, 1fr) 9rem; }
      .reg-counts { grid-column: 3 / -1; justify-content: flex-start; text-align: left; margin-top: 0.25rem; }
    }

    @media (max-width: 700px) {
      .reg-row { grid-template-columns: 1.9rem minmax(0, 1fr); row-gap: 0.3rem; }
      .reg-index { display: none; }
      .reg-grade, .reg-counts { grid-column: 2; }
    }

    @media (prefers-reduced-motion: reduce) {
      .reg-row, .reg-pick { transition: none; }
    }

  </style>

</BaseLayout>
