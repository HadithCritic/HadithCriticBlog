    min-height: 100vh;
    padding-bottom: 7rem;
    background:
      radial-gradient(circle at 85% 10%, rgba(216, 177, 102, 0.07), transparent 30%),
      radial-gradient(circle at 15% 40%, rgba(164, 106, 63, 0.08), transparent 28%),
      linear-gradient(180deg, var(--hc-surface-0) 0%, var(--hc-surface-2) 40%, var(--hc-surface-0) 100%);
  }

  /* Hero Section */
  .narrators-hero {
    position: relative;
    padding: clamp(5.5rem, 8vw, 7.5rem) 0 clamp(3rem, 5vw, 4rem);
    border-bottom: 1px solid var(--hc-rule);
    overflow: hidden;
  }

  .narrators-hero::before {
    content: "";
    position: absolute;
    inset: 16px;
    border: 1px solid var(--hc-rule-soft);
