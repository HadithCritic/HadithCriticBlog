---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Narrator Biographies & Rijāl Archive | HadithCritic"
  description="A scholarly register of 24,326 classical hadith transmitters with biographical dossiers, Arabic calligraphy, reliability evaluations, and side-by-side isnad comparison."
>
  <div class="narrators-page" id="narrators-app">
    <!-- Hero Section -->
    <section class="narrators-hero" aria-labelledby="narrators-hero-title">
      <div class="hc-container narrators-hero__inner">
        <div class="narrators-hero__badge">
          <span class="pulse-dot"></span>
          <span>Academic Rijāl & Transmitter Research Archive</span>
        </div>
        <h1 id="narrators-hero-title" class="narrators-hero__title">
          The Transmitters of <em>Hadith.</em>
        </h1>
        <p class="narrators-hero__lead">
          A critical register of <strong>24,326 classical hadith transmitters</strong> across the canonical collections.
          Examine biographical dossiers, reliability rankings, chronological lifespans, places of stay, and compare narrators side-by-side to evaluate transmission overlap.
        </p>

        <!-- KPI Metrics Grid -->
        <div class="narrators-stats" aria-label="Dataset Statistics">
          <div class="stat-card">
            <span class="stat-card__number" id="stat-total">24,326</span>
            <span class="stat-card__label">Transmitters Indexed</span>
          </div>
          <div class="stat-card">
            <span class="stat-card__number">4</span>
            <span class="stat-card__label">Generational Cohorts</span>
          </div>
          <div class="stat-card">
            <span class="stat-card__number">100%</span>
            <span class="stat-card__label">Bidirectional Isnad Links</span>
          </div>
          <div class="stat-card">
            <span class="stat-card__number">Side-by-Side</span>
            <span class="stat-card__label">Comparative Matrix</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Explorer Section -->
    <section class="narrators-explorer hc-container" aria-label="Narrator Explorer">
      <!-- Research Presets Bar -->
      <div class="presets-bar" aria-label="Research Presets">
        <span class="presets-bar__label">Research Presets:</span>
        <div class="presets-bar__scroll">
          <button class="preset-btn is-active" data-preset="all">All Transmitters</button>
          <button class="preset-btn" data-preset="sahaba">Companions (Sahaba)</button>
          <button class="preset-btn" data-preset="tabiun">Senior Tabi'un</button>
          <button class="preset-btn" data-preset="medina">Medinan Hub</button>
          <button class="preset-btn" data-preset="kufa">Kufan Hub</button>
          <button class="preset-btn" data-preset="basra">Basran Hub</button>
          <button class="preset-btn" data-preset="thiqah">Thiqah (Trustworthy)</button>
        </div>
      </div>

      <!-- Search & Filters Toolbar -->
      <div class="explorer-toolbar">
        <div class="search-box">
          <span class="search-box__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input
            type="text"
            id="search-input"
            class="search-box__input"
            placeholder="Search English transliteration, Arabic script (e.g. الزهري), ID (#10511), or city..."
            autocomplete="off"
            spellcheck="false"
          />
          <button id="search-clear" class="search-box__clear" aria-label="Clear search" style="display: none;">
            &times;
          </button>
          <span class="search-box__kbd" aria-hidden="true">/</span>
        </div>

        <div class="filter-row">
          <!-- Generation Filter -->
          <div class="filter-group">
            <label for="filter-gen" class="filter-label">Generation</label>
            <select id="filter-gen" class="filter-select">
              <option value="">All Generations</option>
              <option value="Companion (Sahabi)">Companions (Sahaba)</option>
              <option value="Follower (Tabi'i)">Followers (Tabi'un)</option>
              <option value="Successor (Taba' Tabi'i)">Successors (Taba' Tabi'in)</option>
              <option value="3rd Century AH">3rd Century AH</option>
              <option value="4th Century AH">4th Century AH</option>
            </select>
          </div>

          <!-- Reliability Grade Filter -->
          <div class="filter-group">
            <label for="filter-grade" class="filter-label">Reliability</label>
            <select id="filter-grade" class="filter-select">
              <option value="">All Evaluations</option>
              <option value="Thiqah (Trustworthy)">Thiqah (Trustworthy)</option>
              <option value="Sadooq (Truthful)">Sadooq (Truthful)</option>
              <option value="Maqbool (Acceptable)">Maqbool (Acceptable)</option>
              <option value="Da'if (Weak)">Da'if (Weak)</option>
              <option value="Matrook (Abandoned)">Matrook (Abandoned)</option>
              <option value="Majhool (Unknown)">Majhool (Unknown)</option>
              <option value="Sahabi (Companion)">Sahabi (Companion)</option>
            </select>
          </div>

          <!-- Hub / City Filter -->
          <div class="filter-group">
            <label for="filter-city" class="filter-label">Transmission Hub</label>
            <select id="filter-city" class="filter-select">
              <option value="">All Hubs</option>
              <option value="Medina">Medina / Medinah</option>
              <option value="Makkah">Makkah</option>
              <option value="Kufa">Kufa</option>
              <option value="Basra">Basra</option>
              <option value="Syria">Syria / Damascus</option>
              <option value="Baghdad">Baghdad</option>
              <option value="Egypt">Egypt</option>
              <option value="Yemen">Yemen</option>
              <option value="Khurasan">Khurasan</option>
            </select>
          </div>

          <!-- Sort Order -->
          <div class="filter-group">
            <label for="filter-sort" class="filter-label">Sort</label>
            <select id="filter-sort" class="filter-select">
              <option value="id-asc">Scholar ID (1 → 24k)</option>
              <option value="id-desc">Scholar ID (24k → 1)</option>
              <option value="name-asc">Name (A → Z)</option>
              <option value="death-asc">Death Date (Earliest)</option>
              <option value="death-desc">Death Date (Latest)</option>
              <option value="students-desc">Most Students</option>
              <option value="teachers-desc">Most Teachers</option>
            </select>
          </div>

          <!-- View Mode Toggle -->
          <div class="view-toggle" role="group" aria-label="View Mode">
            <button id="view-table-btn" class="view-toggle__btn is-active" title="Registry Table View" aria-pressed="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
            <button id="view-grid-btn" class="view-toggle__btn" title="Biographical Cards View" aria-pressed="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            </button>
          </div>
        </div>

        <!-- Active Filters & Reset Bar -->
        <div class="active-bar" id="active-bar" style="display: none;">
          <span class="active-bar__label">Active filters:</span>
          <div class="active-bar__chips" id="active-chips"></div>
          <button id="reset-filters-btn" class="active-bar__reset">Clear all</button>
        </div>
      </div>

      <!-- Results Header -->
      <div class="results-head">
        <div class="results-head__count">
          <span id="results-count-text">Loading transmitters index...</span>
        </div>
        <div class="results-head__actions">
          <button id="open-compare-btn-head" class="compare-trigger-btn" style="display: none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"></path></svg>
            Compare Selected (<span class="compare-count-val">0</span>)
          </button>
          <div class="results-head__per-page">
            <label for="per-page-select">Per page:</label>
            <select id="per-page-select" class="filter-select filter-select--sm">
              <option value="25">25</option>
              <option value="50" selected>50</option>
              <option value="100">100</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Loading State -->
      <div id="loading-spinner" class="explorer-loading">
        <div class="spinner"></div>
        <p>Loading 24,326 transmitter records...</p>
      </div>

      <!-- Table View Container -->
      <div id="table-view" class="table-container" style="display: none;">
        <table class="narrators-table">
          <thead>
            <tr>
              <th class="col-check" title="Select for comparison">Compare</th>
              <th class="col-id">ID</th>
              <th class="col-name">Transmitter Name</th>
              <th class="col-gen">Generation</th>
              <th class="col-grade">Reliability</th>
              <th class="col-death">Death / Era</th>
              <th class="col-stay">Places of Stay</th>
              <th class="col-network">Network</th>
              <th class="col-action">Dossier</th>
            </tr>
          </thead>
          <tbody id="table-body">
            <!-- Populated via JavaScript -->
          </tbody>
        </table>
      </div>

      <!-- Grid / Cards View Container -->
      <div id="grid-view" class="grid-container" style="display: none;">
        <div class="narrators-grid" id="grid-body">
          <!-- Populated via JavaScript -->
        </div>
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="empty-state" style="display: none;">
        <div class="empty-state__icon">🔍</div>
        <h3 class="empty-state__title">No transmitters found</h3>
        <p class="empty-state__desc">Try adjusting your search terms, changing the generation filter, or clearing active filters.</p>
        <button class="hc-btn hc-btn--ghost" id="empty-reset-btn">Reset All Filters</button>
      </div>

      <!-- Pagination Container -->
      <div id="pagination-container" class="pagination-bar" style="display: none;">
        <button id="prev-page-btn" class="pagination-btn" disabled>&larr; Previous</button>
        <div class="pagination-info">
          <span id="page-info-text">Page 1 of 1</span>
        </div>
        <button id="next-page-btn" class="pagination-btn">Next &rarr;</button>
      </div>
    </section>

    <!-- Persistent Bottom Comparison Dock -->
    <aside id="comparison-dock" class="comparison-dock" aria-label="Narrator Comparison Queue" style="display: none;">
      <div class="comparison-dock__inner">
        <div class="comparison-dock__info">
          <span class="comparison-dock__title">Compare Narrators</span>
          <span class="comparison-dock__slots">(<span id="dock-count">0</span>/3 selected)</span>
        </div>
        <div class="comparison-dock__chips" id="dock-chips"></div>
        <div class="comparison-dock__actions">
          <button id="dock-clear-btn" class="dock-btn dock-btn--ghost">Clear</button>
          <button id="dock-compare-btn" class="dock-btn dock-btn--primary">
            Compare Side-by-Side &rarr;
          </button>
        </div>
      </div>
    </aside>

    <!-- Side-over Transmitter Dossier Modal -->
    <div id="dossier-modal" class="dossier-modal" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="dossier-backdrop" id="dossier-backdrop"></div>
      <div class="dossier-panel">
        <div class="dossier-header">
          <div class="dossier-header__top">
            <span class="dossier-id-badge" id="modal-id">#0</span>
            <div class="dossier-header__actions">
              <button id="modal-compare-toggle-btn" class="dossier-btn-text" title="Add to comparison workspace">
                + Compare
              </button>
              <button id="modal-cite-btn" class="dossier-btn-icon" title="Cite this transmitter">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              </button>
              <button id="modal-copy-btn" class="dossier-btn-icon" title="Copy direct link to transmitter">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span class="copy-tooltip" id="copy-tooltip">Copied!</span>
              </button>
              <button id="modal-close-btn" class="dossier-btn-icon" aria-label="Close dossier">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
          </div>

          <h2 class="dossier-name-en" id="modal-name-en">Transmitter Name</h2>
          <p class="dossier-name-ar" id="modal-name-ar" dir="rtl" lang="ar">الاسم بالعربية</p>

          <div class="dossier-badges" id="modal-badges">
            <span class="dossier-badge dossier-badge--gen" id="modal-gen">Generation</span>
            <span class="dossier-badge dossier-badge--grade" id="modal-grade">Grade</span>
          </div>
        </div>

        <div class="dossier-content" id="modal-content">
          <!-- Loading placeholder -->
          <div class="dossier-loading" id="modal-loading">
            <div class="spinner"></div>
            <p>Fetching biographical dossier...</p>
          </div>

          <!-- Dossier Body -->
          <div class="dossier-body" id="modal-body" style="display: none;">
            <!-- Vital Statistics Section -->
            <section class="dossier-section">
              <h3 class="dossier-section__title">Vital Chronology & Places</h3>
              <div class="vital-grid">
                <div class="vital-card">
                  <span class="vital-card__label">Birth Date & Place</span>
                  <span class="vital-card__value" id="modal-birth">—</span>
                </div>
                <div class="vital-card">
                  <span class="vital-card__label">Death Date & Place</span>
                  <span class="vital-card__value" id="modal-death">—</span>
                </div>
                <div class="vital-card" id="modal-death-reason-card">
                  <span class="vital-card__label">Death Reason</span>
                  <span class="vital-card__value" id="modal-death-reason">—</span>
                </div>
                <div class="vital-card vital-card--full">
                  <span class="vital-card__label">Places of Stay / Travel</span>
                  <div class="stay-path" id="modal-places-path"></div>
                </div>
              </div>
            </section>

            <!-- Areas of Interest & Canonical Tags -->
            <section class="dossier-section" id="modal-tags-section">
              <h3 class="dossier-section__title">Specialization & Canonical Sigla</h3>
              <div class="dossier-interests" id="modal-interests"></div>
              <div class="dossier-tags" id="modal-tags"></div>
            </section>

            <!-- Lineage & Family Ties -->
            <section class="dossier-section" id="modal-family-section">
              <h3 class="dossier-section__title">Lineage & Family Relations</h3>
              <div class="family-groups" id="modal-family-groups"></div>
            </section>

            <!-- Transmission Networks (Teachers & Students) -->
            <section class="dossier-section">
              <div class="network-header">
                <h3 class="dossier-section__title">Transmission Networks</h3>
                <div class="network-tabs" role="tablist">
                  <button class="network-tab is-active" id="tab-teachers-btn" role="tab" aria-selected="true">
                    Teachers (<span id="modal-teachers-count">0</span>)
                  </button>
                  <button class="network-tab" id="tab-students-btn" role="tab" aria-selected="false">
                    Students (<span id="modal-students-count">0</span>)
                  </button>
                </div>
              </div>

              <!-- Teachers Pane -->
              <div class="network-pane is-active" id="pane-teachers" role="tabpanel">
                <div class="relation-chips" id="modal-teachers-list"></div>
              </div>

              <!-- Students Pane -->
              <div class="network-pane" id="pane-students" role="tabpanel" style="display: none;">
                <div class="relation-chips" id="modal-students-list"></div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>

    <!-- Side-by-Side Comparison Workspace Modal -->
    <div id="compare-modal" class="compare-modal" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="compare-backdrop" id="compare-backdrop"></div>
      <div class="compare-panel">
        <header class="compare-header">
          <div class="compare-header__title-box">
            <h2 class="compare-header__title">Narrator Comparison Workspace</h2>
            <p class="compare-header__subtitle">Comparative biographical analysis, transmission overlap, and isnād intersections.</p>
          </div>
          <div class="compare-header__actions">
            <button id="compare-export-btn" class="hc-btn hc-btn--ghost" title="Copy structured markdown comparison notes">
              Export Notes
            </button>
            <button id="compare-close-btn" class="dossier-btn-icon" aria-label="Close comparison">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
        </header>

        <!-- Overlap Analytics Banner -->
        <section class="overlap-banner" id="overlap-banner">
          <div class="overlap-card">
            <span class="overlap-card__title">Shared Authorities (Teachers)</span>
            <div class="overlap-card__body" id="shared-teachers-container">
              <span class="overlap-empty">None detected</span>
            </div>
          </div>
          <div class="overlap-card">
            <span class="overlap-card__title">Shared Transmitters (Students)</span>
            <div class="overlap-card__body" id="shared-students-container">
              <span class="overlap-empty">None detected</span>
            </div>
          </div>
          <div class="overlap-card">
            <span class="overlap-card__title">Chronology & Geographic Overlap</span>
            <div class="overlap-card__body" id="overlap-coexistence-container">
              <span class="overlap-text" id="coexistence-text">—</span>
            </div>
          </div>
        </section>

        <!-- Multi-Column Comparison Grid -->
        <div class="compare-grid" id="compare-grid">
          <!-- Populated via JavaScript for 2-3 narrators -->
        </div>
      </div>
    </div>

    <!-- Academic Citation Modal -->
    <div id="citation-modal" class="citation-modal" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="citation-backdrop" id="citation-backdrop"></div>
      <div class="citation-box">
        <div class="citation-box__header">
          <h3 class="citation-box__title">Academic Citation</h3>
          <button id="citation-close-btn" class="dossier-btn-icon" aria-label="Close citation dialog">&times;</button>
        </div>
        <p class="citation-box__copy">Standard scholarly format for footnote or bibliographic reference:</p>
        <div class="citation-text-card">
          <p id="citation-text" class="citation-text">Generating citation...</p>
        </div>
        <div class="citation-box__actions">
          <button id="citation-copy-btn" class="hc-btn">Copy Citation</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  interface RawiIndexItem {
    i: number;      // ID
    e: string;      // English Name
    a: string;      // Arabic Name
    g: string;      // Generation
    r: string;      // Reliability Grade
    dh: string;     // Death Hijri
    dg: string;     // Death Gregorian
    dp: string;     // Death Place
    ps: string;     // Places of Stay
    tc: number;     // Teachers count
    sc: number;     // Students count
    t: string[];    // Tags
  }

  interface RelationItem {
    id: number | null;
    name: string;
  }

  interface RawiDetail {
    id: number;
    nameEn: string;
    nameAr: string;
    rawName: string;
    rawGrade: string;
    generation: string;
    grade: string;
    parents: RelationItem[];
    spouse: RelationItem[];
    siblings: RelationItem[];
    children: RelationItem[];
    birthDatePlace: string;
    placesOfStay: string;
    deathDatePlace: string;
    birthPlace: string;
    deathPlace: string;
    deathReason: string;
    birthHijri: string;
    birthGregorian: string;
    deathHijri: string;
    deathGregorian: string;
    teachers: RelationItem[];
    students: RelationItem[];
    areaOfInterest: string;
    tags: string[];
    books: string;
  }

  let allTransmitters: RawiIndexItem[] = [];
  let filteredTransmitters: RawiIndexItem[] = [];
  let currentPage = 1;
  let itemsPerPage = 50;
  let currentView: 'table' | 'grid' = 'table';
  let comparisonQueue: number[] = [];
  let activeDossierId: number | null = null;
  const chunkCache = new Map<number, Record<string, RawiDetail>>();

  // DOM Elements
  const searchInput = document.querySelector('#search-input') as any as HTMLInputElement;
  const searchClear = document.querySelector('#search-clear') as any as HTMLButtonElement;
  const filterGen = document.querySelector('#filter-gen') as any as HTMLSelectElement;
  const filterGrade = document.querySelector('#filter-grade') as any as HTMLSelectElement;
  const filterCity = document.querySelector('#filter-city') as any as HTMLSelectElement;
  const filterSort = document.querySelector('#filter-sort') as any as HTMLSelectElement;
  const perPageSelect = document.querySelector('#per-page-select') as any as HTMLSelectElement;

  const viewTableBtn = document.querySelector('#view-table-btn') as any as HTMLButtonElement;
  const viewGridBtn = document.querySelector('#view-grid-btn') as any as HTMLButtonElement;

  const tableView = document.querySelector('#table-view') as any as HTMLElement;
  const gridView = document.querySelector('#grid-view') as any as HTMLElement;
  const tableBody = document.querySelector('#table-body') as any as HTMLElement;
  const gridBody = document.querySelector('#grid-body') as any as HTMLElement;
  const loadingSpinner = document.querySelector('#loading-spinner') as any as HTMLElement;
  const emptyState = document.querySelector('#empty-state') as any as HTMLElement;

  const activeBar = document.querySelector('#active-bar') as any as HTMLElement;
  const activeChips = document.querySelector('#active-chips') as any as HTMLElement;
  const resetFiltersBtn = document.querySelector('#reset-filters-btn') as any as HTMLButtonElement;
  const emptyResetBtn = document.querySelector('#empty-reset-btn') as any as HTMLButtonElement;

  const resultsCountText = document.querySelector('#results-count-text') as any as HTMLElement;
  const paginationContainer = document.querySelector('#pagination-container') as any as HTMLElement;
  const prevPageBtn = document.querySelector('#prev-page-btn') as any as HTMLButtonElement;
  const nextPageBtn = document.querySelector('#next-page-btn') as any as HTMLButtonElement;
  const pageInfoText = document.querySelector('#page-info-text') as any as HTMLElement;
  const openCompareBtnHead = document.querySelector('#open-compare-btn-head') as any as HTMLButtonElement;

  // Comparison Dock
  const comparisonDock = document.querySelector('#comparison-dock') as any as HTMLElement;
  const dockChips = document.querySelector('#dock-chips') as any as HTMLElement;
  const dockCount = document.querySelector('#dock-count') as any as HTMLElement;
  const dockClearBtn = document.querySelector('#dock-clear-btn') as any as HTMLButtonElement;
  const dockCompareBtn = document.querySelector('#dock-compare-btn') as any as HTMLButtonElement;

  // Comparison Workspace Modal
  const compareModal = document.querySelector('#compare-modal') as any as HTMLElement;
  const compareBackdrop = document.querySelector('#compare-backdrop') as any as HTMLElement;
  const compareCloseBtn = document.querySelector('#compare-close-btn') as any as HTMLButtonElement;
  const compareExportBtn = document.querySelector('#compare-export-btn') as any as HTMLButtonElement;
  const compareGrid = document.querySelector('#compare-grid') as any as HTMLElement;
  const sharedTeachersContainer = document.querySelector('#shared-teachers-container') as any as HTMLElement;
  const sharedStudentsContainer = document.querySelector('#shared-students-container') as any as HTMLElement;
