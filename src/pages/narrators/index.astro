---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';

/**
 * The narrator register.
 *
 * Replaces a 3,864-line page that mixed markup, ~2,000 lines of CSS and a large
 * client script, downloaded a 5.2 MB index to filter 20,950 records in the
 * browser, and opened every transmitter in a modal — so none of the dossier
 * pages were linkable, shareable or crawlable.
 *
 * Now: the first page of results and the filter facets are rendered here from
 * D1, so the register works with JavaScript off and search engines see real
 * rows; the client module takes over for filtering and paging. Each row is a
 * link to /narrators/{id}, which since the D1 move exists for every narrator
 * rather than the 8,000 the file cap allowed.
 */

const p = Astro.url.searchParams;
const q = (p.get('q') || '').trim().toLowerCase();
const generation = p.get('generation') || 'all';
const grade = p.get('grade') || 'all';
const century = parseInt(p.get('century') || '', 10);
const sortKey = p.get('sort') || 'id';
const page = Math.max(1, parseInt(p.get('page') || '1', 10) || 1);
const size = 50;

const SORTS: Record<string, string> = {
  id: 'id ASC',
  'id-desc': 'id DESC',
  name: 'name_en ASC, id ASC',
  death: 'death_hijri IS NULL, death_hijri ASC, id ASC',
  'death-desc': 'death_hijri IS NULL, death_hijri DESC, id ASC',
  hadith: 'hadith_count DESC, id ASC',
  criticism: 'statement_count DESC, id ASC'
};

const where: string[] = ['unnamed = 0'];
const binds: unknown[] = [];
if (q) {
  where.push('search_text LIKE ?');
  binds.push(`%${q.replace(/[%_]/g, (m) => `\\${m}`)}%`);
}
if (generation !== 'all') {
  where.push('generation = ?');
  binds.push(generation);
}
if (grade !== 'all') {
  where.push('grade = ?');
  binds.push(grade);
}
if (Number.isFinite(century) && century > 0) {
  where.push('death_hijri BETWEEN ? AND ?');
  binds.push((century - 1) * 100 + 1, century * 100);
}
const sql = `WHERE ${where.join(' AND ')}`;
const order = SORTS[sortKey] || SORTS.id;

interface Row {
  id: number;
  name_en: string;
  name_ar: string;
  generation: string;
  grade: string;
  death_hijri: number | null;
  death_place: string;
  places_en: string;
  hadith_count: number;
  teacher_count: number;
  student_count: number;
  statement_count: number;
}

let rows: Row[] = [];
let total = 0;
let generations: { value: string; n: number }[] = [];
let grades: { value: string; n: number }[] = [];
let centuries: { value: number; n: number }[] = [];
let stats = { all_narrators: 0, graded: 0, dated: 0 };
let failed = false;

try {
  const [listed, counted, gen, grd, cen, tot] = await env.DB.batch([
    env.DB.prepare(
      `SELECT id,name_en,name_ar,generation,grade,death_hijri,death_place,places_en,
              hadith_count,teacher_count,student_count,statement_count
         FROM narrator ${sql} ORDER BY ${order} LIMIT ? OFFSET ?`
    ).bind(...binds, size, (page - 1) * size),
    env.DB.prepare(`SELECT COUNT(*) AS n FROM narrator ${sql}`).bind(...binds),
    env.DB.prepare(
      `SELECT generation AS value, COUNT(*) AS n FROM narrator
        WHERE unnamed = 0 AND generation <> '' GROUP BY generation ORDER BY n DESC`
    ),
    env.DB.prepare(
      `SELECT grade AS value, COUNT(*) AS n FROM narrator
        WHERE unnamed = 0 AND grade <> '' GROUP BY grade ORDER BY n DESC LIMIT 8`
    ),
    env.DB.prepare(
      `SELECT ((death_hijri - 1) / 100) + 1 AS value, COUNT(*) AS n FROM narrator
        WHERE unnamed = 0 AND death_hijri IS NOT NULL GROUP BY value ORDER BY value`
    ),
    env.DB.prepare(
      `SELECT COUNT(*) AS all_narrators,
              SUM(CASE WHEN critic_count > 0 THEN 1 ELSE 0 END) AS graded,
              SUM(CASE WHEN death_hijri IS NOT NULL THEN 1 ELSE 0 END) AS dated
         FROM narrator WHERE unnamed = 0`
    )
  ]);
  rows = (listed.results || []) as unknown as Row[];
  total = ((counted.results?.[0] as { n?: number })?.n) ?? 0;
  generations = (gen.results || []) as unknown as typeof generations;
  grades = (grd.results || []) as unknown as typeof grades;
  centuries = (cen.results || []) as unknown as typeof centuries;
  stats = { ...stats, ...((tot.results?.[0] as typeof stats) || {}) };
} catch (error) {
  console.error('Narrator register failed to load', error);
  failed = true;
}

const pages = Math.max(1, Math.ceil(total / size));
const firstIndex = (page - 1) * size + 1;

/**
 * URL for one filter value, preserving every other active parameter.
 * Changing a filter returns to page 1: staying on page 40 of a result set that
 * no longer has 40 pages is how a filter appears to return nothing.
 */
const filterUrl = (key: string, value: string) => {
  const u = new URLSearchParams(Astro.url.search);
  if (!value || value === 'all') u.delete(key);
  else u.set(key, value);
  u.delete('page');
  const qs = u.toString();
  return qs ? `/narrators?${qs}` : '/narrators';
};

const heroStats = [
  { num: stats.all_narrators.toLocaleString(), label: 'Transmitters' },
  { num: stats.graded.toLocaleString(), label: 'With Criticism' },
  { num: stats.dated.toLocaleString(), label: 'Dated' },
  { num: '33', label: 'Collections' }
];
---

<BaseLayout
  title="Narrator Biographies & Rijāl Archive | HadithCritic"
  description={`A critical register of ${stats.all_narrators.toLocaleString()} classical hadith transmitters drawn from 33 collections. Every grade shown is the recorded judgement of a named authority.`}
>
  <div class="register-page" data-register>
    <header class="register-head">
      <div class="wrap">
        <p class="hc-eyebrow"><a href="/">Home</a> / Rijāl register</p>
        <h1 class="register-title">The Transmitters of <span class="register-title-accent">Hadith.</span></h1>
        <p class="register-lead">
          A critical register of {stats.all_narrators.toLocaleString()} classical hadith transmitters drawn
          from 33 collections, including all six canonical books. Every grade shown is the recorded
          judgement of a named authority, not an editorial summary, and no rating of our own is applied.
        </p>

        <div class="hc-stat-band hc-stat-band--4 register-stat-band" aria-label="Register statistics">
          {heroStats.map((s) => (
            <div class="hc-stat">
              <span class="hc-stat__num">{s.num}</span>
              <span class="hc-stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </header>

    <div class="wrap register-body">
      {failed ? (
        <p class="register-error">The register is temporarily unavailable. Please try again shortly.</p>
      ) : (
        <>
          <form class="register-controls" method="get" action="/narrators">
            <div class="hc-searchbar register-search">
              <label class="sr-only" for="register-q">Search transmitters</label>
              <input
                id="register-q"
                class="hc-searchbar__input"
                type="search"
                name="q"
                value={q}
                placeholder="Search name, Arabic script, kunya, or place…"
                data-register-search
                autocomplete="off"
              />
              <button type="button" class="register-search__clear" data-register-clear aria-label="Clear search">×</button>
              <button type="submit" class="hc-searchbar__submit">Search <span aria-hidden="true">→</span></button>
            </div>

            {/* A search must not silently discard the filters already applied. */}
            {generation !== 'all' && <input type="hidden" name="generation" value={generation} />}
            {grade !== 'all' && <input type="hidden" name="grade" value={grade} />}
            {Number.isFinite(century) && century > 0 && <input type="hidden" name="century" value={century} />}

            <div class="register-filters">
              <div class="register-filter">
                <span class="register-filter__label">Generation</span>
                <div class="register-tabs" data-filter-group="generation">
                  <a
                    class={`register-tab${generation === 'all' ? ' is-active' : ''}`}
                    href={filterUrl('generation', 'all')}
                    data-value="all"
                    aria-current={generation === 'all' ? 'true' : undefined}
                  >All</a>
                  {generations.map((g) => (
                    <a
                      class={`register-tab${generation === g.value ? ' is-active' : ''}`}
                      href={filterUrl('generation', String(g.value))}
                      data-value={g.value}
                      aria-current={generation === g.value ? 'true' : undefined}
                    >
                      {g.value.replace(/\s*\(.*\)$/, '')} <span class="register-tab__n">{g.n.toLocaleString()}</span>
                    </a>
                  ))}
                </div>
              </div>

              <div class="register-filter">
                <span class="register-filter__label">Recorded grade</span>
                <div class="register-tabs" data-filter-group="grade">
                  <a
                    class={`register-tab${grade === 'all' ? ' is-active' : ''}`}
                    href={filterUrl('grade', 'all')}
                    data-value="all"
                    aria-current={grade === 'all' ? 'true' : undefined}
                  >All</a>
                  {grades.map((g) => (
                    <a
                      class={`register-tab${grade === g.value ? ' is-active' : ''}`}
                      href={filterUrl('grade', String(g.value))}
                      data-value={g.value}
                      aria-current={grade === g.value ? 'true' : undefined}
                    >
                      {g.value.replace(/\s*\(.*\)$/, '')} <span class="register-tab__n">{g.n.toLocaleString()}</span>
                    </a>
                  ))}
                </div>
              </div>

              <div class="register-filter">
                <span class="register-filter__label">Century</span>
                <div class="register-tabs" data-filter-group="century">
                  <a
                    class={`register-tab${!(Number.isFinite(century) && century > 0) ? ' is-active' : ''}`}
                    href={filterUrl('century', '')}
                    data-value=""
                    aria-current={!(Number.isFinite(century) && century > 0) ? 'true' : undefined}
                  >All</a>
                  {centuries.map((c) => (
                    <a
                      class={`register-tab${century === c.value ? ' is-active' : ''}`}
                      href={filterUrl('century', String(c.value))}
                      data-value={String(c.value)}
                      aria-current={century === c.value ? 'true' : undefined}
                    >
                      {c.value} AH <span class="register-tab__n">{c.n.toLocaleString()}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <div class="register-toolbar">
              <span class="register-status" data-register-status aria-live="polite">
                {total.toLocaleString()} transmitter{total === 1 ? '' : 's'}
              </span>
              <label class="register-sort">
                <span>Sort</span>
                <select data-register-sort name="sort">
                  <option value="id" selected={sortKey === 'id'}>Narrator ID</option>
                  <option value="name" selected={sortKey === 'name'}>Name (A–Z)</option>
                  <option value="death" selected={sortKey === 'death'}>Death year (earliest)</option>
                  <option value="death-desc" selected={sortKey === 'death-desc'}>Death year (latest)</option>
                  <option value="hadith" selected={sortKey === 'hadith'}>Hadith transmitted</option>
                  <option value="criticism" selected={sortKey === 'criticism'}>Most discussed</option>
                </select>
              </label>
              <noscript><button type="submit" class="register-sort__apply">Apply sort</button></noscript>
            </div>
          </form>

          <ol class="register-list" data-register-list start={firstIndex}>
            {rows.map((r, i) => {
              const places = JSON.parse(r.places_en || '[]') as string[];
              const meta = [r.generation, r.death_hijri ? `d. ${r.death_hijri} AH` : null, places[0] || r.death_place || null].filter(Boolean);
              const counts = [
                r.hadith_count ? `${r.hadith_count.toLocaleString()} hadith` : null,
                r.teacher_count || r.student_count ? `${r.teacher_count}T / ${r.student_count}S` : null,
                r.statement_count ? `${r.statement_count} statements` : null
              ].filter(Boolean);
              return (
                <li class="reg-row">
                  <span class="reg-index">{firstIndex + i}</span>
                  <a class="reg-main" href={`/narrators/${r.id}`}>
                    <span class="reg-names">
                      <span class="reg-name">{r.name_en || r.name_ar}</span>
                      {r.name_ar && <span class="reg-name-ar" lang="ar" dir="rtl">{r.name_ar}</span>}
                    </span>
                    <span class="reg-meta">
                      {meta.map((m, k) => (
                        <>
                          {k > 0 && <span class="reg-sep" aria-hidden="true">·</span>}
                          <span>{m}</span>
                        </>
                      ))}
                    </span>
                  </a>
                  <span class="reg-grade">{r.grade || 'Unrated'}</span>
                  <span class="reg-counts">
                    {counts.map((m, k) => (
                      <>
                        {k > 0 && <span class="reg-sep" aria-hidden="true">·</span>}
                        <span>{m}</span>
                      </>
                    ))}
                  </span>
                  <button
                    type="button"
                    class="reg-pick"
                    data-pick={r.id}
                    data-name={r.name_en || r.name_ar}
                    aria-pressed="false"
                    aria-label={`Add to comparison: ${r.name_en || r.name_ar}`}
                  ><span aria-hidden="true">+</span></button>
                </li>
              );
            })}
          </ol>

          <nav class="register-pager" data-register-pager aria-label="Register pages">
            {pages > 1 && (
              <>
                <a class="reg-page" href={`?${new URLSearchParams({ ...Object.fromEntries(p), page: String(page - 1) })}`} aria-disabled={page <= 1}>← Previous</a>
                <span class="reg-page-of">Page {page.toLocaleString()} of {pages.toLocaleString()}</span>
                <a class="reg-page" href={`?${new URLSearchParams({ ...Object.fromEntries(p), page: String(page + 1) })}`} aria-disabled={page >= pages}>Next →</a>
              </>
            )}
          </nav>
        </>
      )}
    </div>

    <div class="compare-dock" data-compare-dock hidden>
      <div class="wrap compare-dock__inner">
        <span class="compare-dock__count"><strong data-compare-count>0</strong> selected</span>
        <div class="compare-dock__chips" data-compare-chips></div>
        <div class="compare-dock__actions">
          <button type="button" class="compare-dock__clear" data-compare-clear>Clear</button>
          <button type="button" class="hc-btn compare-dock__open" data-compare-open>Compare</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { initNarratorRegister } from '../../lib/narrator-register';
    initNarratorRegister();
  </script>

  <style>
    /* The register follows the same editorial rules-and-whitespace pattern as
       the treatise ledger: numbered rows separated by hairlines, no card per
       entry, one accent colour carrying state. */
    .register-page {
      background: var(--hc-surface-0);
      padding-bottom: clamp(4rem, 8vw, 7rem);
    }

    .register-head {
      padding: clamp(3rem, 6vw, 5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
      border-bottom: 1px solid var(--hc-rule);
    }

    .register-title {
      max-width: 20ch;
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 5vw, 3.8rem);
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.035em;
      color: var(--hc-text-primary);
    }

    .register-title-accent {
      color: var(--hc-gold);
    }

    .register-lead {
      max-width: 68ch;
      margin: 1.25rem 0 0;
      font-family: var(--font-body);
      font-size: 1.05rem;
      line-height: 1.72;
      color: var(--hc-text-secondary);
    }

    /* Only the spacing is local; the band itself is .hc-stat-band. */
    .register-stat-band {
      margin-top: clamp(2rem, 4vw, 3rem);
    }

    .register-body { padding-top: clamp(1.75rem, 3vw, 2.5rem); }

    .register-error {
      padding: 3rem 0;
      font-family: var(--font-body);
      font-size: 1.05rem;
      color: var(--hc-text-secondary);
    }

    /* ---- controls ---- */
    .register-controls {
      padding-bottom: 1.1rem;
      border-bottom: 1px solid var(--hc-rule);
    }

    /* Enhancement only: the clear control does nothing without the client
       module, so it is hidden until that module marks the register ready. */
    .register-search__clear {
      display: none;
      flex: none;
      min-width: 44px;
      border: 0;
      background: transparent;
      color: var(--hc-text-tertiary);
      font-size: 1.2rem;
      line-height: 1;
      cursor: pointer;
      transition: color var(--motion-fast) ease;
    }

    [data-register][data-ready="true"] .register-search__clear { display: block; }

    .register-search__clear:hover { color: var(--hc-text-primary); }

    .register-filters {
      display: grid;
      gap: 0.55rem;
      margin-top: 1.35rem;
    }

    .register-filter {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 0.9rem;
      align-items: start;
    }

    .register-filter__label {
      padding-top: 0.42rem;
      font-family: var(--font-ui);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--hc-text-tertiary);
    }

    /* Filters wrap instead of scrolling sideways; the old preset bar put a raw
       horizontal scrollbar under the controls. */
    .register-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.15rem 1.1rem;
    }

    .register-tab {
      text-decoration: none;
      padding: 0.35rem 0 0.4rem;
      border: 0;
      border-bottom: 1px solid transparent;
      background: transparent;
      color: var(--hc-text-secondary);
      font-family: var(--font-ui);
      font-size: 0.8rem;
      font-weight: 600;
      line-height: 1.2;
      cursor: pointer;
      transition: color 160ms ease, border-color 160ms ease;
    }

    .register-tab:hover { color: var(--hc-text-primary); }

    .register-tab.is-active {
      color: var(--hc-gold);
      border-bottom-color: var(--hc-gold);
    }

    .register-tab__n {
      font-size: 0.76rem;
      font-variant-numeric: tabular-nums;
      color: var(--hc-text-tertiary);
    }

    .register-toolbar {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1.5rem;
      margin-top: 1.35rem;
    }

    .register-status {
      font-family: var(--font-ui);
      font-size: 0.8rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      color: var(--hc-text-tertiary);
    }

    .register-sort {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-ui);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--hc-text-tertiary);
    }

    .register-sort select {
      padding: 0.3rem 0.2rem;
      border: 0;
      border-bottom: 1px solid var(--hc-rule-strong);
      background: transparent;
      color: var(--hc-text-primary);
      font-family: var(--font-ui);
      font-size: 0.82rem;
      text-transform: none;
      letter-spacing: 0;
    }

    /* ---- comparison dock ---- */
    .compare-dock {
      position: sticky;
      bottom: 0;
      z-index: 40;
      border-top: 1px solid var(--hc-rule-strong);
      background: var(--hc-surface-1);
    }

    .compare-dock__inner {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
    }

    .compare-dock__count {
      font-family: var(--font-ui);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--hc-text-tertiary);
      white-space: nowrap;
    }

    .compare-dock__count strong { color: var(--hc-gold); }

    .compare-dock__chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      flex: 1;
      min-width: 0;
    }

    .compare-dock__actions {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      white-space: nowrap;
    }

    .compare-dock__clear {
      border: 0;
      background: transparent;
      color: var(--hc-text-tertiary);
      font-family: var(--font-ui);
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
    }

    .compare-dock__clear:hover { color: var(--hc-text-primary); }

    @media (max-width: 700px) {
      .register-filter { grid-template-columns: 1fr; gap: 0.3rem; }
      .register-filter__label { padding-top: 0; }
      .register-toolbar { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
      .compare-dock__chips { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .register-tab, .register-search__clear { transition: none; }
    }
  </style>

  <!-- Rows are re-rendered client side after every filter change, so they can
       never carry Astro's scoping attribute. These rules are global by
       necessity; the class names are prefixed to keep them contained. -->
  <style is:global>
    /* ---- register rows ---- */
    .register-list {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--hc-rule-soft);
    }

    .register-list[aria-busy='true'] { opacity: 0.45; }

    .reg-row {
      display: grid;
      grid-template-columns: 1.9rem 3.1rem minmax(0, 1fr) 11rem auto;
      align-items: baseline;
      gap: 0.9rem;
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--hc-rule-soft);
      transition: background 160ms ease;
    }

    .reg-row:hover {
      background: linear-gradient(90deg,
        color-mix(in srgb, var(--hc-gold) 4%, transparent), transparent 70%);
    }

    /* Last in the DOM so it never takes tab priority over the row's own link,
       first in the grid so it keeps its position. Hidden until the client
       module is ready, because comparison is script-only. */
    .reg-pick {
      visibility: hidden;
      grid-column: 1;
      grid-row: 1;
      min-width: 24px;
      min-height: 24px;
      border: 1px solid var(--hc-rule);
      background: transparent;
      color: var(--hc-text-tertiary);
      font-family: var(--font-ui);
      font-size: 0.85rem;
      line-height: 1;
      cursor: pointer;
      transition: color 160ms ease, border-color 160ms ease;
    }

    [data-register][data-ready="true"] .reg-pick { visibility: visible; }

    .reg-pick:hover { color: var(--hc-gold); border-color: var(--hc-gold-dim); }

    .reg-pick.is-picked {
      color: var(--hc-text-inverse);
      background: var(--hc-gold);
      border-color: var(--hc-gold);
    }

    .reg-index {
      font-family: var(--font-ui);
      font-size: 0.76rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--hc-text-tertiary);
    }

    .reg-main {
      min-width: 0;
      text-decoration: none;
      display: block;
    }

    .reg-names {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .reg-name {
      font-family: var(--font-display);
      font-size: 1.12rem;
      font-weight: 500;
      line-height: 1.25;
      color: var(--hc-text-primary);
    }

    .reg-main:hover .reg-name { color: var(--hc-gold); }

    .reg-name-ar {
      font-family: var(--font-arabic);
      font-size: 1.02rem;
      line-height: 1.8;
      color: var(--hc-text-tertiary);
    }

    .reg-meta,
    .reg-counts {
      display: flex;
