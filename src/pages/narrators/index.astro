  // Helper: Grade CSS Class
  function getGradeClass(grade: string): string {
    const g = grade.toLowerCase();
    if (g.includes('thiqah') || g.includes('trustworthy')) return 'badge-thiqah';
    if (g.includes('sadooq') || g.includes('truthful')) return 'badge-sadooq';
    if (g.includes('maqbool') || g.includes('acceptable')) return 'badge-maqbool';
    if (g.includes('da\'if') || g.includes('weak')) return 'badge-daif';
    if (g.includes('matrook') || g.includes('abandoned')) return 'badge-matrook';
    if (g.includes('sahabi') || g.includes('companion')) return 'badge-sahabi';
    return 'badge-default';
  }

  // Load Data
  async function loadData() {
    try {
      const res = await fetch('/data/narrators/index.json');
      if (!res.ok) throw new Error('Failed to load transmitters index');
      allTransmitters = await res.json();
      
      const statTotal = document.getElementById('stat-total');
      if (statTotal) statTotal.textContent = allTransmitters.length.toLocaleString();

      loadingSpinner.style.display = 'none';
      applyFilters();

      // Check URL parameters: ?compare=3,7 or ?id=10511
      const urlParams = new URLSearchParams(window.location.search);
      const compareParam = urlParams.get('compare');
      if (compareParam) {
        const ids = compareParam.split(',').map(s => parseInt(s.trim(), 10)).filter(n => !isNaN(n));
        if (ids.length >= 2) {
          comparisonQueue = ids.slice(0, 3);
          updateComparisonDock();
          openComparisonWorkspace();
        }
      } else {
        const initialId = urlParams.get('id');
        if (initialId) {
          openDossier(parseInt(initialId, 10));
        }
      }

      const initialQuery = urlParams.get('q');
      if (initialQuery) {
        searchInput.value = initialQuery;
        applyFilters();
      }
    } catch (err) {
      console.error(err);
      loadingSpinner.innerHTML = '<p class="error-msg">Failed to load narrator index. Please refresh the page.</p>';
    }
  }

  function applyFilters() {
    const q = searchInput.value.trim().toLowerCase();
    const gen = filterGen.value;
    const grade = filterGrade.value;
    const city = filterCity.value.toLowerCase();
    const sort = filterSort.value;

    searchClear.style.display = q ? 'block' : 'none';

    filteredTransmitters = allTransmitters.filter((item) => {
      // Text search
      if (q) {
        const idMatch = `#${item.i}` === q || `${item.i}` === q;
        const enMatch = item.e.toLowerCase().includes(q);
        const arMatch = item.a.includes(q);
        const cityMatch = (item.dp + ' ' + item.ps).toLowerCase().includes(q);
        const tagMatch = item.t.some((tag) => tag.toLowerCase().includes(q));

        if (!idMatch && !enMatch && !arMatch && !cityMatch && !tagMatch) {
          return false;
        }
      }

      // Generation
      if (gen && item.g !== gen) return false;

      // Reliability
      if (grade && item.r !== grade) return false;

      // Hub / City
      if (city) {
        const fullLocation = (item.dp + ' ' + item.ps).toLowerCase();
        if (!fullLocation.includes(city)) return false;
      }

      return true;
    });

    // Sort
    filteredTransmitters.sort((a, b) => {
      if (sort === 'id-asc') return a.i - b.i;
      if (sort === 'id-desc') return b.i - a.i;
      if (sort === 'name-asc') return a.e.localeCompare(b.e);
      if (sort === 'death-asc') {
        const da = parseInt(a.dh, 10) || 9999;
        const db = parseInt(b.dh, 10) || 9999;
        return da - db;
      }
      if (sort === 'death-desc') {
        const da = parseInt(a.dh, 10) || -1;
        const db = parseInt(b.dh, 10) || -1;
        return db - da;
      }
      if (sort === 'students-desc') return b.sc - a.sc;
      if (sort === 'teachers-desc') return b.tc - a.tc;
      return a.i - b.i;
    });

    currentPage = 1;
    updateActiveChips();
    renderResults();
  }

  function updateActiveChips() {
    const chips: Array<{ label: string; clear: () => void }> = [];

    if (searchInput.value.trim()) {
      chips.push({
        label: `"${searchInput.value.trim()}"`,
        clear: () => {
          searchInput.value = '';
          applyFilters();
        }
      });
    }
    if (filterGen.value) {
      chips.push({
        label: filterGen.value,
        clear: () => {
          filterGen.value = '';
          applyFilters();
        }
      });
    }
    if (filterGrade.value) {
      chips.push({
        label: filterGrade.value,
        clear: () => {
          filterGrade.value = '';
          applyFilters();
        }
      });
    }
    if (filterCity.value) {
      chips.push({
        label: `Hub: ${filterCity.value}`,
        clear: () => {
          filterCity.value = '';
          applyFilters();
        }
      });
    }

    if (chips.length > 0) {
      activeBar.style.display = 'flex';
      activeChips.innerHTML = chips
        .map((c, idx) => `
          <button class="active-chip" data-chip-idx="${idx}">
            <span>${c.label}</span>
            <span class="active-chip__remove">&times;</span>
          </button>
        `)
        .join('');

      activeChips.querySelectorAll('.active-chip').forEach((el: any) => {
        el.addEventListener('click', () => {
          const idx = parseInt(el.getAttribute('data-chip-idx') || '0', 10);
          chips[idx]?.clear();
        });
      });
    } else {
      activeBar.style.display = 'none';
      activeChips.innerHTML = '';
    }
  }

  function renderResults() {
    const total = filteredTransmitters.length;
    resultsCountText.textContent = `Showing ${total.toLocaleString()} transmitter${total === 1 ? '' : 's'}`;

    if (total === 0) {
      tableView.style.display = 'none';
      gridView.style.display = 'none';
      paginationContainer.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    emptyState.style.display = 'none';
    paginationContainer.style.display = 'flex';

    const totalPages = Math.ceil(total / itemsPerPage);
    if (currentPage > totalPages) currentPage = totalPages;

    const startIdx = (currentPage - 1) * itemsPerPage;
    const endIdx = Math.min(startIdx + itemsPerPage, total);
    const pageItems = filteredTransmitters.slice(startIdx, endIdx);

    pageInfoText.textContent = `Page ${currentPage} of ${totalPages || 1}`;
    prevPageBtn.disabled = currentPage <= 1;
    nextPageBtn.disabled = currentPage >= totalPages;

    if (currentView === 'table') {
      tableView.style.display = 'block';
      gridView.style.display = 'none';
      renderTable(pageItems);
    } else {
      tableView.style.display = 'none';
      gridView.style.display = 'block';
      renderGrid(pageItems);
    }
  }

