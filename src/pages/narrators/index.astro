  // Comparison Management
  function toggleComparison(id: number) {
    const idx = comparisonQueue.indexOf(id);
    if (idx !== -1) {
      comparisonQueue.splice(idx, 1);
    } else {
      if (comparisonQueue.length >= 3) {
        alert('You can compare a maximum of 3 narrators at a time. Please remove one first.');
        return;
      }
      comparisonQueue.push(id);
    }

    updateComparisonDock();
    renderResults();
    updateModalCompareBtn();
  }

  function updateComparisonDock() {
    const count = comparisonQueue.length;
    dockCount.textContent = count.toString();
    document.querySelectorAll('.compare-count-val').forEach((el: any) => {
      el.textContent = count.toString();
    });

    if (count > 0) {
      comparisonDock.style.display = 'block';
      openCompareBtnHead.style.display = 'inline-flex';

      dockChips.innerHTML = comparisonQueue
        .map((id) => {
          const item = allTransmitters.find((t) => t.i === id);
          const name = item ? item.e : `#${id}`;
          return `
            <span class="dock-chip">
              <span class="dock-chip__id">#${id}</span>
              <span class="dock-chip__name">${name}</span>
              <button class="dock-chip__remove" data-remove-id="${id}">&times;</button>
            </span>
          `;
        })
        .join('');

      dockChips.querySelectorAll('[data-remove-id]').forEach((btn: any) => {
        btn.addEventListener('click', (e: MouseEvent) => {
          e.stopPropagation();
          const id = parseInt(btn.getAttribute('data-remove-id') || '0', 10);
          toggleComparison(id);
        });
      });
    } else {
      comparisonDock.style.display = 'none';
      openCompareBtnHead.style.display = 'none';
      dockChips.innerHTML = '';
    }
  }

  function updateModalCompareBtn() {
    if (!activeDossierId) return;
    const isQueued = comparisonQueue.includes(activeDossierId);
    modalCompareToggleBtn.textContent = isQueued ? '✓ In Compare' : '+ Compare';
    modalCompareToggleBtn.classList.toggle('is-selected', isQueued);
  }

  // Fetch Full Transmitter Profile
  async function fetchTransmitterDetail(id: number): Promise<RawiDetail | null> {
    const chunkIdx = Math.floor((id - 1) / 1000);
    if (!chunkCache.has(chunkIdx)) {
      try {
        const res = await fetch(`/data/narrators/chunks/chunk_${chunkIdx}.json`);
        if (!res.ok) throw new Error(`Failed to load chunk ${chunkIdx}`);
        const chunkData = (await res.json()) as Record<string, RawiDetail>;
        chunkCache.set(chunkIdx, chunkData);
      } catch (e) {
        console.error(e);
        return null;
      }
    }
    const chunk = chunkCache.get(chunkIdx);
    return chunk ? chunk[id] || null : null;
  }

  // Open Comparison Workspace
  async function openComparisonWorkspace() {
    if (comparisonQueue.length < 2) {
      alert('Please select at least 2 narrators to compare side-by-side.');
      return;
    }

    compareModal.classList.add('is-open');
    compareModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    // Update URL parameter
    const newUrl = new URL(window.location.href);
    newUrl.searchParams.set('compare', comparisonQueue.join(','));
    newUrl.searchParams.delete('id');
    window.history.pushState({}, '', newUrl.toString());

    compareGrid.innerHTML = `
      <div class="compare-loading">
        <div class="spinner"></div>
        <p>Loading comparative dossiers & isnād overlap analysis...</p>
      </div>
    `;

    // Fetch details for all queued narrators
    const details = await Promise.all(comparisonQueue.map((id) => fetchTransmitterDetail(id)));
    const validDetails = details.filter((d): d is RawiDetail => d !== null);

    if (validDetails.length < 2) {
      compareGrid.innerHTML = '<p class="error-msg">Could not load comparative data.</p>';
      return;
    }

    renderComparisonMatrix(validDetails);
  }

  function renderComparisonMatrix(profiles: RawiDetail[]) {
    // 1. Identify Shared Authorities (Teachers)
    const teacherIdMaps = profiles.map((p) => new Set((p.teachers || []).map((t) => t.id).filter(Boolean)));
    const sharedTeacherIds: number[] = [];

    if (teacherIdMaps.length >= 2) {
      const firstSet = teacherIdMaps[0];
      for (const tid of firstSet) {
        if (teacherIdMaps.every((s) => s.has(tid))) {
          sharedTeacherIds.push(tid as number);
        }
      }
    }

    const sharedTeachers = sharedTeacherIds
      .map((tid) => {
        for (const p of profiles) {
          const found = (p.teachers || []).find((t) => t.id === tid);
          if (found) return found;
        }
        return null;
      })
      .filter((t): t is RelationItem => t !== null);

    if (sharedTeachers.length > 0) {
      sharedTeachersContainer.innerHTML = sharedTeachers
        .map((t) => `
          <button class="relation-chip relation-chip--shared" data-pivot-id="${t.id}">
            <span>${t.name}</span>
            <span class="chip-id">#${t.id}</span>
            <span class="shared-tag">Shared</span>
          </button>
        `)
        .join('');
    } else {
      sharedTeachersContainer.innerHTML = '<span class="overlap-empty">No direct common teachers recorded in this corpus.</span>';
    }

    // 2. Identify Shared Transmitters (Students)
    const studentIdMaps = profiles.map((p) => new Set((p.students || []).map((s) => s.id).filter(Boolean)));
    const sharedStudentIds: number[] = [];

    if (studentIdMaps.length >= 2) {
      const firstSet = studentIdMaps[0];
      for (const sid of firstSet) {
        if (studentIdMaps.every((s) => s.has(sid))) {
          sharedStudentIds.push(sid as number);
        }
      }
    }

    const sharedStudents = sharedStudentIds
      .map((sid) => {
        for (const p of profiles) {
          const found = (p.students || []).find((s) => s.id === sid);
          if (found) return found;
        }
        return null;
      })
      .filter((s): s is RelationItem => s !== null);

    if (sharedStudents.length > 0) {
      sharedStudentsContainer.innerHTML = sharedStudents
        .map((s) => `
          <button class="relation-chip relation-chip--shared" data-pivot-id="${s.id}">
            <span>${s.name}</span>
            <span class="chip-id">#${s.id}</span>
            <span class="shared-tag">Shared</span>
          </button>
        `)
        .join('');
    } else {
      sharedStudentsContainer.innerHTML = '<span class="overlap-empty">No direct common students recorded in this corpus.</span>';
    }

    // 3. Chronological & Geographic Overlap
    const deathYears = profiles.map((p) => parseInt(p.deathHijri, 10)).filter((y) => !isNaN(y));
    let coexistenceMsg = '';
    if (deathYears.length >= 2) {
      const minD = Math.min(...deathYears);
      const maxD = Math.max(...deathYears);
      const diff = maxD - minD;
      if (diff <= 35) {
        coexistenceMsg = `Contemporary contemporaries (death gap of ${diff} years: ${minD} AH – ${maxD} AH). Potential physical meeting (muʿāṣarah) verified.`;
      } else {
        coexistenceMsg = `Separated by ${diff} years (${minD} AH vs ${maxD} AH). Direct transmission chronologically ${diff > 75 ? 'impossible' : 'unlikely'}.`;
      }
    } else {
      coexistenceMsg = 'Chronological dates incomplete in classical register.';
    }

    // Find common cities of stay
    const citySets = profiles.map((p) => {
      const str = (p.placesOfStay || '') + ',' + (p.deathPlace || '');
      return new Set(str.split(',').map((c) => c.trim().toLowerCase()).filter(Boolean));
    });
    const commonCities: string[] = [];
    if (citySets.length >= 2) {
      for (const city of citySets[0]) {
        if (citySets.every((s) => s.has(city))) {
          commonCities.push(city);
        }
      }
    }

    const cityMsg = commonCities.length > 0
      ? ` Common regional hubs: ${commonCities.map(c => c.charAt(0).toUpperCase() + c.slice(1)).join(', ')}.`
      : '';

    coexistenceText.textContent = coexistenceMsg + cityMsg;

    // 4. Render Multi-Column Matrix
    compareGrid.style.gridTemplateColumns = `repeat(${profiles.length}, 1fr)`;
    compareGrid.innerHTML = profiles
      .map((p) => {
        const gradeBadge = `<span class="badge ${getGradeClass(p.grade)}">${p.grade}</span>`;
        const deathText = p.deathDatePlace || p.deathPlace || (p.deathHijri ? `${p.deathHijri} AH` : '—');
        const birthText = p.birthDatePlace || p.birthPlace || (p.birthHijri ? `${p.birthHijri} AH` : '—');

        const renderRelations = (items: RelationItem[], sharedIds: number[]) => {
          if (!items || items.length === 0) return '<p class="network-empty">None recorded</p>';
          return items
            .map((item) => {
              const isShared = item.id && sharedIds.includes(item.id);
              return item.id
                ? `<button class="relation-chip ${isShared ? 'relation-chip--shared' : ''}" data-pivot-id="${item.id}">
                    <span>${item.name}</span>
                    <span class="chip-id">#${item.id}</span>
                    ${isShared ? '<span class="shared-indicator">★ Shared</span>' : ''}
                  </button>`
                : `<span class="relation-chip relation-chip--static">${item.name}</span>`;
            })
            .join('');
        };

        const stayPath = (p.placesOfStay || '')
          .split(',')
          .map((c) => c.trim())
          .filter(Boolean)
          .map((c) => `<span class="stay-node">${c}</span>`)
          .join('<span class="stay-arrow">&rarr;</span>') || '—';

        return `
          <div class="compare-col">
            <div class="compare-col__head">
              <span class="id-tag">#${p.id}</span>
              <h3 class="compare-col__name-en">${p.nameEn}</h3>
              ${p.nameAr ? `<p class="compare-col__name-ar" dir="rtl" lang="ar">${p.nameAr}</p>` : ''}
              <div class="compare-col__badges">
                <span class="dossier-badge dossier-badge--gen">${p.generation}</span>
                ${gradeBadge}
              </div>
            </div>

            <div class="compare-col__section">
              <h4 class="col-section-title">Vital Dates & Hubs</h4>
              <div class="col-field">
                <span class="col-field__label">Birth</span>
                <span class="col-field__val">${birthText}</span>
              </div>
              <div class="col-field">
                <span class="col-field__label">Death</span>
                <span class="col-field__val">${deathText} ${p.deathReason ? `[${p.deathReason}]` : ''}</span>
              </div>
              <div class="col-field">
                <span class="col-field__label">Places of Stay</span>
                <div class="stay-path">${stayPath}</div>
              </div>
            </div>

            <div class="compare-col__section">
              <h4 class="col-section-title">Teachers (${p.teachers?.length || 0})</h4>
              <div class="col-chips-scroll">
                ${renderRelations(p.teachers, sharedTeacherIds)}
              </div>
            </div>

            <div class="compare-col__section">
              <h4 class="col-section-title">Students (${p.students?.length || 0})</h4>
              <div class="col-chips-scroll">
                ${renderRelations(p.students, sharedStudentIds)}
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    // Attach pivot handlers inside compare grid
    compareGrid.querySelectorAll('[data-pivot-id]').forEach((el: any) => {
      el.addEventListener('click', () => {
        const pivotId = parseInt(el.getAttribute('data-pivot-id') || '0', 10);
        if (pivotId) {
          closeComparisonWorkspace();
          openDossier(pivotId);
        }
      });
    });

    sharedTeachersContainer.querySelectorAll('[data-pivot-id]').forEach((el: any) => {
      el.addEventListener('click', () => {
        const pivotId = parseInt(el.getAttribute('data-pivot-id') || '0', 10);
        if (pivotId) {
          closeComparisonWorkspace();
          openDossier(pivotId);
        }
      });
    });

    sharedStudentsContainer.querySelectorAll('[data-pivot-id]').forEach((el: any) => {
      el.addEventListener('click', () => {
        const pivotId = parseInt(el.getAttribute('data-pivot-id') || '0', 10);
        if (pivotId) {
          closeComparisonWorkspace();
          openDossier(pivotId);
        }
      });
    });
  }

  function closeComparisonWorkspace() {
    compareModal.classList.remove('is-open');
    compareModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';

    const newUrl = new URL(window.location.href);
    newUrl.searchParams.delete('compare');
    window.history.pushState({}, '', newUrl.toString());
  }

  // Dossier Loading & Opening
  async function openDossier(id: number) {
    activeDossierId = id;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    modalId.textContent = `#${id}`;
    modalLoading.style.display = 'flex';
    modalBody.style.display = 'none';

    updateModalCompareBtn();

    const newUrl = new URL(window.location.href);
    newUrl.searchParams.set('id', id.toString());
    newUrl.searchParams.delete('compare');
    window.history.pushState({ id }, '', newUrl.toString());

    switchNetworkTab('teachers');

    const detail = await fetchTransmitterDetail(id);
    if (!detail) {
      modalLoading.innerHTML = '<p class="error-msg">Could not load details for this transmitter.</p>';
      return;
    }

    modalNameEn.textContent = detail.nameEn || detail.rawName;
    modalNameAr.textContent = detail.nameAr || '';
    modalNameAr.style.display = detail.nameAr ? 'block' : 'none';

    modalGen.textContent = detail.generation;
    modalGrade.textContent = detail.grade;
    modalGrade.className = `dossier-badge dossier-badge--grade ${getGradeClass(detail.grade)}`;

    modalBirth.textContent = detail.birthDatePlace || detail.birthPlace || (detail.birthHijri ? `${detail.birthHijri} AH` : '—');
    modalDeath.textContent = detail.deathDatePlace || detail.deathPlace || (detail.deathHijri ? `${detail.deathHijri} AH` : '—');
    
    if (detail.deathReason) {
      document.getElementById('modal-death-reason-card')!.style.display = 'block';
      modalDeathReason.textContent = detail.deathReason;
    } else {
      document.getElementById('modal-death-reason-card')!.style.display = 'none';
    }

    const places = detail.placesOfStay
      ? detail.placesOfStay.split(',').map((p) => p.trim()).filter(Boolean)
      : [];
    if (places.length > 0) {
      modalPlacesPath.innerHTML = places
        .map((p) => `<span class="stay-node">${p}</span>`)
        .join('<span class="stay-arrow">&rarr;</span>');
    } else {
      modalPlacesPath.innerHTML = '<span class="meta-val">No recorded journeys</span>';
    }

    modalInterests.innerHTML = detail.areaOfInterest
      ? `<span class="interest-tag">${detail.areaOfInterest}</span>`
      : '';
    modalTags.innerHTML = detail.tags
      ? detail.tags.map((t) => `<span class="canonical-tag">${t}</span>`).join('')
      : '';

    // Family
    const familyHtml: string[] = [];
    const renderFamilyGroup = (title: string, list: RelationItem[]) => {
      if (!list || list.length === 0) return;
      const chips = list
        .map((m) =>
          m.id
            ? `<button class="relation-chip" data-pivot-id="${m.id}">${m.name} <span class="chip-id">#${m.id}</span></button>`
            : `<span class="relation-chip relation-chip--static">${m.name}</span>`
        )
        .join('');
      familyHtml.push(`
        <div class="family-group">
          <span class="family-group__label">${title}:</span>
          <div class="family-group__chips">${chips}</div>
        </div>
      `);
    };

    renderFamilyGroup('Parents', detail.parents);
    renderFamilyGroup('Spouses', detail.spouse);
    renderFamilyGroup('Siblings', detail.siblings);
    renderFamilyGroup('Children', detail.children);

    if (familyHtml.length > 0) {
      document.getElementById('modal-family-section')!.style.display = 'block';
      modalFamilyGroups.innerHTML = familyHtml.join('');
    } else {
      document.getElementById('modal-family-section')!.style.display = 'none';
    }

    modalTeachersCount.textContent = (detail.teachers?.length || 0).toString();
    modalStudentsCount.textContent = (detail.students?.length || 0).toString();

    const renderNetworkList = (list: RelationItem[], container: HTMLElement) => {
      if (!list || list.length === 0) {
        container.innerHTML = '<p class="network-empty">No direct entries recorded in this corpus.</p>';
        return;
      }
      container.innerHTML = list
        .map((rel) =>
          rel.id
            ? `<button class="relation-chip" data-pivot-id="${rel.id}">
                <span class="relation-chip__name">${rel.name}</span>
                <span class="chip-id">#${rel.id}</span>
              </button>`
            : `<span class="relation-chip relation-chip--static">${rel.name}</span>`
        )
        .join('');
    };

    renderNetworkList(detail.teachers, modalTeachersList);
    renderNetworkList(detail.students, modalStudentsList);

    modal.querySelectorAll('[data-pivot-id]').forEach((el: any) => {
      el.addEventListener('click', () => {
        const pivotId = parseInt(el.getAttribute('data-pivot-id') || '0', 10);
        if (pivotId) openDossier(pivotId);
      });
    });

    modalLoading.style.display = 'none';
    modalBody.style.display = 'block';
  }

  function closeDossier() {
    activeDossierId = null;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';

    const newUrl = new URL(window.location.href);
    newUrl.searchParams.delete('id');
    window.history.pushState({}, '', newUrl.toString());
  }

  function switchNetworkTab(tab: 'teachers' | 'students') {
    if (tab === 'teachers') {
      tabTeachersBtn.classList.add('is-active');
      tabTeachersBtn.setAttribute('aria-selected', 'true');
      tabStudentsBtn.classList.remove('is-active');
      tabStudentsBtn.setAttribute('aria-selected', 'false');

      paneTeachers.style.display = 'block';
      paneStudents.style.display = 'none';
    } else {
      tabStudentsBtn.classList.add('is-active');
      tabStudentsBtn.setAttribute('aria-selected', 'true');
      tabTeachersBtn.classList.remove('is-active');
      tabTeachersBtn.setAttribute('aria-selected', 'false');

      paneStudents.style.display = 'block';
      paneTeachers.style.display = 'none';
    }
  }

  // Academic Citation Generator
  function openCitationDialog() {
    if (!activeDossierId) return;
    const item = allTransmitters.find((t) => t.i === activeDossierId);
    if (!item) return;

    const deathPart = item.dh ? `d. ${item.dh} AH / ${item.dg} CE` : 'n.d.';
    const placePart = item.dp ? `, ${item.dp}` : '';
    const cite = `HadithCritic Rijāl Register, s.v. "${item.e}" (Ar. ${item.a || item.e}, ${deathPart}${placePart}), Scholar Index #${item.i}, accessed ${new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}, https://hadithcriticblog.com/narrators?id=${item.i}.`;

    citationText.textContent = cite;
    citationModal.classList.add('is-open');
    citationModal.setAttribute('aria-hidden', 'false');
  }

  function closeCitationDialog() {
    citationModal.classList.remove('is-open');
    citationModal.setAttribute('aria-hidden', 'true');
  }

  // Research Presets Handling
  document.querySelectorAll('.preset-btn').forEach((btn: any) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-btn').forEach((b: any) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const preset = btn.getAttribute('data-preset');
      // Reset standard filters
      filterGen.value = '';
      filterGrade.value = '';
      filterCity.value = '';

      if (preset === 'sahaba') {
        filterGen.value = 'Companion (Sahabi)';
      } else if (preset === 'tabiun') {
        filterGen.value = 'Follower (Tabi\'i)';
      } else if (preset === 'medina') {
        filterCity.value = 'Medina';
      } else if (preset === 'kufa') {
        filterCity.value = 'Kufa';
      } else if (preset === 'basra') {
        filterCity.value = 'Basra';
      } else if (preset === 'thiqah') {
        filterGrade.value = 'Thiqah (Trustworthy)';
      }

      applyFilters();
    });
  });

  // Event Listeners
  searchInput.addEventListener('input', applyFilters);
  searchClear.addEventListener('click', () => {
    searchInput.value = '';
    applyFilters();
    searchInput.focus();
  });

  filterGen.addEventListener('change', applyFilters);
  filterGrade.addEventListener('change', applyFilters);
  filterCity.addEventListener('change', applyFilters);
  filterSort.addEventListener('change', applyFilters);

  perPageSelect.addEventListener('change', () => {
    itemsPerPage = parseInt(perPageSelect.value, 10) || 50;
    currentPage = 1;
    renderResults();
  });

  resetFiltersBtn.addEventListener('click', () => {
    searchInput.value = '';
    filterGen.value = '';
    filterGrade.value = '';
    filterCity.value = '';
    filterSort.value = 'id-asc';
    document.querySelectorAll('.preset-btn').forEach((b: any) => b.classList.remove('is-active'));
    document.querySelector('.preset-btn[data-preset="all"]')?.classList.add('is-active');
    applyFilters();
  });

  emptyResetBtn.addEventListener('click', () => {
    searchInput.value = '';
    filterGen.value = '';
    filterGrade.value = '';
    filterCity.value = '';
    filterSort.value = 'id-asc';
    document.querySelectorAll('.preset-btn').forEach((b: any) => b.classList.remove('is-active'));
    document.querySelector('.preset-btn[data-preset="all"]')?.classList.add('is-active');
    applyFilters();
  });

  viewTableBtn.addEventListener('click', () => {
    currentView = 'table';
    viewTableBtn.classList.add('is-active');
    viewTableBtn.setAttribute('aria-pressed', 'true');
    viewGridBtn.classList.remove('is-active');
    viewGridBtn.setAttribute('aria-pressed', 'false');
    renderResults();
  });

  viewGridBtn.addEventListener('click', () => {
    currentView = 'grid';
    viewGridBtn.classList.add('is-active');
    viewGridBtn.setAttribute('aria-pressed', 'true');
    viewTableBtn.classList.remove('is-active');
    viewTableBtn.setAttribute('aria-pressed', 'false');
    renderResults();
  });

  prevPageBtn.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderResults();
      window.scrollTo({ top: document.querySelector('.explorer-toolbar')?.getBoundingClientRect().top ?? 0 + window.scrollY - 80, behavior: 'smooth' });
    }
  });

  nextPageBtn.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredTransmitters.length / itemsPerPage);
    if (currentPage < totalPages) {
      currentPage++;
      renderResults();
      window.scrollTo({ top: document.querySelector('.explorer-toolbar')?.getBoundingClientRect().top ?? 0 + window.scrollY - 80, behavior: 'smooth' });
    }
  });

  tabTeachersBtn.addEventListener('click', () => switchNetworkTab('teachers'));
  tabStudentsBtn.addEventListener('click', () => switchNetworkTab('students'));

  modalCloseBtn.addEventListener('click', closeDossier);
  modalBackdrop.addEventListener('click', closeDossier);

  modalCopyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(window.location.href);
    copyTooltip.classList.add('is-visible');
    setTimeout(() => {
      copyTooltip.classList.remove('is-visible');
    }, 1800);
  });

  modalCiteBtn.addEventListener('click', openCitationDialog);
  modalCompareToggleBtn.addEventListener('click', () => {
    if (activeDossierId) {
      toggleComparison(activeDossierId);
    }
  });

  // Dock Buttons
  dockClearBtn.addEventListener('click', () => {
    comparisonQueue = [];
    updateComparisonDock();
    renderResults();
    updateModalCompareBtn();
  });

  dockCompareBtn.addEventListener('click', openComparisonWorkspace);
  openCompareBtnHead.addEventListener('click', openComparisonWorkspace);

  compareCloseBtn.addEventListener('click', closeComparisonWorkspace);
  compareBackdrop.addEventListener('click', closeComparisonWorkspace);

  compareExportBtn.addEventListener('click', async () => {
    const details = await Promise.all(comparisonQueue.map((id) => fetchTransmitterDetail(id)));
    const valid = details.filter((d): d is RawiDetail => d !== null);
    if (valid.length === 0) return;

    let md = `# Comparative Hadith Transmitter Analysis\n\n`;
    md += `*Generated from HadithCritic Rijāl Register (${new Date().toLocaleDateString()})*\n\n`;
    valid.forEach((p) => {
      md += `## #${p.id} ${p.nameEn} (${p.nameAr || ''})\n`;
      md += `- **Generation:** ${p.generation}\n`;
      md += `- **Grade:** ${p.grade}\n`;
      md += `- **Lifespan:** ${p.birthDatePlace || 'n.d.'} — ${p.deathDatePlace || 'n.d.'}\n`;
      md += `- **Places of Stay:** ${p.placesOfStay || '—'}\n`;
      md += `- **Teachers (${p.teachers?.length || 0}):** ${p.teachers?.map(t => t.name).join(', ') || 'None'}\n`;
      md += `- **Students (${p.students?.length || 0}):** ${p.students?.map(s => s.name).join(', ') || 'None'}\n\n`;
    });

    navigator.clipboard.writeText(md);
    alert('Comparison research notes copied to clipboard in Markdown format!');
  });

  citationCloseBtn.addEventListener('click', closeCitationDialog);
  citationBackdrop.addEventListener('click', closeCitationDialog);
  citationCopyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(citationText.textContent || '');
    citationCopyBtn.textContent = 'Copied!';
    setTimeout(() => {
      citationCopyBtn.textContent = 'Copy Citation';
      closeCitationDialog();
    }, 1200);
  });

  // Global Keyboard Shortcuts
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      searchInput.focus();
    }
    if ((e.key === 'c' || e.key === 'C') && document.activeElement !== searchInput) {
      if (comparisonQueue.length >= 2 && !compareModal.classList.contains('is-open')) {
        openComparisonWorkspace();
      }
    }
    if (e.key === 'Escape') {
      if (citationModal.classList.contains('is-open')) closeCitationDialog();
      else if (compareModal.classList.contains('is-open')) closeComparisonWorkspace();
      else if (modal.classList.contains('is-open')) closeDossier();
    }
  });

  // Handle browser back/forward buttons
  window.addEventListener('popstate', (e) => {
    if (e.state && e.state.id) {
      openDossier(e.state.id);
    } else {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      compareModal.classList.remove('is-open');
      compareModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  });

  // Init
  loadData();
</script>

<style>
