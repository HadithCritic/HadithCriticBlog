---
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Side-by-side comparison of selected transmitters.
 *
 * The previous register had this as a modal workspace, which meant a comparison
 * could not be linked, shared or cited. The selection lives in the URL
 * (?ids=3,2779,2472), so a comparison is a real address a researcher can put in
 * a footnote or send to someone.
 *
 * Prerendered, and filled from the static corpus in the browser: the table
 * depends only on the query string, which a static page keeps, and there are
 * 20,950 transmitters to draw from. `noindex` because a comparison is a
 * workspace rather than a document, which is why losing server-rendered HTML
 * here costs nothing.
 */

/** As many columns as stay readable on a wide screen. */
const MAX = 6;
---

<BaseLayout
  title="Compare Transmitters | Rijāl Archive | HadithCritic"
  description="Side-by-side comparison of classical hadith transmitters from the rijāl register."
  noindex={true}
>
  <div class="compare-page">
    <div class="wrap">
      <nav class="compare-crumb" aria-label="Breadcrumb">
        <a href="/narrators">← Rijāl register</a>
      </nav>

      <h1 class="compare-title">Compare Transmitters</h1>

      <div data-compare-mount data-max={MAX}>
        <p class="compare-empty">Reading the register…</p>
      </div>

      <noscript>
        <p class="compare-empty">
          Comparisons are assembled from a static SQLite corpus inside your
          browser, which needs JavaScript. Each transmitter also has their own
          page in the <a href="/narrators">register</a>.
        </p>
      </noscript>
    </div>
  </div>

  <script>
    import { initNarratorCompare } from '../../lib/narrator-compare';
    initNarratorCompare();
  </script>

  <style is:global>
    /*
      Global rather than scoped: the table below is created by
      src/lib/narrator-compare.ts once the corpus answers, and a node created by
      script never carries the page's data-astro-cid attribute.
    */
    .compare-page {
      background: var(--hc-surface-0);
      padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(4rem, 8vw, 7rem);
    }

    .compare-crumb {
      margin-bottom: 1.25rem;
      font-family: var(--font-ui);
      font-size: 0.8rem;
    }

    .compare-crumb a { color: var(--hc-text-tertiary); text-decoration: none; }
    .compare-crumb a:hover { color: var(--hc-gold); }

    .compare-title {
      margin: 0 0 1.75rem;
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 2.9rem);
      font-weight: 500;
      line-height: 1.05;
      letter-spacing: -0.03em;
      color: var(--hc-text-primary);
    }

    .compare-empty {
      max-width: 60ch;
      font-family: var(--font-body);
      font-size: 1.05rem;
      line-height: 1.7;
      color: var(--hc-text-secondary);
    }

    .compare-empty a { color: var(--hc-gold); }

    /* Wide comparisons scroll inside their own container so the page never does. */
    .compare-scroll { overflow-x: auto; }

    .compare-table {
      width: 100%;
      border-collapse: collapse;
      font-family: var(--font-ui);
      font-size: 0.88rem;
    }

    .compare-table th,
    .compare-table td {
      padding: 0.7rem 0.9rem 0.7rem 0;
      text-align: left;
      vertical-align: baseline;
      border-bottom: 1px solid var(--hc-rule-soft);
    }

    .compare-table thead th {
      padding-bottom: 0.9rem;
      border-bottom: 1px solid var(--hc-rule);
      font-family: var(--font-display);
      font-size: 1.06rem;
      font-weight: 500;
      color: var(--hc-text-primary);
    }

    .compare-table thead th a { color: inherit; text-decoration: none; }
    .compare-table thead th a:hover { color: var(--hc-gold); }

    .compare-id {
      display: block;
      margin-top: 0.2rem;
      font-family: var(--font-ui);
      font-size: 0.76rem;
      font-variant-numeric: tabular-nums;
      color: var(--hc-text-tertiary);
    }

    .compare-table tbody th {
      width: 9rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--hc-text-tertiary);
    }

    .compare-table td { color: var(--hc-text-secondary); }
    .compare-table td[lang='ar'] { font-family: var(--font-arabic); font-size: 1.05rem; line-height: 1.9; }
  </style>
</BaseLayout>
