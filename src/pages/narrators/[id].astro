  }

  .rijal-spinner {
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--hc-rule-soft);
    border-top-color: var(--hc-gold);
    border-radius: 50%;
    animation: rijal-spin 900ms linear infinite;
  }

  @keyframes rijal-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rijal-spinner {
      animation: none;
    }
  }

  .rijal-page {
    max-width: 68rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
  }

  /* ---- Hero & Biographical Header Plate ---- */
