---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { person, entityPage } from '../../lib/seo';
import { db } from '../../lib/db';
import { toPlainText } from '../../lib/format-text';

/**
 * Rijal dossier, rendered on demand from the database.
 *
 * This page used to be prerendered via getStaticPaths, which meant it existed
 * for only 8,000 of the 20,950 narrators: Cloudflare Workers cap a deployment
 * at 20,000 files and the build was already at 17,818. Reading from a database removes
 * both limits at once — every narrator now has a URL, and 8,000 HTML files
 * leave the build.
 *
 * It also fixes a data split. The criticism shards under public/ deliberately
 * carried only the narrators *without* a page, so the apparatus had to be
 * inlined at build time here and fetched client-side there. D1 holds the whole
 * 54 MB set, so both paths read the same rows.
 */

type Verdict = 'jarh' | 'tadil' | 'mixed' | 'unclassified';

interface Relation {
  id: number;
  name: string;
  count: number;
}

interface Statement {
  text: string;
  citation: string;
  pageId: number | null;
  verdict: Verdict;
}

interface Detail {
  id: number;
  nameEn: string;
  nameAr: string;
  fullName: string;
  kunya: string;
  nickname: string;
  lineage: string;
  relation: string;
  generation: string;
  grade: string;
  tabaqa: string;
  tabaqaEn: string;
  tabaqaNumber: number | null;
  rankIbnHajar: string;
  rankIbnHajarEn: string;
  rankDhahabi: string;
  rankDhahabiEn: string;
  madhhab: string;
  madhhabEn: string;
  flags: string[];
  deathPlace: string;
  placesEn: string[];
  placesAr: string[];
  deathDate: string;
  deathHijri: string;
  deathGregorian: string;
  hadithCount: number;
  aliasCount: number;
  aliases: { form: string; count: number }[];
  teachers: Relation[];
  students: Relation[];
  books: { book: string; count: number }[];
  positions: { pos: number; count: number }[];
  sampleChains: { book: string; number: string; path: number[] }[];
}

interface Criticism {
  criticCount: number;
  statementCount: number;
  tally: Record<Verdict, number>;
  critics: { critic: string; statements: Statement[] }[];
  phenomena: { key: string; label: string; statements: Statement[] }[];
}

const id = Number(Astro.params.id);
if (!Number.isFinite(id) || id < 0) return Astro.redirect('/narrators', 302);

interface StatementRow {
  critic: string;
  text: string;
  citation: string;
  page_id: number | null;
  verdict: Verdict;
  phenomenon_key: string | null;
  phenomenon_label: string | null;
}

const [detailRow, statementRows] = await db.batch([
  db.prepare('SELECT payload FROM narrator_detail WHERE id = ?').bind(id),
  db.prepare(
    `SELECT critic, text, citation, page_id, verdict, phenomenon_key, phenomenon_label
       FROM criticism_statement WHERE narrator_id = ? ORDER BY ord`
  ).bind(id)
]);

const detailPayload = detailRow.results?.[0] as { payload?: string } | undefined;
if (!detailPayload?.payload) {
  return new Response('Narrator not found', { status: 404 });
}

const detail = JSON.parse(detailPayload.payload) as Detail;

/**
 * Rebuild the shape the template already expects from the normalised rows.
 * Criticism is stored one statement per row so it stays queryable and so no
 * single narrator's apparatus exceeds D1's statement ceiling; grouping it back
 * into critics happens here rather than changing the whole template.
 */
const rows = (statementRows.results || []) as unknown as StatementRow[];
let criticism: Criticism | null = null;

if (rows.length) {
  const byCritic = new Map<string, Statement[]>();
  const byPhenomenon = new Map<string, { key: string; label: string; statements: Statement[] }>();
  const tally: Record<Verdict, number> = { jarh: 0, tadil: 0, mixed: 0, unclassified: 0 };

  for (const r of rows) {
    const statement: Statement = {
      text: r.text,
      citation: r.citation,
      pageId: r.page_id,
      verdict: r.verdict
    };
    if (!byCritic.has(r.critic)) byCritic.set(r.critic, []);
    byCritic.get(r.critic)!.push(statement);

    if (tally[r.verdict] !== undefined) tally[r.verdict] += 1;

    if (r.phenomenon_key) {
      if (!byPhenomenon.has(r.phenomenon_key)) {
        byPhenomenon.set(r.phenomenon_key, {
          key: r.phenomenon_key,
          label: r.phenomenon_label || r.phenomenon_key,
          statements: []
        });
      }
      byPhenomenon.get(r.phenomenon_key)!.statements.push(statement);
    }
  }

  criticism = {
    criticCount: byCritic.size,
    statementCount: rows.length,
    tally,
    critics: [...byCritic].map(([critic, statements]) => ({ critic, statements })),
    phenomena: [...byPhenomenon.values()]
  };
}

/**
 * Sample chains store narrator ids, not names, to keep the dossier payload
 * small. Resolve just the ids this page links to in one query rather than
 * carrying a 20,950-entry name map.
 */
const referenced = [
  ...(detail.sampleChains || []).flatMap((c) => c.path),
  ...(detail.teachers || []).map((t) => t.id),
  ...(detail.students || []).map((t) => t.id)
];
const uniqueIds = [...new Set(referenced)].filter((n) => Number.isFinite(n));

const chainNames: Record<string, string> = {};
if (uniqueIds.length) {
  const placeholders = uniqueIds.map(() => '?').join(',');
  const named = await db.prepare(
    `SELECT id, name_en, name_ar FROM narrator WHERE id IN (${placeholders})`
  )
    .bind(...uniqueIds)
    .all<{ id: number; name_en: string; name_ar: string }>();
  for (const row of named.results || []) {
    chainNames[row.id] = row.name_en || row.name_ar;
  }
}

// Every narrator in D1 now has a page, so anything we resolved a name for is
// safe to link. The old build had to gate this on the prerendered subset.
const linkableIds = new Set(Object.keys(chainNames).map(Number));

/**
 * What this transmitter actually narrated.
 *
 * The dossier already reports what the critics said about him. This is the
 * other half of the evidence, and until the corpus landed in D1 the site could
 * not show it: the register's `hadith_count` was a number with nothing behind
 * it. `hadith_narrator.narrator_id` is the same integer as `narrator.id` —
 * verified across all 20,950 shared rows — so this is one indexed lookup and
 * not a reconciliation.
 *
 * A sample is enough on this page; the full list lives at /hadith?narrator={id}.
 */
interface Transmission {
  id: number;
  hadith_num: string;
  book_en: string;
  matn_en: string | null;
  pos: number;
  narrator_count: number;
  parallel_count: number;
}

/**
 * The corpus tables are a separate migration from the register, so this page
 * has to survive their absence. A partly-applied import, or a rollback, would
 * otherwise take every rijal dossier down with it — D1 rejects a whole batch
 * when one statement references a missing table. The corpus sections are
 * additive, so failing to read them degrades to hiding them.
 */
let transmissions: Transmission[] = [];
let transmissionCount = 0;
let attestedForms: { surface: string; n_mentions: number; is_display: number }[] = [];

try {
  const [transmissionRes, transmissionCountRes, aliasRes] = await db.batch([
    // The eight openers come from `narrator_top_hadith`, which stores this
    // exact ranking. Asked live it was the most expensive statement on the
    // site — 66,853 rows and 735 ms for ʿĀʾishah — because no index spans
    // `hadith_narrator.narrator_id` and `hadith.parallel_count`, so every one
    // of her 16,511 narrations was gathered and sorted to take eight. See
    // migrations/0006 and scripts/refresh-stats.mjs.
    //
    // It also fixes a duplicate: the old query joined `hadith_narrator`
    // directly with no DISTINCT, so a transmitter named twice in one chain
    // could spend two of their eight slots on the same narration. `pos` is now
    // read back as the earliest position they occupy, an indexed lookup each.
    db.prepare(
      `SELECT h.id, h.hadith_num, h.matn_en, h.narrator_count, h.parallel_count,
              (SELECT MIN(hn.pos) FROM hadith_narrator hn
                WHERE hn.narrator_id = t.narrator_id AND hn.hadith_id = h.id) AS pos,
              b.title_en AS book_en
         FROM narrator_top_hadith t
         JOIN hadith h ON h.id = t.hadith_id
         JOIN hadith_book b ON b.id = h.book_id
        WHERE t.narrator_id = ?
        ORDER BY t.ord`
    ).bind(id),
    // DISTINCT because a transmitter can be named more than once in one chain.
    // Counting rows here would disagree with the corpus view this links to,
    // which counts narrations.
    db.prepare(
      'SELECT COUNT(DISTINCT hadith_id) AS n FROM hadith_narrator WHERE narrator_id = ?'
    ).bind(id),
    // Attested spellings: the register's display form is often not how this
    // person is actually named in the chains.
    db.prepare(
      `SELECT surface, n_mentions, is_display FROM narrator_alias
        WHERE narrator_id = ? ORDER BY n_mentions DESC LIMIT 8`
    ).bind(id)
  ]);

  transmissions = (transmissionRes.results || []) as unknown as Transmission[];
  transmissionCount = Number(
    (transmissionCountRes.results?.[0] as { n?: number } | undefined)?.n ?? 0
  );
  attestedForms = (aliasRes.results || []) as unknown as typeof attestedForms;
} catch (error) {
  console.error('Corpus lookup failed for narrator', id, error);
}

const VERDICT_LABELS: Record<Verdict, string> = {
  jarh: 'Jarh',
  tadil: "Ta'dil",
  mixed: 'Mixed',
  unclassified: 'Unclassified'
};

const verdicts = [
  ['Ibn Hajar al-Asqalani', detail.rankIbnHajarEn, detail.rankIbnHajar],
  ['al-Dhahabi', detail.rankDhahabiEn, detail.rankDhahabi],
  ['Tabaqa (Taqrib al-Tahdhib)', detail.tabaqaEn, detail.tabaqa],
  ['Creedal Attribution', detail.madhhabEn, detail.madhhab]
].filter(([, en, ar]) => en || ar);

const nameRows = [
  ['Full name', detail.fullName],
  ['Kunya', detail.kunya],
  ['Nickname', detail.nickname],
  ['Lineage', detail.lineage],
  ['Relations', detail.relation]
].filter(([, v]) => v);

const journey = detail.placesEn?.length ? detail.placesEn : detail.placesAr || [];

const deathLine = detail.deathHijri
  ? `${detail.deathHijri} AH / ${detail.deathGregorian} CE`
  : 'date not recorded';

const critics = [...(criticism?.critics || [])].sort(
  (a, b) => b.statements.length - a.statements.length
);

const maxBook = detail.books?.[0]?.count || 1;
const maxPos = Math.max(1, ...(detail.positions || []).map((p) => p.count));

const title = `${detail.nameEn || detail.nameAr} | Rijāl Dossier | HadithCritic`;
const description = [
  `${detail.nameEn}${detail.nameAr ? ` (${detail.nameAr})` : ''}, ${deathLine}.`,
  detail.rankIbnHajarEn ? `Ibn Hajar: ${detail.rankIbnHajarEn}` : '',
  detail.hadithCount ? `${detail.hadithCount} hadith across the corpus.` : '',
  criticism ? `${criticism.statementCount} recorded statements from ${criticism.criticCount} critics.` : ''
]
  .filter(Boolean)
  .join(' ')
  .slice(0, 300);

// --- structured data -------------------------------------------------------
const dossierUrl = new URL(`/narrators/${detail.id}`, Astro.site).href;
const personNode = person({
  url: dossierUrl,
  nameEn: detail.nameEn,
  nameAr: detail.nameAr,
  fullName: detail.fullName,
  kunya: detail.kunya,
  description,
  deathYearCE: detail.deathGregorian,
  deathPlace: detail.deathPlace,
  places: detail.placesEn,
  generation: detail.generation,
  id: detail.id
});

const narratorSchema = [
  entityPage({
    url: dossierUrl,
    title,
    description,
    entityId: personNode['@id'] as string
  }),
  personNode
];

const narratorCrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Rijāl Register', url: '/narrators' },
  { name: detail.nameEn || detail.nameAr, url: `/narrators/${detail.id}` }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`/narrators/${detail.id}`}
  schema={narratorSchema}
  crumbs={narratorCrumbs}
>
  <article class="rijal-page">
    <header class="rijal-head">
      <a class="rijal-back" href="/narrators">&larr; Rijāl register</a>
      <span class="rijal-id">#{detail.id}</span>
      <h1 class="rijal-name-en">{detail.nameEn || detail.nameAr}</h1>
      {detail.nameAr && <p class="rijal-name-ar" dir="rtl" lang="ar">{detail.nameAr}</p>}

      <div class="rijal-badges">
        <span class="rijal-badge">{detail.generation}</span>
        {detail.tabaqaNumber && <span class="rijal-badge">Tabaqa {detail.tabaqaNumber}</span>}
        <span class="rijal-badge rijal-badge--grade">{detail.grade}</span>
        {detail.flags?.map((f) => <span class="rijal-badge rijal-badge--flag">{f}</span>)}
      </div>

      <dl class="rijal-facts">
        <div><dt>Died</dt><dd>{deathLine}{detail.deathPlace ? `, ${detail.deathPlace}` : ''}</dd></div>
        <div><dt>Hadith</dt><dd>{detail.hadithCount ? detail.hadithCount.toLocaleString() : '—'}</dd></div>
        <div><dt>Teachers</dt><dd>{detail.teachers?.length || 0}</dd></div>
        <div><dt>Students</dt><dd>{detail.students?.length || 0}</dd></div>
      </dl>
    </header>

    {verdicts.length > 0 && (
      <section class="rijal-section">
        <h2>Scholarly Verdicts</h2>
        <p class="rijal-note">Each verdict is the named authority's own wording, shown in translation with the Arabic alongside.</p>
        <div class="rijal-verdicts">
          {verdicts.map(([who, en, ar]) => (
            <div class="rijal-verdict">
              <span class="rijal-verdict__who">{who}</span>
              {en && <p class="rijal-verdict__en">{en}</p>}
              {ar && <p class="rijal-verdict__ar" dir="rtl" lang="ar">{ar}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    {detail.deathDate && (
      <section class="rijal-section">
        <h2>Death Notice</h2>
        <p class="rijal-note">Kept verbatim: the source preserves the disagreement between authorities over the year, which is itself evidence.</p>
        <p class="rijal-arabic" dir="rtl" lang="ar">{detail.deathDate}</p>
      </section>
    )}

    {detail.books?.length > 0 && (
      <section class="rijal-section">
        <h2>Presence in the Corpus</h2>
        <ul class="rijal-bars">
          {detail.books.slice(0, 12).map((b) => (
            <li class="rijal-bar">
              <span class="rijal-bar__label">{b.book}</span>
              <span class="rijal-bar__track"><span class="rijal-bar__fill" style={`width:${Math.max(2, (b.count / maxBook) * 100)}%`}></span></span>
              <span class="rijal-bar__value">{b.count.toLocaleString()}</span>
            </li>
          ))}
        </ul>

        {detail.positions?.length > 0 && (
          <>
            <h3 class="rijal-subhead">Position in the chain</h3>
            <p class="rijal-note">Position 0 sits at the Companion end; the highest position sits with the compiler.</p>
            <ul class="rijal-bars rijal-bars--compact">
              {detail.positions.map((p) => (
                <li class="rijal-bar">
                  <span class="rijal-bar__label">Position {p.pos}</span>
                  <span class="rijal-bar__track"><span class="rijal-bar__fill" style={`width:${Math.max(2, (p.count / maxPos) * 100)}%`}></span></span>
                  <span class="rijal-bar__value">{p.count.toLocaleString()}</span>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )}

    {transmissionCount > 0 && (
      <section class="rijal-section">
        <h2>Narrations</h2>
        <p class="rijal-note">
          {transmissionCount.toLocaleString()} narrations in the corpus name this
          transmitter. Shown are the most widely attested; no authenticity
          grading is applied to any of them.
        </p>
        <ul class="rijal-transmissions">
          {transmissions.map((t) => (
            <li class="rijal-transmission">
              <a href={`/hadith/${t.id}`}>
                <span class="rijal-transmission__src">
                  {t.book_en}{t.hadith_num ? ` № ${t.hadith_num}` : ''}
                </span>
                {t.matn_en && <span class="rijal-transmission__text">{toPlainText(t.matn_en).slice(0, 200)}</span>}
                <span class="rijal-transmission__meta">
                  Position {t.pos} of {t.narrator_count}
                  {t.parallel_count > 0 && ` · ${t.parallel_count.toLocaleString()} parallels`}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="rijal-note">
          <a class="rijal-more" href={`/hadith?narrator=${detail.id}`}>
            All {transmissionCount.toLocaleString()} narrations →
          </a>
        </p>
      </section>
    )}

    {attestedForms.length > 1 && (
      <section class="rijal-section">
        <h2>Attested Spellings</h2>
        <p class="rijal-note">
          How the chains actually name this person, with occurrence counts. The
          register's display form is frequently not the commonest one, which is
          why identity resolution cannot rely on string matching alone.
        </p>
        <ul class="rijal-forms">
          {attestedForms.map((f) => (
            <li class="rijal-form">
              <span lang="ar" dir="rtl" class="rijal-form__surface">{f.surface}</span>
              <span class="rijal-form__count">{f.n_mentions.toLocaleString()}</span>
              {f.is_display === 1 && <span class="rijal-form__flag">Register form</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {detail.sampleChains?.length > 0 && (
      <section class="rijal-section">
        <h2>Sample Isnads</h2>
        <p class="rijal-note">Read left to right from the Companion end toward the compiler. This narrator is marked.</p>
        {detail.sampleChains.map((chain) => (
          <div class="rijal-chain">
            <span class="rijal-chain__src">{chain.book}{chain.number ? ` ${chain.number}` : ''}</span>
            <ol class="rijal-chain__path">
              {chain.path.map((nid) => (
                <li class={nid === detail.id ? 'rijal-node rijal-node--self' : 'rijal-node'}>
                  {nid === detail.id ? (
                    <span>{detail.nameEn || detail.nameAr}</span>
                  ) : linkableIds.has(nid) ? (
                    <a href={`/narrators/${nid}`}>{chainNames[nid] || `#${nid}`}</a>
                  ) : (
                    <span>{chainNames[nid] || `#${nid}`}</span>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    )}

    {criticism && (
      <section class="rijal-section">
        <h2>Jarh &amp; Ta'dil</h2>
        <p class="rijal-note">
          {criticism.statementCount.toLocaleString()} statements from {criticism.criticCount} critics.
          A statement is labelled only where an unambiguous formula is present; the rest are left unclassified rather than guessed at.
        </p>
        <div class="rijal-tally">
          {(Object.entries(criticism.tally) as [Verdict, number][])
            .filter(([, n]) => n > 0)
            .map(([k, n]) => <span class={`rijal-pill rijal-pill--${k}`}>{VERDICT_LABELS[k]} {n}</span>)}
        </div>

        {criticism.phenomena?.length > 0 && (
          <div class="rijal-phenomena">
            {criticism.phenomena.map((p) => (
              <span class="rijal-badge rijal-badge--flag">{p.label} {p.statements.length}</span>
            ))}
          </div>
        )}

        {critics.map((g) => (
          <details class="rijal-critic">
            <summary>
              <span dir="rtl" lang="ar">{g.critic}</span>
              <span class="rijal-critic__count">{g.statements.length}</span>
            </summary>
            <ul class="rijal-statements">
              {g.statements.map((s) => (
                <li class={`rijal-statement rijal-statement--${s.verdict}`}>
                  <p dir="rtl" lang="ar">{s.text}</p>
                  <div class="rijal-statement__meta">
                    <span class="rijal-statement__verdict">{VERDICT_LABELS[s.verdict]}</span>
                    {s.citation && <cite dir="rtl" lang="ar">{s.citation}</cite>}
                  </div>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </section>
    )}

    {(nameRows.length > 0 || detail.aliases?.length > 0) && (
      <section class="rijal-section">
        <h2>Names &amp; Attested Forms</h2>
        {nameRows.length > 0 && (
          <dl class="rijal-names">
            {nameRows.map(([label, value]) => (
              <div><dt>{label}</dt><dd dir="auto">{value}</dd></div>
            ))}
          </dl>
        )}
        {detail.aliases?.length > 0 && (
          <>
            <p class="rijal-note">Appears in the isnads under {detail.aliasCount} distinct form{detail.aliasCount === 1 ? '' : 's'}.</p>
            <div class="rijal-aliases">
              {detail.aliases.map((a) => (
                <span class="rijal-alias" dir="rtl" lang="ar">{a.form}<span class="rijal-alias__count">{a.count}</span></span>
              ))}
            </div>
          </>
        )}
      </section>
    )}

    {journey.length > 0 && (
      <section class="rijal-section">
        <h2>Places</h2>
        <p class="rijal-journey">{journey.map((p) => <span class="rijal-place" dir="auto">{p}</span>)}</p>
      </section>
    )}

    {(detail.teachers?.length > 0 || detail.students?.length > 0) && (
      <section class="rijal-section">
        <h2>Transmission Network</h2>
        <p class="rijal-note">Derived from adjacency in the isnad chains, with the number of times each pairing occurs.</p>
        <div class="rijal-network">
          <div>
            <h3 class="rijal-subhead">Teachers ({detail.teachers.length})</h3>
            <ul class="rijal-relations">
              {detail.teachers.map((t) => (
                <li>
                  {linkableIds.has(t.id) ? <a href={`/narrators/${t.id}`}>{t.name}</a> : <span class="rijal-plain">{t.name}</span>}
                  <span>{t.count}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="rijal-subhead">Students ({detail.students.length})</h3>
            <ul class="rijal-relations">
              {detail.students.map((s) => (
                <li>
                  {linkableIds.has(s.id) ? <a href={`/narrators/${s.id}`}>{s.name}</a> : <span class="rijal-plain">{s.name}</span>}
                  <span>{s.count}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .rijal-page {
    max-width: 62rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
  }

  .rijal-back {
    font-family: var(--font-ui);
    font-size: 0.87rem;
    color: var(--hc-text-tertiary);
    text-decoration: none;
  }

  .rijal-back:hover { color: var(--hc-gold); }

  .rijal-id {
    margin-left: 0.7rem;
    font-family: var(--font-ui);
    font-size: 0.83rem;
    color: var(--hc-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .rijal-name-en {
    margin: 0.8rem 0 0;
    font-family: var(--font-display, serif);
    font-size: clamp(1.61rem, 4vw, 2.46rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

