---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { CORPUS_CACHE_CONTROL } from '../../lib/edge-cache';

/**
 * Rijal dossier for one transmitter.
 *
 * A shell. There are 20,950 transmitters, past what Cloudflare will hold as
 * prerendered assets, and there is no database behind the site to ask at
 * request time, so the Worker renders the frame and src/lib/narrator-dossier.ts
 * fills it from the static corpus in the browser.
 *
 * This route stays on-demand rather than prerendered only because the id is
 * unbounded. It performs no I/O of any kind, so it costs a Worker invocation
 * and nothing else.
 *
 * The consequence to be aware of: a crawler that does not run JavaScript sees
 * the shell rather than the dossier. That is the price of serving a 1.6 GB
 * corpus from static files, and it is paid knowingly.
 */

const raw = Astro.params.id ?? '';
const id = Number(raw);
const valid = /^\d+$/.test(raw) && Number.isFinite(id) && id >= 0;

if (!valid) {
  return Astro.redirect('/narrators', 302);
}

const pageTitle = `Transmitter #${id} | Rijal Dossier | HadithCritic`;

// The shell depends on the id and the deployment, and on nothing that can
// fail, so it is unconditionally storable at the edge.
Astro.response.headers.set('Cache-Control', CORPUS_CACHE_CONTROL);
---

<BaseLayout
  title={pageTitle}
  description="A biographical entry in the HadithCritic rijal register: attributed classical verdicts, transmission network, and recorded narrations."
  canonical={`/narrators/${id}`}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Rijāl Register', url: '/narrators' },
    { name: `#${id}`, url: `/narrators/${id}` }
  ]}
>
  <article class="rijal-page" data-narrator-id={id}>
    <div class="rijal-loading" data-dossier-loading>
      <span class="rijal-spinner" aria-hidden="true"></span>
      <p>Reading transmitter #{id} from the corpus...</p>
    </div>
    <noscript>
      <div class="rijal-degraded">
        <div class="rijal-degraded__badge">JavaScript required</div>
        <h1 class="rijal-degraded__title">Transmitter #{id}</h1>
        <p class="rijal-degraded__text">
          Dossiers are read from a static SQLite corpus inside your browser,
          which needs JavaScript. The written research on this site does not.
        </p>
        <div class="rijal-degraded__actions">
          <a class="rijal-btn" href="/narrators">Return to the register</a>
        </div>
      </div>
    </noscript>
  </article>
</BaseLayout>

<script>
  import { initNarratorDossier } from '../../lib/narrator-dossier';
  initNarratorDossier();
</script>

<style is:global>

  /* The shell's own state, before src/lib/narrator-dossier.ts has anything to show. */
  .rijal-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
