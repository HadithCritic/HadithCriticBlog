---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HadithCritic',
  description = 'Historical criticism, Quranic scholarship, and source-level analysis of hadith traditions.'
} = Astro.props;

const navItems = [
  { href: '/blogs', label: 'Blogs' },
  { href: '/academia', label: 'Academia' },
  { href: '/videos', label: 'Videos' },
  { href: '/projects', label: 'Projects' },
  { href: '/resources', label: 'Resources' },
  { href: '/about', label: 'About' }
];
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10110f" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const preferredTheme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme || preferredTheme);
    </script>
  </head>
  <body>
    <div class="site-shell">
      <div class="page-bg-container" aria-hidden="true">
        <div class="grid-rails"></div>
        <div class="page-bg-image"></div>
      </div>

      <header class="site-header">
        <div class="wrap header-inner">
          <a href="/" class="header-brand" aria-label="HadithCritic home">
            <img src="/geometric_emblem_transparent.png" alt="" class="header-emblem" />
            <span class="header-brand-name">HadithCritic</span>
          </a>

          <nav class="header-nav" aria-label="Main navigation">
            {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>

          <div class="header-actions">
            <a class="header-icon-btn" href="/search" aria-label="Search">
              <i class="fa-solid fa-search" aria-hidden="true"></i>
            </a>
            <button type="button" class="toggle-switch" id="theme-toggle" aria-label="Toggle color theme">
              <span class="toggle-knob">
                <i class="fa-solid fa-circle-half-stroke" aria-hidden="true"></i>
              </span>
            </button>
            <button type="button" class="header-icon-btn header-menu-btn" id="menu-open-btn" aria-label="Open menu">
              <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </header>

      <div id="mobile-menu-overlay" class="mobile-menu-overlay" role="dialog" aria-modal="true" aria-label="Navigation">
        <div class="menu-header">
          <a href="/" class="header-brand" aria-label="HadithCritic home">
            <img src="/geometric_emblem_transparent.png" alt="" class="header-emblem" />
            <span class="header-brand-name">HadithCritic</span>
          </a>
          <button type="button" class="menu-close-wrapper" id="menu-close-btn" aria-label="Close menu">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </div>

        <nav class="menu-nav" aria-label="Mobile navigation">
          <ul class="menu-link-list">
            {navItems.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>

          <div class="menu-footer">
            <div class="menu-theme-pill" role="group" aria-label="Theme">
              <button type="button" class="theme-opt" id="menu-opt-dark">
                <i class="fa-solid fa-moon" aria-hidden="true"></i> Dark
              </button>
              <button type="button" class="theme-opt" id="menu-opt-light">
                <i class="fa-solid fa-sun" aria-hidden="true"></i> Light
              </button>
            </div>
          </div>
        </nav>
      </div>

      <main class="main-content">
        <slot />
      </main>

      <footer class="footer-pro">
        <div class="wrap">
          <div class="footer-pro-grid">
            <div class="footer-col-brand">
              <a href="/" class="footer-brand-logo">
                <img src="/geometric_emblem_transparent.png" alt="" class="footer-logo-img" />
                <span class="footer-logo-text">HadithCritic</span>
              </a>
              <p class="footer-brand-desc">
                Quran-centered hadith criticism focused on transmitter history, sectarian context, and evidentiary verification.
              </p>
            </div>

            <div class="footer-col-links">
              <h2 class="footer-col-title">Research</h2>
              <ul>
                <li><a href="/blogs">Articles</a></li>
                <li><a href="/academia">Academic notes</a></li>
                <li><a href="/resources">Resources</a></li>
              </ul>
            </div>

            <div class="footer-col-links">
              <h2 class="footer-col-title">Library</h2>
              <ul>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/books">Books and PDFs</a></li>
                <li><a href="/methodology">Methodology</a></li>
              </ul>
            </div>

            <div class="footer-col-links">
              <h2 class="footer-col-title">Connect</h2>
              <ul>
                <li><a href="https://www.youtube.com/@HadithCritic">YouTube</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/contact">Contact</a></li>
              </ul>
            </div>
          </div>

          <div class="footer-pro-ctas">
            <div class="footer-cta-box">
              <h2 class="footer-cta-title">Support the research</h2>
              <p class="footer-cta-desc">Help expand source checks, translations, dossiers, and long-form refutations.</p>
              <a href="/support" class="footer-cta-link">Make a donation &rarr;</a>
            </div>
            <div class="footer-cta-box">
              <h2 class="footer-cta-title">Follow new work</h2>
              <p class="footer-cta-desc">Get articles, videos, and publication notes when the evidence is ready.</p>
              <a href="/subscribe" class="footer-cta-link">Subscribe &rarr;</a>
            </div>
          </div>

          <div class="footer-pro-base">
            <div>&copy; HadithCritic. Verification over reputation.</div>
            <div class="footer-socials">
              <a href="https://www.youtube.com/@HadithCritic">YouTube</a>
              <a href="/resources">Resources</a>
              <a href="/about">About</a>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const html = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const overlay = document.getElementById('mobile-menu-overlay');
      const openBtn = document.getElementById('menu-open-btn');
      const closeBtn = document.getElementById('menu-close-btn');
      const optLight = document.getElementById('menu-opt-light');
      const optDark = document.getElementById('menu-opt-dark');

      function setTheme(theme) {
        html.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        optLight?.classList.toggle('active', theme === 'light');
        optDark?.classList.toggle('active', theme === 'dark');
      }

      setTheme(html.getAttribute('data-theme') || 'dark');

      toggle?.addEventListener('click', () => {
        setTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      });

      optLight?.addEventListener('click', () => setTheme('light'));
      optDark?.addEventListener('click', () => setTheme('dark'));

      function closeMenu() {
        overlay?.classList.remove('active');
        document.body.style.overflow = '';
      }

      openBtn?.addEventListener('click', () => {
        overlay?.classList.add('active');
        document.body.style.overflow = 'hidden';
      });

      closeBtn?.addEventListener('click', closeMenu);
      overlay?.addEventListener('click', (event) => {
        if (event.target === overlay) closeMenu();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
    </script>
  </body>
</html>
