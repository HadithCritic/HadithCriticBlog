---
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A scholarly digital research platform for hadith criticism and isnād analysis." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&family=Source+Sans+3:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title>{title} | HadithCriticBlog</title>
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container nav-inner">
            <a href="/" class="brand">
                <img src="https://hadithcriticblog.com/wp-content/uploads/2026/02/cropped-HCpfp.jpg" alt="HC Logo">
                <span>HADITHCRITIC</span>
            </a>

            <div class="nav-tabs" id="navLinks">
                <div class="nav-highlight" id="navHighlight"></div>
                <a href="/" class={`nav-tab ${Astro.url.pathname === '/' ? 'active' : ''}`}>HOME</a>
                <a href="/blogs" class={`nav-tab ${Astro.url.pathname.startsWith('/blogs') ? 'active' : ''}`}>BLOGS</a>
                <a href="/academia" class={`nav-tab ${Astro.url.pathname.startsWith('/academia') ? 'active' : ''}`}>ACADEMIA</a>
                <a href="/contact" class={`nav-tab ${Astro.url.pathname.startsWith('/contact') ? 'active' : ''}`}>CONTACT</a>
                <a href="/projects" class={`nav-tab ${Astro.url.pathname.startsWith('/projects') ? 'active' : ''}`}>PROJECTS</a>
                <a href="/resources" class={`nav-tab ${Astro.url.pathname.startsWith('/resources') ? 'active' : ''}`}>RESOURCES</a>
                <a href="/youtube" class={`nav-tab ${Astro.url.pathname.startsWith('/youtube') ? 'active' : ''}`}>YOUTUBE</a>
            </div>

            <div class="nav-actions">
                <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
    </nav>
    
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer style="border-top: 1px solid var(--border); background-color: var(--bg); margin-top: auto;">
        <div style="max-width: 1240px; margin: 0 auto; padding: 32px 20px 24px;">
            <!-- Main grid -->
            <div class="footer-grid" style="display: grid; gap: 32px; margin-bottom: 16px;">
                <!-- Brand column -->
                <div style="display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center;">
                    <div>
                        <a href="/" style="font-family: var(--font-display); font-size: 26px; font-weight: 700; letter-spacing: -0.015em; color: var(--text-heading); text-decoration: none; display: block;">
                            HADITHCRITIC
                        </a>
                    </div>
                    <p style="font-family: var(--font-body); font-size: 14px; color: var(--text-muted); line-height: 1.6; max-width: 44ch;">
                        A rigorous examination of traditional Islamic narratives through historical criticism, philosophical analysis, and the Quranic mandate. Questioning isnād-based methodology and mainstream assumptions of authenticity.
                    </p>
                </div>

                <!-- Link columns -->
                <div>
                    <div style="font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin-bottom: 18px;">
                        Analysis
                    </div>
                    <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; padding: 0;">
                        <li><a href="/blogs" style="font-family: var(--font-body); font-size: 14px; color: var(--text-body); text-decoration: none;">Latest Blogs</a></li>
                        <li><a href="/academia" style="font-family: var(--font-body); font-size: 14px; color: var(--text-body); text-decoration: none;">Academia</a></li>
                        <li><a href="/projects" style="font-family: var(--font-body); font-size: 14px; color: var(--text-body); text-decoration: none;">Projects</a></li>
                    </ul>
                </div>

                <div>
                    <div style="font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin-bottom: 18px;">
                        Media
                    </div>
                    <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; padding: 0;">
                        <li><a href="/resources" style="font-family: var(--font-body); font-size: 14px; color: var(--text-body); text-decoration: none;">Resources</a></li>
                        <li><a href="/youtube" style="font-family: var(--font-body); font-size: 14px; color: var(--text-body); text-decoration: none;">YouTube</a></li>
                    </ul>
                </div>

                <div>
                    <div style="font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin-bottom: 18px;">
                        Organization
                    </div>
                    <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; padding: 0;">
                        <li><a href="/contact" style="font-family: var(--font-body); font-size: 14px; color: var(--text-body); text-decoration: none;">Contact</a></li>
                        <li><a href="https://discord.gg/SubmissionServer" target="_blank" style="font-family: var(--font-body); font-size: 14px; color: var(--text-body); text-decoration: none;">Discord</a></li>
                    </ul>
                </div>
            </div>

            <!-- Verse block -->
            <div style="padding: 32px 20px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); text-align: center;">
                <p style="max-width: 850px; margin: 0 auto; line-height: 1.6;">
                    <span style="font-family: var(--font-sans); font-size: 13px; font-weight: 700; letter-spacing: 0.12em; color: var(--accent); margin-right: 8px;">
                        45:6 —
                    </span>
                    <span style="font-family: var(--font-display); font-style: italic; font-size: 17px; color: var(--text-muted);">
                        These are God's revelations that We recite to you truthfully. In which Hadith other than God and His revelations do they believe?
                    </span>
                </p>
            </div>

            <!-- Bottom bar -->
            <div class="footer-bottom-bar" style="margin-top: 24px; font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                    <span>&copy; {new Date().getFullYear()} HadithCritic</span>
                    <span style="opacity: 0.5;">·</span>
                    <span>Academic Hadith & Quranic Scholarship</span>
                </div>
                <div style="display: flex; gap: 16px;">
                    <a href="https://github.com/HadithCritic" target="_blank" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 6px;">
                        <i class="fab fa-github"></i> <span>GitHub</span>
                    </a>
                    <a href="https://discord.gg/SubmissionServer" target="_blank" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 6px;">
                        <i class="fab fa-discord"></i> <span>Discord</span>
                    </a>
                    <a href="https://youtube.com/@HadithCritic" target="_blank" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 6px;">
                        <i class="fab fa-youtube"></i> <span>YouTube</span>
                    </a>
                    <a href="https://twitter.com/HadithCritic" target="_blank" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 6px;">
                        <i class="fab fa-twitter"></i> <span>Twitter</span>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <style>
        .footer-grid {
            grid-template-columns: 2fr 1fr 1fr 1fr;
        }
        @media (max-width: 900px) {
            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        @media (max-width: 600px) {
            .footer-grid {
                grid-template-columns: 1fr;
            }
            .footer-bottom-bar {
                flex-direction: column;
                align-items: flex-start !important;
            }
        }
    </style>

    <script is:inline>
        const menuToggle = document.getElementById('menuToggle');
        const navLinks = document.getElementById('navLinks');
        
        menuToggle?.addEventListener('click', () => {
            navLinks?.classList.toggle('active');
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tabsContainer = document.getElementById('navLinks');
            if (!tabsContainer) return;
            
            const tabs = tabsContainer.querySelectorAll('.nav-tab');
            const highlight = document.getElementById('navHighlight');
            let activeTab = tabsContainer.querySelector('.nav-tab.active');

            function updateHighlight(targetTab: Element) {
                if (!targetTab || !highlight || !tabsContainer) return;
                const containerRect = tabsContainer.getBoundingClientRect();
                const tabRect = targetTab.getBoundingClientRect();
                
                // Adjust for padding inside the container
                const offsetLeft = tabRect.left - containerRect.left;
                
                highlight.style.width = `${tabRect.width}px`;
                highlight.style.transform = `translateX(${offsetLeft}px)`;
            }

            // Initialize position
            if (activeTab && highlight) {
                highlight.style.opacity = '1';
                setTimeout(() => updateHighlight(activeTab!), 50);
            } else if (highlight) {
                highlight.style.opacity = '0';
            }

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    activeTab = tab;
                    updateHighlight(activeTab);
                });
            });
            
            // Handle resize
            window.addEventListener('resize', () => {
                if (activeTab) updateHighlight(activeTab);
            });
        });
    </script>
  </body>
</html>
