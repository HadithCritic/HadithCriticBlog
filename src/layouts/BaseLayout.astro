---
import '../styles/global.css';
import Emblem from '../components/Emblem.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "HadithCritic", 
  description = "Historical Criticism & Quranic Scholarship" 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Use the simplified seal for the favicon later, for now keeping standard -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Minimalist Navbar -->
    <header class="site-header">
      <div class="nav-inner">
        <a href="/" class="nav-brand" aria-label="HadithCritic Home">
          <Emblem variant="simplified" size="sm" />
          <span class="brand-text">HadithCritic</span>
        </a>
        <nav class="nav-links">
          <a href="/about">About</a>
          <a href="/methodology">Methodology</a>
          <a href="/bibliography">Bibliography</a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <slot />

    <!-- Vatican-Style Footer -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-emblem">
          <Emblem variant="primary" size="lg" className="emblem-footer" />
        </div>
        <div class="footer-brand">
          <span class="footer-name">HadithCritic</span>
          <span class="footer-tagline">Verification Over Reputation</span>
        </div>
        <nav class="footer-links">
          <a href="/about">About</a>
          <a href="/methodology">Methodology</a>
          <a href="/bibliography">Bibliography</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Header Styles */
  .site-header {
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    padding: 1rem 0;
  }
  
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-primary);
  }
  
  .nav-brand:hover {
    text-decoration: none;
  }
  
  .brand-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    font-weight: 500;
  }
  
  .nav-links {
    display: flex;
    gap: 2rem;
  }
  
  .nav-links a {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  
  .nav-links a:hover {
    color: var(--accent-primary);
    text-decoration: none;
  }

  /* Footer Styles */
  .site-footer {
    margin-top: 6rem;
    padding: 4rem 0;
    background: var(--bg-elevated);
    border-top: 1px solid var(--border-subtle);
    text-align: center;
  }

  .footer-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-emblem {
    margin-bottom: 1.5rem;
  }

  :global(.emblem-footer) {
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }

  :global(.emblem-footer:hover) {
    opacity: 1;
  }

  .footer-brand {
    margin-bottom: 2rem;
  }

  .footer-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .footer-tagline {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
    margin-top: 0.5rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .footer-links a {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  
  .footer-links a:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  /* Responsive tweaks */
  @media (max-width: 640px) {
    .nav-inner {
      flex-direction: column;
      gap: 1rem;
    }
    
    .nav-links {
      gap: 1rem;
    }
  }
</style>
