---
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A scholarly digital research platform for hadith criticism and isnād analysis." } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&family=Source+Sans+3:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title>{title} | HadithCriticBlog</title>
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar" id="navbar">
        <div class="container nav-inner">
            <a href="/" class="brand">
                <img src="https://hadithcriticblog.com/wp-content/uploads/2026/02/cropped-HCpfp.jpg" alt="HC Logo">
                <span>HADITHCRITIC</span>
            </a>

            <div class="nav-tabs" id="navLinks">
                <div class="nav-highlight" id="navHighlight"></div>
                <a href="/" class={`nav-tab ${currentPath === '/' ? 'active' : ''}`}>HOME</a>
                <a href="/blogs" class={`nav-tab ${currentPath.startsWith('/blogs') ? 'active' : ''}`}>BLOGS</a>
                <a href="/academia" class={`nav-tab ${currentPath.startsWith('/academia') ? 'active' : ''}`}>ACADEMIA</a>
                <a href="/contact" class={`nav-tab ${currentPath.startsWith('/contact') ? 'active' : ''}`}>CONTACT</a>
                <a href="/projects" class={`nav-tab ${currentPath.startsWith('/projects') ? 'active' : ''}`}>PROJECTS</a>
                <a href="/resources" class={`nav-tab ${currentPath.startsWith('/resources') ? 'active' : ''}`}>RESOURCES</a>
                <a href="/youtube" class={`nav-tab ${currentPath.startsWith('/youtube') ? 'active' : ''}`}>YOUTUBE</a>
            </div>

            <div class="nav-actions">
                <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation">
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                </button>
            </div>
        </div>
    </nav>
    
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-glow"></div>
        <div class="container footer-inner">
            <!-- Main grid -->
            <div class="footer-grid">
                <!-- Brand column -->
                <div class="footer-brand-col">
                    <a href="/" class="footer-brand">
                        HADITHCRITIC
                    </a>
                    <p class="footer-desc">
                        A rigorous examination of traditional Islamic narratives through historical criticism, philosophical analysis, and the Quranic mandate. Questioning isnād-based methodology and mainstream assumptions of authenticity.
                    </p>
                    <div class="footer-socials">
                        <a href="https://github.com/HadithCritic" target="_blank" aria-label="GitHub"><i class="fab fa-github"></i></a>
                        <a href="https://discord.gg/SubmissionServer" target="_blank" aria-label="Discord"><i class="fab fa-discord"></i></a>
                        <a href="https://youtube.com/@HadithCritic" target="_blank" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                        <a href="https://twitter.com/HadithCritic" target="_blank" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>

                <!-- Link columns -->
                <div class="footer-links-col">
                    <div class="footer-col-title">Analysis</div>
                    <ul>
                        <li><a href="/blogs">Latest Blogs</a></li>
                        <li><a href="/academia">Academia</a></li>
                        <li><a href="/projects">Projects</a></li>
                    </ul>
                </div>

                <div class="footer-links-col">
                    <div class="footer-col-title">Media</div>
                    <ul>
                        <li><a href="/resources">Resources</a></li>
                        <li><a href="/youtube">YouTube</a></li>
                    </ul>
                </div>

                <div class="footer-links-col">
                    <div class="footer-col-title">Organization</div>
                    <ul>
                        <li><a href="/contact">Contact</a></li>
                        <li><a href="https://discord.gg/SubmissionServer" target="_blank">Discord</a></li>
                    </ul>
                </div>
            </div>

            <!-- Verse block -->
            <div class="footer-verse">
                <p>
                    <span class="verse-ref">45:6 —</span>
                    <span class="verse-text">
                        These are God's revelations that We recite to you truthfully. In which Hadith other than God and His revelations do they believe?
                    </span>
                </p>
            </div>

            <!-- Bottom bar -->
            <div class="footer-bottom-bar">
                <div class="footer-bottom-left">
                    <span>&copy; {new Date().getFullYear()} HadithCritic</span>
                    <span class="footer-dot">·</span>
                    <span>Academic Hadith & Quranic Scholarship</span>
                </div>
                <div class="footer-bottom-right">
                    <span class="footer-credit">Crafted with academic rigor</span>
                </div>
            </div>
        </div>
    </footer>

    <style>
        /* Enhanced Navbar */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(10, 10, 10, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255,255,255,0.04);
            transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.3s;
        }
        .navbar.nav-hidden {
            transform: translateY(-100%);
        }
        .navbar.nav-scrolled {
            background: rgba(10, 10, 10, 0.92);
            border-bottom-color: rgba(255,255,255,0.08);
        }
        .nav-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 68px;
            padding: 0 20px;
            max-width: 1280px;
            margin: 0 auto;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            z-index: 1001;
        }
        .brand img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(202, 138, 4, 0.3);
        }
        .brand span {
            font-family: var(--font-display, 'Source Serif 4', serif);
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 0.05em;
            color: var(--text-heading, #fff);
        }

        /* Nav Tabs */
        .nav-tabs {
            position: relative;
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px;
            background: rgba(255,255,255,0.03);
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .nav-tab {
            position: relative;
            padding: 8px 16px;
            font-family: var(--font-sans, 'Source Sans 3', sans-serif);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--text-muted, #888);
            text-decoration: none;
            border-radius: 8px;
            transition: color 0.3s;
            z-index: 2;
            white-space: nowrap;
        }
        .nav-tab:hover {
            color: var(--text-body, #d4d4d4);
        }
        .nav-tab.active {
            color: var(--text-heading, #fff);
        }
        .nav-highlight {
            position: absolute;
            top: 4px;
            left: 4px;
            height: calc(100% - 8px);
            background: rgba(202, 138, 4, 0.15);
            border: 1px solid rgba(202, 138, 4, 0.25);
            border-radius: 8px;
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            z-index: 1;
            opacity: 0;
        }

        /* Hamburger */
        .menu-toggle {
            display: none;
            flex-direction: column;
            gap: 5px;
            padding: 8px;
            background: none;
            border: none;
            cursor: pointer;
            z-index: 1001;
        }
        .hamburger-line {
            display: block;
            width: 22px;
            height: 2px;
            background: var(--text-heading, #fff);
            border-radius: 2px;
            transition: all 0.3s;
        }
        .menu-toggle.active .hamburger-line:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
        }
        .menu-toggle.active .hamburger-line:nth-child(2) {
            opacity: 0;
        }
        .menu-toggle.active .hamburger-line:nth-child(3) {
            transform: rotate(-45deg) translate(5px, -5px);
        }

        /* Enhanced Footer */
        .site-footer {
            position: relative;
            background: linear-gradient(180deg, #0c0c0c 0%, #080808 100%);
            border-top: 1px solid rgba(255,255,255,0.05);
            overflow: hidden;
            margin-top: auto;
        }
        .footer-glow {
            position: absolute;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 600px;
            height: 200px;
            background: radial-gradient(ellipse, rgba(202, 138, 4, 0.08) 0%, transparent 70%);
            pointer-events: none;
        }
        .footer-inner {
            position: relative;
            z-index: 1;
            max-width: 1240px;
            margin: 0 auto;
            padding: 60px 20px 24px;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 48px;
            margin-bottom: 48px;
        }
        .footer-brand-col {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .footer-brand {
            font-family: var(--font-display, 'Source Serif 4', serif);
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.015em;
            color: var(--text-heading, #fff);
            text-decoration: none;
        }
        .footer-desc {
            font-family: var(--font-body, 'Source Serif 4', serif);
            font-size: 14px;
            color: var(--text-muted, #888);
            line-height: 1.7;
            max-width: 40ch;
            margin: 0;
        }
        .footer-socials {
            display: flex;
            gap: 12px;
            margin-top: 4px;
        }
        .footer-socials a {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted, #888);
            font-size: 14px;
            text-decoration: none;
            transition: all 0.2s;
        }
        .footer-socials a:hover {
            background: rgba(202, 138, 4, 0.1);
            border-color: rgba(202, 138, 4, 0.3);
            color: var(--hc-gold, #ca8a04);
            transform: translateY(-2px);
        }
        .footer-col-title {
            font-family: var(--font-sans, 'Source Sans 3', sans-serif);
            font-size: 11px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--hc-gold, #ca8a04);
            margin-bottom: 18px;
            font-weight: 600;
        }
        .footer-links-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 0;
            margin: 0;
        }
        .footer-links-col a {
            font-family: var(--font-body, 'Source Serif 4', serif);
            font-size: 14px;
            color: var(--text-body, #a0a0a0);
            text-decoration: none;
            transition: color 0.2s;
            position: relative;
            padding-left: 0;
            transition: all 0.2s;
        }
        .footer-links-col a:hover {
            color: var(--text-heading, #fff);
            padding-left: 8px;
        }
        .footer-links-col a::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 0;
            height: 1px;
            background: var(--hc-gold, #ca8a04);
            transition: width 0.2s;
        }
        .footer-links-col a:hover::before {
            width: 4px;
        }

        /* Verse */
        .footer-verse {
            padding: 32px 20px;
            border-top: 1px solid rgba(255,255,255,0.06);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            text-align: center;
            position: relative;
        }
        .footer-verse::before,
        .footer-verse::after {
            content: '"';
            position: absolute;
            font-family: var(--font-display);
            font-size: 60px;
            color: rgba(202, 138, 4, 0.1);
            line-height: 1;
        }
        .footer-verse::before {
            top: 10px;
            left: 20px;
        }
        .footer-verse::after {
            bottom: -10px;
            right: 20px;
        }
        .footer-verse p {
            max-width: 850px;
            margin: 0 auto;
            line-height: 1.6;
        }
        .verse-ref {
            font-family: var(--font-sans);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.12em;
            color: var(--hc-gold, #ca8a04);
            margin-right: 8px;
        }
        .verse-text {
            font-family: var(--font-display, 'Source Serif 4', serif);
            font-style: italic;
            font-size: 17px;
            color: var(--text-muted, #888);
        }

        /* Bottom Bar */
        .footer-bottom-bar {
            margin-top: 24px;
            font-family: var(--font-sans);
            font-size: 11px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-muted, #666);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }
        .footer-bottom-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .footer-dot {
            opacity: 0.4;
        }
        .footer-bottom-right {
            color: rgba(255,255,255,0.2);
        }

        /* Responsive */
        @media (max-width: 900px) {
            .footer-grid {
                grid-template-columns: 1fr 1fr;
                gap: 40px;
            }
            .footer-brand-col {
                grid-column: 1 / -1;
                text-align: center;
                align-items: center;
            }
            .footer-desc {
                max-width: 50ch;
            }
        }
        @media (max-width: 768px) {
            .nav-tabs {
                position: fixed;
                top: 0;
                right: -100%;
                width: 280px;
                height: 100vh;
                flex-direction: column;
                align-items: flex-start;
                padding: 80px 24px 24px;
                background: rgba(10, 10, 10, 0.98);
                backdrop-filter: blur(20px);
                border-radius: 0;
                border-left: 1px solid rgba(255,255,255,0.08);
                transition: right 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
                gap: 8px;
            }
            .nav-tabs.active {
                right: 0;
            }
            .nav-tab {
                width: 100%;
                padding: 12px 16px;
                font-size: 14px;
            }
            .nav-highlight {
                display: none;
            }
            .menu-toggle {
                display: flex;
            }
            .footer-grid {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .footer-links-col {
                text-align: center;
            }
            .footer-links-col a:hover {
                padding-left: 0;
            }
            .footer-links-col a::before {
                display: none;
            }
            .footer-bottom-bar {
                flex-direction: column;
                text-align: center;
            }
        }
        @media (max-width: 600px) {
            .footer-verse::before,
            .footer-verse::after {
                display: none;
            }
        }
    </style>

    <script is:inline>
        // Navbar scroll behavior
        let lastScroll = 0;
        const navbar = document.getElementById('navbar');
        
        window.addEventListener('scroll', () => {
            const currentScroll = window.pageYOffset;
            
            if (currentScroll > 50) {
                navbar.classList.add('nav-scrolled');
            } else {
                navbar.classList.remove('nav-scrolled');
            }
            
            if (currentScroll > lastScroll && currentScroll > 200) {
                navbar.classList.add('nav-hidden');
            } else {
                navbar.classList.remove('nav-hidden');
            }
            lastScroll = currentScroll;
        });

        // Mobile menu
        const menuToggle = document.getElementById('menuToggle');
        const navLinks = document.getElementById('navLinks');
        
        menuToggle?.addEventListener('click', () => {
            menuToggle.classList.toggle('active');
            navLinks?.classList.toggle('active');
        });

        // Close mobile menu on link click
        document.querySelectorAll('.nav-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                menuToggle?.classList.remove('active');
                navLinks?.classList.remove('active');
            });
        });

        // Nav highlight
        document.addEventListener('DOMContentLoaded', () => {
            const tabsContainer = document.getElementById('navLinks');
            if (!tabsContainer) return;
            
            const tabs = tabsContainer.querySelectorAll('.nav-tab');
            const highlight = document.getElementById('navHighlight');
            let activeTab = tabsContainer.querySelector('.nav-tab.active');

            function updateHighlight(targetTab) {
                if (!targetTab || !highlight || !tabsContainer) return;
                const containerRect = tabsContainer.getBoundingClientRect();
                const tabRect = targetTab.getBoundingClientRect();
                const offsetLeft = tabRect.left - containerRect.left;
                
                highlight.style.width = `${tabRect.width}px`;
                highlight.style.transform = `translateX(${offsetLeft}px)`;
            }

            if (activeTab && highlight) {
                highlight.style.opacity = '1';
                setTimeout(() => updateHighlight(activeTab), 100);
            }

            tabs.forEach(tab => {
                tab.addEventListener('mouseenter', () => updateHighlight(tab));
                tab.addEventListener('mouseleave', () => {
                    if (activeTab) updateHighlight(activeTab);
                });
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    activeTab = tab;
                    updateHighlight(activeTab);
                });
            });
            
            window.addEventListener('resize', () => {
                if (activeTab) updateHighlight(activeTab);
            });
        });
    </script>
  </body>
</html>
