---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
// @ts-ignore
const { title, description, date, author, tags, category, readTime } = article.data;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// @ts-ignore
const allArticles = await Astro.glob('../content/articles/*.md');
// @ts-ignore
const currentIndex = allArticles.findIndex((a: any) => a.frontmatter.title === title);
const prevArticle = allArticles[currentIndex - 1];
const nextArticle = allArticles[currentIndex + 1];
---

<BaseLayout title={title} description={description}>
  <!-- Reading Progress Bar -->
  <div class="reading-progress-container">
    <div class="reading-progress-bar" id="readingProgress"></div>
  </div>

  <!-- Article Hero Header -->
  <header class="article-hero">
    <div class="article-hero-bg">
      <div class="hero-noise"></div>
      <div class="hero-gradient"></div>
    </div>
    <div class="container article-hero-inner">
      <nav class="article-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep"><i class="fas fa-chevron-right"></i></span>
        <a href="/blogs">Blogs</a>
        <span class="breadcrumb-sep"><i class="fas fa-chevron-right"></i></span>
        <span class="breadcrumb-current">{category}</span>
      </nav>
      
      <h1 class="article-title">{title}</h1>
      
      <p class="article-excerpt">{description}</p>
      
      <div class="article-meta-bar">
        <div class="meta-author">
          <div class="author-avatar">
            <span>{author.charAt(0)}</span>
          </div>
          <div class="author-info">
            <span class="author-name">{author}</span>
            <span class="author-role">Research Contributor</span>
          </div>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <i class="far fa-calendar"></i>
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <i class="far fa-clock"></i>
          <span>{readTime || '8 min read'}</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item category-badge">
          <i class="fas fa-tag"></i>
          <span>{category}</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Article Body -->
  <div class="article-body container">
    <aside class="article-sidebar">
      <div class="sidebar-sticky">
        <!-- Table of Contents -->
        <div class="toc-card">
          <h3><i class="fas fa-list-ul"></i> Contents</h3>
          <nav class="toc-nav" id="tocNav" aria-label="Table of contents">
            <!-- Populated by JS -->
          </nav>
        </div>
        
        <!-- Share -->
        <div class="share-card">
          <h3>Share</h3>
          <div class="share-buttons">
            <button class="share-btn" onclick="shareArticle('twitter')" aria-label="Share on Twitter">
              <i class="fab fa-twitter"></i>
            </button>
            <button class="share-btn" onclick="shareArticle('facebook')" aria-label="Share on Facebook">
              <i class="fab fa-facebook-f"></i>
            </button>
            <button class="share-btn" onclick="shareArticle('copy')" aria-label="Copy link">
              <i class="fas fa-link"></i>
            </button>
          </div>
        </div>
      </div>
    </aside>

    <main class="article-main">
      <div class="article-content prose" id="articleContent">
        <slot />
      </div>

      <!-- Tags -->
      {tags && tags.length > 0 && (
        <div class="article-tags">
          <span class="tags-label"><i class="fas fa-tags"></i> Tags:</span>
          {tags.map(tag => (
            <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag-link">
              {tag}
            </a>
          ))}
        </div>
      )}

      <!-- Author Card -->
      <div class="author-card">
        <div class="author-card-avatar">
          <span>{author.charAt(0)}</span>
        </div>
        <div class="author-card-info">
          <h4>Written by <span class="author-card-name">{author}</span></h4>
          <p>Contributing researcher at HadithCritic, examining traditional Islamic narratives through historical and philosophical analysis.</p>
          <div class="author-card-social">
            <a href="https://twitter.com/HadithCritic" target="_blank"><i class="fab fa-twitter"></i></a>
            <a href="https://github.com/HadithCritic" target="_blank"><i class="fab fa-github"></i></a>
          </div>
        </div>
      </div>

      <!-- Prev/Next Navigation -->
      <nav class="article-nav" aria-label="Article navigation">
        {prevArticle && (
          <a href={prevArticle.url} class="article-nav-prev">
            <span class="nav-label"><i class="fas fa-arrow-left"></i> Previous</span>
            <span class="nav-title">{prevArticle.frontmatter.title}</span>
          </a>
        )}
        {nextArticle && (
          <a href={nextArticle.url} class="article-nav-next">
            <span class="nav-label">Next <i class="fas fa-arrow-right"></i></span>
            <span class="nav-title">{nextArticle.frontmatter.title}</span>
          </a>
        )}
      </nav>
    </main>
  </div>

  <script is:inline>
    // Reading Progress
    function updateReadingProgress() {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      document.getElementById('readingProgress').style.width = scrolled + '%';
    }
    window.addEventListener('scroll', updateReadingProgress);

    // Table of Contents Generator
    function generateTOC() {
      const content = document.getElementById('articleContent');
      const tocNav = document.getElementById('tocNav');
      if (!content || !tocNav) return;
      
      const headings = content.querySelectorAll('h2, h3');
      if (headings.length === 0) {
        tocNav.innerHTML = '<p class="toc-empty">No sections found</p>';
        return;
      }
      
      const ul = document.createElement('ul');
      headings.forEach((heading, index) => {
        const id = 'section-' + index;
        heading.id = id;
        const li = document.createElement('li');
        li.className = heading.tagName === 'H3' ? 'toc-h3' : 'toc-h2';
        const a = document.createElement('a');
        a.href = '#' + id;
        a.textContent = heading.textContent;
        a.addEventListener('click', (e) => {
          e.preventDefault();
          document.getElementById(id).scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        li.appendChild(a);
        ul.appendChild(li);
      });
      tocNav.appendChild(ul);
    }
    
    // Active TOC highlighting
    function highlightTOC() {
      const headings = document.querySelectorAll('#articleContent h2, #articleContent h3');
      const tocLinks = document.querySelectorAll('#tocNav a');
      let current = '';
      
      headings.forEach(heading => {
        const sectionTop = heading.offsetTop;
        if (scrollY >= sectionTop - 150) {
          current = heading.getAttribute('id');
        }
      });
      
      tocLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + current) {
          link.classList.add('active');
        }
      });
    }

    // Share functionality
    function shareArticle(platform) {
      const url = encodeURIComponent(window.location.href);
      const text = encodeURIComponent(document.title);
      const shareUrls = {
        twitter: `https://twitter.com/intent/tweet?url=${url}&text=${text}`,
        facebook: `https://www.facebook.com/sharer/sharer.php?u=${url}`,
        copy: null
      };
      
      if (platform === 'copy') {
        navigator.clipboard.writeText(window.location.href);
        const btn = document.querySelector('.share-btn[onclick*="copy"]');
        const original = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check"></i>';
        setTimeout(() => btn.innerHTML = original, 2000);
      } else {
        window.open(shareUrls[platform], '_blank', 'width=600,height=400');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      generateTOC();
      window.addEventListener('scroll', highlightTOC);
    });
  </script>

  <style>
    /* Reading Progress */
    .reading-progress-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: rgba(255,255,255,0.05);
      z-index: 9999;
    }
    .reading-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--hc-gold, #ca8a04), #eab308);
      width: 0%;
      transition: width 0.1s;
    }

    /* Article Hero */
    .article-hero {
      position: relative;
      padding: 120px 20px 60px;
      overflow: hidden;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .article-hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .hero-noise {
      position: absolute;
      inset: 0;
      opacity: 0.03;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    }
    .hero-gradient {
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(ellipse at 20% 50%, rgba(202, 138, 4, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 0%, rgba(202, 138, 4, 0.05) 0%, transparent 40%),
        linear-gradient(180deg, rgba(10,10,10,0) 0%, var(--bg, #0a0a0a) 100%);
    }
    .article-hero-inner {
      position: relative;
      z-index: 1;
      max-width: 900px;
    }

    /* Breadcrumbs */
    .article-breadcrumbs {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 32px;
      font-family: var(--font-sans, 'Inter', sans-serif);
      font-size: 12px;
      color: var(--text-muted, #888);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .article-breadcrumbs a {
      color: var(--text-muted, #888);
      text-decoration: none;
      transition: color 0.2s;
    }
    .article-breadcrumbs a:hover {
      color: var(--hc-gold, #ca8a04);
    }
    .breadcrumb-sep {
      font-size: 8px;
      opacity: 0.5;
    }
    .breadcrumb-current {
      color: var(--hc-gold, #ca8a04);
    }

    /* Title */
    .article-title {
      font-family: var(--font-display, 'Cormorant Garamond', serif);
      font-size: clamp(36px, 5vw, 64px);
      font-weight: 700;
      line-height: 1.1;
      color: var(--text-heading, #fff);
      margin: 0 0 20px 0;
      letter-spacing: -0.02em;
    }

    /* Excerpt */
    .article-excerpt {
      font-family: var(--font-body, 'Source Serif 4', serif);
      font-size: clamp(16px, 2vw, 20px);
      line-height: 1.6;
      color: var(--text-body, #b0b0b0);
      max-width: 700px;
      margin: 0 0 32px 0;
      font-style: italic;
    }

    /* Meta Bar */
    .article-meta-bar {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      padding: 16px 0;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .meta-author {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .author-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--hc-gold, #ca8a04), #a16207);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 16px;
      color: #fff;
    }
    .author-info {
      display: flex;
      flex-direction: column;
    }
    .author-name {
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 600;
      color: var(--text-heading, #fff);
    }
    .author-role {
      font-family: var(--font-sans);
      font-size: 11px;
      color: var(--text-muted, #888);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .meta-divider {
      width: 1px;
      height: 24px;
      background: rgba(255,255,255,0.1);
    }
    .meta-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-sans);
      font-size: 13px;
      color: var(--text-muted, #888);
    }
    .meta-item i {
      color: var(--hc-gold, #ca8a04);
      font-size: 12px;
    }
    .category-badge {
      background: rgba(202, 138, 4, 0.1);
      padding: 4px 12px;
      border-radius: 999px;
      border: 1px solid rgba(202, 138, 4, 0.2);
      color: var(--hc-gold, #ca8a04);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
    }

    /* Article Body Layout */
    .article-body {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 60px;
      padding: 60px 20px;
      max-width: 1200px;
    }

    /* Sidebar */
    .article-sidebar {
      position: relative;
    }
    .sidebar-sticky {
      position: sticky;
      top: 100px;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .toc-card, .share-card {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px;
      padding: 20px;
    }
    .toc-card h3, .share-card h3 {
      font-family: var(--font-sans);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--text-heading, #fff);
      margin: 0 0 16px 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .toc-card h3 i {
      color: var(--hc-gold, #ca8a04);
      font-size: 12px;
    }
    .toc-nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .toc-nav li {
      position: relative;
    }
    .toc-nav a {
      display: block;
      padding: 6px 0;
      font-family: var(--font-sans);
      font-size: 13px;
      color: var(--text-muted, #888);
      text-decoration: none;
      border-left: 2px solid transparent;
      padding-left: 12px;
      margin-left: -12px;
      transition: all 0.2s;
      line-height: 1.4;
    }
    .toc-nav a:hover {
      color: var(--text-body, #d4d4d4);
      border-left-color: rgba(202, 138, 4, 0.3);
    }
    .toc-nav a.active {
      color: var(--hc-gold, #ca8a04);
      border-left-color: var(--hc-gold, #ca8a04);
      font-weight: 500;
    }
    .toc-h3 a {
      padding-left: 20px;
      font-size: 12px;
    }
    .toc-empty {
      font-size: 12px;
      color: var(--text-muted);
      font-style: italic;
    }

    /* Share */
    .share-buttons {
      display: flex;
      gap: 8px;
    }
    .share-btn {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      color: var(--text-body, #d4d4d4);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .share-btn:hover {
      background: var(--hc-gold, #ca8a04);
      color: #fff;
      border-color: var(--hc-gold, #ca8a04);
      transform: translateY(-2px);
    }

    /* Main Content */
    .article-main {
      min-width: 0;
    }

    /* Prose Styling */
    .prose {
      font-family: var(--font-body, 'Source Serif 4', serif);
      font-size: 17px;
      line-height: 1.8;
      color: var(--text-body, #c0c0c0);
    }
    .prose :global(p) {
      margin: 0 0 1.5em 0;
    }
    .prose :global(h2) {
      font-family: var(--font-display, 'Cormorant Garamond', serif);
      font-size: 32px;
      font-weight: 700;
      color: var(--text-heading, #fff);
      margin: 2em 0 0.6em;
      padding-bottom: 0.3em;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      letter-spacing: -0.01em;
    }
    .prose :global(h3) {
      font-family: var(--font-display, 'Cormorant Garamond', serif);
      font-size: 24px;
      font-weight: 600;
      color: var(--text-heading, #fff);
      margin: 1.8em 0 0.5em;
    }
    .prose :global(blockquote) {
      margin: 2em 0;
      padding: 24px 32px;
      border-left: 3px solid var(--hc-gold, #ca8a04);
      background: rgba(202, 138, 4, 0.05);
      border-radius: 0 12px 12px 0;
      font-style: italic;
      color: var(--text-body, #d4d4d4);
    }
    .prose :global(blockquote p:last-child) {
      margin-bottom: 0;
    }
    .prose :global(ul), .prose :global(ol) {
      margin: 0 0 1.5em 0;
      padding-left: 1.5em;
    }
    .prose :global(li) {
      margin-bottom: 0.5em;
    }
    .prose :global(a) {
      color: var(--hc-gold, #ca8a04);
      text-decoration: underline;
      text-decoration-color: rgba(202, 138, 4, 0.3);
      text-underline-offset: 3px;
      transition: all 0.2s;
    }
    .prose :global(a:hover) {
      text-decoration-color: var(--hc-gold, #ca8a04);
    }
    .prose :global(code) {
      font-family: var(--font-mono, 'JetBrains Mono', monospace);
      font-size: 0.9em;
      background: rgba(255,255,255,0.05);
      padding: 2px 6px;
      border-radius: 4px;
      color: #e2e8f0;
    }
    .prose :global(pre) {
      background: rgba(0,0,0,0.4);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 20px;
      overflow-x: auto;
      margin: 1.5em 0;
    }
    .prose :global(pre code) {
      background: none;
      padding: 0;
    }
    .prose :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: 12px;
      margin: 2em 0;
      border: 1px solid rgba(255,255,255,0.06);
    }
    .prose :global(hr) {
      border: none;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
      margin: 3em 0;
    }

    /* Tags */
    .article-tags {
      margin: 48px 0 32px;
      padding-top: 32px;
      border-top: 1px solid rgba(255,255,255,0.06);
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .tags-label {
      font-family: var(--font-sans);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted, #888);
      margin-right: 4px;
    }
    .tag-link {
      font-family: var(--font-sans);
      font-size: 12px;
      padding: 6px 14px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 999px;
      color: var(--text-body, #b0b0b0);
      text-decoration: none;
      transition: all 0.2s;
    }
    .tag-link:hover {
      background: rgba(202, 138, 4, 0.1);
      border-color: rgba(202, 138, 4, 0.3);
      color: var(--hc-gold, #ca8a04);
    }

    /* Author Card */
    .author-card {
      display: flex;
      gap: 20px;
      padding: 28px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px;
      margin: 40px 0;
    }
    .author-card-avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--hc-gold, #ca8a04), #a16207);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 22px;
      color: #fff;
      flex-shrink: 0;
    }
    .author-card-info h4 {
      font-family: var(--font-sans);
      font-size: 14px;
      color: var(--text-muted, #888);
      margin: 0 0 8px 0;
      font-weight: 400;
    }
    .author-card-name {
      color: var(--text-heading, #fff);
      font-weight: 600;
    }
    .author-card-info p {
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--text-body, #a0a0a0);
      line-height: 1.6;
      margin: 0 0 12px 0;
    }
    .author-card-social {
      display: flex;
      gap: 12px;
    }
    .author-card-social a {
      color: var(--text-muted, #888);
      font-size: 16px;
      transition: color 0.2s;
    }
    .author-card-social a:hover {
      color: var(--hc-gold, #ca8a04);
    }

    /* Article Nav */
    .article-nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 48px;
      padding-top: 32px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .article-nav a {
      padding: 20px 24px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      text-decoration: none;
      transition: all 0.3s;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .article-nav a:hover {
      background: rgba(255,255,255,0.04);
      border-color: rgba(202, 138, 4, 0.2);
      transform: translateY(-2px);
    }
    .article-nav-next {
      text-align: right;
      align-items: flex-end;
    }
    .nav-label {
      font-family: var(--font-sans);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--hc-gold, #ca8a04);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .nav-title {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 600;
      color: var(--text-heading, #fff);
      line-height: 1.3;
    }

    /* Responsive */
    @media (max-width: 900px) {
      .article-body {
