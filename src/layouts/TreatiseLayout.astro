---
import BaseLayout from './BaseLayout.astro';
import ManuscriptLightbox from '../components/treatise/ManuscriptLightbox.astro';
import chaptersData from '../data/shirk-endorsed/chapters.json';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
  prevPage?: { title: string; href: string } | null;
  nextPage?: { title: string; href: string } | null;
}

const {
  title,
  description = "A 10-century evidentiary critical edition documenting the classical Sunni scholarly consensus on Tawassul, Tashaffuʿ, and Istighāthah.",
  currentSlug = 'index',
  prevPage = null,
  nextPage = null
} = Astro.props;

// Group chapters into sections
const coreChapters = chaptersData.filter((c) => c.category === 'core');
const imamsChapters = chaptersData.filter((c) => c.category === 'four-imams');
---

<BaseLayout title={`${title} | HadithCritic`} description={description}>
  <div class="treatise-page">
    <!-- Top Reading Progress Indicator -->
    <div id="readingProgress" class="reading-progress-bar" aria-hidden="true"></div>

    <div class="wrap treatise-container">
      <!-- Sticky Sidebar Table of Contents -->
      <aside class="treatise-sidebar" id="treatiseSidebar">
        <div class="sidebar-sticky">
          <div class="sidebar-header">
            <a href="/research/shirk-endorsed" class="treatise-back-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
              <span>Archival Overview & Register</span>
            </a>
            <span class="sidebar-eyebrow">Critical Research Edition</span>
            <h2 class="sidebar-title">Shirk: Endorsed By The Scholars of Islam</h2>
          </div>

          <nav class="sidebar-nav" aria-label="Treatise Table of Contents">
            <!-- Part 1: Core Treatises -->
            <div class="nav-section">
              <span class="nav-section-title">Part I: Foundational Studies</span>
              <ul class="nav-list">
                {coreChapters.map((c, i) => {
                  const href = `/research/shirk-endorsed/${c.id}`;
                  const isActive = currentSlug === c.id;
                  return (
                    <li>
                      <a href={href} class={`nav-item ${isActive ? 'is-active' : ''}`}>
                        <span class="nav-item__num">{String(i + 1).padStart(2, '0')}</span>
                        <span class="nav-item__text">{c.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>

            <!-- Part 2: The 4 Imams -->
            <div class="nav-section">
              <span class="nav-section-title">Part II: The Four Sunni Imams</span>
              <ul class="nav-list">
                {imamsChapters.map((c, i) => {
                  const href = `/research/shirk-endorsed/${c.id}`;
                  const isActive = currentSlug === c.id;
                  return (
                    <li>
                      <a href={href} class={`nav-item ${isActive ? 'is-active' : ''}`}>
                        <span class="nav-item__num nav-item__num--gold">{String(i + 1).padStart(2, '0')}</span>
                        <span class="nav-item__text">{c.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>

            <!-- Part 3: The Major Scholars -->
            <div class="nav-section">
              <span class="nav-section-title">Part III: The 99 Major Scholars</span>
              <ul class="nav-list">
                <li>
                  <a
                    href="/research/shirk-endorsed/scholars-worth-mentioning"
                    class={`nav-item ${currentSlug === 'scholars-worth-mentioning' ? 'is-active' : ''}`}
                  >
                    <span class="nav-item__num">★</span>
                    <span class="nav-item__text">Scholars Worth Mentioning</span>
                  </a>
                </li>
                <li>
                  <a
                    href="/research/shirk-endorsed/ledger"
                    class="nav-item nav-item--highlight"
                  >
                    <span class="nav-item__num">↗</span>
                    <span class="nav-item__text">Interactive 99-Scholar Ledger</span>
                  </a>
                </li>
              </ul>
            </div>
          </nav>
        </div>
      </aside>

      <!-- Main Reading Column -->
      <div class="treatise-main" id="mainContent">
        <!-- Breadcrumbs -->
        <nav class="treatise-breadcrumbs" aria-label="Breadcrumb">
          <a href="/" class="crumb-link">HadithCritic</a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <a href="/research/shirk-endorsed" class="crumb-link">Shirk: Endorsed By Scholars</a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <span class="crumb-current" aria-current="page">{title}</span>
        </nav>

        <article class="treatise-prose">
          <slot />
        </article>

        <!-- Previous / Next Navigation Footer -->
        {(prevPage || nextPage) && (
          <footer class="treatise-pagination">
            {prevPage ? (
              <a href={prevPage.href} class="pagination-btn pagination-btn--prev">
                <span class="pagination-label">← Previous Chapter</span>
                <span class="pagination-title">{prevPage.title}</span>
              </a>
            ) : <div />}

            {nextPage ? (
              <a href={nextPage.href} class="pagination-btn pagination-btn--next">
                <span class="pagination-label">Next Chapter →</span>
                <span class="pagination-title">{nextPage.title}</span>
              </a>
            ) : <div />}
          </footer>
        )}
      </div>
    </div>

    <!-- Mobile Drawer Trigger -->
    <div class="mobile-toc-bar">
      <button type="button" class="mobile-toc-toggle" id="mobileTocToggle" aria-label="Toggle Chapter Navigation">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <span>Chapter Index & Navigation</span>
      </button>
    </div>
  </div>

  <ManuscriptLightbox />
</BaseLayout>

<style>
  .treatise-page {
    position: relative;
    background: var(--hc-surface-0, #0c0c0d);
    min-height: 100vh;
  }

  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--hc-gold, #c8a755), var(--hc-gold-bright, #e8c878));
    z-index: 100;
    width: 0%;
    transition: width 0.08s ease;
  }

  .treatise-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  @media (min-width: 1024px) {
    .treatise-container {
      grid-template-columns: 290px minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  /* ── Sidebar ── */
  .treatise-sidebar {
    position: relative;
  }

  @media (min-width: 1024px) {
    .treatise-sidebar {
      position: sticky;
      top: 90px;
      align-self: start;
      max-height: calc(100vh - 110px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--hc-rule, rgba(255, 255, 255, 0.1)) transparent;
    }
  }

  .sidebar-sticky {
    padding-right: 1.25rem;
  }

  .sidebar-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
  }

  .treatise-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--hc-gold, #c8a755);
    text-decoration: none;
    font-family: var(--font-ui, sans-serif);
    font-weight: 600;
    margin-bottom: 0.85rem;
    transition: color 0.15s ease;
  }

  .treatise-back-link:hover {
    color: var(--hc-gold-bright, #e8c878);
  }

  .sidebar-eyebrow {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hc-text-tertiary, #858077);
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
  }

  .sidebar-title {
    font-size: 1.1rem;
    line-height: 1.35;
    color: var(--hc-text-primary, #f5f2eb);
    font-family: var(--font-display, serif);
    font-weight: 600;
    margin: 0.35rem 0 0;
  }

  .nav-section {
    margin-bottom: 1.5rem;
  }

  .nav-section-title {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hc-gold, #c8a755);
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.45rem 0.65rem;
    font-size: 0.82rem;
    color: var(--hc-text-secondary, #b5b0a5);
    text-decoration: none;
    font-family: var(--font-ui, sans-serif);
    border-radius: 3px;
    line-height: 1.35;
    transition: all 0.15s ease;
  }

  .nav-item__num {
    font-family: var(--font-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--hc-text-tertiary, #858077);
    flex-shrink: 0;
  }

  .nav-item__num--gold {
    color: var(--hc-gold, #c8a755);
  }

  .nav-item__text {
    flex: 1;
  }

  .nav-item:hover {
    color: var(--hc-text-primary, #f5f2eb);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-item.is-active {
    color: var(--hc-gold, #c8a755);
    background: rgba(200, 167, 85, 0.12);
    font-weight: 600;
    border-left: 2px solid var(--hc-gold, #c8a755);
  }

  .nav-item.is-active .nav-item__num {
    color: var(--hc-gold, #c8a755);
  }

  .nav-item--highlight {
    color: var(--hc-gold, #c8a755);
    font-weight: 600;
  }

  /* ── Main Reading Area ── */
  .treatise-main {
    max-width: 800px;
    width: 100%;
  }

  .treatise-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--hc-text-tertiary, #858077);
    font-family: var(--font-ui, sans-serif);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .crumb-link {
    color: var(--hc-text-secondary, #b5b0a5);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .crumb-link:hover {
    color: var(--hc-gold, #c8a755);
  }

  .crumb-sep {
    color: var(--hc-rule-strong, rgba(255, 255, 255, 0.15));
  }

  .crumb-current {
    color: var(--hc-text-primary, #f5f2eb);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Typography & Prose ── */
  .treatise-prose :global(h2) {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    font-family: var(--font-display, serif);
    color: var(--hc-text-primary, #f5f2eb);
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    line-height: 1.2;
    font-weight: 500;
    border-bottom: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
    padding-bottom: 0.65rem;
  }

  .treatise-prose :global(h3) {
    font-size: clamp(1.22rem, 1.7vw, 1.45rem);
    font-family: var(--font-display, serif);
    color: var(--hc-gold, #c8a755);
    margin-top: 2.5rem;
    margin-bottom: 0.85rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .treatise-prose :global(h4) {
    font-size: 0.92rem;
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hc-gold, #c8a755);
    margin-top: 2rem;
    margin-bottom: 0.6rem;
  }

  .treatise-prose :global(p) {
    font-size: clamp(1.05rem, 1.2vw, 1.12rem);
    line-height: 1.85;
    color: var(--hc-text-secondary, #dcd8cf);
    margin-bottom: 1.5rem;
  }

  .treatise-prose :global(p strong),
  .treatise-prose :global(li strong) {
    color: var(--hc-text-primary, #f5f2eb);
    font-weight: 600;
  }

  .treatise-prose :global(p em),
  .treatise-prose :global(li em) {
    font-style: italic;
    color: var(--hc-gold, #c8a755);
  }

  /* ── Bilingual / Arabic source text ── */
  .treatise-prose :global(.arabic-text) {
    direction: rtl;
    text-align: right;
    margin: 1.25rem 0 1.75rem;
    padding: 1.35rem 1.5rem;
    background: rgba(242, 235, 220, 0.035);
    border: 1px solid rgba(200, 167, 85, 0.18);
    border-right: 3px solid var(--hc-gold, #c8a755);
    border-radius: 4px 0 0 4px;
  }

  .treatise-prose :global(.arabic-text p) {
    margin: 0;
    color: var(--hc-text-primary, #f5f2eb);
    font-family: var(--font-arabic, var(--font-display, serif));
    font-size: clamp(1.22rem, 1.65vw, 1.48rem);
    line-height: 2.15;
    letter-spacing: 0;
  }

  .treatise-prose :global(ul), .treatise-prose :global(ol) {
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
    color: var(--hc-text-secondary, #dcd8cf);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .treatise-prose :global(ul ul),
  .treatise-prose :global(ol ol) {
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
  }

  .treatise-prose :global(li) {
    margin-bottom: 0.65rem;
  }

  .treatise-prose :global(li::marker) {
    color: var(--hc-gold, #c8a755);
  }

  .treatise-prose :global(blockquote) {
    margin: 2rem 0;
    padding: 1.35rem 1.75rem;
    background: linear-gradient(135deg, rgba(200, 167, 85, 0.06) 0%, rgba(20, 20, 22, 0.5) 100%);
    border-left: 3px solid var(--hc-gold, #c8a755);
    border-radius: 0 4px 4px 0;
    font-family: var(--font-display, serif);
    font-size: clamp(1.1rem, 1.35vw, 1.25rem);
    font-style: italic;
    line-height: 1.65;
    color: var(--hc-text-primary, #f5f2eb);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .treatise-prose :global(blockquote strong) {
    color: #fff;
    font-weight: 600;
  }

  .treatise-prose :global(hr) {
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--hc-rule, rgba(255, 255, 255, 0.12)) 20%, var(--hc-rule, rgba(255, 255, 255, 0.12)) 80%, transparent 100%);
    margin: 3.5rem 0;
  }

  .treatise-prose :global(a) {
    color: var(--hc-gold, #c8a755);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .treatise-prose :global(a:hover) {
    color: var(--hc-gold-bright, #e8c878);
  }

  /* ── Pagination ── */
  .treatise-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
  }

  .pagination-btn {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.4rem;
    background: var(--hc-surface-1, #141416);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.1));
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pagination-btn:hover {
    border-color: var(--hc-gold, #c8a755);
    background: var(--hc-surface-2, #18181b);
    transform: translateY(-2px);
  }

  .pagination-btn--next {
    text-align: right;
  }

  .pagination-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hc-gold, #c8a755);
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .pagination-title {
    font-size: 1.05rem;
    color: var(--hc-text-primary, #f5f2eb);
    font-family: var(--font-display, serif);
    font-weight: 600;
    line-height: 1.3;
  }

  /* ── Mobile TOC Bar ── */
  .mobile-toc-bar {
    display: none;
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
  }

  .mobile-toc-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.25rem;
    background: var(--hc-surface-1, #141416);
    border: 1px solid var(--hc-gold, #c8a755);
    border-radius: 4px;
    color: var(--hc-gold, #c8a755);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    cursor: pointer;
  }

  @media (max-width: 1023px) {
    .treatise-sidebar {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(12, 12, 13, 0.95);
      z-index: 90;
      padding: 2rem 1.5rem;
      overflow-y: auto;
    }

    .treatise-sidebar.is-open {
      display: block;
    }

    .mobile-toc-bar {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .treatise-pagination {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Reading progress
    const progressBar = document.getElementById('readingProgress');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
        progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      }, { passive: true });
    }

    // Mobile TOC Toggle
    const mobileBtn = document.getElementById('mobileTocToggle');
    const sidebar = document.getElementById('treatiseSidebar');
    if (mobileBtn && sidebar) {
      mobileBtn.addEventListener('click', () => {
        sidebar.classList.toggle('is-open');
        if (sidebar.classList.contains('is-open')) {
          mobileBtn.querySelector('span').textContent = 'Close Chapter Index ✕';
        } else {
          mobileBtn.querySelector('span').textContent = 'Chapter Index & Navigation';
        }
      });
    }

    // Auto-bind click on manuscript scans inside prose to trigger lightbox
    document.querySelectorAll('.manuscript-scan').forEach((img) => {
      img.addEventListener('click', () => {
        const trigger = document.querySelector(`[data-lightbox-src="${img.getAttribute('src')}"]`);
        if (trigger) {
          trigger.click();
        } else {
          const lightbox = document.getElementById('manuscriptLightbox');
          const lightboxImg = document.getElementById('lightboxImg');
          if (lightbox && lightboxImg) {
            lightboxImg.src = img.getAttribute('src');
            lightbox.hidden = false;
            requestAnimationFrame(() => lightbox.classList.add('is-open'));
            document.body.style.overflow = 'hidden';
          }
        }
      });
    });
  });
</script>
