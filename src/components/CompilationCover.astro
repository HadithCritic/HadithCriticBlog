---
/** Decorative bindings, drawn for the catalogue rather than historical editions. */
interface Props { slug: string; title: string; }
const { slug, title } = Astro.props;
const designs: Record<string, { tone: string; motif: string }> = {
  'sahih-al-bukhari': { tone: 'copper', motif: 'palmette' },
  'sahih-muslim': { tone: 'black', motif: 'lobed' },
  'sunan-ibn-majah': { tone: 'bronze', motif: 'almond' },
  'sunan-abi-dawud': { tone: 'umber', motif: 'lattice' },
  'jami-al-tirmidhi': { tone: 'charcoal', motif: 'rosette' },
  'sunan-al-nasa-i': { tone: 'warm', motif: 'arch' },
};
const design = designs[slug];
const id = `binding-${slug}`;
---

<svg class={`compilation-cover compilation-cover--${design.tone}`} viewBox="0 0 520 320" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={`${id}-grain`} width="8" height="8" patternUnits="userSpaceOnUse">
      <path d="M0 2h3m2 4h3M2 0v1m4 6v2" class="compilation-cover__grain" />
    </pattern>
    <pattern id={`${id}-vine`} width="28" height="16" patternUnits="userSpaceOnUse">
      <path d="M0 8C7-3 21 19 28 8M0 8C7 19 21-3 28 8M14 3l4 5-4 5-4-5z" fill="none" stroke="var(--binding-foil)" stroke-width="0.8" />
    </pattern>
    <pattern id={`${id}-diaper`} width="22" height="22" patternUnits="userSpaceOnUse">
      <path d="M11 0L22 11 11 22 0 11zM11 7l4 4-4 4-4-4z" fill="none" stroke="var(--binding-foil)" stroke-width="0.8" />
    </pattern>
    <g id={`${id}-corner`}>
      <path d="M0 0h50C40 4 42 16 29 17S17 35 0 42z" />
      <path d="M5 5h31C25 9 31 17 19 20S13 31 5 33zM9 9c17-1 1 20 13 9m-9-6c9-2-3 15 7 8" />
      <path d="M38 3l4 4-4 4-4-4zM3 36l4 4-4 4-4-4z" />
    </g>
    <g id={`${id}-flower`}>
      <path d="M0-28C8-19 5-13 12-12S19-8 28 0C19 8 13 5 12 12S8 19 0 28C-8 19-5 13-12 12S-19 8-28 0C-19-8-13-5-12-12S-8-19 0-28z" />
      <path d="M0-17 5-5 17 0 5 5 0 17-5 5-17 0-5-5z" />
      <circle r="3" />
    </g>
  </defs>
  <rect width="520" height="320" class="compilation-cover__ground" />
  <rect width="520" height="320" fill={`url(#${id}-grain)`} />
  <g class="compilation-cover__tooling" fill="none">
    <rect x="8" y="8" width="504" height="304" />
    <rect x="13" y="13" width="494" height="294" />
    <path d="M26 29H494V291H26z" />
    <rect x="26" y="15" width="468" height="12" fill={`url(#${id}-vine)`} stroke="none" />
    <rect x="26" y="293" width="468" height="12" fill={`url(#${id}-vine)`} stroke="none" />
    <use href={`#${id}-corner`} transform="translate(27 30) scale(.6)" />
    <use href={`#${id}-corner`} transform="translate(493 30) scale(-.6 .6)" />
    <use href={`#${id}-corner`} transform="translate(27 290) scale(.6 -.6)" />
    <use href={`#${id}-corner`} transform="translate(493 290) scale(-.6 -.6)" />
  </g>
  <!-- The fore-edge and stamped centre occupy the illustration half. -->
  <g class="compilation-cover__panel">
    <path d="M323 45h145v230H323z" class="compilation-cover__inlay" />
    <g class="compilation-cover__tooling" fill="none">
      <path d="M328 49h135v222H328zM333 54h125v212H333z" />
      <rect x="337" y="58" width="117" height="204" fill={`url(#${id}-diaper)`} class="compilation-cover__lattice" stroke="none" />
      {design.motif === 'palmette' && <>
        <path d="M395 68C375 91 345 89 346 123v74c-1 34 29 32 49 55 20-23 50-21 49-55v-74c1-34-29-32-49-55z" class="compilation-cover__medallion" />
        <path d="M395 85v30m0-9c-24-3-22-19-22-19 17 1 22 19 22 19s5-18 22-19c0 0 2 16-22 19M395 235v-29m0 9c-24 3-22 19-22 19 17-1 22-19 22-19s5 18 22 19c0 0 2-16-22-19" />
      </>}
      {design.motif === 'lobed' && <>
        <path d="M395 69c11 15 27 5 30 23 22-3 14 20 24 27-12 16 4 26-7 41 11 15-5 25 7 41-10 7-2 30-24 27-3 18-19 8-30 23-11-15-27-5-30-23-22 3-14-20-24-27 12-16-4-26 7-41-11-15 5-25-7-41 10-7 2-30 24-27 3-18 19-8 30-23z" class="compilation-cover__medallion" />
        <use href={`#${id}-flower`} transform="translate(395 98) scale(.5)" />
        <use href={`#${id}-flower`} transform="translate(395 222) scale(.5)" />
      </>}
      {design.motif === 'almond' && <>
        <path d="M395 69c-68 43-68 139 0 182 68-43 68-139 0-182z" class="compilation-cover__medallion" />
        <path d="M395 80c-57 40-57 120 0 160 57-40 57-120 0-160zM395 91l8 12-8 12-8-12zM395 229l8-12-8-12-8 12z" />
      </>}
      {design.motif === 'lattice' && <>
        <path d="M370 78h50l23 23v118l-23 23h-50l-23-23V101z" class="compilation-cover__medallion" />
        <path d="M374 85h42l20 20v110l-20 20h-42l-20-20V105zM395 90l9 9-9 9-9-9zM395 230l9-9-9-9-9 9z" />
      </>}
      {design.motif === 'rosette' && <>
        <path d="M395 72l14 11 19-2 6 19 16 10-6 19 6 19-14 12 14 12-6 19 6 19-16 10-6 19-19-2-14 11-14-11-19 2-6-19-16-10 6-19-6-19 14-12-14-12 6-19-6-19 16-10 6-19 19 2z" class="compilation-cover__medallion" />
        <use href={`#${id}-flower`} transform="translate(395 100) scale(.55)" />
        <use href={`#${id}-flower`} transform="translate(395 220) scale(.55)" />
      </>}
      {design.motif === 'arch' && <>
        <path d="M350 241V114c0-16 32-24 45-45 13 21 45 29 45 45v127z" class="compilation-cover__medallion" />
        <path d="M357 233V117c0-14 28-23 38-37 10 14 38 23 38 37v116zM357 213h76" />
        <use href={`#${id}-flower`} transform="translate(395 103) scale(.45)" />
      </>}
      <path d="M350 134h90q-8 8-8 26t8 26h-90q8-8 8-26t-8-26z" class="compilation-cover__cartouche" />
      <path d="M360 140h70M360 180h70" />
      <path d="M376 195h38m-29 5h20" />
    </g>
    <foreignObject x="355" y="141" width="80" height="39">
      <div class="compilation-cover__stamp" lang="ar" dir="rtl">{title}</div>
    </foreignObject>
  </g>
</svg>
