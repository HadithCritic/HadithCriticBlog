---
import { deathDate, readerFor, roundedWords, type HistorySource } from '../../data/history';

interface Props { source: HistorySource; index: number; }
const { source, index } = Astro.props;
const titleId = `${source.id}-title`;
const reader = readerFor(source);
const numeral = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'][index] ?? String(index + 1);
---

<article class="history-source" id={source.id} aria-labelledby={titleId} data-history-source>
  <figure class="history-source__figure">
    <a
      href={`${source.imageBase}-1600.webp`}
      target="_blank"
      rel="noopener noreferrer"
      data-history-zoom
      data-caption={source.imageCaption}
      aria-label={`Enlarge the illustration for ${source.title}`}
    >
      <img
        src={`${source.imageBase}-1600.webp`}
        srcset={`${source.imageBase}-800.webp 800w, ${source.imageBase}-1600.webp 1600w`}
        sizes="(min-width: 1280px) 600px, (min-width: 1100px) 47vw, calc(100vw - 48px)"
        width="1600" height="900" alt={source.imageAlt}
        loading="lazy" decoding="async"
      />
      <span class="history-source__zoom" aria-hidden="true"><span></span>Enlarge</span>
    </a>
    <figcaption>
      <span>{source.imageCaption}</span>
      <span>Interpretive painting</span>
    </figcaption>
  </figure>

  <div class="history-source__copy">
    <header class="history-source__head">
      <p class="history-source__numeral" aria-hidden="true">{numeral}</p>
      <div>
        <p class="history-source__author">{source.author}<span>{deathDate(source)}</span><span>{source.form}</span></p>
        <h3 id={titleId}>{reader ? <a href={reader.href}>{source.title}</a> : source.title}</h3>
        <p class="history-source__arabic" lang="ar" dir="rtl">{source.arabic}</p>
      </div>
    </header>
    <p class="history-source__description">{source.description}</p>
    {reader ? (
      <p class="history-source__foot">
        <span>{roundedWords(reader.words)} · {reader.entries.toLocaleString("en-US")} sections</span>
        <a class="hc-btn" href={reader.href}>Read the book <span aria-hidden="true">→</span></a>
      </p>
    ) : (
      <p class="history-source__foot is-soon">
        <span>The English translation is still in progress.</span>
        <span class="history-source__soon">Not open yet</span>
      </p>
    )}
  </div>
</article>
