---
/* The tools of the resources catalogue as three banner tiles, each in its own
   site's colors with its art faded in behind. The colors come from the
   catalogue and clear WCAG AA on their own, so the tiles read the same in
   both themes. */
import type { ToolTile } from "../../lib/home-resources";

interface Props {
  tools: ToolTile[];
}

const { tools } = Astro.props;
---

<ul class="tools" aria-label="Tools">
  {tools.map((tool) => (
    <li>
      <a
        class="tools__tile"
        href={tool.href}
        target="_blank"
        rel="noopener noreferrer"
        style={`--t-bg: ${tool.brand.bg}; --t-ink: ${tool.brand.ink}; --t-accent: ${tool.brand.accent}`}
      >
        <img class="tools__art" src={tool.art} alt="" width="720" height="405" loading="lazy" decoding="async" />
        {tool.brand.logo && (
          <span class:list={["tools__mark", tool.brand.shape === "app" && "tools__mark--app"]} aria-hidden="true">
            <img src={tool.brand.logo} alt="" width="64" height="64" loading="lazy" decoding="async" />
          </span>
        )}
        <span class="tools__body">
          <span class="tools__name">{tool.title}</span>
          <span class="tools__meta">{tool.meta}</span>
          <span class="tools__cta">
            {tool.cta}<span class="sr-only"> (opens in a new tab)</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .tools {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tools__tile {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    min-height: 96px;
    padding: 0.9rem 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: var(--t-bg);
    color: var(--t-ink);
    text-decoration: none;
    isolation: isolate;
    transition:
      translate var(--motion-base) var(--ease-back),
      box-shadow var(--motion-base) var(--ease-standard);
  }

  .tools__tile:hover,
  .tools__tile:focus-visible {
    translate: 0 -3px;
    box-shadow: var(--home-shadow);
  }

  .tools__tile:focus-visible {
    --hc-focus-offset: 3px;
  }

  /* The site's art on the right half, faded into the tile's ground. */
  .tools__art {
    position: absolute;
    inset: 0 0 0 auto;
    z-index: -1;
    width: 62%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    mask-image: linear-gradient(to right, transparent, #000 70%);
    transition: scale var(--motion-settle) var(--ease-standard);
  }

  .tools__tile:hover .tools__art {
    scale: 1.05;
  }

  .tools__mark {
    flex: none;
    width: 44px;
    height: 44px;
    overflow: hidden;
    border-radius: 50%;
  }

  .tools__mark--app {
    border-radius: 11px;
  }

  .tools__mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tools__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .tools__name {
    font: 600 1.02rem/1.25 var(--font-display);
  }

  .tools__meta {
    color: color-mix(in srgb, var(--t-ink) 72%, transparent);
    font: 400 var(--fs-xs)/1.3 var(--font-ui);
  }

  .tools__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.25rem;
    color: var(--t-accent);
    font: 600 var(--fs-xs)/1.3 var(--font-ui);
  }

  @media (prefers-reduced-motion: reduce) {
    .tools__tile,
    .tools__art {
      transition: none;
    }
  }
</style>
