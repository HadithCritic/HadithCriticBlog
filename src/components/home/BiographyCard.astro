---
/* One entry of the Taqrīb as the register keeps it: Ibn Ḥajar's Arabic, the
   translator's English, and the fields read from the Arabic as tags, each
   with a note where the reading needed a rule or another edition. On first
   view the tags settle in one after another (data-reveal-once). */
import type { BiographyFigure } from "../../lib/home-narrators";
import HomeButton from "./HomeButton.astro";

interface Props {
  biography: BiographyFigure;
}

const { biography } = Astro.props;
---

<article class="bio" data-reveal-once aria-labelledby="bio-title">
  <p class="bio__kicker">One entry, read field by field</p>
  <h3 id="bio-title" class="bio__title">{biography.name} <span>Taqrīb no. {biography.number}</span></h3>

  <p class="bio__label">Ibn Ḥajar's entry</p>
  <p class="bio__ar" lang="ar" dir="rtl">{biography.ar}</p>
  <p class="bio__label">Translation</p>
  <p class="bio__en">{biography.en}</p>

  <p class="bio__label">What the register reads from it</p>
  <dl class="bio__tags">
    {biography.tags.map((tag, index) => (
      <div class="bio__tag" style={`--i: ${index}`}>
        <dt>{tag.label}</dt>
        <dd>
          {tag.ar && <span class="bio__tag-ar" lang="ar" dir="rtl">{tag.ar}</span>}
          <span class="bio__tag-value">{tag.value}</span>
          {tag.note && <span class="bio__tag-note">{tag.note}</span>}
        </dd>
      </div>
    ))}
  </dl>

  <HomeButton href={biography.href} variant="glass">Open the entry in the register</HomeButton>
</article>

<style>
  .bio {
    --bio-step: 110ms;
    display: flex;
    flex-direction: column;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    border: 1px solid var(--home-line);
    border-radius: 18px;
    background: var(--home-card);
    box-shadow: var(--home-shadow);
    color: var(--hc-text-primary);
  }

  .bio__kicker,
  .bio__label {
    margin: 0;
    color: var(--hc-gold);
    font: 600 var(--fs-xs)/1.2 var(--font-ui);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bio__label {
    margin-top: 1.1rem;
    color: var(--hc-text-tertiary);
  }

  .bio__title {
    margin: 0.55rem 0 0;
    font: 600 1.4rem/1.2 var(--font-display);
    letter-spacing: -0.01em;
  }

  .bio__title span {
    display: block;
    margin-top: 0.25rem;
    color: var(--hc-text-tertiary);
    font: 500 var(--fs-xs)/1.2 var(--font-ui);
    letter-spacing: 0;
  }

  .bio__ar {
    margin: 0.5rem 0 0;
    font: 400 1.3rem/1.9 var(--font-arabic);
  }

  .bio__en {
    margin: 0.4rem 0 0;
    color: var(--hc-text-secondary);
    font: 400 var(--fs-base)/1.6 var(--font-body);
  }

  .bio__tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0.6rem 0 1.25rem;
  }

  .bio__tag {
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--home-line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
  }

  .bio__tag dt {
    color: var(--hc-gold);
    font: 600 var(--fs-xs)/1.2 var(--font-ui);
  }

  .bio__tag dd {
    display: grid;
    gap: 0.2rem;
    margin: 0.3rem 0 0;
  }

  .bio__tag-ar {
    font: 400 1.05rem/1.5 var(--font-arabic);
  }

  .bio__tag-value {
    font: 500 var(--fs-sm)/1.35 var(--font-ui);
  }

  .bio__tag-note {
    color: var(--hc-text-tertiary);
    font: 400 var(--fs-xs)/1.4 var(--font-ui);
  }

  .bio :global(.hbtn) {
    align-self: flex-start;
    margin-top: auto;
  }

  /* ── First view: the tags settle one after another ──────────── */

  .bio.is-armed .bio__tag {
    opacity: 0;
    translate: 0 8px;
  }

  .bio.is-playing .bio__tag {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--motion-base) var(--ease-standard),
      translate var(--motion-base) var(--ease-back);
    transition-delay: calc(200ms + var(--i) * var(--bio-step));
  }

  @media (max-width: 480px) {
    .bio__tags {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio.is-armed .bio__tag {
      opacity: 1;
      translate: none;
      transition: none;
    }
  }
</style>
