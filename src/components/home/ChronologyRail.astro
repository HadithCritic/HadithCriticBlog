---
/* The histories on a hijri axis, each at its author's death, with a bar for
   the words of its English reader. Open readers are solid bars and link to
   the reader; a book not open yet is an outline. Bars stand a little apart
   when two deaths fall close; the dot on the axis keeps the exact year.

   On first view the axis draws left to right and then each book lands
   (data-reveal-once, see home-motion.ts). Hovering or focusing a book shows
   its title, author and reading pages in the panel under the rail
   (home-detail-panel.ts); without script the panel keeps its legend and every
   link still says what it opens. On a phone the rail scrolls sideways. */
import type { ChronologyFigure } from "../../lib/home-history";
import { formatCount } from "../../lib/home-data-core";

interface Props {
  chronology: ChronologyFigure;
}

const { chronology } = Astro.props;
const { books, ticks } = chronology;
const lastTick = ticks.length - 1;
---

<figure class="crail" data-detail-panel data-reveal-once aria-labelledby="crail-title">
  <p id="crail-title" class="crail__kicker">Each history at its author's death</p>

  <div class="crail__scroll">
    <div class="crail__plot">
      <ol class="crail__books" data-detail-area>
        {books.map((book, index) => {
          const style = `--x: ${book.barX}%; --h: ${book.share ?? 0.2}; --i: ${index}`;
          const label = `${book.title}, by ${book.author}, ${book.died}. ${book.facts}.`;
          return (
            <li class:list={["crail__book", !book.href && "crail__book--pending"]} style={style}>
              {book.href ? (
                <a class="crail__hit" href={book.href} data-detail-key={book.id}>
                  <span class="crail__name" aria-hidden="true">{book.authorShort}</span>
                  <span class="crail__bar" aria-hidden="true"></span>
                  <span class="sr-only">{label}</span>
                </a>
              ) : (
                <span class="crail__hit" tabindex="0" data-detail-key={book.id}>
                  <span class="crail__name" aria-hidden="true">{book.authorShort}</span>
                  <span class="crail__bar" aria-hidden="true"></span>
                  <span class="sr-only">{label}</span>
                </span>
              )}
            </li>
          );
        })}
      </ol>

      <div class="crail__axis" aria-hidden="true">
        <span class="crail__line"></span>
        {books.map((book) => (
          <span
            class:list={["crail__dot", !book.href && "crail__dot--pending"]}
            style={`--x: ${book.x}%; --t: ${book.x / 100}`}
          ></span>
        ))}
      </div>

      <ol class="crail__ticks" aria-hidden="true">
        {ticks.map((tick, index) => (
          <li
            class:list={["crail__tick", index === 0 && "crail__tick--first", index === lastTick && "crail__tick--last"]}
            style={`--x: ${tick.x}%`}
          >
            <b>{tick.ah}{index === 0 && " AH"}</b>
            <span>{tick.ce}{index === 0 && " CE"}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="crail__detail" aria-hidden="true">
    <div class="crail__card" data-detail="">
      <p class="crail__card-meta">{chronology.open} of {books.length} histories open in English</p>
      <p class="crail__card-title">{formatCount(chronology.words)} words of translation</p>
      <p class="crail__card-facts">
        A bar's height follows the words of the book's reader; an outline marks a book not open yet.
      </p>
    </div>
    {books.map((book) => (
      <div class="crail__card" data-detail={book.id} hidden>
        <p class="crail__card-meta">{book.died}</p>
        <p class="crail__card-title">{book.title}</p>
        <p class="crail__card-facts">{book.author}. {book.facts}.</p>
      </div>
    ))}
  </div>
</figure>

<style>
  .crail {
    --crail-bar-max: 10.5rem;
    --crail-names: 8.25rem;
    --crail-draw: 900ms;
    --crail-step: 90ms;
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    border: 1px solid var(--home-line);
    border-radius: 18px;
    background: var(--home-card);
    box-shadow: var(--home-shadow);
    color: var(--hc-text-primary);
  }

  .crail__kicker {
    margin: 0;
    color: var(--hc-gold);
    font: 600 var(--fs-xs)/1.2 var(--font-ui);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ── Plot ───────────────────────────────────────────────────── */

  .crail__scroll {
    margin: 0.75rem calc(-1 * clamp(0.5rem, 2vw, 1rem)) 0;
    padding: 0 clamp(0.5rem, 2vw, 1rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .crail__plot {
    min-width: 600px;
    padding: 0 0.5rem;
  }

  .crail__books {
    position: relative;
    height: calc(var(--crail-bar-max) + var(--crail-names));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crail__book {
    position: absolute;
    bottom: 0;
    left: var(--x);
    display: flex;
    translate: -50% 0;
    transition: opacity var(--motion-base) var(--ease-standard);
  }

  .crail__hit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
    border-radius: 4px;
  }

  .crail__hit:focus-visible {
    --hc-focus-offset: 3px;
  }

  .crail__name {
    color: var(--hc-text-secondary);
    font: 500 var(--fs-xs)/1 var(--font-ui);
    white-space: nowrap;
    writing-mode: vertical-rl;
    rotate: 180deg;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .crail__bar {
    display: block;
    width: 14px;
    height: max(6px, calc(var(--crail-bar-max) * var(--h)));
    border-radius: 3px 3px 0 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--hc-gold) 78%, transparent), var(--hc-gold));
    transform-origin: bottom;
    transition: filter var(--motion-fast) var(--ease-standard);
  }

  .crail__book--pending .crail__bar {
    border: 1.5px dashed var(--hc-text-tertiary);
    border-bottom: 0;
    background: none;
  }

  .crail__book--pending .crail__name {
    color: var(--hc-text-tertiary);
  }

  /* One book in view: it stays, the others step back. */
  .crail[data-active] .crail__book:not(.is-active) {
    opacity: 0.35;
  }

  .crail__book.is-active .crail__name {
    color: var(--hc-text-primary);
  }

  .crail__book.is-active .crail__bar {
    filter: brightness(1.12);
  }

  /* ── Axis ───────────────────────────────────────────────────── */

  .crail__axis {
    position: relative;
    height: 9px;
    margin-top: -4px;
  }

  .crail__line {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--home-line-strong);
    transform-origin: left;
  }

  .crail__dot {
    position: absolute;
    top: 0;
    left: var(--x);
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--home-card);
    border-radius: 50%;
    background: var(--hc-gold);
    translate: -50% 0;
  }

  .crail__dot--pending {
    border-color: var(--hc-text-tertiary);
    background: var(--home-card);
  }

  .crail__ticks {
    position: relative;
    height: 2.6rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .crail__tick {
    position: absolute;
    top: 0;
    left: var(--x);
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding-top: 0.45rem;
    translate: -50% 0;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
  }

  .crail__tick::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 0.3rem;
    background: var(--home-line-strong);
  }

  .crail__tick--first {
    justify-items: start;
    translate: 0 0;
  }

  .crail__tick--first::before {
    left: 0;
  }

  .crail__tick--last {
    justify-items: end;
    translate: -100% 0;
  }

  .crail__tick--last::before {
    left: auto;
    right: 0;
  }

  .crail__tick b {
    color: var(--hc-text-secondary);
    font: 600 var(--fs-xs)/1.2 var(--font-ui);
  }

  .crail__tick span {
    color: var(--hc-text-tertiary);
    font: 400 var(--fs-xs)/1.2 var(--font-ui);
  }

  /* ── Detail panel ───────────────────────────────────────────── */

  .crail__detail {
    display: grid;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--home-line);
  }

  /* Every card shares one cell, so the panel keeps the height of the tallest. */
  .crail__card {
    grid-area: 1 / 1;
  }

  .crail__card[hidden] {
    display: block;
    visibility: hidden;
  }

  .crail__card-meta {
    margin: 0;
    color: var(--hc-gold);
    font: 600 var(--fs-xs)/1.3 var(--font-ui);
    font-variant-numeric: lining-nums;
  }

  .crail__card-title {
    margin: 0.3rem 0 0;
    font: 600 1.25rem/1.25 var(--font-display);
  }

  .crail__card-facts {
    margin: 0.3rem 0 0;
    color: var(--hc-text-secondary);
    font: 400 var(--fs-sm)/1.5 var(--font-body);
  }

  /* ── First view: the axis draws, then each book lands ───────── */

  .crail.is-armed .crail__line {
    transform: scaleX(0);
  }

  .crail.is-armed .crail__dot {
    scale: 0;
  }

  .crail.is-armed .crail__bar {
    transform: scaleY(0);
  }

  .crail.is-armed .crail__name,
  .crail.is-armed .crail__tick {
    opacity: 0;
  }

  .crail.is-playing .crail__line {
    transform: scaleX(1);
    transition: transform var(--crail-draw) var(--ease-in-out-quart);
  }

  .crail.is-playing .crail__dot {
    scale: 1;
    transition: scale var(--motion-base) var(--ease-back) calc(var(--crail-draw) * var(--t));
  }

  .crail.is-playing .crail__tick {
    opacity: 1;
    transition: opacity var(--motion-base) var(--ease-standard) calc(var(--crail-draw) * 0.4);
  }

  .crail.is-playing .crail__bar {
    transform: scaleY(1);
    transition:
      transform var(--motion-settle) var(--ease-back) calc(var(--crail-draw) + var(--i) * var(--crail-step)),
      filter var(--motion-fast) var(--ease-standard);
  }

  .crail.is-playing .crail__name {
    opacity: 1;
    transition:
      opacity var(--motion-base) var(--ease-standard) calc(var(--crail-draw) + 200ms + var(--i) * var(--crail-step)),
      color var(--motion-fast) var(--ease-standard);
  }

  @media (prefers-reduced-motion: reduce) {
    .crail.is-armed .crail__line,
    .crail.is-armed .crail__dot,
    .crail.is-armed .crail__bar,
    .crail.is-armed .crail__name,
    .crail.is-armed .crail__tick {
      opacity: 1;
      scale: none;
      transform: none;
      transition: none;
    }

    .crail__book,
    .crail__name,
    .crail__bar {
      transition: none;
    }
  }
</style>
