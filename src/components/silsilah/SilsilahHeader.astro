---
/* Header variant for the Silsilah hadith database. Same emblem as HadithCritic,
   distinct wordmark, navigation scoped to the database. */
---
<header class="site-header sil-header" id="siteHeader">
  <div class="wrap header-inner">
    <a href="/silsilah/" class="header-brand">
      <img src="/geometric_emblem_transparent.png" alt="" class="header-emblem" />
      <span class="sil-brand">
        <span class="sil-brand-name">Silsilah</span>
        <span class="sil-brand-sub">by HadithCritic</span>
      </span>
    </a>

    <nav class="header-nav" aria-label="Silsilah navigation">
      <a href="/silsilah/" class="hc-header-link">Collections</a>
      <a href="/silsilah/search/" class="hc-header-link">Search</a>
      <a href="/silsilah/find/" class="hc-header-link">Find by Reference</a>
      <a href="/silsilah/about/" class="hc-header-link">Sources</a>
      <a href="/" class="hc-header-link">HadithCritic</a>
    </nav>

    <div class="header-actions">
      <form class="sil-ref-form" action="/silsilah/search/" method="get" role="search">
        <input
          type="text"
          name="q"
          class="sil-ref-input"
          placeholder="Search or bukhari:2487"
          aria-label="Search the hadith corpus"
          autocomplete="off"
          spellcheck="false"
        />
        <button type="submit" class="sil-ref-go" aria-label="Find reference">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>
      </form>
      <button class="header-theme-toggle" id="themeToggleBtn" aria-label="Toggle light/dark mode">
        <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <button class="header-menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileNav">
        <span class="hamburger-line" aria-hidden="true"></span>
        <span class="hamburger-line" aria-hidden="true"></span>
        <span class="hamburger-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="header-mobile-nav" id="mobileNav" aria-hidden="true">
    <a href="/silsilah/" class="hc-header-link">Collections</a>
    <a href="/silsilah/search/" class="hc-header-link">Search</a>
    <a href="/silsilah/find/" class="hc-header-link">Find by Reference</a>
    <a href="/silsilah/about/" class="hc-header-link">Sources</a>
    <a href="/" class="hc-header-link">HadithCritic</a>
    <div class="header-actions-mobile">
      <form class="sil-ref-form sil-ref-form--mobile" action="/silsilah/search/" method="get" role="search">
        <input type="text" name="q" class="sil-ref-input" placeholder="Search or bukhari:2487" aria-label="Search the hadith corpus" autocomplete="off" spellcheck="false" />
        <button type="submit" class="sil-ref-go" aria-label="Find reference">Go</button>
      </form>
    </div>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid var(--hc-rule);
  background: color-mix(in srgb, var(--hc-black) 90%, transparent);
  backdrop-filter: blur(14px) saturate(1.2);
  -webkit-backdrop-filter: blur(14px) saturate(1.2);
  transition: border-color 300ms ease, box-shadow 300ms ease, background 300ms ease;
}

.site-header.is-scrolled {
  border-color: var(--hc-rule-strong);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  background: color-mix(in srgb, var(--hc-black) 95%, transparent);
}

.header-inner {
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

.header-brand {
  display: inline-flex;
  align-items: center;
  gap: 0.85rem;
  text-decoration: none;
  flex-shrink: 0;
}

.header-emblem {
  height: 32px;
  width: auto;
  object-fit: contain;
  filter: sepia(0.6) saturate(1.5) hue-rotate(350deg) brightness(0.95);
}

.sil-brand {
  display: flex;
  flex-direction: column;
  line-height: 1;
  gap: 0.22rem;
}

.sil-brand-name {
  color: var(--hc-gold);
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.sil-brand-sub {
  color: var(--hc-ash);
  font-family: var(--font-ui);
  font-size: 0.58rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.header-nav {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.header-nav .hc-header-link {
  position: relative;
  padding: 0.45rem 0.7rem;
  font-size: 0.76rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 500;
  color: rgba(242, 235, 220, 0.75);
  transition: color 250ms ease;
  text-decoration: none;
  font-family: var(--font-ui);
}

.header-nav .hc-header-link:hover,
.header-nav .hc-header-link[aria-current="page"] {
  color: var(--hc-gold);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.sil-ref-form {
  display: flex;
  align-items: stretch;
  border: 1px solid var(--hc-rule);
  border-radius: var(--radius-xs);
  background: rgba(216, 177, 102, 0.04);
  overflow: hidden;
}

.sil-ref-input {
  width: 168px;
  padding: 0.42rem 0.65rem;
  border: 0;
  background: transparent;
  color: var(--hc-parchment);
  font-family: var(--font-ui);
  font-size: 0.78rem;
}

.sil-ref-input::placeholder {
  color: var(--hc-ash);
}

.sil-ref-input:focus {
  outline: none;
}

.sil-ref-form:focus-within {
  border-color: var(--hc-rule-strong);
}

.sil-ref-go {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 0.6rem;
  border: 0;
  border-left: 1px solid var(--hc-rule);
  background: rgba(216, 177, 102, 0.07);
  color: var(--hc-gold);
  font-family: var(--font-ui);
  font-size: 0.72rem;
}

.sil-ref-go:hover {
  background: rgba(216, 177, 102, 0.14);
}

.sil-ref-go svg {
  width: 14px;
  height: 14px;
}

/* Theme Toggle */
.header-theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 1px solid var(--hc-rule);
  border-radius: var(--radius-xs);
  background: rgba(216, 177, 102, 0.04);
  color: var(--hc-gold);
  cursor: pointer;
  transition: border-color 200ms ease, background 200ms ease, color 200ms ease;
  padding: 0;
}

.header-theme-toggle:hover {
  border-color: var(--hc-rule-strong);
  background: rgba(216, 177, 102, 0.1);
  color: var(--hc-gold-soft);
}

.header-theme-toggle svg {
  width: 16px;
  height: 16px;
}

html[data-theme="light"] .sun-icon { display: none; }
html:not([data-theme="light"]) .moon-icon { display: none; }

/* Mobile */
.header-menu-toggle {
  display: none;
  width: 36px;
  height: 36px;
  position: relative;
  background: none;
  border: 1px solid var(--hc-rule);
  border-radius: var(--radius-xs);
  padding: 0;
  cursor: pointer;
  color: var(--hc-gold);
}

.hamburger-line {
  display: block;
  width: 18px;
  height: 1.5px;
  background: currentColor;
  position: absolute;
  left: 8px;
  transition: all 300ms var(--ease);
}

.hamburger-line:nth-child(1) { top: 11px; }
.hamburger-line:nth-child(2) { top: 16px; }
.hamburger-line:nth-child(3) { top: 21px; }

.header-menu-toggle.is-open .hamburger-line:nth-child(1) { top: 16px; transform: rotate(45deg); }
.header-menu-toggle.is-open .hamburger-line:nth-child(2) { opacity: 0; transform: scaleX(0); }
.header-menu-toggle.is-open .hamburger-line:nth-child(3) { top: 16px; transform: rotate(-45deg); }

.header-mobile-nav {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, color-mix(in srgb, var(--hc-charcoal) 98%, transparent), color-mix(in srgb, var(--hc-black) 98%, transparent));
  backdrop-filter: blur(20px) saturate(1.2);
  border-bottom: 1px solid var(--hc-rule);
  padding: 1.5rem var(--pad) 2.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: opacity 350ms ease, transform 350ms var(--ease), visibility 350ms;
  pointer-events: none;
}

.header-mobile-nav.is-open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.header-mobile-nav .hc-header-link {
  display: block;
  padding: 0.9rem 0;
  font-size: 0.9rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
  color: rgba(242, 235, 220, 0.8);
  border-bottom: 1px solid var(--hc-rule-soft);
  width: 100%;
  max-width: 300px;
  text-decoration: none;
  font-family: var(--font-ui);
}

.header-mobile-nav .hc-header-link:hover {
  color: var(--hc-gold);
}

.header-actions-mobile {
  margin-top: 1.5rem;
  width: 100%;
  max-width: 300px;
}

.sil-ref-form--mobile {
  width: 100%;
}

.sil-ref-form--mobile .sil-ref-input {
  flex: 1;
  width: auto;
}

@media (max-width: 980px) {
  .header-nav { display: none; }
  .header-menu-toggle { display: block; }
  .header-actions .sil-ref-form { display: none; }
  .header-inner { min-height: 64px; gap: 1rem; }
  .sil-brand-name { font-size: 1.3rem; }
  .header-emblem { height: 28px; }
}
</style>

<script>
  (function () {
    const header = document.getElementById('siteHeader');
    function onScroll() {
      header?.classList.toggle('is-scrolled', window.scrollY > 20);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const toggle = document.getElementById('menuToggle');
    const mobileNav = document.getElementById('mobileNav');
    if (toggle && mobileNav) {
      toggle.addEventListener('click', function () {
        const isOpen = mobileNav.classList.toggle('is-open');
        toggle.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(isOpen));
        mobileNav.setAttribute('aria-hidden', String(!isOpen));
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });
    }

    // Theme toggle
    const themeBtn = document.getElementById('themeToggleBtn');
    if (themeBtn) {
      themeBtn.addEventListener('click', function() {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
        const newTheme = currentTheme === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('hc-theme', newTheme);
      });
    }
  })();
</script>
