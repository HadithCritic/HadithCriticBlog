---
interface Props {
  variant?: 'image' | 'dark';
  learnMoreHref?: string;
  reportsHref?: string;
}
const { learnMoreHref = '/blogs/', reportsHref = '/blogs/' } = Astro.props;
const year = new Date().getFullYear();
const groups = [
  { title: 'Reports', links: [['All Reports', '/blogs/'], ['Monographs', reportsHref], ['History', '/blogs/category/origins-early-history/'], ['Theology', '/blogs/category/theology-epistemology/'], ['Prophecies', '/blogs/category/prophecies-eschatology/']] },
  { title: 'Collections', links: [['Hadith Corpus', '/hadith/'], ['Rijal Register', '/narrators/'], ['Qurʾān', '/projects/quran/'], ['Tafsir', '/projects/tafsir/'], ['All Projects', '/projects/']] },
  { title: 'Research', links: [['Studies & Analysis', '/blogs/'], ['Islamic Studies Atlas', '/projects/islamic-studies-atlas/'], ['Academic Work', '/academia/'], ['Research & Method', learnMoreHref]] },
  { title: 'Resources', links: [['Research Library', '/resources/'], ['Video Archive', '/youtube/'], ['Source Code', 'https://github.com/HadithCritic/HadithCriticBlog'], ['RSS Feed', '/rss.xml']] },
  { title: 'About', links: [['HadithCritic', '/'], ['Inquiries', '/contact/'], ['Submissions', '/contact/'], ['Privacy & Terms', '/legal/']] }
];
const principles = [
  { title: 'Rigor', description: 'Method before opinion.', icon: 'M3 5c3-1 6-1 9 1v15c-3-2-6-2-9-1V5Zm9 1c3-2 6-2 9-1v15c-3-1-6-1-9 1M6 8h3m-3 3h3m-3 3h3m6-6h3m-3 3h3m-3 3h3' },
  { title: 'Fairness', description: 'Charity in judgment, clarity in evidence.', icon: 'M12 3v18m-5 0h10M4 7l8-3 8 3M4 7l-3 9h6L4 7Zm16 0-3 9h6l-3-9ZM1 16c1 4 5 4 6 0m10 0c1 4 5 4 6 0' },
  { title: 'Transparency', description: 'Open reports. Traceable sources.', icon: 'M9 3h6m-3-2v2M7 7h10l-1 13H8L7 7Zm-1 0 6-4 6 4M10 10v7m4-7v7M7 22h10' },
  { title: 'A Legacy of Inquiry', description: 'Upholding the standards of the scholars and the pursuit of truth.', icon: 'M12 2 22 12 12 22 2 12 12 2Zm0 4 6 6-6 6-6-6 6-6Zm0 3 3 3-3 3-3-3 3-3Z' }
];
const channels = [
  { name: 'X', href: 'https://x.com/HadithCritic', path: 'm4 3 16 18M20 3 4 21M4 3h5l11 18h-5L4 3Z' },
  { name: 'YouTube', href: 'https://www.youtube.com/@HadithCritic', path: 'M21 7c0-2-2-3-9-3S3 5 3 7v10c0 2 2 3 9 3s9-1 9-3V7ZM10 8l6 4-6 4V8Z' },
  { name: 'Discord', href: 'https://discord.gg/SubmissionServer', path: 'M8 5 5 6 2 17l5 2 1-2m8-12 3 1 3 11-5 2-1-2M8 5c3-1 5-1 8 0M7 17c3 2 7 2 10 0M8 11v2m8-2v2' },
  { name: 'GitHub', href: 'https://github.com/HadithCritic/HadithCriticBlog', path: 'M9 21v-4c-4 1-4-2-6-2m12 6v-4c0-1-1-2-1-2 4 0 6-2 6-5 0-2-1-3-2-4 0-1 0-2-1-3l-4 2H9L5 3c-1 1-1 2-1 3-1 1-2 2-2 4 0 3 2 5 6 5-1 1-1 2-1 2' }
];
---

<footer id="site-footer" class="hc-footer hc-plate" aria-label="Site footer">
  <div class="hc-footer__frame">
    {[0, 1, 2, 3].map((corner) => <svg class:list={['hc-footer__corner', 'hc-footer__corner--' + corner]} viewBox="0 0 48 48" fill="none" stroke="currentColor" aria-hidden="true"><path d="M2 46V8h38M8 46V2h38M2 18h16V2M8 26h18V8M2 8c18 0 4 20 18 20S30 8 16 8 4 30 28 30M8 2c0 18 20 4 20 18s-20 10-20-4S30 4 30 28" /></svg>)}
    <span class="hc-footer__crest" aria-hidden="true"></span>
    <div class="hc-footer__grid">
      <div class="hc-footer__brand">
        <a class="hc-footer__wordmark" href="/" aria-label="HadithCritic home">
          <img src="/images/brand/hc-logo-transparent-192.png" width="80" height="112" alt="" loading="lazy" />
          <span>HadithCritic</span>
        </a>
        <div class="hc-footer__brand-rule" aria-hidden="true"><span></span></div>
        <p class="hc-footer__brand-desc">Textual criticism, transmission analysis, and source verification, so the truth is sought through evidence and transmitted with integrity.</p>
        <div class="hc-footer__contact">
          <a href="/contact/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h20v14H2V5Zm0 0 10 8L22 5" /></svg>Inquiries &amp; partnerships</a>
          <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22S4 14 4 9a8 8 0 1 1 16 0c0 5-8 13-8 13Z"/><circle cx="12" cy="9" r="3" /></svg>A worldwide research community</span>
        </div>
      </div>
      <div class="hc-footer__directory">
        {groups.map((group) => <div class="hc-footer__col">
          <h3 class="hc-footer__label">{group.title}</h3>
          <nav class="hc-footer__links" aria-label={group.title + ' navigation'}>
            {group.links.map(([label, href]) => <a href={href}>{label}</a>)}
          </nav>
        </div>)}
      </div>
      <div class="hc-footer__col hc-footer__col--dispatch">
        <h3 class="hc-footer__label">Stay Informed</h3>
        <p class="hc-footer__dispatch-desc">Receive new reports and research insights when a blog post is published. Unsubscribe anytime.</p>
        <div class="hc-footer__dispatch" data-subscribe-form>
          <form class="hc-footer__form" data-subscribe-form-el>
            <label for="footer-dispatch-email" class="sr-only">Email address</label>
            <div class="hc-footer__input-row">
              <input type="email" id="footer-dispatch-email" name="email" placeholder="Enter your email address" required autocomplete="email" inputmode="email" class="hc-footer__input" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
              <button type="submit" class="hc-footer__submit" aria-label="Subscribe to blog updates"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3 12h17m-7-7 7 7-7 7" /></svg></button>
            </div>
            <p class="hc-footer__status" data-subscribe-form-status role="status" aria-live="polite"></p>
          </form>
          <noscript><p class="hc-footer__fallback">Email signup requires JavaScript. <a href="/rss.xml">Follow the RSS feed</a> for new posts.</p></noscript>
        </div>
        <h3 class="hc-footer__label hc-footer__community-label">Join Our Community</h3>
        <nav class="hc-footer__social" aria-label="External channels">
          {channels.map((channel) => <a href={channel.href} aria-label={channel.name}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={channel.path}/></svg></a>)}
        </nav>
        <p class="hc-footer__community-note">Discussions <span>|</span> Updates <span>|</span> Research</p>
      </div>
    </div>
    <picture class="hc-footer__landscape" aria-hidden="true">
      <source srcset="/images/brand/footer-panorama-v1-1440.webp 1440w, /images/brand/footer-panorama-v1.webp 2172w" sizes="100vw" type="image/webp" />
      <img src="/images/brand/footer-panorama-v1.webp" width="2172" height="724" alt="" loading="lazy" decoding="async" />
    </picture>
    <div class="hc-footer__principles">
      {principles.map((item, index) => <div class:list={['hc-footer__principle', index === 3 && 'hc-footer__principle--legacy']}>
        <span class="hc-footer__principle-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=".8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon}/></svg></span>
        <div><h3>{item.title}</h3><p>{item.description}</p></div>
      </div>)}
    </div>
    <div class="hc-footer__bottom">
      <span class="hc-footer__copyright">© {year} HadithCritic. All rights reserved.</span>
      <span class="hc-footer__bottom-rule" aria-hidden="true"><i></i></span>
      <nav class="hc-footer__legal-links" aria-label="Legal and utility links">
        <a href="/legal/">Privacy &amp; Terms</a><a href="/contact/">Contact</a><a href="/sitemap-index.xml">Sitemap</a><a href="#siteHeader" class="hc-footer__top">Back to top</a>
      </nav>
    </div>
  </div>
</footer>

<script>
  // Subscription handler — preserves /api/subscribe contract
  document.querySelectorAll('.hc-footer__dispatch[data-subscribe-form]').forEach((container) => {
    const form = container.querySelector<HTMLFormElement>('[data-subscribe-form-el]');
    const status = container.querySelector<HTMLElement>('[data-subscribe-form-status]');
    if (!form || !status) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = data.get('email');
      const website = data.get('website');
      if (typeof email !== 'string' || !email) return;

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitButton) submitButton.disabled = true;
      status.textContent = '';
      status.className = 'hc-footer__status';

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website })
        });
        const result = (await response.json()) as { success: boolean; error?: string };

        if (result.success) {
          status.textContent = "You're on the blog update list. We'll email you when a new post is published.";
          status.classList.add('is-success');
          form.reset();
        } else {
          status.textContent = result.error || 'Subscription failed. Please try again.';
          status.classList.add('is-error');
        }
      } catch {
        status.textContent = 'Network error. Please try again.';
        status.classList.add('is-error');
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  });

</script>

<style>
  /* Hallmark · pre-emit critique: P5 H4 E4 S5 R4 V4 */
  /* Component scope: engraved scholarly footer; locked manuscript palette. */
  .hc-footer {
    --footer-font: var(--font-critical);
    position: relative;
    isolation: isolate;
    margin-top: var(--hc-footer-gap, 64px);
    padding: 12px 12px max(12px, var(--sab, 0px));
    background: var(--hc-fixed-black);
    color: var(--hc-text-primary);
    font-family: var(--footer-font);
  }
  .hc-footer__frame { position: relative; border: 1px solid var(--hc-gold-dim); box-shadow: inset 0 0 0 5px var(--hc-fixed-black), inset 0 0 0 6px var(--hc-rule-strong); }
  .hc-footer__corner { position: absolute; z-index: 2; width: 40px; height: 40px; color: var(--hc-gold-dim); pointer-events: none; }
  .hc-footer__corner--0 { top: -3px; left: -3px; }
  .hc-footer__corner--1 { top: -3px; right: -3px; transform: rotate(90deg); }
  .hc-footer__corner--2 { bottom: -3px; right: -3px; transform: rotate(180deg); }
  .hc-footer__corner--3 { bottom: -3px; left: -3px; transform: rotate(270deg); }
  .hc-footer__crest { position: absolute; top: -8px; left: calc(50% - 8px); width: 16px; height: 16px; transform: rotate(45deg); border: 1px solid var(--hc-gold); background: var(--hc-fixed-black); box-shadow: inset 0 0 0 4px var(--hc-fixed-black), inset 0 0 0 5px var(--hc-gold-dim); }
  .hc-footer__grid { max-width: 1760px; margin: auto; padding: 64px 48px 0; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 2.9fr) minmax(0, .95fr); gap: 40px; align-items: start; }
  .hc-footer__brand { min-width: 0; }
  .hc-footer .hc-footer__wordmark { display: flex; align-items: center; gap: 12px; color: var(--hc-gold); text-decoration: none; }
  .hc-footer__wordmark img { width: 56px; height: 104px; object-fit: cover; object-position: center; }
  .hc-footer__wordmark span { font-family: var(--font-editorial); font-weight: 600; font-size: clamp(34px, 3.2vw, 54px); line-height: 1; white-space: nowrap; }
  .hc-footer__brand-rule { display: flex; align-items: center; margin: -10px 0 28px 70px; border-top: 1px solid var(--hc-gold-dim); position: relative; }
  .hc-footer__brand-rule span { position: absolute; left: 50%; top: -4px; width: 7px; height: 7px; transform: rotate(45deg); border: 1px solid var(--hc-gold); background: var(--hc-fixed-black); }
  .hc-footer__brand-desc { margin: 0 0 20px; font-size: 19px; line-height: 1.4; max-width: 36ch; color: var(--hc-text-primary); }
  .hc-footer__contact { display: grid; gap: 12px; font-size: 16px; }
  .hc-footer__contact a, .hc-footer__contact span { display: flex; align-items: center; gap: 12px; }
  .hc-footer__contact svg { width: 20px; height: 20px; flex-shrink: 0; fill: none; stroke: var(--hc-gold); stroke-width: 1.6; }
  .hc-footer a { color: inherit; text-decoration: none; }
  .hc-footer a:hover { color: var(--hc-gold-bright); text-decoration: underline; text-underline-offset: 5px; }
  .hc-footer a:active { color: var(--hc-gold); }
  .hc-footer__directory { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px; padding-top: 14px; }
  .hc-footer__label { font-family: var(--font-ui); font-size: 13px; font-weight: 500; line-height: 1.3; letter-spacing: .12em; text-transform: uppercase; color: var(--hc-gold); margin: 0 0 22px; }
  .hc-footer__directory .hc-footer__label::after { content: ''; display: block; width: 34px; margin-top: 16px; border-bottom: 1px solid var(--hc-gold-dim); }
  .hc-footer__links { display: grid; gap: 12px; }
  .hc-footer__links a { width: fit-content; font-size: 15px; line-height: 1.3; white-space: nowrap; }
  .hc-footer__col--dispatch { border-left: 1px solid var(--hc-gold-dim); padding: 14px 0 0 32px; position: relative; }
  .hc-footer__col--dispatch::before { content: ''; position: absolute; top: 50%; left: -4px; height: 7px; width: 7px; transform: rotate(45deg); border: 1px solid var(--hc-gold-dim); background: var(--hc-fixed-black); }
  .hc-footer__col--dispatch .hc-footer__label { margin-bottom: 8px; }
  .hc-footer__dispatch-desc { font-size: 18px; line-height: 1.35; margin: 0 0 20px; }
  .hc-footer__input-row { display: flex; border: 1px solid var(--hc-text-secondary); border-radius: 3px; }
  .hc-footer__input { min-width: 0; width: 100%; flex: 1; height: 50px; background: transparent; border: 0; padding: 0 14px; color: var(--hc-text-primary); font: italic 15px var(--footer-font); --hc-focus-offset: -4px; }
  .hc-footer__input::placeholder { color: var(--hc-text-secondary); opacity: 1; }
  .hc-footer__submit { flex: 0 0 48px; border: 0; border-left: 1px solid var(--hc-gold-dim); border-radius: 0 2px 2px 0; background: var(--hc-gold); color: var(--hc-fixed-black); cursor: pointer; --hc-focus-offset: -4px; transition: background-color var(--motion-fast); }
  .hc-footer__submit svg { width: 24px; height: 24px; stroke-width: 1.4; vertical-align: middle; }
  .hc-footer__submit:hover { background: var(--hc-gold-bright); }
  .hc-footer__submit:active { background: var(--hc-gold-soft); }
  .hc-footer__submit:disabled { opacity: .65; cursor: wait; }
  .hc-footer__input:invalid:not(:placeholder-shown) { box-shadow: inset 0 -2px var(--hc-danger); }
  .hc-footer__status { font-size: 15px; line-height: 1.4; margin: 8px 0 0; }
  .hc-footer__status:empty { display: none; }
  .hc-footer__status.is-success { color: var(--hc-gold-soft); }
  .hc-footer__status.is-error { color: var(--hc-danger); }
  .hc-footer__fallback { font-size: 16px; }
  .hc-footer__fallback a { text-decoration: underline; }
  .hc-footer__community-label { margin-top: 30px !important; }
  .hc-footer__social { display: flex; gap: 16px; margin: 14px 0; }
  .hc-footer__social a { display: grid; place-items: center; width: 32px; height: 36px; }
  .hc-footer__social svg { width: 23px; height: 23px; }
  .hc-footer__community-note { margin: 12px 0 0; font-size: 13px; white-space: nowrap; }
  .hc-footer__community-note span { padding-inline: 6px; color: var(--hc-gold-dim); }
  .hc-footer__landscape { display: block; height: clamp(230px, 28vw, 480px); margin-top: 12px; overflow: clip; }
  .hc-footer__landscape img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center bottom; mask-image: linear-gradient(to bottom, transparent, black 15%); }
  .hc-footer__principles { border-block: 1px solid var(--hc-gold-dim); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.35fr); padding: 20px 48px; gap: 32px; }
  .hc-footer__principle { display: flex; align-items: center; gap: 24px; position: relative; }
  .hc-footer__principle:not(:last-child)::after { content: ''; position: absolute; right: -16px; height: 56px; border-right: 1px solid var(--hc-rule-strong); }
  .hc-footer__principle-icon { display: grid; place-items: center; width: 72px; height: 72px; flex-shrink: 0; border: 1px solid var(--hc-gold-dim); border-radius: 50%; color: var(--hc-gold); }
  .hc-footer__principle-icon svg { width: 46px; height: 46px; }
  .hc-footer__principle--legacy .hc-footer__principle-icon { border: 3px double var(--hc-gold-dim); background: var(--hc-fixed-charcoal-2); }
  .hc-footer__principle h3 { margin: 0 0 4px; font: 500 13px/1.4 var(--font-ui); text-transform: uppercase; letter-spacing: .12em; color: var(--hc-gold); }
  .hc-footer__principle p { margin: 0; font-size: 17px; line-height: 1.3; max-width: 30ch; }
  .hc-footer__bottom { padding: 22px 48px; display: flex; align-items: center; gap: 32px; font-size: 15px; }
  .hc-footer__copyright { white-space: nowrap; }
  .hc-footer__bottom-rule { flex: 1; border-top: 1px solid var(--hc-rule-strong); position: relative; }
  .hc-footer__bottom-rule i { position: absolute; left: 50%; top: -4px; width: 7px; height: 7px; border: 1px solid var(--hc-gold); transform: rotate(45deg); background: var(--hc-fixed-black); }
  .hc-footer__legal-links { display: flex; gap: 20px; flex-wrap: wrap; }
  .hc-footer__legal-links a { white-space: nowrap; }
  .hc-footer__legal-links a + a { border-left: 1px solid var(--hc-rule-strong); padding-left: 20px; }
  @media (max-width: 1450px) {
    .hc-footer__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 2.5fr); gap: 32px; padding: 48px 32px 0; }
    .hc-footer__col--dispatch { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 40px; border-left: 0; border-top: 1px solid var(--hc-rule-strong); padding: 24px 0 0; }
    .hc-footer__col--dispatch::before { display: none; }
    .hc-footer__col--dispatch > .hc-footer__label:first-child { grid-column: 1; }
    .hc-footer__dispatch-desc { grid-column: 1; max-width: 40ch; }
    .hc-footer__dispatch { grid-column: 1; }
    .hc-footer__community-label { grid-column: 2; grid-row: 1; margin-top: 0 !important; }
    .hc-footer__social { grid-column: 2; grid-row: 2; align-self: start; margin: 0; }
    .hc-footer__community-note { grid-column: 2; grid-row: 3; }
    .hc-footer__principles { padding-inline: 32px; gap: 24px; }
    .hc-footer__principle { gap: 16px; }
    .hc-footer__principle-icon { width: 56px; height: 56px; }
    .hc-footer__principle-icon svg { width: 36px; height: 36px; }
    .hc-footer__bottom { padding-inline: 32px; }
  }
  @media (max-width: 1100px) {
    .hc-footer__grid { grid-template-columns: minmax(0, 1fr); }
    .hc-footer__brand { max-width: 520px; }
    .hc-footer__wordmark span { font-size: 46px; }
    .hc-footer__brand-desc { max-width: 48ch; }
    .hc-footer__brand-rule { max-width: 220px; }
    .hc-footer__principles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 32px; }
    .hc-footer__principle::after { display: none; }
    .hc-footer__bottom { flex-wrap: wrap; gap: 16px; }
    .hc-footer__bottom-rule { min-width: 80px; }
  }
  @media (max-width: 640px) {
    .hc-footer { margin-top: var(--hc-footer-gap, 48px); padding-inline: 8px; }
    .hc-footer__grid { padding: 36px 24px 0; gap: 32px; }
    .hc-footer__wordmark span { font-size: 36px; }
    .hc-footer__wordmark img { width: 44px; height: 88px; }
    .hc-footer__brand-rule { margin-left: 56px; }
    .hc-footer__directory { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 16px; }
    .hc-footer__links a { font-size: 14px; }
    .hc-footer__col--dispatch { display: block; }
    .hc-footer__community-label { margin-top: 28px !important; }
    .hc-footer__landscape { height: 220px; margin-top: 20px; }
    .hc-footer__landscape img { object-position: 64% bottom; }
    .hc-footer__principles { grid-template-columns: minmax(0, 1fr); padding: 24px; gap: 24px; }
    .hc-footer__principle { gap: 20px; }
    .hc-footer__bottom { padding: 24px; font-size: 14px; }
    .hc-footer__bottom-rule { display: none; }
    .hc-footer__legal-links { gap: 12px 16px; }
    .hc-footer__legal-links a + a { padding-left: 0; border: 0; }
  }
  @media (max-width: 374px) {
    .hc-footer__grid { padding-inline: 16px; }
    .hc-footer__wordmark span { font-size: 32px; }
    .hc-footer__directory { grid-template-columns: minmax(0, 1fr); }
    .hc-footer__principles, .hc-footer__bottom { padding-inline: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .hc-footer__submit { transition: none; } }
</style>



