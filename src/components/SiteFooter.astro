---
---
<footer class="site-footer">
  <div class="footer-top-border"></div>
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-brand-logo">
        <img src="/geometric_emblem_transparent.png" alt="" class="footer-emblem" />
        <span class="footer-brand-name">HadithCritic</span>
      </a>
      <p class="footer-desc">
        HadithCritic is dedicated to the study of reports through evidence, transmission, source history, and textual comparison.
      </p>
    </div>

    <div class="footer-navs">
      <div class="footer-col">
        <strong>Directory</strong>
        <nav>
          <a href="/blogs">Blog</a>
          <a href="/academia">Academia</a>
          <a href="/projects">Projects</a>
          <a href="/resources">Resources</a>
        </nav>
      </div>
      <div class="footer-col">
        <strong>Media</strong>
        <nav>
          <a href="/youtube">YouTube</a>
          <a href="/method">Method</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </div>
  </div>
  
  <div class="wrap footer-base">
    <p>&copy; {new Date().getFullYear()} HadithCritic. Verification over reputation.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: auto;
    padding-top: 4rem;
    background: var(--hc-black-soft);
  }

  .footer-top-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: url("/assets/textures/parchment-card-light.png") repeat-x;
    border-top: 1px solid var(--hc-gold-dim);
    border-bottom: 1px solid var(--hc-rule);
    opacity: 0.8;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 2fr;
    gap: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .footer-brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .footer-emblem {
    height: 32px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) saturate(100%) invert(80%) sepia(35%) saturate(546%) hue-rotate(345deg) brightness(88%) contrast(92%);
  }

  .footer-brand-name {
    color: var(--hc-gold);
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 500;
  }

  .footer-desc {
    color: var(--hc-ash);
    max-width: 40ch;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .footer-navs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .footer-col strong {
    display: block;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.2rem;
  }

  .footer-col nav {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .footer-col a {
    color: var(--hc-parchment);
    font-family: var(--font-body);
    font-size: 1rem;
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--hc-gold-soft);
  }

  .footer-base {
    padding: 2rem 0;
    color: var(--hc-ash);
    font-size: 0.85rem;
    font-family: var(--font-ui);
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
