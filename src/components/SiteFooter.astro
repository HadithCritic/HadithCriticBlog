---
interface Props {
  variant?: 'image' | 'dark';
  learnMoreHref?: string;
  reportsHref?: string;
}

const { variant = 'image', learnMoreHref = '/blogs', reportsHref = '/blogs' } = Astro.props;

const year = new Date().getFullYear();
---

<footer
  id="site-footer"
  class:list={['hc-footer', variant === 'dark' && 'hc-footer--dark']}
  aria-label="Site footer"
>
  <div class="hc-footer__container">
    <!-- Navigation Grid -->
    <div class="hc-footer__grid">
      <div class="hc-footer__col">
        <h3 class="hc-footer__label">Research</h3>
        <nav class="hc-footer__links" aria-label="Research navigation">
          <a href="/hadith/">Hadith Corpus</a>
          <a href="/narrators/">Rijāl Register</a>
          <a href="/research/shirk-endorsed/">Research Studies</a>
          <a href="/academia/">Academic Work</a>
          <a href="/projects/">Research Projects</a>
        </nav>
      </div>

      <div class="hc-footer__col">
        <h3 class="hc-footer__label">Library</h3>
        <nav class="hc-footer__links" aria-label="Library navigation">
          <a href="/blogs/">Studies &amp; Analysis</a>
          <a href="/resources/">Research Library</a>
          <a href="/youtube/">Video Archive</a>
          <a href={reportsHref}>Monographs</a>
          <a href="/contact/">Submissions &amp; Inquiries</a>
        </nav>
      </div>

      <div class="hc-footer__col hc-footer__col--dispatch">
        <h3 class="hc-footer__label">Stay Informed</h3>
        <p class="hc-footer__dispatch-desc">
          Get an email when a new blog post is published. Each update includes a direct link, and you can unsubscribe anytime.
        </p>

        <div class="hc-footer__dispatch" data-subscribe-form>
          <form class="hc-footer__form" data-subscribe-form-el>
            <label for="footer-dispatch-email" class="sr-only">Email address</label>
            <div class="hc-footer__input-row">
              <input
                type="email"
                id="footer-dispatch-email"
                name="email"
                placeholder="researcher@institution.edu"
                required
                autocomplete="email"
                inputmode="email"
                class="hc-footer__input"
              />
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
              <button type="submit" class="hc-footer__submit" aria-label="Subscribe">
                Subscribe
              </button>
            </div>
            <p class="hc-footer__status" data-subscribe-form-status role="status" aria-live="polite"></p>
          </form>
          <nav class="hc-footer__dispatch-actions" aria-label="Quick links">
            <a href={learnMoreHref} class="hc-footer__action">Research &amp; Methodology</a>
            <a href="/contact/" class="hc-footer__action">Contact</a>
          </nav>
        </div>
      </div>
    </div>

    <div class="hc-footer__rule" role="separator"></div>

    <!-- Legal / Utility Row -->
    <div class="hc-footer__bottom">
      <div class="hc-footer__legal">
        <span class="hc-footer__copyright">Copyright {year} HadithCritic</span>
        <nav class="hc-footer__legal-links" aria-label="Legal">
          <a href="/legal/">Privacy &amp; Terms</a>
          <a href="https://github.com/HadithCritic/HadithCriticBlog" target="_blank" rel="noopener noreferrer">Source</a>
        </nav>
      </div>

      <div class="hc-footer__utility">
        <nav class="hc-footer__social" aria-label="External channels">
          <a href="https://x.com/HadithCritic" target="_blank" rel="noopener noreferrer" aria-label="X">X</a>
          <a href="https://www.youtube.com/@HadithCritic" target="_blank" rel="noopener noreferrer" aria-label="YouTube">YouTube</a>
          <a href="https://discord.gg/SubmissionServer" target="_blank" rel="noopener noreferrer" aria-label="Discord">Discord</a>
          <a href="https://github.com/HadithCritic/HadithCriticBlog" target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub</a>
        </nav>
        <button type="button" class="hc-footer__top" id="footer-back-to-top" aria-label="Back to top">
          Back to top
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  // Subscription handler — preserves /api/subscribe contract
  document.querySelectorAll('.hc-footer__dispatch[data-subscribe-form]').forEach((container) => {
    const form = container.querySelector<HTMLFormElement>('[data-subscribe-form-el]');
    const status = container.querySelector<HTMLElement>('[data-subscribe-form-status]');
    if (!form || !status) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = data.get('email');
      const website = data.get('website');
      if (typeof email !== 'string' || !email) return;

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitButton) submitButton.disabled = true;
      status.textContent = '';
      status.className = 'hc-footer__status';

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website })
        });
        const result = (await response.json()) as { success: boolean; error?: string };

        if (result.success) {
          status.textContent = "You're on the blog update list. We'll email you when a new post is published.";
          status.classList.add('is-success');
          form.reset();
        } else {
          status.textContent = result.error || 'Subscription failed. Please try again.';
          status.classList.add('is-error');
        }
      } catch {
        status.textContent = 'Network error. Please try again.';
        status.classList.add('is-error');
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  });

  // Back to top
  const backToTopBtn = document.getElementById('footer-back-to-top');
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style>
  /* ── Footer tokens (local, lean) ── */
  .hc-footer {
    --hc-footer-bg: var(--hc-surface-0, #0f0f10);
    --hc-footer-surface: var(--hc-surface-1, #141312);
    --hc-footer-text: var(--hc-text-primary, #f2ebdc);
    --hc-footer-muted: var(--hc-text-secondary, #b8ad99);
    --hc-footer-dim: var(--hc-text-tertiary, #8c8a86);
    --hc-footer-border: rgba(255, 255, 255, 0.08);
    --hc-footer-accent: var(--hc-gold, #d8b166);
    --hc-footer-container: min(100% - 48px, 1160px);
    --hc-footer-radius: 0;

    position: relative;
    isolation: isolate;
    margin-top: 64px;
    border-top: 1px solid var(--hc-footer-border);
    background: var(--hc-footer-bg);
    color: var(--hc-footer-text);
  }

  .hc-footer__container {
    width: var(--hc-footer-container);
    margin-inline: auto;
    padding-block: 48px 32px;
  }

  /* ── Rules ── */
  .hc-footer__rule {
    height: 1px;
    margin-block: 40px 32px;
    background: var(--hc-footer-border);
    border: none;
  }

  /* ── Navigation Grid ── */
  .hc-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.35fr);
    gap: 40px 48px;
    align-items: start;
  }

  .hc-footer__label {
    margin: 0 0 16px;
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-footer-dim);
  }

  .hc-footer__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hc-footer__links a {
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--hc-footer-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .hc-footer__links a:hover,
  .hc-footer__links a:focus-visible {
    color: var(--hc-footer-text);
  }

  .hc-footer__links a:focus-visible {
    outline: 2px solid var(--hc-footer-accent);
    outline-offset: 2px;
  }

  /* ── Dispatch (newsletter) ── */
  .hc-footer__dispatch-desc {
    margin: 0 0 16px;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--hc-footer-muted);
    max-width: 36ch;
  }

  .hc-footer__form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hc-footer__input-row {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--hc-footer-border);
    border-radius: var(--hc-footer-radius);
    background: var(--hc-footer-surface);
    overflow: hidden;
    transition: border-color 150ms ease;
  }

  .hc-footer__input-row:focus-within {
    border-color: rgba(216, 177, 102, 0.45);
  }

  .hc-footer__input {
    flex: 1;
    min-width: 0;
    height: 40px;
    padding: 0 14px;
    background: transparent;
    border: none;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.875rem;
    color: var(--hc-footer-text);
  }

  .hc-footer__input::placeholder {
    color: var(--hc-footer-dim);
  }

  /* The row clips its children (overflow: hidden), so the global ring at its
     default outward offset was cut off. Draw it inside the input instead. */
  .hc-footer__input {
    --hc-focus-offset: -3px;
  }

  .hc-footer__submit {
    height: 40px;
    padding: 0 18px;
    background: transparent;
    border: none;
    border-left: 1px solid var(--hc-footer-border);
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hc-footer-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .hc-footer__submit:hover,
  .hc-footer__submit:focus-visible {
    color: var(--hc-footer-text);
    background: rgba(255, 255, 255, 0.03);
  }

  .hc-footer__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .hc-footer__status {
    margin: 0;
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: 0.8125rem;
    line-height: 1.4;
    min-height: 1.2em;
  }

  .hc-footer__status.is-success {
    color: var(--hc-success, #81c784);
  }

  .hc-footer__status.is-error {
    color: var(--hc-error, #e57373);
  }

  .hc-footer__dispatch-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .hc-footer__action {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--hc-footer-border);
    border-radius: var(--hc-footer-radius);
    background: transparent;
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--hc-footer-muted);
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .hc-footer__action:hover,
  .hc-footer__action:focus-visible {
    color: var(--hc-footer-text);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .hc-footer__action:focus-visible {
    outline: 2px solid var(--hc-footer-accent);
    outline-offset: 2px;
  }

  /* ── Bottom bar ── */
  .hc-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .hc-footer__legal {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hc-footer__copyright {
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--hc-footer-dim);
  }

  .hc-footer__legal-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hc-footer__legal-links a {
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--hc-footer-dim);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .hc-footer__legal-links a:hover,
  .hc-footer__legal-links a:focus-visible {
    color: var(--hc-footer-muted);
  }

  .hc-footer__utility {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .hc-footer__social {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hc-footer__social a {
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--hc-footer-dim);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .hc-footer__social a:hover,
  .hc-footer__social a:focus-visible {
    color: var(--hc-footer-text);
  }

  .hc-footer__top {
    height: 32px;
    padding: 0 12px;
    background: transparent;
    border: 1px solid var(--hc-footer-border);
    border-radius: var(--hc-footer-radius);
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--hc-footer-dim);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .hc-footer__top:hover,
  .hc-footer__top:focus-visible {
    color: var(--hc-footer-text);
    border-color: rgba(255, 255, 255, 0.16);
  }

  .hc-footer__top:focus-visible {
    outline: 2px solid var(--hc-footer-accent);
    outline-offset: 2px;
  }

  /* Screen-reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Light theme ── */
  :global([data-theme="light"]) .hc-footer {
    --hc-footer-bg: var(--hc-surface-0, #fbf9f4);
    --hc-footer-surface: var(--hc-surface-1, #f2ece0);
    --hc-footer-text: var(--hc-text-primary, #2b2824);
    --hc-footer-muted: var(--hc-text-secondary, #6b635a);
    --hc-footer-dim: var(--hc-text-tertiary, #635e56);
    --hc-footer-border: rgba(43, 40, 36, 0.12);
    --hc-footer-accent: var(--hc-gold, #6f5019);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hc-footer__container {
      width: min(100% - 32px, 1160px);
      padding-block: 40px 28px;
    }

    .hc-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 40px;
    }

    .hc-footer__col--dispatch {
      grid-column: 1 / -1;
      max-width: 420px;
    }

    .hc-footer__rule {
      margin-block: 32px;
    }
  }

  @media (max-width: 640px) {
    .hc-footer {
      margin-top: 48px;
    }

    .hc-footer__container {
      width: min(100% - 32px, 1160px);
      padding-block: 32px 24px;
    }

    .hc-footer__action {
      flex: 1;
      justify-content: center;
    }

    .hc-footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hc-footer__col--dispatch {
      max-width: none;
    }

    .hc-footer__rule {
      margin-block: 28px;
    }

    .hc-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .hc-footer__utility {
      width: 100%;
      justify-content: space-between;
    }

    .hc-footer__input-row {
      flex-direction: column;
    }

    .hc-footer__submit {
      width: 100%;
      border-left: none;
      border-top: 1px solid var(--hc-footer-border);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hc-footer__action,
    .hc-footer__links a,
    .hc-footer__submit,
    .hc-footer__social a,
    .hc-footer__legal-links a,
    .hc-footer__top,
    .hc-footer__input-row {
      transition: none !important;
    }
  }
</style>
