---
interface Props {
  variant?: 'image' | 'dark';
  learnMoreHref?: string;
  reportsHref?: string;
}

const { variant = 'image', learnMoreHref = '/blogs', reportsHref = '/blogs' } = Astro.props;
---

<footer id="site-footer" class:list={['hcFooter', variant === 'dark' && 'hcFooter--dark']} aria-labelledby="footer-title">
  <div class="hcFooter__content">
    <div class="hcFooter__grid">
      <!-- Col 1: Brand & Philosophy -->
      <div class="hcFooter__col hcFooter__col--brand">
        <h2 id="footer-title" class="hcFooter__brand-title">Verification over reputation.</h2>
        <p class="hcFooter__brand-desc">
          HadithCritic is an independent research initiative studying historical reports through empirical evidence, isnād criticism, manuscript transmission, and rigorous textual analysis.
        </p>
        <a href={learnMoreHref} class="hcFooter__learn-link">
          <span>About our methodology</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="hcFooter__col hcFooter__col--nav">
        <span class="hcFooter__section-title">Navigation</span>
        <nav class="hcFooter__links-grid" aria-label="Footer navigation">
          <a href="/blogs">Blog</a>
          <a href="/research/shirk-endorsed">Shirk Monograph</a>
          <a href="/academia">Academia</a>
          <a href="/projects">Projects</a>
          <a href="/resources">Resources</a>
          <a href="/youtube">YouTube</a>
          <a href="/brand">Brand Assets</a>
          <a href="/contact">Contact</a>
          <a href="/legal">Privacy & Terms</a>
        </nav>
      </div>

      <!-- Col 3: Compact Dispatch Subscription -->
      <div class="hcFooter__col hcFooter__col--subscribe">
        <div class="hcFooter__subscribe-box" data-subscribe-form>
          <span class="hcFooter__section-title">Stay Informed</span>
          <p class="hcFooter__sub-text">
            Receive concise email alerts when new research monographs and hadith investigations publish.
          </p>
          <form class="hcFooter__sub-form" data-subscribe-form-el>
            <label for="footer-sub-email" class="sr-only">Email address</label>
            <div class="hcFooter__field-wrap">
              <input
                type="email"
                id="footer-sub-email"
                name="email"
                placeholder="you@example.com"
                required
                autocomplete="email"
                inputmode="email"
              />
              <button type="submit" aria-label="Subscribe to dispatch">
                <span>Join</span>
                <span aria-hidden="true">→</span>
              </button>
            </div>
            <span class="hcFooter__sub-note">No spam. Unsubscribe anytime.</span>
          </form>
          <p class="hcFooter__sub-status" data-subscribe-form-status role="status" aria-live="polite"></p>
        </div>
      </div>
    </div>

    <!-- Bottom Bar: Meta, Actions, Copyright & Socials -->
    <div class="hcFooter__bottom">
      <div class="hcFooter__bottom-left">
        <span class="hcFooter__copyright">
          © {new Date().getFullYear()} HadithCritic. Independent Islamic Historical Criticism.
        </span>
      </div>

      <div class="hcFooter__bottom-right">
        <div class="hcFooter__quick-actions">
          <a href="/contact" class="hcFooter__action-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>Contact</span>
          </a>
          <a href={reportsHref} class="hcFooter__action-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
            <span>Reports</span>
          </a>
        </div>

        <nav class="hcFooter__social" aria-label="Social links">
          <a href="https://x.com/HadithCritic" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
          </a>
          <a href="https://www.youtube.com/@HadithCritic" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.015 3.015 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93-.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://discord.gg/SubmissionServer" aria-label="Discord" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          </a>
          <a href="https://github.com/HadithCritic/HadithCriticBlog" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </nav>
      </div>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll('.hcFooter__subscribe-box[data-subscribe-form]').forEach((container) => {
    const form = container.querySelector<HTMLFormElement>('[data-subscribe-form-el]');
    const status = container.querySelector<HTMLElement>('[data-subscribe-form-status]');
    if (!form || !status) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = new FormData(form).get('email');
      if (typeof email !== 'string' || !email) return;

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitButton) submitButton.disabled = true;
      status.textContent = '';
      status.className = 'hcFooter__sub-status';

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const result = (await response.json()) as { success: boolean; error?: string };

        if (result.success) {
          status.textContent = "Subscribed to investigations.";
          status.classList.add('is-success');
          form.reset();
        } else {
          status.textContent = result.error || 'Subscription failed. Try again.';
          status.classList.add('is-error');
        }
      } catch {
        status.textContent = 'Network error. Please try again.';
        status.classList.add('is-error');
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  });
</script>


