---
import SubscribeForm from './SubscribeForm.astro';

interface Props {
  variant?: 'image' | 'dark';
  learnMoreHref?: string;
  reportsHref?: string;
}

const { variant = 'image', learnMoreHref = '/blogs', reportsHref = '/blogs' } = Astro.props;
---

<footer id="site-footer" class:list={['hcFooter', variant === 'dark' && 'hcFooter--dark']} aria-labelledby="footer-title">
  <div class="hcFooter__content">
    <div class="hcFooter__panel">
      <div class="hcFooter__brand">
        <h2 id="footer-title">Verification over reputation.</h2>
        <p>
          HadithCritic is an independent research initiative studying reports through evidence, transmission, source history, textual comparison, and clear judgment.
          <a href={learnMoreHref} class="hcFooter__link">Learn more</a>
        </p>
      </div>

      <nav class="hcFooter__links" aria-label="Footer navigation">
        <a href="/blogs">Blog</a>
        <a href="/academia">Academia</a>
        <a href="/projects">Projects</a>
        <a href="/resources">Resources</a>
        <a href="/youtube">YouTube</a>
        <a href="/brand">Brand</a>
        <a href="/contact">Contact</a>
        <a href="/legal">Privacy & Terms</a>
      </nav>

      <div class="hcFooter__meta">
        <div class="hcFooter__actions-group">
          <div class="hcFooter__contact">
            <a href="/contact" class="hcFooter__action">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Contact
            </a>
            <a href={reportsHref} class="hcFooter__action">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
              Reports
            </a>
          </div>
          <nav class="hcFooter__social" aria-label="Social links">
            <a href="https://x.com/HadithCritic" aria-label="X (Twitter)">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
            </a>
            <a href="https://www.youtube.com/@HadithCritic" aria-label="YouTube">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.015 3.015 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93-.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://discord.gg/SubmissionServer" aria-label="Discord">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            </a>
            <a href="https://github.com/HadithCritic/HadithCriticBlog" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
          </nav>
        </div>
      </div>
    </div>

    <SubscribeForm variant="footer" />
  </div>
</footer>

<style>
  .hcFooter {
    position: relative;
    isolation: isolate;
    margin-top: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    border-top: 1px solid var(--hc-rule, rgba(216, 177, 102, 0.32));
    color: var(--hc-fixed-parchment, #F2EBDC);
    background:
      radial-gradient(circle at 18% 18%, rgba(216, 177, 102, 0.09), transparent 30rem),
      radial-gradient(circle at 82% 72%, rgba(164, 106, 63, 0.12), transparent 34rem),
      linear-gradient(180deg, rgba(15, 15, 16, 0.94), rgba(15, 15, 16, 0.86)),
      url("/images/brand/dark_footer_asset.png") center / 760px auto repeat;
  }

  .hcFooter::before,
  .hcFooter::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hcFooter::before {
    inset-block: 0;
    background:
      linear-gradient(180deg, rgba(15, 15, 16, 0.88), rgba(15, 15, 16, 0.10) 18%, rgba(15, 15, 16, 0.18) 78%, rgba(15, 15, 16, 0.82)),
      linear-gradient(90deg, rgba(15, 15, 16, 0.82), transparent 24%, transparent 76%, rgba(15, 15, 16, 0.82));
  }

  .hcFooter::after {
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(216, 177, 102, 0.58), transparent);
  }

  .hcFooter__content {
    position: relative;
    z-index: 1;
    width: min(100% - (var(--pad, 1.5rem) * 2), var(--wrap, 1240px));
    margin-inline: auto;
    padding-block: clamp(3.4rem, 6.5vw, 5.5rem) clamp(2.5rem, 4.5vw, 3.5rem);
  }

  .hcFooter__panel {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(320px, 0.95fr) minmax(380px, 0.88fr);
    grid-template-areas:
      "brand links"
      "meta meta";
    gap: clamp(2rem, 5vw, 5rem) clamp(2.5rem, 7vw, 6.5rem);
    align-items: start;
  }

  .hcFooter__brand {
    grid-area: brand;
    max-width: 56ch;
  }

  .hcFooter h2 {
    margin: 0;
    color: var(--hc-fixed-parchment, #F2EBDC);
    font-family: var(--font-display, serif);
    font-size: clamp(2.35rem, 5vw, 4.7rem);
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .hcFooter__brand p {
    margin: clamp(1rem, 2vw, 1.3rem) 0 0;
    max-width: 52ch;
    color: color-mix(in srgb, var(--hc-fixed-parchment, #F2EBDC) 78%, transparent);
    font-size: clamp(1rem, 0.4vw + 0.92rem, 1.12rem);
    line-height: 1.72;
  }

  .hcFooter__link {
    margin-left: 0.3rem;
    color: var(--hc-gold-bright, #E8C878);
    font-weight: 750;
    text-decoration-color: rgba(232, 200, 120, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .hcFooter__link:hover {
    color: var(--hc-gold-bright, #E8C878);
    text-decoration-color: currentColor;
  }

  .hcFooter__links {
    grid-area: links;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(10rem, 1fr));
    gap: 0.85rem 1.5rem;
    margin: 0;
    padding: clamp(1.2rem, 2vw, 1.55rem);
    border: 1px solid rgba(216, 177, 102, 0.2);
    background:
      linear-gradient(180deg, rgba(30, 29, 27, 0.62), rgba(15, 15, 16, 0.54));
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.24);
  }

  .hcFooter__links a {
    color: color-mix(in srgb, var(--hc-fixed-parchment, #F2EBDC) 76%, transparent);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1.25;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .hcFooter__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    min-height: 2rem;
  }

  .hcFooter__links a::before {
    content: "";
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid currentColor;
    opacity: 0.5;
    transform: rotate(45deg);
    transition: opacity 180ms ease, transform 180ms var(--ease, ease);
  }

  .hcFooter__links a:hover {
    color: var(--hc-gold-bright, #E8C878);
  }

  .hcFooter__links a:hover::before {
    opacity: 1;
    transform: rotate(45deg) scale(1.18);
  }

  .hcFooter__meta {
    grid-area: meta;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem 2rem;
    padding-top: clamp(1.25rem, 2.5vw, 1.8rem);
    border-top: 1px solid rgba(242, 235, 220, 0.13);
  }

  .hcFooter__actions-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.4rem;
    min-width: 0;
  }

  .hcFooter__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hcFooter__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.48rem;
    min-height: 42px;
    padding: 0.62rem 0.92rem;
    border: 1px solid rgba(216, 177, 102, 0.34);
    color: var(--hc-fixed-parchment, #F2EBDC);
    background: rgba(216, 177, 102, 0.07);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.86rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms var(--ease, ease);
  }

  .hcFooter__action:hover {
    border-color: rgba(232, 200, 120, 0.7);
    color: var(--hc-gold-bright, #E8C878);
    background: rgba(216, 177, 102, 0.13);
    transform: translateY(-1px);
  }

  .hcFooter__action svg {
    flex: 0 0 auto;
  }

  .hcFooter__social {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hcFooter__social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(216, 177, 102, 0.26);
    color: color-mix(in srgb, var(--hc-fixed-parchment, #F2EBDC) 72%, transparent);
    background: rgba(242, 235, 220, 0.07);
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms var(--ease, ease);
  }

  .hcFooter__social a:hover {
    border-color: rgba(232, 200, 120, 0.7);
    color: var(--hc-gold-bright, #E8C878);
    background: rgba(216, 177, 102, 0.13);
    transform: translateY(-1px);
  }

  .hcFooter__copyright {
    grid-column: 1 / -1;
    margin: 0.35rem 0 0;
    color: color-mix(in srgb, var(--hc-fixed-parchment, #F2EBDC) 45%, transparent);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.76rem;
    line-height: 1.2;
  }

  @media (max-width: 980px) {
    .hcFooter__panel {
      grid-template-columns: 1fr;
      grid-template-areas:
        "brand"
        "links"
        "meta";
      gap: 1.6rem;
    }

    .hcFooter__brand {
      max-width: 68ch;
    }

    .hcFooter__links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hcFooter__meta {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hcFooter {
      margin-top: clamp(2.5rem, 10vw, 4rem);
      background-size: 560px auto;
      background-position: center top;
    }

    .hcFooter::before {
      background:
        linear-gradient(180deg, rgba(15, 15, 16, 0.84), rgba(15, 15, 16, 0.26) 18%, rgba(15, 15, 16, 0.34) 74%, rgba(15, 15, 16, 0.88)),
        linear-gradient(90deg, rgba(15, 15, 16, 0.72), transparent 42%, rgba(15, 15, 16, 0.72));
    }

    .hcFooter__content {
      width: min(100% - 2rem, 34rem);
      padding-block: 3rem max(2.4rem, calc(2rem + var(--sab, 0px)));
    }

    .hcFooter h2 {
      max-width: 11ch;
      font-size: clamp(2.25rem, 12vw, 3.55rem);
      line-height: 0.96;
    }

    .hcFooter__brand p {
      max-width: 32rem;
      font-size: 0.98rem;
      line-height: 1.64;
    }

    .hcFooter__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem 0.9rem;
      padding: 1rem;
    }

    .hcFooter__links a {
      width: 100%;
    }

    .hcFooter__actions-group,
    .hcFooter__contact,
    .hcFooter__social {
      width: 100%;
    }

    .hcFooter__actions-group {
      display: grid;
      gap: 1rem;
    }

    .hcFooter__contact {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .hcFooter__action {
      width: 100%;
      min-height: 44px;
    }

    .hcFooter__social {
      display: grid;
      grid-template-columns: repeat(4, 42px);
      justify-content: start;
    }
  }

  @media (max-width: 420px) {
    .hcFooter__links,
    .hcFooter__contact {
      grid-template-columns: 1fr;
    }

    .hcFooter__social {
      grid-template-columns: repeat(4, 40px);
    }

    .hcFooter__social a {
      width: 40px;
      height: 40px;
    }
  }

  .hcFooter--dark {
    color: var(--hc-fixed-parchment);
    background:
      radial-gradient(circle at 50% 0%, rgba(216, 177, 102, 0.08), transparent 34%),
      linear-gradient(180deg, rgba(15, 15, 16, 0.98), rgba(20, 19, 17, 0.98));
  }

  .hcFooter--dark::before {
    background:
      linear-gradient(180deg, rgba(216, 177, 102, 0.04), transparent 42%),
      radial-gradient(circle at 20% 65%, rgba(164, 106, 63, 0.09), transparent 32%);
  }

  .hcFooter--dark .hcFooter__panel {
    max-width: 980px;
    margin-inline: auto;
    grid-template-columns: 1fr;
    grid-template-areas:
      "brand"
      "links"
      "meta";
    text-align: center;
  }

  .hcFooter--dark .hcFooter__brand {
    max-width: 68ch;
    margin-inline: auto;
  }

  .hcFooter--dark h2 {
    max-width: none;
    white-space: normal;
  }

  .hcFooter--dark .hcFooter__links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hcFooter--dark .hcFooter__meta,
  .hcFooter--dark .hcFooter__actions-group,
  .hcFooter--dark .hcFooter__contact,
  .hcFooter--dark .hcFooter__social {
    justify-content: center;
  }

  @media (max-width: 640px) {
    .hcFooter--dark .hcFooter__panel {
      text-align: left;
    }

    .hcFooter--dark .hcFooter__links {
      display: grid;
      justify-content: stretch;
    }

    .hcFooter--dark .hcFooter__meta,
    .hcFooter--dark .hcFooter__actions-group,
    .hcFooter--dark .hcFooter__contact,
    .hcFooter--dark .hcFooter__social {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hcFooter__links a::before,
    .hcFooter__action,
    .hcFooter__social a {
      transition: none;
    }
  }
</style>
