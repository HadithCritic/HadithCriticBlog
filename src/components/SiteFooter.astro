---
interface Props {
  variant?: 'image' | 'dark';
  learnMoreHref?: string;
  reportsHref?: string;
}

const { variant = 'image', learnMoreHref = '/method', reportsHref = '/reports' } = Astro.props;
---

<footer id="site-footer" class:list={['hcFooter', variant === 'dark' && 'hcFooter--dark']} aria-labelledby="footer-title">
  <div class="hcFooter__content">
    <div class="hcFooter__panel">
      <div class="hcFooter__brand">
        <h2 id="footer-title">Verification over reputation.</h2>
        <p>
          HadithCritic is an independent research initiative studying reports through evidence, transmission, source history, textual comparison, and clear judgment.
          <a href={learnMoreHref} class="hcFooter__link">Learn more</a>
        </p>
      </div>

      <nav class="hcFooter__links" aria-label="Footer navigation">
        <a href="/blogs">Blog</a>
        <a href="/academia">Academia</a>
        <a href="/projects">Projects</a>
        <a href="/resources">Resources</a>
        <a href="/youtube">YouTube</a>
        <a href="/brand">Brand</a>
        <a href="/contact">Contact</a>
      </nav>

      <div class="hcFooter__meta">
        <div class="hcFooter__actions-group">
          <div class="hcFooter__contact">
            <a href="/contact" class="hcFooter__action">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Contact
            </a>
            <a href={reportsHref} class="hcFooter__action">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
              Reports
            </a>
          </div>
          <nav class="hcFooter__social" aria-label="Social links">
            <a href="https://twitter.com/hadithcritic" aria-label="Twitter">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
            </a>
            <a href="https://youtube.com/hadithcritic" aria-label="YouTube">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.015 3.015 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93-.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://discord.gg/hadithcritic" aria-label="Discord">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            </a>
            <a href="https://github.com/hadithcritic" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
          </nav>
        </div>

        <nav class="hcFooter__legal" aria-label="Legal links">
          <a href="/legal/terms">Terms</a>
          <a href="/legal/privacy">Privacy</a>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .hcFooter {
    position: relative;
    isolation: isolate;
    min-height: clamp(300px, 35vw, 500px);
    margin-top: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    border-top: 1px solid var(--hc-rule, rgba(216, 177, 102, 0.32));
    color: oklch(22% 0.025 67);
    background:
      linear-gradient(90deg, rgba(15, 15, 16, 0.28), rgba(15, 15, 16, 0) 30%, rgba(15, 15, 16, 0.12) 100%),
      url("/images/brand/footerasset.webp") center / 100% 100% no-repeat;
    box-shadow: inset 0 36px 58px rgba(15, 15, 16, 0.42);
  }

  .hcFooter::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hcFooter::before {
    z-index: 0;
    background:
      linear-gradient(180deg, rgba(15, 15, 16, 0.82), rgba(15, 15, 16, 0.02) 21%, rgba(15, 15, 16, 0.02) 78%, rgba(15, 15, 16, 0.78)),
      radial-gradient(circle at 18% 58%, rgba(96, 62, 28, 0.14), transparent 30%);
  }

  .hcFooter__content {
    position: relative;
    z-index: 1;
    width: min(100% - (var(--pad, 1.5rem) * 2), var(--wrap, 1240px));
    min-height: inherit;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(260px, 0.68fr) minmax(420px, 0.72fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 7rem);
    padding-top: 5rem;
    padding-bottom: 3rem;
  }

  .hcFooter__panel {
    grid-column: 2;
    width: min(100%, 720px);
    margin-left: auto;
  }

  .hcFooter__brand {
    max-width: 66ch;
  }

  .hcFooter h2 {
    margin: 0.55rem 0 0;
    color: oklch(19% 0.022 67);
    font-family: var(--font-display, serif);
    font-size: clamp(1.5rem, 5vw, 3.35rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.98;
    white-space: nowrap;
  }

  .hcFooter__brand p {
    margin: 1rem 0 0;
    color: oklch(31% 0.032 67);
    font-size: 1rem;
    line-height: 1.68;
  }

  .hcFooter__link {
    margin-left: 0.3rem;
    color: oklch(38% 0.085 73);
    font-weight: 700;
    text-decoration-color: rgba(110, 59, 36, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .hcFooter__link:hover {
    color: oklch(30% 0.075 62);
    text-decoration-color: currentColor;
  }

  .hcFooter__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem 1rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(110, 59, 36, 0.2);
  }

  .hcFooter__links a,
  .hcFooter__legal a {
    color: oklch(28% 0.034 67);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
  }

  .hcFooter__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
  }

  .hcFooter__links a::before {
    content: "";
    width: 0.38rem;
    height: 0.38rem;
    border: 1px solid currentColor;
    opacity: 0.55;
    transform: rotate(45deg);
    transition: opacity 180ms ease, transform 180ms var(--ease, ease);
  }

  .hcFooter__links a:hover,
  .hcFooter__legal a:hover {
    color: oklch(38% 0.085 73);
  }

  .hcFooter__links a:hover::before {
    opacity: 1;
    transform: rotate(45deg) scale(1.18);
  }

  .hcFooter__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(110, 59, 36, 0.2);
  }

  .hcFooter__actions-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .hcFooter__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }


  .hcFooter__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 40px;
    padding: 0.55rem 0.8rem;
    border: 1px solid rgba(110, 59, 36, 0.32);
    color: oklch(24% 0.03 67);
    background: rgba(242, 235, 220, 0.28);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms var(--ease, ease);
  }

  .hcFooter__action:hover {
    border-color: rgba(110, 59, 36, 0.58);
    color: oklch(19% 0.022 67);
    background: rgba(216, 177, 102, 0.22);
    transform: translateY(-1px);
  }

  .hcFooter__action svg {
    flex: 0 0 auto;
  }


  .hcFooter__social,
  .hcFooter__legal {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hcFooter__social a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(110, 59, 36, 0.28);
    color: oklch(30% 0.045 67);
    background: rgba(242, 235, 220, 0.24);
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms var(--ease, ease);
  }

  .hcFooter__social a:hover {
    border-color: rgba(110, 59, 36, 0.58);
    color: oklch(19% 0.022 67);
    background: rgba(216, 177, 102, 0.22);
    transform: translateY(-1px);
  }

  .hcFooter__legal {
    gap: 0.9rem;
  }

  .hcFooter__legal a {
    font-size: 0.78rem;
  }

  .hcFooter__copyright {
    grid-column: 1 / -1;
    margin: 0.35rem 0 0;
    color: oklch(34% 0.035 67);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.76rem;
    line-height: 1.2;
  }

  @media (max-width: 1100px) {
    .hcFooter__content {
      grid-template-columns: minmax(200px, 0.4fr) minmax(0, 0.6fr);
      gap: 2rem;
    }

    .hcFooter h2 {
      font-size: 2.8rem;
    }
  }

  @media (max-width: 820px) {
    .hcFooter {
      min-height: auto;
      background-size: auto 100%;
      background-position: 34% center;
    }

    .hcFooter::before {
      background:
        linear-gradient(180deg, rgba(15, 15, 16, 0.42), rgba(15, 15, 16, 0.04) 34%, rgba(15, 15, 16, 0.78) 56%, rgba(15, 15, 16, 0.96) 100%),
        radial-gradient(circle at 26% 28%, rgba(96, 62, 28, 0.14), transparent 26%);
    }

    .hcFooter__content {
      display: block;
      min-height: inherit;
      padding-block: 4rem 3rem;
    }

    .hcFooter__panel {
      width: 100%;
      max-width: 640px;
      margin-inline: auto;
    }

    .hcFooter__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  @media (max-width: 540px) {
    .hcFooter {
      min-height: auto;
      background-position: 40% center;
    }

    .hcFooter__content {
      padding-block: 4rem 2.5rem;
    }

    .hcFooter__brand,
    .hcFooter__links,
    .hcFooter__meta {
      max-width: 22rem;
    }

    .hcFooter h2 {
      font-size: clamp(1.4rem, 6.5vw, 2.12rem);
      line-height: 1.04;
    }

    .hcFooter__brand p {
      font-size: 0.96rem;
    }

    .hcFooter__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
    }

    .hcFooter__contact {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr;
    }

    .hcFooter__action {
      width: 100%;
    }
  }

  .hcFooter--dark {
    min-height: auto;
    color: var(--hc-parchment);
    background:
      radial-gradient(circle at 50% 0%, rgba(216, 177, 102, 0.08), transparent 34%),
      linear-gradient(180deg, rgba(15, 15, 16, 0.98), rgba(20, 19, 17, 0.98));
    box-shadow: none;
  }

  .hcFooter--dark::before {
    background:
      linear-gradient(180deg, rgba(216, 177, 102, 0.04), transparent 42%),
      radial-gradient(circle at 20% 65%, rgba(164, 106, 63, 0.09), transparent 32%);
  }

  .hcFooter--dark .hcFooter__content {
    display: block;
    min-height: auto;
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2.4rem, 4vw, 3rem);
  }

  .hcFooter--dark .hcFooter__panel {
    width: min(100%, 820px);
    margin-inline: auto;
    text-align: center;
  }

  .hcFooter--dark .hcFooter__brand {
    max-width: 68ch;
    margin-inline: auto;
  }

  .hcFooter--dark h2 {
    color: var(--hc-parchment);
    font-size: clamp(2rem, 4vw, 3.45rem);
    line-height: 1;
    white-space: normal;
  }

  .hcFooter--dark .hcFooter__brand p {
    color: var(--hc-muted);
  }

  .hcFooter--dark .hcFooter__link,
  .hcFooter--dark .hcFooter__links a:hover,
  .hcFooter--dark .hcFooter__legal a:hover {
    color: var(--hc-gold-bright, var(--hc-gold-soft));
    text-decoration-color: rgba(232, 200, 120, 0.45);
  }

  .hcFooter--dark .hcFooter__links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.2rem;
    border-top-color: var(--hc-rule-soft);
  }

  .hcFooter--dark .hcFooter__links a,
  .hcFooter--dark .hcFooter__legal a {
    color: var(--hc-muted);
  }

  .hcFooter--dark .hcFooter__meta {
    justify-content: center;
    border-top-color: var(--hc-rule-soft);
  }

  .hcFooter--dark .hcFooter__actions-group,
  .hcFooter--dark .hcFooter__contact,
  .hcFooter--dark .hcFooter__social,
  .hcFooter--dark .hcFooter__legal {
    justify-content: center;
  }

  .hcFooter--dark .hcFooter__action,
  .hcFooter--dark .hcFooter__social a {
    border-color: var(--hc-rule);
    color: var(--hc-parchment);
    background: rgba(216, 177, 102, 0.06);
  }

  .hcFooter--dark .hcFooter__action:hover,
  .hcFooter--dark .hcFooter__social a:hover {
    border-color: var(--hc-rule-strong);
    color: var(--hc-gold-bright, var(--hc-gold-soft));
    background: rgba(216, 177, 102, 0.1);
  }

  @media (max-width: 540px) {
    .hcFooter--dark .hcFooter__brand,
    .hcFooter--dark .hcFooter__links,
    .hcFooter--dark .hcFooter__meta {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hcFooter__links a::before,
    .hcFooter__action,
    .hcFooter__social a {
      transition: none;
    }
  }
</style>
