---
import '../styles/site-footer.css';
interface Props {
  variant?: 'image' | 'dark';
  learnMoreHref?: string;
  reportsHref?: string;
}
const { learnMoreHref = '/blogs/', reportsHref = '/blogs/' } = Astro.props;
const year = new Date().getFullYear();
const groups = [
  { title: 'Reports', links: [['All Reports', '/blogs/'], ['Monographs', reportsHref], ['History', '/blogs/category/origins-early-history/'], ['Theology', '/blogs/category/theology-epistemology/'], ['Prophecies', '/blogs/category/prophecies-eschatology/']] },
  { title: 'Collections', links: [['Hadith Corpus', '/hadith/'], ['Rijal Register', '/narrators/'], ['Qurʾān', '/projects/quran/'], ['Tafsir', '/projects/tafsir/'], ['All Projects', '/projects/']] },
  { title: 'Research', links: [['Studies & Analysis', '/blogs/'], ['Islamic Studies Atlas', '/projects/islamic-studies-atlas/'], ['ICMA Register', '/projects/academic-studies/'], ['Fiqh Compass', '/projects/fiqh-compass/'],['Academic Work', '/academia/'], ['Research & Method', learnMoreHref]] },
  { title: 'Resources', links: [['Research Library', '/resources/'], ['Video Archive', '/youtube/'], ['Source Code', 'https://github.com/HadithCritic/HadithCriticBlog'], ['RSS Feed', '/rss.xml']] },
  { title: 'About', links: [['HadithCritic', '/'], ['Inquiries', '/contact/'], ['Submissions', '/contact/'], ['Privacy & Terms', '/legal/']] }
];
const principles = [
  { title: 'Rigor', description: 'Method before opinion.', icon: 'M3 5c3-1 6-1 9 1v15c-3-2-6-2-9-1V5Zm9 1c3-2 6-2 9-1v15c-3-1-6-1-9 1M6 8h3m-3 3h3m-3 3h3m6-6h3m-3 3h3m-3 3h3' },
  { title: 'Fairness', description: 'Charity in judgment, clarity in evidence.', icon: 'M12 3v18m-5 0h10M4 7l8-3 8 3M4 7l-3 9h6L4 7Zm16 0-3 9h6l-3-9ZM1 16c1 4 5 4 6 0m10 0c1 4 5 4 6 0' },
  { title: 'Transparency', description: 'Open reports. Traceable sources.', icon: 'M9 3h6m-3-2v2M7 7h10l-1 13H8L7 7Zm-1 0 6-4 6 4M10 10v7m4-7v7M7 22h10' },
  { title: 'A Legacy of Inquiry', description: 'Upholding the standards of the scholars and the pursuit of truth.', icon: 'M12 2 22 12 12 22 2 12 12 2Zm0 4 6 6-6 6-6-6 6-6Zm0 3 3 3-3 3-3-3 3-3Z' }
];
const channels = [
  { name: 'X', href: 'https://x.com/HadithCritic', path: 'm4 3 16 18M20 3 4 21M4 3h5l11 18h-5L4 3Z' },
  { name: 'YouTube', href: 'https://www.youtube.com/@HadithCritic', path: 'M21 7c0-2-2-3-9-3S3 5 3 7v10c0 2 2 3 9 3s9-1 9-3V7ZM10 8l6 4-6 4V8Z' },
  { name: 'Discord', href: 'https://discord.gg/SubmissionServer', path: 'M8 5 5 6 2 17l5 2 1-2m8-12 3 1 3 11-5 2-1-2M8 5c3-1 5-1 8 0M7 17c3 2 7 2 10 0M8 11v2m8-2v2' },
  { name: 'GitHub', href: 'https://github.com/HadithCritic/HadithCriticBlog', path: 'M9 21v-4c-4 1-4-2-6-2m12 6v-4c0-1-1-2-1-2 4 0 6-2 6-5 0-2-1-3-2-4 0-1 0-2-1-3l-4 2H9L5 3c-1 1-1 2-1 3-1 1-2 2-2 4 0 3 2 5 6 5-1 1-1 2-1 2' }
];
---

<footer id="site-footer" class="hc-footer hc-plate" aria-label="Site footer">
  <div class="hc-footer__frame">
    {[0, 1, 2, 3].map((corner) => <svg class:list={['hc-footer__corner', 'hc-footer__corner--' + corner]} viewBox="0 0 48 48" fill="none" stroke="currentColor" aria-hidden="true"><path d="M2 46V8h38M8 46V2h38M2 18h16V2M8 26h18V8M2 8c18 0 4 20 18 20S30 8 16 8 4 30 28 30M8 2c0 18 20 4 20 18s-20 10-20-4S30 4 30 28" /></svg>)}
    <span class="hc-footer__crest" aria-hidden="true"></span>
    <div class="hc-footer__grid">
      <div class="hc-footer__brand">
        <a class="hc-footer__wordmark" href="/" aria-label="HadithCritic home">
          <img src="/images/brand/hc-logo-transparent-192.png" width="80" height="112" alt="" loading="lazy" />
          <span>HadithCritic</span>
        </a>
        <div class="hc-footer__brand-rule" aria-hidden="true"><span></span></div>
        <p class="hc-footer__brand-desc">Textual criticism, transmission analysis, and source verification, so the truth is sought through evidence and transmitted with integrity.</p>
        <div class="hc-footer__contact">
          <a href="/contact/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h20v14H2V5Zm0 0 10 8L22 5" /></svg>Inquiries &amp; partnerships</a>
          <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22S4 14 4 9a8 8 0 1 1 16 0c0 5-8 13-8 13Z"/><circle cx="12" cy="9" r="3" /></svg>A worldwide research community</span>
        </div>
        <details class="hc-footer__principles">
          <summary>Research principles</summary>
          {principles.map(item => <div class="hc-footer__principle"><h3>{item.title}</h3><p>{item.description}</p></div>)}
        </details>
      </div>
      <div class="hc-footer__directory">
        {groups.map((group) => <details class="hc-footer__col" data-footer-group open>
          <summary><h3 class="hc-footer__label">{group.title}</h3></summary>
          <nav class="hc-footer__links" aria-label={group.title + ' navigation'}>
            {group.links.map(([label, href]) => <a href={href}>{label}</a>)}
          </nav>
        </details>)}
      </div>
      <div class="hc-footer__col hc-footer__col--dispatch">
        <h3 class="hc-footer__label">Stay Informed</h3>
        <p class="hc-footer__dispatch-desc">Receive new reports and research insights when a blog post is published. Unsubscribe anytime.</p>
        <div class="hc-footer__dispatch" data-subscribe-form>
          <form class="hc-footer__form" data-subscribe-form-el>
            <label for="footer-dispatch-email" class="sr-only">Email address</label>
            <div class="hc-footer__input-row">
              <input type="email" id="footer-dispatch-email" name="email" placeholder="Enter your email address" required autocomplete="email" inputmode="email" class="hc-footer__input" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
              <button type="submit" class="hc-footer__submit" aria-label="Subscribe to blog updates"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3 12h17m-7-7 7 7-7 7" /></svg></button>
            </div>
            <p class="hc-footer__status" data-subscribe-form-status role="status" aria-live="polite"></p>
          </form>
          <noscript><p class="hc-footer__fallback">Email signup requires JavaScript. <a href="/rss.xml">Follow the RSS feed</a> for new posts.</p></noscript>
        </div>
        <h3 class="hc-footer__label hc-footer__community-label">Join Our Community</h3>
        <nav class="hc-footer__social" aria-label="External channels">
          {channels.map((channel) => <a href={channel.href} aria-label={channel.name}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={channel.path}/></svg></a>)}
        </nav>
        <p class="hc-footer__community-note">Discussions <span>|</span> Updates <span>|</span> Research</p>
      </div>
    </div>
    <picture class="hc-footer__landscape" aria-hidden="true">
      <source srcset="/images/brand/footer-panorama-v1-1440.webp 1440w, /images/brand/footer-panorama-v1.webp 2172w" sizes="100vw" type="image/webp" />
      <img src="/images/brand/footer-panorama-v1.webp" width="2172" height="724" alt="" loading="lazy" decoding="async" />
    </picture>
    <div class="hc-footer__bottom">
      <span class="hc-footer__copyright">© {year} HadithCritic. All rights reserved.</span>
      <span class="hc-footer__bottom-rule" aria-hidden="true"><i></i></span>
      <nav class="hc-footer__legal-links" aria-label="Legal and utility links">
        <a href="/legal/">Privacy &amp; Terms</a><a href="/contact/">Contact</a><a href="/sitemap-index.xml">Sitemap</a><a href="#siteHeader" class="hc-footer__top">Back to top</a>
      </nav>
    </div>
  </div>
</footer>

<script>
  // Compact native disclosures on phones; no-script users keep every link visible.
  const footerMedia = window.matchMedia('(max-width: 640px)');
  const setFooterGroups = () => {
    document.querySelectorAll<HTMLDetailsElement>('[data-footer-group]').forEach(group => {
      group.open = !footerMedia.matches;
    });
  };
  setFooterGroups();
  footerMedia.addEventListener('change', setFooterGroups);

  // Subscription handler — preserves /api/subscribe contract
  document.querySelectorAll('.hc-footer__dispatch[data-subscribe-form]').forEach((container) => {
    const form = container.querySelector<HTMLFormElement>('[data-subscribe-form-el]');
    const status = container.querySelector<HTMLElement>('[data-subscribe-form-status]');
    if (!form || !status) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = data.get('email');
      const website = data.get('website');
      if (typeof email !== 'string' || !email) return;

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitButton) submitButton.disabled = true;
      status.textContent = '';
      status.className = 'hc-footer__status';

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website })
        });
        const result = (await response.json()) as { success: boolean; error?: string };

        if (result.success) {
          status.textContent = "You're on the blog update list. We'll email you when a new post is published.";
          status.classList.add('is-success');
          form.reset();
        } else {
          status.textContent = result.error || 'Subscription failed. Please try again.';
          status.classList.add('is-error');
        }
      } catch {
        status.textContent = 'Network error. Please try again.';
        status.classList.add('is-error');
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  });

</script>
