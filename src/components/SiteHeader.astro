---
---
<header class="site-header" id="siteHeader">
  <div class="wrap header-inner">
    <a href="/" class="header-brand">
      <img src="/geometric_emblem_transparent.png" alt="" class="header-emblem" />
      <span class="header-brand-name">HadithCritic</span>
    </a>

    <nav class="header-nav" aria-label="Main navigation">
      <a href="/blogs" class="hc-header-link">Blog</a>
      <a href="/academia" class="hc-header-link">Academia</a>
      <div class="header-dropdown">
        <a href="/projects" class="hc-header-link header-dropdown-trigger" aria-haspopup="true">
          Projects
          <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
        </a>
        <div class="header-dropdown-menu" role="menu" aria-label="Projects">
          <a href="/silsilah/" role="menuitem">
            <strong>Silsilah</strong>
            <span>Hadith database, 19 collections</span>
          </a>
          <a href="/studies/" role="menuitem">
            <strong>Common-Link Studies</strong>
            <span>Isnad scholarship, animated</span>
          </a>
          <a href="/rijal/" role="menuitem">
            <strong>Narrator Biographies</strong>
            <span>8,000+ transmitters of the six books</span>
          </a>
          <a href="/corpus-map/" role="menuitem">
            <strong>Corpus Mapping</strong>
            <span>Watch any report travel city to city</span>
          </a>
          <a href="/projects" role="menuitem">
            <strong>All projects</strong>
            <span>The full workbench</span>
          </a>
        </div>
      </div>
      <a href="/resources" class="hc-header-link">Resources</a>
      <a href="/youtube" class="hc-header-link">YouTube</a>
      <a href="/contact" class="hc-header-link">Contact</a>
    </nav>

    <div class="header-actions">
      <button class="header-search-btn" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </button>
      <a href="/reports" class="hc-btn hc-btn--ghost">Explore Reports</a>
      <button class="header-menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileNav">
        <span class="hamburger-line" aria-hidden="true"></span>
        <span class="hamburger-line" aria-hidden="true"></span>
        <span class="hamburger-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="header-mobile-nav" id="mobileNav" aria-hidden="true">
    <a href="/blogs" class="hc-header-link">Blog</a>
    <a href="/academia" class="hc-header-link">Academia</a>
    <a href="/projects" class="hc-header-link">Projects</a>
    <a href="/silsilah/" class="hc-header-link header-sublink">Silsilah Hadith Database</a>
    <a href="/studies/" class="hc-header-link header-sublink">Common-Link Studies</a>
    <a href="/rijal/" class="hc-header-link header-sublink">Narrator Biographies</a>
    <a href="/corpus-map/" class="hc-header-link header-sublink">Corpus Mapping</a>
    <a href="/resources" class="hc-header-link">Resources</a>
    <a href="/youtube" class="hc-header-link">YouTube</a>
    <a href="/contact" class="hc-header-link">Contact</a>
    <div class="header-actions-mobile">
      <a href="/reports" class="hc-btn hc-btn--ghost">Explore Reports</a>
    </div>
  </div>
</header>

<style>
/* ===== Header ===== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid var(--hc-rule);
  background: color-mix(in srgb, var(--hc-black) 90%, transparent);
  backdrop-filter: blur(14px) saturate(1.2);
  -webkit-backdrop-filter: blur(14px) saturate(1.2);
  transition: border-color 300ms ease, box-shadow 300ms ease, background 300ms ease;
}

.site-header.is-scrolled {
  border-color: var(--hc-rule-strong);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  background: color-mix(in srgb, var(--hc-black) 95%, transparent);
}

.header-inner {
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

/* Brand */
.header-brand {
  display: inline-flex;
  align-items: center;
  gap: 0.85rem;
  text-decoration: none;
  flex-shrink: 0;
}

.header-emblem {
  height: 32px;
  width: auto;
  object-fit: contain;
  filter: sepia(0.6) saturate(1.5) hue-rotate(350deg) brightness(0.95);
  transition: filter 300ms ease, transform 300ms ease;
}

.header-brand:hover .header-emblem {
  filter: sepia(0.4) saturate(2) hue-rotate(340deg) brightness(1.1);
  transform: scale(1.05) rotate(-3deg);
}

.header-brand-name {
  color: var(--hc-gold);
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  line-height: 1;
}

/* Desktop Nav */
.header-nav {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.header-nav .hc-header-link {
  position: relative;
  padding: 0.45rem 0.7rem;
  font-size: 0.76rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 500;
  color: rgba(242, 235, 220, 0.75);
  transition: color 250ms ease;
  text-decoration: none;
}

.header-nav .hc-header-link::after {
  content: '';
  position: absolute;
  bottom: 2px;
  left: 50%;
  width: calc(100% - 1.4rem);
  height: 1.5px;
  background: linear-gradient(90deg, transparent, var(--hc-gold), transparent);
  transform: translateX(-50%) scaleX(0);
  transition: transform 350ms var(--ease);
  opacity: 0.85;
}

.header-nav .hc-header-link:hover,
.header-nav .hc-header-link[aria-current="page"],
.header-nav .hc-header-link.is-active {
  color: var(--hc-gold);
}

.header-nav .hc-header-link:hover::after,
.header-nav .hc-header-link[aria-current="page"]::after,
.header-nav .hc-header-link.is-active::after {
  transform: translateX(-50%) scaleX(1);
}

/* Projects dropdown */
.header-dropdown {
  position: relative;
}

.header-dropdown-trigger {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.header-dropdown-trigger svg {
  transition: transform 250ms var(--ease);
}

.header-dropdown:hover .header-dropdown-trigger svg,
.header-dropdown:focus-within .header-dropdown-trigger svg {
  transform: rotate(180deg);
}

.header-dropdown-menu {
  position: absolute;
  top: calc(100% + 8px);
  left: 50%;
  transform: translate(-50%, -6px);
  min-width: 250px;
  padding: 0.45rem;
  border: 1px solid var(--hc-rule);
  border-radius: var(--radius-sm);
  background: linear-gradient(180deg, color-mix(in srgb, var(--hc-charcoal) 97%, transparent), color-mix(in srgb, var(--hc-black) 98%, transparent));
  backdrop-filter: blur(18px) saturate(1.2);
  -webkit-backdrop-filter: blur(18px) saturate(1.2);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 220ms ease, transform 220ms var(--ease), visibility 220ms;
  z-index: 60;
}

.header-dropdown-menu::before {
  content: "";
  position: absolute;
  top: -8px;
  left: 0;
  right: 0;
  height: 8px;
}

.header-dropdown:hover .header-dropdown-menu,
.header-dropdown:focus-within .header-dropdown-menu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translate(-50%, 0);
}

.header-dropdown-menu a {
  display: grid;
  gap: 0.15rem;
  padding: 0.6rem 0.75rem;
  border-radius: var(--radius-xs);
  text-decoration: none;
  transition: background 180ms ease;
}

.header-dropdown-menu a:hover {
  background: rgba(216, 177, 102, 0.08);
}

.header-dropdown-menu strong {
  color: var(--hc-parchment);
  font-family: var(--font-ui);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.header-dropdown-menu a:hover strong {
  color: var(--hc-gold);
}

.header-dropdown-menu span {
  color: var(--hc-ash);
  font-family: var(--font-ui);
  font-size: 0.7rem;
  letter-spacing: 0.02em;
}

.header-mobile-nav .header-sublink {
  font-size: 0.78rem;
  color: var(--hc-gold-dim);
}

/* Actions */
.header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.header-search-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 1px solid var(--hc-rule);
  border-radius: var(--radius-xs);
  background: rgba(216, 177, 102, 0.04);
  color: var(--hc-gold);
  cursor: pointer;
  transition: border-color 200ms ease, background 200ms ease, color 200ms ease;
}

.header-search-btn:hover {
  border-color: var(--hc-rule-strong);
  background: rgba(216, 177, 102, 0.1);
  color: var(--hc-gold-soft);
}

.header-search-btn svg {
  width: 16px;
  height: 16px;
}

/* Mobile toggle */
.header-menu-toggle {
  display: none;
  width: 36px;
  height: 36px;
  position: relative;
  background: none;
  border: 1px solid var(--hc-rule);
  border-radius: var(--radius-xs);
  padding: 0;
  cursor: pointer;
  color: var(--hc-gold);
  transition: border-color 200ms ease, background 200ms ease;
}

.header-menu-toggle:hover {
  border-color: var(--hc-rule-strong);
  background: rgba(216, 177, 102, 0.06);
}

.hamburger-line {
  display: block;
  width: 18px;
  height: 1.5px;
  background: currentColor;
  position: absolute;
  left: 8px;
  transition: all 300ms var(--ease);
}

.hamburger-line:nth-child(1) { top: 11px; }
.hamburger-line:nth-child(2) { top: 16px; }
.hamburger-line:nth-child(3) { top: 21px; }

.header-menu-toggle.is-open .hamburger-line:nth-child(1) {
  top: 16px;
  transform: rotate(45deg);
}
.header-menu-toggle.is-open .hamburger-line:nth-child(2) {
  opacity: 0;
  transform: scaleX(0);
}
.header-menu-toggle.is-open .hamburger-line:nth-child(3) {
  top: 16px;
  transform: rotate(-45deg);
}

/* Mobile Nav */
.header-mobile-nav {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, color-mix(in srgb, var(--hc-charcoal) 98%, transparent), color-mix(in srgb, var(--hc-black) 98%, transparent));
  backdrop-filter: blur(20px) saturate(1.2);
  -webkit-backdrop-filter: blur(20px) saturate(1.2);
  border-bottom: 1px solid var(--hc-rule);
  padding: 1.5rem var(--pad) 2.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: opacity 350ms ease, transform 350ms var(--ease), visibility 350ms;
  pointer-events: none;
}

.header-mobile-nav.is-open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.header-mobile-nav .hc-header-link {
  display: block;
  padding: 0.9rem 0;
  font-size: 0.9rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
  color: rgba(242, 235, 220, 0.8);
  border-bottom: 1px solid var(--hc-rule-soft);
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 300ms ease, transform 300ms var(--ease), color 200ms ease;
  width: 100%;
  max-width: 300px;
  text-decoration: none;
}

.header-mobile-nav.is-open .hc-header-link {
  opacity: 1;
  transform: translateY(0);
}

.header-mobile-nav .hc-header-link:nth-child(1) { transition-delay: 40ms; }
.header-mobile-nav .hc-header-link:nth-child(2) { transition-delay: 80ms; }
.header-mobile-nav .hc-header-link:nth-child(3) { transition-delay: 120ms; }
.header-mobile-nav .hc-header-link:nth-child(4) { transition-delay: 160ms; }
.header-mobile-nav .hc-header-link:nth-child(5) { transition-delay: 200ms; }
.header-mobile-nav .hc-header-link:nth-child(6) { transition-delay: 240ms; }

.header-mobile-nav .hc-header-link:hover,
.header-mobile-nav .hc-header-link[aria-current="page"] {
  color: var(--hc-gold);
}

.header-mobile-nav .hc-header-link:last-of-type {
  border-bottom: 0;
}

.header-mobile-nav .header-actions-mobile {
  display: flex;
  justify-content: center;
  margin-top: 1.5rem;
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 300ms ease, transform 300ms var(--ease);
  transition-delay: 280ms;
}

.header-mobile-nav.is-open .header-actions-mobile {
  opacity: 1;
  transform: translateY(0);
}

/* Responsive */
@media (max-width: 980px) {
  .header-nav {
    display: none;
  }
  .header-menu-toggle {
    display: block;
  }
  .header-search-btn {
    display: none;
  }
  .header-inner {
    min-height: 64px;
    gap: 1rem;
  }
  .header-brand-name {
    font-size: 1.3rem;
  }
  .header-emblem {
    height: 28px;
  }
}

@media (max-width: 640px) {
  .header-actions .hc-btn {
    display: none;
  }
  .header-inner {
    min-height: 60px;
  }
  .header-brand-name {
    font-size: 1.2rem;
  }
  .header-emblem {
    height: 26px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .site-header,
  .header-nav .hc-header-link,
  .header-nav .hc-header-link::after,
  .header-mobile-nav,
  .header-mobile-nav .hc-header-link,
  .hamburger-line,
  .header-emblem {
    transition: none !important;
  }
}
</style>

<script>
  (function() {
    const header = document.getElementById('siteHeader');
    const toggle = document.getElementById('menuToggle');
    const mobileNav = document.getElementById('mobileNav');
    
    // Scroll shadow
    function onScroll() {
      if (window.scrollY > 20) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    
    // Mobile toggle
    if (toggle && mobileNav) {
      toggle.addEventListener('click', function() {
        const isOpen = mobileNav.classList.toggle('is-open');
        toggle.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(isOpen));
        mobileNav.setAttribute('aria-hidden', String(!isOpen));
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });
      
      // Close on link click
      mobileNav.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', function() {
          mobileNav.classList.remove('is-open');
          toggle.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
          mobileNav.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        });
      });
    }
    
    // Close on resize to desktop
    window.addEventListener('resize', function() {
      if (window.innerWidth > 980 && mobileNav.classList.contains('is-open')) {
        mobileNav.classList.remove('is-open');
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    });
  })();
</script>
