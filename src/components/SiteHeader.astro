---
import ProjectNavigation from './ProjectNavigation.astro';
// Links carry the trailing slash the site is served at, but a page can be
// reached either way, so compare without it.
const pathname = Astro.url.pathname.replace(/(.)\/$/, '$1');
const links = [
  { href: '/blogs/', label: 'Blog', active: pathname === '/blogs' || pathname.startsWith('/blogs/') },
  { href: '/projects/', label: 'Projects', active: pathname === '/projects' },
  { href: '/resources/', label: 'Resources', active: pathname === '/resources' },
  { href: '/youtube/', label: 'YouTube', active: pathname === '/youtube' },
  { href: '/contact/', label: 'Contact', active: pathname === '/contact' }
];
---

<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <a href="/" class="header-brand" aria-label="HadithCritic home">
      <img src="/images/brand/geometric-emblem-96.webp" alt="" class="header-emblem" width="32" height="32" decoding="async" />
      <span class="header-brand-name">HadithCritic</span>
    </a>
    <nav class="header-nav" aria-label="Main navigation">
      {links.map((link) => (
        link.label === 'Projects' ? <ProjectNavigation /> :
        <a href={link.href} class="hc-header-link" aria-current={link.active ? 'page' : undefined}>
          <span class="hc-header-link__label">{link.label}</span>
          <span class="hc-header-link__indicator" aria-hidden="true"></span>
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="header-search-btn" type="button" data-search-trigger aria-label="Search HadithCritic archive">
        <svg class="header-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="header-search-label">Search</span>
        <kbd class="header-search-kbd" aria-hidden="true">
          <span class="header-search-kbd-mod">Ctrl</span>
          <span class="header-search-kbd-key">K</span>
        </kbd>
      </button>

      <a href="/#subscribe" class="header-subscribe" data-subscribe-trigger aria-haspopup="dialog">Subscribe</a>

      <button
        class="theme-toggle"
        id="themeToggle"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Toggle light and dark theme"
        title="Switch to light theme"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.6 6.6 0 0 0 10.7 10.7z"></path>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
        </svg>
      </button>

      <button class="header-menu-toggle" id="menuToggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileNav">
        <span class="hamburger-box" aria-hidden="true">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </span>
      </button>
    </div>
  </div>
</header>
<script is:inline>
  // Set the top-of-page state before first paint so the header never flashes
  // solid over the hero. Without JS the header simply stays solid.
  (function () {
    var header = document.getElementById('siteHeader');
    if (header && window.scrollY <= 20) header.classList.add('is-at-top');
  })();
</script>
<div class="mobile-nav-backdrop" id="mobileNavBackdrop" hidden></div>
<nav class="header-mobile-nav" id="mobileNav" aria-label="Mobile navigation" aria-hidden="true">
  <div class="mobile-nav-top">
    <div class="mobile-nav-brand">
      <img src="/images/brand/geometric-emblem-96.webp" alt="" class="mobile-nav-emblem" width="24" height="24" decoding="async" loading="lazy" />
      <span class="mobile-nav-title">Navigation</span>
    </div>
    <button class="mobile-nav-close-btn" id="mobileNavClose" type="button" aria-label="Close navigation menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <button class="mobile-search" type="button" data-search-trigger aria-label="Search HadithCritic">
    <span class="mobile-search-left">
      <svg class="mobile-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span>Search the archive</span>
    </span>
    <kbd class="mobile-search-kbd" aria-hidden="true">
      <span class="header-search-kbd-mod">Ctrl</span>
      <span class="header-search-kbd-key">K</span>
    </kbd>
  </button>
  <div class="mobile-nav-links">
    {links.map((link) => link.label === 'Projects' ? <ProjectNavigation mobile /> : <a href={link.href} class="hc-header-link" aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
    <a href="/#subscribe" class="hc-header-link" data-subscribe-trigger aria-haspopup="dialog">Subscribe by email</a>
  </div>
</nav>

<noscript>
  <style is:global>
    @media (max-width: 980px) {
      #siteHeader .header-inner { flex-wrap: wrap; padding-bottom: var(--space-2xs); }
      #siteHeader .header-nav { display: flex; flex-wrap: wrap; width: 100%; order: 3; }
      #siteHeader .header-menu-toggle { display: none; }
      #siteHeader .project-nav { position: static; }
      #siteHeader .project-nav__panel { position: absolute; left: 1rem; right: 1rem; top: 100%; width: auto; transform: none; }
      #siteHeader .project-nav__list { grid-template-columns: 1fr; max-height: 65vh; overflow-y: auto; }
    }
  </style>
</noscript>

<style>
  /* The bar is solid by default (and without JS). At the very top of the page
     it drops its ground and rule so it reads as part of whatever sits behind
     it, then returns once the reader scrolls. The rule is an inset shadow, not
     a border, so the bar's height is exactly --hc-header-h in both states. */
  .site-header {
    --hc-header-wrap: 1680px;
    --hc-header-gutter: clamp(1rem, 3vw, 3rem);
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(var(--hc-scrim), 0.88);
    box-shadow: inset 0 -1px 0 var(--hc-rule);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  /* Transitions start only after the first paint, so a page that loads at
     the top never fades from solid to clear. */
  .site-header.is-ready {
    transition: box-shadow var(--motion-base) var(--ease-standard),
                background var(--motion-base) var(--ease-standard),
                backdrop-filter var(--motion-base) var(--ease-standard);
  }
  .site-header.is-scrolled {
    box-shadow: inset 0 -1px 0 var(--hc-rule-strong), var(--hc-header-shadow);
    background: rgba(var(--hc-scrim), 0.96);
  }
  .site-header.is-at-top {
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  /* Wider than the page's content measure, so the brand and the actions sit
     out toward the edges and the links have room to breathe. */
  .header-inner {
    display: flex;
    box-sizing: border-box;
    width: min(100%, var(--hc-header-wrap));
    min-height: 80px;
    margin-inline: auto;
    padding-inline: max(var(--hc-header-gutter), var(--sal)) max(var(--hc-header-gutter), var(--sar));
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  @media (max-width: 640px) {
    .site-header {
      --hc-header-gutter: 0.9rem;
    }
  }
  .header-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    flex: 0 0 auto;
    color: var(--hc-text-primary);
    text-decoration: none;
    transition: opacity var(--motion-fast) var(--ease-standard);
  }
  .header-emblem {
    width: 32px;
    height: 32px;
    object-fit: contain;
    transition: transform var(--motion-base) var(--ease-standard);
  }
  .header-brand-name {
    font: 600 clamp(1.45rem, 2.2vw, 1.6rem)/1 var(--font-editorial);
    letter-spacing: 0;
    transition: color var(--motion-fast) var(--ease-standard);
  }
  .header-brand:hover .header-emblem {
    transform: scale(1.05);
  }
  .header-brand:hover .header-brand-name {
    color: var(--hc-gold-bright);
  }
  .header-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3xs);
  }
  /* Links are rounded pills that shade on hover; the current section keeps a
     quieter shade so the reader can see where they are. */
  .hc-header-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 var(--space-sm);
    color: var(--hc-text-secondary);
    font: 500 var(--fs-base)/1 var(--font-ui);
    text-decoration: none;
    border-radius: 12px;
    transition: color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard);
  }
  .hc-header-link__indicator {
    display: none;
  }
  .hc-header-link:hover {
    color: var(--hc-text-primary);
    background: color-mix(in srgb, var(--hc-text-primary) 8%, transparent);
  }
  .hc-header-link[aria-current='page'] {
    color: var(--hc-text-primary);
    background: color-mix(in srgb, var(--hc-text-primary) 5%, transparent);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  /* Controls stay quiet: no frame or fill until the pointer is on them. The
     search bar is the one exception, a faint field so it reads as search. */
  .header-search-btn,
  .header-menu-toggle,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    min-width: 38px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--hc-text-secondary);
    font: 500 var(--fs-sm)/1 var(--font-ui);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--motion-fast) var(--ease-standard),
                background var(--motion-fast) var(--ease-standard),
                border-color var(--motion-fast) var(--ease-standard);
  }
  .header-search-btn:hover,
  .header-menu-toggle:hover,
  .theme-toggle:hover {
    color: var(--hc-text-primary);
    background: color-mix(in srgb, var(--hc-text-primary) 8%, transparent);
  }
  .header-search-btn:focus-visible,
  .header-menu-toggle:focus-visible,
  .theme-toggle:focus-visible,
  .header-subscribe:focus-visible {
    outline: 2px solid var(--hc-gold);
    outline-offset: 2px;
  }
  .mobile-search,
  .mobile-nav-close-btn {
    min-height: 36px;
    font: 500 var(--fs-sm)/1 var(--font-ui);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  /* Search bar */
  .header-search-btn {
    justify-content: flex-start;
    gap: 0.55rem;
    width: 13.5rem;
    padding: 0 0.45rem 0 0.75rem;
    border-color: color-mix(in srgb, var(--hc-text-primary) 9%, transparent);
    background: color-mix(in srgb, var(--hc-text-primary) 4%, transparent);
    color: var(--hc-text-tertiary);
  }
  .header-search-btn:hover {
    border-color: color-mix(in srgb, var(--hc-text-primary) 16%, transparent);
  }
  .header-search-icon {
    flex-shrink: 0;
    opacity: 0.8;
  }
  .header-search-label {
    flex: 1;
    text-align: left;
    letter-spacing: 0;
  }
  .header-search-kbd {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 0.22rem 0.4rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--hc-text-primary) 7%, transparent);
    color: var(--hc-text-tertiary);
    font: 500 var(--fs-xs)/1 var(--font-ui);
    letter-spacing: 0.02em;
  }

  /* Theme switch: one glyph, the theme the reader is in. */
  .theme-toggle {
    position: relative;
  }
  .theme-toggle__icon {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: transform 320ms var(--ease-standard), opacity 200ms ease;
  }
  .theme-toggle__icon--sun {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }
  :global([data-theme="light"]) .theme-toggle__icon--moon {
    opacity: 0;
    transform: rotate(60deg) scale(0.6);
  }
  :global([data-theme="light"]) .theme-toggle__icon--sun {
    opacity: 1;
    transform: none;
  }

  /* Mobile menu button */
  .header-menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    min-width: 40px;
    padding: 0;
    place-content: center;
  }
  .hamburger-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-3xs);
    width: 18px;
    height: 14px;
  }
  .hamburger-line {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform var(--motion-fast) var(--ease-standard),
                opacity var(--motion-fast) var(--ease-standard);
  }
  .header-menu-toggle.is-open .hamburger-line:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .header-menu-toggle.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .header-menu-toggle.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  .mobile-nav-backdrop {
    position: fixed;
    z-index: 99;
    inset: 0;
    background: rgba(7, 7, 8, 0.68);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .header-mobile-nav {
    display: none;
  }

  /* The menu leaves the shortcut hint off; Ctrl K still opens search. */
  .mobile-search-kbd {
    display: none;
  }

  /* One highlighted action, as the bar's last word before the theme switch. */
  .header-subscribe {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 var(--space-sm);
    border-radius: 10px;
    background: var(--hc-gold);
    color: var(--hc-text-inverse);
    font: 500 var(--fs-sm)/1 var(--font-ui);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--motion-fast) var(--ease-standard);
  }
  .header-subscribe:hover {
    background: var(--hc-gold-bright);
  }

  /* Between the mobile menu and a wide window the links need the room, so
     search shrinks to its icon and Subscribe moves into the menu. */
  @media (max-width: 1200px) {
    .header-search-label,
    .header-subscribe {
      display: none;
    }
    .header-search-btn {
      width: 40px;
      padding: 0;
      justify-content: center;
    }
  }

  @media (max-width: 980px) {
    .header-nav,
    .header-search-btn {
      display: none;
    }
    .header-menu-toggle {
      display: grid;
    }
    .header-mobile-nav {
      position: fixed;
      z-index: 100;
      top: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
      width: min(24rem, calc(100vw - 1.5rem));
      padding: max(1.25rem, var(--safe-top)) 1.25rem max(1.5rem, var(--safe-bottom));
      border-left: 1px solid var(--hc-rule-strong);
      background: var(--hc-surface-1);
      box-shadow: -12px 0 40px rgba(0, 0, 0, 0.75);
      transform: translateX(102%);
      visibility: hidden;
      transition: transform var(--motion-slow) var(--ease-emphasis),
                  visibility 0s linear var(--motion-slow);
    }
    .header-mobile-nav.is-open {
      transform: translateX(0);
      visibility: visible;
      transition-delay: 0s;
    }
    .mobile-nav-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: var(--space-xs);
      border-bottom: 1px solid var(--hc-rule);
    }
    .mobile-nav-brand {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
    }
    .mobile-nav-emblem {
      width: 24px;
      height: 24px;
      object-fit: contain;
    }
    .mobile-nav-title {
      font-family: var(--font-editorial);
      font-size: var(--fs-lg);
      font-weight: 600;
      letter-spacing: 0;
      color: var(--hc-text-primary);
    }
    .mobile-nav-close-btn {
      display: grid;
      width: 40px;
      height: 40px;
      min-width: 40px;
      place-content: center;
      border-radius: var(--radius-xs);
      border: 1px solid var(--hc-rule);
      color: var(--hc-text-secondary);
      background: var(--hc-surface-2);
      cursor: pointer;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      transition: color 160ms ease, border-color 160ms ease;
    }
    .mobile-nav-close-btn:hover,
    .mobile-nav-close-btn:active {
      color: var(--hc-gold);
      border-color: var(--hc-gold-dim);
    }
    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    .header-mobile-nav .hc-header-link {
      display: flex;
      flex-direction: row;
      justify-content: flex-start;
      width: 100%;
      min-height: 48px;
      align-items: center;
      padding: var(--space-xs) var(--space-2xs);
      border-bottom: 1px solid var(--hc-rule-soft);
      font-size: var(--fs-base);
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .header-mobile-nav .hc-header-link__indicator {
      display: none;
    }
    .mobile-search {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: var(--space-xs) var(--space-xs);
      color: var(--hc-text-secondary);
      background: var(--hc-surface-2);
      border: 1px solid var(--hc-rule);
      border-radius: var(--radius-xs);
      text-align: left;
      cursor: pointer;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .mobile-search:hover,
    .mobile-search:active {
      border-color: var(--hc-gold-dim);
      color: var(--hc-text-primary);
      background: var(--hc-surface-3);
    }
    .mobile-search-left {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
    }
    .mobile-search-icon {
      color: var(--hc-gold);
      flex-shrink: 0;
    }
    .mobile-search-kbd {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      padding: 0.15rem var(--space-3xs);
      border: 1px solid var(--hc-rule-soft);
      border-radius: 2px;
      background: var(--hc-surface-1);
      color: var(--hc-gold-soft);
      font: 600 var(--fs-xs)/1 var(--font-ui);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .hc-header-link__indicator,
    .header-mobile-nav,
    .hamburger-line,
    .theme-toggle,
    .theme-toggle__icon {
      transition: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('#siteHeader');
  const toggle = document.querySelector<HTMLButtonElement>('#menuToggle');
  const closeBtn = document.querySelector<HTMLButtonElement>('#mobileNavClose');
  const menu = document.querySelector<HTMLElement>('#mobileNav');
  const backdrop = document.querySelector<HTMLElement>('#mobileNavBackdrop');
  const mainContent = document.querySelector<HTMLElement>('#main-content');
  const footer = document.querySelector<HTMLElement>('.site-footer');
  let scrollY = 0;
  const onScroll = () => {
    const scrolled = window.scrollY > 20;
    header?.classList.toggle('is-scrolled', scrolled);
    header?.classList.toggle('is-at-top', !scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  requestAnimationFrame(() => requestAnimationFrame(() => header?.classList.add('is-ready')));

  const setMenu = (open: boolean, returnFocus = false) => {
    if (!toggle || !menu || !backdrop) return;
    if (open) {
      scrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      mainContent?.setAttribute('inert', '');
      footer?.setAttribute('inert', '');
      menu.classList.add('is-open');
      toggle.classList.add('is-open');
      backdrop.classList.add('is-open');
      backdrop.hidden = false;
      menu.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      menu.querySelector<HTMLElement>('a, button')?.focus();
    } else {
      menu.classList.remove('is-open');
      toggle.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      backdrop.hidden = true;
      menu.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      mainContent?.removeAttribute('inert');
      footer?.removeAttribute('inert');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      window.scrollTo(0, scrollY);
      if (returnFocus) toggle.focus();
    }
  };

  toggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
  closeBtn?.addEventListener('click', () => setMenu(false, true));
  backdrop?.addEventListener('click', () => setMenu(false, true));
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.classList.contains('is-open')) setMenu(false, true);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 980 && menu?.classList.contains('is-open')) setMenu(false);
  });
  document.querySelectorAll<HTMLElement>('[data-search-trigger]').forEach((button) =>
    button.addEventListener('click', () => {
      setMenu(false);
      document.dispatchEvent(new CustomEvent('hc:search-open', { detail: button }));
    })
  );

  const themeToggle = document.querySelector<HTMLButtonElement>('#themeToggle');
  const updateToggleAria = (theme: string) => {
    if (themeToggle) {
      const isLight = theme === 'light';
      themeToggle.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
      themeToggle.setAttribute('title', isLight ? 'Switch to dark theme' : 'Switch to light theme');
      themeToggle.setAttribute('aria-checked', isLight ? 'true' : 'false');
    }
  };
  const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
  updateToggleAria(currentTheme);

  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch { /* The current page still changes theme. */ }
    updateToggleAria(next);
  });

  // Show the platform's text keyboard shortcut without a command glyph.
  const isMac = typeof navigator !== 'undefined' && /Mac|iPhone|iPad|iPod/i.test(navigator.userAgent);
  if (isMac) {
    document.querySelectorAll('.header-search-kbd-mod').forEach((el) => {
      el.textContent = 'Command';
    });
  }
</script>

