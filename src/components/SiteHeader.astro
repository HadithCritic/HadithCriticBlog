---
const pathname = Astro.url.pathname;
const links = [
  { href: '/blogs', label: 'Blog', active: pathname === '/blogs' || pathname.startsWith('/blogs/') },
  { href: '/academia', label: 'Academia', active: pathname === '/academia' },
  { href: '/projects', label: 'Projects', active: pathname === '/projects' },
  { href: '/resources', label: 'Resources', active: pathname === '/resources' },
  { href: '/youtube', label: 'YouTube', active: pathname === '/youtube' },
  { href: '/contact', label: 'Contact', active: pathname === '/contact' }
];
---

<header class="site-header" id="siteHeader">
  <div class="wrap header-inner">
    <a href="/" class="header-brand" aria-label="HadithCritic home">
      <img src="/images/brand/geometric_emblem_transparent.png" alt="" class="header-emblem" />
      <span class="header-brand-name">HadithCritic</span>
    </a>
    <nav class="header-nav" aria-label="Main navigation">
      {links.map((link) => <a href={link.href} class="hc-header-link" aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <button class="header-search-btn" type="button" data-search-trigger aria-label="Search HadithCritic"><span aria-hidden="true">Search</span><kbd>Ctrl K</kbd></button>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle light and dark theme">
        <svg class="theme-toggle__icon theme-toggle__icon--sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path></svg>
      </button>
      <button class="header-menu-toggle" id="menuToggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileNav"><span class="hamburger-line"></span><span class="hamburger-line"></span><span class="hamburger-line"></span></button>
    </div>
  </div>

  <div class="mobile-nav-backdrop" id="mobileNavBackdrop" hidden></div>

  <nav class="header-mobile-nav" id="mobileNav" aria-label="Mobile navigation" aria-hidden="true">
    <div class="mobile-nav-header">
      <div class="mobile-nav-header__brand">
        <span class="mobile-nav-header__diamond" aria-hidden="true">❖</span>
        <span class="mobile-nav-header__title">Navigation</span>
      </div>
      <button class="mobile-nav-close" id="mobileNavClose" type="button" aria-label="Close navigation menu">
        <span class="mobile-nav-close__icon" aria-hidden="true">✕</span>
        <span class="mobile-nav-close__text">Close</span>
      </button>
    </div>

    <div class="mobile-nav-body">
      <button class="mobile-search" type="button" data-search-trigger aria-label="Search HadithCritic">
        <span class="mobile-search__text">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <span>Search the archive</span>
        </span>
        <kbd class="mobile-search__kbd">Ctrl K</kbd>
      </button>

      <div class="mobile-nav-links">
        {links.map((link) => (
          <a href={link.href} class="mobile-nav-link" aria-current={link.active ? 'page' : undefined}>
            <span class="mobile-nav-link__label">{link.label}</span>
            <span class="mobile-nav-link__arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mobile-nav-footer">
      <button class="mobile-nav-theme-btn" id="mobileThemeToggle" type="button" aria-label="Toggle light and dark theme">
        <span class="mobile-nav-theme-left">
          <svg class="theme-toggle__icon theme-toggle__icon--sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
          <svg class="theme-toggle__icon theme-toggle__icon--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path></svg>
          <span class="mobile-nav-theme-text" id="mobileThemeStatus">Theme</span>
        </span>
        <span class="mobile-nav-theme-switch" aria-hidden="true">Switch</span>
      </button>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--hc-rule);
    background: var(--hc-surface-0);
    transition: transform var(--motion-base) var(--ease-standard), border-color var(--motion-base) var(--ease-standard), box-shadow var(--motion-base) var(--ease-standard);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .site-header.is-scrolled {
    border-color: var(--hc-rule-strong);
    box-shadow: var(--hc-header-shadow);
  }
  .header-inner {
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-top: var(--safe-top);
  }
  .header-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex: 0 0 auto;
    color: var(--hc-text-primary);
    text-decoration: none;
  }
  .header-emblem {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }
  .header-brand-name {
    font: 600 clamp(1.2rem, 2vw, 1.5rem)/1 var(--font-display);
    letter-spacing: -0.02em;
  }
  .header-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.7rem, 1.7vw, 1.55rem);
  }
  .hc-header-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--hc-text-secondary);
    font: 700 0.76rem/1 var(--font-ui);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .hc-header-link::after {
    position: absolute;
    bottom: 4px;
    left: 0;
    width: 100%;
    height: 1px;
    content: '';
    background: var(--hc-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-base) var(--ease-standard);
  }
  .hc-header-link:hover,
  .hc-header-link[aria-current='page'] {
    color: var(--hc-text-primary);
  }
  .hc-header-link[aria-current='page']::after,
  .hc-header-link:hover::after {
    transform: scaleX(1);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .header-search-btn,
  .header-menu-toggle,
  .theme-toggle,
  .mobile-search {
    min-height: 44px;
    border: 1px solid var(--hc-rule);
    color: var(--hc-text-secondary);
    background: transparent;
    font: 700 0.73rem/1 var(--font-ui);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .theme-toggle {
    display: grid;
    width: 44px;
    place-content: center;
  }
  .theme-toggle:hover {
    color: var(--hc-text-primary);
    border-color: var(--hc-rule-strong);
  }
  .theme-toggle__icon--sun {
    display: none;
  }
  [data-theme="light"] .theme-toggle__icon--sun {
    display: block;
  }
  [data-theme="light"] .theme-toggle__icon--moon {
    display: none;
  }
  .header-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.65rem;
  }
  .header-search-btn kbd {
    padding: 0.18rem 0.32rem;
    border: 1px solid var(--hc-rule-soft);
    color: var(--hc-gold-soft);
    font: inherit;
  }
  .header-menu-toggle {
    display: none;
    width: 44px;
    padding: 0;
    place-content: center;
    gap: 4px;
  }
  .hamburger-line {
    display: block;
    width: 18px;
    height: 1px;
    background: currentColor;
    transition: transform var(--motion-fast) var(--ease-standard), opacity var(--motion-fast) var(--ease-standard);
  }
  .header-menu-toggle.is-open .hamburger-line:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  .header-menu-toggle.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .header-menu-toggle.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  .mobile-nav-backdrop {
    position: fixed;
    z-index: 98;
    inset: 0;
    background: rgba(7, 7, 8, 0.72);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--motion-base) var(--ease-standard), visibility var(--motion-base);
  }
  .mobile-nav-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .header-mobile-nav {
    display: none;
  }

  :global(:focus-visible) {
    outline: 2px solid var(--hc-gold-bright);
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .header-nav,
    .header-search-btn {
      display: none;
    }
    .header-menu-toggle {
      display: grid;
    }

    .header-mobile-nav {
      position: fixed;
      z-index: 99;
      top: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      width: min(24rem, 100vw);
      height: 100vh;
      height: 100dvh;
      border-left: 1px solid var(--hc-rule);
      background: var(--hc-surface-1);
      transform: translateX(102%);
      visibility: hidden;
      box-shadow: -10px 0 40px rgba(0, 0, 0, 0.6);
      overscroll-behavior: contain;
      transition: transform var(--motion-slow) var(--ease-emphasis), visibility 0s linear var(--motion-slow);
    }

    .header-mobile-nav.is-open {
      transform: translateX(0);
      visibility: visible;
      transition-delay: 0s;
    }

    /* Mobile Drawer Header with Exit Button */
    .mobile-nav-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 56px;
      padding: max(0.9rem, var(--sat, var(--safe-top, 0px))) 1.25rem 0.9rem;
      border-bottom: 1px solid var(--hc-rule);
      background: var(--hc-surface-2);
    }

    .mobile-nav-header__brand {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--hc-gold);
      font-family: var(--font-ui);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .mobile-nav-header__diamond {
      font-size: 0.85rem;
      line-height: 1;
    }

    .mobile-nav-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      min-height: 44px;
      min-width: 44px;
      padding: 0.4rem 0.75rem;
      border: 1px solid var(--hc-rule);
      border-radius: var(--radius-xs, 4px);
      background: rgba(216, 177, 102, 0.08);
      color: var(--hc-text-primary);
      font-family: var(--font-ui);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
    }

    .mobile-nav-close:hover,
    .mobile-nav-close:focus-visible {
      color: var(--hc-gold-bright);
      border-color: var(--hc-gold);
      background: rgba(216, 177, 102, 0.18);
    }

    .mobile-nav-close__icon {
      font-size: 1rem;
      line-height: 1;
    }

    /* Mobile Drawer Body */
    .mobile-nav-body {
      flex: 1 1 auto;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 1.25rem 1.25rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .mobile-search {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 48px;
      padding: 0.75rem 1rem;
      border: 1px solid var(--hc-rule);
      border-radius: var(--radius-xs, 4px);
      background: rgba(242, 235, 220, 0.03);
      color: var(--hc-gold-soft);
      text-align: left;
      transition: border-color 180ms ease, background 180ms ease;
    }

    .mobile-search:hover,
    .mobile-search:focus-visible {
      border-color: var(--hc-gold);
      background: rgba(216, 177, 102, 0.08);
    }

    .mobile-search__text {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-family: var(--font-ui);
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .mobile-search__kbd {
      padding: 0.15rem 0.35rem;
      border: 1px solid var(--hc-rule-soft);
      border-radius: 3px;
      color: var(--hc-text-tertiary);
      font-size: 0.68rem;
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .mobile-nav-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 48px;
      padding: 0.75rem 0.85rem;
      border-bottom: 1px solid var(--hc-rule-soft);
      border-radius: var(--radius-xs, 4px);
      color: var(--hc-text-secondary);
      font-family: var(--font-ui);
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-decoration: none;
      text-transform: uppercase;
      transition: color 180ms ease, background 180ms ease, padding-left 180ms ease;
    }

    .mobile-nav-link:hover,
    .mobile-nav-link:focus-visible {
      color: var(--hc-text-primary);
      background: rgba(216, 177, 102, 0.06);
      padding-left: 1.1rem;
    }

    .mobile-nav-link[aria-current='page'] {
      color: var(--hc-gold-bright);
      background: rgba(216, 177, 102, 0.1);
      border-left: 3px solid var(--hc-gold);
    }

    .mobile-nav-link__arrow {
      color: var(--hc-gold-dim);
      font-size: 1rem;
      transition: transform 180ms ease, color 180ms ease;
    }

    .mobile-nav-link:hover .mobile-nav-link__arrow,
    .mobile-nav-link[aria-current='page'] .mobile-nav-link__arrow {
      color: var(--hc-gold);
      transform: translateX(3px);
    }

    /* Mobile Drawer Footer */
    .mobile-nav-footer {
      flex: 0 0 auto;
      padding: 1rem 1.25rem max(1.5rem, var(--sab, var(--safe-bottom, 0px)));
      border-top: 1px solid var(--hc-rule);
      background: var(--hc-surface-2);
    }

    .mobile-nav-theme-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 44px;
      padding: 0.65rem 0.9rem;
      border: 1px solid var(--hc-rule);
      border-radius: var(--radius-xs, 4px);
      background: transparent;
      color: var(--hc-text-secondary);
      cursor: pointer;
      font-family: var(--font-ui);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: border-color 180ms ease, color 180ms ease, background 180ms ease;
    }

    .mobile-nav-theme-btn:hover,
    .mobile-nav-theme-btn:focus-visible {
      color: var(--hc-text-primary);
      border-color: var(--hc-rule-strong);
      background: rgba(216, 177, 102, 0.08);
    }

    .mobile-nav-theme-left {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
    }

    .mobile-nav-theme-switch {
      color: var(--hc-gold);
      font-size: 0.72rem;
      font-weight: 700;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .hc-header-link::after,
    .header-mobile-nav,
    .hamburger-line,
    .mobile-nav-link,
    .mobile-nav-link__arrow {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('#siteHeader');
  const toggle = document.querySelector<HTMLButtonElement>('#menuToggle');
  const closeBtn = document.querySelector<HTMLButtonElement>('#mobileNavClose');
  const menu = document.querySelector<HTMLElement>('#mobileNav');
  const backdrop = document.querySelector<HTMLElement>('#mobileNavBackdrop');
  const themeToggle = document.querySelector<HTMLButtonElement>('#themeToggle');
  const mobileThemeToggle = document.querySelector<HTMLButtonElement>('#mobileThemeToggle');
  const mobileThemeStatus = document.querySelector<HTMLElement>('#mobileThemeStatus');

  let scrollY = 0;
  let lastScrollY = window.scrollY;
  const onScroll = () => {
    const currentY = window.scrollY;
    header?.classList.toggle('is-scrolled', currentY > 20);

    if (!menu?.classList.contains('is-open')) {
      const diff = currentY - lastScrollY;
      if (currentY > 90 && diff > 8) {
        header?.classList.add('is-hidden');
      } else if (diff < -6 || currentY <= 60) {
        header?.classList.remove('is-hidden');
      }
    }
    lastScrollY = currentY;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const updateThemeStatus = () => {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    if (mobileThemeStatus) {
      mobileThemeStatus.textContent = isLight ? 'Light Theme' : 'Dark Theme';
    }
  };
  updateThemeStatus();

  const toggleTheme = () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateThemeStatus();
  };

  themeToggle?.addEventListener('click', toggleTheme);
  mobileThemeToggle?.addEventListener('click', toggleTheme);

  const getInertTargets = () => {
    return document.querySelectorAll<HTMLElement>('#main-content, #site-footer, main, footer');
  };

  const setMenu = (open: boolean, returnFocus = false) => {
    if (!toggle || !menu || !backdrop) return;
    const inertTargets = getInertTargets();
    if (open) {
      header?.classList.remove('is-hidden');
      scrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      inertTargets.forEach((el) => el.setAttribute('inert', ''));
      menu.classList.add('is-open');
      toggle.classList.add('is-open');
      backdrop.classList.add('is-open');
      backdrop.hidden = false;
      menu.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close navigation menu');
      setTimeout(() => {
        if (closeBtn) {
          closeBtn.focus();
        } else {
          menu.querySelector<HTMLElement>('a, button')?.focus();
        }
      }, 50);
    } else {
      menu.classList.remove('is-open');
      toggle.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      backdrop.hidden = true;
      menu.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      inertTargets.forEach((el) => el.removeAttribute('inert'));
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      window.scrollTo(0, scrollY);
      if (returnFocus) toggle.focus();
    }
  };

  toggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
  closeBtn?.addEventListener('click', () => setMenu(false, true));
  backdrop?.addEventListener('click', () => setMenu(false, true));
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.classList.contains('is-open')) {
      setMenu(false, true);
    }
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 980 && menu?.classList.contains('is-open')) {
      setMenu(false);
    }
  });
  document.querySelectorAll<HTMLElement>('[data-search-trigger]').forEach((button) =>
    button.addEventListener('click', () => {
      setMenu(false);
      document.dispatchEvent(new CustomEvent('hc:search-open', { detail: button }));
    })
  );
</script>
