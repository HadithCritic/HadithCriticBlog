---
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="header-brand">
      <!-- Use the existing transparent emblem or an inline SVG -->
      <img src="/geometric_emblem_transparent.png" alt="" class="header-emblem" />
      <span class="header-brand-name">HadithCritic</span>
    </a>

    <nav class="header-nav" aria-label="Main navigation">
      <a href="/reports">Reports</a>
      <a href="/blogs">Blog</a>
      <a href="/academia">Academia</a>
      <a href="/projects">Projects</a>
      <a href="/resources">Resources</a>
      <a href="/youtube">YouTube</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>

    <div class="header-actions">
      <!-- Optional: Search icon or explore button -->
      <a href="/reports" class="btn btn-outline">Explore Reports</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--hc-rule);
    background: color-mix(in srgb, var(--hc-black) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
  }

  .header-emblem {
    height: 32px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) saturate(100%) invert(80%) sepia(35%) saturate(546%) hue-rotate(345deg) brightness(88%) contrast(92%); /* Try to tint it gold-ish, or just use CSS mask */
  }

  .header-brand-name {
    color: var(--hc-gold);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header-nav a {
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .header-nav a:hover {
    color: var(--hc-gold);
  }

  .btn-outline {
    font-size: 0.85rem;
    padding: 0.4rem 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-ui);
  }

  @media (max-width: 980px) {
    .header-nav {
      display: none; /* Add mobile menu later */
    }
  }
</style>
