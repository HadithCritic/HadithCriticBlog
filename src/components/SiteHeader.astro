---
const pathname = Astro.url.pathname;
const links = [
  { href: '/blogs', label: 'Blog', active: pathname === '/blogs' || pathname.startsWith('/blogs/') },
  { href: '/academia', label: 'Academia', active: pathname === '/academia' },
  { href: '/projects', label: 'Projects', active: pathname === '/projects' },
  { href: '/resources', label: 'Resources', active: pathname === '/resources' },
  { href: '/youtube', label: 'YouTube', active: pathname === '/youtube' },
  { href: '/contact', label: 'Contact', active: pathname === '/contact' }
];
---

<header class="site-header" id="siteHeader">
  <div class="wrap header-inner">
    <a href="/" class="header-brand" aria-label="HadithCritic home">
      <img src="/images/brand/geometric_emblem_transparent.png" alt="" class="header-emblem" />
      <span class="header-brand-name">HadithCritic</span>
    </a>
    <nav class="header-nav" aria-label="Main navigation">
      {links.map((link) => <a href={link.href} class="hc-header-link" aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <button class="header-search-btn" type="button" data-search-trigger aria-label="Search HadithCritic"><span aria-hidden="true">Search</span><kbd>Ctrl K</kbd></button>
      <button class="header-menu-toggle" id="menuToggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileNav"><span class="hamburger-line"></span><span class="hamburger-line"></span><span class="hamburger-line"></span></button>
    </div>
  </div>
  <div class="mobile-nav-backdrop" id="mobileNavBackdrop" hidden></div>
  <nav class="header-mobile-nav" id="mobileNav" aria-label="Mobile navigation" aria-hidden="true">
    <button class="mobile-search" type="button" data-search-trigger aria-label="Search HadithCritic">Search the archive <span aria-hidden="true">Ctrl K</span></button>
    {links.map((link) => <a href={link.href} class="hc-header-link" aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--hc-rule); background: var(--hc-surface-0); transition: border-color var(--motion-base) var(--ease-standard), box-shadow var(--motion-base) var(--ease-standard); }
  .site-header.is-scrolled { border-color: var(--hc-rule-strong); box-shadow: var(--hc-header-shadow); }
  .header-inner { display: flex; min-height: 72px; align-items: center; justify-content: space-between; gap: 1.25rem; padding-top: var(--safe-top); }
  .header-brand { display: inline-flex; align-items: center; gap: .75rem; flex: 0 0 auto; color: var(--hc-text-primary); text-decoration: none; }
  .header-emblem { width: 32px; height: 32px; object-fit: contain; } .header-brand-name { font: 600 clamp(1.2rem, 2vw, 1.5rem)/1 var(--font-display); letter-spacing: -.02em; }
  .header-nav { display: flex; align-items: center; justify-content: center; gap: clamp(.7rem, 1.7vw, 1.55rem); }
  .hc-header-link { position: relative; display: inline-flex; align-items: center; min-height: 44px; color: var(--hc-text-secondary); font: 700 .76rem/1 var(--font-ui); letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .hc-header-link::after { position: absolute; bottom: 4px; left: 0; width: 100%; height: 1px; content: ''; background: var(--hc-gold); transform: scaleX(0); transform-origin: left; transition: transform var(--motion-base) var(--ease-standard); }
  .hc-header-link:hover, .hc-header-link[aria-current='page'] { color: var(--hc-text-primary); }.hc-header-link[aria-current='page']::after, .hc-header-link:hover::after { transform: scaleX(1); }
  .header-actions { display: flex; align-items: center; gap: .5rem; }.header-search-btn, .header-menu-toggle, .mobile-search { min-height: 44px; border: 1px solid var(--hc-rule); color: var(--hc-text-secondary); background: transparent; font: 700 .73rem/1 var(--font-ui); letter-spacing: .07em; text-transform: uppercase; cursor: pointer; }
  .header-search-btn { display: inline-flex; align-items: center; gap: .55rem; padding: .55rem .65rem; }.header-search-btn kbd { padding: .18rem .32rem; border: 1px solid var(--hc-rule-soft); color: var(--hc-gold-soft); font: inherit; }
  .header-menu-toggle { display: none; width: 44px; padding: 0; place-content: center; gap: 4px; }.hamburger-line { display: block; width: 18px; height: 1px; background: currentColor; transition: transform var(--motion-fast) var(--ease-standard), opacity var(--motion-fast) var(--ease-standard); }.header-menu-toggle.is-open .hamburger-line:nth-child(1) { transform: translateY(5px) rotate(45deg); }.header-menu-toggle.is-open .hamburger-line:nth-child(2) { opacity: 0; }.header-menu-toggle.is-open .hamburger-line:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }
  .mobile-nav-backdrop { position: fixed; z-index: 48; inset: 0; background: rgba(7,7,8,.68); }.header-mobile-nav { display: none; }
  :global(:focus-visible) { outline: 2px solid var(--hc-gold-bright); outline-offset: 3px; }
  @media (max-width: 980px) { .header-nav, .header-search-btn { display: none; }.header-menu-toggle { display: grid; }.header-mobile-nav { position: fixed; z-index: 49; top: 0; right: 0; bottom: 0; display: grid; align-content: start; gap: .15rem; width: min(24rem, calc(100vw - 2.5rem)); padding: max(5.75rem, calc(3rem + var(--safe-top))) 1.25rem max(1.5rem, var(--safe-bottom)); border-left: 1px solid var(--hc-rule); background: var(--hc-surface-1); transform: translateX(102%); visibility: hidden; transition: transform var(--motion-slow) var(--ease-emphasis), visibility 0s linear var(--motion-slow); }.header-mobile-nav.is-open { transform: translateX(0); visibility: visible; transition-delay: 0s; }.header-mobile-nav .hc-header-link { padding: .7rem 0; border-bottom: 1px solid var(--hc-rule-soft); font-size: .85rem; }.mobile-search { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-bottom: .75rem; padding: .6rem .75rem; color: var(--hc-gold-soft); text-align: left; }.mobile-search span { color: var(--hc-text-tertiary); font-size: .68rem; } }
  @media (prefers-reduced-motion: reduce) { .site-header, .hc-header-link::after, .header-mobile-nav, .hamburger-line { transition: none; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('#siteHeader');
  const toggle = document.querySelector<HTMLButtonElement>('#menuToggle');
  const menu = document.querySelector<HTMLElement>('#mobileNav');
  const backdrop = document.querySelector<HTMLElement>('#mobileNavBackdrop');
  const shell = document.querySelector<HTMLElement>('.site-shell');
  let scrollY = 0;
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 20);
  window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
  const setMenu = (open: boolean, returnFocus = false) => {
    if (!toggle || !menu || !backdrop) return;
    if (open) { scrollY = window.scrollY; document.body.style.position = 'fixed'; document.body.style.top = `-${scrollY}px`; document.body.style.width = '100%'; shell?.setAttribute('inert', ''); menu.classList.add('is-open'); toggle.classList.add('is-open'); backdrop.hidden = false; menu.setAttribute('aria-hidden', 'false'); toggle.setAttribute('aria-expanded', 'true'); menu.querySelector<HTMLElement>('a, button')?.focus(); }
    else { menu.classList.remove('is-open'); toggle.classList.remove('is-open'); backdrop.hidden = true; menu.setAttribute('aria-hidden', 'true'); toggle.setAttribute('aria-expanded', 'false'); shell?.removeAttribute('inert'); document.body.style.position = ''; document.body.style.top = ''; document.body.style.width = ''; window.scrollTo(0, scrollY); if (returnFocus) toggle.focus(); }
  };
  toggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
  backdrop?.addEventListener('click', () => setMenu(false, true));
  menu?.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) setMenu(false); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu?.classList.contains('is-open')) setMenu(false, true); });
  window.addEventListener('resize', () => { if (window.innerWidth > 980 && menu?.classList.contains('is-open')) setMenu(false); });
  document.querySelectorAll<HTMLElement>('[data-search-trigger]').forEach((button) => button.addEventListener('click', () => { setMenu(false); document.dispatchEvent(new CustomEvent('hc:search-open', { detail: button })); }));
</script>
