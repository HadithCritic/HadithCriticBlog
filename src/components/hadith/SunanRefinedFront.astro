---
import fs from 'node:fs';
import path from 'node:path';
import SubscribeForm from '../SubscribeForm.astro';

const html = fs.readFileSync(
  path.resolve(process.cwd(), 'src/data/hadith/pages/sunan-ibn-majah/refined-front.html'),
  'utf8'
);
const marker = '<!-- SUNAN-SUBSCRIBE-FORM -->';
const markerAt = html.indexOf(marker);
if (markerAt < 0) throw new Error('Sunan Ibn Mājah refined page is missing its email signup position.');
const beforeSubscribe = html.slice(0, markerAt);
const afterSubscribe = html.slice(markerAt + marker.length);
---

<Fragment set:html={beforeSubscribe} />
<SubscribeForm variant="closing" />
<Fragment set:html={afterSubscribe} />
