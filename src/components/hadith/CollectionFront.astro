---
/**
 * The front page of a hadith collection: a hero in the work's own design,
 * a short account of the work, the chapter index and the edition notes.
 *
 * The words come from the collection's HTML (read by collection-front.ts) or,
 * for a collection without one, from the page that uses this component. The
 * design comes from collection-identities.ts: one of four hero compositions,
 * the work's palette and a pattern that names its kind. The compiler's
 * medallion and the work's cover come from hadith-art.ts.
 *
 * Anything the page adds (an excerpt, for example) goes in the default slot,
 * between the account of the work and the index.
 */
import { identityFor, type HeroMotif } from '../../data/hadith/collection-identities';
import { GENERIC_LEDE, type CollectionFrontData } from '../../lib/collection-front';
import { compilerFor } from '../../lib/hadith-compilers';
import { coverFor, medallionFor } from '../../lib/hadith-art';
import { LIBRARY_COLLECTIONS } from '../../lib/hadith-library';
import SunanBookIndex from './SunanBookIndex.astro';
import '../../styles/collection-front.css';
import '../../styles/sunan-book.css';
import { getSunanBooks } from '../../lib/sunan-ibn-majah-books';

interface Props {
  slug: string;
  front: CollectionFrontData;
}

const { slug, front } = Astro.props;
const identity = identityFor(slug);
const compiler = compilerFor(slug);
const medallion = medallionFor(compiler);
const cover = coverFor(slug);
const arabic = LIBRARY_COLLECTIONS.find((book) => book.slug === slug)?.title_ar ?? '';
const corpusEntry = LIBRARY_COLLECTIONS.find((book) => book.slug === slug);
if (!corpusEntry) throw new Error(`${slug}: no matching entry in the hadith library`);
const { layout, motif, palette } = identity;
const isSunanIbnMajah = slug === 'sunan-ibn-majah';

const lede = GENERIC_LEDE.test(front.lede) ? identity.lede : front.lede;
if (!lede) throw new Error(`${slug}: the hero sentence is the template's, and collection-identities.ts gives none`);

/* "Transmitted by", "recension of" and the like belong in the facts; a note
   that the work collects someone else's ḥadīth is already in the account. */
const via = compiler?.via && !/^(collects|gathers)\b/.test(compiler.via) ? compiler.via : '';
const place = compiler?.origin ?? '';
/* The edition line is shown only where the notes below do not already give it. */
const editionInNotes = front.notes.some((note) => /^(edition|source)$/i.test(note.label));
/* Keep "al-Shamāʾil", "Ibn-..." and the like on one line: a break after the
   article's hyphen leaves "al-" hanging at the end of a line. */
const titleHtml = front.titleHtml.replace(/<br\s*\/?\s*>/gi, ' ').replace(
  /(^|[\s>(])((?:al|an|ad|ar|as|ash|at|az|bi|li|wa)-[^\s<]+)/gi,
  '$1<span class="cf-nobr">$2</span>'
);
const style = `--cf-ground:${palette.ground};--cf-glow:${palette.glow};--cf-accent:${palette.accent};--cf-deep:${palette.deep}`;

/* One tile per pattern, drawn in the work's accent. */
const TILES: Record<HeroMotif, { w: number; h: number; d: string; dots?: [number, number][] }> = {
  chain: { w: 40, h: 30, d: 'M1 15a9 5.5 0 1 0 18 0a9 5.5 0 1 0 -18 0M17 15a9 5.5 0 1 0 18 0a9 5.5 0 1 0 -18 0' },
  'broken-chain': { w: 64, h: 30, d: 'M1 15a9 5.5 0 1 0 18 0a9 5.5 0 1 0 -18 0M17 15a9 5.5 0 1 0 18 0a9 5.5 0 1 0 -18 0M42 15h3M50 15h3' },
  ledger: { w: 180, h: 22, d: 'M0 21.5H180M12.5 0V22M15.5 0V22' },
  measure: { w: 44, h: 44, d: 'M0 .5H44M.5 0V44M22 0v5M22 39v5M0 22h5M39 22h5' },
  star: { w: 56, h: 56, d: 'M16 16h24v24H16zM28 11l17 17-17 17-17-17z' },
  arcade: { w: 48, h: 64, d: 'M5 64V32a19 19 0 0 1 38 0v32' },
  waves: { w: 64, h: 18, d: 'M0 9c8-7 24-7 32 0s24 7 32 0' },
  dots: { w: 38, h: 38, d: 'M22 27l8-3', dots: [[7, 9], [12.5, 9]] },
  reed: { w: 26, h: 140, d: 'M4.5 0v140M12.5 0v140M17.5 40v100' }
};
const tile = TILES[motif];
const patternId = `cf-pattern-${motif}`;
const chapterRows = [...front.indexHtml.matchAll(/<a\b(?=[^>]*class="[^"]*\bchapter-row\b[^"]*")[^>]*>([\s\S]*?)<\/a>/gi)];
const chapterCounts = chapterRows.map(([, html]) => {
  const count = html.match(/class="chapter-count"[^>]*>[\s\S]*?·\s*([\d,]+)\s+entr(?:y|ies)/i)?.[1];
  return count ? Number(count.replace(/,/g, '')) : null;
}).filter((count): count is number => count !== null);
const indexCount = chapterRows.length || (front.indexHtml.match(/\bdata-filter-row\b/g) ?? []).length;
const composition = {
  single: chapterCounts.filter((count) => count === 1).length,
  short: chapterCounts.filter((count) => count >= 2 && count < 10).length,
  extended: chapterCounts.filter((count) => count >= 10).length
};
const hasComposition = chapterCounts.length > 0;
const sunanBooks = isSunanIbnMajah
  ? getSunanBooks().map((book) => ({
      number: book.number,
      title: book.title,
      titleAr: book.titleAr,
      chapters: book.chapters.length,
      reports: book.reportCount,
      firstReport: book.firstReport,
      lastReport: book.lastReport
    }))
  : [];
---

<div class={`cf-page cf-page--${layout}`} style={style} data-collection={slug}>
  <header class:list={["cf-hero", `cf-hero--${layout}`, identity.mirror && "cf-hero--mirror"]} aria-labelledby="cf-title">
    {!isSunanIbnMajah && <svg class="cf-motif" aria-hidden="true" focusable="false">
      <defs>
        <pattern id={patternId} width={tile.w} height={tile.h} patternUnits="userSpaceOnUse">
          <path d={tile.d} fill="none" stroke="currentColor" stroke-width="1" />
          {tile.dots?.map(([x, y]) => <circle cx={x} cy={y} r="1.7" fill="currentColor" />)}
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill={`url(#${patternId})`} />
    </svg>}
    <img
      class="cf-hero__backdrop"
      src={cover.src}
      alt=""
      width="1400"
      height="788"
      style={`object-position:${cover.position}`}
      decoding="async"
      fetchpriority="high"
    />

    <div class="hc-container cf-hero__inner">
      <div class="cf-hero__copy">
        <p class="cf-kicker">
          <a href="/hadith/">Hadith corpus</a>
          {place && <Fragment><span aria-hidden="true">·</span> <span>{place}</span></Fragment>}
          <span aria-hidden="true">·</span> <span>{identity.era}</span>
        </p>
        <h1 id="cf-title" class="cf-title" set:html={titleHtml} />
        {arabic && (layout !== 'colophon' || isSunanIbnMajah) && <p class="cf-arabic" lang="ar" dir="rtl">{arabic}</p>}
        <span class="cf-rule" aria-hidden="true"></span>
        <p class="cf-author">
          {medallion && <img class="cf-author__medallion" src={medallion} alt="" width="44" height="44" decoding="async" />}
          <span class="cf-author__label">{front.authorLabel}</span>
          <span class="cf-author__name">{front.compiler}</span>
          {front.date && <span class="cf-author__date">{front.date}</span>}
        </p>
        <p class="cf-lede">{lede}</p>
        <div class="cf-actions">
          <a class="hc-btn cf-btn" href={isSunanIbnMajah ? '/hadith/collection/sunan-ibn-majah/book/1/' : front.beginHref}>{isSunanIbnMajah ? 'Begin with Kitāb 1' : front.beginLabel} <span aria-hidden="true">→</span></a>
          <a class="hc-btn hc-btn--ghost cf-btn cf-btn--ghost" href={front.exploreHref}>{isSunanIbnMajah ? 'Explore all 38 kitābs' : front.exploreLabel} <span aria-hidden="true">↓</span></a>
        </div>
      </div>

    </div>
    <div class={`hc-container cf-measures${hasComposition ? '' : ' cf-measures--two'}`} aria-label="Collection overview">
      <div class="cf-measure">
        <strong>{corpusEntry.hadith_count.toLocaleString('en-US')}</strong>
        <span>Reports <small>in this edition</small></span>
      </div>
      <div class="cf-measure">
        <strong>{isSunanIbnMajah ? sunanBooks.length : indexCount.toLocaleString('en-US')}</strong>
        <span>{isSunanIbnMajah ? 'Kitābs' : 'Index entries'} <small>{isSunanIbnMajah ? '1,516 bābs' : 'in source order'}</small></span>
      </div>
      {hasComposition && (
        <div class="cf-measure cf-measure--composition">
          <span class="cf-composition-label">Chapter composition <small>By number of reports</small></span>
          <div class="cf-composition-bars" role="img" aria-label={`${composition.single} single-report chapters, ${composition.short} chapters with 2 to 9 reports, and ${composition.extended} chapters with 10 or more reports`}>
            <i style={`--part:${composition.single}`} title={`${composition.single} single-report chapters`}></i>
            <i style={`--part:${composition.short}`} title={`${composition.short} chapters with 2 to 9 reports`}></i>
            <i style={`--part:${composition.extended}`} title={`${composition.extended} chapters with 10 or more reports`}></i>
          </div>
          <span class="cf-composition-legend">{composition.single} single <b>·</b> {composition.short} short <b>·</b> {composition.extended} extended</span>
        </div>
      )}
    </div>
  </header>

  {isSunanIbnMajah
    ? <SunanBookIndex books={sunanBooks} />
    : front.indexHtml && <div class="cf-index" set:html={front.indexHtml
    .replace('class="frame home-main"', 'class="hc-container home-main"')} />}

  <section class="cf-work" aria-labelledby="cf-work-title">
    <div class="hc-container cf-work__grid">
      <div class="cf-work__head">
        <p class="cf-eyebrow">The work</p>
        <h2 id="cf-work-title" class="cf-work__title">About this compilation</h2>
      </div>
      <div class="cf-work__body">
        <p class="cf-work__about">{identity.about}</p>
        <dl class="cf-facts">
          {place && <div><dt>Place</dt><dd>{place}</dd></div>}
          {isSunanIbnMajah && <div><dt>Arrangement</dt><dd>{sunanBooks.length} kitābs · {indexCount.toLocaleString('en-US')} bābs</dd></div>}
          {via && <div><dt>Transmission</dt><dd>{via.charAt(0).toUpperCase() + via.slice(1)}</dd></div>}
          {!editionInNotes && <div><dt>Edition</dt><dd>{identity.edition}</dd></div>}
        </dl>
      </div>
    </div>
  </section>

  <slot />

  <section class="cf-notes" aria-labelledby="cf-notes-title">
    <div class="hc-container cf-notes__grid">
      <h2 id="cf-notes-title" class="cf-notes__title">About the edition</h2>
      <div class="cf-notes__list">
        {front.notes.map((note) => (
          <div class="cf-note">
            <h3 class="cf-note__label">{note.label}</h3>
          <p class="cf-note__text" dir="auto" set:html={note.html} />
          </div>
        ))}
      </div>
    </div>
  </section>

  {front.scripts.map((script) => <script is:inline set:html={script} />)}
</div>
