---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/local-edition.css';

interface Props {
  slug: string;
  title: string;
  arabic: string;
  author: string;
  extent: string;
  detail: string;
}
const { slug, title, arabic, author, extent, detail } = Astro.props;
---
<BaseLayout title={`${title} | HadithCritic`} description={`${title}, a collection of ${extent}.`} crumbs={[{name: 'Home', url: '/'}, {name: 'Hadith corpus', url: '/hadith/'}, {name: title, url: `/hadith/collection/${slug}/`}]}>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&amp;family=DM+Sans:wght@400;500;600;700&amp;family=Newsreader:opsz,wght@6..72,400;6..72,500&amp;family=Sorts+Mill+Goudy&amp;display=swap" />
  <main class="local-edition collection-preview">
    <a class="back" href="/hadith/">Hadith library</a>
    <p class="kicker">Collection · Arabic &amp; English</p>
    <h1>{title}</h1>
    <p class="arabic-title" lang="ar" dir="rtl">{arabic}</p>
    <p class="lede">{author}</p>
    <div class="preview-facts"><span>{extent}</span><span>Arabic &amp; English</span></div>
    <section class="preview-about" aria-labelledby="edition-heading">
      <p class="kicker">The edition</p>
      <h2 id="edition-heading">About this collection</h2>
      <p class="detail">{detail}</p>
      <p class="detail">The reader edition is in preparation.</p>
    </section>
  </main>
</BaseLayout>
<style>
  .collection-preview { min-height: 70vh; }
  .preview-facts { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 32px; }
  .preview-facts span { background: var(--surface, #242626); border: 1px solid var(--border, #42423d); border-radius: 10px; padding: 11px 15px; font-size: .85rem; }
  .preview-about { margin-top: 80px; border-top: 1px solid var(--border, #42423d); padding-top: 8px; }
  .preview-about .kicker { margin-top: 38px; }
  .preview-about h2 { font: 400 clamp(2rem, 4vw, 3rem)/1.1 'Sorts Mill Goudy', Georgia, serif; }
</style>
