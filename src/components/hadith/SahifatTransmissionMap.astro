---
const transmitters = [
  { name: "Muḥammad ﷺ", role: "The Prophet", note: "The source of the reports" },
  { name: "Abū Hurayra", role: "Companion", note: "Original transmitter" },
  { name: "Hammām ibn Munabbih", role: "Collector", note: "The Ṣaḥīfa’s named compiler" },
  { name: "Maʿmar ibn Rāshid", role: "Transmitter", note: "Transmitted from Hammām" },
  { name: "ʿAbd al-Razzāq", role: "Transmitter", note: "Transmitted from Maʿmar" },
  { name: "Aḥmad al-Sulamī", role: "Transmitter", note: "Nishapuri transmitter" },
  { name: "Abū Bakr al-Qaṭṭān", role: "Transmitter", note: "Nishapuri transmitter" },
  { name: "Ibn Mandah", role: "Transmitter", note: "Muḥammad ibn Isḥāq" },
  { name: "ʿAbd al-Wahhāb ibn Mandah", role: "Transmitter", note: "Son of Ibn Mandah" },
  { name: "Abū al-Khayr al-Bāghbān", role: "Transmitter", note: "Received it from Ibn Mandah’s son" },
  { name: "Muḥammad al-Bandahī", role: "Transmitter", note: "Read from the manuscript described in the opening" },
  { name: "This reader", role: "Arabic and English", note: "The supplied edition" },
];
---

<section class="pf-band pf-band--parchment sf-transmission" aria-labelledby="sf-transmission-title">
  <div class="pf-wrap">
    <header class="pf-head pf-head--center reveal">
      <p class="pf-eyebrow">The transmission</p>
      <h2 id="sf-transmission-title" class="pf-h2">Where this <em>Ṣaḥīfa</em> sits.</h2>
      <p class="pf-lede">
        The opening statement traces the reports from the Prophet through Abū Hurayra and Hammām, then through later transmitters to the manuscript represented by this edition.
      </p>
    </header>

    <figure class="sf-transmission__figure reveal reveal--d1">
      <div class="sf-transmission__heading">
        <p>Opening transmission · read from the source toward this edition</p>
        <span>12 steps</span>
      </div>
      <div class="sf-transmission__scroll" tabindex="0" aria-label="Transmission chain; scroll horizontally to follow it">
        <ol class="sf-transmission__chain">
          {transmitters.map((transmitter, index) => (
            <li class:list={["sf-transmission__node", index === 0 && "sf-transmission__node--origin", index === transmitters.length - 1 && "sf-transmission__node--edition"]}>
              <span class="sf-transmission__index">{String(index + 1).padStart(2, "0")}</span>
              <strong>{transmitter.name}</strong>
              <span class="sf-transmission__role">{transmitter.role}</span>
              <span class="sf-transmission__note">{transmitter.note}</span>
            </li>
          ))}
        </ol>
      </div>
      <figcaption>
        Names and order follow the opening transmission printed with this edition. This shows the chain supplied for the Ṣaḥīfa; it does not claim that every report has a separately stated, identical chain.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .sf-transmission__figure {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(18px, 3vw, 30px);
    border: 1px solid var(--pf-line);
    border-radius: var(--pf-radius-sm);
    background: var(--pf-card);
    box-shadow: var(--pf-shadow);
  }

  .sf-transmission__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 20px;
    margin-bottom: 18px;
    color: var(--pf-gold);
    font: 600 12px/1.4 var(--pf-ui);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .sf-transmission__heading p { margin: 0; }
  .sf-transmission__heading span { color: var(--pf-muted); }

  .sf-transmission__scroll {
    overflow-x: auto;
    padding: 0 0 8px;
    scrollbar-color: var(--pf-stroke-soft) transparent;
  }

  .sf-transmission__chain {
    display: grid;
    grid-template-columns: repeat(12, minmax(132px, 1fr));
    min-width: 1230px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sf-transmission__node {
    position: relative;
    display: flex;
    min-height: 170px;
    flex-direction: column;
    align-items: flex-start;
    padding: 18px 18px 16px 12px;
    border-top: 1px solid var(--pf-stroke-soft);
  }

  .sf-transmission__node::before {
    content: "";
    position: absolute;
    top: -6px;
    left: 12px;
    width: 11px;
    height: 11px;
    border: 2px solid var(--pf-stroke);
    border-radius: 50%;
    background: var(--pf-card);
  }

  .sf-transmission__node:not(:last-child)::after {
    content: "";
    position: absolute;
    top: -5px;
    right: 7px;
    width: 8px;
    height: 8px;
    border-top: 1px solid var(--pf-stroke);
    border-right: 1px solid var(--pf-stroke);
    rotate: 45deg;
    background: var(--pf-card);
  }

  .sf-transmission__index {
    margin-bottom: 14px;
    color: var(--pf-muted);
    font: 600 12px/1 var(--pf-ui);
    font-variant-numeric: tabular-nums;
  }

  .sf-transmission__node strong {
    color: var(--pf-ink);
    font: 600 16px/1.25 var(--pf-display);
  }

  .sf-transmission__role {
    margin-top: 8px;
    color: var(--pf-gold);
    font: 600 12px/1.35 var(--pf-ui);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .sf-transmission__note {
    margin-top: 7px;
    color: var(--pf-muted);
    font: 400 12px/1.45 var(--pf-ui);
  }

  .sf-transmission__node--origin::before,
  .sf-transmission__node--edition::before {
    background: var(--pf-stroke);
  }

  .sf-transmission__node--edition strong { color: var(--pf-gold); }

  .sf-transmission__figure figcaption {
    max-width: 88ch;
    margin-top: 16px;
    padding-top: 15px;
    border-top: 1px solid var(--pf-line);
    color: var(--pf-muted);
    font: 400 13px/1.6 var(--pf-ui);
  }

  @media (max-width: 700px) {
    .sf-transmission__figure { padding: 18px; }
    .sf-transmission__heading { font-size: 12px; }
    .sf-transmission__chain { min-width: 1150px; }
  }
</style>
