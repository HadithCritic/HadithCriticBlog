---
const steps = [
  {
    name: "Maʿmar ibn Rāshid",
    role: "Compiler",
    note: "The Jāmiʿ is attributed to Maʿmar, who settled and taught in Yemen.",
  },
  {
    name: "ʿAbd al-Razzāq al-Ṣanʿānī",
    role: "Preserver",
    note: "His Muṣannaf preserves Maʿmar’s Jāmiʿ at its end.",
  },
  {
    name: "The printed edition",
    role: "Volumes 10–11",
    note: "The edition of Ḥabīb al-Raḥmān al-Aʿẓamī places the Jāmiʿ in the final two volumes.",
  },
  {
    name: "This reader",
    role: "Source order",
    note: "283 chapters and 1,615 numbered reports; unnumbered continuations remain with the reports they follow.",
  },
];
---

<section class="pf-band pf-band--parchment jm-transmission" aria-labelledby="jm-transmission-title">
  <div class="pf-wrap">
    <header class="pf-head pf-head--center reveal">
      <p class="pf-eyebrow">The work’s transmission</p>
      <h2 id="jm-transmission-title" class="pf-h2">Where this <em>Jāmiʿ</em> sits.</h2>
      <p class="pf-lede">
        From Maʿmar’s collection to its preservation in ʿAbd al-Razzāq’s Muṣannaf, then to the printed edition and this reader.
      </p>
    </header>

    <ol class="jm-transmission__steps reveal reveal--d1">
      {steps.map((step, index) => (
        <li class="jm-transmission__step">
          <span class="jm-transmission__number">{String(index + 1).padStart(2, "0")}</span>
          <span class="jm-transmission__role">{step.role}</span>
          <h3>{step.name}</h3>
          <p>{step.note}</p>
        </li>
      ))}
    </ol>
    <p class="jm-transmission__caption">
      The sequence summarizes the work’s preservation and printed placement; the chapter index follows the supplied edition.
    </p>
  </div>
</section>

<style>
  .jm-transmission__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 1280px;
    margin: 0 auto;
    padding: 0;
    border-top: 1px solid var(--pf-stroke-soft);
    list-style: none;
  }

  .jm-transmission__step {
    position: relative;
    min-width: 0;
    padding: 24px clamp(14px, 2vw, 28px) 10px 0;
  }

  .jm-transmission__step + .jm-transmission__step {
    padding-left: clamp(14px, 2vw, 28px);
    border-left: 1px solid var(--pf-stroke-soft);
  }

  .jm-transmission__number {
    display: block;
    margin-bottom: 24px;
    color: var(--pf-muted);
    font: 600 12px/1 var(--pf-ui);
    font-variant-numeric: tabular-nums;
  }

  .jm-transmission__role {
    color: var(--pf-gold);
    font: 600 12px/1.4 var(--pf-ui);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .jm-transmission__step h3 {
    margin: 9px 0 8px;
    color: var(--pf-ink);
    font: 600 20px/1.25 var(--pf-display);
  }

  .jm-transmission__step p,
  .jm-transmission__caption {
    color: var(--pf-muted);
    font: 400 14px/1.6 var(--pf-ui);
  }

  .jm-transmission__step p { margin: 0; }

  .jm-transmission__caption {
    max-width: 1280px;
    margin: 20px auto 0;
    font-size: 12px;
  }

  @media (max-width: 850px) {
    .jm-transmission__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .jm-transmission__step:nth-child(3) { border-left: 0; padding-left: 0; }
    .jm-transmission__step:nth-child(n + 3) { border-top: 1px solid var(--pf-stroke-soft); }
  }

  @media (max-width: 520px) {
    .jm-transmission__steps { grid-template-columns: 1fr; }
    .jm-transmission__step + .jm-transmission__step { padding-left: 0; border-left: 0; }
    .jm-transmission__step:nth-child(n + 2) { border-top: 1px solid var(--pf-stroke-soft); }
    .jm-transmission__step { padding-bottom: 20px; }
    .jm-transmission__number { margin-bottom: 14px; }
  }
</style>
