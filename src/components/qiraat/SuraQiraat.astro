---
import "../../styles/qiraat.css";
import "../../styles/project-pages.css";
import { partUrl, verseNumber, type PartSpan } from "../../lib/qiraat-parts";
import type { SuraData } from "../../lib/qiraat-suras";
import vanPutten from "../../data/qiraat/van-putten-taysir.json";

type Reader = { qari: string; display: string; whole: boolean; riwayat: { id: string; display: string }[] };
type Claim = { id: string; book_id: string; page: string; quote: string; quote_is_exact_raw: boolean; via: string[]; note: string | null };
type Group = {
  kind: "reading" | "differs" | "reported" | "unstated"; tone: number | null; short: string; members: string[];
  readers: Reader[]; qaris: string[]; includes_hafs: boolean; member_count: number;
  value_label?: string; forms?: { text: string; book_id: string; page: string }[]; claims?: Claim[];
  by_book?: { book_id: string; values: { label: string }[] }[]; values?: { label: string }[];
};
type Report = Claim & { readers: Reader[]; value_label: string; basis: string };
type Feature = {
  id: string; label: string; verse: string; words: { id: string; text: string }[];
  groups: Group[]; cells: Record<string, { g: number; b: string }>; books: string[]; reports: Report[];
  route_notes?: { book_id: string; page: string; volume?: string; narrators: string[]; excerpt: string }[];
  route_entries?: { book_id: string; page: string; evidence: string; note?: string | null; entries: { narrator: string; under: string; kind: string; form: string; reading?: string | null }[] }[];
  lemma?: string; scope?: "here" | "wherever" | "listed" | null; anchor_status?: string | null;
  note?: string | null; unresolved?: { span: string; reason: string }[];
};
type Neighbour = { n: number; latin: string } | null;
/*
 * A sura that fits on one page arrives whole, with no parts.
 * A long sura arrives twice: whole with `part` null (the overview), and one slice per part.
 */
interface Props {
  data: SuraData;
  name: { n: number; ar: string; latin: string; verses: number };
  prev: Neighbour;
  next: Neighbour;
  parts?: PartSpan[];
  part?: PartSpan | null;
}

const { data, name, prev, next, parts = [], part = null } = Astro.props;
const features = data.features as unknown as Feature[];
const overview = parts.length > 0 && part === null;
const total = data.riwayat.length;
const bookIds = data.books.map((book) => book.book_id);
const bookOf = new Map(data.books.map((book) => [book.book_id, book]));
const riwayaOf = new Map(data.riwayat.map((r) => [r.id, r]));
/* Each transmitter wears his reader's hue: the first is the deep shade, the second the light one. */
const wear = new Map(data.qaris.flatMap((q) => q.riwayat.map((id, shade) => [id, `q-${q.id} shade-${shade}`] as const)));
/* Position numbers are global to the sura, so a position keeps its number on the overview and on its part. */
const offset = part ? part.start : 0;
const suraPositions = parts.length > 0 ? parts[parts.length - 1].end : features.length;
const width = suraPositions > 99 ? 3 : 2;
const positions = features.map((feature, index) => ({
  ...feature,
  no: String(offset + index + 1).padStart(width, "0"),
  ref: `${data.sura}:${verseNumber(feature.verse)}`,
  farsh: Boolean(feature.scope),
  anchored: feature.words.length > 0,
}));
const positionNo = new Map(positions.map((p) => [p.id, p.no]));
const lemmaOf = (position: (typeof positions)[number]) => (position.anchored ? position.words[0].text : position.lemma);
/* A long sura gets the compact overview; a short one keeps the full grid. */
const dense = overview || positions.length > 14;
/* A long sura shows only the verses that hold a position; a short one shows its whole text. */
const partial = part !== null || data.verses.length > 20;
const shownVerses = partial ? data.verses.filter((verse) => verse.words.some((word) => word.features.length > 0)) : data.verses;
const bookName = (id: string) => bookOf.get(id)?.short_title ?? id;
const labelLang = (text: string | undefined) => /[؀-ۿ]/u.test(text ?? "") ? "ar" : undefined;
const noteParts = (text: string) => text.split(/([؀-ۿ]+(?:\s+[؀-ۿ]+)*)/u);
/* A is always the reading that includes Ḥafṣ (the Cairo text); B, C and D follow inside one position. */
const letter = (group: Group) => String.fromCharCode(65 + (group.tone ?? 0));
const tally = (position: Feature) => position.groups.map((g) => `${g.kind === "reading" ? letter(g) : g.short} ${g.member_count}`);
/* The one-line summary: each reading by letter, then each state once with its total. */
const summary = (position: Feature) => {
  const readings = position.groups.filter((g) => g.kind === "reading").map((g) => `${letter(g)} ${g.member_count}`);
  const states = new Map<string, number>();
  for (const g of position.groups) if (g.kind !== "reading") states.set(g.short, (states.get(g.short) ?? 0) + g.member_count);
  return [...readings, ...[...states].map(([label, n]) => `${label} ${n}`)];
};
const departs = (position: Feature, id: string) => {
  const group = position.groups[position.cells[id].g];
  return group.kind === "reading" && group.tone !== 0;
};
/* How many positions each transmitter reads other than the Cairo text. A count, not a ranking. */
const departures = data.qaris.map((q) => ({
  q,
  rows: q.riwayat.map((id, shade) => ({ id, shade, count: positions.filter((p) => departs(p, id)).length })),
}));

const VIA: Record<string, string> = {
  direct: "The book names this transmitter",
  qari: "The book names the qāriʾ; applied to both his transmitters",
  rest: "The book says “the others”; applied to the readers it covers",
};
const BASIS: Record<string, string> = {
  report: "Reported through a named student",
  rejected: "Recorded, then rejected in the book",
  disputed: "The book says there is a dispute over this reader",
  permitted: "The book permits this as a way of beginning the word",
};
const SET_LABEL: Record<string, string> = { seven: "Seven readers", ten: "Ten readers" };
const SCOPE: Record<string, string> = { wherever: "Wherever the word occurs", listed: "At the places the book lists" };
const KIND_LABEL = { differs: "The books differ", reported: "Reported, not listed", unstated: "Not stated in the books cited" };
const KIND_TITLE = { differs: "What each book gives", reported: "Reports only", unstated: "No book states these readers" };
/* A grid cell names its state in words; the overview, at 22px a cell, uses a sign the legend explains. */
const STATE_WORD = { differs: "differs", reported: "reported", unstated: "not stated" };
const STATE_SIGN = { differs: "≠", reported: "r", unstated: "–" };

/* What each book says for one transmitter at one position: lists it, reports it, or is silent. */
const MARK: Record<string, string> = { l: "lists it", r: "reports it", "-": "silent" };
function bookTrail(feature: Feature, marks: string) {
  return bookIds
    .map((id) => {
      const at = feature.books.indexOf(id);
      return `${bookOf.get(id)?.mark ?? id} ${MARK[at < 0 ? "-" : marks[at]]}`;
    })
    .join(", ");
}

function citedBooks(claims: Claim[] = []) {
  const byBook = new Map<string, Set<string>>();
  for (const claim of claims) byBook.set(claim.book_id, (byBook.get(claim.book_id) ?? new Set()).add(claim.page));
  return bookIds.filter((id) => byBook.has(id)).map((id) => ({ id, pages: [...byBook.get(id)!].join("; ") }));
}

/* Reader focus is a native radio plus :has(), so it works with scripting off. */
const readerRules = data.qaris
  .map(
    (q) => `
.qq:has(#qq-r-${q.id}:checked) .m-row[data-q="${q.id}"] :is(.m-rh, .tile) { box-shadow: inset 0 0 0 2px var(--hc-gold); }
.qq:has(#qq-r-${q.id}:checked) .ov__row[data-q="${q.id}"] .ov__name { box-shadow: inset 0 0 0 2px var(--hc-gold); }
.qq:has(#qq-r-${q.id}:checked) :is(.rdg, .rep):not([data-qaris~="${q.id}"]) { display: none; }
.qq:has(#qq-r-${q.id}:checked) .who[data-q="${q.id}"] { border-color: var(--hc-gold); color: var(--hc-text-primary); font-weight: 700; }`,
  )
  .join("\n");
/* Short titles read "Author, Title", so a comma between books would run them together. */
const sources = data.books.map((book) => book.short_title).join("; ");

/*
 * at-Taysir in Marijn van Putten's translation (CC BY-NC 4.0), keyed by verse.
 * It translates Pretzl's edition, the pagination Shamela 5527 and the claims
 * cite. English leads; each book's Arabic quotation stays with its reading below.
 * A verse with several positions prints the statement at its first position.
 */
type VpStatement = { id: string; sura: number | null; verse: number | null; section: string; kind: string; heading: string; pretzl_pages: number[]; text: string; footnotes: { n: number; text: string }[] };
const taysirByVerse = new Map<number, VpStatement[]>();
for (const statement of vanPutten.statements as VpStatement[]) {
  if (statement.section !== "farsh" || statement.sura !== data.sura || statement.verse === null) continue;
  taysirByVerse.set(statement.verse, [...(taysirByVerse.get(statement.verse) ?? []), statement]);
}
const taysirFirstAt = new Map<number, string>();
for (const position of positions) {
  const verse = verseNumber(position.verse);
  if (taysirByVerse.has(verse) && !taysirFirstAt.has(verse)) taysirFirstAt.set(verse, position.id);
}
/*
 * What no position carries, shown once on the sura's main page: the lists
 * al-Dani closes the sura with (its yaʾs, numbered but with no verse), and his
 * entries on verses the module has no position for yet. Together with the
 * positions and the general principles page, every statement of the
 * translation is shown somewhere.
 */
const taysirOfSura = (vanPutten.statements as VpStatement[]).filter((st) => st.section === "farsh" && st.sura === data.sura);
const taysirClosing = part === null ? taysirOfSura.filter((st) => st.verse === null) : [];
const verseHasPosition = new Set(positions.map((position) => verseNumber(position.verse)));
const taysirUnplaced = part === null ? taysirOfSura.filter((st) => st.verse !== null && !verseHasPosition.has(st.verse)) : [];
const vpPages = (statements: VpStatement[]) => {
  const pages = [...new Set(statements.flatMap((st) => st.pretzl_pages))].sort((a, b) => a - b);
  return pages.length === 1 ? `p. ${pages[0]}` : `pp. ${pages[0]} to ${pages[pages.length - 1]}`;
};
const swatchFor = (reader: Reader) =>
  reader.whole ? "sw" : `sw sw--${data.qaris.find((q) => q.id === reader.qari)!.riwayat.indexOf(reader.riwayat[0].id)}`;
---

<div class="qq pj">
  <header class="pj-hero" aria-labelledby="qq-title">
    <div class="pj-shell pj-hero__inner">
      <nav class="pj-hero__eyebrow" aria-label="Suras">
        {prev && <a class="pj-hero__step" href={`/projects/quran/sura/${prev.n}/`} rel="prev">{prev.n}. {prev.latin}</a>}
        <a href="/projects/quran/#suras">Sura {name.n} of 114{part ? `, part ${part.index} of ${part.of}` : ""}</a>
        {next && <a class="pj-hero__step" href={`/projects/quran/sura/${next.n}/`} rel="next">{next.n}. {next.latin}</a>}
      </nav>
      <h1 id="qq-title" class="pj-hero__title">{name.latin} <span class="pj-hero__ar hc-quran" lang="ar">{name.ar}</span></h1>
      <p class="pj-hero__lede">
        {part && <>Part {part.index} of {part.of}: verses {name.n}:{part.firstVerse} to {name.n}:{part.lastVerse}, positions {positions[0].no} to {positions[positions.length - 1].no}. </>}
        The ten qirāʾāt word by word, as reported in {sources}.
      </p>
      <ul class="pj-hero__facts" aria-label="This sura at a glance">
        <li>Sura {name.n}, {name.verses} verses</li>
        <li>{positions.length} {positions.length === 1 ? "position" : "positions"}</li>
        <li>{total} transmitters</li>
        <li>{data.books.length} books</li>
      </ul>
      <p class="pj-hero__notice">Every reading below is a proposal that no reviewer has checked yet.</p>
      <div class="pj-hero__actions">
        <a class="pj-chip pj-chip--gold" href="#books">Books cited</a>
        <a class="pj-chip pj-chip--go" href="/projects/quran/transmission/">How the readings were transmitted</a>
      </div>
    </div>
  </header>

  <div class="pj-about">
    <div class="pj-shell pj-about__row">
      <details class="pj-disc">
        <summary><span class="pj-disc__title">Summary by reader</span></summary>
        <div class="pj-disc__body">
          <p>Positions where each transmitter reads other than the Cairo text (the reading that includes Ḥafṣ). A count, not a ranking.</p>
          <ol class="dep" aria-label="Positions where each transmitter reads other than the Cairo text">
            {departures.map(({ q, rows }) => (
              <li class={`dep__q q-${q.id}`}>
                <span class="dep__name">{q.display} <span lang="ar">{q.name_ar}</span></span>
                <span class="dep__bars">
                  {rows.map((row) => (
                    <span class={`dep__line shade-${row.shade}`}>
                      <span class="dep__who">{riwayaOf.get(row.id)?.display ?? row.id}</span>
                      <span class="dep__track" aria-hidden="true"><i class="dep__bar" style={`--w:${positions.length ? (row.count / positions.length) * 100 : 0}%`}></i></span>
                      <b class="dep__n">{row.count}</b>
                    </span>
                  ))}
                </span>
              </li>
            ))}
          </ol>
        </div>
      </details>
      <details class="pj-disc">
        <summary><span class="pj-disc__title">How to read this</span></summary>
        <div class="pj-disc__body">
          <dl>
            <div><dt>Quotations</dt><dd>Each quotation is the book’s own wording, with the vowel marks of the edition we hold. Short Arabic labels are excerpts of its descriptions. English labels and the grouping are ours.</dd></div>
            <div><dt>Reader sets</dt><dd>When a book says “the others”, we apply it to the readers that book covers. A seven-reader book says nothing about the other three, and the page says so.</dd></div>
            <div><dt>Reports</dt><dd>A book may pass on a reading through a named student, record one and reject it, say a reader’s reading is disputed, or permit another way of beginning a word. These stay apart from what the book lists outright.</dd></div>
            <div><dt>Review</dt><dd>No reading has been reviewed. Each is checked only for one thing: that the quoted words appear on the cited page. Whether a reader was assigned to the right reading has not been checked by a person.</dd></div>
          </dl>
        </div>
      </details>
    </div>
  </div>

  <div class="pj-toolbar pj-toolbar--sticky">
    <div class="pj-shell pj-toolbar__row">
      <div class="pj-toolbar__group pj-toolbar__group--scroll" role="radiogroup" aria-labelledby="qq-focus-label">
        <span class="pj-toolbar__label" id="qq-focus-label">Focus on</span>
        <label class="pj-chip">
          <input class="pj-chip__input" type="radio" name="qq-reader" id="qq-r-all" checked />
          <span>All ten</span>
        </label>
        {data.qaris.map((q) => (
          <label class={`pj-chip q-${q.id}`}>
            <input class="pj-chip__input" type="radio" name="qq-reader" id={`qq-r-${q.id}`} />
            <i class="sw" aria-hidden="true"></i><span>{q.display}</span>
          </label>
        ))}
      </div>
      <div class="pj-toolbar__end">
        <details class="pj-legend">
          <summary class="pj-chip">Legend</summary>
          <div class="pj-legend__panel">
            <div class="pj-legend__group">
              <p class="pj-legend__cap">Readers</p>
              <p class="legend__line">Each reader has one color. His two transmitters are its deeper and its lighter shade.</p>
              <ul class="pj-legend__cols">
                {data.qaris.map((q) => (
                  <li class={`q-${q.id}`}><span class="legend__pair" aria-hidden="true"><i class="sw sw--0"></i><i class="sw sw--1"></i></span>{q.display} <span lang="ar">{q.name_ar}</span></li>
                ))}
              </ul>
            </div>
            <div class="pj-legend__group">
              <p class="pj-legend__cap">Readings</p>
              <ul>
                <li><b class="lt" aria-hidden="true">A</b>The letter is the reading. A is the reading of the Cairo text, the one that includes Ḥafṣ.</li>
                <li><b class="lt" aria-hidden="true">B</b>B, C and D are the other readings at the same position.</li>
              </ul>
            </div>
            <div class="pj-legend__group">
              <p class="pj-legend__cap">States</p>
              <ul>
                <li><span class="tile tile--key q-asim shade-0 is-differs" aria-hidden="true"><span class="tile__state">differs</span></span>The books differ. The overview marks it ≠.</li>
                <li><span class="tile tile--key q-asim shade-0 is-reported" aria-hidden="true"><i class="pj-dot"></i><span class="tile__state">reported</span></span>Reported, not listed. A dashed border; the overview marks it r.</li>
                <li><span class="tile tile--key q-asim shade-0 is-unstated" aria-hidden="true"><i class="pj-dot"></i><span class="tile__state">not stated</span></span>Not stated in the books cited. A dotted border; the overview marks it –.</li>
              </ul>
            </div>
            <div class="pj-legend__group">
              <p class="pj-legend__cap">Books</p>
              <p class="legend__line">In the grid, point at or focus a cell to see what each book says for that transmitter: lists it, reports it, or silent. The books, in order: {data.books.map((book) => book.mark).join(" ")}.</p>
            </div>
          </div>
        </details>
        {!overview && (
          <>
            <button type="button" class="pj-btn" data-qq-expand hidden>Expand all</button>
            <button type="button" class="pj-btn" data-qq-collapse hidden>Collapse all</button>
          </>
        )}
      </div>
    </div>
  </div>

  <div class="pj-shell qq-body">
    {overview && (
      <section class="pj-section" id="parts" aria-labelledby="parts-h">
        <header class="pj-head">
          <h2 id="parts-h" class="pj-head__title">Parts of the sura</h2>
          <span class="pj-head__rule" aria-hidden="true"></span>
          <span class="pj-head__count">{parts.length} parts</span>
        </header>
        <p class="pj-lede">
          {positions.length} positions are too many for one page, so the sura is set out in {parts.length} parts. A part never splits a verse, and a position keeps its number from part to part.
          The overview below shows all of them at once, left to right through the sura.
        </p>
        <ol class="parts">
          {parts.map((span) => {
            const inPart = positions.slice(span.start, span.end);
            return (
              <li>
                <a class="part" href={partUrl(name.n, span.index)}>
                  <span class="part__n">{span.index}</span>
                  <span class="part__ref">{name.n}:{span.firstVerse}{span.lastVerse !== span.firstVerse && <> to {name.n}:{span.lastVerse}</>}</span>
                  <span class="part__meta">{inPart.length} {inPart.length === 1 ? "position" : "positions"}, {inPart[0].no} to {inPart[inPart.length - 1].no}</span>
                  <span class="part__ar hc-quran" lang="ar">
                    {inPart.slice(0, 5).map((position, i) => <>{i > 0 && " "}<span>{lemmaOf(position)}</span></>)}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    )}

    {!overview && (
    <section class="pj-section" id="positions" aria-labelledby="positions-h">
      <header class="pj-head">
        <h2 id="positions-h" class="pj-head__title">Position by position</h2>
        <span class="pj-head__rule" aria-hidden="true"></span>
        <span class="pj-head__count">{positions.length} {positions.length === 1 ? "position" : "positions"}</span>
      </header>

      <ol class="poslist">
      {positions.map((position) => (
        <li>
          <article class="pos pj-card" id={position.id} aria-labelledby={`${position.id}-h`}>
            <header class="pos__head">
              <div class="pos__id">
                <p class="pos__no">
                  <span class="disc">{position.no}</span>
                  <a href={`#${position.id}`}>{position.ref}</a>
                  {position.scope && position.scope !== "here" && <span class="pos__scope">{SCOPE[position.scope]}</span>}
                </p>
                {position.farsh ? (
                  <h3 class="pos__title pos__title--ar hc-quran" id={`${position.id}-h`} lang="ar">{position.lemma}</h3>
                ) : (
                  <h3 class="pos__title" id={`${position.id}-h`}>{position.label}</h3>
                )}
                <p class="pos__tally" aria-label={`Who reads what: ${tally(position).join(", ")}`}>{summary(position).join(" · ")}</p>
              </div>
              {position.anchored && <p class="pos__word hc-quran" lang="ar">{position.words.map((word) => word.text).join(" ")}</p>}
            </header>

            {(() => {
              const verse = verseNumber(position.verse);
              const statements = taysirByVerse.get(verse);
              if (!statements) return null;
              const first = taysirFirstAt.get(verse);
              if (first !== position.id) {
                return <p class="pj-note">al-Dānī’s entry for {data.sura}:{verse} is translated at <a href={`#${first}`}>position {positionNo.get(first!)}</a>.</p>;
              }
              const notes = statements.flatMap((st) => st.footnotes);
              return (
                <div class="en">
                  {statements.map((st) => <p class="en__text">{st.text}</p>)}
                  <p class="en__src">al-Dānī, <i>at-Taysīr</i>, {vpPages(statements)}, on {data.sura}:{verse}. Translated by Marijn van Putten (Open Book Publishers, 2026, CC BY-NC 4.0). The Arabic of each book is quoted with its reading below.</p>
                  {notes.length > 0 && (
                    <details class="pj-disc pj-disc--quiet">
                      <summary>Translator’s notes ({notes.length})</summary>
                      <ol class="en__notes">{notes.map((note) => <li value={note.n}>{note.text}</li>)}</ol>
                    </details>
                  )}
                </div>
              );
            })()}

            {!position.anchored && position.farsh && (
              <p class="pj-note"><span class="pj-note__k">Note</span>The book’s word could not be matched to a word of this verse, so it is shown at the verse the extraction named.</p>
            )}
            {position.note && <p class="pj-note"><span class="pj-note__k">Note</span>{noteParts(position.note).map((text) => <bdi lang={labelLang(text)}>{text}</bdi>)}</p>}
            {position.unresolved && position.unresolved.length > 0 && (
              <p class="pj-note">
                <span class="pj-note__k">Note</span>Not assigned to any reader:{" "}
                {position.unresolved.map((u, i) => (
                  <>{i > 0 && "; "}<bdi lang="ar">{u.span}</bdi> ({noteParts(u.reason).map((text) => <bdi lang={labelLang(text)}>{text}</bdi>)})</>
                ))}
              </p>
            )}

            <ol class="rdgs" aria-label="Readings at this position">
              {position.groups.map((group) => {
                const books = citedBooks(group.claims);
                return (
                  <li class={`rdg rdg--${group.kind}`} data-qaris={group.qaris.join(" ")}>
                    <div class="rdg__head">
                      {group.kind === "reading"
                        ? <b class="lt lt--lg" aria-label={`Reading ${letter(group)}`}>{letter(group)}</b>
                        : <span class="rdg__state">{KIND_LABEL[group.kind]}</span>}
                      <div class="rdg__what">
                        <p class="rdg__value"><bdi lang={labelLang(group.value_label)}>{group.kind === "reading" ? group.value_label : KIND_TITLE[group.kind]}</bdi></p>
                        {group.kind === "reading" && group.includes_hafs && <p class="rdg__kind">Includes Ḥafṣ, the Cairo text</p>}
                      </div>
                      <p class="rdg__n"><b>{group.member_count}</b> of {total}</p>
                    </div>

                    <ul class="rdg__who" aria-label="Read by">
                      {group.readers.map((reader) => (
                        <li><a class={`who q-${reader.qari}`} data-q={reader.qari} href={`/projects/quran/readers/${reader.qari}/`}>
                          <i class={swatchFor(reader)} aria-hidden="true"></i>
                          {reader.display}{!reader.whole && ` (${reader.riwayat.map((r) => r.display).join(", ")})`}
                        </a></li>
                      ))}
                    </ul>

                    {group.forms && group.forms.length > 0 && (
                      <ul class="forms" aria-label="As written in the books">
                        {group.forms.map((form) => (
                          <li><bdi class="forms__ar" lang="ar">{form.text}</bdi><span class="forms__src">{bookOf.get(form.book_id)?.mark} · {form.page}</span></li>
                        ))}
                      </ul>
                    )}
                    {group.by_book && (
                      <ul class="bybook" aria-label="What each book gives">
                        {group.by_book.map((entry) => (
                          <li><b class="mk">{bookOf.get(entry.book_id)?.mark}</b><span>{entry.values.map((v, i) => <>{i > 0 && "; "}<bdi lang={labelLang(v.label)}>{v.label}</bdi></>)}</span></li>
                        ))}
                      </ul>
                    )}
                    {group.values && <p class="rdg__note">Reports only: {group.values.map((v, i) => <>{i > 0 && "; "}<bdi lang={labelLang(v.label)}>{v.label}</bdi></>)}. See below.</p>}

                    {group.claims && group.claims.length > 0 && (
                      <details class="src">
                        <summary class="pj-chip">Sources ({group.claims.length})</summary>
                        <div class="src__body">
                          <p class="src__marks">
                            <span class="src__k">Cited in</span>
                            {data.books.map((book) => <b class:list={["mk", { "mk--off": !books.some((b) => b.id === book.book_id) }]} title={book.short_title}>{book.mark}</b>)}
                          </p>
                          <ul class="pages">{books.map((b) => <li><span>{bookName(b.id)}</span> {b.pages}</li>)}</ul>
                          <ul class="quotes">
                            {group.claims.map((claim) => (
                              <li>
                                <p class="quotes__ref">{bookName(claim.book_id)}, {claim.page}</p>
                                <blockquote class="quotes__ar" lang="ar">{claim.quote}</blockquote>
                                <p class="quotes__how">
                                  {claim.via.map((v) => VIA[v]).join(". ")}{!claim.quote_is_exact_raw && ". The quotation runs over a page break, so its vowel marks are omitted"}
                                </p>
                                {claim.note && <p class="quotes__how">{claim.note}</p>}
                              </li>
                            ))}
                          </ul>
                        </div>
                      </details>
                    )}
                  </li>
                );
              })}
            </ol>

            {position.reports.length > 0 && (
              <details class="pj-disc pj-disc--quiet more">
                <summary>{position.reports.some((report) => report.basis === "permitted") ? "Also reported or permitted in the books" : "Also reported in the books"} ({position.reports.length})</summary>
                <ul class="more__list">
                  {position.reports.map((report) => (
                    <li class="rep" data-qaris={[...new Set(report.readers.map((r) => r.qari))].join(" ")}>
                      <p class="quotes__ref">
                        {bookName(report.book_id)}, {report.page}. {report.readers.map((r) => (r.whole ? r.display : `${r.display} (${r.riwayat.map((w) => w.display).join(", ")})`)).join(", ")}: <bdi lang={labelLang(report.value_label)}>{report.value_label}</bdi>. {BASIS[report.basis]}.
                      </p>
                      <blockquote class="quotes__ar" lang="ar">{report.quote}</blockquote>
                      {report.note && <p class="quotes__how">{report.note}</p>}
                    </li>
                  ))}
                </ul>
              </details>
            )}

            {(position.route_entries ?? []).length > 0 && (
              <details class="pj-disc pj-disc--quiet more">
                <summary>Routes read below the transmitters ({position.route_entries!.reduce((n, item) => n + item.entries.length, 0)})</summary>
                <p class="quotes__how">Narrators outside the twenty transmitters, and what the book says each reports. Read by hand from the passage quoted under each; the reading number links to the readings above only where the form is the same.</p>
                <ul class="more__list">
                  {position.route_entries!.map((item) => (
                    <li class="rep">
                      <p class="quotes__ref">{bookName(item.book_id)}, {item.page}.</p>
                      <ul class="route-rows">
                        {item.entries.map((row) => (
                          <li>
                            <bdi lang="ar">{row.narrator}</bdi>{" "}
                            {row.kind === "disputed" ? "(disputed) reports that" : row.kind === "reports" ? "reports for" : "reports that"} {row.under}{" "}
                            {row.kind === "reports" ? "" : "reads"}: <bdi lang={labelLang(row.form)}>{row.form}</bdi>
                            {row.reading && <span>{" "}(the reading <bdi lang={labelLang(row.reading)}>{row.reading}</bdi> above)</span>}
                          </li>
                        ))}
                      </ul>
                      <blockquote class="quotes__ar" lang="ar">{item.evidence}</blockquote>
                      {item.note && <p class="quotes__how">{item.note}</p>}
                    </li>
                  ))}
                </ul>
              </details>
            )}
            {(position.route_notes ?? []).length > 0 && (
              <details class="pj-disc pj-disc--quiet more">
                <summary>Routes named below the transmitters, not read ({position.route_notes!.length})</summary>
                <p class="quotes__how">The books below give the reading through narrators outside the twenty transmitters. The passages are quoted as printed; they are not entered as readings here.</p>
                <ul class="more__list">
                  {position.route_notes!.map((note) => (
                    <li class="rep">
                      <p class="quotes__ref">{bookName(note.book_id)}, {note.page}. Narrators named: {note.narrators.map((name, index) => (<Fragment><bdi lang="ar">{name}</bdi>{index < note.narrators.length - 1 ? ", " : ""}</Fragment>))}.</p>
                      <blockquote class="quotes__ar" lang="ar">{note.excerpt}</blockquote>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </article>
        </li>
      ))}
      </ol>
      {part && (
        <nav class="pj-pager" aria-label={`Parts of ${name.latin}`}>
          {part.index > 1 ? <a href={partUrl(name.n, part.index - 1)} rel="prev">Part {part.index - 1}, from {name.n}:{parts[part.index - 2].firstVerse}</a> : <span></span>}
          <a class="pj-pager__index" href={`/projects/quran/sura/${name.n}/#parts`}>All {part.of} parts</a>
          {part.index < part.of ? <a href={partUrl(name.n, part.index + 1)} rel="next">Part {part.index + 1}, from {name.n}:{parts[part.index].firstVerse}</a> : <span></span>}
        </nav>
      )}
    </section>
    )}

    {!overview && (
    <section class="pj-section" id="passage" aria-labelledby="passage-h">
      <header class="pj-head">
        <h2 id="passage-h" class="pj-head__title">{partial ? "The verses with a difference" : "The passage"}</h2>
        <span class="pj-head__rule" aria-hidden="true"></span>
        <span class="pj-head__count">{shownVerses.length} {shownVerses.length === 1 ? "verse" : "verses"}</span>
      </header>
      <div class="passage pj-card">
        <p class="passage__cap">Cairo 1924 edition. A numbered word opens its position above.</p>
        <ol class="verses">
          {shownVerses.map((verse) => (
            <li class="verse">
              <span class="verse__ref">{data.sura}:{verse.number}</span>
              <p class="verse__text hc-quran" lang="ar">
                {verse.words.map((word, index) => (
                  <>
                    {index > 0 && " "}
                    {word.features.length > 0 ? (
                      <a class="w" href={`#${word.features[0]}`}>{word.text}<span class="w__no" aria-label={`position ${positionNo.get(word.features[0])}`}>{positionNo.get(word.features[0])}</span></a>
                    ) : (
                      <span>{word.text}</span>
                    )}
                  </>
                ))}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>
    )}

    <section class="pj-section" id="collation" aria-labelledby="collation-h">
      <details class="pj-disc pj-disc--card grid" open={overview}>
        <summary>
          <h2 id="collation-h" class="pj-disc__title grid__title">Full collation grid</h2>
          <span class="pj-disc__meta">{total} transmitters, {positions.length} {positions.length === 1 ? "position" : "positions"}</span>
        </summary>
        <div class="pj-disc__body">
          {!dense && (
            <>
              <p class="pj-lede">
                Each row is a transmitter, each column a word. A cell carries the letter of the reading he has there, in his reader’s color, or names its state. Point at or focus a cell to see which of the {bookIds.length} {bookIds.length === 1 ? "book says" : "books say"} so; the same facts are set out in words in each position above.
              </p>
              <div class="matrix" role="region" aria-label="Collation matrix" tabindex="0">
                <table style={`--cols:${positions.length}`}>
                  <caption class="sr-only">Readings of the twenty transmitters at {positions.length} positions in {name.latin}</caption>
                  <thead>
                    <tr>
                      <th scope="col" class="m-corner">Transmitter</th>
                      {positions.map((position) => (
                        <th scope="col" class="m-col">
                          <a href={`#${position.id}`}>
                            <span class="m-col__top"><span class="disc">{position.no}</span><span class="m-col__ref">{position.ref}</span></span>
                            <span class="m-col__ar hc-quran" lang="ar">{lemmaOf(position)}</span>
                            <span class="m-col__tally">{tally(position).join(" · ")}</span>
                          </a>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  {data.qaris.map((q) => (
                    <tbody class="m-group">
                      {q.riwayat.map((id, index) => (
                        <tr class="m-row" data-q={q.id}>
                          <th scope="row" class={`m-rh ${wear.get(id)}`}>
                            {index === 0 && <span class="m-rh__q">{q.display} <span lang="ar">{q.name_ar}</span></span>}
                            <span class="m-rh__r"><i class="pj-dot" aria-hidden="true"></i>{riwayaOf.get(id)!.display}</span>
                          </th>
                          {positions.map((position) => {
                            const cell = position.cells[id];
                            const group = position.groups[cell.g];
                            const trail = bookTrail(position, cell.b);
                            const what = group.kind === "reading" ? `reading ${letter(group)}, ${group.short}` : group.short;
                            return (
                              <td>
                                <a class={`tile ${wear.get(id)} is-${group.kind}`} href={`#${position.id}`}
                                  data-tip={`${riwayaOf.get(id)!.display}, ${position.ref}: ${what}. ${trail}.`}
                                  title={`${what}. ${trail}.`}
                                  aria-label={`${riwayaOf.get(id)!.display}, ${position.ref}: ${what}. ${trail}.`}>
                                  {group.kind === "reading"
                                    ? <b class="tile__lt">{letter(group)}</b>
                                    : <>{group.kind !== "differs" && <i class="pj-dot"></i>}<span class="tile__state">{STATE_WORD[group.kind]}</span></>}
                                </a>
                              </td>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  ))}
                </table>
              </div>
              <p class="readout" data-qq-readout aria-live="polite" hidden>Point at or focus a cell to read what each book says.</p>
            </>
          )}

          {dense && (
            <>
              <p class="pj-lede">
                One row per transmitter, one column per position, left to right through the sura. A colored square with a letter is a reading other than the Cairo text; a plain baseline means he reads as the Cairo text does.
                {overview
                  ? " Scroll sideways to follow the sura. The parts above set the same facts out in words, with the quotations."
                  : " Scroll sideways, or use the jump links to reach a position. The same facts are set out in words in each position above."}
              </p>
              {overview ? (
                <nav class="pj-chips jump" aria-label="Jump to a part">
                  {parts.map((span) => <a class="pj-chip" href={partUrl(name.n, span.index)}>{name.n}:{span.firstVerse}</a>)}
                </nav>
              ) : (
                <nav class="pj-chips jump" aria-label="Jump to a position">
                  {positions.filter((_, i) => i % Math.ceil(positions.length / 12) === 0).map((position) => (
                    <a class="pj-chip" href={`#${position.id}`}>{position.ref}</a>
                  ))}
                </nav>
              )}
              <div class="ov" role="region" aria-label="Overview of departures from the Cairo text" tabindex="0">
                <div class="ov__grid" style={`--n:${positions.length}`} aria-hidden="true">
                  {data.qaris.flatMap((q) =>
                    q.riwayat.map((id) => (
                      <div class={`ov__row ${wear.get(id)}`} data-q={q.id}>
                        <span class="ov__name"><i class="pj-dot"></i>{riwayaOf.get(id)!.display}</span>
                        <i class="ov__base"></i>
                        {positions.map((position, index) => {
                          const group = position.groups[position.cells[id].g];
                          const col = `grid-column:${index + 2}`;
                          if (group.kind === "reading" && group.tone === 0) return null;
                          return group.kind === "reading"
                            ? <i class="ov__t is-reading" style={col}>{letter(group)}</i>
                            : <i class={`ov__t is-${group.kind}`} style={col}>{STATE_SIGN[group.kind]}</i>;
                        })}
                      </div>
                    )),
                  )}
                </div>
              </div>
            </>
          )}
        </div>
      </details>
    </section>

    {(taysirClosing.length > 0 || taysirUnplaced.length > 0) && (
    <section class="pj-section" id="taysir" aria-labelledby="taysir-h">
      <header class="pj-head">
        <h2 id="taysir-h" class="pj-head__title">More from al-Dānī’s at-Taysīr</h2>
        <span class="pj-head__rule" aria-hidden="true"></span>
        <span class="pj-head__count">{taysirClosing.length + taysirUnplaced.length} entries</span>
      </header>
      <p class="pj-lede">
        al-Dānī’s entries for this sura that no position above carries: any verse the module has no position for yet, and the lists he closes the sura with.
        In Marijn van Putten’s translation (Open Book Publishers, 2026, CC BY-NC 4.0), with the page of Pretzl’s edition.
        The general principles they rest on are on <a href="/projects/quran/taysir/">their own page</a>.
      </p>
      {taysirUnplaced.length > 0 && (
        <details class="pj-disc pj-disc--card taysir-more">
          <summary><span class="pj-disc__title">Verses with no position here yet</span><span class="pj-disc__meta">{taysirUnplaced.length}</span></summary>
          <div class="pj-disc__body">
            {taysirUnplaced.map((st) => (
              <div class="en">
                <p class="en__ref">{data.sura}:{st.verse}</p>
                <p class="en__text">{st.text}</p>
                <p class="en__src">al-Dānī, <i>at-Taysīr</i>, {vpPages([st])}.</p>
                {st.footnotes.length > 0 && (
                  <details class="pj-disc pj-disc--quiet">
                    <summary>Translator’s notes ({st.footnotes.length})</summary>
                    <ol class="en__notes">{st.footnotes.map((note) => <li value={note.n}>{note.text}</li>)}</ol>
                  </details>
                )}
              </div>
            ))}
          </div>
        </details>
      )}
      {taysirClosing.length > 0 && (
        <details class="pj-disc pj-disc--card taysir-more">
          <summary><span class="pj-disc__title">The lists that close the sura</span><span class="pj-disc__meta">{taysirClosing.length}</span></summary>
          <div class="pj-disc__body">
            {taysirClosing.map((st) => (
              <div class="en">
                <p class="en__ref">{st.heading}</p>
                <p class="en__text">{st.text}</p>
                <p class="en__src">al-Dānī, <i>at-Taysīr</i>, {vpPages([st])}.</p>
                {st.footnotes.length > 0 && (
                  <details class="pj-disc pj-disc--quiet">
                    <summary>Translator’s notes ({st.footnotes.length})</summary>
                    <ol class="en__notes">{st.footnotes.map((note) => <li value={note.n}>{note.text}</li>)}</ol>
                  </details>
                )}
              </div>
            ))}
          </div>
        </details>
      )}
    </section>
    )}

    <section class="pj-section" id="books" aria-labelledby="books-h">
      <header class="pj-head">
        <h2 id="books-h" class="pj-head__title">Books cited</h2>
        <span class="pj-head__rule" aria-hidden="true"></span>
        <span class="pj-head__count">{data.books.length} books</span>
      </header>
      <p class="pj-lede">Each book covers a different set of readers, which decides what “the others” means in its wording. Dates are the authors’ death years in the Hijri calendar.</p>
      <ol class="books">
        {data.books.map((book) => (
          <li class="book pj-card">
            <p class="book__head"><span class="book__mark">{book.mark}</span><span class="book__name">{book.short_title}</span></p>
            <p class="book__ar" lang="ar">{book.title_ar}</p>
            <p class="book__meta">d. {book.author_year} AH · {SET_LABEL[book.reader_set] ?? "Other scope"} · {book.claim_count} readings cited in this sura</p>
            <details class="pj-disc pj-disc--quiet">
              <summary>Pages cited</summary>
              <p class="book__pages">{book.pages.length > 12 ? `${book.pages.slice(0, 12).join("; ")}; and ${book.pages.length - 12} more pages` : book.pages.join("; ")}</p>
            </details>
          </li>
        ))}
      </ol>
      <p class="attribution">
        Verse text: Corpus Coranicum, Cairo 1924 edition, TEI export pinned to commit{" "}
        <code>57cb2b7be321</code>, CC BY-SA 4.0. Quoted readings come from editions in the Maktaba Shamela, cited by page.
      </p>
      <nav class="pj-pager" aria-label="Neighbouring suras">
        {prev ? <a href={`/projects/quran/sura/${prev.n}/`} rel="prev">Sura {prev.n}, {prev.latin}</a> : <span></span>}
        <a class="pj-pager__index" href="/projects/quran/">All suras</a>
        {next ? <a href={`/projects/quran/sura/${next.n}/`} rel="next">Sura {next.n}, {next.latin}</a> : <span></span>}
      </nav>
    </section>
  </div>
</div>

<style is:inline set:html={readerRules}></style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(".qq")) {
    /* Expand all and Collapse all open every disclosure inside the positions. */
    const scope = root.querySelector("#positions");
    const expand = root.querySelector<HTMLButtonElement>("[data-qq-expand]");
    const collapse = root.querySelector<HTMLButtonElement>("[data-qq-collapse]");
    if (scope && expand && collapse) {
      const set = (open: boolean) => scope.querySelectorAll("details").forEach((d) => { (d as HTMLDetailsElement).open = open; });
      expand.hidden = false;
      collapse.hidden = false;
      expand.addEventListener("click", () => set(true));
      collapse.addEventListener("click", () => set(false));
    }
    /* The grid's readout: what each book says for the cell under the pointer or the focus. */
    const readout = root.querySelector<HTMLElement>("[data-qq-readout]");
    const matrix = root.querySelector<HTMLElement>(".matrix");
    if (readout && matrix) {
      readout.hidden = false;
      const show = (event: Event) => {
        const tile = (event.target as HTMLElement).closest<HTMLElement>(".tile");
        if (tile?.dataset.tip) readout.textContent = tile.dataset.tip;
      };
      matrix.addEventListener("pointerover", show);
      matrix.addEventListener("focusin", show);
    }
  }
</script>

<style>
  .qq-body { padding-bottom: clamp(4rem, 9vw, 7rem); }

  /* Position number: a gold disc. Reading letter: a small square that keeps the ink around it. */
  .disc { display: inline-grid; place-items: center; min-width: 1.7rem; height: 1.7rem; padding-inline: 0.4rem; border-radius: 999px; background: var(--hc-gold); color: var(--hc-text-inverse); font: 700 0.8rem/1 var(--font-ui); font-variant-numeric: lining-nums tabular-nums; }
  .lt { display: inline-grid; place-items: center; flex: none; min-width: 1.3rem; height: 1.3rem; border: 1px solid currentColor; border-radius: 2px; font: 700 0.78rem/1 var(--font-ui); }
  .lt--lg { min-width: 1.9rem; height: 1.9rem; border-color: var(--hc-gold); color: var(--hc-gold); font-size: 0.95rem; }
  .mk { display: inline-grid; place-items: center; min-width: 1.75rem; height: 1.4rem; padding-inline: 0.25rem; border: 1px solid var(--hc-rule); border-radius: 2px; color: var(--hc-text-primary); font: 700 0.78rem/1 var(--font-ui); letter-spacing: 0.04em; }
  .mk--off { border-style: dashed; color: var(--hc-text-tertiary); }

  /* ── Summary by reader ──────────────────────────────────────── */
  .dep { display: grid; gap: 0.6rem; margin: 0; padding: 0; list-style: none; }
  .dep__q { display: grid; grid-template-columns: 9rem minmax(0, 1fr); align-items: center; gap: 0.75rem; }
  .dep__name { color: var(--hc-text-primary); font: 600 0.9rem/1.3 var(--font-ui); }
  .dep__name [lang] { color: var(--hc-text-secondary); font: 400 1rem/1 var(--font-arabic); }
  .dep__bars { display: grid; gap: 4px; }
  .dep__line { display: grid; grid-template-columns: 6rem minmax(0, 1fr) 2rem; align-items: center; gap: 0.6rem; }
  .dep__who { overflow: hidden; color: var(--hc-text-secondary); font: 500 0.82rem/1.2 var(--font-ui); text-overflow: ellipsis; white-space: nowrap; }
  .dep__track { display: block; height: 0.6rem; border-radius: 1px; background: var(--hc-surface-2); }
  .dep__bar { display: block; width: var(--w); min-width: 2px; height: 100%; border-radius: 1px; background: var(--bg); }
  .dep__n { color: var(--hc-text-primary); font: 700 0.85rem/1 var(--font-ui); font-variant-numeric: tabular-nums lining-nums; text-align: end; }

  /* ── Legend extras ──────────────────────────────────────────── */
  .legend__line { margin: 0 0 0.6rem; color: var(--hc-text-secondary); font-size: 0.92rem; line-height: 1.55; }
  .legend__pair { display: inline-flex; flex: none; gap: 2px; }
  .legend__pair .sw { width: 0.95rem; height: 0.95rem; }
  .pj-legend li [lang] { color: var(--hc-text-tertiary); font-family: var(--font-arabic); }
  .pj-legend .lt { color: var(--hc-gold); }
  .pj-toolbar .sw { width: 0.8rem; height: 0.8rem; }

  /* ── Positions ──────────────────────────────────────────────── */
  .poslist { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--pj-gap); margin: 0; padding: 0; list-style: none; }
  .pos { padding: clamp(1rem, 2.4vw, 1.5rem); scroll-margin-top: calc(var(--pj-top) + 5rem); content-visibility: auto; contain-intrinsic-size: auto 30rem; }
  .pos:target { border-color: var(--hc-gold); }
  .pos__head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem 1.5rem; align-items: start; margin-bottom: 1rem; }
  .pos__no { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.6rem; margin: 0 0 0.45rem; color: var(--hc-text-secondary); font: 600 0.88rem/1.3 var(--font-ui); letter-spacing: 0.04em; font-variant-numeric: lining-nums tabular-nums; }
  .pos__no a { color: inherit; text-decoration: none; }
  .pos__no a:hover { color: var(--hc-gold-bright); }
  .pos__scope { color: var(--hc-text-tertiary); font-weight: 500; letter-spacing: 0; }
  .pos__scope::before { content: "·" / ""; margin-inline-end: 0.6rem; }
