---
type Props = { id: string; arabic?: boolean };
const { id, arabic = false } = Astro.props;
---

<header class="q-section-head">
  <h2 id={id} class:list={["q-section-title", { "q-section-title--ar": arabic }]} lang={arabic ? "ar" : undefined}>
    <slot name="title" />
  </h2>
  {Astro.slots.has("count") && <span class="q-section-count"><slot name="count" /></span>}
</header>
