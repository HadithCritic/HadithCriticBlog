---
/**
 * The HadithCritic mark: three interlocking hexagonal rings, a chain of
 * transmission. Drawn in currentColor from the paths of
 * /images/brand/HCsvg.svg, so a variant is a change of colour, never a
 * redrawing.
 */
interface Props {
  /** Rendered height; the width follows the mark's own 2:5 proportion. */
  size?: string;
  label?: string;
  class?: string;
}

const { size = '48px', label, class: className } = Astro.props;
---

<svg
  class:list={['hc-mark', className]}
  viewBox="0 0 377 954"
  style={`height:${size};width:auto`}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path fill-rule="evenodd" d="M 18 126 L 18 314 L 42 331 L 47 332 L 83 308 L 55 289 L 55 148 L 188 64 L 322 148 L 322 289 L 294 309 L 331 332 L 335 331 L 359 314 L 359 125 L 192 19 L 187 18 Z" />
  <path fill-rule="evenodd" d="M 188 266 L 127 304 L 122 309 L 157 332 L 164 330 L 185 316 L 190 315 L 322 399 L 322 547 L 296 564 L 294 567 L 333 590 L 359 572 L 359 373 Z M 254 378 L 221 357 L 217 357 L 190 374 L 187 374 L 103 320 L 18 373 L 18 572 L 34 584 L 46 590 L 83 566 L 55 547 L 55 399 L 59 395 L 103 369 L 178 417 L 190 422 L 255 380 Z M 122 637 L 123 640 L 187 680 L 195 677 L 256 638 L 221 615 L 214 617 L 188 633 L 158 614 Z" />
  <path fill-rule="evenodd" d="M 187 524 L 87 586 L 18 632 L 18 828 L 189 936 L 359 828 L 359 631 L 192 525 Z M 187 573 L 192 574 L 322 656 L 322 804 L 189 889 L 55 804 L 55 656 L 59 652 Z" />
</svg>
