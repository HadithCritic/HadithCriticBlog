---
/* Reading preferences: text size, verse highlights and the light or dark
   theme. Shown in the sidebar on wide screens and in a popover from the
   toolbar on narrow ones; both copies drive the same settings
   (src/lib/tafsir-reader.ts). */
import Icon from './Icon.astro';

interface Props {
  /** Distinguishes the two copies' control ids. */
  prefix: string;
}
const { prefix } = Astro.props;
---

<div class="tfr-setting">
  <span id={`${prefix}-size-label`}>Text size</span>
  <div class="tfr-stepper" role="group" aria-labelledby={`${prefix}-size-label`}>
    <button type="button" data-size-step="-1" aria-label="Smaller text"><Icon name="minus" size={13} /></button>
    <output data-size-value aria-live="polite">17</output>
    <button type="button" data-size-step="1" aria-label="Larger text"><Icon name="plus" size={13} /></button>
  </div>
</div>
<div class="tfr-setting">
  <label for={`${prefix}-highlights`}>Verse highlights</label>
  <input id={`${prefix}-highlights`} class="tfr-switch" type="checkbox" data-highlights-switch checked />
</div>
<div class="tfr-setting">
  <label for={`${prefix}-dark`}>Dark reading mode</label>
  <input id={`${prefix}-dark`} class="tfr-switch" type="checkbox" data-dark-switch />
</div>
