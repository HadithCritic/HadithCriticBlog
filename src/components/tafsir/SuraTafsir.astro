---
import "../../styles/tafsir.css";
import "../../styles/project-pages.css";
import names from "../../data/quran-sura-names.json";
import { eraIdOf, loadTafsirSura, shortName, tafsirPartUrl, versePartsOf, works, type Entry, type VersePart, type Work } from "../../lib/tafsir";

type SuraName = (typeof names)[number];
interface Props { name: SuraName; part: VersePart }

const { name, part } = Astro.props;
const sura = loadTafsirSura(name.n);
const parts = versePartsOf(name.verses);
const urlFor = (p: VersePart) => tafsirPartUrl(name.n, p);
const otherPart = (offset: number) => parts.find((p) => p.index === part.index + offset);
const previousPart = otherPart(-1);
const nextPart = otherPart(1);

/*
 * An entry that spans several verses is indexed under each of them. It is printed once, at the
 * first of its verses on this page, and labelled with its range; the later verses point back to it.
 */
const verses = sura.verses
  .filter((verse) => verse.number >= part.first && verse.number <= part.last)
  .map((verse) => {
    const byWork = works
      .map((work) => {
        const all = verse.byWork[work.id]?.entries ?? [];
        const first = all.filter((entry) => Math.max(entry.verses.from, part.first) === verse.number);
        const carried = all.filter((entry) => Math.max(entry.verses.from, part.first) !== verse.number);
        return { work, entries: first, carried };
      })
      .filter((row) => row.entries.length > 0 || row.carried.length > 0);
    return { ...verse, byWork };
  });

/* Works that say anything in this sura, for the picker. A count of verses, not a ranking. */
const present = works.filter((work) => sura.coverage[work.id] > 0 || (sura.surahMaterial[work.id]?.length ?? 0) > 0);
const surahMaterialCount = works.reduce((sum, work) => sum + (sura.surahMaterial[work.id]?.length ?? 0), 0);
const showSurahMaterial = part.index === 1 && surahMaterialCount > 0;
const versesWithComment = sura.verses.filter((verse) => Object.values(verse.byWork).some((w) => w.entries.length > 0)).length;

const range = (entry: Entry) =>
  entry.verses.from === entry.verses.to ? null : `${name.n}:${entry.verses.from} to ${name.n}:${entry.verses.to}`;
const cite = (entry: { citation: { volume: string | null; page: string }; page_end?: string | null }) =>
  `${entry.citation.volume ? `vol. ${entry.citation.volume}, ` : ""}p. ${entry.citation.page}${entry.page_end ? ` to ${entry.page_end}` : ""}`;

/* The source marks Qurʾānic wording with braces. The braces are kept; the span only sets them apart. */
const quranSpans = (text: string) => text.split(/(\{[^{}]*\})/u);

/* The author is printed when the work's short name does not already carry it in full. */
const authorOf = (work: Work) => (shortName(work) === work.author ? null : work.author);

function englishNote(status: string | null | undefined): string {
  if (!status) return "English, not reviewed";
  if (/AI translation/i.test(status)) return "Machine translation (AI), not reviewed";
  if (/supplied in catalog/i.test(status)) return "English from the source catalogue, translator not recorded, not reviewed";
  return status;
}

/*
 * How a passage came to sit at its verse, in plain English, from the
 * locator_status the build records. Every placement is still a proposal.
 */
function placementBasis(status: string | null | undefined): string {
  const s = status ?? "";
  if (/corrected/i.test(s)) return "placement corrected after checking the wording and its verse reference";
  if (/numbered verse marker/i.test(s)) return "placed by the verse number printed in the text";
  if (/heading quotation/i.test(s)) return /outside the forward window/i.test(s)
    ? "placed by the verse its heading quotes, found beyond the expected range"
    : "placed by the verse its heading quotes";
  if (/cross-reference/i.test(s)) return "placed by a cross-reference in its section";
  if (/source section/i.test(s)) return "placed by a verse cited in its section";
  if (/Arabic verse citation/i.test(s)) return "placed by a verse it cites";
  if (/source catalogue/i.test(s)) return "placed by the source catalogue's verse locator";
  if (/English text/i.test(s)) return "placed by a verse locator in its English";
  return "placed by its source";
}

/* Whether a work's passages here come with English: all, some, or none. */
function languageOf(entries: Entry[]): string {
  const withEnglish = entries.filter((entry) => entry.text_en).length;
  if (withEnglish === 0) return "Arabic only";
  if (withEnglish === entries.length) return "English and Arabic";
  return `English for ${withEnglish} of ${entries.length}`;
}

/* Hiding a work is one rule per work on a native checkbox, so it works with scripting off. */
const pickerRules = present
  .map((work) => `.tf:has(#tf-w-${work.id}:not(:checked)) [data-work="${work.id}"] { display: none; }`)
  .join("\n");
const workCountHere = (id: string) => verses.filter((verse) => verse.byWork.some((row) => row.work.id === id && row.entries.length > 0)).length;
---

<div class="tf pj">
  <header class="pj-hero" aria-labelledby="reader-title">
    <div class="pj-shell pj-hero__inner">
      <nav class="pj-hero__eyebrow" aria-label="Suras">
        {sura.prev && <a class="pj-hero__step" href={`/projects/tafsir/sura/${sura.prev.n}/`} rel="prev">{sura.prev.n}. {sura.prev.latin}</a>}
        <a href="/projects/tafsir/#suras">Sura {name.n} of 114</a>
        {sura.next && <a class="pj-hero__step" href={`/projects/tafsir/sura/${sura.next.n}/`} rel="next">{sura.next.n}. {sura.next.latin}</a>}
      </nav>
      <h1 id="reader-title" class="pj-hero__title">{name.latin} <span class="pj-hero__ar hc-quran" lang="ar" dir="rtl">{name.ar}</span></h1>
      <p class="pj-hero__lede">
        Sura {name.n}, {name.verses} verses{part.of > 1 ? `; this page holds verses ${part.first} to ${part.last}` : ""}.
        {present.length > 0
          ? <> {present.length} of the {works.length} early commentaries comment here, on {versesWithComment} of its verses.</>
          : <> None of the {works.length} early commentaries is placed at this sura yet.</>}
      </p>
      <div class="pj-hero__actions">
        <a class="pj-chip pj-chip--gold" href="#verses">Read the verses</a>
        {sura.collated && <a class="pj-chip pj-chip--go" href={`/projects/quran/sura/${name.n}/`}>Variant readings in this sura</a>}
      </div>
    </div>
  </header>

  <div class="pj-about">
    <div class="pj-shell">
      <details class="pj-disc">
        <summary><span class="pj-disc__title">How to read the labels</span></summary>
        <div class="pj-disc__body">
          <dl>
            <div><dt>Arabic</dt><dd>As printed in the Shamela edition named for each work, with its volume and page.</dd></div>
            <div><dt>Placement</dt><dd>Proposed. Each passage says how it was placed: a verse number printed in the text, the verse its heading quotes, or a verse cited in its section. No reviewer has checked the placements yet.</dd></div>
            <div><dt>English</dt><dd>Shown first wherever the source supplies it, and labelled with where it comes from; none of it is reviewed. Each commentary says whether its passages here have English. Most of the early works are not translated yet.</dd></div>
            <div><dt>Color</dt><dd>The color marks the era its author died in, not the book. Counts are verses with a passage, not a ranking. <a href="/projects/tafsir/#works">About the works</a></dd></div>
          </dl>
        </div>
      </details>
    </div>
  </div>

  <div class="pj-toolbar pj-toolbar--sticky">
    <div class="pj-shell tf-tools">
      <div class="pj-toolbar__row">
        {present.length > 0 ? (
          <fieldset class="pj-toolbar__group pj-toolbar__group--scroll">
            <legend class="sr-only">Commentaries shown on this page</legend>
            <span class="pj-toolbar__label" aria-hidden="true">Show</span>
            {present.map((work) => (
              <label class={`pj-chip tf-pick era-${eraIdOf(work)}`}>
                <input class="pj-chip__input" type="checkbox" id={`tf-w-${work.id}`} checked />
                <i class="e-sq" aria-hidden="true"></i>
                <span class="tf-pick__name">{shortName(work)}</span>
                <span class="pj-chip__sub">d. {work.death_ah} AH · {workCountHere(work.id)} {workCountHere(work.id) === 1 ? "verse" : "verses"} on this page</span>
              </label>
            ))}
          </fieldset>
        ) : (
          <p class="tf-none">No commentary is placed in this sura yet.</p>
        )}
        <div class="pj-toolbar__end">
          <button type="button" class="pj-btn" data-tf-expand hidden>Expand all</button>
          <button type="button" class="pj-btn" data-tf-collapse hidden>Collapse all</button>
        </div>
      </div>
      <nav class="tf-vnav" aria-label="Verses on this page">
        <span class="pj-toolbar__label" aria-hidden="true">Verse</span>
        <ol>
          {verses.map((verse) => <li><a href={`#v${verse.number}`}>{verse.number}</a></li>)}
        </ol>
      </nav>
    </div>
  </div>

  <div class="pj-shell tf-body">
    <section class="pj-section" id="verses" aria-labelledby="verses-title">
      <header class="pj-head">
        <h2 id="verses-title" class="pj-head__title">{part.of > 1 ? `Verses ${part.first} to ${part.last}` : "The verses"}</h2>
        <span class="pj-head__rule" aria-hidden="true"></span>
        <span class="pj-head__count">{verses.length} {verses.length === 1 ? "verse" : "verses"}</span>
      </header>

      {part.of > 1 && (
        <nav class="pj-chips tf-parts" aria-label="Parts of this sura">
          {parts.map((p) => <a class="pj-chip" href={urlFor(p)} aria-current={p.index === part.index ? "page" : undefined}>{p.first}–{p.last}</a>)}
        </nav>
      )}

      <ol class="tf-list">
        {verses.map((verse) => {
          const count = verse.byWork.filter((row) => row.entries.length > 0).length;
          return (
            <li class="tf-verse" id={`v${verse.number}`}>
              <div class="tf-verse__head">
                <a class="tf-verse__ref" href={`#v${verse.number}`} aria-label={`Sura ${name.n}, verse ${verse.number}`}>{name.n}:{verse.number}</a>
                <span class="tf-verse__count">{count > 0 ? `${count} ${count === 1 ? "commentary" : "commentaries"}` : "No commentary placed here"}</span>
                {verse.features.length > 0 && (
                  <span class="tf-verse__readings">
                    Readings differ at{" "}
                    {verse.features.map((feature, i) => (
                      <>{i > 0 && ", "}<a href={feature.href} class="hc-quran" lang="ar">{feature.word}</a></>
                    ))}
                  </span>
                )}
                {count > 0 && (
                  <span class="tf-verse__tools" data-tf-verse-tools hidden>
                    <button type="button" class="pj-btn" data-tf-open aria-label={`Expand every commentary on ${name.n}:${verse.number}`}>Expand</button>
                    <button type="button" class="pj-btn" data-tf-close aria-label={`Collapse every commentary on ${name.n}:${verse.number}`}>Collapse</button>
                  </span>
                )}
              </div>

              <div class="tf-plate">
                <p class="tf-plate__en" lang="en">{verse.en ?? "English verse text is unavailable."}</p>
                <p class="tf-plate__ar hc-quran" lang="ar" dir="rtl">{verse.words.map((word) => word.text).join(" ")}</p>
              </div>

              <div class="tf-works">
                {verse.byWork.map(({ work, entries, carried }) => (
                  <div class={`tf-work era-${eraIdOf(work)}`} data-work={work.id}>
                    {entries.length > 0 ? (
                      <details class="pj-disc pj-disc--card tf-work__box">
                        <summary class="tf-work__summary">
                          <i class="e-sq" aria-hidden="true"></i>
                          <span class="tf-work__name">{shortName(work)}</span>
                          {authorOf(work) && <span class="tf-work__author">{authorOf(work)}</span>}
                          <span class="tf-work__meta">d. {work.death_ah} AH · {entries.length} {entries.length === 1 ? "passage" : "passages"}</span>
                          <span class="tf-work__lang">{languageOf(entries)}</span>
                        </summary>
                        <div class="pj-disc__body">
                          {entries.map((entry) => (
                            <article class:list={["tf-pass", { "tf-pass--bi": Boolean(entry.text_en) }]}>
                              {entry.text_en && (
                                <div class="tf-pass__en" lang="en">
                                  <p>{entry.text_en}</p>
                                  <p class="tf-pass__label">{englishNote(entry.translation_status)}</p>
                                </div>
                              )}
                              <p class="tf-pass__ar" lang="ar" dir="rtl">
                                {quranSpans(entry.text_ar ?? entry.text).map((piece) => piece.startsWith("{") ? <span class="tf-q">{piece}</span> : piece)}
                              </p>
                              <p class="tf-pass__cite">
                                <span>{cite(entry)}</span>
                                {entry.printed_label && <span>Printed no. <span lang="ar" dir="rtl">{entry.printed_label.replace(/\s*-\s*$/, "")}</span></span>}
                                {range(entry) && <span>Covers {range(entry)}</span>}
                              </p>
                              <div class="tf-pass__more">
                                <details class="pj-disc pj-disc--quiet">
                                  <summary>Placement</summary>
                                  <p class="tf-pass__note">Placement proposed: {placementBasis(entry.locator_status)}</p>
                                </details>
                                {(entry.foot_note_ar || entry.foot_note_en) && (
                                  <details class="pj-disc pj-disc--quiet tf-pass__notes">
                                    <summary>Editor's notes</summary>
                                    {entry.foot_note_en && <p lang="en">{entry.foot_note_en}</p>}
                                    {entry.foot_note_ar && <p lang="ar" dir="rtl">{entry.foot_note_ar}</p>}
                                  </details>
                                )}
                              </div>
                            </article>
                          ))}
                        </div>
                      </details>
                    ) : (
                      <p class="tf-work__carried">
                        <i class="e-sq" aria-hidden="true"></i>
                        {shortName(work)}: {carried.length === 1 ? "a passage" : `${carried.length} passages`} on a range of verses, printed at{" "}
                        {carried.map((entry, i) => {
                          const at = Math.max(entry.verses.from, part.first);
                          return <>{i > 0 && ", "}<a href={`#v${at}`}>{name.n}:{at}</a></>;
                        })}
                      </p>
                    )}
                  </div>
                ))}
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    {showSurahMaterial && (
      <section class="pj-section tf-surah" aria-labelledby="tf-surah-title">
        <header class="pj-head">
          <h2 id="tf-surah-title" class="pj-head__title">Placed at the sura, not a verse</h2>
          <span class="pj-head__rule" aria-hidden="true"></span>
          <span class="pj-head__count">{surahMaterialCount} {surahMaterialCount === 1 ? "passage" : "passages"}</span>
        </header>
        <p class="pj-lede">The sources put these passages under {name.latin} without a verse marker or citation that places them safely. They are kept here rather than given a verse.</p>
        <div class="tf-works">
          {works.filter((work) => (sura.surahMaterial[work.id]?.length ?? 0) > 0).map((work) => (
            <details class={`pj-disc pj-disc--card tf-work tf-work__box era-${eraIdOf(work)}`} data-work={work.id}>
              <summary class="tf-work__summary">
                <i class="e-sq" aria-hidden="true"></i>
                <span class="tf-work__name">{shortName(work)}</span>
                {authorOf(work) && <span class="tf-work__author">{authorOf(work)}</span>}
                <span class="tf-work__meta">d. {work.death_ah} AH · {sura.surahMaterial[work.id].length} {sura.surahMaterial[work.id].length === 1 ? "passage" : "passages"}</span>
              </summary>
              <div class="pj-disc__body">
                {sura.surahMaterial[work.id].map((entry) => (
                  <article class:list={["tf-pass", { "tf-pass--bi": Boolean(entry.text_en) }]}>
                    {entry.text_en && (
                      <div class="tf-pass__en" lang="en">
                        <p>{entry.text_en}</p>
                        <p class="tf-pass__label">{englishNote(entry.translation_status)}</p>
                      </div>
                    )}
                    <p class="tf-pass__ar" lang="ar" dir="rtl">
                      {quranSpans(entry.text_ar ?? entry.text).map((piece) => piece.startsWith("{") ? <span class="tf-q">{piece}</span> : piece)}
                    </p>
                    <p class="tf-pass__cite"><span>{cite(entry)}</span><span>Sura-level placement</span></p>
                  </article>
                ))}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}
    {part.index > 1 && surahMaterialCount > 0 && (
      <p class="pj-lede tf-surah-pointer">{surahMaterialCount} passages placed at the sura but not at a verse are listed on <a href={urlFor(parts[0])}>the first page of {name.latin}</a>.</p>
    )}

    <nav class="pj-pager" aria-label="Sura navigation">
      {previousPart
        ? <a href={urlFor(previousPart)} rel="prev">Verses {previousPart.first} to {previousPart.last}</a>
        : sura.prev ? <a href={`/projects/tafsir/sura/${sura.prev.n}/`} rel="prev">{sura.prev.n}. {sura.prev.latin}</a> : <span></span>}
      <a class="pj-pager__index" href="/projects/tafsir/#suras">All suras</a>
      {nextPart
        ? <a href={urlFor(nextPart)} rel="next">Verses {nextPart.first} to {nextPart.last}</a>
        : sura.next ? <a href={`/projects/tafsir/sura/${sura.next.n}/`} rel="next">{sura.next.n}. {sura.next.latin}</a> : <span></span>}
    </nav>
  </div>
</div>

<style is:inline set:html={pickerRules}></style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(".tf")) {
    const boxes = (scope: HTMLElement) => scope.querySelectorAll<HTMLDetailsElement>(".tf-work__box");
    const set = (scope: HTMLElement, open: boolean) => boxes(scope).forEach((box) => { box.open = open; });
    /* Page-wide: every commentary on the page. */
    const expand = root.querySelector<HTMLButtonElement>("[data-tf-expand]");
    const collapse = root.querySelector<HTMLButtonElement>("[data-tf-collapse]");
    if (expand && collapse) {
      expand.hidden = false;
      collapse.hidden = false;
      expand.addEventListener("click", () => set(root, true));
      collapse.addEventListener("click", () => set(root, false));
    }
    /* Per verse: every commentary on one verse. */
    for (const tools of root.querySelectorAll<HTMLElement>("[data-tf-verse-tools]")) {
      const verse = tools.closest<HTMLElement>(".tf-verse");
      if (!verse) continue;
      tools.hidden = false;
      tools.querySelector("[data-tf-open]")?.addEventListener("click", () => set(verse, true));
      tools.querySelector("[data-tf-close]")?.addEventListener("click", () => set(verse, false));
    }
  }
</script>

<style>
  .tf { --pj-width: 1100px; }
  .tf-body { padding-bottom: clamp(4rem, 9vw, 7rem); }
  .pj-about a { color: var(--hc-gold); }

  /* Toolbar: the work picker, then the verse navigator on its own line. */
  .tf-tools { display: grid; gap: 0.5rem; }
  .tf-pick .e-sq { border-radius: 50%; }
  .tf-pick__name { color: var(--hc-text-primary); }
  .tf-pick:has(input:not(:checked)) { border-style: dashed; }
  .tf-pick:has(input:not(:checked)) .tf-pick__name { color: var(--hc-text-tertiary); text-decoration: line-through; }
  .tf-pick:has(input:not(:checked)) .e-sq { opacity: 0.35; }
  .tf-none { margin: 0; color: var(--hc-text-secondary); font-size: 0.95rem; }
  .tf-vnav { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
  .tf-vnav ol { display: flex; gap: 0.25rem; min-width: 0; margin: 0; padding: 0 0 0.15rem; overflow-x: auto; list-style: none; }
  .tf-vnav a { display: inline-grid; place-items: center; min-width: 32px; min-height: 32px; padding-inline: 0.35rem; border: 1px solid var(--hc-rule-soft); border-radius: var(--radius-xs); color: var(--hc-text-secondary); font: 500 0.85rem/1 var(--font-ui); font-variant-numeric: lining-nums tabular-nums; text-decoration: none; }
  .tf-vnav a:hover { border-color: var(--hc-gold); color: var(--hc-gold-bright); }

  .tf-parts { margin-bottom: 1rem; }
  .tf-parts .pj-chip { font-variant-numeric: tabular-nums; }
  .tf-parts [aria-current="page"] { border-color: var(--hc-gold); color: var(--hc-gold); }

  /* A verse: its number, its text in both languages, then one closed row per commentary. */
  .tf-list { margin: 0; padding: 0; list-style: none; }
  .tf-verse { padding: 1.75rem 0 2rem; border-bottom: 1px solid var(--hc-rule-soft); scroll-margin-top: calc(var(--pj-top) + 8rem); }
  .tf-verse:first-child { padding-top: 0.5rem; }
  .tf-verse__head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem; margin-bottom: 0.9rem; }
  .tf-verse__ref { color: var(--hc-gold); font: 600 1.6rem/1 var(--font-display); font-variant-numeric: lining-nums tabular-nums; text-decoration: none; }
  .tf-verse__ref:hover { color: var(--hc-gold-bright); }
  .tf-verse__count { color: var(--hc-text-secondary); font: 500 0.88rem/1.4 var(--font-ui); }
  .tf-verse__readings { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; padding: 0.15rem 0.6rem; border: 1px solid var(--hc-rule); border-radius: var(--radius-xs); color: var(--hc-text-secondary); font: 500 0.85rem/1.6 var(--font-ui); }
  .tf-verse__readings a { color: var(--hc-text-primary); font-size: 1.1rem; text-decoration-color: var(--hc-gold); }
  .tf-verse__readings a:hover { color: var(--hc-gold-bright); }
  .tf-verse__tools { display: inline-flex; gap: 0.35rem; margin-inline-start: auto; }
  .tf-verse__tools .pj-btn { min-height: 32px; font-size: 0.85rem; }

  .tf-plate { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 1.5rem; align-items: start; margin-bottom: 1.1rem; }
  .tf-plate__en { grid-column: 1; grid-row: 1; margin: 0; color: var(--hc-text-primary); font: 400 1.05rem/1.8 var(--font-body); }
  .tf-plate__ar { grid-column: 2; grid-row: 1; margin: 0; color: var(--hc-text-primary); font-size: clamp(1.7rem, 1.2vw + 1.3rem, 2.2rem); line-height: 2.05; text-align: right; }

  .tf-works { display: grid; gap: 6px; }
  .tf-work__summary .e-sq { border-radius: 50%; }
  .tf-work__name { color: var(--hc-text-primary); font: 600 1rem/1.3 var(--font-body); }
  .tf-work__author { color: var(--hc-text-secondary); font: 400 0.92rem/1.3 var(--font-body); }
  .tf-work__meta { color: var(--hc-text-secondary); font: 500 0.85rem/1.4 var(--font-ui); font-variant-numeric: lining-nums tabular-nums; }
  .tf-work__lang { padding: 0.05rem 0.45rem; border: 1px solid var(--hc-rule); border-radius: 2px; color: var(--hc-text-secondary); font: 500 0.78rem/1.4 var(--font-ui); }
  .tf-work__carried { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.5rem; margin: 0; padding: 0.45rem 1rem; border: 1px dashed var(--hc-rule-soft); border-radius: var(--radius-xs); color: var(--hc-text-secondary); font: 400 0.88rem/1.5 var(--font-ui); }
  .tf-work__carried .e-sq { border-radius: 50%; }
  .tf-work__carried a { color: var(--hc-text-primary); }

  /* An open commentary: the passage, one metadata line, then Placement and Editor's notes. */
