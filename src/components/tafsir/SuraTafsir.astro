---
import "../../styles/tafsir.css";
import names from "../../data/quran-sura-names.json";
import { eraIdOf, loadTafsirSura, shortName, tafsirPartUrl, versePartsOf, works, type Entry, type VersePart } from "../../lib/tafsir";

type SuraName = (typeof names)[number];
interface Props { name: SuraName; part: VersePart }

const { name, part } = Astro.props;
const sura = loadTafsirSura(name.n);
const parts = versePartsOf(name.verses);
const urlFor = (p: VersePart) => tafsirPartUrl(name.n, p);
const otherPart = (offset: number) => parts.find((p) => p.index === part.index + offset);
const previousPart = otherPart(-1);
const nextPart = otherPart(1);

/*
 * An entry that spans several verses is indexed under each of them. It is printed once, at the
 * first of its verses on this page, and labelled with its range; the later verses point back to it.
 */
const verses = sura.verses
  .filter((verse) => verse.number >= part.first && verse.number <= part.last)
  .map((verse) => {
    const byWork = works
      .map((work) => {
        const all = verse.byWork[work.id]?.entries ?? [];
        const first = all.filter((entry) => Math.max(entry.verses.from, part.first) === verse.number);
        const carried = all.filter((entry) => Math.max(entry.verses.from, part.first) !== verse.number);
        return { work, entries: first, carried };
      })
      .filter((row) => row.entries.length > 0 || row.carried.length > 0);
    return { ...verse, byWork };
  });

/* Works that say anything in this sura, for the picker. A count of verses, not a ranking. */
const present = works.filter((work) => sura.coverage[work.id] > 0 || (sura.surahMaterial[work.id]?.length ?? 0) > 0);
const surahMaterialCount = works.reduce((sum, work) => sum + (sura.surahMaterial[work.id]?.length ?? 0), 0);
const showSurahMaterial = part.index === 1 && surahMaterialCount > 0;
const versesWithComment = sura.verses.filter((verse) => Object.values(verse.byWork).some((w) => w.entries.length > 0)).length;

const range = (entry: Entry) =>
  entry.verses.from === entry.verses.to ? null : `${name.n}:${entry.verses.from} to ${name.n}:${entry.verses.to}`;
const cite = (entry: { citation: { volume: string | null; page: string }; page_end?: string | null }) =>
  `${entry.citation.volume ? `vol. ${entry.citation.volume}, ` : ""}p. ${entry.citation.page}${entry.page_end ? ` to ${entry.page_end}` : ""}`;

/* A long discussion (al-Ṭabarī can run for pages on one verse) starts folded, so a verse stays scannable. */
const FOLD_AT = 2400;
const lengthOf = (entries: Entry[]) => entries.reduce((sum, entry) => sum + (entry.text_ar ?? entry.text).length, 0);

/* The source marks Qurʾānic wording with braces. The braces are kept; the span only sets them apart. */
const quranSpans = (text: string) => text.split(/(\{[^{}]*\})/u);

function englishNote(status: string | null | undefined): string {
  if (!status) return "English, not reviewed";
  if (/AI translation/i.test(status)) return "Machine translation (AI), not reviewed";
  if (/supplied in catalog/i.test(status)) return "English from the source catalogue, translator not recorded, not reviewed";
  return status;
}

/*
 * How a passage came to sit at its verse, in plain English, from the
 * locator_status the build records. Every placement is still a proposal.
 */
function placementBasis(status: string | null | undefined): string {
  const s = status ?? "";
  if (/corrected/i.test(s)) return "placement corrected after checking the wording and its verse reference";
  if (/numbered verse marker/i.test(s)) return "placed by the verse number printed in the text";
  if (/heading quotation/i.test(s)) return /outside the forward window/i.test(s)
    ? "placed by the verse its heading quotes, found beyond the expected range"
    : "placed by the verse its heading quotes";
  if (/cross-reference/i.test(s)) return "placed by a cross-reference in its section";
  if (/source section/i.test(s)) return "placed by a verse cited in its section";
  if (/Arabic verse citation/i.test(s)) return "placed by a verse it cites";
  if (/source catalogue/i.test(s)) return "placed by the source catalogue's verse locator";
  if (/English text/i.test(s)) return "placed by a verse locator in its English";
  return "placed by its source";
}

/* Whether a work's passages here come with English: all, some, or none. */
function languageOf(entries: Entry[]): string {
  const withEnglish = entries.filter((entry) => entry.text_en).length;
  if (withEnglish === 0) return "Arabic only";
  if (withEnglish === entries.length) return "English and Arabic";
  return `English for ${withEnglish} of ${entries.length}`;
}

/* Hiding a work is one rule per work on a native checkbox, so it works with scripting off. */
const pickerRules = present
  .map((work) => `.tf:has(#tf-w-${work.id}:not(:checked)) [data-work="${work.id}"] { display: none; }`)
  .join("\n");
const workCountHere = (id: string) => verses.filter((verse) => verse.byWork.some((row) => row.work.id === id && row.entries.length > 0)).length;
---

<main class="tf">
  <header class="hc-masthead" aria-labelledby="reader-title">
    <div class="hc-container hc-masthead__inner">
      <div>
        <nav class="tf-crumbs" aria-label="Suras">
          {sura.prev ? <a href={`/projects/tafsir/sura/${sura.prev.n}/`} rel="prev">{sura.prev.n}. {sura.prev.latin}</a> : <span></span>}
          <a href="/projects/tafsir/#suras">Sura {name.n} of 114</a>
          {sura.next ? <a href={`/projects/tafsir/sura/${sura.next.n}/`} rel="next">{sura.next.n}. {sura.next.latin}</a> : <span></span>}
        </nav>
        <h1 id="reader-title" class="hc-masthead__title">{name.latin} <span class="hc-quran tf-title-ar" lang="ar" dir="rtl">{name.ar}</span></h1>
        <p class="hc-masthead__lead">
          Sura {name.n}, {name.verses} verses{part.of > 1 ? `; this page holds verses ${part.first} to ${part.last}` : ""}.
          {present.length > 0
            ? <> {present.length} of the {works.length} early commentaries comment here, on {versesWithComment} of its verses.</>
            : <> None of the {works.length} early commentaries is placed at this sura yet.</>}
        </p>
        <div class="hc-masthead__actions">
          <a class="hc-btn" href="#verses">Read the verses</a>
          {sura.collated && <a class="hc-btn hc-btn--ghost" href={`/projects/quran/sura/${name.n}/`}>Variant readings in this sura</a>}
        </div>
      </div>
      <aside class="tf-status" aria-labelledby="tf-status-title">
        <p class="tf-eyebrow" id="tf-status-title">How to read the labels</p>
        <dl>
          <div><dt>Arabic</dt><dd>As printed in the Shamela edition named for each work, with its volume and page.</dd></div>
          <div><dt>Placement</dt><dd>Proposed. Each passage says how it was placed: a verse number printed in the text, the verse its heading quotes, or a verse cited in its section. No reviewer has checked the placements yet.</dd></div>
          <div><dt>English</dt><dd>Shown first wherever the source supplies it, and labelled with where it comes from; none of it is reviewed. Each commentary says whether its passages here have English. Most of the early works are not translated yet.</dd></div>
        </dl>
      </aside>
    </div>
  </header>

  <div class="hc-container tf-layout">
    <aside class="tf-panel" aria-labelledby="tf-panel-title">
      <p class="tf-eyebrow">Commentaries</p>
      <h2 id="tf-panel-title" class="tf-panel__title">Show or hide a work</h2>
      {present.length > 0 ? (
        <fieldset class="tf-picker">
          <legend class="sr-only">Commentaries shown on this page</legend>
          {present.map((work) => (
            <label class={`tf-pick era-${eraIdOf(work)}`}>
              <input type="checkbox" id={`tf-w-${work.id}`} checked />
              <i class="e-sq" aria-hidden="true"></i>
              <span class="tf-pick__name">{shortName(work)}</span>
              <span class="tf-pick__meta">d. {work.death_ah} AH · {workCountHere(work.id)} {workCountHere(work.id) === 1 ? "verse" : "verses"} on this page</span>
            </label>
          ))}
        </fieldset>
      ) : (
        <p class="tf-panel__note">No commentary is placed in this sura yet.</p>
      )}
      <p class="tf-panel__note">The color marks the era its author died in, not the book. Counts are verses with a passage, not a ranking.</p>
      <a class="hc-back-link hc-back-link--ruled" href="/projects/tafsir/#works">About the works</a>
    </aside>

    <section class="tf-verses" id="verses" aria-labelledby="verses-title">
      <header class="tf-section-head">
        <h2 id="verses-title">{part.of > 1 ? `Verses ${part.first} to ${part.last}` : "The verses"}</h2>
        <span>{verses.length} {verses.length === 1 ? "verse" : "verses"}</span>
      </header>

      {part.of > 1 && (
        <nav class="tf-parts" aria-label="Parts of this sura">
          {parts.map((p) => <a href={urlFor(p)} aria-current={p.index === part.index ? "page" : undefined}>{p.first}–{p.last}</a>)}
        </nav>
      )}

      <ol class="tf-list">
        {verses.map((verse) => {
          const count = verse.byWork.filter((row) => row.entries.length > 0).length;
          return (
            <li class="tf-verse" id={`v${verse.number}`}>
              <div class="tf-verse__head">
                <a class="tf-verse__ref" href={`#v${verse.number}`} aria-label={`Sura ${name.n}, verse ${verse.number}`}>{name.n}:{verse.number}</a>
                <span class="tf-verse__count">{count > 0 ? `${count} ${count === 1 ? "commentary" : "commentaries"}` : "No commentary placed here"}</span>
                {verse.features.length > 0 && (
                  <span class="tf-verse__readings">
                    Readings differ at{" "}
                    {verse.features.map((feature, i) => (
                      <>{i > 0 && ", "}<a href={feature.href} class="hc-quran" lang="ar">{feature.word}</a></>
                    ))}
                  </span>
                )}
              </div>

              <div class="tf-plate">
                <p class="tf-plate__en" lang="en">{verse.en ?? "English verse text is unavailable."}</p>
                <p class="tf-plate__ar hc-quran" lang="ar" dir="rtl">{verse.words.map((word) => word.text).join(" ")}</p>
              </div>

              {verse.byWork.map(({ work, entries, carried }) => (
                <div class={`tf-work era-${eraIdOf(work)}`} data-work={work.id}>
                  {entries.length > 0 ? (
                    <details class="tf-work__box" open={lengthOf(entries) <= FOLD_AT}>
                      <summary class="tf-work__summary">
                        <i class="e-sq" aria-hidden="true"></i>
                        <span class="tf-work__name">{shortName(work)}</span>
                        <span class="tf-work__meta">d. {work.death_ah} AH</span>
                        <span class="tf-work__n">{entries.length} {entries.length === 1 ? "passage" : "passages"}</span>
                        <span class="tf-work__lang">{languageOf(entries)}</span>
                      </summary>
                      {entries.map((entry) => (
                        <article class:list={["tf-pass", { "tf-pass--bi": Boolean(entry.text_en) }]}>
                          {entry.text_en && (
                            <div class="tf-pass__en" lang="en">
                              <p>{entry.text_en}</p>
                              <p class="tf-pass__label">{englishNote(entry.translation_status)}</p>
                            </div>
                          )}
                          <p class="tf-pass__ar" lang="ar" dir="rtl">
                            {quranSpans(entry.text_ar ?? entry.text).map((piece) => piece.startsWith("{") ? <span class="tf-q">{piece}</span> : piece)}
                          </p>
                          <p class="tf-pass__cite">
                            <span>{cite(entry)}</span>
                            {entry.printed_label && <span>Printed no. <span lang="ar" dir="rtl">{entry.printed_label.replace(/\s*-\s*$/, "")}</span></span>}
                            {range(entry) && <span>Covers {range(entry)}</span>}
                            <span>Placement proposed: {placementBasis(entry.locator_status)}</span>
                          </p>
                          {(entry.foot_note_ar || entry.foot_note_en) && (
                            <details class="tf-pass__notes">
                              <summary>Editor's notes</summary>
                              {entry.foot_note_en && <p lang="en">{entry.foot_note_en}</p>}
                              {entry.foot_note_ar && <p lang="ar" dir="rtl">{entry.foot_note_ar}</p>}
                            </details>
                          )}
                        </article>
                      ))}
                    </details>
                  ) : (
                    <p class="tf-work__carried">
                      <i class="e-sq" aria-hidden="true"></i>
                      {shortName(work)}: {carried.length === 1 ? "a passage" : `${carried.length} passages`} on a range of verses, printed at{" "}
                      {carried.map((entry, i) => {
                        const at = Math.max(entry.verses.from, part.first);
                        return <>{i > 0 && ", "}<a href={`#v${at}`}>{name.n}:{at}</a></>;
                      })}
                    </p>
                  )}
                </div>
              ))}
            </li>
          );
        })}
      </ol>

      {showSurahMaterial && (
        <section class="tf-surah" aria-labelledby="tf-surah-title">
          <header class="tf-section-head">
            <h2 id="tf-surah-title">Placed at the sura, not a verse</h2>
            <span>{surahMaterialCount} {surahMaterialCount === 1 ? "passage" : "passages"}</span>
          </header>
          <p class="tf-surah__lede">The sources put these passages under {name.latin} without a verse marker or citation that places them safely. They are kept here rather than given a verse.</p>
          {works.filter((work) => (sura.surahMaterial[work.id]?.length ?? 0) > 0).map((work) => (
            <details class={`tf-work tf-work__box era-${eraIdOf(work)}`} data-work={work.id}>
              <summary class="tf-work__summary">
                <i class="e-sq" aria-hidden="true"></i>
                <span class="tf-work__name">{shortName(work)}</span>
                <span class="tf-work__meta">d. {work.death_ah} AH</span>
                <span class="tf-work__n">{sura.surahMaterial[work.id].length} {sura.surahMaterial[work.id].length === 1 ? "passage" : "passages"}</span>
              </summary>
              {sura.surahMaterial[work.id].map((entry) => (
                <article class:list={["tf-pass", { "tf-pass--bi": Boolean(entry.text_en) }]}>
                  {entry.text_en && (
                    <div class="tf-pass__en" lang="en">
                      <p>{entry.text_en}</p>
                      <p class="tf-pass__label">{englishNote(entry.translation_status)}</p>
                    </div>
                  )}
                  <p class="tf-pass__ar" lang="ar" dir="rtl">
                    {quranSpans(entry.text_ar ?? entry.text).map((piece) => piece.startsWith("{") ? <span class="tf-q">{piece}</span> : piece)}
                  </p>
                  <p class="tf-pass__cite"><span>{cite(entry)}</span><span>Sura-level placement</span></p>
                </article>
              ))}
            </details>
          ))}
        </section>
      )}
      {part.index > 1 && surahMaterialCount > 0 && (
        <p class="tf-surah__lede">{surahMaterialCount} passages placed at the sura but not at a verse are listed on <a href={urlFor(parts[0])}>the first page of {name.latin}</a>.</p>
      )}

      <nav class="tf-pager" aria-label="Sura navigation">
        {previousPart
          ? <a href={urlFor(previousPart)} data-dir="prev">Verses {previousPart.first} to {previousPart.last}</a>
          : sura.prev ? <a href={`/projects/tafsir/sura/${sura.prev.n}/`} data-dir="prev">{sura.prev.n}. {sura.prev.latin}</a> : <span></span>}
        {nextPart
          ? <a href={urlFor(nextPart)} data-dir="next">Verses {nextPart.first} to {nextPart.last}</a>
          : sura.next ? <a href={`/projects/tafsir/sura/${sura.next.n}/`} data-dir="next">{sura.next.n}. {sura.next.latin}</a> : <span></span>}
      </nav>
    </section>
  </div>
</main>

<style is:inline set:html={pickerRules}></style>

<style>
  .tf-title-ar { margin-inline-start: 0.5rem; font-size: 0.78em; }
  .tf-crumbs { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.25rem 1rem; max-width: 34rem; margin: 0 0 1.25rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--hc-rule-soft); font: 500 0.85rem/1.4 var(--font-ui); }
  .tf-crumbs a { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; color: var(--hc-text-secondary); text-decoration: none; }
  .tf-crumbs a:hover { color: var(--hc-gold-bright); }
  .tf-crumbs a[rel="prev"]::before { content: "←" / ""; }
  .tf-crumbs a[rel="next"]::after { content: "→" / ""; }
  .tf-pager a[data-dir="prev"]::before { content: "←" / ""; }
  .tf-pager a[data-dir="next"]::after { content: "→" / ""; }
  .tf-eyebrow { margin: 0; color: var(--hc-gold); font: 700 0.75rem/1.4 var(--font-ui); letter-spacing: 0.12em; text-transform: uppercase; }

  .tf-status { align-self: center; max-width: 24rem; padding: 1.25rem 1.4rem; border-inline-start: 2px solid var(--hc-gold); background: var(--hc-surface-1); }
  .tf-status dl { display: grid; gap: 0.7rem; margin: 0.8rem 0 0; }
  .tf-status dt { color: var(--hc-text-primary); font: 600 0.85rem/1.4 var(--font-ui); }
  .tf-status dd { margin: 0.15rem 0 0; color: var(--hc-text-secondary); font: 400 0.88rem/1.55 var(--font-body); }

  .tf-layout { display: grid; grid-template-columns: minmax(14rem, 17rem) minmax(0, 1fr); align-items: start; gap: clamp(1.5rem, 4vw, 3.5rem); padding-block: clamp(2rem, 5vw, 4rem); }
  .tf-panel { position: sticky; top: calc(var(--site-header-height, 72px) + 1.5rem); padding: 1.2rem; border: 1px solid var(--hc-rule); background: var(--hc-surface-1); }
  .tf-panel__title { margin: 0.3rem 0 0.9rem; color: var(--hc-text-primary); font: 500 1.15rem/1.3 var(--font-display); }
  .tf-panel__note { margin: 0.9rem 0; color: var(--hc-text-tertiary); font: 400 0.8rem/1.6 var(--font-body); }
  .tf-picker { display: grid; gap: 0.15rem; margin: 0; padding: 0; border: 0; }
  .tf-pick { display: grid; grid-template-columns: auto auto minmax(0, 1fr); align-items: center; gap: 0.15rem 0.55rem; min-height: 44px; padding: 0.4rem 0.3rem; border-bottom: 1px solid var(--hc-rule-soft); cursor: pointer; }
  .tf-pick input { width: 1rem; height: 1rem; margin: 0; accent-color: var(--hc-gold); }
  .tf-pick__name { color: var(--hc-text-primary); font: 600 0.9rem/1.3 var(--font-body); }
  .tf-pick__meta { grid-column: 3; color: var(--hc-text-tertiary); font: 400 0.75rem/1.4 var(--font-ui); }
  .tf-pick:has(input:not(:checked)) .tf-pick__name { color: var(--hc-text-tertiary); text-decoration: line-through; }

  .tf-section-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--hc-rule); }
  .tf-section-head h2 { margin: 0; color: var(--hc-text-primary); font: 500 clamp(1.35rem, 2.5vw, 1.8rem)/1.2 var(--font-display); }
  .tf-section-head > span { color: var(--hc-text-secondary); font: 500 0.8rem/1.5 var(--font-ui); }
  .tf-parts { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-block: 1rem; }
  .tf-parts a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 0.7rem; border: 1px solid var(--hc-rule); color: var(--hc-text-secondary); font: 600 0.78rem/1.3 var(--font-ui); font-variant-numeric: tabular-nums; text-decoration: none; }
  .tf-parts a:hover { color: var(--hc-text-primary); border-color: var(--hc-gold-dim); }
  .tf-parts a[aria-current="page"] { border-color: var(--hc-gold); color: var(--hc-gold); }

  .tf-list { margin: 0; padding: 0; list-style: none; }
  .tf-verse { padding: 1.5rem 0 1.75rem; border-bottom: 1px solid var(--hc-rule-soft); scroll-margin-top: 6.5rem; }
  .tf-verse__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1rem; margin-bottom: 0.75rem; }
  .tf-verse__ref { color: var(--hc-gold); font: 700 0.85rem/1.4 var(--font-ui); font-variant-numeric: tabular-nums; text-decoration: none; }
  .tf-verse__count { color: var(--hc-text-secondary); font: 500 0.8rem/1.4 var(--font-ui); }
  .tf-verse__readings { color: var(--hc-text-tertiary); font: 400 0.8rem/1.6 var(--font-ui); }
  .tf-verse__readings a { color: var(--hc-text-secondary); font-size: 1.05rem; text-decoration-color: var(--hc-rule); }
  .tf-verse__readings a:hover { color: var(--hc-gold-bright); }

  .tf-plate { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.25rem; align-items: start; }
  .tf-plate__en, .tf-plate__ar { margin: 0; color: var(--hc-text-primary); }
  .tf-plate__en { font: 400 1rem/1.85 var(--font-body); }
  .tf-plate__ar { font-size: 1.45rem; line-height: 2.05; text-align: right; }

  .tf-work { margin-top: 0.9rem; }
  .tf-work__box { border: 1px solid var(--hc-rule-soft); border-inline-start: 3px solid var(--e-line); background: var(--hc-surface-1); }
  .tf-work__summary { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.7rem; min-height: 44px; padding: 0.55rem 0.9rem; cursor: pointer; list-style: none; }
  .tf-work__summary::-webkit-details-marker { display: none; }
  .tf-work__summary::after { content: '+'; margin-inline-start: auto; color: var(--hc-gold); font: 600 1rem/1 var(--font-ui); }
  details[open] > .tf-work__summary::after { content: '−'; }
  .tf-work__name { color: var(--hc-text-primary); font: 600 0.95rem/1.3 var(--font-body); }
  .tf-work__meta { color: var(--hc-text-tertiary); font: 400 0.78rem/1.4 var(--font-ui); }
  .tf-work__n { color: var(--hc-text-secondary); font: 500 0.78rem/1.4 var(--font-ui); }
  .tf-work__lang { padding: 0.05rem 0.45rem; border: 1px solid var(--hc-rule); color: var(--hc-text-secondary); font: 500 0.75rem/1.4 var(--font-ui); }
  .tf-work__carried { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.5rem; margin: 0; padding: 0.35rem 0.2rem; color: var(--hc-text-tertiary); font: 400 0.82rem/1.5 var(--font-ui); }
  .tf-work__carried a { color: var(--hc-text-secondary); }

  .tf-pass { display: grid; gap: 0.6rem; margin: 0; padding: 0.9rem 1rem 1rem; border-top: 1px solid var(--hc-rule-soft); }
  .tf-pass--bi { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 1.25rem; }
  .tf-pass--bi .tf-pass__cite, .tf-pass--bi .tf-pass__notes { grid-column: 1 / -1; }
  .tf-pass__en p { margin: 0; color: var(--hc-text-primary); font: 400 0.95rem/1.75 var(--font-body); }
  .tf-pass__en .tf-pass__label { margin-top: 0.45rem; color: var(--hc-text-tertiary); font: 500 0.75rem/1.45 var(--font-ui); }
  .tf-pass__ar { margin: 0; color: var(--hc-text-primary); font: 400 1.2rem/2 var(--font-arabic); text-align: right; white-space: pre-line; }
