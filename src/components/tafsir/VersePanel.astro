---
/* The Qur'anic verse in Arabic and English, before the commentary begins. */
import Icon from './Icon.astro';
import { pad } from '../../lib/tafsir-render';

interface Props {
  surah: number;
  verse: number;
  name: string;
  arabic: string;
  english: string;
  englishSource?: string;
  begin: string | null;
}

const { surah, verse, name, arabic, english, englishSource = 'Rashad Khalifa translation', begin } = Astro.props;
const ref = `${surah}:${verse}`;
---

<figure class="tfr-verse" id="verse-text" aria-labelledby="verse-heading">
  <div class="tfr-verse__heading">
    <div>
      <span class="micro tfr-verse__kicker">The Qur'anic text</span>
      <h3 id="verse-heading">The verse, before its interpretation.</h3>
    </div>
    <span class="tfr-verse__number" aria-label={`Surah ${surah}, verse ${verse}`}><span>{pad(surah)}</span><i>/</i><strong>{pad(verse)}</strong></span>
  </div>
  <div class="tfr-verse__body">
    <p class="tfr-verse__ar" lang="ar" dir="rtl" data-verse-ar>{arabic}</p>
    <div class="tfr-verse__rule" role="presentation"><span aria-hidden="true">✳</span></div>
    <p class="tfr-verse__en" lang="en" data-verse-en>{english}</p>
    <div class="tfr-verse__attribution micro"><span>Arabic <b>Reference text</b></span><span>English <b>{englishSource}</b></span></div>
  </div>
  <figcaption class="tfr-verse__bottom">
    <span>Q {ref} <span aria-hidden="true">·</span> {name}</span>
    <div class="tfr-verse__buttons">
      <button type="button" class="tfr-button" data-share-verse aria-label={`Share Q ${ref} in Arabic and English`}><Icon name="share" size={14} /> Share verse</button>
      {begin && <a class="tfr-button tfr-button--solid" href={begin}>Begin commentary <Icon name="down" size={14} /></a>}
    </div>
  </figcaption>
</figure>
