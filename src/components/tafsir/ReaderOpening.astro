---
/* The top of every Tafsīr reader page: the surah, the work, and its author.
   It sits under the site's own header, which reads clear over this dark band. */
import type { LibraryWork } from '../../data/tafsir-library';

interface Props {
  work: LibraryWork;
  title: string;
  /** Set in small type after the title: "2:14". */
  reference?: string;
  subtitle: string;
  meta: string[];
}

const { work, title, reference, subtitle, meta } = Astro.props;
---

<section class="opening tfx-dark-top"><div class="wrap"><div class="opening__aside">
  <span class="opening__eyebrow overline">The Qur’an · Tafsīr</span>
  <h1 id="pageTitle">{title}{reference && <Fragment> <span class="tfv-ref">{reference}</span></Fragment>}</h1>
  <p class="opening__subtitle">{subtitle}</p>
  <div class="opening__meta">{meta.map((item) => <span>{item}</span>)}</div>
  <div class="scholar">
    {work.portrait && (
      <span aria-label={`Illustrative portrait of ${work.name}; not a verified likeness`} class="portrait-slot" data-region={work.region} role="img"><img alt="" aria-hidden="true" decoding="async" loading="lazy" src={`/images/tafsir/figures/${work.portrait}.webp`} /></span>
    )}
    <div class="scholar__copy"><strong>{work.author}</strong><span>{work.attribution} · d. {work.died} AH</span></div>
  </div>
</div></div></section>
