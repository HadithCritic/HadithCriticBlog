---
interface Heading { depth: number; text: string; slug: string; }
const { headings = [] } = Astro.props as { headings: Heading[] };
---
{headings.length > 0 && (
  <details class="mobile-article-toc">
    <summary>In this study</summary>
    <ol>
      {headings.map((heading) => <li class:list={{ 'is-subheading': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
    </ol>
  </details>
)}

<style>
  .mobile-article-toc { margin: 1.5rem auto; max-width: var(--wrap-reading); border-block: 1px solid var(--hc-rule); color: var(--hc-text-secondary); }
  summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; color: var(--hc-gold-soft); font-family: var(--font-ui); font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  ol { margin: 0 0 1rem; padding-left: 1.2rem; }
  li { margin: .45rem 0; } .is-subheading { margin-left: .85rem; }
  a { color: inherit; text-underline-offset: .2em; }
  @media (min-width: 1200px) { .mobile-article-toc { display: none; } }
</style>
