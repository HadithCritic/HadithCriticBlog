---
import scholarsData from '../../data/shirk-endorsed/scholars.json';

const centuries = [
  { id: 'all', label: 'All Centuries' },
  { id: '4', label: '4th AH' },
  { id: '5', label: '5th AH' },
  { id: '6', label: '6th AH' },
  { id: '7', label: '7th AH' },
  { id: '8', label: '8th AH' },
  { id: '9', label: '9th AH' },
  { id: '10', label: '10th AH' },
  { id: '11', label: '11th AH' },
  { id: '12', label: '12th AH' },
  { id: '13', label: '13th AH' },
  { id: '14', label: '14th AH' }
];

const madhhabs = [
  { id: 'all', label: 'All Schools' },
  { id: 'Shafii', label: 'Shāfiʿī' },
  { id: 'Hanafi', label: 'Ḥanafī' },
  { id: 'Hanbali', label: 'Ḥanbalī' },
  { id: 'Maliki', label: 'Mālikī' }
];
---

<section class="scholar-ledger" id="scholar-ledger">
  <div class="ledger-header">
    <div class="ledger-title-group">
      <span class="ledger-eyebrow">Archival Evidence Ledger</span>
      <h2 class="ledger-title">Register of 99 Classical Sunni Authorities</h2>
      <p class="ledger-subtitle">
        Chronological testimonies spanning ten centuries, documenting explicit scholarly consensus on the permissibility of Tawassul, Tashaffuʿ, and Istighāthah.
      </p>
    </div>

    <!-- Controls -->
    <div class="ledger-controls">
      <div class="search-box">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input
          type="text"
          id="scholarSearch"
          class="search-input"
          placeholder="Search by scholar, book, or citation..."
          aria-label="Search scholars"
        />
        <button type="button" id="clearSearch" class="clear-btn" aria-label="Clear search" hidden>×</button>
      </div>

      <!-- Madhhab Filter -->
      <div class="filter-row">
        <span class="filter-label">School:</span>
        <div class="filter-chips" role="radiogroup" aria-label="Filter by school of jurisprudence">
          {madhhabs.map((m) => (
            <button
              type="button"
              class={`filter-chip ${m.id === 'all' ? 'is-active' : ''}`}
              data-filter-madhhab={m.id}
            >
              {m.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Century Filter -->
      <div class="filter-row">
        <span class="filter-label">Era:</span>
        <div class="filter-chips filter-chips--centuries" role="radiogroup" aria-label="Filter by century">
          {centuries.map((c) => (
            <button
              type="button"
              class={`filter-chip ${c.id === 'all' ? 'is-active' : ''}`}
              data-filter-century={c.id}
            >
              {c.label}
            </button>
          ))}
        </div>
      </div>

      <div class="ledger-status-bar">
        <span id="ledgerCount" class="ledger-count">Showing 99 of 99 scholars</span>
        <span class="ledger-sort-hint">Chronologically ordered by death date (Hijri)</span>
      </div>
    </div>
  </div>

  <!-- Ledger Rows -->
  <div class="ledger-list" id="ledgerList">
    {scholarsData.map((s, idx) => (
      <article
        class="ledger-row"
        data-scholar-id={s.id}
        data-century={s.century || ''}
        data-madhhab={s.madhhab.toLowerCase()}
        data-search-text={`${s.title} ${s.name} ${s.madhhab} ${s.deathYear || ''} ${s.arabicExcerpt || ''}`.toLowerCase()}
      >
        <div class="ledger-row__header">
          <div class="ledger-row__meta">
            <span class="era-badge">{s.deathYear ? `d. ${s.deathYear} AH` : 'Classical'}</span>
            <span class="century-tag">{s.century ? `${s.century}th Century AH` : ''}</span>
            <span class={`madhhab-tag madhhab-tag--${s.madhhab.toLowerCase().replace(/[^a-z]/g, '')}`}>
              {s.madhhab}
            </span>
          </div>
          <h3 class="scholar-name">
            <a href={`/research/shirk-endorsed/${s.id}`} class="scholar-link">
              <span class="scholar-num">{idx + 1}.</span> {s.title}
            </a>
          </h3>
        </div>

        <div class="ledger-row__content">
          {s.arabicExcerpt && (
            <div class="arabic-quote-box" dir="rtl" lang="ar">
              <p class="arabic-text">{s.arabicExcerpt}</p>
            </div>
          )}

          {s.scans && s.scans.length > 0 && (
            <div class="scans-preview">
              <span class="scans-label">Primary Source Scans ({s.scans.length}):</span>
              <div class="scans-thumbnails">
                {s.scans.map((scanUrl, sIdx) => (
                  <button
                    type="button"
                    class="scan-thumb-btn"
                    data-lightbox-src={scanUrl}
                    data-lightbox-title={`${s.title} - Page Scan ${sIdx + 1}`}
                    data-lightbox-caption={`Primary source manuscript/print proof citation for ${s.name}`}
                    aria-label={`View manuscript scan ${sIdx + 1} for ${s.name}`}
                  >
                    <img src={scanUrl} alt={`${s.name} scan ${sIdx + 1}`} loading="lazy" class="scan-thumb-img" />
                    <span class="scan-zoom-badge">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                      Scan {sIdx + 1}
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>

        <div class="ledger-row__actions">
          <a href={`/research/shirk-endorsed/${s.id}`} class="read-dossier-link">
            Read Complete Citation & Analysis →
          </a>
        </div>
      </article>
    ))}
  </div>

  <div id="noResults" class="no-results" hidden>
    <p>No scholars match your current filter criteria.</p>
    <button type="button" id="resetFilters" class="reset-btn">Reset All Filters</button>
  </div>
</section>

<style>
  .scholar-ledger {
    margin: 3.5rem 0;
    padding-top: 2rem;
    border-top: 1px solid var(--hc-rule-strong, rgba(212, 175, 55, 0.25));
  }

  .ledger-header {
    margin-bottom: 2.5rem;
  }

  .ledger-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--hc-gold, #c8a755);
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .ledger-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--hc-text-primary, #f5f2eb);
    font-family: var(--font-display, serif);
    font-weight: 600;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .ledger-subtitle {
    font-size: 1.05rem;
    color: var(--hc-text-secondary, #b5b0a5);
    line-height: 1.6;
    max-width: 48rem;
    margin: 0;
  }

  /* Controls */
  .ledger-controls {
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--hc-surface-1, #141416);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--hc-text-tertiary, #75716b);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.8rem 2.75rem 0.8rem 2.6rem;
    background: var(--hc-surface-0, #0c0c0d);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.12));
    border-radius: 3px;
    color: var(--hc-text-primary, #f5f2eb);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.95rem;
    transition: border-color 0.15s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--hc-gold, #c8a755);
  }

  .clear-btn {
    position: absolute;
    right: 0.75rem;
    background: transparent;
    border: none;
    color: var(--hc-text-secondary, #a8a5a0);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0.2rem 0.5rem;
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hc-text-tertiary, #858077);
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    min-width: 4rem;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-chip {
    padding: 0.35rem 0.75rem;
    background: var(--hc-surface-0, #0c0c0d);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.1));
    color: var(--hc-text-secondary, #b5b0a5);
    font-size: 0.78rem;
    font-family: var(--font-ui, sans-serif);
    font-weight: 500;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-chip:hover {
    color: var(--hc-text-primary, #f5f2eb);
    border-color: var(--hc-rule-strong, rgba(212, 175, 55, 0.4));
  }

  .filter-chip.is-active {
    background: rgba(200, 167, 85, 0.15);
    border-color: var(--hc-gold, #c8a755);
    color: var(--hc-gold, #c8a755);
    font-weight: 600;
  }

  .ledger-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.06));
    font-size: 0.78rem;
    color: var(--hc-text-tertiary, #858077);
    font-family: var(--font-ui, sans-serif);
  }

  .ledger-count {
    color: var(--hc-gold, #c8a755);
    font-weight: 600;
  }

  /* List */
  .ledger-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .ledger-row {
    background: var(--hc-surface-1, #141416);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
    border-radius: 4px;
    padding: 1.5rem;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .ledger-row:hover {
    border-color: var(--hc-rule-strong, rgba(212, 175, 55, 0.35));
    background: var(--hc-surface-2, #18181b);
  }

  .ledger-row__header {
    margin-bottom: 1rem;
  }

  .ledger-row__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.45rem;
  }

  .era-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--hc-gold, #c8a755);
    font-family: var(--font-ui, sans-serif);
    letter-spacing: 0.05em;
  }

  .century-tag {
    font-size: 0.72rem;
    color: var(--hc-text-tertiary, #858077);
    font-family: var(--font-ui, sans-serif);
  }

  .madhhab-tag {
    font-size: 0.68rem;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-ui, sans-serif);
    font-weight: 600;
    background: rgba(255, 255, 255, 0.05);
    color: var(--hc-text-secondary, #b5b0a5);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.1));
  }

  .scholar-name {
    font-size: 1.25rem;
    margin: 0;
    font-family: var(--font-display, serif);
    font-weight: 600;
    line-height: 1.3;
  }

  .scholar-link {
    color: var(--hc-text-primary, #f5f2eb);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .scholar-link:hover {
    color: var(--hc-gold, #c8a755);
  }

  .scholar-num {
    color: var(--hc-gold-soft, rgba(200, 167, 85, 0.6));
    font-weight: 400;
    margin-right: 0.25rem;
  }

  /* Content */
  .arabic-quote-box {
    margin: 1rem 0;
    padding: 1rem 1.25rem;
    background: rgba(200, 167, 85, 0.04);
    border-right: 3px solid var(--hc-gold, #c8a755);
    border-radius: 2px;
  }

  .arabic-text {
    font-family: 'Amiri', 'Scheherazade New', serif;
    font-size: 1.25rem;
    line-height: 2.1;
    color: var(--hc-text-primary, #f5f2eb);
    margin: 0;
  }

  .scans-preview {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--hc-rule, rgba(255, 255, 255, 0.07));
  }

  .scans-label {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hc-text-tertiary, #858077);
    font-family: var(--font-ui, sans-serif);
    margin-bottom: 0.65rem;
    font-weight: 600;
  }

  .scans-thumbnails {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .scan-thumb-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0;
    background: #09090a;
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.12));
    border-radius: 2px;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .scan-thumb-btn:hover {
    transform: translateY(-2px);
    border-color: var(--hc-gold, #c8a755);
  }

  .scan-thumb-img {
    width: 90px;
    height: 110px;
    object-fit: cover;
    display: block;
  }

  .scan-zoom-badge {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.65rem;
    color: var(--hc-gold, #c8a755);
    padding: 0.2rem 0.4rem;
    background: var(--hc-surface-2, #18181b);
    width: 100%;
    justify-content: center;
    font-family: var(--font-ui, sans-serif);
  }

  .ledger-row__actions {
    margin-top: 1.25rem;
    display: flex;
    justify-content: flex-end;
  }

  .read-dossier-link {
    font-size: 0.82rem;
    color: var(--hc-gold, #c8a755);
    text-decoration: none;
    font-family: var(--font-ui, sans-serif);
    font-weight: 600;
    transition: gap 0.15s ease;
  }

  .read-dossier-link:hover {
    text-decoration: underline;
  }

  .no-results {
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--hc-surface-1, #141416);
    border: 1px solid var(--hc-rule, rgba(255, 255, 255, 0.08));
    border-radius: 4px;
    margin-top: 2rem;
    color: var(--hc-text-secondary, #b5b0a5);
  }

  .reset-btn {
    margin-top: 1rem;
    padding: 0.5rem 1.2rem;
    background: rgba(200, 167, 85, 0.15);
    border: 1px solid var(--hc-gold, #c8a755);
    color: var(--hc-gold, #c8a755);
    font-family: var(--font-ui, sans-serif);
    font-weight: 600;
    border-radius: 3px;
    cursor: pointer;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('scholarSearch');
    const clearBtn = document.getElementById('clearSearch');
    const madhhabChips = document.querySelectorAll('[data-filter-madhhab]');
    const centuryChips = document.querySelectorAll('[data-filter-century]');
    const rows = document.querySelectorAll('.ledger-row');
    const countDisplay = document.getElementById('ledgerCount');
    const noResults = document.getElementById('noResults');
    const resetBtn = document.getElementById('resetFilters');

    let activeMadhhab = 'all';
    let activeCentury = 'all';
    let searchQuery = '';

    function filterRows() {
      let visibleCount = 0;

      rows.forEach((row) => {
        const rowCentury = row.getAttribute('data-century');
        const rowMadhhab = row.getAttribute('data-madhhab') || '';
        const rowSearch = row.getAttribute('data-search-text') || '';

        // Check madhhab
        let matchesMadhhab = true;
        if (activeMadhhab !== 'all') {
          matchesMadhhab = rowMadhhab.includes(activeMadhhab.toLowerCase());
        }

        // Check century
        let matchesCentury = true;
        if (activeCentury !== 'all') {
          matchesCentury = rowCentury === activeCentury;
        }

        // Check search query
        let matchesSearch = true;
        if (searchQuery.trim()) {
          const query = searchQuery.toLowerCase().trim();
          matchesSearch = rowSearch.includes(query);
        }

        if (matchesMadhhab && matchesCentury && matchesSearch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} of ${rows.length} scholars`;
      }

      if (noResults) {
        noResults.hidden = visibleCount > 0;
      }
    }

    // Madhhab selection
    madhhabChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        madhhabChips.forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        activeMadhhab = chip.getAttribute('data-filter-madhhab') || 'all';
        filterRows();
      });
    });

    // Century selection
    centuryChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        centuryChips.forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        activeCentury = chip.getAttribute('data-filter-century') || 'all';
        filterRows();
      });
    });

    // Search input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        if (clearBtn) {
          clearBtn.hidden = !searchQuery;
        }
        filterRows();
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearBtn.hidden = true;
        searchInput.focus();
        filterRows();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        activeMadhhab = 'all';
        activeCentury = 'all';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        if (clearBtn) clearBtn.hidden = true;

        madhhabChips.forEach((c) => c.classList.remove('is-active'));
        centuryChips.forEach((c) => c.classList.remove('is-active'));
        const defaultM = document.querySelector('[data-filter-madhhab="all"]');
        const defaultC = document.querySelector('[data-filter-century="all"]');
        if (defaultM) defaultM.classList.add('is-active');
        if (defaultC) defaultC.classList.add('is-active');

        filterRows();
      });
    }
  });
</script>
