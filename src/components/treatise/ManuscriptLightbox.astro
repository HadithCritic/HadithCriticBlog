---
// Manuscript Lightbox Modal for Primary Source Scans
---

<div
  id="manuscriptLightbox"
  class="manuscript-lightbox"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="lightboxTitle"
  hidden
>
  <div class="lightbox-backdrop" data-lightbox-close></div>

  <div class="lightbox-dialog">
    <header class="lightbox-header">
      <div class="lightbox-meta">
        <span class="lightbox-eyebrow">Primary Source Manuscript Scan</span>
        <h3 id="lightboxTitle" class="lightbox-title">Manuscript Citation</h3>
      </div>

      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close manuscript viewer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <div class="lightbox-body">
      <div class="lightbox-image-container">
        <img id="lightboxImg" src="" alt="Primary Source Scan" class="lightbox-image" />
      </div>
    </div>

    <footer class="lightbox-footer">
      <span id="lightboxCaption" class="lightbox-caption">Original Manuscript / Reference Edition Proof</span>
      <a id="lightboxDownload" href="" target="_blank" rel="noopener noreferrer" class="lightbox-open-full">
        Open Full Image ↗
      </a>
    </footer>
  </div>
</div>

<style>
  .manuscript-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: var(--hc-surface-0);
    opacity: 0;
    visibility: hidden;
    transition: opacity 180ms ease, visibility 180ms ease;
  }

  .manuscript-lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--hc-surface-0) 96%, transparent);
    backdrop-filter: blur(8px);
  }

  .lightbox-dialog {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    width: min(96vw, 1400px);
    height: min(94vh, 1100px);
    background: var(--hc-surface-0);
    border-top: 1px solid var(--hc-rule-strong);
    border-bottom: 1px solid var(--hc-rule);
  }

  .lightbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .lightbox-meta {
    min-width: 0;
    padding-left: 0.1rem;
  }

  .lightbox-eyebrow {
    display: block;
    margin-bottom: 0.22rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--hc-gold);
  }

  .lightbox-title {
    max-width: 72ch;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--hc-text-primary);
  }

  .lightbox-close {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--hc-text-tertiary);
    cursor: pointer;
    transition: color 160ms ease;
  }

  .lightbox-close:hover {
    color: var(--hc-text-primary);
  }

  .lightbox-body {
    min-height: 0;
    overflow: auto;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 3vw, 2rem) 0;
    background: #09090a;
  }

  .lightbox-image-container {
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
  }

  .lightbox-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lightbox-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .lightbox-caption {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-ui);
    font-size: 0.77rem;
    line-height: 1.35;
    color: var(--hc-text-tertiary);
  }

  .lightbox-open-full {
    flex: 0 0 auto;
    font-family: var(--font-ui);
    font-size: 0.77rem;
    font-weight: 600;
    color: var(--hc-gold);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .lightbox-open-full:hover {
    color: var(--hc-gold-bright);
  }

  @media (max-width: 640px) {
    .manuscript-lightbox {
      padding: 0.65rem;
    }

    .lightbox-dialog {
      width: 100%;
      height: 96vh;
    }

    .lightbox-title {
      font-size: 1.06rem;
    }

    .lightbox-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .manuscript-lightbox,
    .lightbox-close,
    .lightbox-open-full {
      transition: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('manuscriptLightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxTitle = document.getElementById('lightboxTitle');
    const lightboxCaption = document.getElementById('lightboxCaption');
    const lightboxDownload = document.getElementById('lightboxDownload');

    let lastFocused = null;

    function openLightbox(src, title, caption, trigger) {
      if (!lightbox || !lightboxImg || !src) return;
      lastFocused = trigger instanceof HTMLElement ? trigger : document.activeElement;
      lightboxImg.setAttribute('src', src);
      if (lightboxTitle) lightboxTitle.textContent = title || 'Manuscript Citation';
      if (lightboxCaption) lightboxCaption.textContent = caption || 'Primary Source Evidence';
      if (lightboxDownload) lightboxDownload.href = src;

      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        lightbox.querySelector('.lightbox-close')?.focus();
      });
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');

      window.setTimeout(() => {
        lightbox.hidden = true;
        if (lightboxImg) lightboxImg.removeAttribute('src');
        if (lightboxDownload) lightboxDownload.removeAttribute('href');
        document.body.style.overflow = '';
        if (lastFocused instanceof HTMLElement) lastFocused.focus();
      }, 180);
    }

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      const trigger = target.closest('[data-lightbox-src]');
      if (trigger) {
        event.preventDefault();
        openLightbox(
          trigger.getAttribute('data-lightbox-src'),
          trigger.getAttribute('data-lightbox-title') || '',
          trigger.getAttribute('data-lightbox-caption') || '',
          trigger
        );
        return;
      }

      if (target.closest('[data-lightbox-close]')) {
        event.preventDefault();
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (!lightbox || lightbox.hidden) return;
      if (event.key === 'Escape') closeLightbox();
    });
  });
</script>
