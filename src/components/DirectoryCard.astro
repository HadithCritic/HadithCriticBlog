---
interface Props {
  href: string;
  title: string;
  description: string;
  label: string;
  theme?: 'charcoal' | 'parchment' | 'umber';
  imgSrc?: string;
}

const { 
  href, 
  title, 
  description, 
  label, 
  theme = 'charcoal',
  imgSrc
} = Astro.props;

const themeClass = theme === 'parchment' 
  ? 'hc-directory-card--parchment' 
  : theme === 'umber' 
    ? 'hc-directory-card--umber' 
    : '';

const cardClass = `hc-directory-card ${themeClass}`;
---
<a href={href} class={cardClass}>
  <div class="card-inner">
    <span class="hc-label">{label}</span>
    <h3 class="hc-title">{title}</h3>
    <p class="hc-copy">{description}</p>
  </div>
  {imgSrc && <img src={imgSrc} alt="" loading="lazy" />}
</a>

<style>
  .hc-directory-card {
    position: relative;
    min-height: 340px;
    overflow: hidden;
    padding: 0;
  }

  .hc-directory-card .card-inner {
    position: relative;
    z-index: 2;
    min-height: inherit;
    padding: clamp(1.35rem, 2vw, 2rem);
    display: flex;
    flex-direction: column;
  }

  .hc-directory-card h3 {
    margin: 0.6rem 0 0.65rem;
    font-size: clamp(2.4rem, 4vw, 4.2rem);
    line-height: 0.92;
  }

  .hc-directory-card p {
    max-width: 28ch;
    margin: 0;
    font-size: 0.98rem;
  }

  .hc-directory-card img {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 42%;
    object-fit: cover;
    opacity: 0.42;
    filter: sepia(0.4) contrast(1.12);
    mix-blend-mode: luminosity;
    transition: transform 500ms var(--ease), opacity 300ms var(--ease);
  }

  .hc-directory-card:hover img {
    transform: scale(1.04) translateY(-4px);
    opacity: 0.58;
  }
</style>
