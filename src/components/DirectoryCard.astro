---
interface Props {
  href: string;
  title: string;
  description: string;
  label: string;
  ctaText: string;
  theme?: 'charcoal' | 'parchment';
  icon?: string;
}

const { 
  href, 
  title, 
  description, 
  label, 
  ctaText,
  theme = 'charcoal',
  icon
} = Astro.props;

const cardClass = theme === 'parchment' ? 'hc-card--parchment' : 'hc-card';
---
<a href={href} class={`directory-card ${cardClass}`}>
  <div class="card-inner">
    <div class="card-header">
      <span class="hc-label">{label}</span>
      {icon && <i class={`fa-solid ${icon} card-icon`}></i>}
    </div>
    
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    
    <div class="card-footer">
      <span class="cta-text">{ctaText} <i class="fa-solid fa-arrow-right"></i></span>
    </div>
  </div>
</a>

<style>
  .directory-card {
    display: block;
    text-decoration: none;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease), border-color 300ms ease;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .directory-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 32px 90px rgba(0, 0, 0, 0.45);
    border-color: var(--hc-gold-dim);
  }

  .hc-card--parchment:hover {
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.25);
  }

  .card-inner {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .card-icon {
    color: var(--hc-gold-dim);
    font-size: 1.2rem;
    opacity: 0.6;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 500;
    margin: 0 0 1rem;
    line-height: 1.1;
    color: inherit;
    letter-spacing: -0.02em;
  }

  .hc-card .card-title {
    color: var(--hc-parchment);
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 2rem;
    flex-grow: 1;
    opacity: 0.85;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .hc-card--parchment .card-footer {
    border-top-color: rgba(157, 122, 60, 0.2);
  }

  .cta-text {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hc-gold);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap 200ms ease;
  }

  .directory-card:hover .cta-text {
    gap: 0.8rem;
  }

  .hc-card--parchment .cta-text {
    color: var(--hc-umber-dark);
  }
</style>
