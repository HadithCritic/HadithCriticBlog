---
export interface Props {
  prevUrl?: string;
  prevTitle?: string;
  nextUrl?: string;
  nextTitle?: string;
}
const { prevUrl, prevTitle, nextUrl, nextTitle } = Astro.props;
---
<div class="hc-prev-next">
  {prevUrl ? (
    <a href={prevUrl} class="nav-card prev-card">
      <span class="nav-label">
        <span class="nav-arrow" aria-hidden="true">←</span>
        <span>Previous Study</span>
      </span>
      <span class="nav-title">{prevTitle}</span>
    </a>
  ) : <div class="nav-placeholder"></div>}
  
  {nextUrl ? (
    <a href={nextUrl} class="nav-card next-card">
      <span class="nav-label">
        <span>Next Study</span>
        <span class="nav-arrow" aria-hidden="true">→</span>
      </span>
      <span class="nav-title">{nextTitle}</span>
    </a>
  ) : <div class="nav-placeholder"></div>}
</div>

<style>
  .hc-prev-next {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 4.5rem;
    margin-bottom: 2rem;
  }

  .nav-placeholder {
    display: none;
  }

  .nav-card {
    padding: 1.5rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease, background 200ms ease;
    display: flex;
    flex-direction: column;
    background:
      linear-gradient(
        140deg,
        color-mix(in srgb, var(--hc-surface-2) 85%, transparent),
        color-mix(in srgb, var(--hc-surface-1) 95%, transparent)
      );
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    min-width: 0;
  }

  .nav-card:hover {
    transform: translateY(-2px);
    border-color: var(--hc-gold);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22), 0 0 12px rgba(216, 177, 102, 0.15);
  }

  .next-card {
    text-align: right;
    align-items: flex-end;
  }

  .nav-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.65rem;
  }

  .nav-arrow {
    font-size: 0.9rem;
    transition: transform 200ms ease;
  }

  .prev-card:hover .nav-arrow {
    transform: translateX(-3px);
  }

  .next-card:hover .nav-arrow {
    transform: translateX(3px);
  }

  .nav-title {
    color: var(--hc-text-primary);
    font-family: var(--font-display);
    font-size: 1.18rem;
    line-height: 1.25;
    font-weight: 500;
    transition: color 200ms ease;
  }

  .nav-card:hover .nav-title {
    color: var(--hc-gold-soft);
  }

  :global([data-theme="light"]) .nav-card {
    background:
      linear-gradient(140deg, rgba(251, 249, 244, 0.98), rgba(244, 239, 229, 0.96));
    border-color: var(--hc-rule);
    box-shadow: 0 10px 30px rgba(43, 40, 36, 0.08);
  }

  @media (max-width: 640px) {
    .hc-prev-next {
      grid-template-columns: 1fr;
      margin-top: 3rem;
      gap: 1rem;
    }

    .nav-card {
      padding: 1.15rem;
    }

    .next-card {
      text-align: left;
      align-items: flex-start;
    }

    .next-card .nav-label {
      flex-direction: row-reverse;
      justify-content: flex-end;
    }
  }
</style>
