---
export interface Props {
  prevUrl?: string;
  prevTitle?: string;
  nextUrl?: string;
  nextTitle?: string;
}
const { prevUrl, prevTitle, nextUrl, nextTitle } = Astro.props;
---
<div class="hc-prev-next">
  {prevUrl ? (
    <a href={prevUrl} class="nav-card prev-card">
      <span class="nav-label hc-small">Previous</span>
      <span class="nav-title">{prevTitle}</span>
    </a>
  ) : <div></div>}
  
  {nextUrl ? (
    <a href={nextUrl} class="nav-card next-card">
      <span class="nav-label hc-small">Next</span>
      <span class="nav-title">{nextTitle}</span>
    </a>
  ) : <div></div>}
</div>
<style>
  .hc-prev-next {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 4rem;
  }
  .nav-card {
    flex: 1;
    padding: 1.5rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 200ms, border-color 200ms;
    display: flex;
    flex-direction: column;
    background: rgba(30, 29, 27, 0.4);
  }
  .nav-card:hover {
    background: rgba(30, 29, 27, 0.8);
    border-color: var(--hc-gold-dim);
  }
  .next-card {
    text-align: right;
  }
  .nav-label {
    color: var(--hc-gold);
    margin-bottom: 0.5rem;
  }
  .nav-title {
    color: var(--hc-parchment);
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
</style>
