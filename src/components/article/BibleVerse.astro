---
export interface Props {
  /** A verse reference: "Exodus 23:19" */
  reference: string;
  /** Optional override label for the eyebrow; defaults to "Bible" */
  eyebrow?: string;
}

const { reference, eyebrow = "Bible" } = Astro.props;
---
<div class="hc-article-panel hc-article-panel--parchment bible-verse">
  <div class="bible-verse__header">
    <span class="hc-eyebrow">{eyebrow}</span>
  </div>
  <div class="bible-verse__content">
    <slot />
  </div>
  <div class="bible-verse__ref">{reference}</div>
</div>

<style>
  .bible-verse {
    position: relative;
    padding-top: 3rem;
  }
  .bible-verse__header {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.5rem 1.25rem;
    background: var(--hc-parchment-deep);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: var(--radius-sm) 0 var(--radius-sm) 0;
  }
  .bible-verse__header .hc-eyebrow {
    color: var(--hc-umber-dark);
  }
  .bible-verse__content {
    font-size: 1.15rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
    padding-left: 1rem;
    border-left: 2px solid var(--hc-gold-dim);
    color: #2f281f;
  }
  
  .bible-verse__content :global(p) {
    color: #2f281f;
  }
  .bible-verse__content :global(p:first-child) {
    margin-top: 0;
  }
  .bible-verse__content :global(p:last-child) {
    margin-bottom: 0;
  }
  
  .bible-verse__content :global(strong) {
    color: #1a1611;
  }
  
  .bible-verse__ref {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-umber-dark);
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    padding-top: 1rem;
    font-weight: 600;
  }
</style>
