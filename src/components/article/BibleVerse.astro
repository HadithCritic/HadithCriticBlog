---
export interface Props {
  /** A verse reference: "Exodus 23:19" */
  reference: string;
  /** Optional override label for the eyebrow; defaults to "Bible" */
  eyebrow?: string;
}

const { reference, eyebrow = "Bible" } = Astro.props;
---

<div class="hc-article-panel bible-verse" data-bible-verse>
  <div class="bible-verse__header">
    <div class="bible-verse__badge">
      <span class="bible-verse__badge-label">{eyebrow}</span>
    </div>

    <button
      type="button"
      class="bible-verse__share"
      data-bible-share
      title="Share citation"
      aria-label="Share citation"
    >
      <span class="bible-verse__share-text">Share</span>
    </button>
  </div>

  <div class="bible-verse__content" data-bible-text>
    <slot />
  </div>

  <div class="bible-verse__ref" data-ref-text={reference}>
    <span>{reference}</span>
  </div>
</div>

<script>
  import { shareText, flashCopied, buildCitation } from '../../lib/clipboard';
  function initBibleShare() {
    for (const card of document.querySelectorAll<HTMLElement>('[data-bible-verse]')) {
      if (card.dataset.shareInitialized) continue;
      card.dataset.shareInitialized = 'true';

      const shareBtn = card.querySelector<HTMLButtonElement>('[data-bible-share]');
      if (!shareBtn) continue;

      shareBtn.addEventListener('click', async () => {
        const textEl = card.querySelector('[data-bible-text]');
        const refVal = card.querySelector('[data-ref-text]')?.getAttribute('data-ref-text');

        const citation = buildCitation({
          quoted: textEl?.textContent,
          reference: refVal
        });
        if (!citation) return;
        if (!(await shareText(citation, 'Bible citation'))) return;
        flashCopied(shareBtn, { labelSelector: '.bible-verse__share-text', copiedLabel: 'Ready to share', idleLabel: 'Share', className: 'is-shared' });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBibleShare);
  } else {
    initBibleShare();
  }
  document.addEventListener('astro:page-load', initBibleShare);
</script>

<style>
  .bible-verse {
    position: relative;
    margin: 2.75rem 0;
    padding: 0;
    border: 1px solid var(--hc-rule);
    border-top: 1px solid var(--hc-rule-strong);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--hc-surface-2) 65%, transparent);
    box-shadow: none;
    overflow: hidden;
  }

  .bible-verse__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--hc-rule);
    background: transparent;
  }

  .bible-verse__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1.1rem;
    background: transparent;
    border-right: 1px solid var(--hc-rule-soft);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bible-verse__badge-icon {
    font-size: 0.95rem;
  }

  /* Share Button */
  .bible-verse__share {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-right: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--hc-rule);
    background: rgba(15, 15, 16, 0.6);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .bible-verse__share:hover {
    color: var(--hc-gold);
    border-color: var(--hc-gold-dim);
    background: rgba(216, 177, 102, 0.1);
    transform: translateY(-1px);
  }

  .bible-verse__share.is-shared {
    border-color: var(--hc-gold-dim);
    color: var(--hc-text-primary);
    background: color-mix(in srgb, var(--hc-gold) 10%, transparent);
  }

  .bible-verse__content {
    padding: 0;
    font-family: var(--font-body);
    font-size: 1em;
    line-height: 1.72;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    color: var(--hc-text-secondary);
    border-left: 0;
    font-style: italic;
    margin: clamp(1.1rem, 2.5vw, 1.8rem) clamp(1.2rem, 2.5vw, 1.8rem);
  }

  .bible-verse__content :global(p) {
    color: var(--hc-text-primary);
    margin: 0 0 0.75rem;
    text-align: justify;
  }
  .bible-verse__content :global(p:last-child) {
    margin-bottom: 0;
  }

  .bible-verse__content :global(strong) {
    color: var(--hc-text-primary);
    font-weight: 700;
  }

  .bible-verse__ref {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.85rem clamp(1.4rem, 3vw, 2.2rem);
    font-family: var(--font-ui);
    font-size: 0.84rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-text-secondary);
    border-top: 1px solid var(--hc-rule-soft);
    background: rgba(216, 177, 102, 0.03);
    font-weight: 700;
  }

  .bible-verse__ref-icon {
    font-size: 0.84rem;
    color: var(--hc-gold-bright);
  }

  :global([data-theme="light"]) .bible-verse {
    background: color-mix(in srgb, var(--hc-surface-2) 65%, transparent);
    border-color: var(--hc-rule);
    border-top-color: var(--hc-rule-strong);
    box-shadow: none;
  }

  :global([data-theme="light"]) .bible-verse__header {
    background: transparent;
  }

  :global([data-theme="light"]) .bible-verse__badge {
    background: transparent;
    color: var(--hc-text-secondary);
  }

  :global([data-theme="light"]) .bible-verse__share {
    background: rgba(251, 249, 244, 0.9);
    border-color: var(--hc-rule);
    color: var(--hc-text-primary);
  }

  :global([data-theme="light"]) .bible-verse__ref {
    background: rgba(176, 126, 44, 0.04);
  }

  @media (max-width: 640px) {
    .bible-verse {
      margin: 2rem 0;
    }

    .bible-verse__badge {
      padding: 0.4rem 0.85rem;
      font-size: 0.78rem;
    }

    .bible-verse__content {
      padding: 0;
      margin: 0.85rem;
      font-size: 1em;
      line-height: 1.72;
    }

    .bible-verse__ref {
      padding: 0.8rem 1.1rem;
    }
  }
</style>
