---
export interface Props {
  /** A verse reference: "Exodus 23:19" */
  reference: string;
  /** Optional override label for the eyebrow; defaults to "Bible" */
  eyebrow?: string;
}

const { reference, eyebrow = "Bible" } = Astro.props;
---

<div class="hc-article-panel bible-verse" data-bible-verse>
  <div class="bible-verse__header">
    <div class="bible-verse__badge">
      <span class="bible-verse__badge-icon" aria-hidden="true">✦</span>
      <span class="bible-verse__badge-label">{eyebrow}</span>
    </div>

    <button
      type="button"
      class="bible-verse__copy"
      data-bible-copy
      title="Copy verse"
      aria-label="Copy verse to clipboard"
    >
      <span class="bible-verse__copy-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </span>
      <span class="bible-verse__copy-check" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </span>
      <span class="bible-verse__copy-text">Copy</span>
    </button>
  </div>

  <div class="bible-verse__content" data-bible-text>
    <slot />
  </div>

  <div class="bible-verse__ref" data-ref-text={reference}>
    <span class="bible-verse__ref-icon" aria-hidden="true">✦</span>
    <span>{reference}</span>
  </div>
</div>

<script>
  function initBibleCopy() {
    for (const card of document.querySelectorAll<HTMLElement>('[data-bible-verse]')) {
      if (card.dataset.copyInitialized) continue;
      card.dataset.copyInitialized = 'true';

      const copyBtn = card.querySelector<HTMLButtonElement>('[data-bible-copy]');
      if (!copyBtn) continue;

      copyBtn.addEventListener('click', async () => {
        const textEl = card.querySelector('[data-bible-text]');
        const refVal = card.querySelector('[data-ref-text]')?.getAttribute('data-ref-text');

        let textParts: string[] = [];
        if (textEl?.textContent) textParts.push(`"${textEl.textContent.trim()}"`);
        if (refVal) textParts.push(`— ${refVal.trim()}`);

        const textToCopy = textParts.join('\n\n');
        if (!textToCopy) return;

        try {
          await navigator.clipboard.writeText(textToCopy);
          copyBtn.classList.add('is-copied');
          const labelSpan = copyBtn.querySelector('.bible-verse__copy-text');
          if (labelSpan) labelSpan.textContent = 'Copied!';

          setTimeout(() => {
            copyBtn.classList.remove('is-copied');
            if (labelSpan) labelSpan.textContent = 'Copy';
          }, 2200);
        } catch (err) {
          console.warn('Failed to copy Bible verse:', err);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBibleCopy);
  } else {
    initBibleCopy();
  }
  document.addEventListener('astro:page-load', initBibleCopy);
</script>

<style>
  .bible-verse {
    position: relative;
    margin: 2.75rem 0;
    padding: 0;
    border: 1px solid var(--hc-rule);
    border-top: 3px solid var(--hc-gold);
    border-radius: var(--radius-sm);
    background:
      radial-gradient(circle at 85% 10%, rgba(216, 177, 102, 0.06), transparent 45%),
      linear-gradient(
        140deg,
        color-mix(in srgb, var(--hc-surface-2) 88%, transparent),
        color-mix(in srgb, var(--hc-surface-1) 96%, transparent)
      );
    box-shadow:
      0 1px 0 rgba(216, 177, 102, 0.08) inset,
      0 16px 45px rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }

  .bible-verse__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--hc-rule);
    background: rgba(15, 15, 16, 0.35);
  }

  .bible-verse__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1.1rem;
    background: rgba(216, 177, 102, 0.08);
    border-right: 1px solid var(--hc-rule);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bible-verse__badge-icon {
    font-size: 0.85rem;
  }

  /* Copy Button */
  .bible-verse__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-right: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--hc-rule);
    background: rgba(15, 15, 16, 0.6);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .bible-verse__copy:hover {
    color: var(--hc-gold);
    border-color: var(--hc-gold-dim);
    background: rgba(216, 177, 102, 0.1);
    transform: translateY(-1px);
  }

  .bible-verse__copy-check {
    display: none;
    color: #4ade80;
  }

  .bible-verse__copy.is-copied {
    border-color: #4ade80;
    color: #4ade80;
    background: rgba(74, 222, 128, 0.1);
  }

  .bible-verse__copy.is-copied .bible-verse__copy-icon {
    display: none;
  }

  .bible-verse__copy.is-copied .bible-verse__copy-check {
    display: inline-flex;
  }

  .bible-verse__content {
    padding: clamp(1.3rem, 3vw, 2.2rem) clamp(1.4rem, 3vw, 2.2rem);
    font-family: var(--font-body);
    font-size: clamp(1.06rem, 0.3vw + 1.02rem, 1.2rem);
    line-height: 1.78;
    color: var(--hc-text-secondary);
    padding-left: clamp(1.6rem, 3vw, 2.4rem);
    border-left: 3px solid var(--hc-gold-dim);
    font-style: italic;
    margin: 1.25rem 1.4rem;
  }

  .bible-verse__content :global(p) {
    color: var(--hc-text-primary);
    margin: 0 0 0.75rem;
  }
  .bible-verse__content :global(p:last-child) {
    margin-bottom: 0;
  }

  .bible-verse__content :global(strong) {
    color: var(--hc-text-primary);
    font-weight: 700;
  }

  .bible-verse__ref {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.85rem clamp(1.4rem, 3vw, 2.2rem);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-gold);
    border-top: 1px solid var(--hc-rule-soft);
    background: rgba(216, 177, 102, 0.03);
    font-weight: 700;
  }

  .bible-verse__ref-icon {
    font-size: 0.75rem;
    color: var(--hc-gold-bright);
  }

  :global([data-theme="light"]) .bible-verse {
    background:
      radial-gradient(circle at 85% 10%, rgba(176, 126, 44, 0.08), transparent 45%),
      linear-gradient(140deg, rgba(251, 249, 244, 0.98), rgba(244, 239, 229, 0.96));
    border-color: var(--hc-rule);
    border-top-color: var(--hc-gold);
    box-shadow: 0 10px 35px rgba(43, 40, 36, 0.08);
  }

  :global([data-theme="light"]) .bible-verse__header {
    background: rgba(240, 234, 220, 0.6);
  }

  :global([data-theme="light"]) .bible-verse__badge {
    background: rgba(176, 126, 44, 0.1);
    color: var(--hc-gold);
  }

  :global([data-theme="light"]) .bible-verse__copy {
    background: rgba(251, 249, 244, 0.9);
    border-color: var(--hc-rule);
    color: var(--hc-text-primary);
  }

  :global([data-theme="light"]) .bible-verse__ref {
    background: rgba(176, 126, 44, 0.04);
  }

  @media (max-width: 640px) {
    .bible-verse {
      margin: 2rem 0;
    }

    .bible-verse__badge {
      padding: 0.4rem 0.85rem;
      font-size: 0.64rem;
    }

    .bible-verse__content {
      padding: 0.85rem;
      margin: 1rem;
      font-size: 1rem;
      line-height: 1.68;
    }

    .bible-verse__ref {
      padding: 0.8rem 1.1rem;
    }
  }
</style>
