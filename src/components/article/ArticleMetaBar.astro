---
<div class="article-metabar">
  <div class="hc-container metabar-inner">
    <div class="metabar-left">
      <button class="metabar-link" aria-label="Table of Contents">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <span>Contents</span>
      </button>
      <a href="#sources" class="metabar-link">Sources</a>
      <a href="#isnad" class="metabar-link">Isnād Map</a>
    </div>
    
    <div class="metabar-center">
      <div class="reading-progress">
        <div class="reading-progress-bar" id="readingProgress"></div>
      </div>
    </div>
    
    <div class="metabar-right">
      <button class="metabar-link">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
        <span>Share</span>
      </button>
    </div>
  </div>
</div>

<style>
  .article-metabar {
    position: sticky;
    top: calc(72px + var(--sat, 0px)); /* Height of site header + safe area */
    z-index: 40;
    background: color-mix(in srgb, var(--hc-black) 94%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hc-rule);
    padding: 0.75rem 0;
  }
  .metabar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .metabar-left, .metabar-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .metabar-link {
    background: none;
    border: none;
    color: var(--hc-parchment);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    text-decoration: none;
    transition: color 200ms ease;
  }
  .metabar-link:hover {
    color: var(--hc-gold);
  }
  .metabar-center {
    flex: 1;
    max-width: 300px;
    margin: 0 2rem;
    display: none;
  }
  .reading-progress {
    height: 2px;
    background: var(--hc-rule-soft);
    width: 100%;
    border-radius: 2px;
    overflow: hidden;
  }
  .reading-progress-bar {
    height: 100%;
    background: var(--hc-gold);
    width: 0%;
  }
  
  @media (min-width: 768px) {
    .metabar-center {
      display: block;
    }
  }
</style>

<script>
  // Simple reading progress
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const bar = document.getElementById('readingProgress');
    if (bar) bar.style.width = scrolled + '%';
  });
</script>
