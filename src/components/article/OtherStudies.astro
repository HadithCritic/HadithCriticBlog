---
import type { CollectionEntry } from 'astro:content';

interface Props {
  articles: CollectionEntry<'articles'>[];
  limit?: number;
}

const { articles = [], limit = 4 } = Astro.props;
const displayArticles = articles.slice(0, limit);
---

{displayArticles.length > 0 && (
  <div class="other-studies-rail">
    <div class="other-studies-card">
      <div class="other-studies-card__header">
        <span class="other-studies-card__title">Other Studies</span>
      </div>
      <div class="other-studies-list">
        {displayArticles.map((art) => (
          <a href={`/blogs/${art.id}`} class="other-study-item">
            <h4 class="other-study-item__title">{art.data.title}</h4>
            <span class="other-study-item__date">
              {new Date(art.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
)}

<style>
  .other-studies-rail {
    display: flex;
    flex-direction: column;
    margin-top: 1.25rem;
  }

  .other-studies-card {
    padding: 1.15rem 1.25rem;
    border-radius: 4px;
    border: 1px solid var(--hc-rule);
    background: var(--hc-surface-1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  :global([data-theme="light"]) .other-studies-card {
    background: #fbf9f4;
    border-color: var(--hc-rule);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .other-studies-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .other-studies-card__title {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .other-studies-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .other-study-item {
    display: block;
    padding: 0.55rem 0.65rem;
    border-radius: 3px;
    border: 1px solid var(--hc-rule-soft);
    background: var(--hc-surface-0);
    text-decoration: none;
    transition: border-color 160ms ease, background 160ms ease;
  }

  .other-study-item:hover {
    border-color: var(--hc-gold-dim);
    background: var(--hc-surface-2);
  }

  .other-study-item__title {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--hc-text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .other-study-item:hover .other-study-item__title {
    color: var(--hc-gold);
  }

  .other-study-item__date {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
  }
</style>
