---
import type { CollectionEntry } from 'astro:content';

interface Props {
  articles: CollectionEntry<'articles'>[];
  limit?: number;
}

const { articles = [], limit = 4 } = Astro.props;
const displayArticles = articles.slice(0, limit);
---

{displayArticles.length > 0 && (
  <div class="other-studies-rail">
    <div class="other-studies-card">
      <div class="other-studies-card__header">
        <span class="other-studies-card__title">Other Studies</span>
      </div>
      <div class="other-studies-list">
        {displayArticles.map((art) => (
          <a href={`/blogs/${art.id}/`} class="other-study-item">
            <h4 class="other-study-item__title">{art.data.title}</h4>
            <span class="other-study-item__date">
              {new Date(art.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
)}

<style>
  .other-studies-rail {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
  }

  .other-studies-card {
    padding-top: 0.85rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .other-studies-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .other-studies-card__title {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--hc-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .other-studies-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .other-study-item {
    display: block;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--hc-rule-soft);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .other-study-item:hover {
    color: var(--hc-gold);
  }

  .other-study-item__title {
    margin: 0 0 0.2rem;
    font-family: var(--font-display);
    font-size: 0.79rem;
    font-weight: 400;
    line-height: 1.38;
    color: var(--hc-text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .other-study-item:hover .other-study-item__title {
    color: var(--hc-gold-soft);
  }

  .other-study-item__date {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-text-tertiary);
  }
</style>
