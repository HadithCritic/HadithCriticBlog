---
// QuranTalk Citation Embed — v2.0
// A premium scholarly citation card that honors the QuranTalk brand identity
// while integrating seamlessly with the HadithCriticBlog dark archive aesthetic.

export interface Props {
  url?: string;
  title?: string;
  author?: string;
  date?: string;
  description?: string;
}

const {
  url = "https://qurantalkblog.com/2024/11/05/jesus-messiah-ben-david-or-ben-aaron/",
  title = "Which Messiah Was Jesus? Ben David, Ben Joseph, or Ben Aaron?",
  author = "QuranTalk",
  date = "November 5, 2024",
  description
} = Astro.props;
---

<figure class="qt-cite" role="region" aria-label={`External citation: ${title} by ${author}`}>
  {/* Ambient glow layer */}
  <div class="qt-cite__glow" aria-hidden="true"></div>

  <div class="qt-cite__body">
    {/* ─── Header: Brand identity ─── */}
    <header class="qt-cite__header">
      <div class="qt-cite__brand">
        {/* QuranTalk "Q" Logo — faithful to the brand's gold Q in circle */}
        <div class="qt-cite__logo" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="qtGold" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#F5E4B3" />
                <stop offset="50%" stop-color="#D8B166" />
                <stop offset="100%" stop-color="#9E7833" />
              </linearGradient>
              <filter id="qtGlow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="2" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>
            {/* Outer ring */}
            <circle cx="50" cy="50" r="46" fill="none" stroke="url(#qtGold)" stroke-width="3.5" />
            {/* Inner dashed ring */}
            <circle cx="50" cy="50" r="40" fill="none" stroke="url(#qtGold)" stroke-width="0.8" stroke-dasharray="4 3" opacity="0.5" />
            {/* The Q */}
            <path d="M50 20 C33 20 20 33 20 50 C20 67 33 80 50 80 C67 80 80 67 80 50 C80 33 67 20 50 20 Z M50 30 C61 30 70 39 70 50 C70 61 61 70 50 70 C39 70 30 61 30 50 C30 39 39 30 50 30 Z" fill="url(#qtGold)" />
            {/* Q tail */}
            <path d="M58 58 L78 78 C80 80 82 77 79 75 L64 60 Z" fill="url(#qtGold)" />
          </svg>
        </div>

        <div class="qt-cite__brand-text">
          <span class="qt-cite__brand-name">{author}</span>
          <span class="qt-cite__brand-tag">Featured Citation</span>
        </div>
      </div>

      {date && (
        <time class="qt-cite__date" datetime={date}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
          </svg>
          {date}
        </time>
      )}
    </header>

    {/* ─── Content: Title + Description ─── */}
    <div class="qt-cite__content">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="qt-cite__link"
        title={`Read "${title}" on ${author}`}
      >
        <h4 class="qt-cite__title">{title}</h4>
        <span class="qt-cite__link-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
        </span>
      </a>

      {description && <p class="qt-cite__desc">{description}</p>}

      <div class="qt-cite__slot">
        <slot />
      </div>
    </div>

    {/* ─── Footer: Source + CTA ─── */}
    <footer class="qt-cite__footer">
      <div class="qt-cite__source">
        <span class="qt-cite__live-dot" aria-hidden="true"></span>
        <span class="qt-cite__domain">qurantalkblog.com</span>
      </div>

      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="qt-cite__cta"
      >
        <span>Read Article</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </a>
    </footer>
  </div>
</figure>

<style>
  /* ═══════════════════════════════════════════════════════════════
     QURANTALK CITATION EMBED — v2.0
     Premium scholarly citation card with ambient glow, glass-morphism
     accents, and faithful brand identity.
     ═══════════════════════════════════════════════════════════════ */

  .qt-cite {
    position: relative;
    margin: 2.75rem 0;
    border-radius: var(--radius-sm, 8px);
    background:
      radial-gradient(ellipse 80% 50% at 20% 40%, rgba(216, 177, 102, 0.07) 0%, transparent 50%),
      radial-gradient(ellipse 60% 40% at 80% 20%, rgba(216, 177, 102, 0.04) 0%, transparent 50%),
      linear-gradient(170deg, rgba(15,15,16,0.98) 0%, rgba(20,20,23,0.99) 100%);
    border: 1px solid rgba(216, 177, 102, 0.22);
    overflow: hidden;
    transition: border-color 0.35s ease, box-shadow 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Ambient glow that intensifies on hover */
  .qt-cite__glow {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: linear-gradient(135deg,
      rgba(216, 177, 102, 0) 0%,
      rgba(216, 177, 102, 0.04) 40%,
      rgba(216, 177, 102, 0.08) 60%,
      rgba(216, 177, 102, 0) 100%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 0;
  }

  .qt-cite:hover .qt-cite__glow {
    opacity: 1;
  }

  .qt-cite:hover {
    border-color: rgba(216, 177, 102, 0.45);
    box-shadow:
      0 0 0 1px rgba(216, 177, 102, 0.08),
      0 20px 50px -15px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(216, 177, 102, 0.06);
    transform: translateY(-2px);
  }

  /* Top accent line — the "seal" effect */
  .qt-cite::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2.5px;
    background: linear-gradient(90deg,
      transparent 0%,
      #9E7833 15%,
      #D8B166 50%,
      #F5E4B3 70%,
      #D8B166 85%,
      transparent 100%
    );
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .qt-cite:hover::before {
    opacity: 1;
  }

  /* Body padding with safe area for glow */
  .qt-cite__body {
    position: relative;
    z-index: 1;
    padding: 1.6rem 1.9rem 1.4rem;
  }

  /* ─── Header ─── */
  .qt-cite__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.35rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid rgba(216, 177, 102, 0.1);
  }

  .qt-cite__brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .qt-cite__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .qt-cite:hover .qt-cite__logo {
    transform: scale(1.08) rotate(2deg);
  }

  .qt-cite__logo svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 6px rgba(216, 177, 102, 0.25));
  }

  .qt-cite__brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .qt-cite__brand-name {
    font-family: var(--font-display, "Cormorant Garamond", "Cinzel", serif);
    font-size: 0.96rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #F5E4B3;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .qt-cite__brand-tag {
    font-family: var(--font-ui, "IBM Plex Sans", sans-serif);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(216, 177, 102, 0.55);
  }

  .qt-cite__date {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui, "IBM Plex Sans", sans-serif);
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--hc-text-tertiary, #8a8276);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.3rem 0.7rem;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .qt-cite__date svg {
    opacity: 0.6;
  }

  /* ─── Content ─── */
  .qt-cite__content {
    margin-bottom: 1.1rem;
  }

  .qt-cite__link {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
    margin-bottom: 0.7rem;
  }

  .qt-cite__title {
    margin: 0;
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: clamp(1.15rem, 0.5vw + 1rem, 1.35rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--hc-parchment, #f2ebdc);
    transition: color 0.25s ease;
    text-wrap: balance;
  }

  .qt-cite__link:hover .qt-cite__title {
    color: #E8C878;
  }

  .qt-cite__link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(216, 177, 102, 0.08);
    border: 1px solid rgba(216, 177, 102, 0.18);
    color: #D8B166;
    flex-shrink: 0;
    margin-top: 0.1rem;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .qt-cite__link:hover .qt-cite__link-icon {
    background: rgba(216, 177, 102, 0.18);
    border-color: rgba(216, 177, 102, 0.4);
    color: #F5E4B3;
    transform: translate(2px, -2px);
    box-shadow: 0 4px 12px rgba(216, 177, 102, 0.15);
  }

  .qt-cite__desc {
    margin: 0;
    font-family: var(--font-body, "Source Serif 4", serif);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--hc-text-secondary, #a8a095);
    text-wrap: pretty;
  }

  .qt-cite__slot {
    margin-top: 0.9rem;
  }

  .qt-cite__slot:empty {
    display: none;
  }

  /* ─── Footer ─── */
  .qt-cite__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(216, 177, 102, 0.1);
  }

  .qt-cite__source {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Pulsing live dot */
  .qt-cite__live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #D8B166;
    box-shadow: 0 0 0 0 rgba(216, 177, 102, 0.4);
    animation: qtPulse 2.5s ease-in-out infinite;
  }

  @keyframes qtPulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(216, 177, 102, 0.4);
    }
    50% {
      box-shadow: 0 0 0 5px rgba(216, 177, 102, 0);
    }
  }

  .qt-cite__domain {
    font-family: var(--font-ui, "IBM Plex Mono", monospace);
    font-size: 0.78rem;
    color: var(--hc-text-tertiary, #8a8276);
    letter-spacing: 0.02em;
  }

  .qt-cite__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-xs, 4px);
    background: rgba(216, 177, 102, 0.1);
    border: 1px solid rgba(216, 177, 102, 0.25);
    color: #F5E4B3;
    font-family: var(--font-ui, "IBM Plex Sans", sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .qt-cite__cta:hover {
    background: rgba(216, 177, 102, 0.22);
    border-color: rgba(216, 177, 102, 0.5);
    color: #FFF8E7;
    box-shadow: 0 0 16px rgba(216, 177, 102, 0.2);
    transform: translateX(1px);
  }

  .qt-cite__cta svg {
    transition: transform 0.2s ease;
  }

  .qt-cite__cta:hover svg {
    transform: translateX(2px);
  }

  /* ═══════════════════════════════════════════════════════════════
     LIGHT MODE ADAPTATION
     ═══════════════════════════════════════════════════════════════ */
  :global([data-theme="light"]) .qt-cite {
    background:
      radial-gradient(ellipse 80% 50% at 20% 40%, rgba(164, 106, 63, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse 60% 40% at 80% 20%, rgba(164, 106, 63, 0.03) 0%, transparent 50%),
      linear-gradient(170deg, rgba(251,249,244,0.98) 0%, rgba(242,236,224,0.99) 100%);
    border-color: rgba(164, 106, 63, 0.25);
  }

  :global([data-theme="light"]) .qt-cite:hover {
    border-color: rgba(164, 106, 63, 0.5);
    box-shadow:
      0 0 0 1px rgba(164, 106, 63, 0.06),
      0 20px 50px -15px rgba(0, 0, 0, 0.15),
      0 0 30px rgba(164, 106, 63, 0.04);
  }

  :global([data-theme="light"]) .qt-cite__title {
    color: #2b2824;
  }

  :global([data-theme="light"]) .qt-cite__link:hover .qt-cite__title {
    color: #9E7833;
  }

  :global([data-theme="light"]) .qt-cite__desc {
    color: #5c5448;
  }

  :global([data-theme="light"]) .qt-cite__domain {
    color: #8a8276;
  }

  :global([data-theme="light"]) .qt-cite__date {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.06);
    color: #8a8276;
  }

  :global([data-theme="light"]) .qt-cite__header {
    border-bottom-color: rgba(164, 106, 63, 0.12);
  }

  :global([data-theme="light"]) .qt-cite__footer {
    border-top-color: rgba(164, 106, 63, 0.12);
  }

  :global([data-theme="light"]) .qt-cite__cta {
    background: rgba(164, 106, 63, 0.08);
    border-color: rgba(164, 106, 63, 0.25);
    color: #795418;
  }

  :global([data-theme="light"]) .qt-cite__cta:hover {
    background: rgba(164, 106, 63, 0.18);
    border-color: rgba(164, 106, 63, 0.45);
    color: #5c3a10;
  }

  :global([data-theme="light"]) .qt-cite__link-icon {
    background: rgba(164, 106, 63, 0.06);
    border-color: rgba(164, 106, 63, 0.15);
    color: #A46A3F;
  }

  :global([data-theme="light"]) .qt-cite__link:hover .qt-cite__link-icon {
    background: rgba(164, 106, 63, 0.14);
    border-color: rgba(164, 106, 63, 0.35);
    color: #795418;
  }

  :global([data-theme="light"]) .qt-cite__brand-name {
    color: #9E7833;
  }

  :global([data-theme="light"]) .qt-cite__brand-tag {
    color: rgba(164, 106, 63, 0.6);
  }

  /* ═══════════════════════════════════════════════════════════════
     MOBILE RESPONSIVENESS
     ═══════════════════════════════════════════════════════════════ */
  @media (max-width: 640px) {
    .qt-cite__body {
      padding: 1.25rem 1.4rem 1.1rem;
    }

    .qt-cite__header {
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .qt-cite__title {
      font-size: 1.08rem;
    }

    .qt-cite__link-icon {
      width: 28px;
      height: 28px;
    }

    .qt-cite__cta span {
      display: none;
    }

    .qt-cite__cta {
      padding: 0.5rem;
    }

    .qt-cite__desc {
      font-size: 0.9rem;
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     REDUCED MOTION
     ═══════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .qt-cite,
    .qt-cite__glow,
    .qt-cite__logo,
    .qt-cite__link-icon,
    .qt-cite__cta,
    .qt-cite__cta svg {
      transition: none !important;
      animation: none !important;
      transform: none !important;
    }

    .qt-cite__live-dot {
      animation: none;
      box-shadow: 0 0 4px rgba(216, 177, 102, 0.4);
    }
  }
</style>
