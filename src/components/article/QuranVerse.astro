---
import verses from "../../data/quran-verses.json";

export interface Props {
  /** A verse reference or list: "49:6", "6:74-76", or "2:255, 24:13". */
  verse: string;
  /** Optional override label; defaults to a tidy "Quran <refs>". */
  label?: string;
}

const data = verses as Record<string, { ar: string; en: string }>;
const { verse, label } = Astro.props;

// Expand "6:74-76" -> ["6:74","6:75","6:76"] and split comma lists.
function expand(ref: string): string[] {
  const out: string[] = [];
  for (const part of ref
    .split(",")
    .map((s) => s.trim())
    .filter(Boolean)) {
    const m = part.match(/^(\d+):(\d+)-(\d+)$/);
    if (m) {
      const ch = m[1];
      for (let v = Number(m[2]); v <= Number(m[3]); v++) out.push(`${ch}:${v}`);
    } else {
      out.push(part);
    }
  }
  return out;
}

const refs = expand(verse);
const found = refs.map((r) => ({ ref: r, ...(data[r] || {}) }));
const missing = found.filter((f) => !f.ar && !f.en).map((f) => f.ref);
if (missing.length) {
  console.warn(
    `[QuranVerse] No data for: ${missing.join(", ")} (verse="${verse}")`,
  );
}

// Western -> Arabic-Indic digits, for the ayah-end marker and any other
// Arabic-context numerals ("12" -> "١٢").
const ARABIC_INDIC_DIGITS = ["٠", "١", "٢", "٣", "٤", "٥", "٦", "٧", "٨", "٩"];
function toArabicIndicDigits(input: string): string {
  return input.replace(/\d/g, (d) => ARABIC_INDIC_DIGITS[Number(d)]);
}

// Per-verse segments (Arabic text + its own verse number), so each ayah
// can carry its own end-of-verse marker instead of a single Unicode
// glyph stitched between whole-surah strings. Most web fonts render the
// classical U+06DD end-of-ayah character as an oversized, badly aligned
// fallback circle -- rendering the marker as a small CSS badge instead
// sidesteps that entirely and is closer to how printed muṣḥafs set it.
const arabicSegments = found
  .filter((f) => f.ar)
  .map((f) => ({ text: f.ar, num: f.ref.split(":")[1] ?? "" }));

// Plain-text Arabic string (still separated by the real ayah-end glyph)
// kept only for the "Copy" button, where a font fallback glyph doesn't
// matter -- it's just going onto the user's clipboard as text.
const arabicPlain = arabicSegments.map((s) => s.text).join(" \u06DD ");

const verseEntries = found.filter((f) => f.en);
const english = verseEntries.map((f) => f.en);
const englishPlain = english.join(" ");
const ref = label || `Quran ${verse}`;
const hasData = Boolean(arabicSegments.length || english.length);
---

<div class="hc-article-panel quran-verse" data-quran-verse>
  <div class="quran-verse__header">
    <div class="quran-verse__badge">
      <span class="quran-verse__badge-icon" aria-hidden="true">✦</span>
      <span class="quran-verse__badge-label">Quran</span>
    </div>

    {
      hasData && (
        <button
          type="button"
          class="quran-verse__copy"
          data-quran-copy
          title="Copy verse"
          aria-label="Copy verse to clipboard"
        >
          <span class="quran-verse__copy-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="13"
              height="13"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
          </span>
          <span class="quran-verse__copy-check" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="13"
              height="13"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
          <span class="quran-verse__copy-text">Copy</span>
        </button>
      )
    }
  </div>

  <div class="quran-verse__content">
    {
      hasData ? (
        <>
          {arabicSegments.length > 0 && (
            <div
              class="quran-verse__arabic"
              dir="rtl"
              lang="ar"
              data-arabic-text
              data-copy-text={arabicPlain}
            >
              {arabicSegments.map((seg) => (
                <span class="qv-ayah">
                  {seg.text}
                  {seg.num && (
                    <span class="qv-ayah-end" aria-hidden="true">
                      {toArabicIndicDigits(seg.num)}
                    </span>
                  )}
                </span>
              ))}
            </div>
          )}
          {english.length > 0 && (
            <p class="quran-verse__english" data-english-text data-copy-text={englishPlain}>
              {verseEntries.map((f, index) => (
                <>
                  <span class="qv-verse">{f.en}</span>
                  {index < verseEntries.length - 1 && (
                    <span class="qv-verse-num" aria-label={`Verse ${f.ref.split(":")[1]}`}>
                      {f.ref.split(":")[1]}
                    </span>
                  )}
                  {' '}
                </>
              ))}
            </p>
          )}
          <div class="quran-verse__ref" data-ref-text={ref}>
            <span class="quran-verse__ref-icon" aria-hidden="true">
              ✦
            </span>
            <span>{ref}</span>
          </div>
        </>
      ) : (
        <p class="quran-verse__missing">Verse data unavailable for {ref}.</p>
      )
    }
  </div>
</div>

<script>
  import { copyText, flashCopied, buildCitation } from "../../lib/clipboard";
  function initQuranCopy() {
    for (const card of document.querySelectorAll<HTMLElement>(
      "[data-quran-verse]",
    )) {
      if (card.dataset.copyInitialized) continue;
      card.dataset.copyInitialized = "true";

      const copyBtn =
        card.querySelector<HTMLButtonElement>("[data-quran-copy]");
      if (!copyBtn) continue;

      copyBtn.addEventListener("click", async () => {
        const arabicEl = card.querySelector("[data-arabic-text]");
        const englishEl = card.querySelector("[data-english-text]");
        const refVal = card
          .querySelector("[data-ref-text]")
          ?.getAttribute("data-ref-text");

        const textToCopy = buildCitation({
          primary: arabicEl?.getAttribute("data-copy-text") || arabicEl?.textContent,
          quoted: englishEl?.getAttribute("data-copy-text") || englishEl?.textContent,
          reference: refVal
        });
        if (!textToCopy) return;
        if (!(await copyText(textToCopy, "verse"))) return;
        flashCopied(copyBtn, { labelSelector: ".quran-verse__copy-text" });
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initQuranCopy);
  } else {
    initQuranCopy();
  }
  document.addEventListener("astro:page-load", initQuranCopy);
</script>

<style>
  .quran-verse {
    position: relative;
    margin: 2.75rem 0;
    padding: 0;
    border: 1px solid var(--hc-rule);
    border-top: 1px solid var(--hc-rule-strong);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--hc-surface-2) 65%, transparent);
    box-shadow: none;
    overflow: hidden;
  }

  .quran-verse__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--hc-rule);
    background: transparent;
  }

  .quran-verse__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1.1rem;
    background: transparent;
    border-right: 1px solid var(--hc-rule-soft);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .quran-verse__badge-icon {
    font-size: 0.95rem;
  }

  /* Copy Button */
  .quran-verse__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-right: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--hc-rule);
    background: rgba(15, 15, 16, 0.6);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .quran-verse__copy:hover {
    color: var(--hc-gold);
    border-color: var(--hc-gold-dim);
    background: rgba(216, 177, 102, 0.1);
    transform: translateY(-1px);
  }

  .quran-verse__copy-check {
    display: none;
    color: #4ade80;
  }

  .quran-verse__copy.is-copied {
    border-color: #4ade80;
    color: #4ade80;
    background: rgba(74, 222, 128, 0.1);
  }

  .quran-verse__copy.is-copied .quran-verse__copy-icon {
    display: none;
  }

  .quran-verse__copy.is-copied .quran-verse__copy-check {
    display: inline-flex;
  }

  .quran-verse__content {
    padding: clamp(1.3rem, 3vw, 2.2rem) clamp(1.4rem, 3vw, 2.2rem);
  }

  .quran-verse__arabic {
    /* Amiri Quran: carries the U+06D6-06ED Qur'anic mark set. */
    font-family: var(--font-quran);
    font-size: clamp(1.27rem, 1.2vw + 1.25rem, 1.57rem);
    line-height: 2.35;
    color: var(--hc-text-primary);
    text-align: right;
    direction: rtl;
    margin-bottom: 1.35rem;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    font-feature-settings:
      "cv01" on,
      "calt" on;
    text-rendering: optimizeLegibility;
  }

  /* Each ayah is its own span so the end-of-verse badge below can be
     glued to the verse it belongs to and wrap with it as a unit. */
  .qv-ayah {
    display: inline;
  }

  /* End-of-ayah marker, drawn in CSS rather than relying on the
     Unicode U+06DD glyph (\u06DD), which most web fonts either lack or
     render as an oversized fallback circle sitting off the baseline --
     the exact "floating O" look this replaces. A small ring with the
     verse number in Arabic-Indic numerals matches printed muṣḥaf
     typesetting and stays correctly sized and aligned in any font. */
  .qv-ayah-end {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: content-box;
    width: 1em;
    height: 1em;
    margin: 0 0.3em;
    border: 1.5px solid var(--hc-gold-dim);
    border-radius: 50%;
    background: rgba(216, 177, 102, 0.08);
    font-family: var(--font-arabic);
    font-size: 0.62em;
    line-height: 1;
    color: var(--hc-gold);
    vertical-align: 0.02em;
    direction: ltr; /* single-digit/short numbers don't need RTL shaping */
  }

  .quran-verse__english {
    font-family: var(--font-body);
    font-size: 1em;
    line-height: 1.75;
    color: var(--hc-text-secondary);
    padding-left: 0;
    border-left: 0;
    font-style: italic;
    margin: 0 0 1.25rem;
  }

  .qv-verse-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4em;
    height: 1.4em;
    margin-inline: 0.4em;
    border: 1px solid var(--hc-rule-strong);
    border-radius: 50%;
    background: rgba(216, 177, 102, 0.08);
    font-family: var(--font-ui);
    font-size: 0.72em;
    font-style: normal;
    font-weight: 700;
    line-height: 1;
    color: var(--hc-text-secondary);
    vertical-align: 0.05em;
  }

  .quran-verse__missing {
    margin: 0;
    color: var(--hc-text-secondary);
    font-style: italic;
  }

  .quran-verse__ref {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.84rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-gold);
    border-top: 1px solid var(--hc-rule-soft);
    padding-top: 1rem;
    font-weight: 700;
  }

  .quran-verse__ref-icon {
    font-size: 0.84rem;
    color: var(--hc-gold-bright);
  }

  :global([data-theme="light"]) .quran-verse {
    background: color-mix(in srgb, var(--hc-surface-2) 65%, transparent);
    border-color: var(--hc-rule);
    border-top-color: var(--hc-rule-strong);
    box-shadow: none;
  }

  :global([data-theme="light"]) .quran-verse__header {
    background: transparent;
  }

  :global([data-theme="light"]) .quran-verse__badge {
    background: transparent;
    color: var(--hc-text-secondary);
  }

  :global([data-theme="light"]) .quran-verse__copy {
    background: rgba(251, 249, 244, 0.9);
    border-color: var(--hc-rule);
    color: var(--hc-text-primary);
  }

  @media (max-width: 640px) {
    .quran-verse {
      margin: 2rem 0;
    }

    .quran-verse__badge {
      padding: 0.4rem 0.85rem;
      font-size: 0.78rem;
    }

    .quran-verse__content {
      padding: 1.1rem;
    }

    .quran-verse__arabic {
      font-size: clamp(1.3rem, 6.8vw, 1.36rem);
      line-height: 2.1;
    }

    .qv-ayah-end {
      margin: 0 0.2em;
    }

    .quran-verse__english {
      padding-left: 0;
      font-size: 1em;
      line-height: 1.72;
    }

    .qv-verse-num {
      width: 1.35em;
      height: 1.35em;
      margin-inline: 0.3em;
    }
  }
</style>
