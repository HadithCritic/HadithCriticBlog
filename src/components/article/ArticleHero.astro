---
export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  category: string;
  date?: string;
  readingTime?: string;
  heroImage?: string;
  heroAlt?: string;
}
const { title, subtitle, description, category, date, readingTime, heroImage, heroAlt } = Astro.props;
---
<section class="article-hero">
  <div class="hc-container hero-grid">
    <div class="hero-content">
      <span class="hc-chip article-hero__chip" data-category={category}>{category}</span>
      <h1 class="hc-title article-hero__title">{title}</h1>
      {subtitle && <h2 class="hc-title article-hero__subtitle">{subtitle}</h2>}
      {description && <p class="hc-copy article-hero__description">{description}</p>}
      <div class="article-meta">
        {date && <span class="hc-eyebrow">{date}</span>}
        {date && readingTime && <span class="hc-eyebrow" style="color: var(--hc-rule-strong);">&middot;</span>}
        {readingTime && <span class="hc-eyebrow">{readingTime}</span>}
      </div>
    </div>
    
    {heroImage && (
      <div class="hero-media">
        <div class="hero-image-wrapper">
        <figure class="hero-plate">
          <img src={heroImage} alt={heroAlt || `Cover for ${title}`} />
        </figure>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .article-hero {
    padding: clamp(3rem, 5vw, 4.5rem) 0;
    border-bottom: 1px solid var(--hc-rule);
    background:
      radial-gradient(circle at 78% 34%, rgba(123,45,36,.12), transparent 45%),
      linear-gradient(135deg, rgba(15,15,16,.98) 0%, rgba(30,29,27,.95) 58%, rgba(15,15,16,.98) 100%);
    position: relative;
    overflow: hidden;
  }
  
  .article-hero::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(216,177,102,.16);
    pointer-events: none;
  }

  .article-hero::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--hc-surface-0));
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(460px, 1.05fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-content,
  .hero-media {
    min-width: 0;
  }

  .article-hero__chip {
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .article-hero__title {
    max-width: 800px;
    margin-bottom: 0.5rem;
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .article-hero__subtitle {
    max-width: 700px;
    margin-bottom: 1.5rem;
    color: var(--hc-gold);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.12;
  }

  .article-hero__description {
    max-width: 650px;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .article-meta {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-plate {
    margin: 0;
    position: relative;
    padding: 0.55rem;
    border: 1px solid var(--hc-rule);
    background: rgba(15,15,16,.68);
    box-shadow: var(--shadow);
  }

  .hero-plate::before {
    content: "";
    position: absolute;
    inset: 1rem;
    border: 1px solid rgba(216,177,102,.14);
    pointer-events: none;
    z-index: 2;
  }

  .hero-plate img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: saturate(.95) contrast(1.04);
  }

  @media (max-width: 1050px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .article-hero {
      /* Add safe area compensation */
      padding: max(2.75rem, calc(2rem + var(--sat, 0px))) 0 2.4rem;
    }

    .article-hero::before {
      inset: 10px;
    }

    .hero-grid {
      gap: 1.6rem;
    }

    .article-hero__chip {
      margin-bottom: 1.1rem;
      max-width: 100%;
      white-space: normal;
    }

    .article-hero__title {
      font-size: clamp(2.35rem, 12vw, 3.35rem);
      line-height: 1.02;
      letter-spacing: -0.015em;
      /* Prevent long words from breaking layout */
      overflow-wrap: break-word;
      word-break: break-word;
    }

    .article-hero__subtitle {
      margin-bottom: 1rem;
      font-size: clamp(1.2rem, 6vw, 1.55rem);
    }

    .article-hero__description {
      font-size: 1rem;
      line-height: 1.65;
    }

    .article-meta {
      margin-top: 1.6rem;
      gap: 0.45rem 0.7rem;
    }

    .hero-plate {
      padding: 0.35rem;
    }

    .hero-plate::before {
      inset: 0.55rem;
    }
  }

  .hero-image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
  }

  .hero-image-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 40%, var(--hc-surface-2) 100%);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
</style>
