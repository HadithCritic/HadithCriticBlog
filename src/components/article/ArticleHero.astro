---
export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  category: string;
  date?: string;
  readingTime?: string;
  heroImage?: string;
}
const { title, subtitle, description, category, date, readingTime, heroImage } = Astro.props;

const bgStyle = heroImage 
  ? `background-image: linear-gradient(90deg, #0f0f10 20%, rgba(15,15,16,0.6) 50%, transparent 100%), url('${heroImage}');`
  : `background: var(--hc-black);`;
---
<section class="article-hero" style={bgStyle}>
  <div class="hc-container hero-inner">
    <span class="hc-chip" style="margin-bottom: 1.5rem; display: inline-block;">{category}</span>
    <h1 class="hc-title hc-title--xl" style="font-size: clamp(3rem, 5vw, 4.5rem); line-height: 1.05; max-width: 800px; margin-bottom: 0.5rem;">{title}</h1>
    {subtitle && <h2 class="hc-title" style="font-size: clamp(1.4rem, 2vw, 1.8rem); color: var(--hc-gold); max-width: 700px; margin-bottom: 1.5rem;">{subtitle}</h2>}
    {description && <p class="hc-copy" style="max-width: 650px; font-size: 1.1rem; line-height: 1.6;">{description}</p>}
    <div class="article-meta">
      {date && <span class="hc-eyebrow">{date}</span>}
      {date && readingTime && <span class="hc-eyebrow" style="color: var(--hc-rule-strong);">•</span>}
      {readingTime && <span class="hc-eyebrow">{readingTime}</span>}
    </div>
  </div>
</section>

<style>
  .article-hero {
    padding: clamp(4rem, 8vw, 8rem) 0;
    background-size: cover;
    background-position: center right;
    border-bottom: 1px solid var(--hc-rule);
    min-height: 50vh;
    display: flex;
    align-items: center;
    position: relative;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
  }
  .article-meta {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
</style>
