---
/**
 * A thematic break between parts of an article: the ornament rule, then an
 * optional part title. The title is a real h2 so it reaches the contents.
 */
export interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const id = title
  ? title.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
  : undefined;
---

<div class="hc-part">
  <span class="hc-part__ornament" aria-hidden="true"></span>
  {title && <h2 class="hc-part__title" id={id}>{title}</h2>}
  {subtitle && <p class="hc-part__subtitle">{subtitle}</p>}
</div>
