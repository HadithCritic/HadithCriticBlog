---
/** The conclusion the article reaches. Authoring name for <Note kind="verdict">. */
import Note, { type NoteFact } from './Note.astro';

export interface Props {
  title?: string;
  status?: string;
  /** Short figures printed under the verdict. Statements of fact, never a grade. */
  facts?: NoteFact[];
}

const { title = 'Analytical Verdict', status, facts } = Astro.props;
---

<Note kind="verdict" title={title} status={status} facts={facts}><slot /></Note>
