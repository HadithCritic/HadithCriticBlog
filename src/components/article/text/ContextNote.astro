---
/** Background the argument leans on. Authoring name for <Note kind="context">. */
import Note from './Note.astro';

export interface Props {
  title?: string;
  collapsible?: boolean;
}

const { title = 'Historical Context', collapsible = false } = Astro.props;
---

<Note kind="context" title={title} collapsible={collapsible}><slot /></Note>
