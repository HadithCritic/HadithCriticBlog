---
/** The thesis the article argues. Authoring name for <Note kind="claim">. */
import Note, { type NoteFact } from './Note.astro';

export interface Props {
  title?: string;
  /** Short figures printed under the claim: `[{ value: '2', label: 'Routes' }]`. */
  facts?: NoteFact[];
}

const { title = 'Core Thesis', facts } = Astro.props;
---

<Note kind="claim" title={title} facts={facts}><slot /></Note>
