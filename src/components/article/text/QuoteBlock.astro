---
/**
 * A quotation from a modern or classical author that is not scripture or a
 * report. Purely typographic: an indented passage with a hanging mark and an
 * attribution line, no box.
 */
export interface Props {
  author?: string;
  source?: string;
  sourceUrl?: string;
}

const { author, source, sourceUrl } = Astro.props;
---

<figure class="hc-quote">
  <blockquote class="hc-quote__text"><slot /></blockquote>
  {(author || source) && (
    <figcaption class="hc-quote__by">
      {author && <span class="hc-quote__author">{author}</span>}
      {source && (sourceUrl
        ? <cite><a href={sourceUrl} target="_blank" rel="noopener noreferrer">{source}</a></cite>
        : <cite>{source}</cite>)}
    </figcaption>
  )}
</figure>
