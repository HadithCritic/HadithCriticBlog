---
export interface Props {
  title?: string;
}
const { title = "Core Thesis" } = Astro.props;
---
<div class="hc-article-panel claim-box">
  <div class="claim-header">
    <span class="claim-badge">
      <span class="claim-badge__icon" aria-hidden="true">✦</span>
      <span class="claim-badge__text">{title}</span>
    </span>
  </div>
  <div class="claim-content">
    <slot />
  </div>
</div>

<style>
  .claim-box {
    position: relative;
    margin: 2.75rem 0;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid var(--hc-rule);
    border-top: 3px solid var(--hc-gold);
    border-radius: var(--radius-sm);
    background:
      radial-gradient(circle at 95% 5%, rgba(216, 177, 102, 0.06), transparent 45%),
      linear-gradient(
        140deg,
        color-mix(in srgb, var(--hc-surface-2) 90%, transparent),
        color-mix(in srgb, var(--hc-surface-1) 96%, transparent)
      );
    box-shadow:
      0 1px 0 rgba(216, 177, 102, 0.08) inset,
      0 18px 50px rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }

  .claim-box::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--hc-gold), transparent 80%);
    pointer-events: none;
  }

  .claim-header {
    margin-bottom: 1.1rem;
  }

  .claim-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgba(216, 177, 102, 0.12);
    border: 1px solid rgba(216, 177, 102, 0.25);
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .claim-badge__icon {
    font-size: 0.78rem;
    color: var(--hc-gold-bright);
  }

  .claim-content {
    font-family: var(--font-body);
    font-size: clamp(1.08rem, 0.3vw + 1.02rem, 1.2rem);
    line-height: 1.78;
    color: var(--hc-text-primary);
    font-style: italic;
  }

  .claim-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .claim-content :global(strong) {
    font-weight: 700;
    color: var(--hc-text-primary);
    font-style: normal;
  }

  :global([data-theme="light"]) .claim-box {
    background:
      radial-gradient(circle at 95% 5%, rgba(176, 126, 44, 0.08), transparent 45%),
      linear-gradient(140deg, rgba(251, 249, 244, 0.98), rgba(244, 239, 229, 0.96));
    border-color: var(--hc-rule);
    border-top-color: var(--hc-gold);
    box-shadow: 0 10px 35px rgba(43, 40, 36, 0.08);
  }

  :global([data-theme="light"]) .claim-badge {
    background: rgba(176, 126, 44, 0.1);
    border-color: rgba(176, 126, 44, 0.3);
    color: var(--hc-gold);
  }

  @media (max-width: 640px) {
    .claim-box {
      margin: 2rem 0;
      padding: 1.2rem 1.1rem;
    }

    .claim-content {
      font-size: 1.04rem;
      line-height: 1.68;
    }
  }
</style>
