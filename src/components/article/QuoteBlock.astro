---
export interface Props {
  author?: string;
  source?: string;
  sourceUrl?: string;
}
const { author, source, sourceUrl } = Astro.props;
---
<figure class="quote-block">
  <div class="quote-block__content">
    <slot />
  </div>
  {(author || source) && (
    <figcaption class="quote-block__footer">
      {author && <span class="quote-block__author">{author}</span>}
      {source && (
        sourceUrl ? (
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="quote-block__source-link">
            ({source})
          </a>
        ) : (
          <span class="quote-block__source">({source})</span>
        )
      )}
    </figcaption>
  )}
</figure>

<style>
  .quote-block {
    position: relative;
    margin: 2.75rem 0;
    padding: clamp(1.4rem, 3vw, 2.2rem) clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--hc-rule);
    background: color-mix(in srgb, var(--hc-surface-2) 70%, transparent);
    border-radius: var(--radius-sm);
    box-shadow: none;
  }

  .quote-block__content {
    font-family: var(--font-body);
    font-size: 1em;
    line-height: 1.72;
    color: var(--hc-text-primary);
    font-style: italic;
  }

  .quote-block__content :global(p:last-child) {
    margin-bottom: 0;
  }

  .quote-block__content :global(strong) {
    font-style: normal;
    color: var(--hc-text-primary);
    font-weight: 700;
  }

  .quote-block__footer {
    margin-top: 1.15rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hc-rule-soft);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--hc-text-tertiary);
    flex-wrap: wrap;
  }

  .quote-block__author {
    font-weight: 600;
    color: var(--hc-text-primary);
  }

  .quote-block__source {
    color: var(--hc-text-secondary);
  }

  .quote-block__source-link {
    color: var(--hc-gold-dim);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 180ms ease;
  }

  .quote-block__source-link:hover {
    color: var(--hc-gold);
  }

  :global([data-theme="light"]) .quote-block {
    background: color-mix(in srgb, var(--hc-surface-2) 70%, transparent);
    border-color: var(--hc-rule);
    box-shadow: none;
  }

  @media (max-width: 640px) {
    .quote-block {
      margin: 2rem 0;
      padding: 1.15rem 1.1rem;
    }

    .quote-block__content {
      font-size: 1em;
      line-height: 1.72;
    }
  }
</style>
