---
interface Props {
  headings: { depth: number; text: string; slug: string }[];
}

const { headings } = Astro.props;
---

{headings.length > 0 && (
  <nav class="editorial-toc" aria-label="Table of contents">
    <div class="editorial-toc__header">
      <span class="editorial-toc__title">Sections & Headings</span>
      <span class="editorial-toc__count">{headings.length}</span>
    </div>

    <ul class="editorial-toc__list">
      {headings.map((h) => (
        <li class={`editorial-toc__item ${h.depth === 3 ? 'editorial-toc__item--sub' : ''}`}>
          <a href={`#${h.slug}`} class="editorial-toc__link" data-toc-slug={h.slug}>
            <span class="editorial-toc__text">{h.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function initEditorialToc() {
    const links = [...document.querySelectorAll<HTMLElement>('.editorial-toc__link')];
    if (!links.length) return;

    const slugs = links.map((l) => l.dataset.tocSlug).filter(Boolean) as string[];
    const ACTIVE_OFFSET_PX = 140;

    let frame = 0;
    const resolveActive = () => {
      frame = 0;
      let current = slugs[0];

      for (const slug of slugs) {
        const el = document.getElementById(slug);
        if (!el) continue;
        if (el.getBoundingClientRect().top > ACTIVE_OFFSET_PX) break;
        current = slug;
      }

      links.forEach((link) => {
        const isActive = link.dataset.tocSlug === current;
        link.classList.toggle('is-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    const onScroll = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(resolveActive);
    };

    resolveActive();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEditorialToc);
  } else {
    initEditorialToc();
  }
  document.addEventListener('astro:page-load', initEditorialToc);
</script>

<style>
  .editorial-toc {
    padding-top: 0.85rem;
    border-top: 1px solid var(--hc-rule-soft);
  }

  .editorial-toc__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.55rem;
    gap: 0.75rem;
  }

  .editorial-toc__title {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--hc-text-secondary);
  }

  .editorial-toc__count {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--hc-gold);
  }

  .editorial-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .editorial-toc__item {
    margin: 0;
    padding: 0;
  }

  .editorial-toc__item--sub {
    padding-inline-start: 0.75rem;
  }

  .editorial-toc__link {
    display: flex;
    display: block;
    padding: 0.32rem 0.5rem;
    border-inline-start: 1px solid transparent;
    color: var(--hc-text-secondary);
    font-family: var(--font-body);
    font-size: 0.79rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .editorial-toc__text {
    display: block;
    overflow-wrap: anywhere;
  }

  .editorial-toc__link:hover {
    color: var(--hc-text-primary);
  }

  .editorial-toc__link.is-active {
    color: var(--hc-gold);
    border-inline-start-color: var(--hc-gold-dim);
  }
</style>
