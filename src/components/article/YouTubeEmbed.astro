---
export interface Props {
  url: string;
  title?: string;
  channel?: string;
  date?: string;
}

const { url, title, channel = 'YouTube', date } = Astro.props;

function parseYouTube(raw: string) {
  let id = '';
  let start = '';
  try {
    const source = new URL(raw);
    if (source.hostname.includes('youtu.be')) {
      id = source.pathname.replace('/', '');
    } else {
      id = source.searchParams.get('v') ?? source.pathname.split('/embed/')[1] ?? '';
      const time = source.searchParams.get('t');
      if (time) start = time.replace('s', '');
    }
  } catch {
    id = raw;
  }
  return { id, start };
}

const { id: videoId, start } = parseYouTube(url);
const thumbnail = `https://i.ytimg.com/vi/${videoId}/mqdefault.jpg`;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}${start ? `&t=${start}s` : ''}`;
---

<figure class="yt-cite" role="region" aria-label={title ? `Video citation: ${title}` : 'YouTube video citation'}>
  <div class="yt-cite__player" data-yt-id={videoId} data-yt-start={start}>
    <button
      type="button"
      class="yt-cite__facade"
      aria-label={`Play video${title ? `: ${title}` : ''}`}
    >
      <img
        class="yt-cite__thumb"
        src={thumbnail}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <span class="yt-cite__play">Play video</span>
    </button>
  </div>

  <figcaption class="yt-cite__body">
    <div class="yt-cite__source">
      <span class="yt-cite__label">Video source</span>
      <span class="yt-cite__channel">{channel}</span>
    </div>
    {title && <h3 class="yt-cite__title">{title}</h3>}
    {date && <time class="yt-cite__date" datetime={date}>{date}</time>}
    <a href={watchUrl} target="_blank" rel="noopener noreferrer" class="yt-cite__link">
      Watch on YouTube
    </a>
  </figcaption>
</figure>

<script is:inline>
  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!(target instanceof Element)) return;
    var button = target.closest('.yt-cite__facade');
    if (!button) return;
    var player = button.closest('[data-yt-id]');
    if (!player) return;
    var id = player.dataset.ytId;
    var startAt = player.dataset.ytStart;
    if (!id) return;

    var iframe = document.createElement('iframe');
    iframe.src =
      'https://www.youtube-nocookie.com/embed/' +
      id +
      '?autoplay=1&rel=0' +
      (startAt ? '&start=' + startAt : '');
    iframe.title = 'YouTube video player';
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute(
      'allow',
      'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share',
    );
    iframe.setAttribute('allowfullscreen', 'true');
    player.replaceChildren(iframe);
  });
</script>

<style>
  .yt-cite {
    display: grid;
    grid-template-columns: minmax(12rem, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 1rem;
    width: min(100%, 42rem);
    margin: clamp(1.75rem, 3vw, 2.5rem) 0;
    padding-block: 0.75rem;
    border-block: 1px solid var(--hc-rule-soft);
    color: var(--hc-text-primary);
  }

  .yt-cite__player {
    position: relative;
    min-width: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--hc-surface-0);
  }

  .yt-cite__player iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt-cite__facade {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--hc-text-primary);
    cursor: pointer;
  }

  .yt-cite__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.68) saturate(0.76);
    transition: filter 180ms ease;
  }

  .yt-cite__facade:hover .yt-cite__thumb,
  .yt-cite__facade:focus-visible .yt-cite__thumb {
    filter: brightness(0.82) saturate(0.86);
  }

  .yt-cite__play {
    position: relative;
    padding: 0.42rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--hc-text-primary) 48%, transparent);
    background: color-mix(in srgb, var(--hc-surface-0) 82%, transparent);
    color: var(--hc-text-primary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.035em;
  }

  .yt-cite__body {
    min-width: 0;
    padding-inline-end: 0.5rem;
  }

  .yt-cite__source {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.55rem;
    margin-bottom: 0.35rem;
  }

  .yt-cite__label {
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .yt-cite__channel,
  .yt-cite__date {
    color: var(--hc-text-tertiary);
    font-size: 0.76rem;
  }

  .yt-cite__title {
    margin: 0 0 0.55rem;
    color: var(--hc-text-primary);
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.34;
    text-wrap: pretty;
  }

  .yt-cite__date {
    display: block;
    margin-bottom: 0.6rem;
    font-variant-numeric: tabular-nums;
  }

  .yt-cite__link {
    display: inline-block;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--hc-rule-strong);
    text-underline-offset: 0.2em;
  }

  .yt-cite__link:hover {
    color: var(--hc-gold);
    text-decoration-color: currentColor;
  }

  :global([data-theme="light"]) .yt-cite__thumb {
    filter: brightness(0.82) saturate(0.78);
  }

  @media (max-width: 560px) {
    .yt-cite {
      grid-template-columns: 1fr;
      max-width: 34rem;
      gap: 0.65rem;
    }

    .yt-cite__body {
      padding-inline: 0.1rem;
    }
  }
</style>
