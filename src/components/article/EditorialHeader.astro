---
interface Props {
  category: string;
  wordCount?: number;
  readingMinutes?: number;
  author?: string;
  title: string;
  description?: string;
  date?: string;
  heroImage?: string;
  heroAlt?: string;
}

const {
  category,
  wordCount = 0,
  readingMinutes = 1,
  author = 'HadithCritic',
  title,
  description,
  date,
  heroImage,
  heroAlt
} = Astro.props;
---

<header class="editorial-header">
  {category && (
    <div class="editorial-header__category">
      <a href={`/blogs?category=${encodeURIComponent(category)}`} class="editorial-header__category-link">
        {category}
      </a>
    </div>
  )}

  <div class="editorial-header__meta">
    {wordCount > 0 && (
      <>
        <span>{wordCount.toLocaleString('en-US')} Words</span>
        <span class="meta-sep" aria-hidden="true">|</span>
      </>
    )}
    <span>{readingMinutes} Min Read</span>
    <span class="meta-sep" aria-hidden="true">|</span>
    <span class="meta-author">{author}</span>
    {date && (
      <>
        <span class="meta-sep" aria-hidden="true">|</span>
        <span class="meta-date">{date}</span>
      </>
    )}
  </div>

  <h1 class="editorial-header__title">{title}</h1>

  {description && (
    <p class="editorial-header__standfirst">{description}</p>
  )}

  <div class="editorial-header__ornament" aria-hidden="true">
    <span class="ornament-line"></span>
    <span class="ornament-glyph">✦</span>
    <span class="ornament-line"></span>
  </div>

  {heroImage && (
    <div class="editorial-header__media">
      <figure class="editorial-header__plate">
        <img src={heroImage} alt={heroAlt || `Cover illustration for ${title}`} loading="eager" />
      </figure>
    </div>
  )}
</header>

<style>
  .editorial-header {
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
    padding-bottom: 0.5rem;
  }

  .editorial-header__category {
    margin-bottom: 1rem;
  }

  .editorial-header__category-link {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hc-gold);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .editorial-header__category-link:hover {
    color: var(--hc-gold-bright);
  }

  .editorial-header__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .meta-sep {
    color: var(--hc-rule-strong);
    opacity: 0.6;
  }

  .meta-author {
    color: var(--hc-text-secondary);
  }

  .meta-date {
    color: var(--hc-text-tertiary);
  }

  .editorial-header__title {
    max-width: 32ch;
    margin: 0 auto 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 4.2vw, 3.4rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--hc-text-primary);
    text-wrap: balance;
  }

  .editorial-header__standfirst {
    max-width: 48ch;
    margin: 0 auto 1.75rem;
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1.35vw, 1.25rem);
    font-style: italic;
    line-height: 1.55;
    color: var(--hc-text-secondary);
  }

  .editorial-header__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    max-width: 220px;
    margin: 2rem auto;
    color: var(--hc-gold);
    opacity: 0.55;
  }

  .ornament-line {
    flex: 1;
    height: 1px;
    background: var(--hc-rule);
  }

  .ornament-glyph {
    font-size: 0.85rem;
    color: var(--hc-gold);
  }

  .editorial-header__media {
    margin-top: 2rem;
    margin-bottom: 1.5rem;
  }

  .editorial-header__plate {
    margin: 0;
    padding: 6px;
    border: 1px solid var(--hc-rule);
    background: color-mix(in srgb, var(--hc-surface-1) 80%, transparent);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
    border-radius: 2px;
  }

  .editorial-header__plate img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--hc-rule-soft);
  }

  @media (max-width: 640px) {
    .editorial-header__title {
      font-size: clamp(1.75rem, 7vw, 2.3rem);
    }
    .editorial-header__standfirst {
      font-size: 1.05rem;
    }
  }
</style>
