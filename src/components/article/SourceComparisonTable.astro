---
export interface Props {
  stickyFirstCol?: boolean;
  caption?: string;
}

const { stickyFirstCol = false, caption } = Astro.props;
---

<div class={`hc-source-table-wrapper ${stickyFirstCol ? 'has-sticky-col' : ''}`} data-source-table-wrap>
  <table class="hc-source-table">
    {caption && <caption class="hc-source-table__caption">{caption}</caption>}
    <thead>
      <tr>
        <slot name="header" />
      </tr>
    </thead>
    <tbody>
      <slot />
    </tbody>
  </table>
  <p class="hc-source-table__hint">Scroll horizontally to see all columns</p>
</div>

<style>
  .hc-source-table-wrapper {
    max-width: 100%;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
    border-block: 1px solid var(--hc-rule-soft);
  }

  .hc-source-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    text-align: left;
  }

  .hc-source-table__caption {
    caption-side: top;
    padding: 0.55rem 0.75rem 0.75rem;
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: left;
  }

  .hc-source-table :global(th),
  .hc-source-table :global(td) {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .hc-source-table :global(thead th) {
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
    background: transparent;
    border-block: 1px solid var(--hc-rule-soft);
  }

  .hc-source-table :global(tbody th[scope="row"]) {
    width: 25%;
    color: var(--hc-text-primary);
    font-family: var(--font-body);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .hc-source-table :global(tbody td) {
    color: var(--hc-text-secondary);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .hc-source-table :global(tbody tr:last-child th),
  .hc-source-table :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .hc-source-table :global(td strong) {
    color: var(--hc-text-primary);
    font-weight: 600;
  }

  .has-sticky-col .hc-source-table :global(th:first-child),
  .has-sticky-col .hc-source-table :global(td:first-child) {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--hc-surface-1);
  }

  .hc-source-table__hint {
    display: none;
    margin: 0;
    padding: 0.45rem 0;
    color: var(--hc-text-tertiary);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  :global([data-theme="light"]) .has-sticky-col .hc-source-table :global(th:first-child),
  :global([data-theme="light"]) .has-sticky-col .hc-source-table :global(td:first-child) {
    background: var(--hc-surface-1);
  }

  @media (max-width: 640px) {
    .hc-source-table {
      min-width: 34rem;
    }

    .hc-source-table :global(th),
    .hc-source-table :global(td) {
      padding: 0.55rem 0.6rem;
    }

    .hc-source-table :global(tbody td) {
      font-size: 0.82rem;
    }

    .hc-source-table__hint {
      display: block;
    }
  }
</style>
