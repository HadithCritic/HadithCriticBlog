---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { title, description, image, canonical } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} canonical={canonical} type="article">
  <div class="reading-progress" aria-hidden="true"><div class="reading-progress__bar" data-reading-progress-bar></div></div>
  <div class="hc-article">
    <slot name="hero" />
    <slot name="metabar" />
    <div class="hc-article-grid">
      <div class="article-margin-left"></div>
      <div class="article-main-content"><slot /></div>
      <aside class="article-margin-right"><slot name="toc" /></aside>
    </div>
  </div>
</BaseLayout>

<style>
  .reading-progress { position: fixed; top: 0; right: 0; left: 0; z-index: 1000; height: 3px; padding-inline: var(--safe-right) var(--safe-left); pointer-events: none; }
  .reading-progress__bar { width: 100%; height: 100%; background: var(--hc-gold); box-shadow: 0 0 8px rgba(216, 177, 102, .3); transform: scaleX(0); transform-origin: left; }
  .article-margin-left, .article-margin-right { display: none; }.article-main-content { width: 100%; min-width: 0; }
  @media (min-width: 1200px) { .article-margin-left, .article-margin-right { display: block; }.article-margin-right { position: sticky; top: calc(8rem + var(--safe-top)); height: fit-content; } }
  @media (max-width: 640px) { .reading-progress { height: 2px; } }
</style>
