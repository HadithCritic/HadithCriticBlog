---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { title, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <main class="hc-article">
    <slot name="hero" />
    <slot name="metabar" />
    <div class="hc-article-grid">
      <div class="article-margin-left">
        <!-- Optional left margin content -->
      </div>
      <div class="article-main-content">
        <slot />
      </div>
      <aside class="article-margin-right">
        <slot name="toc" />
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .article-margin-left {
    display: none;
  }
  .article-margin-right {
    display: none;
  }
  .article-main-content {
    width: 100%;
  }

  @media (min-width: 1200px) {
    .article-margin-left {
      display: block;
    }
    .article-margin-right {
      display: block;
      position: sticky;
      top: 140px;
      height: fit-content;
    }
  }
</style>
