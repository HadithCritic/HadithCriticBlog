---
/**
 * What follows the last note: the article's topics, the studies on either
 * side of it in the archive, and further reading from its own branch. Set
 * as text and rules, never cards, so the essay ends rather than gives way to
 * a feed.
 */
export interface Neighbour {
  href: string;
  title: string;
}

export interface FurtherStudy {
  href: string;
  title: string;
  folio: string;
  dateLabel: string;
}

export interface Props {
  tags?: string[];
  category: string;
  categoryHref: string;
  categoryCount: number;
  earlier?: Neighbour;
  later?: Neighbour;
  further: FurtherStudy[];
}

const { tags = [], category, categoryHref, categoryCount, earlier, later, further } = Astro.props;
---

<footer class="hc-end">
  {tags.length > 0 && (
    <p class="hc-end__topics"><span class="hc-end__label">Topics</span> {tags.join(', ')}</p>
  )}

  {(earlier || later) && (
    <nav class="hc-turn" aria-label="Adjacent studies">
      {earlier
        ? <a class="hc-turn__link" href={earlier.href} rel="prev"><span class="hc-end__label">Earlier study</span><span class="hc-turn__title">{earlier.title}</span></a>
        : <span />}
      {later && <a class="hc-turn__link hc-turn__link--later" href={later.href} rel="next"><span class="hc-end__label">Later study</span><span class="hc-turn__title">{later.title}</span></a>}
    </nav>
  )}

  {further.length > 0 && (
    <section class="hc-further" aria-labelledby="hc-further-title">
      <h2 id="hc-further-title" class="hc-further__title">More in <span data-category={category}>{category}</span></h2>
      <ol class="hc-further__list">
        {further.map((study) => (
          <li>
            <span class="hc-further__folio" aria-hidden="true">{study.folio}</span>
            <a href={study.href}>{study.title}</a>
            <span class="hc-further__date">{study.dateLabel}</span>
          </li>
        ))}
      </ol>
      <a class="hc-further__all" href={categoryHref}>All {categoryCount} studies in {category}</a>
    </section>
  )}
</footer>
