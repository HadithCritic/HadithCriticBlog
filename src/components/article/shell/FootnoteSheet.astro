---
// FootnoteSheet.astro - Interactive mobile bottom-sheet & desktop modal for footnote citations
---

<dialog class="footnote-dialog" id="footnoteDialog" aria-labelledby="footnoteTitle">
  <div class="footnote-sheet">
    <div class="footnote-sheet__header">
      <div class="footnote-sheet__title-wrap">
        <h3 id="footnoteTitle" class="footnote-sheet__title">Note</h3>
      </div>
      <button type="button" class="footnote-sheet__close" id="footnoteClose" aria-label="Close citation">
        Close
      </button>
    </div>

    <div class="footnote-sheet__body" id="footnoteContent">
      <!-- Cloned footnote content injected dynamically -->
    </div>

    <div class="footnote-sheet__footer">
      <a href="#footnote-label" class="footnote-sheet__jump" id="footnoteJumpLink">
        Go to the note
      </a>
    </div>
  </div>
</dialog>

<script>
  function initFootnotes() {
    const dialog = document.querySelector<HTMLDialogElement>('#footnoteDialog');
    const closeBtn = document.querySelector<HTMLButtonElement>('#footnoteClose');
    const titleEl = document.querySelector<HTMLElement>('#footnoteTitle');
    const contentEl = document.querySelector<HTMLElement>('#footnoteContent');
    const jumpLink = document.querySelector<HTMLAnchorElement>('#footnoteJumpLink');

    if (!dialog || !closeBtn || !titleEl || !contentEl) return;

    const closeDialog = () => {
      if (dialog.open) {
        dialog.close();
      }
    };

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });

    closeBtn.addEventListener('click', closeDialog);
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });

    if (jumpLink) {
      jumpLink.addEventListener('click', (event) => {
        event.preventDefault();
        const targetId = jumpLink.hash.slice(1);
        const targetEl = document.getElementById(targetId);
        closeDialog();
        if (!targetEl) return;
        history.pushState(null, '', `#${targetId}`);
        targetEl.setAttribute('tabindex', '-1');
        targetEl.focus({ preventScroll: true });
        targetEl.scrollIntoView({
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start'
        });
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dialog.open) {
        closeDialog();
      }
    });

    // Intercept footnote reference clicks
    const footnoteLinks = document.querySelectorAll<HTMLAnchorElement>(
      'a[data-footnote-ref], sup a[href^="#user-content-fn-"], sup a[href^="#fn-"]'
    );

    footnoteLinks.forEach((link) => {
      if (link.dataset.footnotePopupBound || link.closest('.footnotes')) return;
      link.dataset.footnotePopupBound = 'true';
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return;

        const targetId = href.slice(1);
        const targetEl = document.getElementById(targetId) || document.getElementById(`user-content-${targetId}`);
        if (!targetEl || typeof dialog.showModal !== 'function') return;

        e.preventDefault();

        // Extract footnote text/html
        const clone = targetEl.cloneNode(true) as HTMLElement;
        // Remove backrefs
        clone.querySelectorAll('[data-footnote-backref], .data-footnote-backref, a[href^="#fnref"]').forEach((el) => el.remove());

        // Extract footnote label/number
        const refText = link.textContent?.trim() || '';
        titleEl.textContent = refText ? `Note ${refText}` : 'Note';

        if (jumpLink) {
          jumpLink.setAttribute('href', `#${targetId}`);
        }

        contentEl.innerHTML = clone.innerHTML;

        dialog.showModal();
        document.body.style.overflow = 'hidden';
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFootnotes);
  } else {
    initFootnotes();
  }
  document.addEventListener('astro:page-load', initFootnotes);
</script>

<style>
  /* A sheet from the bottom on phones, a centred note on wider screens.
     Rendered inside .hc-article, so it reads the reader palette. */
  .footnote-dialog {
    margin: auto auto 0 auto;
    width: 100%;
    max-width: 36rem;
    padding: 0;
    border: 0;
    border-top: 1px solid var(--r-rule-accent);
    border-radius: 0;
    background: var(--r-bg);
    color: var(--r-ink);
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.25);
  }

  @media (prefers-reduced-motion: no-preference) {
    .footnote-dialog[open] {
      animation: footnoteSlideUp 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes footnoteSlideUp {
    from {
      transform: translateY(16px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .footnote-dialog::backdrop {
    background: rgba(10, 10, 10, 0.5);
  }

  .footnote-sheet {
    display: flex;
    flex-direction: column;
    max-height: 75vh;
    max-height: 75dvh;
  }

  .footnote-sheet__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.35rem 0.4rem;
  }

  .footnote-sheet__title {
    margin: 0;
    color: var(--r-ink-3);
    font: 500 1rem/1.3 var(--font-body);
    font-variant-caps: small-caps;
    font-variant-numeric: lining-nums;
    letter-spacing: 0.06em;
  }

  .footnote-sheet__close {
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--r-ink-3);
    font: 400 0.82rem/1 var(--font-ui);
    cursor: pointer;
    transition: color 160ms ease;
  }

  .footnote-sheet__close:hover {
    color: var(--r-ink);
  }

  .footnote-sheet__body {
    padding: 0.2rem 1.35rem 1rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    color: var(--r-ink);
    font: 400 1rem/1.65 var(--font-body);
  }

  .footnote-sheet__body :global(p) {
    margin: 0 0 0.75rem;
  }

  .footnote-sheet__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .footnote-sheet__body :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--r-rule-accent);
    text-underline-offset: 0.18em;
  }

  .footnote-sheet__footer {
    display: flex;
    justify-content: flex-end;
    padding: 0.5rem 1.35rem max(0.9rem, var(--sab, var(--safe-bottom, 0px)));
    border-top: 1px solid var(--r-rule);
  }

  .footnote-sheet__jump {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--r-accent);
    font: 400 0.82rem/1.2 var(--font-ui);
    text-decoration: none;
  }

  .footnote-sheet__jump:hover {
    color: var(--r-accent-hover);
  }

  @media (min-width: 768px) {
    .footnote-dialog {
      margin: auto;
      border: 1px solid var(--r-rule-strong);
      border-top: 1px solid var(--r-rule-accent);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
    }
  }
</style>
