---
/**
 * The article's opening, in reading order: where it sits (Studies, then its
 * branch), the title, the standfirst, one line of facts, then the artwork as
 * a plate at the width of the text. Topics are listed at the end of the
 * article, not here, so the opening stays a title page.
 */
export interface Props {
  title: string;
  description?: string;
  category: string;
  categoryHref: string;
  author: string;
  dateISO: string;
  dateLabel: string;
  updatedISO?: string;
  updatedLabel?: string;
  readingMinutes: number;
  heroImage?: string;
  heroAlt?: string;
  heroSrcset?: string;
  heroWidth?: number;
  heroHeight?: number;
}

const {
  title, description, category, categoryHref, author, dateISO, dateLabel,
  updatedISO, updatedLabel, readingMinutes, heroImage, heroAlt, heroSrcset, heroWidth = 1200, heroHeight = 675
} = Astro.props;
---

<header class="hc-head">
  <p class="hc-head__trail">
    <a href="/blogs/">Studies</a>
    <span aria-hidden="true">/</span>
    <a href={categoryHref} class="hc-head__branch" data-category={category}>{category}</a>
  </p>

  <h1 class="hc-head__title">{title}</h1>

  {description && <p class="hc-head__standfirst">{description}</p>}

  <p class="hc-head__meta">
    <span>By {author}</span>
    <time datetime={dateISO}>{dateLabel}</time>
    {updatedISO && <span>Revised <time datetime={updatedISO}>{updatedLabel}</time></span>}
    <span>{readingMinutes} min read</span>
  </p>

  {heroImage && (
    <figure class="hc-head__plate">
      <img src={heroImage} srcset={heroSrcset} sizes="(max-width: 800px) 100vw, 900px" alt={heroAlt ?? ''} width={heroWidth} height={heroHeight} decoding="async" fetchpriority="high" />
    </figure>
  )}
</header>
