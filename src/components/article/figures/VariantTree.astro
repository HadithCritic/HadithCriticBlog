---
/**
 * One bottleneck fanning into several wordings of the matn. The head is the
 * transmission: the root and the common transmitter as a short chain. Below
 * it the wordings stand one above another on parchment, each version the
 * full width: a version letter and its sources, the transmitter and route,
 * the Arabic, the English.
 *
 * `marks` lists the exact words that differ, in either language; each is
 * highlighted where it first occurs in that version's Arabic or English.
 * Styled in src/styles/article-plates.css, "Variant tree".
 */
export interface VariantBranch {
  name: string;
  from?: string;
  /** The wording in Arabic, set above the English. */
  arabic?: string;
  quote: string;
  sources: string;
  /** Exact substrings to highlight as the point of difference. */
  marks?: string[];
}

export interface Props {
  title: string;
  root: string;
  bottleneck: string;
  branches: VariantBranch[];
  ariaLabel?: string;
}

interface Part {
  text: string;
  marked: boolean;
}

/** Splits a text at the first occurrence of each mark, in reading order. */
function markText(text: string, marks: string[] = []): Part[] {
  const hits = marks
    .map((mark) => ({ mark, at: mark ? text.indexOf(mark) : -1 }))
    .filter((hit) => hit.at >= 0)
    .sort((a, b) => a.at - b.at);
  const parts: Part[] = [];
  let cursor = 0;
  for (const { mark, at } of hits) {
    if (at < cursor) continue;
    if (at > cursor) parts.push({ text: text.slice(cursor, at), marked: false });
    parts.push({ text: mark, marked: true });
    cursor = at + mark.length;
  }
  if (cursor < text.length) parts.push({ text: text.slice(cursor), marked: false });
  return parts;
}

const { title, root, bottleneck, branches, ariaLabel } = Astro.props;
const letter = (index: number) => String.fromCharCode(65 + index);
---

<figure class="variant-tree" aria-label={ariaLabel || title}>
  <figcaption class="variant-tree__head">
    <span class="variant-tree__eyebrow">Transmission variants</span>
    <span class="variant-tree__title">{title}</span>
  </figcaption>

  <p class="variant-tree__trunk">
    <span class="variant-tree__root">{root}</span>
    <span class="variant-tree__arrow" aria-hidden="true"></span>
    <span class="variant-tree__bottleneck">
      <span class="variant-tree__tag">Common transmitter</span>
      <span class="variant-tree__bottleneck-name">{bottleneck}</span>
    </span>
  </p>

  <ol class="variant-tree__versions">
    {branches.map((branch, index) => (
      <li class="variant-tree__version">
        <p class="variant-tree__version-head">
          <span class="variant-tree__letter">Version {letter(index)}</span>
          <span class="variant-tree__sources">{branch.sources}</span>
        </p>
        <p class="variant-tree__name">
          {branch.name}{branch.from && <span class="variant-tree__from"> via {branch.from}</span>}
        </p>
        {branch.arabic && (
          <p class="variant-tree__ar" lang="ar" dir="rtl">
            {markText(branch.arabic, branch.marks).map((part) => (part.marked ? <mark>{part.text}</mark> : part.text))}
          </p>
        )}
        <p class:list={['variant-tree__quote', { 'variant-tree__quote--alone': !branch.arabic }]}>
          {markText(branch.quote, branch.marks).map((part) => (part.marked ? <mark>{part.text}</mark> : part.text))}
        </p>
      </li>
    ))}
  </ol>
</figure>
