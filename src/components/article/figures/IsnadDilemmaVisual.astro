---
/**
 * The isnad dilemma as one picture: five hundred people claimed in the text
 * on the left, one recoverable witness on the right, the lines between them
 * converging. The dot field is exactly 25 by 20, so it holds 500 dots. Used
 * in study 63 directly after its courtroom section, so the analogy is not
 * repeated here. Static markup only, so its styles can stay scoped.
 */
const strands = [-62, -42, -22, 0, 22, 42, 62];
---

<figure class="dilemma" aria-labelledby="dilemma-title">
  <figcaption class="dilemma__head">
    <span class="dilemma__kicker">Evidence method</span>
    <h2 id="dilemma-title" class="dilemma__title">The isnad dilemma</h2>
    <p class="dilemma__lede">Reported numbers and recoverable sources answer different questions.</p>
  </figcaption>

  <div class="dilemma__picture">
    <div class="dilemma__side">
      <span class="dilemma__label">Claimed in the text</span>
      <span class="dilemma__field" aria-hidden="true"></span>
      <p class="dilemma__count"><b>500</b> people said to have seen it</p>
    </div>

    <svg class="dilemma__funnel" viewBox="0 0 120 160" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      {strands.map((dy) => <path d={`M 0 ${80 + dy} C 60 ${80 + dy}, 60 80, 120 80`} />)}
    </svg>

    <div class="dilemma__side">
      <span class="dilemma__label">Recoverable source</span>
      <span class="dilemma__one" aria-hidden="true"></span>
      <p class="dilemma__count"><b>1</b> named witness: Paul</p>
    </div>
  </div>

  <blockquote class="dilemma__quote">
    <p>“Christ appeared to more than five hundred brothers at once.”</p>
    <cite>1 Corinthians 15:6</cite>
  </blockquote>

  <p class="dilemma__note">
    A reported group size does not, by itself, establish how many independent accounts preserve the claim.
  </p>
</figure>

<style>
  .dilemma {
    margin: calc(var(--space-block, 2.25rem) * 1.1) 0;
    padding: clamp(1.2rem, 4vw, 1.8rem) clamp(1.1rem, 4vw, 1.9rem);
    border: 1px solid var(--r-frame, var(--hc-rule));
    border-radius: 4px;
    background: var(--r-surface, var(--hc-surface-1));
    color: var(--r-ink, var(--hc-text-primary));
  }

  .dilemma__kicker,
  .dilemma__label {
    color: var(--r-accent, var(--hc-gold));
    font: 600 0.75rem/1.4 var(--font-ui);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .dilemma__title {
    margin: 0.25rem 0 0.2rem;
    color: var(--r-ink, var(--hc-text-primary));
    font: 600 clamp(1.4rem, 1.15rem + 0.9vw, 1.7rem)/1.2 var(--font-editorial);
  }

  .dilemma__lede {
    margin: 0;
    color: var(--r-ink-2, var(--hc-text-secondary));
    font-size: 0.95em;
  }

  /* 500 on the left, the strands converging, 1 on the right. */
  .dilemma__picture {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(3rem, 6rem) minmax(0, 1fr);
    align-items: center;
    margin: 1.4rem 0 1.2rem;
  }

  .dilemma__side {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    text-align: center;
  }

  /* 25 columns by 20 rows at 8px: exactly 500 dots. */
  .dilemma__field {
    width: 200px;
    height: 160px;
    background: radial-gradient(circle, var(--r-ink-3, var(--hc-text-tertiary)) 1.6px, transparent 2.1px) 0 0 / 8px 8px;
  }

  .dilemma__one {
    display: grid;
    place-items: center;
    width: 160px;
    height: 160px;
  }

  .dilemma__one::before {
    content: "";
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--r-accent, var(--hc-gold));
    box-shadow: 0 0 0 7px color-mix(in srgb, var(--r-accent, var(--hc-gold)) 18%, transparent);
  }

  .dilemma__funnel {
    width: 100%;
    height: 160px;
    margin-top: 1.9rem;
  }

  .dilemma__funnel path {
    fill: none;
    stroke: var(--r-accent, var(--hc-gold));
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
  }

  .dilemma__count {
    margin: 0;
    color: var(--r-ink-2, var(--hc-text-secondary));
    font-size: 0.92em;
    line-height: 1.35;
  }

  .dilemma__count b {
    display: block;
    color: var(--r-ink, var(--hc-text-primary));
    font: 500 2.4rem/1 var(--font-editorial);
    /* Lining figures: Cormorant's old-style 1 reads as a capital I. */
    font-variant-numeric: lining-nums;
  }

  .dilemma__quote {
    margin: 0;
    padding: 0.85rem 0 0;
    border: 0;
    border-top: 1px solid var(--r-rule, var(--hc-rule-soft));
    text-align: center;
  }

  .dilemma__quote p {
    margin: 0;
    font: italic 500 1.15rem/1.45 var(--font-editorial);
  }

  .dilemma__quote cite {
    display: block;
    margin-top: 0.3rem;
    color: var(--r-ink-3, var(--hc-text-tertiary));
    font: 600 0.75rem/1.4 var(--font-ui);
    font-style: normal;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .dilemma__note {
    margin: 0.9rem 0 0;
    color: var(--r-ink-2, var(--hc-text-secondary));
    font-size: 0.92em;
    text-align: center;
  }

  /* Phones: the same picture run downward, 500 above, 1 below. */
  @media (max-width: 600px) {
    .dilemma__picture {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    /* Turned a quarter, the funnel's box stays 96 by 72 while it draws 72
       by 96, so the margins make room for the 12px it reaches past each end. */
    .dilemma__funnel {
      width: 96px;
      height: 72px;
      margin: 1.4rem 0 0.9rem;
      transform: rotate(90deg);
    }

    .dilemma__one {
      width: 72px;
      height: 56px;
    }
  }
</style>
