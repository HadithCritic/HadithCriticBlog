---
/** An authored Qur'anic quotation: preserve the supplied translation and Arabic. */
import SourceShare from './SourceShare.astro';

interface Props {
  verse: string;
}

const { verse } = Astro.props;
const reference = `Quran ${verse}`;
---

<figure class="hc-verse" data-source data-share-title="Quran citation">
  <div class="hc-verse__row">
    <a class="hc-verse__badge" href={`https://wikisubmission.org/quran/${verse}`} target="_blank" rel="noopener noreferrer" aria-label={`${reference} on WikiSubmission`}>{verse}</a>
    <div class="hc-verse__en" data-source-quoted><slot name="translation" /></div>
    {Astro.slots.has('arabic') && <div class="hc-verse__ar" lang="ar" dir="rtl" data-source-primary><slot name="arabic" /></div>}
  </div>
  <figcaption class="hc-verse__foot">
    <span class="hc-verse__cite">
      <cite data-source-ref>{reference}</cite>
      <button type="button" class="hc-source__share" data-source-share hidden><span>Share</span></button>
    </span>
  </figcaption>
</figure>

<SourceShare />

<style>
  .hc-verse__en {
    color: var(--r-ink);
    font: 400 1em/1.62 var(--font-body);
  }
  .hc-verse__ar {
    color: var(--r-ink);
    font: 400 clamp(1.4rem, 1.15rem + 1vw, 1.75rem)/2.05 var(--font-quran);
    direction: rtl;
    text-align: right;
  }
  .hc-verse__en :global(p), .hc-verse__ar :global(p) { margin: 0; }
  .hc-verse__ar :global(.ar-inline) { font-family: inherit; }
</style>
