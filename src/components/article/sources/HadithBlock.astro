---
/**
 * A report: Arabic, translation and citation.
 *
 *   <HadithBlock label="…" source="…" arabic={`…`} translation={`…`} />
 *
 * Arabic and translation may instead be written inside the tag as
 * `<div class="hadith-block__arabic">` / `<div class="hadith-block__translation">`.
 * `title` and `label` are the same thing, a short heading; thirteen articles
 * pass `title`, which the previous version silently dropped.
 */
import Source from './Source.astro';

export interface Props {
  label?: string;
  title?: string;
  arabic?: string;
  translation?: string;
  /** Older name for `translation`. */
  english?: string;
  source?: string;
}

const { label, title, arabic, translation, english, source } = Astro.props;
---

<Source kind="hadith" title={title ?? label} arabic={arabic} translation={translation ?? english} reference={source} shareTitle="Report">
  <slot />
</Source>
