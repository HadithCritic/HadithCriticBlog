---
/** A Biblical passage: <BibleVerse reference="Exodus 24:12">"…"</BibleVerse>. */
import Source from './Source.astro';

export interface Props {
  reference: string;
  /** Older name for an optional heading. */
  eyebrow?: string;
}

const { reference, eyebrow } = Astro.props;
---

<Source kind="bible" title={eyebrow} reference={reference} shareTitle="Bible citation">
  <slot />
</Source>
