---
import { getEntry } from 'astro:content';

export interface Props {
  /** Collection id, including the category directory. */
  id: string;
}

const { id } = Astro.props;
const article = await getEntry('articles', id);
if (!article) throw new Error(`ArticleLink: unknown article ${id}`);
---

<a href={`/blogs/${article.id}/`}><slot>{article.data.title}</slot></a>
