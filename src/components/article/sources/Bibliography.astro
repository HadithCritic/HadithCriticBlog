---
/**
 * A works-cited list, set with hanging indents like the Markdown
 * bibliographies the other articles write by hand.
 */
export interface BibliographyEntry {
  author: string;
  title: string;
  details: string;
  year?: string;
}

export interface Props {
  entries: BibliographyEntry[];
  title?: string;
}

const { entries, title = 'Bibliography' } = Astro.props;
---

<section class="hc-works" aria-labelledby="bibliography">
  <h2 id="bibliography">{title}</h2>
  <ul class="hc-works__list">
    {entries.map((entry) => (
      <li>
        <span class="hc-works__author">{entry.author}</span>,{' '}
        <cite>{entry.title}</cite>,{' '}
        {entry.details}{entry.year && <> ({entry.year})</>}.
      </li>
    ))}
  </ul>
</section>
