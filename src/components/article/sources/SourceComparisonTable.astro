---
/**
 * A comparison of sources, variants or witnesses. The `header` slot takes the
 * <th> cells and the default slot the <tr> rows. Styled exactly like a
 * Markdown table (src/styles/article.css, "Tables"), so the publication has
 * one table. The scroll wrapper is a focusable region on narrow screens.
 */
export interface Props {
  /** Keep the first column visible while the rest scrolls. */
  stickyFirstCol?: boolean;
  caption?: string;
}

const { stickyFirstCol = false, caption } = Astro.props;
---

<figure class:list={['hc-table', { 'hc-table--sticky': stickyFirstCol }]}>
  {caption && <figcaption class="hc-table__caption">{caption}</figcaption>}
  <div class="hc-table__scroll" tabindex="0" role="region" aria-label={caption ?? 'Source comparison table'}>
    <table>
      <thead><tr><slot name="header" /></tr></thead>
      <tbody><slot /></tbody>
    </table>
  </div>
</figure>
