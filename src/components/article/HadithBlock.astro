---
export interface Props {
  arabic?: string;
  translation?: string;
  english?: string;
  source?: string;
  label?: string;
  type?: 'canonical' | 'variant' | 'mawquf' | 'mursal' | 'quote' | 'default';
}

const {
  arabic,
  translation,
  english,
  source,
  label = 'Report Text',
  type = 'default'
} = Astro.props;

const finalTranslation = translation || english;
const hasSlot = Astro.slots.has('default');
---

<div class={`hadith-block hadith-block--${type}`} data-hadith-block>
  <div class="hadith-block__header">
    <div class={`hadith-block__badge hadith-block__badge--${type}`}>
      <span class="hadith-block__badge-dot" aria-hidden="true"></span>
      <span>{label}</span>
    </div>

    <button
      type="button"
      class="hadith-block__share"
      data-hadith-share
      title="Share report"
      aria-label="Share report"
    >
      <span class="hadith-block__share-text">Share</span>
    </button>
  </div>

  <div class="hadith-block__content">
    {arabic ? (
      <div class="hadith-block__arabic" dir="rtl" lang="ar" data-arabic-text>{arabic}</div>
    ) : hasSlot ? (
      <div class="hadith-block__slot-wrap"><slot /></div>
    ) : null}

    {finalTranslation && (
      <div class="hadith-block__english" data-english-text>{finalTranslation}</div>
    )}
  </div>

  {source && (
    <div class="hadith-block__source" data-source-text={source}>
      <span class="hadith-block__source-label">Source</span>
      <span class="hadith-block__source-val">{source}</span>
    </div>
  )}
</div>

<script>
  import { shareText, flashCopied, buildCitation } from '../../lib/clipboard';
  function initHadithShare() {
    for (const block of document.querySelectorAll<HTMLElement>('[data-hadith-block]')) {
      if (block.dataset.shareInitialized) continue;
      block.dataset.shareInitialized = 'true';

      const shareBtn = block.querySelector<HTMLButtonElement>('[data-hadith-share]');
      if (!shareBtn) continue;

      shareBtn.addEventListener('click', async () => {
        const arabicEl = block.querySelector('[data-arabic-text]');
        const englishEl = block.querySelector('[data-english-text]');
        const sourceVal = block.querySelector('[data-source-text]')?.getAttribute('data-source-text');

        const citation = buildCitation({
          primary: arabicEl?.textContent,
          quoted: englishEl?.textContent,
          reference: sourceVal
        });
        if (!citation) return;
        if (!(await shareText(citation, 'Hadith report'))) return;
        flashCopied(shareBtn, { labelSelector: '.hadith-block__share-text', copiedLabel: 'Ready to share', idleLabel: 'Share', className: 'is-shared' });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHadithShare);
  } else {
    initHadithShare();
  }
  document.addEventListener('astro:page-load', initHadithShare);
</script>

<style>
  .hadith-block {
    position: relative;
    margin: 2.75rem 0;
    padding: 0;
    border: 1px solid var(--hc-rule);
    border-top: 1px solid var(--hc-rule-strong);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--hc-surface-2) 65%, transparent);
    box-shadow: none;
    overflow: hidden;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .hadith-block:hover {
    border-color: var(--hc-rule-strong);
    box-shadow: none;
  }

  .hadith-block--variant {
    border-top-color: var(--hc-copper, #c48b68);
  }

  .hadith-block--mawquf {
    border-top-color: var(--hc-gold-soft);
  }

  .hadith-block--mursal {
    border-top-color: var(--hc-umber);
  }

  .hadith-block__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--hc-rule);
    background: transparent;
  }

  .hadith-block__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1.1rem;
    background: transparent;
    border-right: 1px solid var(--hc-rule-soft);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hadith-block__badge-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hc-gold);
    box-shadow: 0 0 6px var(--hc-gold);
  }

  .hadith-block__badge--variant {
    color: var(--hc-copper, #c48b68);
    background: rgba(196, 139, 104, 0.1);
  }
  .hadith-block__badge--variant .hadith-block__badge-dot {
    background: var(--hc-copper, #c48b68);
    box-shadow: 0 0 6px var(--hc-copper, #c48b68);
  }

  .hadith-block__badge--mursal {
    color: var(--hc-umber);
    background: rgba(160, 90, 70, 0.1);
  }
  .hadith-block__badge--mursal .hadith-block__badge-dot {
    background: var(--hc-umber);
    box-shadow: 0 0 6px var(--hc-umber);
  }

  /* Share Button */
  .hadith-block__share {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-right: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--hc-rule);
    background: rgba(15, 15, 16, 0.6);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .hadith-block__share:hover {
    color: var(--hc-gold);
    border-color: var(--hc-gold-dim);
    background: rgba(216, 177, 102, 0.1);
    transform: translateY(-1px);
  }

  .hadith-block__share.is-shared {
    border-color: var(--hc-gold-dim);
    color: var(--hc-text-primary);
    background: color-mix(in srgb, var(--hc-gold) 10%, transparent);
  }

  .hadith-block__content {
    padding: clamp(1.3rem, 3vw, 2.2rem) clamp(1.4rem, 3vw, 2.2rem);
  }

  /* Arabic typography */
  .hadith-block__arabic {
    font-family: var(--font-arabic);
    font-size: clamp(1.45rem, 1.2vw + 1.2rem, 1.53rem);
    line-height: 2.35;
    color: var(--hc-text-primary);
    text-align: right;
    direction: rtl;
    margin-bottom: 1.35rem;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--hc-rule-soft);
    font-feature-settings: "cv01" on, "calt" on;
    text-rendering: optimizeLegibility;
  }

  .hadith-block__arabic:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  /* Slot content support */
  .hadith-block__slot-wrap {
    color: var(--hc-text-primary);
  }

  .hadith-block__slot-wrap :global(.hadith-block__arabic) {
    font-family: var(--font-arabic);
    font-size: clamp(1.45rem, 1.2vw + 1.2rem, 1.53rem);
    line-height: 2.35;
    color: var(--hc-text-primary);
    text-align: right;
    direction: rtl;
    margin-bottom: 1.35rem;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .hadith-block__slot-wrap :global(.hadith-block__translation) {
    font-family: var(--font-body);
    font-size: 1em;
    line-height: 1.72;
    color: var(--hc-text-secondary);
    padding-left: 0;
    border-left: 0;
    font-style: italic;
  }

  /* English translation */
  .hadith-block__english {
    font-family: var(--font-body);
    font-size: 1em;
    line-height: 1.72;
    color: var(--hc-text-secondary);
    padding-left: 0;
    border-left: 0;
    font-style: italic;
  }

  /* Source footer */
  .hadith-block__source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem clamp(1.4rem, 3vw, 2.2rem);
    border-top: 1px solid rgba(216, 177, 102, 0.12);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    color: var(--hc-text-secondary);
    background: rgba(216, 177, 102, 0.035);
  }

  .hadith-block__source-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-text-secondary);
  }

  .hadith-block__source-val {
    color: var(--hc-text-secondary);
    line-height: 1.5;
  }

  /* Light Theme Overrides */
  :global([data-theme="light"]) .hadith-block {
    background: color-mix(in srgb, var(--hc-surface-2) 65%, transparent);
    border-color: var(--hc-rule);
    border-top-color: var(--hc-rule-strong);
    box-shadow: none;
  }

  :global([data-theme="light"]) .hadith-block__header {
    background: transparent;
  }

  :global([data-theme="light"]) .hadith-block__badge {
    background: transparent;
    color: var(--hc-text-secondary);
  }

  :global([data-theme="light"]) .hadith-block__share {
    background: rgba(251, 249, 244, 0.9);
    border-color: var(--hc-rule);
    color: var(--hc-text-primary);
  }

  :global([data-theme="light"]) .hadith-block__source {
    background: rgba(176, 126, 44, 0.04);
  }

  @media (max-width: 640px) {
    .hadith-block {
      margin: 2rem 0;
    }

    .hadith-block__badge {
      padding: 0.4rem 0.85rem;
      font-size: 0.78rem;
    }

    .hadith-block__content {
      padding: 1.1rem;
    }

    .hadith-block__arabic,
    .hadith-block__slot-wrap :global(.hadith-block__arabic) {
      font-size: clamp(1.28rem, 6.5vw, 1.32rem);
      line-height: 2.1;
    }

    .hadith-block__english,
    .hadith-block__slot-wrap :global(.hadith-block__translation) {
      padding-left: 0;
      font-size: 1em;
      line-height: 1.72;
    }

    .hadith-block__source {
      padding: 0.8rem 1.1rem;
      gap: 0.35rem 0.65rem;
    }
  }
</style>
