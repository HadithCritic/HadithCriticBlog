---
---
<div class="hc-related-posts">
  <h3 class="hc-title" style="margin-bottom: 1.5rem; color: var(--hc-gold);">Related Reports</h3>
  <div class="related-grid">
    <slot />
  </div>
</div>
<style>
  .hc-related-posts {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hc-rule);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .hc-related-posts {
      margin-top: 3rem;
      padding-top: 1.5rem;
    }

    .related-grid {
      gap: 1rem;
    }
  }
</style>
