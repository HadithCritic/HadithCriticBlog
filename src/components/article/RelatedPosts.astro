---
import type { CollectionEntry } from 'astro:content';
import { isNewPost } from '../../lib/new-badge';

interface Props {
  currentCategory: string;
  posts: CollectionEntry<'articles'>[];
}

const { currentCategory, posts } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
---

<section class="hc-read-more" aria-labelledby="read-more-title">
  <div class="read-more-header">
    <div class="read-more-title-wrap">
      <span class="read-more-eyebrow">Continue Exploring</span>
      <h2 id="read-more-title" class="read-more-title">Related Investigations</h2>
    </div>
    <a href={`/blogs?category=${encodeURIComponent(currentCategory)}`} class="read-more-all-link">
      <span>More in {currentCategory}</span>
      <span class="read-more-arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <div class="read-more-grid">
    {posts.map((item) => (
      <a href={`/blogs/${item.id}`} class="read-more-card" data-category={item.data.category}>
        <div class="read-more-media">
          {item.data.thumbnail ? (
            <img
              src={item.data.thumbnail}
              alt={`Cover illustration for ${item.data.title}`}
              class="read-more-thumb"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="read-more-thumb-placeholder" />
          )}
          <span class="read-more-cat-badge" data-category={item.data.category}>
            <span class="read-more-dot" aria-hidden="true"></span>
            <span>{item.data.category}</span>
          </span>
        </div>
        <div class="read-more-body">
          <div class="read-more-meta">
            <time datetime={item.data.date.toISOString().slice(0, 10)}>
              {formatDate(item.data.date)}
            </time>
            {isNewPost(item.data.date) && <span class="new-badge">New</span>}
          </div>
          <h3 class="read-more-heading">{item.data.title}</h3>
          {item.data.description && (
            <p class="read-more-desc">{item.data.description}</p>
          )}
          <div class="read-more-cta">
            <span>Read Investigation</span>
            <span class="cta-arrow" aria-hidden="true">→</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .hc-read-more {
    margin-top: clamp(4rem, 6vw, 5.5rem);
    padding-top: clamp(2.5rem, 4vw, 3.5rem);
    border-top: 1px solid var(--hc-rule);
    max-width: 1140px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 2rem);
  }

  .read-more-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .read-more-eyebrow {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-gold);
    margin-bottom: 0.35rem;
  }

  .read-more-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    color: var(--hc-text-primary);
    letter-spacing: -0.02em;
  }

  .read-more-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--hc-gold-soft);
    text-decoration: none;
    transition: gap 200ms ease, color 200ms ease;
  }

  .read-more-all-link:hover {
    color: var(--hc-gold);
    gap: 0.65rem;
  }

  .read-more-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2vw, 1.75rem);
  }

  .read-more-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-sm);
    text-decoration: none;
    border: 1px solid var(--hc-rule);
    background: var(--hc-surface-1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    transition:
      border-color 250ms ease,
      box-shadow 250ms ease,
      transform 250ms var(--ease);
  }

  .read-more-card:hover {
    border-color: var(--card-color, var(--hc-gold));
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22), 0 0 16px var(--card-bg, rgba(216, 177, 102, 0.12));
    transform: translateY(-3px);
  }

  .read-more-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--hc-surface-2);
    overflow: hidden;
  }

  .read-more-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    display: block;
    filter: saturate(0.95) contrast(1.02);
    transition: transform 450ms var(--ease);
  }

  .read-more-card:hover .read-more-thumb {
    transform: scale(1.04);
  }

  .read-more-cat-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.22rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgba(20, 19, 18, 0.85);
    border: 1px solid var(--card-border, var(--hc-rule));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--card-color, var(--hc-gold));
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .read-more-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Category colors */
  .read-more-card[data-category="Origins & Early History"] {
    --card-color: #d48b52;
    --card-bg: rgba(212, 139, 82, 0.12);
    --card-border: rgba(212, 139, 82, 0.35);
  }
  .read-more-card[data-category="Prophecies & Eschatology"] {
    --card-color: #e05a47;
    --card-bg: rgba(224, 90, 71, 0.12);
    --card-border: rgba(224, 90, 71, 0.35);
  }
  .read-more-card[data-category="Theology & Epistemology"] {
    --card-color: #4fa86c;
    --card-bg: rgba(79, 168, 108, 0.12);
    --card-border: rgba(79, 168, 108, 0.35);
  }
  .read-more-card[data-category="Transmission & Narrators"] {
    --card-color: #608fd6;
    --card-bg: rgba(96, 143, 214, 0.12);
    --card-border: rgba(96, 143, 214, 0.35);
  }

  .read-more-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .read-more-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.74rem;
    color: var(--hc-text-tertiary);
    margin-bottom: 0.65rem;
  }

  .new-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.14rem 0.5rem;
    border-radius: var(--radius-pill);
    background: rgba(224, 90, 71, 0.14);
    border: 1px solid rgba(224, 90, 71, 0.4);
    color: #e05a47;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.66rem;
  }

  .read-more-heading {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.4vw, 1.45rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--hc-text-primary);
    transition: color 200ms ease;
  }

  .read-more-card:hover .read-more-heading {
    color: var(--card-color, var(--hc-gold-soft));
  }

  .read-more-desc {
    margin: 0 0 1.25rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--hc-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .read-more-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--card-color, var(--hc-gold));
    transition: gap 200ms ease;
  }

  .read-more-card:hover .read-more-cta {
    gap: 0.65rem;
  }

  .cta-arrow {
    transition: transform 200ms ease;
  }

  .read-more-card:hover .cta-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 960px) {
    .read-more-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .read-more-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .read-more-card {
      max-width: 100%;
    }
  }
</style>
