---
// Shorthand for inline or block Arabic script: <Arabic>عِكْرِمَة</Arabic>
export interface Props {
  inline?: boolean;
}

const { inline = true } = Astro.props;
---

<span lang="ar" dir="rtl" class={inline ? 'ar-inline' : 'ar-block'}>
  <slot />
</span>

<style>
  .ar-inline,
  .ar-block {
    font-family: var(--font-arabic);
  }

  .ar-block {
    display: block;
    line-height: 2.1;
    text-align: right;
  }
</style>
