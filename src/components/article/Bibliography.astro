---
export interface BibliographyEntry {
  author: string;
  title: string;
  details: string;
  year?: string;
}

export interface Props {
  entries: BibliographyEntry[];
}

const { entries } = Astro.props;
---

<section class="hc-bibliography">
  <h2 class="hc-bibliography__title">Bibliography</h2>
  <ul class="hc-bibliography__list">
    {entries.map((entry) => (
      <li class="hc-bibliography__item">
        <span class="hc-bibliography__author">{entry.author}</span>,{' '}
        <em class="hc-bibliography__work">{entry.title}</em>,{' '}
        <span class="hc-bibliography__details">{entry.details}</span>
        {entry.year && <span class="hc-bibliography__year"> ({entry.year})</span>}.
      </li>
    ))}
  </ul>
</section>

<style>
  .hc-bibliography {
    margin-top: 4rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--hc-rule);
  }

  .hc-bibliography__title {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2vw, 1.85rem);
    font-weight: 500;
    color: var(--hc-text-primary);
  }

  .hc-bibliography__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hc-bibliography__item {
    position: relative;
    padding-left: 1.4rem;
    margin-bottom: 0.95rem;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--hc-text-secondary);
  }

  .hc-bibliography__item::before {
    content: "✦";
    position: absolute;
    left: 0;
    top: 0.12rem;
    color: var(--hc-gold-dim);
    font-size: 0.65rem;
  }

  .hc-bibliography__author {
    color: var(--hc-text-primary);
    font-weight: 600;
  }

  .hc-bibliography__work {
    color: var(--hc-text-primary);
    font-style: italic;
  }

  .hc-bibliography__details {
    color: var(--hc-text-secondary);
  }

  .hc-bibliography__year {
    color: var(--hc-text-tertiary);
  }

  :global([data-theme="light"]) .hc-bibliography__author {
    color: var(--hc-text-primary);
  }

  :global([data-theme="light"]) .hc-bibliography__item::before {
    color: var(--hc-gold);
  }
</style>
