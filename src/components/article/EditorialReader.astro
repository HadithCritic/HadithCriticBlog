---
interface Props {
  title?: string;
  prevUrl?: string;
  prevTitle?: string;
  nextUrl?: string;
  nextTitle?: string;
  backHref?: string;
}

const {
  title,
  prevUrl,
  prevTitle,
  nextUrl,
  nextTitle,
  backHref = '/blogs'
} = Astro.props;
---

<div class="editorial-desk-container">
  <!-- Desk Top Toolbar -->
  <div class="desk-toolbar">
    <div class="desk-toolbar__left">
      <div class="desk-nav-arrows">
        {prevUrl ? (
          <a href={prevUrl} class="desk-arrow-btn" title={`Previous: ${prevTitle || 'Article'}`} aria-label="Previous study">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </a>
        ) : (
          <span class="desk-arrow-btn is-disabled" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </span>
        )}

        {nextUrl ? (
          <a href={nextUrl} class="desk-arrow-btn" title={`Next: ${nextTitle || 'Article'}`} aria-label="Next study">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        ) : (
          <span class="desk-arrow-btn is-disabled" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        )}
      </div>

      <div class="desk-breadcrumbs">
        <a href={backHref} class="desk-breadcrumb-link">Studies</a>
        {title && (
          <>
            <span class="desk-breadcrumb-sep" aria-hidden="true">/</span>
            <span class="desk-breadcrumb-current">{title}</span>
          </>
        )}
      </div>
    </div>

    <!-- Reading Options Trigger & Popover -->
    <div class="desk-toolbar__right">
      <button
        type="button"
        id="readingOptionsToggle"
        class="reading-options-btn"
        aria-expanded="false"
        aria-controls="readingOptionsPanel"
        aria-label="Customize typography and reading view"
        title="Reading settings"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="21" x2="4" y2="14"></line>
          <line x1="4" y1="10" x2="4" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12" y2="3"></line>
          <line x1="20" y1="21" x2="20" y2="16"></line>
          <line x1="20" y1="12" x2="20" y2="3"></line>
          <line x1="1" y1="14" x2="7" y2="14"></line>
          <line x1="9" y1="8" x2="15" y2="8"></line>
          <line x1="17" y1="16" x2="23" y2="16"></line>
        </svg>
      </button>

      <div id="readingOptionsPanel" class="reading-options-panel" role="group" aria-label="Reading settings" hidden>
        <div class="options-header">
          <span class="options-header__title">Reading Options</span>
          <button type="button" id="closeReadingOptions" class="options-close-btn" aria-label="Close reading options">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="option-group">
          <span class="option-label">Type Size</span>
          <div class="option-buttons" role="radiogroup" aria-label="Type Size">
            <button type="button" class="option-btn" data-set-size="s" aria-label="Small text">Small</button>
            <button type="button" class="option-btn is-active" data-set-size="m" aria-label="Medium text">Medium</button>
            <button type="button" class="option-btn" data-set-size="l" aria-label="Large text">Large</button>
          </div>
        </div>

        <div class="option-group">
          <span class="option-label">Sheet Measure</span>
          <div class="option-buttons" role="radiogroup" aria-label="Sheet Measure">
            <button type="button" class="option-btn is-active" data-set-measure="standard" aria-label="Standard measure">Standard</button>
            <button type="button" class="option-btn" data-set-measure="wide" aria-label="Wide measure">Wide</button>
          </div>
        </div>

        <div class="option-group">
          <span class="option-label">Alignment</span>
          <div class="option-buttons" role="radiogroup" aria-label="Alignment">
            <button type="button" class="option-btn is-active" data-set-align="justify" aria-label="Justified text">Justified</button>
            <button type="button" class="option-btn" data-set-align="left" aria-label="Left-aligned text">Left</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Physical Reading Sheet Article -->
  <article id="main-article" class="physical-sheet" data-reading-progress-source>
    <slot name="header" />
    <div class="sheet-content">
      <slot />
    </div>
  </article>
</div>

<script>
  function initReadingSettings() {
    const STORAGE_KEY = 'hc_reading_settings';
    const toggleBtn = document.getElementById('readingOptionsToggle');
    const closeBtn = document.getElementById('closeReadingOptions');
    const panel = document.getElementById('readingOptionsPanel');
    const sheet = document.getElementById('main-article');

    if (!toggleBtn || !panel || !sheet) return;

    const btnEl = toggleBtn;
    const panelEl = panel;
    const sheetEl = sheet;

    let settings = {
      size: 'm',
      measure: 'standard',
      align: 'justify'
    };

    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        settings = { ...settings, ...JSON.parse(saved) };
      }
    } catch {
      // Ignore storage error
    }

    function applySettings() {
      sheetEl.setAttribute('data-reading-size', settings.size);
      sheetEl.setAttribute('data-reading-measure', settings.measure);
      sheetEl.setAttribute('data-reading-align', settings.align);

      document.querySelectorAll('[data-set-size]').forEach((b) => {
        const active = b.getAttribute('data-set-size') === settings.size;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });

      document.querySelectorAll('[data-set-measure]').forEach((b) => {
        const active = b.getAttribute('data-set-measure') === settings.measure;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });

      document.querySelectorAll('[data-set-align]').forEach((b) => {
        const active = b.getAttribute('data-set-align') === settings.align;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
    }

    function saveSettings() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
      } catch {
        // Ignore storage error
      }
    }

    applySettings();

    function openPanel() {
      panelEl.hidden = false;
      btnEl.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => panelEl.classList.add('is-open'));
    }

    function closePanel() {
      panelEl.classList.remove('is-open');
      btnEl.setAttribute('aria-expanded', 'false');
      setTimeout(() => {
        panelEl.hidden = true;
      }, 160);
    }

    btnEl.addEventListener('click', (e) => {
      e.stopPropagation();
      if (panelEl.hidden) {
        openPanel();
      } else {
        closePanel();
      }
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closePanel();
    });

    document.addEventListener('click', (e) => {
      if (!panelEl.hidden && !panelEl.contains(e.target as Node) && e.target !== btnEl) {
        closePanel();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panelEl.hidden) {
        closePanel();
        btnEl.focus();
      }
    });

    document.querySelectorAll('[data-set-size]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-set-size');
        if (val) {
          settings.size = val;
          applySettings();
          saveSettings();
        }
      });
    });

    document.querySelectorAll('[data-set-measure]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-set-measure');
        if (val) {
          settings.measure = val;
          applySettings();
          saveSettings();
        }
      });
    });

    document.querySelectorAll('[data-set-align]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-set-align');
        if (val) {
          settings.align = val;
          applySettings();
          saveSettings();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReadingSettings);
  } else {
    initReadingSettings();
  }
  document.addEventListener('astro:page-load', initReadingSettings);
</script>

<style>
  .editorial-desk-container {
    width: 100%;
    min-width: 0;
  }

  /* ── Desk Top Toolbar ── */
  .desk-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem 0.25rem;
  }

  .desk-toolbar__left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .desk-nav-arrows {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .desk-arrow-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    color: var(--hc-text-tertiary);
    text-decoration: none;
    transition: color 160ms ease, background 160ms ease;
  }

  .desk-arrow-btn:hover:not(.is-disabled) {
    color: var(--hc-gold);
    background: color-mix(in srgb, var(--hc-gold) 10%, transparent);
  }

  .desk-arrow-btn.is-disabled {
    opacity: 0.25;
    pointer-events: none;
  }

  .desk-breadcrumbs {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
    min-width: 0;
    overflow: hidden;
  }

  .desk-breadcrumb-link {
    color: var(--hc-text-tertiary);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .desk-breadcrumb-link:hover {
    color: var(--hc-gold);
  }

  .desk-breadcrumb-sep {
    color: var(--hc-rule-strong);
  }

  .desk-breadcrumb-current {
    color: var(--hc-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 32ch;
  }

  .desk-toolbar__right {
    position: relative;
    flex-shrink: 0;
  }

  .reading-options-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    border: 1px solid var(--hc-rule);
    background: var(--hc-surface-1);
    color: var(--hc-text-tertiary);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .reading-options-btn:hover,
  .reading-options-btn[aria-expanded="true"] {
    color: var(--hc-gold);
    border-color: var(--hc-gold-dim);
    background: var(--hc-surface-2);
  }

  /* ── Reading Options Popover ── */
  .reading-options-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 100;
    width: 260px;
    padding: 1.15rem;
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-rule-strong);
    border-radius: 6px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(216, 177, 102, 0.1);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .reading-options-panel.is-open {
    opacity: 1;
    transform: translateY(0);
  }

  .options-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .options-header__title {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .options-close-btn {
    display: grid;
    place-items: center;
    padding: 2px;
    border: 0;
    background: transparent;
    color: var(--hc-text-tertiary);
    cursor: pointer;
    transition: color 160ms ease;
  }

  .options-close-btn:hover {
    color: var(--hc-text-primary);
  }

  .option-group {
    margin-bottom: 0.9rem;
  }

  .option-group:last-child {
    margin-bottom: 0;
  }

  .option-label {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-text-tertiary);
  }

  .option-buttons {
    display: flex;
    gap: 0.35rem;
  }

  .option-btn {
    flex: 1;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--hc-rule);
    border-radius: 3px;
    background: var(--hc-surface-0);
    color: var(--hc-text-secondary);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 160ms ease;
  }

  .option-btn:hover {
    color: var(--hc-text-primary);
    border-color: var(--hc-rule-strong);
  }

  .option-btn.is-active {
    border-color: var(--hc-gold);
    background: color-mix(in srgb, var(--hc-gold) 15%, var(--hc-surface-0));
    color: var(--hc-gold);
    font-weight: 700;
  }

  /* ── Physical Paper Sheet ── */
  .physical-sheet {
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-rule);
    border-radius: 4px;
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.75rem, 4.5vw, 4rem);
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.4),
      0 16px 40px rgba(0, 0, 0, 0.55),
      0 32px 75px rgba(0, 0, 0, 0.65),
      0 0 0 1px rgba(216, 177, 102, 0.06);
    transition: max-width 200ms ease;
    margin-bottom: 4rem;
  }

  :global([data-theme="light"]) .physical-sheet {
    background: #ffffff;
    border-color: rgba(43, 40, 36, 0.14);
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.06),
      0 16px 36px rgba(0, 0, 0, 0.09),
      0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .sheet-content {
    min-width: 0;
  }

  @media (max-width: 640px) {
    .physical-sheet {
      padding: 2rem 1.25rem;
      border-radius: 0;
      border-inline: 0;
    }
  }
</style>
