---
export interface Props {
  headings: { depth: number; text: string; slug: string }[];
}
const { headings } = Astro.props;
---
<nav class="article-toc" aria-label="Table of contents">
  <div class="toc-header">
    <span class="toc-header__label">Contents</span>
    <span class="toc-header__count">{headings.length} sections</span>
  </div>
  <ol class="toc-list">
    {headings.map((h) => (
      <li class={`toc-item ${h.depth === 3 ? 'toc-item--sub' : ''}`}>
        <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>
          <span class="toc-link__text">{h.text}</span>
          <span class="toc-link__line" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  function initTOC() {
    const links = [...document.querySelectorAll<HTMLElement>('.toc-link')];
    if (!links.length) return;

    const headings = links.map((el) => el.dataset.slug).filter(Boolean);
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          links.forEach(link => link.classList.remove('is-active'));
          const active = document.querySelector(`.toc-link[data-slug="${entry.target.id}"]`);
          if (active) active.classList.add('is-active');
        }
      });
    }, { rootMargin: '-20% 0px -60% 0px' });

    headings.forEach(slug => {
      if (!slug) return;
      const el = document.getElementById(slug);
      if (el) observer.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTOC);
  } else {
    initTOC();
  }
  document.addEventListener('astro:page-load', initTOC);
</script>

<style>
  .article-toc {
    position: sticky;
    top: 6rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    padding: 1.5rem;
    border-left: 1px solid var(--hc-rule);
  }

  .toc-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--hc-rule-soft);
  }

  .toc-header__label {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hc-gold-dim);
  }

  .toc-header__count {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    color: var(--hc-text-secondary);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.35rem 0;
    color: var(--hc-text-secondary);
    font-size: 0.82rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 200ms ease;
    position: relative;
  }

  .toc-link:hover {
    color: var(--hc-text-primary);
  }

  .toc-link.is-active {
    color: var(--hc-gold);
    font-weight: 500;
  }

  .toc-link__line {
    position: absolute;
    left: -1.5rem;
    top: 50%;
    width: 2px;
    height: 0;
    background: var(--hc-gold);
    transform: translateY(-50%);
    transition: height 250ms var(--ease);
  }

  .toc-link.is-active .toc-link__line {
    height: 100%;
  }

  .toc-item--sub .toc-link {
    padding-left: 1rem;
    font-size: 0.78rem;
    opacity: 0.8;
  }
</style>
