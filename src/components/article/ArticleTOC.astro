---
export interface Props {
  headings: { depth: number; text: string; slug: string }[];
}
const { headings } = Astro.props;
---
<div class="article-toc">
  <span class="hc-eyebrow" style="margin-bottom: 1rem; display: block;">Contents</span>
  <nav class="toc-nav">
    {headings.map(h => (
      <a href={`#${h.slug}`} class={`toc-link depth-${h.depth}`}>
        {h.text}
      </a>
    ))}
  </nav>
</div>
<style>
  .article-toc {
    border-left: 1px solid var(--hc-rule);
    padding-left: 1.5rem;
  }
  .toc-link {
    display: block;
    color: var(--hc-parchment);
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    opacity: 0.7;
    transition: opacity 200ms, color 200ms;
  }
  .toc-link:hover {
    opacity: 1;
    color: var(--hc-gold);
  }
  .depth-3 {
    padding-left: 1rem;
    font-size: 0.8rem;
  }
</style>
