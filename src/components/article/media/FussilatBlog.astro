---
/** A reusable reference to an essay on Fussilat Blog. */
export interface Props {
  url: string;
  title: string;
  author?: string;
  date?: string;
  description?: string;
}

const { url, title, author, date, description } = Astro.props;
const domain = new URL(url).hostname;
const byline = [author, date].filter(Boolean).join(' · ');
---

<a class="hc-blog-ref" href={url} target="_blank" rel="noopener noreferrer">
  <span class="hc-blog-ref__head">
    <span class="hc-blog-ref__brand">Fussilat Blog</span>
    <span class="hc-blog-ref__label">Cited essay</span>
  </span>
  <span class="hc-blog-ref__body">
    <span class="hc-blog-ref__meta">{byline}</span>
    <span class="hc-blog-ref__title">{title}</span>
    {description && <span class="hc-blog-ref__description">{description}</span>}
  </span>
  <span class="hc-blog-ref__foot">
    <span>{domain}</span>
    <span class="hc-blog-ref__action">Read on Fussilat<span class="hc-blog-ref__arrow" aria-hidden="true"></span><span class="sr-only"> (opens in a new tab)</span></span>
  </span>
</a>
