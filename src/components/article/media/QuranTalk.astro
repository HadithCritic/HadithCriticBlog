---
/**
 * An essay on QuranTalk the article points to, set in that blog's own
 * register: a white page, its mark and menu, the date and title, an optional
 * verse in its bracketed style, and the domain. The whole card is one link.
 * Fixed colors in both themes, like the other plates (article-plates.css).
 */
export interface Props {
  url: string;
  title: string;
  author?: string;
  date?: string;
  description?: string;
  /** A verse the essay turns on, printed in QuranTalk's bracketed style. */
  verse?: string;
  /** Its reference, e.g. "21:48". */
  verseRef?: string;
}

const { url, title, author = 'Quran Talk Blog', date, description, verse, verseRef } = Astro.props;
const domain = (() => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return 'qurantalkblog.com';
  }
})();
const byline = [date, author].filter(Boolean).join(' · ');
---

<a class="hc-qt" href={url} target="_blank" rel="noopener noreferrer">
  <span class="hc-qt__head">
    <img class="hc-qt__mark" src="/images/resources/logos/qurantalk-blog.webp" alt="" width="48" height="48" loading="lazy" decoding="async" />
    <span>
      <span class="hc-qt__name">Quran Talk Blog</span>
      <span class="hc-qt__menu">YouTube · Podcast · Quran Study App · WikiSubmission</span>
    </span>
  </span>
  <span class="hc-qt__body">
    {byline && <span class="hc-qt__date">{byline}</span>}
    <span class="hc-qt__title">{title}</span>
    {description && <span class="hc-qt__desc">{description}</span>}
    {verse && (
      <span class="hc-qt__verse">
        {verseRef && <b>[{verseRef}]</b>} {verse}
      </span>
    )}
    <slot />
  </span>
  <span class="hc-qt__foot">
    <span>{domain}</span>
    <span class="hc-qt__cta">Read on QuranTalk</span>
  </span>
</a>
