---
/** An essay on QuranTalk the article points to. */
import ExternalSource from './ExternalSource.astro';

export interface Props {
  url: string;
  title: string;
  author?: string;
  date?: string;
  description?: string;
}

const { url, title, author = 'QuranTalk', date, description } = Astro.props;
---

<ExternalSource url={url} publisher={author} title={title} date={date} description={description} kind="Further reading">
  <slot />
</ExternalSource>
