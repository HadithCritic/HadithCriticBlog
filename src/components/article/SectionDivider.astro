---
export interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="hc-section-divider" role="separator">
  <div class="hc-section-divider__ornament">
    <span class="hc-section-divider__line"></span>
    <span class="hc-section-divider__symbol" aria-hidden="true">✦ ❖ ✦</span>
    <span class="hc-section-divider__line"></span>
  </div>
  {title && <h2 class="hc-section-divider__title">{title}</h2>}
  {subtitle && <p class="hc-section-divider__subtitle">{subtitle}</p>}
</div>

<style>
  .hc-section-divider {
    margin: 3.5rem 0 2.5rem;
    text-align: left;
  }

  .hc-section-divider__ornament {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .hc-section-divider__line {
    flex: 0 0 80px;
    height: 1px;
    background: linear-gradient(90deg, var(--hc-gold-dim), transparent);
  }

  .hc-section-divider__symbol {
    font-size: 0.85rem;
    color: var(--hc-gold);
    letter-spacing: 0.25em;
    filter: drop-shadow(0 0 6px rgba(216, 177, 102, 0.3));
  }

  .hc-section-divider__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--hc-text-primary);
    text-align: left;
  }

  .hc-section-divider__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--hc-text-secondary);
    text-align: left;
  }

  :global([data-theme="light"]) .hc-section-divider__line {
    background: linear-gradient(90deg, rgba(176, 126, 44, 0.4), transparent);
  }

  @media (max-width: 640px) {
    .hc-section-divider {
      margin: 2.5rem 0 2rem;
    }

    .hc-section-divider__title {
      font-size: 1.25rem;
    }

    .hc-section-divider__line {
      flex: 0 0 50px;
    }
  }
</style>
