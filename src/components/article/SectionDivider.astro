---
export interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="hc-section-divider">
  <hr class="hc-section-divider__rule" />
  {title && <h2 class="hc-section-divider__title">{title}</h2>}
  {subtitle && <p class="hc-section-divider__subtitle">{subtitle}</p>}
</div>

<style>
  .hc-section-divider {
    margin: 3.5rem 0;
    text-align: center;
  }

  .hc-section-divider__rule {
    border: 0;
    height: 1px;
    width: 60%;
    margin: 0 auto 1.25rem;
    background: var(--hc-rule);
  }

  .hc-section-divider__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2vw, 2.2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--hc-text-primary);
  }

  .hc-section-divider__subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: var(--hc-text-tertiary);
  }
</style>
