---
export interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="hc-section-divider" role="separator">
  <div class="hc-section-divider__ornament">
    <span class="hc-section-divider__line"></span>
    <span class="hc-section-divider__symbol" aria-hidden="true">✦ ❖ ✦</span>
    <span class="hc-section-divider__line"></span>
  </div>
  {title && <h2 class="hc-section-divider__title">{title}</h2>}
  {subtitle && <p class="hc-section-divider__subtitle">{subtitle}</p>}
</div>

<style>
  .hc-section-divider {
    margin: 4.5rem 0;
    text-align: center;
  }

  .hc-section-divider__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .hc-section-divider__line {
    flex: 1;
    max-width: 140px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hc-gold-dim), transparent);
  }

  .hc-section-divider__symbol {
    font-size: 0.85rem;
    color: var(--hc-gold);
    letter-spacing: 0.3em;
    filter: drop-shadow(0 0 8px rgba(216, 177, 102, 0.35));
  }

  .hc-section-divider__title {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.5vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--hc-text-primary);
  }

  .hc-section-divider__subtitle {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--hc-text-secondary);
  }

  :global([data-theme="light"]) .hc-section-divider__line {
    background: linear-gradient(90deg, transparent, rgba(176, 126, 44, 0.4), transparent);
  }

  @media (max-width: 640px) {
    .hc-section-divider {
      margin: 3rem 0;
    }

    .hc-section-divider__line {
      max-width: 70px;
    }
  }
</style>
