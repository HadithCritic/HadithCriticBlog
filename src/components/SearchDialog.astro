---
import '../styles/search-dialog.css';

/* Shown before the reader types: the research platforms, then a few
   searches that land on substantial studies. */
const destinations = [
  { href: '/blogs/', title: 'Research archive', note: 'Every published study' },
  { href: '/hadith/', title: 'Hadith Corpus', note: 'Narrations in Arabic and English' },
  { href: '/narrators/', title: 'Rijāl Register', note: 'Transmitters and verdicts' },
  { href: '/projects/quran/', title: 'Qirāʾāt Variants', note: 'The ten readings side by side' },
];
const suggestions = [
  'Messiah ben Aaron',
  'The Family of Amram',
  'Ibn Shihab al-Zuhri',
  'Isnad Politics',
  'Bukhari Fourth Criterion',
  'Zubayrid Call Narrative',
  'Prophetic Knowledge',
  'Plural of Participation',
];
const filters = [
  { value: 'all', label: 'All' },
  { value: 'Origins & Early History', label: 'History' },
  { value: 'Prophecies & Eschatology', label: 'Prophecies' },
  { value: 'Theology & Epistemology', label: 'Theology' },
  { value: 'Transmission & Narrators', label: 'Transmission' },
];
---

<dialog class="search-dialog" id="site-search-dialog" aria-label="Search the HadithCritic archive">
  <div class="sd">
    <div class="sd__field">
      <svg class="sd__field-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7.5"></circle>
        <path d="m20.5 20.5-4.2-4.2"></path>
      </svg>
      <label class="sr-only" for="site-search-input">Search the HadithCritic archive</label>
      <input
        type="search"
        id="site-search-input"
        class="sd__input"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search studies, narrators, topics…"
        data-search-input
        aria-controls="search-results-list"
        aria-autocomplete="list"
      />
      <button type="button" class="sd__clear" data-search-clear aria-label="Clear search" hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
      <button type="button" class="sd__esc" data-search-close aria-label="Close search">Esc</button>
    </div>

    <div class="sd__filters" role="group" aria-label="Filter by category">
      {filters.map((filter, index) => (
        <button
          type="button"
          class:list={['sd__filter', { 'is-active': index === 0 }]}
          data-cat-filter={filter.value}
          data-category={index ? filter.value : undefined}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {index > 0 && <span class="sd__dot" aria-hidden="true"></span>}
          {filter.label}
        </button>
      ))}
    </div>

    <div class="sd__body">
      <p class="sd__label" data-search-status role="status" aria-live="polite">Jump to</p>

      <div class="sd__start" data-search-suggested>
        <ul class="sd__destinations">
          {destinations.map((item) => (
            <li>
              <a href={item.href} class="sd__destination" data-search-close-on-click>
                <span class="sd__destination-title">{item.title}</span>
                <span class="sd__destination-note">{item.note}</span>
                <span class="sd__destination-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="sd__label">Try searching</p>
        <div class="sd__suggestions">
          {suggestions.map((term) => (
            <button type="button" class="sd__suggestion" data-suggest={term}>{term}</button>
          ))}
        </div>
      </div>

      <ol class="sd__results" id="search-results-list" data-search-results hidden></ol>

      <div class="sd__empty" data-search-empty hidden>
        <p class="sd__empty-title">Nothing found</p>
        <p class="sd__empty-text">Try a narrator’s name, a shorter phrase, or clear the category filter.</p>
      </div>
    </div>

    <div class="sd__foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
      <span><kbd>↵</kbd> Open</span>
      <span><kbd>Esc</kbd> Close</span>
    </div>
  </div>
</dialog>

<script>
  interface SearchSection {
    heading: string;
    slug: string;
    text: string;
  }
  interface SearchDoc {
    id: string;
    title: string;
    description: string;
    category: string;
    tags: string[];
    date: string;
    sections: SearchSection[];
    fullText: string;
  }
  interface ArticleEntry {
    url: string;
    title: string;
    description: string;
    category: string;
    tags: string[];
    date: string;
  }
  interface Result {
    url: string;
    title: string;
    excerpt: string;
    category?: string;
    date?: string;
    sectionHeading?: string;
    score: number;
  }

  const dialog = document.querySelector<HTMLDialogElement>('#site-search-dialog');
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
  const clearBtn = dialog?.querySelector<HTMLButtonElement>('[data-search-clear]');
  const status = dialog?.querySelector<HTMLElement>('[data-search-status]');
  const resultList = dialog?.querySelector<HTMLOListElement>('[data-search-results]');
  const startView = dialog?.querySelector<HTMLElement>('[data-search-suggested]');
  const emptyView = dialog?.querySelector<HTMLElement>('[data-search-empty]');
  const chipButtons = dialog ? Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-cat-filter]')) : [];
  const suggestButtons = dialog ? Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-suggest]')) : [];

  // Titles, descriptions and tags only: small enough to answer before the
  // full-text index below arrives on a slow connection.
  let localCatalog: ArticleEntry[] = [];
  let localCatalogRequest: Promise<void> | null = null;

  const loadLocalCatalog = () => {
    if (localCatalogRequest) return localCatalogRequest;
    localCatalogRequest = fetch('/article-catalog.json')
      .then((res) => res.json() as Promise<ArticleEntry[]>)
      .then((entries) => {
        localCatalog = entries;
        if (!deepCatalog.length && input?.value.trim()) runSearch(input.value.trim());
      })
      .catch((err) => console.error('Failed to load local article catalog', err));
    return localCatalogRequest;
  };

  let deepCatalog: SearchDoc[] = [];
  let deepCatalogRequest: Promise<void> | null = null;

  const loadDeepCatalog = () => {
    if (deepCatalogRequest) return deepCatalogRequest;
    deepCatalogRequest = fetch('/search-index.json')
      .then((res) => res.json() as Promise<SearchDoc[]>)
      .then((docs) => {
        deepCatalog = docs;
        if (input?.value.trim()) runSearch(input.value.trim());
      })
      .catch(() => {});
    return deepCatalogRequest;
  };

  let invoker: HTMLElement | null = null;
  let timer = 0;
  let activeCategory = 'all';
  let selectedIndex = -1;

  const open = (button?: HTMLElement) => {
    if (!dialog || dialog.open) return;
    invoker = button || (document.activeElement as HTMLElement);
    loadLocalCatalog();
    loadDeepCatalog();
    dialog.showModal();
    document.documentElement.classList.add('has-modal');
    setTimeout(() => input?.focus(), 30);
  };

  const close = () => dialog?.close();

  document.addEventListener('hc:search-open', (event) => open((event as CustomEvent).detail));

  // Fetch the small catalog as soon as a search button is pointed at, focused
  // or touched, so it is usually in hand by the time the dialog opens. The
  // full-text index still waits for the dialog, to keep it off pages where
  // nobody searches.
  const warmOnTrigger = (event: Event) => {
    if ((event.target as Element | null)?.closest?.('[data-search-trigger]')) loadLocalCatalog();
  };
  document.addEventListener('pointerover', warmOnTrigger, { passive: true });
  document.addEventListener('focusin', warmOnTrigger);

  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      dialog?.open ? close() : open();
    }
  });

  dialog?.querySelector('[data-search-close]')?.addEventListener('click', close);
  dialog?.querySelectorAll('[data-search-close-on-click]').forEach((link) => link.addEventListener('click', close));
  dialog?.addEventListener('close', () => {
    document.documentElement.classList.remove('has-modal');
    invoker?.focus();
  });
  // A click on the backdrop lands on the dialog element itself.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });

  clearBtn?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    clearBtn.hidden = true;
    input.focus();
    runSearch('');
  });

  chipButtons.forEach((chip) => {
    chip.addEventListener('click', () => {
      chipButtons.forEach((c) => {
        c.classList.toggle('is-active', c === chip);
        c.setAttribute('aria-pressed', String(c === chip));
      });
      activeCategory = chip.dataset.catFilter || 'all';
      runSearch(input?.value.trim() || '');
    });
  });

  suggestButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!input) return;
      input.value = btn.dataset.suggest || '';
      if (clearBtn) clearBtn.hidden = false;
      input.focus();
      runSearch(input.value);
    });
  });

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function highlightMatches(text: string, query: string): string {
    if (!query || !text) return escapeHtml(text || '');
    const escaped = escapeHtml(text);
    const terms = query.split(/\s+/).filter(Boolean);
    if (!terms.length) return escaped;
    const pattern = terms.map((t) => escapeHtml(t).replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
    return escaped.replace(new RegExp(`(${pattern})`, 'gi'), '<mark>$1</mark>');
  }

  function cleanSnippet(raw: string): string {
    if (!raw) return '';
    return raw.replace(/\\n/g, ' ').replace(/[{}\[\]]/g, ' ').replace(/\s+/g, ' ').trim();
  }

  function createSnippetText(text: string, term: string): string {
    const cleaned = cleanSnippet(text);
    const idx = cleaned.toLowerCase().indexOf(term.toLowerCase());
    if (idx === -1) return cleaned.slice(0, 140) + (cleaned.length > 140 ? '…' : '');
    const start = Math.max(0, idx - 60);
    const end = Math.min(cleaned.length, idx + term.length + 80);
    return (start > 0 ? '…' : '') + cleaned.slice(start, end) + (end < cleaned.length ? '…' : '');
  }

  function formatDate(rawDate?: string): string {
    if (!rawDate) return '';
    const d = new Date(rawDate);
    if (isNaN(d.getTime())) return rawDate;
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
  }

  function categoryColor(category?: string): string {
    switch (category) {
      case 'Origins & Early History':
        return 'var(--cat-history-text, #d5b091)';
      case 'Prophecies & Eschatology':
        return 'var(--cat-prophecies-text, #d7988b)';
      case 'Theology & Epistemology':
        return 'var(--cat-theology-text, #9cb8a4)';
      case 'Transmission & Narrators':
        return 'var(--cat-philosophy-text, #a3afc7)';
      default:
        return 'var(--hc-gold, #c89b4b)';
    }
  }

  function showView(view: 'start' | 'results' | 'empty') {
    if (startView) startView.hidden = view !== 'start';
    if (resultList) resultList.hidden = view !== 'results';
    if (emptyView) emptyView.hidden = view !== 'empty';
  }

  function renderResults(entries: Result[], query: string) {
    if (!resultList || !status) return;
    resultList.innerHTML = '';
    selectedIndex = -1;

    if (!entries.length) {
      showView('empty');
      status.textContent = 'No results';
      return;
    }

    showView('results');
    status.textContent = `${entries.length} ${entries.length === 1 ? 'result' : 'results'}`;

    entries.forEach((item, idx) => {
      const li = document.createElement('li');
      const date = formatDate(item.date);
      li.innerHTML = `
        <a href="${escapeHtml(item.url)}" class="sd__result" data-index="${idx}" style="--sd-cat: ${categoryColor(item.category)};">
          <span class="sd__result-meta">
            <span class="sd__dot" aria-hidden="true"></span>${escapeHtml(item.category || 'Study')}${date ? `<span class="sd__result-date">${date}</span>` : ''}
          </span>
          <span class="sd__result-title">${highlightMatches(item.title, query)}</span>
          ${item.sectionHeading ? `<span class="sd__result-section">§ ${escapeHtml(item.sectionHeading)}</span>` : ''}
          ${item.excerpt ? `<span class="sd__result-excerpt">${highlightMatches(item.excerpt, query)}</span>` : ''}
          <span class="sd__result-enter" aria-hidden="true">↵</span>
        </a>
      `;
      const link = li.querySelector<HTMLAnchorElement>('a');
      link?.addEventListener('click', close);
      link?.addEventListener('pointermove', () => {
        if (selectedIndex === idx) return;
        selectedIndex = idx;
        updateSelection(false);
      });
      resultList.appendChild(li);
    });
  }

  function catalogDocs(): SearchDoc[] {
    if (deepCatalog.length) return deepCatalog;
    return localCatalog.map((c) => ({
      id: c.url.replace('/blogs/', ''),
      title: c.title,
      description: c.description,
      category: c.category,
      tags: c.tags,
      date: c.date,
      sections: [],
      fullText: `${c.title} ${c.description} ${c.tags.join(' ')}`,
    }));
  }

  function scoreDoc(item: SearchDoc, q: string): Result | null {
    const inTitle = item.title.toLowerCase().includes(q);
    const inDesc = item.description.toLowerCase().includes(q);
    const inTags = item.tags?.some((t) => t.toLowerCase().includes(q)) ?? false;
    const section = item.sections?.find((sec) => sec.heading.toLowerCase().includes(q) || sec.text.toLowerCase().includes(q));
    const inFullText = item.fullText?.toLowerCase().includes(q) ?? false;
    if (!inTitle && !inDesc && !inTags && !section && !inFullText) return null;

    const sectionSnippet = section
      ? createSnippetText(section.text.toLowerCase().includes(q) ? section.text : section.heading, q)
      : '';
    return {
      url: section?.slug ? `/blogs/${item.id}/#${section.slug}` : `/blogs/${item.id}/`,
      title: item.title,
      excerpt: sectionSnippet || item.description || (item.fullText ? createSnippetText(item.fullText, q) : ''),
      category: item.category,
      date: item.date,
      sectionHeading: section?.heading,
      score: (inTitle ? 10 : 0) + (inTags ? 6 : 0) + (inDesc ? 4 : 0) + (section ? 5 : 0),
    };
  }

  function runSearch(query: string) {
    if (!status) return;
    if (!query) {
      if (resultList) resultList.innerHTML = '';
      showView('start');
      status.textContent = 'Jump to';
      selectedIndex = -1;
      return;
    }
    const q = query.toLowerCase();
    const results = catalogDocs()
      .filter((item) => activeCategory === 'all' || item.category === activeCategory)
      .map((item) => scoreDoc(item, q))
      .filter((item): item is Result => item !== null)
      .sort((a, b) => b.score - a.score);
    renderResults(results.slice(0, 16), query);
  }

  function updateSelection(scroll = true) {
    const cards = dialog ? Array.from(dialog.querySelectorAll<HTMLAnchorElement>('.sd__result')) : [];
    cards.forEach((card, idx) => {
      const isSelected = idx === selectedIndex;
      card.classList.toggle('is-selected', isSelected);
      if (isSelected && scroll) card.scrollIntoView({ block: 'nearest' });
    });
  }

  dialog?.addEventListener('keydown', (e: KeyboardEvent) => {
    const cards = Array.from(dialog.querySelectorAll<HTMLAnchorElement>('.sd__result'));
    if (!cards.length) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedIndex = (selectedIndex + 1) % cards.length;
      updateSelection();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedIndex = (selectedIndex - 1 + cards.length) % cards.length;
      updateSelection();
    } else if (e.key === 'Enter') {
      // Enter in the field opens the top result when nothing is selected.
      const target = selectedIndex >= 0 ? selectedIndex : e.target === input ? 0 : -1;
      if (target < 0 || target >= cards.length) return;
      e.preventDefault();
      cards[target].click();
    }
  });

  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    const query = input.value.trim();
    if (clearBtn) clearBtn.hidden = !query;
    timer = window.setTimeout(() => runSearch(query), 120);
  });
</script>
