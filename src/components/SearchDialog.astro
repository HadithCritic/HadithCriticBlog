---
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft);
const searchIndex = allArticles.map((article) => {
  const d = article.data.date ? new Date(article.data.date) : null;
  const formattedDate = d && !isNaN(d.getTime())
    ? d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
    : '';

  return {
    url: `/blogs/${article.id}`,
    title: article.data.title,
    description: article.data.description || '',
    category: article.data.category,
    tags: article.data.tags || [],
    date: formattedDate
  };
});
---

<dialog class="search-dialog" id="site-search-dialog" aria-labelledby="site-search-title">
  <div class="search-dialog__surface">
    <!-- Header -->
    <div class="search-dialog__header">
      <div class="search-dialog__title-group">
        <span class="search-dialog__eyebrow">
          <span class="search-dialog__diamond" aria-hidden="true"></span>
          Archive Inquiries
        </span>
        <h2 id="site-search-title" class="search-dialog__title">Search HadithCritic</h2>
      </div>
      <button type="button" class="search-dialog__close" data-search-close aria-label="Close search">
        <span class="search-dialog__close-text">Close</span>
        <kbd class="search-dialog__kbd">ESC</kbd>
        <svg class="search-dialog__close-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Search Input Box -->
    <div class="search-dialog__input-wrap">
      <div class="search-dialog__input-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <label class="sr-only" for="site-search-input">Search HadithCritic archive</label>
      <input
        type="search"
        id="site-search-input"
        class="search-dialog__input"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search studies, isnads, narrators, topics, or terms…"
        data-search-input
        aria-controls="search-results-list"
        aria-autocomplete="list"
      />
      <button type="button" class="search-dialog__clear" data-search-clear aria-label="Clear search input" hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Category Filter Chips -->
    <div class="search-dialog__chips-bar" role="tablist" aria-label="Filter search results by category">
      <button type="button" class="search-chip is-active" data-cat-filter="all">All Topics</button>
      <button type="button" class="search-chip" data-cat-filter="Theology & Epistemology" data-cat="theology">
        <span class="search-chip__dot"></span>Theology
      </button>
      <button type="button" class="search-chip" data-cat-filter="Origins & Early History" data-cat="origins">
        <span class="search-chip__dot"></span>Origins & History
      </button>
      <button type="button" class="search-chip" data-cat-filter="Transmission & Narrators" data-cat="transmission">
        <span class="search-chip__dot"></span>Transmission
      </button>
      <button type="button" class="search-chip" data-cat-filter="Prophecies & Eschatology" data-cat="prophecies">
        <span class="search-chip__dot"></span>Prophecies
      </button>
    </div>

    <!-- Subheader / Status Bar -->
    <div class="search-dialog__status-bar">
      <span class="search-dialog__status" data-search-status role="status" aria-live="polite">
        Suggested Research Topics
      </span>
      <span class="search-dialog__nav-hint" aria-hidden="true">
        Navigate with <kbd>↑</kbd> <kbd>↓</kbd>
      </span>
    </div>

    <!-- Results / Content Area -->
    <div class="search-dialog__body">
      <!-- Suggested Inquiries (Initial View) -->
      <div class="search-dialog__suggested" data-search-suggested>
        <p class="suggested-title">Frequent Inquiries & Themes</p>
        <div class="suggested-pills">
          <button type="button" class="suggested-pill" data-suggest="Messiah ben Aaron">
            <span class="suggested-pill__icon">✦</span> Messiah ben Aaron
          </button>
          <button type="button" class="suggested-pill" data-suggest="The Family of Amram">
            <span class="suggested-pill__icon">✦</span> Family of Amram
          </button>
          <button type="button" class="suggested-pill" data-suggest="Plural of Participation">
            <span class="suggested-pill__icon">✦</span> Plural of Participation
          </button>
          <button type="button" class="suggested-pill" data-suggest="Ibn Shihab al-Zuhri">
            <span class="suggested-pill__icon">✦</span> Al-Zuhri Forensics
          </button>
          <button type="button" class="suggested-pill" data-suggest="Isnad Politics">
            <span class="suggested-pill__icon">✦</span> Isnad Politics
          </button>
          <button type="button" class="suggested-pill" data-suggest="Bukhari Fourth Criterion">
            <span class="suggested-pill__icon">✦</span> Bukhari Criteria
          </button>
          <button type="button" class="suggested-pill" data-suggest="Zubayrid Call Narrative">
            <span class="suggested-pill__icon">✦</span> Zubayrid Narrative
          </button>
          <button type="button" class="suggested-pill" data-suggest="Prophetic Knowledge">
            <span class="suggested-pill__icon">✦</span> Prophetic Knowledge
          </button>
        </div>
      </div>

      <!-- Results List -->
      <ol class="search-dialog__results" id="search-results-list" data-search-results hidden></ol>

      <!-- Empty State -->
      <div class="search-dialog__empty" data-search-empty hidden>
        <div class="search-dialog__empty-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <p class="search-dialog__empty-title">No matching entries found</p>
        <p class="search-dialog__empty-desc">No articles match your query. Try searching for a broader keyword, narrator name, or select a different category above.</p>
      </div>
    </div>

    <!-- Footer Bar -->
    <div class="search-dialog__footer" aria-hidden="true">
      <div class="search-dialog__footer-hint">
        <kbd class="hc-kbd">↵</kbd> <span>Select</span>
      </div>
      <div class="search-dialog__footer-hint">
        <kbd class="hc-kbd">↑</kbd><kbd class="hc-kbd">↓</kbd> <span>Navigate</span>
      </div>
      <div class="search-dialog__footer-hint">
        <kbd class="hc-kbd">ESC</kbd> <span>Dismiss</span>
      </div>
    </div>
  </div>
</dialog>

<script id="hc-article-catalog" type="application/json" is:inline set:html={JSON.stringify(searchIndex)} />

<style>
  .search-dialog {
    width: min(48rem, calc(100vw - 2rem));
    max-height: min(46rem, calc(100vh - 4rem));
    padding: 0;
    margin: auto;
    border: 1px solid var(--hc-rule, rgba(242, 235, 220, 0.16));
    border-radius: var(--radius-lg, 12px);
    color: var(--hc-text-primary, #f2ebdc);
    background: linear-gradient(180deg, var(--hc-surface-1, #141416) 0%, var(--hc-surface-0, #0f0f10) 100%);
    box-shadow: 
      0 25px 80px -10px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(216, 177, 102, 0.16),
      0 0 40px rgba(216, 177, 102, 0.04);
    overflow: hidden;
  }

  .search-dialog[open] {
    animation: searchModalEnter 0.22s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes searchModalEnter {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(-8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .search-dialog::backdrop {
    background: rgba(6, 6, 8, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    animation: searchBackdropEnter 0.22s ease both;
  }

  @keyframes searchBackdropEnter {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .search-dialog__surface {
    display: flex;
    flex-direction: column;
    height: 100%;
    max-height: inherit;
    padding: 0;
  }

  /* ── Header ── */
  .search-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem 1rem;
    border-bottom: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.08));
  }

  .search-dialog__title-group {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .search-dialog__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--hc-gold-dim, #9d7a3c);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .search-dialog__diamond {
    width: 4px;
    height: 4px;
    background: var(--hc-gold, #c89b4b);
    transform: rotate(45deg);
  }

  .search-dialog__title {
    margin: 0;
    font-family: var(--font-display, serif);
    font-size: clamp(1.4rem, 3vw, 1.57rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--hc-text-primary, #f2ebdc);
  }

  .search-dialog__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--hc-rule, rgba(242, 235, 220, 0.14));
    border-radius: var(--radius-pill, 999px);
    color: var(--hc-text-secondary, #c7beab);
    background: rgba(242, 235, 220, 0.03);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.81rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .search-dialog__close:hover,
  .search-dialog__close:active {
    color: var(--hc-gold-bright, #e8c67c);
    border-color: var(--hc-gold-dim, #9d7a3c);
    background: rgba(216, 177, 102, 0.08);
  }

  .search-dialog__close-icon {
    flex-shrink: 0;
  }

  .search-dialog__kbd {
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--hc-rule, rgba(242, 235, 220, 0.14));
    border-radius: 4px;
    font-family: var(--font-ui, sans-serif);
    font-size: 0.77rem;
    color: var(--hc-gold-soft, #d8b166);
    background: rgba(0, 0, 0, 0.25);
  }

  /* ── Input Box ── */
  .search-dialog__input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    margin: 1.1rem 1.5rem 0.75rem;
    padding: 0 1rem;
    border: 1px solid var(--hc-rule, rgba(242, 235, 220, 0.14));
    border-radius: var(--radius-md, 8px);
    background: rgba(242, 235, 220, 0.03);
    transition: all 200ms ease;
  }

  .search-dialog__input-wrap:focus-within {
    border-color: var(--hc-gold, #c89b4b);
    background: rgba(242, 235, 220, 0.05);
    box-shadow: 
      0 0 0 3px rgba(216, 177, 102, 0.14),
      0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .search-dialog__input-icon {
    display: grid;
    place-items: center;
    color: var(--hc-gold, #c89b4b);
    flex-shrink: 0;
    margin-right: 0.75rem;
  }

  .search-dialog__input {
    width: 100%;
    min-height: 48px;
    border: 0;
    color: var(--hc-text-primary, #f2ebdc);
    background: transparent;
    font-family: var(--font-body, sans-serif);
    font-size: 1.18rem;
  }

  .search-dialog__input::placeholder {
    color: var(--hc-text-tertiary, #8c8577);
    font-family: var(--font-body, sans-serif);
    font-size: 1.03rem;
  }

  .search-dialog__input::-webkit-search-cancel-button,
  .search-dialog__input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-dialog__clear {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 50%;
    color: var(--hc-text-secondary, #c7beab);
    background: rgba(242, 235, 220, 0.08);
    cursor: pointer;
    flex-shrink: 0;
    transition: all 160ms ease;
  }

  .search-dialog__clear:hover {
    color: var(--hc-text-primary, #f2ebdc);
    background: rgba(216, 177, 102, 0.2);
  }

  /* ── Category Chips Bar ── */
  .search-dialog__chips-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 1.5rem 0.85rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .search-dialog__chips-bar::-webkit-scrollbar {
    display: none;
  }

  .search-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 28px;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.1));
    border-radius: var(--radius-pill, 999px);
    color: var(--hc-text-secondary, #c7beab);
    background: rgba(242, 235, 220, 0.02);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.81rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .search-chip:hover {
    color: var(--hc-text-primary, #f2ebdc);
    border-color: var(--hc-rule, rgba(242, 235, 220, 0.18));
    background: rgba(242, 235, 220, 0.06);
  }

  .search-chip.is-active {
    color: var(--hc-text-inverse, #0f0f10);
    background: var(--hc-gold, #c89b4b);
    border-color: var(--hc-gold, #c89b4b);
    font-weight: 700;
  }

  /* ── Hidden State Guard ── */
  [hidden] {
    display: none !important;
  }
  .search-dialog__empty[hidden],
  .search-dialog__suggested[hidden],
  .search-dialog__results[hidden],
  .search-dialog__clear[hidden] {
    display: none !important;
  }

  .search-chip__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  /* ── Status Bar ── */
  .search-dialog__status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1.5rem;
    border-top: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.08));
    border-bottom: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.08));
    background: rgba(0, 0, 0, 0.18);
  }

  .search-dialog__status {
    color: var(--hc-gold-soft, #d8b166);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.83rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search-dialog__nav-hint {
    color: var(--hc-text-tertiary, #8c8577);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.81rem;
  }

  .search-dialog__nav-hint kbd {
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--hc-rule, rgba(242, 235, 220, 0.14));
    border-radius: 3px;
    font-size: 0.78rem;
    color: var(--hc-text-secondary, #c7beab);
  }

  /* ── Content / Results Body ── */
  .search-dialog__body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 1rem 1.5rem;
    max-height: 25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--hc-rule, rgba(242, 235, 220, 0.14)) transparent;
  }

  .search-dialog__body::-webkit-scrollbar {
    width: 6px;
  }
  .search-dialog__body::-webkit-scrollbar-thumb {
    background: var(--hc-rule, rgba(242, 235, 220, 0.14));
    border-radius: 3px;
  }

  /* ── Suggested Inquiries View ── */
  .search-dialog__suggested {
    padding: 0.5rem 0 1rem;
  }

  .suggested-title {
    margin: 0 0 0.85rem;
    color: var(--hc-text-secondary, #c7beab);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.87rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .suggested-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .suggested-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--hc-rule, rgba(242, 235, 220, 0.14));
    border-radius: var(--radius-md, 8px);
    color: var(--hc-text-primary, #f2ebdc);
    background: rgba(242, 235, 220, 0.03);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.92rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .suggested-pill__icon {
    color: var(--hc-gold, #c89b4b);
    font-size: 0.8rem;
  }

  .suggested-pill:hover {
    color: var(--hc-gold-bright, #e8c67c);
    border-color: var(--hc-gold-dim, #9d7a3c);
    background: rgba(216, 177, 102, 0.08);
    transform: translateY(-1px);
  }

  /* ── Empty State ── */
  .search-dialog__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 1.5rem;
  }

  .search-dialog__empty-icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 1px solid var(--hc-rule, rgba(242, 235, 220, 0.14));
    color: var(--hc-gold-dim, #9d7a3c);
    background: rgba(216, 177, 102, 0.06);
    margin-bottom: 1rem;
  }

  .search-dialog__empty-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display, serif);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--hc-text-primary, #f2ebdc);
  }

  .search-dialog__empty-desc {
    max-width: 380px;
    margin: 0;
    color: var(--hc-text-secondary, #c7beab);
    font-family: var(--font-body, sans-serif);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* ── Footer ── */
  .search-dialog__footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    padding: 0.75rem 1.5rem;
    border-top: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.08));
    background: rgba(0, 0, 0, 0.25);
  }

  .search-dialog__footer-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--hc-text-tertiary, #8c8577);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.81rem;
  }

  .hc-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border: 1px solid var(--hc-rule, rgba(242, 235, 220, 0.14));
    border-radius: 3px;
    color: var(--hc-text-secondary, #c7beab);
    background: rgba(242, 235, 220, 0.05);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
  }

  /* ═══════════════════════════════════════════════════════════════
     DYNAMIC SEARCH RESULTS STYLING (GLOBAL FOR RUNTIME ELEMENTS)
     ═══════════════════════════════════════════════════════════════ */
  :global(.search-dialog__results) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  :global(.search-dialog__item) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.search-result-card) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1.3rem;
    border: 1px solid var(--hc-rule, rgba(242, 235, 220, 0.12));
    border-radius: var(--radius-md, 6px);
    background: var(--hc-surface-0, #0f0f10);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  :global(.search-result-card:hover),
  :global(.search-result-card.is-selected),
  :global(.search-result-card:focus-visible) {
    border-color: var(--hc-gold-dim, #9d7a3c);
    background: var(--hc-surface-1, #141416);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(216, 177, 102, 0.1);
  }

  :global(.search-card__header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  :global(.search-card__category) {
    font-family: var(--font-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hc-gold, #c89b4b);
  }

  :global(.search-card__date) {
    color: var(--hc-text-tertiary, #8c8577);
    font-family: var(--font-ui, sans-serif);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
  }

  :global(.search-card__title) {
    margin: 0;
    font-family: var(--font-display, serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--hc-text-primary, #f2ebdc);
    transition: color 160ms ease;
  }

  :global(.search-result-card:hover .search-card__title),
  :global(.search-result-card.is-selected .search-card__title) {
    color: var(--hc-gold-bright, #e8c67c);
  }

  :global(.search-card__section-match) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    background: rgba(242, 235, 220, 0.04);
    border: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.08));
    font-family: var(--font-ui, sans-serif);
    font-size: 0.78rem;
    color: var(--hc-text-secondary, #c7beab);
    width: fit-content;
  }

  :global(.search-card__section-icon) {
    color: var(--hc-gold-dim, #9d7a3c);
    font-weight: 700;
  }

  :global(.search-card__section-text strong) {
    color: var(--hc-text-primary, #f2ebdc);
    font-weight: 600;
  }

  :global(.search-card__excerpt) {
    margin: 0;
    color: var(--hc-text-secondary, #c7beab);
    font-family: var(--font-body, sans-serif);
    font-size: 0.92rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-highlight) {
    background: rgba(216, 177, 102, 0.22);
    color: var(--hc-gold-bright, #fcefd6);
    font-weight: 600;
    padding: 0 3px;
    border-radius: 2px;
    text-decoration: none;
  }

  :global(.search-card__footer) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.15rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--hc-rule-soft, rgba(242, 235, 220, 0.07));
  }

  :global(.search-card__link-text) {
    font-family: var(--font-ui, sans-serif);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hc-gold, #c89b4b);
  }

  :global(.search-card__arrow) {
    color: var(--hc-gold, #c89b4b);
    transform: translateX(0);
    transition: transform 160ms ease;
  }

  :global(.search-result-card:hover .search-card__arrow),
  :global(.search-result-card.is-selected .search-card__arrow) {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .search-dialog {
      width: 100vw;
      max-height: 100vh;
      max-height: 100dvh;
      height: 100vh;
      height: 100dvh;
      border-radius: 0;
      border: none;
    }

    .search-dialog__header {
      padding-top: max(1.1rem, var(--sat, 0px));
      padding-inline: 1rem;
    }

    .search-dialog__input-wrap,
    .search-dialog__chips-bar,
    .search-dialog__status-bar,
    .search-dialog__body {
      padding-inline: 1rem;
    }

    .search-dialog__footer {
      padding-inline: 1rem;
      padding-bottom: max(0.85rem, var(--sab, 0px));
    }

    .search-dialog__input-wrap {
      margin-inline: 1rem;
    }

    .search-dialog__footer-hint:not(:first-child) {
      display: none;
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     LIGHT THEME OVERRIDES — Search Modal & Cards
     ═══════════════════════════════════════════════════════════════ */
  :global([data-theme="light"]) .search-dialog {
    background: var(--hc-surface-0, #fbf9f4);
    border-color: var(--hc-rule-strong, rgba(43, 40, 36, 0.2));
    box-shadow: 0 20px 60px rgba(43, 40, 36, 0.18);
  }

  :global([data-theme="light"]) .search-dialog__status-bar {
    background: var(--hc-surface-1, #f5f0e6);
    border-color: var(--hc-rule-soft, rgba(43, 40, 36, 0.1));
  }

  :global([data-theme="light"]) .search-dialog__footer {
    background: var(--hc-surface-1, #f5f0e6);
    border-color: var(--hc-rule-soft, rgba(43, 40, 36, 0.1));
  }

  :global([data-theme="light"]) .search-result-card {
    background: var(--hc-surface-0, #fbf9f4);
    border-color: var(--hc-rule, rgba(43, 40, 36, 0.14));
  }

  :global([data-theme="light"]) .search-result-card:hover,
  :global([data-theme="light"]) .search-result-card.is-selected,
  :global([data-theme="light"]) .search-result-card:focus-visible {
    background: var(--hc-surface-1, #f5f0e6);
    border-color: var(--hc-gold-dim, #9d7a3c);
    box-shadow: 0 6px 18px rgba(43, 40, 36, 0.1);
  }

  :global([data-theme="light"]) .search-card__section-match {
    background: rgba(43, 40, 36, 0.04);
    border-color: var(--hc-rule-soft, rgba(43, 40, 36, 0.1));
    color: var(--hc-text-secondary, #5c5549);
  }

  :global([data-theme="light"]) .search-highlight {
    background: rgba(176, 126, 44, 0.2);
    color: #4a340d;
  }
</style>

<script>
  interface SearchSection {
    heading: string;
    slug: string;
    text: string;
  }
  interface SearchDoc {
    id: string;
    title: string;
    description: string;
    category: string;
    tags: string[];
    date: string;
    sections: SearchSection[];
    fullText: string;
  }
  interface ArticleEntry {
    url: string;
    title: string;
    description: string;
    category: string;
    tags: string[];
    date: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>('#site-search-dialog');
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
  const clearBtn = dialog?.querySelector<HTMLButtonElement>('[data-search-clear]');
  const status = dialog?.querySelector<HTMLElement>('[data-search-status]');
  const resultList = dialog?.querySelector<HTMLOListElement>('[data-search-results]');
  const suggestedView = dialog?.querySelector<HTMLElement>('[data-search-suggested]');
  const emptyView = dialog?.querySelector<HTMLElement>('[data-search-empty]');
  const chipButtons = dialog ? Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-cat-filter]')) : [];
  const suggestButtons = dialog ? Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-suggest]')) : [];

  let localCatalog: ArticleEntry[] = [];
  try {
    const catalogEl = document.getElementById('hc-article-catalog');
    if (catalogEl?.textContent) {
      localCatalog = JSON.parse(catalogEl.textContent);
    }
  } catch (err) {
    console.error('Failed to load local article catalog', err);
  }

  let deepCatalog: SearchDoc[] = [];
  fetch('/search-index.json')
    .then((res) => res.json() as Promise<SearchDoc[]>)
    .then((docs) => {
      deepCatalog = docs;
    })
    .catch(() => {});

  let invoker: HTMLElement | null = null;
  let timer = 0;
  let activeCategory = 'all';
  let selectedIndex = -1;

  const open = (button?: HTMLElement) => {
    if (!dialog?.open) {
      invoker = button || (document.activeElement as HTMLElement);
      dialog?.showModal();
      setTimeout(() => input?.focus(), 50);
    }
  };

  const close = () => {
    dialog?.close();
  };

  document.addEventListener('hc:search-open', (event) => open((event as CustomEvent).detail));
  
  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      dialog?.open ? close() : open();
    }
  });

  dialog?.querySelector('[data-search-close]')?.addEventListener('click', close);
  dialog?.addEventListener('close', () => invoker?.focus());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });

  clearBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      clearBtn.hidden = true;
      input.focus();
      runSearch('');
    }
  });

  chipButtons.forEach((chip) => {
    chip.addEventListener('click', () => {
      chipButtons.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      activeCategory = chip.dataset.catFilter || 'all';
      runSearch(input?.value.trim() || '');
    });
  });

  suggestButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const term = btn.dataset.suggest || '';
      if (input) {
        input.value = term;
        clearBtn && (clearBtn.hidden = false);
        runSearch(term);
      }
    });
  });

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function highlightMatches(text: string, query: string): string {
    if (!query || !text) return escapeHtml(text || '');
    const escaped = escapeHtml(text);
    const terms = query.split(/\s+/).filter(Boolean);
    if (!terms.length) return escaped;
    const regex = new RegExp(`(${terms.map(t => escapeHtml(t).replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');
    return escaped.replace(regex, '<mark class="search-highlight">$1</mark>');
  }

  function cleanSnippet(raw: string): string {
    if (!raw) return '';
    return raw
      .replace(/\\n/g, ' ')
      .replace(/[{}\[\]]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function createSnippetText(text: string, term: string): string {
    const cleaned = cleanSnippet(text);
    const lower = cleaned.toLowerCase();
    const idx = lower.indexOf(term.toLowerCase());
    if (idx === -1) {
      return cleaned.slice(0, 140) + (cleaned.length > 140 ? '…' : '');
    }

    const start = Math.max(0, idx - 60);
    const end = Math.min(cleaned.length, idx + term.length + 80);
    let snippet = cleaned.slice(start, end);
    if (start > 0) snippet = '…' + snippet;
    if (end < cleaned.length) snippet = snippet + '…';
    return snippet;
  }

  function formatDate(rawDate?: string): string {
    if (!rawDate) return '';
    const d = new Date(rawDate);
    if (isNaN(d.getTime())) return rawDate;
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function renderCards(
    entries: Array<{
      url: string;
      title: string;
      excerpt: string;
      category?: string;
      date?: string;
      sectionHeading?: string;
    }>,
    query: string
  ) {
    if (!resultList || !status || !emptyView || !suggestedView) return;

    resultList.innerHTML = '';
    selectedIndex = -1;

    if (!entries.length) {
      suggestedView.hidden = true;
      resultList.hidden = true;
      emptyView.hidden = false;
      status.textContent = 'No matching results';
      return;
    }

    suggestedView.hidden = true;
    emptyView.hidden = true;
    resultList.hidden = false;
    status.textContent = `${entries.length} ${entries.length === 1 ? 'study' : 'studies'} discovered`;

    entries.forEach((item, idx) => {
      const li = document.createElement('li');
      li.className = 'search-dialog__item';
      const categoryLabel = item.category || 'Analysis';
      const dateDisplay = formatDate(item.date);

      li.innerHTML = `
        <a href="${item.url}" class="search-result-card" data-index="${idx}">
          <div class="search-card__header">
            <span class="search-card__category">${escapeHtml(categoryLabel)}</span>
            ${dateDisplay ? `<span class="search-card__date">${dateDisplay}</span>` : ''}
          </div>
          <h3 class="search-card__title">${highlightMatches(item.title, query)}</h3>
          ${item.sectionHeading ? `
            <div class="search-card__section-match">
              <span class="search-card__section-icon" aria-hidden="true">§</span>
              <span class="search-card__section-text">Section: <strong>${escapeHtml(item.sectionHeading)}</strong></span>
            </div>
          ` : ''}
          ${item.excerpt ? `<p class="search-card__excerpt">${highlightMatches(item.excerpt, query)}</p>` : ''}
          <div class="search-card__footer">
            <span class="search-card__link-text">${item.sectionHeading ? 'Jump to section' : 'Read study'}</span>
            <svg class="search-card__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      `;

      const link = li.querySelector('a');
      link?.addEventListener('click', close);
      resultList.appendChild(li);
    });
  }

  async function runSearch(query: string) {
    if (!status || !resultList || !suggestedView || !emptyView) return;

    if (!query) {
      resultList.innerHTML = '';
      resultList.hidden = true;
      emptyView.hidden = true;
      suggestedView.hidden = false;
      status.textContent = 'Suggested Research Topics';
      selectedIndex = -1;
      return;
    }

    status.textContent = 'Searching archive & content…';

    const lowerQuery = query.toLowerCase();
    const catalogToSearch = deepCatalog.length > 0 ? deepCatalog : localCatalog.map(c => ({
      id: c.url.replace('/blogs/', ''),
      title: c.title,
      description: c.description,
      category: c.category,
      tags: c.tags,
      date: c.date,
      sections: [],
      fullText: `${c.title} ${c.description} ${c.tags.join(' ')}`
    }));

    const results: Array<{
      url: string;
      title: string;
      excerpt: string;
      category?: string;
      date?: string;
      sectionHeading?: string;
      score: number;
    }> = [];

    for (const item of catalogToSearch) {
      if (activeCategory !== 'all' && item.category !== activeCategory) {
        continue;
      }

      const inTitle = item.title.toLowerCase().includes(lowerQuery);
      const inDesc = item.description.toLowerCase().includes(lowerQuery);
      const inTags = item.tags ? item.tags.some(t => t.toLowerCase().includes(lowerQuery)) : false;
      
      let sectionMatch: SearchSection | null = null;
      let sectionSnippet = '';

      if (item.sections && item.sections.length > 0) {
        for (const sec of item.sections) {
          if (sec.heading.toLowerCase().includes(lowerQuery) || sec.text.toLowerCase().includes(lowerQuery)) {
            sectionMatch = sec;
            const src = sec.text.toLowerCase().includes(lowerQuery) ? sec.text : sec.heading;
            sectionSnippet = createSnippetText(src, lowerQuery);
            break;
          }
        }
      }

      const inFullText = item.fullText ? item.fullText.toLowerCase().includes(lowerQuery) : false;

      if (inTitle || inDesc || inTags || sectionMatch || inFullText) {
        let score = 0;
        if (inTitle) score += 10;
        if (inTags) score += 6;
        if (inDesc) score += 4;
        if (sectionMatch) score += 5;

        const targetUrl = sectionMatch && sectionMatch.slug 
          ? `/blogs/${item.id}#${sectionMatch.slug}` 
          : `/blogs/${item.id}`;

        const excerpt = sectionSnippet || item.description || (item.fullText ? createSnippetText(item.fullText, lowerQuery) : '');

        results.push({
          url: targetUrl,
          title: item.title,
          excerpt,
          category: item.category,
          date: item.date,
          sectionHeading: sectionMatch ? sectionMatch.heading : undefined,
          score
        });
      }
    }

    results.sort((a, b) => b.score - a.score);
    renderCards(results.slice(0, 16), query);
  }

  dialog?.addEventListener('keydown', (e: KeyboardEvent) => {
    const cards = Array.from(dialog.querySelectorAll<HTMLAnchorElement>('.search-result-card'));
    if (!cards.length) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedIndex = (selectedIndex + 1) % cards.length;
      updateSelection(cards);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedIndex = (selectedIndex - 1 + cards.length) % cards.length;
      updateSelection(cards);
    } else if (e.key === 'Enter') {
      if (selectedIndex >= 0 && selectedIndex < cards.length) {
        e.preventDefault();
        cards[selectedIndex].click();
      }
    }
  });

  function updateSelection(cards: HTMLAnchorElement[]) {
    cards.forEach((card, idx) => {
      const isSelected = idx === selectedIndex;
      card.classList.toggle('is-selected', isSelected);
      if (isSelected) {
        card.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    });
  }

  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    const query = input.value.trim();
    if (clearBtn) clearBtn.hidden = !query;
    timer = window.setTimeout(() => {
      runSearch(query);
    }, 120);
  });
</script>
