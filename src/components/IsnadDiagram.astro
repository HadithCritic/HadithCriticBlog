---

export interface DiagramNode {
id: string;
x: number;
y: number;
label?: string;
sublabel?: string;
labelPos?: 'right' | 'left' | 'above' | 'below';
labelDx?: number;
labelDy?: number;
kind?: 'root' | 'cl' | 'collector' | 'ghost' | 'normal';
}

export interface DiagramEdge {
from: string;
to: string;
kind?: 'trunk' | 'normal' | 'dive';
}

export interface DiagramTier {
y: number;
label: string;
}

export interface DiagramAnnotation {
x: number;
y: number;
text: string;
anchor?: 'start' | 'middle' | 'end';
kind?: 'dive' | 'note';
dx?: number;
dy?: number;
}

interface Props {
nodes: DiagramNode[];
edges: DiagramEdge[];
tiers?: DiagramTier[];
annotations?: DiagramAnnotation[];
width?: number;
height?: number;
caption?: string;
href?: string;
hrefLabel?: string;
ariaLabel?: string;
legend?: boolean;
}

const {
nodes,
edges,
tiers = [],
annotations = [],
width = 760,
height = 620,
caption,
href,
hrefLabel = 'Open in Silsilah',
ariaLabel = 'Isnad transmission diagram',
legend = true
} = Astro.props as Props;

const byId = new Map<string, DiagramNode>(nodes.map((node) => [node.id, node]));

const at = (id: string): DiagramNode => {
const node = byId.get(id);
if (!node) {
throw new Error('IsnadDiagram: unknown node id ' + id);
}
return node;
};

const curve = (a: DiagramNode, b: DiagramNode): string => {
const lower = a.y >= b.y ? a : b;
const higher = a.y >= b.y ? b : a;
const midY = (lower.y + higher.y) / 2;

return `M ${lower.x} ${lower.y} C ${lower.x} ${midY}, ${higher.x} ${midY}, ${higher.x} ${higher.y}`;
};

const getLabelOffset = (node: DiagramNode) => {
let x = node.x + 16;
let y = node.y + 4;
let anchor: 'start' | 'middle' | 'end' = 'start';

if (node.labelPos === 'left') {
x = node.x - 16;
y = node.y + 4;
anchor = 'end';
}

if (node.labelPos === 'above') {
x = node.x;
y = node.y - 16;
anchor = 'middle';
}

if (node.labelPos === 'below') {
x = node.x;
y = node.y + 24;
anchor = 'middle';
}

return {
x: x + (node.labelDx ?? 0),
y: y + (node.labelDy ?? 0),
anchor
};
};

const getLabelLines = (label?: string): string[] => {
if (!label) return [];
return label.split('\n');
};

const getNodeClass = (node: DiagramNode): string => {
const classes = ['node'];

if (node.kind === 'root') classes.push('node--root');
if (node.kind === 'cl') classes.push('node--cl');
if (node.kind === 'collector') classes.push('node--coll');
if (node.kind === 'ghost') classes.push('node--ghost');

return classes.join(' ');
};

const getLabelClass = (node: DiagramNode): string => {
const classes = ['lbl'];

if (node.kind === 'cl') classes.push('lbl--cl');
if (node.kind === 'collector') classes.push('lbl--coll');
if (node.kind === 'ghost') classes.push('lbl--ghost');

return classes.join(' ');
};

const getEdgeClass = (edge: DiagramEdge): string => {
const classes = ['edge'];

if (edge.kind === 'trunk') classes.push('edge--trunk');

return classes.join(' ');
};

const getAnnotationClass = (annotation: DiagramAnnotation): string => {
const classes = ['lbl', 'lbl--note'];

if (annotation.kind === 'dive') classes.push('lbl--dive');

return classes.join(' ');
};

const getNodeRadius = (node: DiagramNode): number => {
if (node.kind === 'root') return 8;
if (node.kind === 'cl') return 7;
if (node.kind === 'collector') return 6;
return 5.5;
};

const STEP = 190;

const mainEdges = edges.filter((edge) => edge.kind !== 'dive');
const diveEdges = edges.filter((edge) => edge.kind === 'dive');

const orderedMain = [...mainEdges].sort((a, b) => {
const bMax = Math.max(at(b.from).y, at(b.to).y);
const aMax = Math.max(at(a.from).y, at(a.to).y);
return bMax - aMax;
});

const edgeDelay = new Map<DiagramEdge, number>();

orderedMain.forEach((edge, index) => {
edgeDelay.set(edge, index * STEP);
});

const lastMain = orderedMain.length ? (orderedMain.length - 1) * STEP + 700 : 0;
const diveDelay = lastMain + 700;

const nodeDelay = new Map<string, number>();

for (const node of nodes) {
let best = Infinity;

for (const edge of mainEdges) {
if (edge.from !== node.id && edge.to !== node.id) continue;

    const delay = edgeDelay.get(edge) ?? 0;
    const lowerId = at(edge.from).y >= at(edge.to).y ? edge.from : edge.to;

    best = Math.min(best, lowerId === node.id ? delay : delay + 420);

}

diveEdges.forEach((edge, index) => {
  if (edge.from !== node.id && edge.to !== node.id) return;
  const delay = diveDelay + index * 250;
  const lowerId = at(edge.from).y >= at(edge.to).y ? edge.from : edge.to;
  best = Math.min(best, lowerId === node.id ? delay : delay + 420);
});

nodeDelay.set(node.id, Number.isFinite(best) ? best : 0);
}

const tierDelay = (tier: DiagramTier): number => {
let best = Infinity;

for (const node of nodes) {
if (Math.abs(node.y - tier.y) < 48) {
best = Math.min(best, nodeDelay.get(node.id) ?? 0);
}
}

return Number.isFinite(best) ? best : 0;
};

const hasDive = diveEdges.length > 0;
const hasCl = nodes.some((node) => node.kind === 'cl');
---

<figure class="isnad-figure" data-isnad>
  <div class="isnad-frame">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={ariaLabel}>
      {tiers.map((tier) => (
        <text class="tier" x="18" y={tier.y + 4} style={`--d:${tierDelay(tier)}ms`}>
          {tier.label}
        </text>
      ))}

      {orderedMain.map((edge) => (
    <path
      class={getEdgeClass(edge)}
      d={curve(at(edge.from), at(edge.to))}
      pathLength="1"
      style={`--d:${edgeDelay.get(edge)}ms`}
    />
  ))}

  {diveEdges.map((edge, index) => (
    <g class="dive" style={`--d:${diveDelay + index * 250}ms`}>
      <path class="edge--dive" d={curve(at(edge.from), at(edge.to))} />
    </g>
  ))}

  {nodes.map((node) => {
    const offset = getLabelOffset(node);
    const delay = nodeDelay.get(node.id) ?? 0;
    const lines = getLabelLines(node.label);

    return (
      <g>
        {node.kind === 'cl' && (
          <circle class="cl-ring" cx={node.x} cy={node.y} r="14" style={`--d:${delay + 250}ms`} />
        )}

        <circle
          class={getNodeClass(node)}
          cx={node.x}
          cy={node.y}
          r={getNodeRadius(node)}
          style={`--d:${delay}ms`}
        />

        {node.label && (
          <text
            class={getLabelClass(node)}
            x={offset.x}
            y={offset.y}
            text-anchor={offset.anchor}
            style={`--d:${delay + 140}ms`}
          >
            {lines.map((line, index) => (
              <tspan x={offset.x} dy={index === 0 ? 0 : 14}>
                {line}
              </tspan>
            ))}
            {node.sublabel && (
              <tspan class="lbl--sub" x={offset.x} dy="14">
                {node.sublabel}
              </tspan>
            )}
          </text>
        )}
      </g>
    );
  })}

  {annotations.map((annotation) => (
    <text
      class={getAnnotationClass(annotation)}
      x={annotation.x + (annotation.dx ?? 0)}
      y={annotation.y + (annotation.dy ?? 0)}
      text-anchor={annotation.anchor ?? 'start'}
      style={`--d:${annotation.kind === 'dive' ? diveDelay + 200 : lastMain}ms`}
    >
      {annotation.text}
    </text>
  ))}
</svg>

<button
  type="button"
  class="isnad-replay"
  data-isnad-replay
  title="Replay animation"
  aria-label="Replay animation"
>
  <svg
    viewBox="0 0 24 24"
    width="13"
    height="13"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M3 12a9 9 0 1 0 3-6.7" />
    <polyline points="3 4 3 9 8 9" />
  </svg>
    </button>
  </div>

  {(caption || href || legend) && (
    <figcaption class="isnad-caption-wrap">
      {legend && (
        <span class="isnad-legend">
          <i class="key key--strand"></i>
          <span>transmission strand</span>
      {hasCl && (
        <>
          <i class="key key--cl"></i>
          <span>common link</span>
        </>
      )}

      {hasDive && (
        <>
          <i class="key key--dive"></i>
          <span>diving strand</span>
        </>
      )}
    </span>
  )}

  {caption && <p class="isnad-caption">{caption}</p>}

  {href && (
    <a class="isnad-cta" href={href}>
      {hrefLabel} <span aria-hidden="true">→</span>
    </a>
  )}
</figcaption>
  )}

</figure>

<style>
  .isnad-figure {
    width: 100%;
    max-width: none;
    margin: clamp(2rem, 4vw, 3rem) 0;
    box-sizing: border-box;
  }

  .isnad-frame {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-sm);
    background:
      radial-gradient(circle at 50% 112%, rgba(216, 177, 102, 0.09), transparent 54%),
      radial-gradient(circle at 16% 12%, rgba(216, 177, 102, 0.045), transparent 36%),
      linear-gradient(180deg, rgba(30, 29, 27, 0.68), rgba(15, 15, 16, 0.94));
    padding: clamp(0.75rem, 1.6vw, 1.25rem);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 24px 70px rgba(0, 0, 0, 0.22);
  }

  .isnad-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(216, 177, 102, 0.035), transparent 18%, transparent 82%, rgba(216, 177, 102, 0.025)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 22%);
    opacity: 0.9;
  }

  svg {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .isnad-replay {
    position: absolute;
    z-index: 2;
    top: 0.7rem;
    right: 0.7rem;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--hc-rule);
    border-radius: 50%;
    background: rgba(15, 15, 16, 0.72);
    color: var(--hc-gold-dim);
    transition:
      color 200ms ease,
      border-color 200ms ease,
      background 200ms ease,
      transform 300ms var(--ease);
  }

  .isnad-replay:hover {
    color: var(--hc-gold);
    border-color: var(--hc-rule-strong);
    background: rgba(216, 177, 102, 0.08);
    transform: rotate(-60deg);
  }

  .edge {
    fill: none;
    stroke: rgba(216, 177, 102, 0.5);
    stroke-width: 1.3;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .edge--trunk {
    stroke: rgba(216, 177, 102, 0.82);
    stroke-width: 1.75;
  }

  .edge--dive {
    fill: none;
    stroke: var(--hc-umber);
    stroke-width: 1.45;
    stroke-dasharray: 7 5;
  }

  .dive {
    opacity: 0;
  }

  .node {
    fill: #14130f;
    stroke: var(--hc-gold);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.2);
  }

  .node--root {
    fill: var(--hc-gold);
    stroke: var(--hc-gold-soft);
  }

  .node--cl {
    fill: var(--hc-gold);
    stroke: var(--hc-gold-soft);
  }

  .node--coll {
    fill: rgba(216, 177, 102, 0.22);
  }

  .node--ghost {
    fill: transparent;
    stroke-dasharray: 3 2.4;
    stroke: var(--hc-umber);
  }

  .cl-ring {
    fill: none;
    stroke: var(--hc-gold);
    stroke-width: 1;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .lbl,
  .tier {
    fill: var(--hc-muted);
    font-family: var(--font-ui);
    font-size: 12.5px;
    opacity: 0;
    paint-order: stroke;
    stroke: rgba(15, 15, 16, 0.86);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  :global([data-theme="light"]) .isnad-frame {
    background: color-mix(in srgb, var(--hc-surface-1) 85%, transparent);
    border-color: var(--hc-rule);
  }

  :global([data-theme="light"]) .lbl {
    stroke: rgba(251, 249, 244, 0.95);
    fill: var(--hc-text-primary);
  }

  :global([data-theme="light"]) .tier {
    fill: var(--hc-text-secondary);
  }

  :global([data-theme="light"]) .lbl--coll {
    fill: var(--hc-text-primary);
  }


  .tier {
    fill: var(--hc-ash);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    stroke-width: 2px;
  }

  .lbl--cl {
    fill: var(--hc-gold);
    font-size: 13.5px;
    font-weight: 700;
  }

  .lbl--coll {
    fill: var(--hc-parchment-deep);
    font-size: 11px;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .lbl--ghost {
    fill: var(--hc-umber);
  }

  .lbl--sub {
    fill: var(--hc-ash);
    font-size: 11px;
    font-weight: 400;
  }

  .lbl--note {
    fill: var(--hc-ash);
    font-style: italic;
    font-size: 12px;
    stroke-width: 3px;
  }

  .lbl--dive {
    fill: var(--hc-umber);
  }

  :global([data-isnad].play) .edge {
    animation: isnad-draw 700ms var(--ease) forwards;
    animation-delay: var(--d);
  }

  :global([data-isnad].play) .node {
    animation: isnad-pop 450ms var(--ease) forwards;
    animation-delay: var(--d);
  }

  :global([data-isnad].play) .lbl,
  :global([data-isnad].play) .tier {
    animation: isnad-fade 600ms ease forwards;
    animation-delay: var(--d);
  }

  :global([data-isnad].play) .cl-ring {
    animation: isnad-ring 2400ms ease-out infinite;
    animation-delay: var(--d);
  }

  :global([data-isnad].play) .dive {
    animation: isnad-fade 900ms ease forwards;
    animation-delay: var(--d);
  }

  @keyframes isnad-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes isnad-pop {
    from {
      opacity: 0;
      transform: scale(0.2);
    }

    60% {
      opacity: 1;
      transform: scale(1.25);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes isnad-fade {
    from {
      opacity: 0;
      transform: translateY(5px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes isnad-ring {
    0% {
      opacity: 0.9;
      transform: scale(0.55);
    }

    70% {
      opacity: 0;
      transform: scale(1.6);
    }

    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  .isnad-caption-wrap {
    width: 100%;
    max-width: none !important;
    margin: 1rem 0 0 !important;
    padding: 0 !important;
    box-sizing: border-box;
    display: block;
    text-align: left;
  }

  .isnad-legend {
    width: 100%;
    max-width: none !important;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.45rem 0.7rem;
    margin: 0 !important;
    padding: 0 !important;
    color: var(--hc-ash);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-align: left;
  }

  .key {
    display: inline-block;
    flex: 0 0 auto;
    width: 22px;
    height: 0;
    border-top: 2px solid rgba(216, 177, 102, 0.7);
  }

  .key--cl {
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--hc-gold);
    border-radius: 50%;
    background: var(--hc-gold);
  }

  .key--dive {
    border-top-style: dashed;
    border-top-color: var(--hc-umber);
  }

  .key:not(:first-child) {
    margin-left: 0.8rem;
  }

  .isnad-caption-wrap .isnad-caption {
    display: block;
    width: 100%;
    max-width: none !important;
    margin: 0.75rem 0 0 !important;
    padding: 0 !important;
    color: var(--hc-muted);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    line-height: 1.65;
    text-align: left !important;
    text-wrap: pretty;
  }

  .isnad-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.7rem;
    color: var(--hc-gold);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .isnad-cta:hover {
    color: var(--hc-gold-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .edge {
      stroke-dashoffset: 0;
    }

    .node,
    .lbl,
    .tier,
    .dive {
      opacity: 1;
      transform: none;
    }

    .cl-ring {
      opacity: 0.5;
    }

    :global([data-isnad].play) .edge,
    :global([data-isnad].play) .node,
    :global([data-isnad].play) .lbl,
    :global([data-isnad].play) .tier,
    :global([data-isnad].play) .cl-ring,
    :global([data-isnad].play) .dive {
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .isnad-figure {
      margin: 1.75rem 0;
    }

    .isnad-frame {
      padding: 0.7rem;
    }

    .lbl,
    .tier {
      font-size: 10.5px;
    }

    .lbl--cl {
      font-size: 11.5px;
    }

    .lbl--coll {
      font-size: 9.5px;
    }

    .lbl--note {
      font-size: 10px;
    }

    .isnad-caption-wrap .isnad-caption {
      font-size: 0.86rem;
      line-height: 1.6;
    }

    .isnad-legend {
      font-size: 0.68rem;
    }
  }
</style>

<script>
  for (const element of document.querySelectorAll('[data-isnad]')) {
    if (!(element instanceof HTMLElement)) continue;
    if (element.dataset.isnadInit) continue;

    element.dataset.isnadInit = '1';

    const start = () => element.classList.add('play');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              start();
              observer.disconnect();
            }
          }
        },
        { threshold: 0.3 }
      );

      observer.observe(element);
    } else {
      start();
    }

    element.querySelector('[data-isnad-replay]')?.addEventListener('click', () => {
      element.classList.remove('play');
      void element.offsetWidth;
      element.classList.add('play');
    });
  }
</script>
