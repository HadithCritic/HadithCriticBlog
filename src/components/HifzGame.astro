---
// HifzGame.astro
---

<div class="hifz-game" id="hifz-game">
  <div class="hifz-header">
    <h3>Methodology Simulator</h3>
    <p id="hifz-status-text">Test your precision (<i>Dabt</i>) as a Hadith Critic.</p>
    <div class="hifz-stats-bar">
      <span id="stat-mistakes" class="stat-badge">Mistakes: 0</span>
      <span id="stat-hints" class="stat-badge">Hints: 0</span>
    </div>
  </div>

  <!-- PHASE 1: STUDY -->
  <div id="phase-study" class="hifz-phase active">
    <div class="hifz-card">
      <h4 class="hifz-card-title">Study the Transmission</h4>
      <div id="study-source" class="hadith-source"></div>
      <div class="hifz-isnad-display" id="study-isnad"></div>
      <div class="hifz-matn-display">
        <div id="study-matn-arabic" class="matn-arabic" dir="rtl"></div>
        <div id="study-matn-english" class="matn-english"></div>
      </div>
    </div>
    <button id="btn-memorized" class="hc-btn mt-4">I've Memorized This</button>
  </div>

  <!-- PHASE 2: RECONSTRUCT -->
  <div id="phase-reconstruct" class="hifz-phase">
    <div class="hifz-card">
      <h4 class="hifz-card-title">Reconstruct the Chain</h4>
      <p class="hifz-instructions">Reconstruct the route of transmission from the lower transmitter back to the Companion/source.</p>
      
      <div class="hifz-matn-display mb-3">
        <div id="reconstruct-matn-arabic" class="matn-arabic" dir="rtl"></div>
      </div>
      
      <div class="hifz-hint-bar" id="hint-bar">
        <button class="hint-btn" data-type="tabaqa">Reveal Tabaqa</button>
        <button class="hint-btn" data-type="region">Reveal Region</button>
        <button class="hint-btn" data-type="firstLetter">Reveal First Letter</button>
      </div>
      <div id="hint-display" class="hint-display"></div>

      <div class="hifz-reconstruct-pool" id="reconstruct-pool"></div>
      <div class="hifz-reconstruct-built" id="reconstruct-built"></div>

      <div id="jarh-log" class="jarh-log" style="display:none;"></div>
    </div>
  </div>

  <!-- PHASE 3: BAGHDAD INTRO -->
  <div id="phase-baghdad-intro" class="hifz-phase">
    <div class="hifz-card">
      <h4 class="hifz-card-title hc-text-gold">The Baghdad Chamber</h4>
      <p class="mb-2">The chains have been inverted before the people of Baghdad.</p>
      <p>Restore every report to its proper transmission.</p>
    </div>
    <button id="btn-start-baghdad" class="hc-btn mt-4">Face the Critics</button>
  </div>

  <!-- PHASE 4: BAGHDAD TEST -->
  <div id="phase-baghdad-test" class="hifz-phase">
    <p class="hifz-instructions mb-4">Select an Isnad, then select its matching Matn.</p>
    <div class="baghdad-grid">
      <div class="baghdad-col" id="baghdad-isnads">
        <h5>Isnads (Chains)</h5>
      </div>
      <div class="baghdad-col" id="baghdad-matns">
        <h5>Matns (Texts)</h5>
      </div>
    </div>
    <div id="baghdad-action-bar" class="baghdad-action-bar" style="display:none;">
      <button id="btn-confirm-pair" class="hc-btn hc-btn-gold">Submit Pair to the Critics</button>
    </div>
    <div id="baghdad-error-log" class="jarh-log" style="display:none;"></div>
  </div>

  <!-- PHASE 5: VICTORY -->
  <div id="phase-victory" class="hifz-phase">
    <div class="hifz-card">
      <h4 class="hifz-card-title hc-text-gold">Final Evaluation</h4>
      <div id="report-card" class="report-card" style="position:relative;"></div>
    </div>
    <button id="btn-restart" class="hc-btn mt-4">Start New Session</button>
  </div>
</div>

<div id="global-stamp" class="stamp-overlay" style="display:none;"></div>

<script>
  const fullDatabase = [
    {
      id: 1,
      collection: "Ṣaḥīḥ al-Bukhārī",
      reference: "Bukhārī 1",
      isnad: [
        { name: "al-Ḥumaydī", region: "Mecca", tabaqa: "collector's teacher", firstLetter: "al-H" },
        { name: "Sufyān b. ʿUyayna", region: "Mecca", tabaqa: "successor generation", firstLetter: "S" },
        { name: "Yaḥyā b. Saʿīd", region: "Medina", tabaqa: "successor generation", firstLetter: "Y" },
        { name: "Muḥammad b. Ibrāhīm", region: "Medina", tabaqa: "successor", firstLetter: "M" },
        { name: "ʿAlqama b. Waqqāṣ", region: "Medina", tabaqa: "senior successor", firstLetter: "A" },
        { name: "ʿUmar b. al-Khaṭṭāb", region: "Medina", tabaqa: "companion", firstLetter: "U" }
      ],
      decoys: ["Saʿīd b. Yaḥyā", "Ibrāhīm b. Muḥammad", "Sufyān al-Thawrī"],
      matnArabic: "إنما الأعمال بالنيات، وإنما لكل امرئ ما نوى...",
      matnEnglish: "Actions are only by intentions, and each person will have but what they intended."
    },
    {
      id: 2,
      collection: "Muwatta Mālik",
      reference: "Muwatta 15.42",
      isnad: [
        { name: "Yaḥyā b. Yaḥyā", region: "Andalus", tabaqa: "collector's teacher", firstLetter: "Y" },
        { name: "Mālik b. Anas", region: "Medina", tabaqa: "successor generation", firstLetter: "M" },
        { name: "Nāfiʿ", region: "Medina", tabaqa: "successor", firstLetter: "N" },
        { name: "Ibn ʿUmar", region: "Medina", tabaqa: "companion", firstLetter: "I" }
      ],
      decoys: ["Ibn ʿAbbās", "Yaḥyā b. Saʿīd", "Anas b. Mālik"],
      matnArabic: "لا تسافروا بالقرآن إلى أرض العدو...",
      matnEnglish: "Do not travel with the Quran to the land of the enemy."
    },
    {
      id: 3,
      collection: "Ṣaḥīḥ Muslim",
      reference: "Muslim 44",
      isnad: [
        { name: "Zuhayr b. Ḥarb", region: "Baghdad", tabaqa: "collector's teacher", firstLetter: "Z" },
        { name: "Ismāʿīl b. ʿUlayya", region: "Basra", tabaqa: "successor generation", firstLetter: "I" },
        { name: "ʿAbd al-ʿAzīz b. Ṣuḥayb", region: "Basra", tabaqa: "successor", firstLetter: "A" },
        { name: "Anas b. Mālik", region: "Basra", tabaqa: "companion", firstLetter: "A" }
      ],
      decoys: ["Az-Zuhrī", "Qatāda", "Ibn ʿUlayya"],
      matnArabic: "لا يؤمن أحدكم حتى أكون أحب إليه من ولده ووالده والناس أجمعين",
      matnEnglish: "None of you truly believes until I am more beloved to him than his child, his father, and all of mankind."
    },
    {
      id: 4,
      collection: "Sunan Abī Dāwūd",
      reference: "Abū Dāwūd 4321",
      isnad: [
        { name: "Musaddad", region: "Basra", tabaqa: "collector's teacher", firstLetter: "M" },
        { name: "Yaḥyā b. Saʿīd al-Qaṭṭān", region: "Basra", tabaqa: "successor generation", firstLetter: "Y" },
        { name: "ʿUbayd Allāh", region: "Medina", tabaqa: "successor", firstLetter: "U" },
        { name: "Nāfiʿ", region: "Medina", tabaqa: "successor", firstLetter: "N" },
        { name: "Ibn ʿUmar", region: "Medina", tabaqa: "companion", firstLetter: "I" }
      ],
      decoys: ["ʿAbd Allāh", "Yaḥyā b. Yaḥyā", "Mālik"],
      matnArabic: "من تشبه بقوم فهو منهم",
      matnEnglish: "Whoever imitates a people is one of them."
    },
    {
      id: 5,
      collection: "Jāmiʿ al-Tirmidhī",
      reference: "Tirmidhī 2315",
      isnad: [
        { name: "Qutayba b. Saʿīd", region: "Balkh", tabaqa: "collector's teacher", firstLetter: "Q" },
        { name: "Al-Layth b. Saʿd", region: "Egypt", tabaqa: "successor generation", firstLetter: "L" },
        { name: "Ibn Shihāb al-Zuhrī", region: "Medina", tabaqa: "successor", firstLetter: "I" },
        { name: "ʿUrwa", region: "Medina", tabaqa: "senior successor", firstLetter: "U" },
        { name: "ʿĀʾisha", region: "Medina", tabaqa: "companion", firstLetter: "A" }
      ],
      decoys: ["Al-Aʿmash", "Nāfiʿ", "Saʿīd b. al-Musayyab"],
      matnArabic: "من أحدث في أمرنا هذا ما ليس منه فهو رد",
      matnEnglish: "Whoever introduces into this affair of ours that which is not of it, it is rejected."
    }
  ];

  let sessionHadiths = [];
  let currentHadithIndex = 0;
  let reconstructStep = 0;
  let reconstructExpected = [];
  
  // Scoring
  let mistakes = 0;
  let hintsUsed = 0;
  let startTime = null;

  // Baghdad State
  let baghdadPairsFound = 0;
  let selectedIsnadBtn = null;
  let selectedMatnBtn = null;

  // DOM Elements
  const statusText = document.getElementById('hifz-status-text');
  const statMistakes = document.getElementById('stat-mistakes');
  const statHints = document.getElementById('stat-hints');
  const jarhLog = document.getElementById('jarh-log');
  const hintDisplay = document.getElementById('hint-display');
  
  function getEl(id) { return document.getElementById(id); }

  function showPhase(phaseId) {
    document.querySelectorAll('.hifz-phase').forEach(el => el.classList.remove('active'));
    getEl(phaseId).classList.add('active');
  }

  function shuffle(array) {
    let arr = [...array];
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function safeRenderIsnad(container, isnadNames) {
    container.innerHTML = '';
    isnadNames.forEach((name, index) => {
      if (index > 0) {
        const arrow = document.createElement('span');
        arrow.className = 'isnad-arrow';
        arrow.textContent = '→';
        container.appendChild(arrow);
      }
      const node = document.createElement('span');
      node.className = 'isnad-node';
      node.textContent = name;
      container.appendChild(node);
    });
  }

  function updateStats() {
    statMistakes.textContent = `Mistakes: ${mistakes}`;
    statHints.textContent = `Hints: ${hintsUsed}`;
  }

  function startSession() {
    sessionHadiths = shuffle(fullDatabase).slice(0, 3);
    currentHadithIndex = 0;
    mistakes = 0;
    hintsUsed = 0;
    startTime = Date.now();
    updateStats();
    initStudyPhase();
  }

  // --- PHASE 1: STUDY ---
  function initStudyPhase() {
    const hadith = sessionHadiths[currentHadithIndex];
    statusText.textContent = `Narration ${currentHadithIndex + 1} of 3`;
    
    getEl('study-source').textContent = `${hadith.collection} | ${hadith.reference}`;
    safeRenderIsnad(getEl('study-isnad'), hadith.isnad.map(i => i.name));
    getEl('study-matn-arabic').textContent = hadith.matnArabic;
    getEl('study-matn-english').textContent = `"${hadith.matnEnglish}"`;
    
    showPhase('phase-study');
  }

  getEl('btn-memorized').addEventListener('click', () => {
    initReconstructPhase();
  });

  // --- PHASE 2: RECONSTRUCT ---
  function initReconstructPhase() {
    const hadith = sessionHadiths[currentHadithIndex];
    statusText.textContent = `Reconstruct Narration ${currentHadithIndex + 1}`;
    
    getEl('reconstruct-matn-arabic').textContent = hadith.matnArabic;
    
    reconstructExpected = hadith.isnad;
    reconstructStep = 0;
    
    // Pool contains correct + decoys
    const poolNames = [...hadith.isnad.map(i => i.name), ...hadith.decoys];
    const shuffled = shuffle(poolNames);
    
    const pool = getEl('reconstruct-pool');
    pool.innerHTML = '';
    getEl('reconstruct-built').innerHTML = '';
    jarhLog.style.display = 'none';
    hintDisplay.textContent = '';

    shuffled.forEach(name => {
      const btn = document.createElement('button');
      btn.className = 'narrator-btn';
      btn.textContent = name;
      btn.setAttribute("aria-label", `Select narrator ${name}`);
      btn.addEventListener('click', () => handleReconstructClick(btn, name));
      pool.appendChild(btn);
    });
    
    showPhase('phase-reconstruct');
  }

  document.querySelectorAll('.hint-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      hintsUsed++;
      updateStats();
      const type = e.target.dataset.type;
      const expectedObj = reconstructExpected[reconstructStep];
      let msg = "";
      if (type === 'tabaqa') msg = `Hint: The next transmitter is from the ${expectedObj.tabaqa}.`;
      if (type === 'region') msg = `Hint: The next transmitter is from ${expectedObj.region}.`;
      if (type === 'firstLetter') msg = `Hint: The name starts with '${expectedObj.firstLetter}'.`;
      hintDisplay.textContent = msg;
    });
  });

  function handleReconstructClick(btn, name) {
    const expectedObj = reconstructExpected[reconstructStep];
    
    if (name === expectedObj.name) {
      // Correct
      btn.classList.add('correct');
      btn.disabled = true;
      jarhLog.style.display = 'none';
      hintDisplay.textContent = '';
      
      const built = getEl('reconstruct-built');
      if (reconstructStep > 0) {
        const arrow = document.createElement('span');
        arrow.className = 'isnad-arrow';
        arrow.textContent = '→';
        built.appendChild(arrow);
      }
      const node = document.createElement('span');
      node.className = 'isnad-node';
      node.textContent = name;
      built.appendChild(node);
      
      reconstructStep++;
      
      if (reconstructStep === reconstructExpected.length) {
        statusText.textContent = "Ṣaḥīḥ! Chain verified.";
        statusText.style.color = "var(--hc-gold)";
        showStamp('ṢAḤĪḤ', 'stamp-sahih', getEl('phase-reconstruct').querySelector('.hifz-card'));
        setTimeout(() => {
          statusText.style.color = "";
          currentHadithIndex++;
          if (currentHadithIndex < sessionHadiths.length) {
            initStudyPhase();
          } else {
            initBaghdadIntro();
          }
        }, 1200);
      }
    } else {
      // Wrong
      mistakes++;
      updateStats();
      btn.classList.add('wrong');
      showStamp('ḌAʿĪF', 'stamp-daif', getEl('phase-reconstruct').querySelector('.hifz-card'));
      
      // Determine Jarh reasoning
      const isDecoy = sessionHadiths[currentHadithIndex].decoys.includes(name);
      const isLaterInChain = reconstructExpected.slice(reconstructStep+1).find(i => i.name === name);
      
      let jarhMsg = "Unrecognized error.";
      if (isDecoy) {
        jarhMsg = `<strong>Jarḥ Note:</strong> ${name} is an intruder not found in this chain.`;
      } else if (isLaterInChain) {
        if (isLaterInChain.tabaqa === 'companion') {
          jarhMsg = `<strong>Jarḥ Note:</strong> Premature jump. You cannot link directly to the Companion here.`;
        } else {
          jarhMsg = `<strong>Jarḥ Note:</strong> Inversion detected. You skipped ${expectedObj.name}.`;
        }
      }

      jarhLog.innerHTML = jarhMsg;
      jarhLog.style.display = 'block';

      setTimeout(() => {
        btn.classList.remove('wrong');
        initReconstructPhase(); // reset the chain
      }, 2000);
    }
  }

  // --- PHASE 3: BAGHDAD INTRO ---
  function initBaghdadIntro() {
    statusText.textContent = "The Final Test";
    showPhase('phase-baghdad-intro');
  }

  getEl('btn-start-baghdad').addEventListener('click', initBaghdadTest);

  // --- PHASE 4: BAGHDAD TEST ---
  function initBaghdadTest() {
    statusText.textContent = "Match the Isnad to the Matn";
    baghdadPairsFound = 0;
    selectedIsnadBtn = null;
    selectedMatnBtn = null;
    getEl('baghdad-action-bar').style.display = 'none';
    getEl('baghdad-error-log').style.display = 'none';

    const isnadsCol = getEl('baghdad-isnads');
    const matnsCol = getEl('baghdad-matns');
    isnadsCol.innerHTML = '<h5>Isnads (Chains)</h5>';
    matnsCol.innerHTML = '<h5>Matns (Texts)</h5>';

    const shuffledIsnads = shuffle(sessionHadiths);
    const shuffledMatns = shuffle(sessionHadiths);

    shuffledIsnads.forEach(h => {
      const btn = document.createElement('button');
      btn.className = 'baghdad-btn baghdad-isnad';
      btn.dataset.id = h.id;
      btn.innerHTML = `<div class="chain-wrap"></div>`;
      safeRenderIsnad(btn.querySelector('.chain-wrap'), h.isnad.map(i=>i.name));
      btn.addEventListener('click', () => handleBaghdadSelect('isnad', btn));
      isnadsCol.appendChild(btn);
    });

    shuffledMatns.forEach(h => {
      const btn = document.createElement('button');
      btn.className = 'baghdad-btn baghdad-matn';
      btn.dataset.id = h.id;
      btn.innerHTML = `<div dir="rtl" class="matn-arabic">${h.matnArabic}</div><div class="matn-english mt-2">"${h.matnEnglish}"</div>`;
      btn.addEventListener('click', () => handleBaghdadSelect('matn', btn));
      matnsCol.appendChild(btn);
    });

    showPhase('phase-baghdad-test');
  }

  function handleBaghdadSelect(type, btn) {
    if (btn.classList.contains('locked')) return;
    getEl('baghdad-error-log').style.display = 'none';

    if (type === 'isnad') {
      document.querySelectorAll('.baghdad-isnad').forEach(b => {
        if(!b.classList.contains('locked')) b.classList.remove('selected')
      });
      btn.classList.add('selected');
      selectedIsnadBtn = btn;
    } else {
      document.querySelectorAll('.baghdad-matn').forEach(b => {
        if(!b.classList.contains('locked')) b.classList.remove('selected')
      });
      btn.classList.add('selected');
      selectedMatnBtn = btn;
    }

    if (selectedIsnadBtn && selectedMatnBtn) {
      getEl('baghdad-action-bar').style.display = 'block';
    }
  }

  getEl('btn-confirm-pair').addEventListener('click', () => {
    if (!selectedIsnadBtn || !selectedMatnBtn) return;
    checkBaghdadPair();
  });

  function checkBaghdadPair() {
    const id1 = selectedIsnadBtn.dataset.id;
    const id2 = selectedMatnBtn.dataset.id;

    if (id1 === id2) {
      // Match!
      selectedIsnadBtn.classList.remove('selected');
      selectedIsnadBtn.classList.add('locked');
      selectedMatnBtn.classList.remove('selected');
      selectedMatnBtn.classList.add('locked');
      
      baghdadPairsFound++;
      selectedIsnadBtn = null;
      selectedMatnBtn = null;
      getEl('baghdad-action-bar').style.display = 'none';

      if (baghdadPairsFound === sessionHadiths.length) {
        setTimeout(initVictory, 800);
      }
    } else {
      // Mismatch
      mistakes++;
      updateStats();
      selectedIsnadBtn.classList.add('wrong');
      selectedMatnBtn.classList.add('wrong');
      
      showStamp('MAQLŪB', 'stamp-maqlub', getEl('phase-baghdad-test'));

      const errLog = getEl('baghdad-error-log');
      errLog.innerHTML = `<strong>Maqlūb Error:</strong> You attached a chain to a foreign text.`;
      errLog.style.display = 'block';
      
      setTimeout(() => {
        selectedIsnadBtn.classList.remove('wrong', 'selected');
        selectedMatnBtn.classList.remove('wrong', 'selected');
        selectedIsnadBtn = null;
        selectedMatnBtn = null;
        getEl('baghdad-action-bar').style.display = 'none';
        errLog.style.display = 'none';
      }, 2000);
    }
  }

  function calculateRank() {
    if (mistakes === 0 && hintsUsed === 0) return "Ḥāfiẓ";
    if (mistakes === 0) return "Thiqah";
    if (mistakes === 1) return "Ṣadūq yahim";
    if (mistakes === 2) return "Layyin";
    return "Ḍaʿīf";
  }

  // --- PHASE 5: VICTORY ---
  function initVictory() {
    statusText.textContent = "Audit Complete";
    const timeTaken = ((Date.now() - startTime) / 1000).toFixed(1);
    const rank = calculateRank();

    const reportCard = getEl('report-card');
    reportCard.innerHTML = `
      <div class="final-rank ${rank === 'Ḥāfiẓ' ? 'gold' : ''}">${rank}</div>
      <ul class="report-stats">
        <li><span>Chains reconstructed:</span> 3/3</li>
        <li><span>Baghdad pairs restored:</span> 3/3</li>
        <li><span>Total Mistakes:</span> ${mistakes}</li>
        <li><span>Hints Used:</span> ${hintsUsed}</li>
        <li><span>Time Elapsed:</span> ${timeTaken}s</li>
      </ul>
      <div class="strongest-route mt-4">
        <strong>Tested Routes:</strong>
        <p class="mt-2" style="font-size:0.85rem; color: var(--hc-ash)">
          ${sessionHadiths.map(h => h.isnad[h.isnad.length-1].name + ' → Prophet').join('<br/>')}
        </p>
      </div>
    `;

    showPhase('phase-victory');
    
    if (rank === 'Ḥāfiẓ' || rank === 'Thiqah') {
      setTimeout(() => {
        showStamp(rank.toUpperCase(), 'stamp-hafiz', getEl('report-card'), 3000);
      }, 500);
    }
  }

  function showStamp(text, className, container, duration = 1500) {
    const stamp = document.createElement('div');
    stamp.className = `stamp-overlay ${className}`;
    stamp.textContent = text;
    container.style.position = 'relative';
    container.appendChild(stamp);
    
    setTimeout(() => {
      if (stamp.parentNode) {
        stamp.parentNode.removeChild(stamp);
      }
    }, duration);
  }

  getEl('btn-restart').addEventListener('click', startSession);

  // Init automatically
  document.addEventListener("DOMContentLoaded", startSession);
</script>

<style>
  /* Base Styles */
  .hifz-game {
    margin-top: 4rem;
    padding: 2.5rem;
    border: 1px solid var(--hc-rule);
    border-radius: var(--radius-md);
    background: rgba(15, 15, 16, 0.4);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hifz-header h3 {
    margin: 0 0 0.5rem;
    color: var(--hc-gold);
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: -0.02em;
  }

  .hifz-stats-bar {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  .stat-badge {
    background: rgba(0,0,0,0.3);
    border: 1px solid var(--hc-rule);
    padding: 0.3rem 0.6rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--hc-ash);
    border-radius: 4px;
  }

  #hifz-status-text {
    font-size: 0.95rem;
    color: rgba(245, 238, 220, 0.7);
    margin-bottom: 2rem;
    height: 1.5rem;
    transition: color 0.3s ease;
  }

  .hifz-phase {
    display: none;
    animation: fadeIn 0.4s ease;
  }

  .hifz-phase.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Cards */
  .hifz-card {
    background: rgba(25, 25, 27, 0.6);
    border: 1px solid var(--hc-rule-soft);
    border-radius: var(--radius-sm);
    padding: 2rem;
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .hifz-card-title {
    font-family: var(--font-display);
