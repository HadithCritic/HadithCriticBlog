---
interface Props {
  href: string;
  title: string;
  chapter: string;
  tags: string[];
  grade: string;
  gradeLabel: string; // e.g., 'B+'
  reportId: string;
}

const { 
  href, 
  title, 
  chapter,
  tags,
  grade,
  gradeLabel,
  reportId
} = Astro.props;
---
<a href={href} class="report-card hc-card--parchment">
  <div class="report-header">
    <span class="hc-label">Report</span>
    <span class="report-id">#{reportId}</span>
  </div>

  <h3 class="report-title">{title}</h3>
  
  <div class="report-meta">
    <p><strong>Chapter:</strong> {chapter}</p>
    <p><strong>Tags:</strong> {tags.join(' • ')}</p>
  </div>

  <div class="report-grade">
    <div class="grade-info">
      <span class="hc-label">Overall Assessment</span>
      <strong class="grade-text">{grade}</strong>
    </div>
    <div class="grade-badge">
      <span>{gradeLabel}</span>
    </div>
  </div>
</a>

<style>
  .report-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    text-decoration: none;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease);
    /* Jagged edge stamp effect */
    mask-image: radial-gradient(circle, transparent 4px, black 5px);
    mask-size: 14px 14px;
    mask-position: -7px -7px;
  }

  .report-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.3);
  }

  .report-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .report-id {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--hc-umber);
    font-weight: 500;
  }

  .report-title {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 500;
    line-height: 1.1;
    margin: 0 0 1.5rem;
    color: var(--hc-fixed-black);
    letter-spacing: -0.02em;
  }

  .report-meta {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--hc-fixed-charcoal-2);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .report-meta p {
    margin: 0;
  }

  .report-meta strong {
    font-weight: 600;
  }

  .report-grade {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(157, 122, 60, 0.3);
  }

  .grade-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .grade-text {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    color: var(--hc-umber-dark);
    line-height: 1;
  }

  .grade-badge {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--hc-umber);
    color: var(--hc-fixed-parchment);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.2rem;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
  }
</style>
