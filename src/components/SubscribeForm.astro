---
interface Props {
  /** "closing" is the form alone, set inside a band that supplies its own heading. */
  variant: "article" | "footer" | "home" | "closing";
}

const { variant } = Astro.props;
---

<section
  id={variant === "home" || variant === "closing" ? "subscribe" : undefined}
  class:list={["subscribe-form", `subscribe-form--${variant}`]}
  data-subscribe-form
  aria-labelledby={variant === "closing" ? undefined : `subscribe-title-${variant}`}
  aria-label={variant === "closing" ? "Subscribe by email" : undefined}
>
  <div class="subscribe-form__inner">
    {variant !== "home" && variant !== "closing" && <div class="subscribe-form__identity" aria-hidden="true">
      <span class="subscribe-form__index">HadithCritic Dispatch</span>
      <span class="subscribe-form__rule"></span>
    </div>}

    {variant !== "closing" && <div class="subscribe-form__content">
      {variant === "home" ? (
        <h2 id={`subscribe-title-${variant}`} class="home-head__title">Get new blog posts</h2>
      ) : (
        <>
          <div class="subscribe-form__eyebrow">Stay informed</div>
          <h3 id={`subscribe-title-${variant}`}>Get new blog posts</h3>
        </>
      )}
      <p>
        Get one email when a new blog post is published, with a direct link to read it.
      </p>
    </div>}

    <form class="subscribe-form__form" data-subscribe-form-el hidden>
      <label for={`subscribe-email-${variant}`} class:list={[variant === "home" ? "subscribe-form__label" : "sr-only"]}
        >Email address</label
      >
      <div class="subscribe-form__field">
        <input
          type="email"
          id={`subscribe-email-${variant}`}
          name="email"
          placeholder="you@example.com"
          required
          autocomplete="email"
          inputmode="email"
          aria-describedby={`subscribe-note-${variant}`}
        />
        <!-- Honeypot: never shown or focusable, so only a bot fills it. -->
        <input type="text" name="website" hidden tabindex="-1" autocomplete="off" />
        <button type="submit">
          <span>Subscribe</span>
        </button>
      </div>
      <p id={`subscribe-note-${variant}`} class="subscribe-form__note">
        Blog updates only. Unsubscribe anytime.
      </p>
    </form>
    <noscript>
      <p class="subscribe-form__fallback">Enable JavaScript to subscribe by email, or <a href="/rss.xml">follow by RSS</a>.</p>
    </noscript>
  </div>

  <p
    class="subscribe-form__status"
    data-subscribe-form-status
    role="status"
    aria-live="polite"
  >
  </p>
</section>

<script>
  import { bindSubscribeForms } from "../lib/subscribe-client";

  bindSubscribeForms();
</script>

<style>
  .subscribe-form {
    --subscribe-accent: var(--hc-gold);
    --subscribe-accent-soft: var(--hc-gold-soft, var(--hc-gold));
    --subscribe-panel: color-mix(in srgb, var(--hc-surface-2) 74%, transparent);

    position: relative;
    margin-top: clamp(var(--space-xl), 5vw, var(--space-2xl));
    overflow: hidden;
    border: 1px solid var(--hc-rule);
    background: var(--subscribe-panel);
  }

  .subscribe-form::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--subscribe-accent) 18%,
      var(--subscribe-accent) 82%,
      transparent 100%
    );
    opacity: 0.65;
  }

  .subscribe-form::after {
    content: "";
    position: absolute;
    width: 15rem;
    height: 15rem;
    right: -8rem;
    top: -9rem;
    border: 1px solid
      color-mix(in srgb, var(--subscribe-accent) 12%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }

  .subscribe-form__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1.05fr) minmax(20rem, 1fr);
    align-items: center;
    gap: clamp(var(--space-md), 3vw, var(--space-xl));
    padding: clamp(var(--space-md), 3vw, var(--space-lg));
  }

  .subscribe-form__identity {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-xs);
    min-width: 4.5rem;
    padding-right: clamp(var(--space-sm), 2vw, var(--space-lg));
    border-right: 1px solid var(--hc-rule);
  }

  .subscribe-form__index {
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    font-weight: 700;
    line-height: 1.4;
    color: var(--hc-text-tertiary);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .subscribe-form__rule {
    width: 1px;
    flex: 1;
    min-height: 2rem;
    margin-inline: auto;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--subscribe-accent),
      transparent
    );
    opacity: 0.6;
  }

  .subscribe-form__content {
    min-width: 0;
  }

  .subscribe-form__eyebrow {
    margin-bottom: var(--space-2xs);
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--subscribe-accent);
  }

  .subscribe-form__content h3 {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--hc-text-primary);
  }

  .subscribe-form__content p {
    margin: 0;
    max-width: 48ch;
    color: var(--hc-text-secondary);
    font-family: var(--font-body);
    font-size: var(--fs-base);
    line-height: 1.6;
  }

  .subscribe-form__form {
    min-width: 0;
  }

  .subscribe-form__field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2xs);
  }

  .subscribe-form__form input {
    width: 100%;
    min-width: 0;
    height: 2.9rem;
    padding: 0 var(--space-sm);
    border: 1px solid var(--hc-rule);
    border-radius: 0;
    background: color-mix(in srgb, var(--hc-surface-1) 72%, transparent);
    color: var(--hc-text-primary);
    font-family: var(--font-body);
    font-size: var(--fs-base);
    transition:
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .subscribe-form__form input::placeholder {
    color: var(--hc-text-tertiary);
  }

  .subscribe-form__form input:focus {
    border-color: color-mix(
      in srgb,
      var(--subscribe-accent) 62%,
      var(--hc-rule)
    );
    background: var(--hc-surface-1);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--subscribe-accent) 10%, transparent);
  }

  .subscribe-form__form button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    height: 2.9rem;
    padding: 0 var(--space-sm);
    border: 1px solid var(--subscribe-accent);
    border-radius: 0;
    background: var(--subscribe-accent);
    color: var(--hc-text-inverse, #17130d);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: 800;
    cursor: pointer;
    transition:
      transform 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .subscribe-form__form button:hover {
    transform: translateY(-1px);
    background: var(--subscribe-accent-soft);
    border-color: var(--subscribe-accent-soft);
  }

  .subscribe-form__form button:focus-visible {
    --hc-focus-color: var(--subscribe-accent);
  }

  .subscribe-form__form button:disabled {
    opacity: 0.55;
    cursor: default;
    transform: none;
  }

  .subscribe-form__note {
    margin: var(--space-2xs) 0 0;
    color: var(--hc-text-tertiary);
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    line-height: 1.5;
  }

  .subscribe-form__status {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0 clamp(var(--space-md), 3vw, var(--space-lg)) var(--space-sm);
    min-height: 1.2rem;
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    color: var(--subscribe-accent-soft);
  }

  .subscribe-form.is-error .subscribe-form__status {
    color: #e07a6b;
  }

  .subscribe-form--footer {
    margin-top: 0;
    --subscribe-panel: rgba(242, 235, 220, 0.045);
    border-color: rgba(216, 177, 102, 0.23);
  }

  .subscribe-form--footer .subscribe-form__content h3,
  .subscribe-form--footer .subscribe-form__content p {
    color: var(--hc-fixed-parchment, #f2ebdc);
  }

  .subscribe-form--footer .subscribe-form__content p {
    opacity: 0.78;
  }

  .subscribe-form--home {
    margin-top: 0;
    overflow: visible;
    border: 0;
    border-top: 1px solid var(--hc-rule);
    background: transparent;
  }

  .subscribe-form--home::before,
  .subscribe-form--home::after {
    display: none;
  }

  .subscribe-form--home .subscribe-form__inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-lg), 5vw, var(--space-2xl));
    padding: clamp(var(--space-lg), 4vw, var(--space-xl)) 0;
  }

  .subscribe-form--home .subscribe-form__content p {
    max-width: 44ch;
    margin-top: var(--space-xs);
    font-size: var(--fs-base);
  }

  .subscribe-form__label {
    display: block;
    margin-bottom: var(--space-xs);
    color: var(--hc-text-secondary);
    font: 500 var(--fs-xs)/1.4 var(--font-ui);
  }

  .subscribe-form--home .subscribe-form__field {
    gap: 0;
    border-bottom: 1px solid var(--hc-text-tertiary);
    transition: border-color var(--motion-fast) ease;
  }

  .subscribe-form--home .subscribe-form__field:focus-within {
    border-color: var(--hc-gold);
  }

  .subscribe-form--home .subscribe-form__form input {
    min-height: 3.25rem;
    height: auto;
    padding: var(--space-xs) var(--space-xs) var(--space-xs) 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    font-size: var(--fs-base);
  }

  .subscribe-form--home .subscribe-form__form button {
    min-height: 3.25rem;
    height: auto;
    padding: var(--space-xs) 0 var(--space-xs) var(--space-sm);
    border: 0;
    background: transparent;
    color: var(--hc-gold);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    transform: none;
  }

  .subscribe-form--home .subscribe-form__form button:hover {
    color: var(--hc-gold-bright);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .subscribe-form--home .subscribe-form__note {
    margin-top: var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
  }

  .subscribe-form--home .subscribe-form__status {
    padding: 0 0 var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--fs-base);
  }

  .subscribe-form--home .subscribe-form__status:empty {
    display: none;
  }

  .subscribe-form--home.is-error .subscribe-form__status {
    color: var(--hc-danger);
  }

  /* Closing band: one centred field with a filled button. */
  .subscribe-form--closing {
    width: min(100%, 30rem);
    margin: 0 auto;
    overflow: visible;
    border: 0;
    background: none;
  }

  .subscribe-form--closing::before,
  .subscribe-form--closing::after {
    display: none;
  }

  .subscribe-form--closing .subscribe-form__inner {
    display: block;
    padding: 0;
  }

  .subscribe-form--closing .subscribe-form__field {
    display: flex;
    gap: var(--space-2xs);
  }

  .subscribe-form--closing .subscribe-form__form input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 var(--space-sm);
    border: 1px solid var(--hc-rule-strong);
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--hc-surface-0) 70%, transparent);
    color: var(--hc-text-primary);
    font: 400 var(--fs-base)/1.2 var(--font-ui);
  }

  .subscribe-form--closing .subscribe-form__form input:focus {
    border-color: var(--hc-gold);
  }

  .subscribe-form--closing .subscribe-form__form button {
    min-height: 48px;
    padding: 0 var(--space-sm);
    border: 0;
    border-radius: var(--radius-xs);
    background: var(--hc-gold);
    color: var(--hc-text-inverse);
    font: 500 var(--fs-sm)/1 var(--font-ui);
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .subscribe-form--closing .subscribe-form__form button:hover {
    background: var(--hc-gold-bright);
  }

  .subscribe-form--closing .subscribe-form__note,
  .subscribe-form--closing .subscribe-form__status {
    margin: var(--space-xs) 0 0;
    color: var(--hc-text-tertiary);
    font: 400 var(--fs-sm)/1.4 var(--font-ui);
    text-align: center;
  }

  .subscribe-form--closing .subscribe-form__status:empty {
    display: none;
  }

  .subscribe-form--closing.is-error .subscribe-form__status {
    color: var(--hc-danger);
  }

  @media (max-width: 480px) {
    .subscribe-form--closing .subscribe-form__field {
      flex-direction: column;
    }
  }

  .subscribe-form__fallback {
    color: var(--hc-text-secondary);
    font: 400 var(--fs-base)/1.6 var(--font-body);
  }

  .subscribe-form__fallback a {
    color: var(--hc-gold);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .subscribe-form__inner {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .subscribe-form__form {
      grid-column: 2;
    }
  }

  @media (max-width: 640px) {
    .subscribe-form__inner {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      padding: var(--space-md);
    }

    .subscribe-form__identity {
      display: none;
    }

    .subscribe-form__form {
      grid-column: auto;
    }

    .subscribe-form__field {
      grid-template-columns: 1fr;
    }

    .subscribe-form__form button {
      width: 100%;
    }

    .subscribe-form__status {
      padding-inline: var(--space-md);
    }

    .subscribe-form--home .subscribe-form__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-md);
      padding-block: var(--space-lg);
    }

    .subscribe-form--home .subscribe-form__field {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .subscribe-form--home .subscribe-form__form {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .subscribe-form--home .subscribe-form__field,
    .subscribe-form--home .subscribe-form__form input,
    .subscribe-form--home .subscribe-form__form button {
      transition: none;
    }
  }
</style>
