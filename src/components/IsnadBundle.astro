---
/*
  Preset isnad diagram: the famous bundle behind bukhari:1 ("Deeds are by
  intentions"). A single strand rises from the Prophet to Yahya b. Said
  al-Ansari, the common link, then fans out through partial common links to
  the collectors, with a late "diving" strand bypassing the common link.
  Rendering and animation live in IsnadDiagram.
*/
import IsnadDiagram, { type DiagramNode, type DiagramEdge, type DiagramTier, type DiagramAnnotation } from './IsnadDiagram.astro';

interface Props {
  caption?: string;
  href?: string;
  hrefLabel?: string;
}

const {
  caption = 'The bundle behind "deeds are by intentions" (bukhari:1), simplified. A single strand rises to the common link, then fans out. The dashed strand "dives" past him: a later back-projection.',
  href,
  hrefLabel = 'Open the report behind this bundle'
} = Astro.props;

const nodes: DiagramNode[] = [
  { id: 'prophet', x: 380, y: 568, label: 'The Prophet', kind: 'root' },
  { id: 'umar', x: 380, y: 496, label: 'ʿUmar b. al-Khaṭṭāb' },
  { id: 'alqama', x: 380, y: 424, label: 'ʿAlqama b. Waqqāṣ' },
  { id: 'taymi', x: 380, y: 352, label: 'M. b. Ibrāhīm al-Taymī' },
  { id: 'yahya', x: 380, y: 282, label: 'Yaḥyā b. Saʿīd al-Anṣārī', kind: 'cl' },
  { id: 'malik', x: 118, y: 196, label: 'Mālik', labelPos: 'below' },
  { id: 'uyayna', x: 250, y: 196, label: 'Ibn ʿUyayna', labelPos: 'below' },
  { id: 'yazid', x: 380, y: 196, label: 'Yazīd b. Hārūn', labelPos: 'below' },
  { id: 'hammad', x: 512, y: 196, label: 'Ḥammād b. Zayd', labelPos: 'below' },
  { id: 'zuhayr', x: 644, y: 196, label: 'Zuhayr b. M.', labelPos: 'below' },
  { id: 'bukhari', x: 76, y: 84, label: 'BUKHĀRĪ', labelPos: 'above', kind: 'collector' },
  { id: 'muslim', x: 196, y: 84, label: 'MUSLIM', labelPos: 'above', kind: 'collector' },
  { id: 'abudawud', x: 316, y: 84, label: 'ABŪ DĀWŪD', labelPos: 'above', kind: 'collector' },
  { id: 'tirmidhi', x: 436, y: 84, label: 'TIRMIDHĪ', labelPos: 'above', kind: 'collector' },
  { id: 'ibnhanbal', x: 556, y: 84, label: 'IBN ḤANBAL', labelPos: 'above', kind: 'collector' },
  { id: 'tayalisi', x: 676, y: 84, label: 'ṬAYĀLISĪ', labelPos: 'above', kind: 'collector' }
];

const edges: DiagramEdge[] = [
  { from: 'prophet', to: 'umar', kind: 'trunk' },
  { from: 'umar', to: 'alqama', kind: 'trunk' },
  { from: 'alqama', to: 'taymi', kind: 'trunk' },
  { from: 'taymi', to: 'yahya', kind: 'trunk' },
  { from: 'yahya', to: 'malik' },
  { from: 'yahya', to: 'uyayna' },
  { from: 'yahya', to: 'yazid' },
  { from: 'yahya', to: 'hammad' },
  { from: 'yahya', to: 'zuhayr' },
  { from: 'malik', to: 'bukhari' },
  { from: 'malik', to: 'muslim' },
  { from: 'uyayna', to: 'muslim' },
  { from: 'uyayna', to: 'tirmidhi' },
  { from: 'yazid', to: 'abudawud' },
  { from: 'yazid', to: 'ibnhanbal' },
  { from: 'hammad', to: 'ibnhanbal' },
  { from: 'hammad', to: 'tayalisi' },
  { from: 'zuhayr', to: 'tirmidhi' },
  { from: 'zuhayr', to: 'tayalisi' },
  { from: 'tayalisi', to: 'alqama', kind: 'dive' }
];

const tiers: DiagramTier[] = [
  { y: 84, label: 'Collectors' },
  { y: 196, label: 'Partial common links' },
  { y: 282, label: 'Common link' },
  { y: 496, label: 'Single strand' }
];

const annotations: DiagramAnnotation[] = [
  { x: 700, y: 368, text: 'a later “diving” strand', anchor: 'end', kind: 'dive' }
];
---

<IsnadDiagram
  nodes={nodes}
  edges={edges}
  tiers={tiers}
  annotations={annotations}
  caption={caption}
  href={href}
  hrefLabel={hrefLabel}
  ariaLabel="Diagram of an isnad bundle: a single strand of transmitters rises from the Prophet to the common link Yahya b. Said al-Ansari, after which strands fan out through partial common links to the hadith collectors. A dashed strand dives past the common link, illustrating a later back-projected chain."
/>
