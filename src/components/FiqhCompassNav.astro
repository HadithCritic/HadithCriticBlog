---
interface Props {
  current?: "overview" | "methodology" | "issues" | "profiles" | "corrections";
}

const { current = "overview" } = Astro.props;
const items = [
  { id: "overview", label: "Overview", href: "/projects/fiqh-compass/" },
  { id: "methodology", label: "Methodology", href: "/projects/fiqh-compass/methodology/" },
  { id: "axes", label: "12 dimensions", href: "/projects/fiqh-compass/#axis-index" },
  { id: "issues", label: "Issue register", href: "/projects/fiqh-compass/issues/" },
  { id: "profiles", label: "Figures", href: "/projects/fiqh-compass/profiles/" },
  { id: "corrections", label: "Corrections", href: "/projects/fiqh-compass/corrections/" },
];
---

<nav class="fc-project-nav" aria-label="Fiqh Compass">
  <a class="fc-project-nav__brand" href="/projects/fiqh-compass/">
    <span>HADITHCRITIC RESEARCH PROJECT</span>
    <strong>Fiqh Compass</strong>
  </a>
  <div class="fc-project-nav__links">
    {items.map((item) => (
      <a href={item.href} aria-current={current === item.id ? "page" : undefined}>{item.label}</a>
    ))}
    <a class="fc-project-nav__quiz" href="/projects/fiqh-compass/quiz/">Take the quiz</a>
  </div>
</nav>

<style>
  .fc-project-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
    padding: 0.75rem max(var(--pad, 1.25rem), calc((100vw - 80rem) / 2));
    border-bottom: 1px solid var(--fc-line, var(--hc-rule-soft));
    background: var(--fc-bg, var(--hc-surface-0));
    color: var(--fc-ink, var(--hc-text-primary));
  }
  .fc-project-nav__brand { display: grid; gap: 0.12rem; flex: none; text-decoration: none; }
  .fc-project-nav__brand span { color: var(--fc-accent, var(--hc-gold)); font: 600 0.75rem/1.3 var(--font-ui); letter-spacing: 0.1em; }
  .fc-project-nav__brand strong { font: 600 1.05rem/1.2 var(--font-display); }
  .fc-project-nav__links { display: flex; align-items: center; justify-content: flex-end; gap: clamp(0.65rem, 1.6vw, 1.4rem); }
  .fc-project-nav__links a { color: var(--fc-text, var(--hc-text-secondary)); font: 500 0.8rem/1.4 var(--font-ui); text-decoration: none; white-space: nowrap; }
  .fc-project-nav__links a:hover, .fc-project-nav__links a[aria-current="page"] { color: var(--fc-ink, var(--hc-text-primary)); }
  .fc-project-nav__links .fc-project-nav__quiz { min-height: 2.65rem; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0 1rem; border: 1px solid var(--hc-gold); border-radius: 0.12rem; background: var(--hc-gold); color: var(--hc-text-inverse); font-weight: 600; }
  @media (max-width: 900px) {
    .fc-project-nav { align-items: flex-start; flex-direction: column; gap: 0.75rem; padding-block: 0.9rem; }
    .fc-project-nav__links { justify-content: flex-start; width: 100%; overflow-x: auto; padding-bottom: 0.2rem; }
  }
  @media (max-width: 420px) {
    .fc-project-nav__brand span { font-size: 0.75rem; }
    .fc-project-nav__links { gap: 0.85rem; }
    .fc-project-nav__links a { font-size: 0.76rem; }
  }
</style>
