---
interface Props { mobile?: boolean }
const { mobile = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/(.)\/$/, '$1');
const links = [
  { title: 'Hadith Corpus', href: '/hadith/', description: 'Search the narration collections' },
  { title: 'Rijāl Register', href: '/narrators/', description: 'Browse narrator biographies' },
  { title: 'The Qirāʾāt Variants', href: '/projects/quran/', description: 'Compare the ten readings' },
  { title: 'History (Tārīkh)', href: '/projects/history/', description: 'Early historical sources' },
  { title: 'All projects', href: '/projects/', description: 'Every research tool in one place' },
];
const isCurrent = (href: string) => {
  const route = href.replace(/\/$/, '');
  return pathname === route || pathname.startsWith(`${route}/`);
};
const active = links.some(link => isCurrent(link.href));
---

<details class:list={['project-nav', { 'project-nav--mobile': mobile }]} data-project-nav>
  <summary class="project-nav__trigger" data-active={active || undefined}>
    <span>Projects</span>
    <span class="project-nav__chevron" aria-hidden="true"></span>
  </summary>
  <div class="project-nav__panel">
    <ul class="project-nav__list">
      {links.map(link => (
        <li>
          <a href={link.href} aria-current={pathname === link.href.replace(/\/$/, '') ? 'page' : isCurrent(link.href) && link.href !== '/projects/' ? 'location' : undefined}>
            <span class="project-nav__text">
              <span class="project-nav__title">{link.title}</span>
              <span class="project-nav__description">{link.description}</span>
            </span>
            <svg class="project-nav__arrow" width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</details>

<style>
  /* A compact menu in the manner of the links beside it: a rounded trigger
     that shades on hover and while open, and a single-column panel set
     directly beneath it, one hairline between each entry. */
  .project-nav { position: relative; }
  .project-nav__trigger {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 40px;
    padding: 0 10px 0 var(--space-sm);
    border-radius: 12px;
    color: var(--hc-text-secondary);
    font: 500 var(--fs-base)/1 var(--font-ui);
    list-style: none;
    cursor: pointer;
    transition: color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard);
  }
  .project-nav__trigger::-webkit-details-marker { display: none; }
  .project-nav__trigger:hover,
  .project-nav[open] > summary {
    color: var(--hc-text-primary);
    background: color-mix(in srgb, var(--hc-text-primary) 8%, transparent);
  }
  .project-nav__trigger[data-active] {
    color: var(--hc-text-primary);
    background: color-mix(in srgb, var(--hc-text-primary) 5%, transparent);
  }
  .project-nav__chevron {
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--motion-fast) var(--ease-standard);
  }
  .project-nav[open] > summary .project-nav__chevron { transform: translateY(1px) rotate(225deg); }

  .project-nav__panel {
    position: absolute;
    z-index: 1;
    top: calc(100% + 8px);
    left: 0;
    width: 18.5rem;
    padding: var(--space-2xs);
    border: 1px solid var(--hc-rule);
    border-radius: 8px;
    background: var(--hc-surface-0);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
  }
  /* Bridges the gap under the trigger so the pointer can travel into the panel. */
  .project-nav__panel::before {
    content: "";
    position: absolute;
    inset: -9px 0 auto 0;
    height: 9px;
  }
  .project-nav__list { margin: 0; padding: 0; list-style: none; }
  .project-nav__list li + li { border-top: 1px solid var(--hc-rule-soft); }
  .project-nav__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: 60px;
    margin-block: 4px;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: 8px;
    color: var(--hc-text-primary);
    text-decoration: none;
    transition: background var(--motion-fast) var(--ease-standard);
  }
  .project-nav__list a:hover,
  .project-nav__list a:focus-visible,
  .project-nav__list a[aria-current] {
    background: color-mix(in srgb, var(--hc-text-primary) 6%, transparent);
  }
  .project-nav__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .project-nav__title { font: 500 var(--fs-base)/1.3 var(--font-ui); }
  .project-nav__description { color: var(--hc-text-secondary); font: 400 var(--fs-sm)/1.4 var(--font-ui); }
  .project-nav__arrow { flex: none; color: var(--hc-text-tertiary); transition: color var(--motion-fast) ease, transform var(--motion-fast) ease; }
  .project-nav__list a:hover .project-nav__arrow { color: var(--hc-gold); transform: translate(1px, -1px); }

  /* In the phone menu the panel opens in place as a plain list. */
  .project-nav--mobile > summary {
    justify-content: space-between;
    min-height: 48px;
    padding: var(--space-xs) var(--space-2xs);
    border-bottom: 1px solid var(--hc-rule-soft);
    border-radius: 0;
    background: none;
  }
  .project-nav--mobile[open] > summary { background: none; }
  .project-nav--mobile .project-nav__panel {
    position: static;
    width: auto;
    margin: var(--space-2xs) 0 var(--space-sm);
    padding: var(--space-3xs);
    border-color: var(--hc-rule-soft);
    box-shadow: none;
  }
  .project-nav--mobile .project-nav__panel::before { display: none; }
  .project-nav--mobile .project-nav__list a { min-height: 48px; }
  .project-nav--mobile .project-nav__description { display: none; }

  :global([data-theme="light"]) .project-nav__panel { box-shadow: 0 12px 32px rgba(43, 40, 36, 0.12); }

  @media (prefers-reduced-motion: reduce) {
    .project-nav__trigger, .project-nav__chevron, .project-nav__list a, .project-nav__arrow { transition: none; }
  }
</style>

<script>
  const projectMenus = [...document.querySelectorAll<HTMLDetailsElement>('[data-project-nav]')];
  const hoverable = window.matchMedia('(hover: hover) and (min-width: 981px)');
  projectMenus.forEach(menu => {
    const trigger = menu.querySelector<HTMLElement>('summary');
    let closeTimer = 0;
    // On a desktop pointer the menu opens on hover, as well as on click and from the keyboard.
    if (!menu.classList.contains('project-nav--mobile')) {
      menu.addEventListener('pointerenter', event => {
        if (!hoverable.matches || event.pointerType !== 'mouse') return;
        window.clearTimeout(closeTimer);
        menu.open = true;
      });
      menu.addEventListener('pointerleave', event => {
        if (!hoverable.matches || event.pointerType !== 'mouse') return;
        closeTimer = window.setTimeout(() => { menu.open = false; }, 160);
      });
      // Hover has already opened it, so a mouse click keeps it open rather
      // than toggling it shut. Keyboard activation (detail 0) still toggles.
      trigger?.addEventListener('click', event => {
        if (hoverable.matches && event.detail > 0 && menu.open) event.preventDefault();
      });
    }
    menu.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown' && event.target === trigger) {
        event.preventDefault();
        menu.open = true;
        menu.querySelector<HTMLAnchorElement>('a')?.focus();
        return;
      }
      if (event.key !== 'Escape' || !menu.open) return;
      event.preventDefault();
      event.stopPropagation();
      menu.open = false;
      trigger?.focus();
    });
    menu.addEventListener('focusout', event => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
    });
    menu.addEventListener('click', event => {
      if ((event.target as Element).closest('a')) menu.open = false;
    });
  });
  document.addEventListener('pointerdown', event => {
    projectMenus.forEach(menu => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  });
  window.matchMedia('(max-width: 980px)').addEventListener('change', () => {
    projectMenus.forEach(menu => { menu.open = false; });
  });
</script>
