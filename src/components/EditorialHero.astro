---
import '../styles/editorial-pages.css';
interface Props { page: string; title: string; description: string; kicker: string; titleId: string; id?: string; }
const {page,title,description,kicker,titleId,id} = Astro.props;
---
<header class="ed-hero hc-plate" id={id} aria-labelledby={titleId}>
  <img class="ed-hero__art" src={`/images/editorial/${page}-hero.webp`} srcset={`/images/editorial/${page}-hero-1086.webp 1086w, /images/editorial/${page}-hero.webp 2172w`} sizes="(max-width: 640px) 100vw, 70vw" width="2172" height="724" alt="" fetchpriority="high" />
  <div class="ed-shell ed-hero__inner">
    <div class="ed-hero__content">
      <p class="ed-hero__kicker">{kicker}</p>
      <h1 id={titleId}>{title}</h1>
      <div class="ed-hero__rule" aria-hidden="true"><span></span></div>
      <p class="ed-hero__lede">{description}</p>
      {Astro.slots.has('actions') && <div class="ed-hero__actions"><slot name="actions" /></div>}
    </div>
  </div>
</header>
