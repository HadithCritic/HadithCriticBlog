{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hcb",
  "compatibility_date": "2025-05-21",
  "compatibility_flags": ["nodejs_compat"],
  // The site is served only from its custom domains. The workers.dev address
  // was a second public entry point that bots hit directly, so it stays off.
  "workers_dev": false,
  "preview_urls": false,
  // Caps /api/subscribe at 5 attempts per IP per minute. The namespace id is
  // any account-unique integer; it only has to stay the same across deploys
  // for the counters to carry over. The route skips the check if the binding
  // is missing, so a misconfigured deploy still accepts sign-ups.
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
  // There is no database in the site's runtime path. Article announcement
  // emails are paused; the public subscribe endpoint still uses Resend and
  // this rate limit.
}
