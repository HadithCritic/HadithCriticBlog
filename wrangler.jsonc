{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hcb",
  "compatibility_date": "2025-05-21",
  "compatibility_flags": ["nodejs_compat"],
  // Caps /api/subscribe at 5 attempts per IP per minute. The namespace id is
  // any account-unique integer; it only has to stay the same across deploys
  // for the counters to carry over. The route skips the check if the binding
  // is missing, so a misconfigured deploy still accepts sign-ups.
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
  // No database binding, because no public page reads a database. The corpus
  // is a static SQLite file on R2 that the reader's browser queries over HTTP
  // range requests; see docs/static-corpus.md. Turso remains only for the
  // admin notify pages, reached over HTTPS with TURSO_DATABASE_URL and
  // TURSO_AUTH_TOKEN, which are secrets (`wrangler secret put`) and
  // deliberately absent from this file. Locally they come from .dev.vars.
  //
  // PUBLIC_CORPUS_BASE_URL is not here and must not be: it is inlined into the
  // client bundle by Vite when `npm run build` runs, so a runtime var on the
  // Worker has no effect on it. It belongs in the build environment.
}
