# build output
dist/
# Isolated builds (`npm run build -- --outDir dist-<name>`). Each is a full copy
# of the site, ~14,000 files (the Quran releases are hard-linked in, 12.25 GB
# apparent), plus a copy of .dev.vars. Thirteen of them sat untracked in the root and
# put ~180,000 files in Source Control. Anchored to the root so nothing under
# src/ can match.
/dist-*/
# Local-only archive of superseded builds and similar material. See its README.
/local-archive/
# Raw Ifta' Sunnah table-of-contents pages (scripts/fetch-ifta-toc.mjs). Kept
# locally as source evidence; data/ifta-toc/manifest.json records each one's
# URL, size and sha256, and the parsed JSON beside it is committed.
/data/ifta-toc/raw/
# Design-review screenshots and build logs written by agents and Playwright.
/output/
/tmp/
# Agent design-tool run state (hallmark skill).
/.hallmark/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
.cf-secret.json
.dev.vars

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# scratch directory
scratch/


# Large Quran source CSV (compact JSON generated into src/data/)
data/ws_quran_text_rows.csv
dev-server.log
test-results/
playwright-report/

# Local private blog authoring workspace
.blog-maker/
src/content/articles/_preview-*.mdx

# Lane's Lexicon parse (generated from the Perseus XML via scripts/lexicon/parse-lane.mjs)
data/lexicon/lane/


# Cloudflare D1 and Wrangler
.wrangler/
# Astro preview/dev logs. This line was previously saved as UTF-16, so git
# read it as NUL-separated bytes and it never matched anything.
.astro-preview*

# Local-only dev helper: duplicates `npm run dev` (astro dev --host 127.0.0.1).
dev-server.mjs

# Agent skill installs (skills.sh)
.agents/
.claude/skills/
skills-lock.json

# satori font cache for scripts/build-og-images.mjs
.cache/

# Local corpus test datasets
mus test/*.json

# Python bytecode and local build output
__pycache__/
*.pyc

# Extracted PDF text and pickles for the hadith criticism atlas: derived from the local library, not redistributed
docs/research/hadith-graph/inputs/
