# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
.cf-secret.json
.dev.vars

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# scratch directory
scratch/


# Large Quran source CSV (compact JSON generated into src/data/)
data/ws_quran_text_rows.csv
dev-server.log
test-results/
playwright-report/

# Local private blog authoring workspace
.blog-maker/
src/content/articles/_preview-*.mdx

# Silsilah hadith database (generated from hadith/*.tsv via scripts/build-silsilah-data.cjs)
# Anchored to the repo root. Unanchored, this matched src/pages/hadith/ too and
# kept the entire corpus feature out of version control.
/hadith/
src/data/silsilah/
public/silsilah-data/

# Rijal narrator data (generated from OpenITI al-Kashif via scripts/build-rijal-data.cjs)
src/data/rijal/
public/rijal-data/

# Corpus-map identification diagnostic (regenerated by scripts/identify-narrators.cjs)
scripts/identify-report.json

# Cloudflare D1 and Wrangler
.wrangler/
scripts/silsilah.db
scripts/seed_d1_log.txt
# Generated D1 seed dumps. These are exports of the corpus, not source: the
# hadith set alone is 1.4 GB across 305 files and the search payload another
# 462 MB, both well past what GitHub accepts. Regenerate with
# `npm run build:hadith-seed`.
scripts/d1seed*/
# Astro preview/dev logs. This line was previously saved as UTF-16, so git
# read it as NUL-separated bytes and it never matched anything.
.astro-preview*

# Local-only dev helper: duplicates `npm run dev` (astro dev --host 127.0.0.1).
dev-server.mjs
