# build output
dist/
# Isolated builds (`npm run build -- --outDir dist-<name>`). Each is a full copy
# of the site, ~14,000 files (the Quran releases are hard-linked in, 12.25 GB
# apparent), plus a copy of .dev.vars. Thirteen of them sat untracked in the root and
# put ~180,000 files in Source Control. Anchored to the root so nothing under
# src/ can match.
/dist-*/
# Local-only archive of superseded builds and similar material. See its README.
/local-archive/
# Design-review screenshots and build logs written by agents and Playwright.
/output/
/tmp/
# Agent design-tool run state (hallmark skill).
/.hallmark/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
.cf-secret.json
.dev.vars

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# scratch directory
scratch/


# Large Quran source CSV (compact JSON generated into src/data/)
data/ws_quran_text_rows.csv
dev-server.log
test-results/
playwright-report/

# Local private blog authoring workspace
.blog-maker/
src/content/articles/_preview-*.mdx

# Silsilah hadith database (generated from hadith/*.tsv via scripts/build-silsilah-data.cjs)
# Anchored to the repo root. Unanchored, this matched src/pages/hadith/ too and
# kept the entire corpus feature out of version control.
/hadith/
src/data/silsilah/
public/silsilah-data/

# Rijal narrator data (generated from OpenITI al-Kashif via scripts/build-rijal-data.cjs)
src/data/rijal/
public/rijal-data/

# Corpus-map identification diagnostic (regenerated by scripts/identify-narrators.cjs)
scripts/identify-report.json

# Static SQLite Corpus (R2 Hosted)
dist-db/
public/data/chunks/

# Cloudflare D1 and Wrangler
.wrangler/
scripts/silsilah.db
scripts/seed_d1_log.txt
# Generated D1 seed dumps. These are exports of the corpus, not source: the
# hadith set alone is 1.4 GB across 305 files and the search payload another
# 462 MB, both well past what GitHub accepts. Regenerate with
# `npm run build:hadith-seed`.
scripts/d1seed*/
# Astro preview/dev logs. This line was previously saved as UTF-16, so git
# read it as NUL-separated bytes and it never matched anything.
.astro-preview*

# Local-only dev helper: duplicates `npm run dev` (astro dev --host 127.0.0.1).
dev-server.mjs

# Agent skill installs (skills.sh)
.agents/
.claude/skills/
skills-lock.json

# satori font cache for scripts/build-og-images.mjs
.cache/

# Local corpus test datasets
mus test/*.json

# Static corpus, published per version by scripts/publish-corpus.mjs.
# Generated from the master database, which is itself not in git.
public/data/corpus/

# Immutable Quran data releases: about 13 GB across 37 releases. Built into dist by
# scripts/build-site.mjs and served from the CDN, never committed. Staging them made git
# run out of memory ("malloc failed") on diff and commit.
public/data/quran/releases/

# Python bytecode and local build output
__pycache__/
*.pyc

# Extracted PDF text and pickles for the hadith criticism atlas: derived from the local library, not redistributed
docs/research/hadith-graph/inputs/

# Long Shamela passages (up to 1,600 letters each) kept for the qirāʾāt research track. Short evidence spans are
# committed in the claim files; the full passages regenerate with scripts/quran/qiraat/build-qiraat.py and stay local
# until the rights ruling in docs/research/quran-platform/SOURCE-RIGHTS.md.
docs/research/quran-platform/qiraat/second-witness/route-detail.json
docs/research/quran-platform/qiraat/second-witness/*-not-entered.json
docs/research/quran-platform/qiraat/second-witness/mabsut-gap.json
docs/research/quran-platform/qiraat/second-witness/compare-*.json
docs/research/quran-platform/qiraat/second-witness/nashr-compare-auto.json
docs/research/quran-platform/qiraat/second-witness/audit-*.json
docs/research/quran-platform/qiraat/second-witness/queue.json
docs/research/quran-platform/qiraat/second-witness/_triage.json
